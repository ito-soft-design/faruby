# faRuby - Configuration
#
# ここに書いた項目だけが faruby_default.yml の既定値を上書きします。
# 書かなかった項目は既定値のまま残ります。

plc:
  protocol: keyence_kv
  model: KV-5000        # いま相手にしている機種
  host: 192.168.0.10
  port: 8501

mrbc:
  path: C:/mruby-build/mruby/build/host/bin/mrbc.exe

vm:
  steps_per_cycle: 50

# faRuby が使用する PLC デバイスの領域。
# ラダーが使用していない範囲を割り当ててください。
# 変更したら `rake vm_core` で再生成し、KV Studio に取り込み直します。
# 既定値と項目の説明は faruby_default.yml を参照してください。
# memory:
#   device: EM
#   base: 20000

# 機種ごとの設定。上の共通設定を機種ごとに上書きします。
# 機種は plc.model で選び、書いた項目だけが差し替わります。
# models:
#   KV-5000:
#     plc:
#       host: 10.0.1.201
#   KV-X500:
#     plc:
#       host: 10.0.1.202
#     vm:
#       steps_per_cycle: 50
