(* faRuby - MELSEC Q プローブ 1: デバイスの指し方
 *
 * **どれが変換を通るか**を見るためのものです。通らない行は番号を控えて
 * 消し、残りをもう一度変換してください。**通らないこと自体が答え**なので、
 * 全部通す必要はありません。
 *
 * 結果は D100 から 2 ワードおきに書きます (32 ビットが隣を潰すため)。
 * 空きの D100-D160 とインデックスレジスタ Z0-Z1 を使います。
 * ラダーが使っていないことを確かめてから流してください。
 *
 * 期待値:
 *   D100 = 1        素の代入が通る
 *   D122 = 2        インデックス修飾 (Z0 = 12 → D110Z0 は D122)
 *   D124 = 3        インデックス修飾の読み
 *   D130 = 4        Z を式で作れる
 *   D140,D141       32 ビット (DMOV で 100000 → 下位 34464 上位 1)
 *   D144,D145       32 ビットのインデックス修飾
 *   D150,D151       実数 (EMOV で 2.5)
 *   D154            実数 → 整数 (-2.7 の切り捨て方を見る)
 *   D156            整数の割り算 (-7 / 2 の丸め方を見る)
 *   D160 = 5        入れ子 FOR の EXIT が内側だけを抜けるか
 *)

(* ---- 1. 素の代入 ---- *)
D100 := 1;

(* ---- 2. インデックス修飾 (書き) ----
 * KV は D0:Z1、MELSEC は D0Z1 と続けて書く形のはずです
 *)
Z0 := 12;
D110Z0 := 2;

(* ---- 3. インデックス修飾 (読み) ---- *)
D124 := 3;
Z1 := 24;
D100Z1 := D100Z1;

(* ---- 4. Z を式で作れるか ---- *)
Z0 := 10 + 20;
D100Z0 := 4;

(* ---- 5. 32 ビット ----
 * MELSEC は幅をサフィックスではなく命令で決めるはずです。
 * どちらの書き方が通るかを見ます。通らない方を消してください。
 *)
DMOV(TRUE, K100000, D140);
(* 別案: D140 := DINT#100000; *)

(* ---- 6. 32 ビットのインデックス修飾 ---- *)
Z0 := 4;
DMOV(TRUE, K200000, D140Z0);

(* ---- 7. 実数 ---- *)
EMOV(TRUE, E2.5, D150);
(* 別案: D150 := REAL#2.5; *)

(* ---- 8. 実数 → 整数 (0 方向へ切り捨てか、四捨五入か) ---- *)
EMOV(TRUE, E-2.7, D152);
INT(TRUE, D152, D154);

(* ---- 9. 整数の割り算 (0 方向へ切り捨てか、切り下げか) ---- *)
D156 := -7 / 2;

(* ---- 10. 入れ子 FOR と EXIT ----
 * 内側だけ抜けるなら D160 = 5 (外側が 5 周する)
 *)
D160 := 0;
FOR Z0 := 1 TO 5 DO
  FOR Z1 := 1 TO 3 DO
    EXIT;
  END_FOR;
  D160 := D160 + 1;
END_FOR;
