(* faRuby probe 4: ファイルレジスタ。説明は README.md *)

(* 24 ZR に書く。faRuby の固定領域 (バイトコード・定数プール) の置き場所 *)
ZR0 := 24;

(* 25 ZR を 32 ビットで *)
DMOV(TRUE, K300000, ZR2);

(* 26 ZR のインデックス修飾 *)
Z0 := 6;
ZR0Z0 := 26;

(* 27 R (バンク付きのファイルレジスタ) も使えるか *)
R0 := 27;

(* 28 どこまで届くか。faRuby の固定領域は 1 インスタンス 5,000 ワードなので、
 * ZR4999 が通れば足りる。ここも範囲外なら確保量を増やす *)
ZR4999 := 28;

(* 結果を D に写して読めるようにする *)
D270 := ZR0;
DMOV(TRUE, ZR2, D272);
D274 := ZR6;
D276 := R0;
D278 := ZR4999;
