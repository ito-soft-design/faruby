; vm_util.a80 — ユーティリティサブルーチン
;
; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
; 他のすべてのモジュールがここに依存します。
;
; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
;   +0: 型タグ (1B)
;   +1: 予約   (1B, 常に 0)
;   +2: val_lo (1B)
;   +3: val_hi (1B)

; ---------------------------------------------------------------
; get_reg_addr — レジスタ番号 → スロット先頭アドレス
;
;   入力: A = レジスタ番号 (0-63)
;   出力: HL = スロット先頭アドレス
;   破壊: A
;
; REG_FILE_BASE = 0x8100 (下位バイト 0x00) なので、
; レジスタ番号 × 4 がそのまま L になり、H は固定。
; ---------------------------------------------------------------
get_reg_addr:
  add a           ; ×2
  add a           ; ×4
  mov l, a
  mvi h, REG_FILE_BASE_HI
  ret

; ---------------------------------------------------------------
; get_reg_addr_next — R[a+1] のスロット先頭アドレス
;
;   入力: A = レジスタ番号 a
;   出力: HL = R[a+1] のスロット先頭アドレス
;   破壊: A
; ---------------------------------------------------------------
get_reg_addr_next:
  inr a
  jmp get_reg_addr

; ---------------------------------------------------------------
; set_slot_int16 — スロットに 16 ビット整数を書く
;
;   入力: HL = スロット先頭アドレス
;          B  = val_hi (上位バイト)
;          C  = val_lo (下位バイト)
;   出力: なし
;   破壊: HL
; ---------------------------------------------------------------
set_slot_int16:
  mvi m, TT_INTEGER   ; +0: 型タグ
  inx h
  mvi m, 0             ; +1: 予約
  inx h
  mov m, c             ; +2: val_lo
  inx h
  mov m, b             ; +3: val_hi
  ret

; ---------------------------------------------------------------
; set_slot_special — 値を持たない型をスロットに書く
;
;   入力: HL = スロット先頭アドレス
;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
;   出力: なし
;   破壊: A, HL
; ---------------------------------------------------------------
set_slot_special:
  mov m, a             ; +0: 型タグ
  inx h
  mvi m, 0             ; +1: 予約
  inx h
  mvi m, 0             ; +2: val_lo = 0
  inx h
  mvi m, 0             ; +3: val_hi = 0
  ret

; ---------------------------------------------------------------
; copy_slot — スロットを丸ごと複写 (4 バイト)
;
;   入力: HL = コピー元先頭
;         DE = コピー先先頭
;   出力: なし
;   破壊: A, C, HL, DE
; ---------------------------------------------------------------
copy_slot:
  mvi c, SLOT_BYTES
copy_slot_loop:
  mov a, m
  stax d
  inx h
  inx d
  dcr c
  jnz copy_slot_loop
  ret

; ---------------------------------------------------------------
; get_slot_type — スロットの型タグを読む
;
;   入力: HL = スロット先頭アドレス
;   出力: A = 型タグ
;   破壊: なし (HL 保存)
; ---------------------------------------------------------------
get_slot_type:
  mov a, m
  ret

; ---------------------------------------------------------------
; slot_to_value — スロット先頭から値の先頭へ進める
;
;   入力: HL = スロット先頭アドレス
;   出力: HL = 値の先頭 (スロット +2)
;   破壊: なし
; ---------------------------------------------------------------
slot_to_value:
  inx h
  inx h
  ret

; ---------------------------------------------------------------
; add_value16 — 16 ビット加算 (val1 += val2)
;
;   入力: HL = 値 1 の先頭 (結果をここに上書き)
;         DE = 値 2 の先頭
;   出力: 結果を HL の元の位置に上書き
;   破壊: A, HL, DE
;
; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
; ---------------------------------------------------------------
add_value16:
  ldax d          ; A = val2[lo]
  add m           ; A += val1[lo]
  mov m, a        ; val1[lo] = result
  inx h
  inx d
  ldax d          ; A = val2[hi]
  adc m           ; A += val1[hi] + CY
  mov m, a
  ret

; ---------------------------------------------------------------
; sub_value16 — 16 ビット減算 (val1 -= val2)
;
;   入力: HL = 値 1 の先頭 (結果をここに上書き)
;         DE = 値 2 の先頭
;   出力: 結果を HL の元の位置に上書き
;   破壊: A, HL, DE
;
; XCHG はフラグを変えないので借りが正しく伝搬する。
; ---------------------------------------------------------------
sub_value16:
  mov a, m        ; A = val1[lo]
  xchg            ; HL=val2, DE=val1
  sub m           ; A -= val2[lo]
  xchg            ; HL=val1, DE=val2
  mov m, a        ; val1[lo] = result
  inx h
  inx d
  mov a, m        ; A = val1[hi]
  xchg
  sbb m           ; A -= val2[hi] - CY
  xchg
  mov m, a
  ret

; ---------------------------------------------------------------
; cmp_value16 — 16 ビット符号付き比較
;
;   入力: HL = 値 1 の先頭 (byte0 の位置)
;         DE = 値 2 の先頭 (byte0 の位置)
;   出力: A = 比較結果
;           00h → val1 == val2
;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
;           01h → val1 > val2  (ORA A で S が立たない → JP)
;   破壊: A, B, HL, DE
;
; 手順:
;   1. 上位バイト (byte1) の符号ビットを比べる
;   2. 符号が違えば、負の方が小さい
;   3. 符号が同じなら上位 → 下位の順に符号なし比較
; ---------------------------------------------------------------
cmp_value16:
  ; byte1 (上位) の位置を求める
  inx h           ; HL = val1+1 (hi)
  inx d           ; DE = val2+1 (hi)
  ; 符号ビットを比べる
  mov a, m        ; A = val1[hi]
  mov b, a        ; B = val1[hi] (退避)
  ldax d          ; A = val2[hi]
  xra b           ; 符号ビットが違えば bit7 = 1
  jp cmp16_same_sign
  ; 符号が違う: val1 が負なら val1 < val2
  mov a, b        ; A = val1[hi]
  ani 80h         ; bit7 を取り出す
  jnz cmp16_ret_neg ; val1 が負 → val1 < val2
  jmp cmp16_ret_pos ; val1 が正 → val1 > val2
cmp16_same_sign:
  ; 符号が同じ: 上位 → 下位の順に符号なし比較
  ldax d
  cmp m           ; val2[hi] - val1[hi]
  jc cmp16_ret_pos
  jnz cmp16_ret_neg
  dcx h
  dcx d
  ldax d
  cmp m           ; val2[lo] - val1[lo]
  jc cmp16_ret_pos
  jnz cmp16_ret_neg
  ; すべて等しい
  xra a           ; A = 00h
  ret
cmp16_ret_neg:
  mvi a, 0FFh     ; val1 < val2
  ret
cmp16_ret_pos:
  mvi a, 01h      ; val1 > val2
  ret
