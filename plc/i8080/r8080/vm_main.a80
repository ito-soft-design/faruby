; vm_main.a80 — faRuby i8080 VM
;
; mruby バイトコードを実行する VM の本体。
; ND8080 ボード (拡張 RAM 搭載: 0x0000-0xFFFF) を想定。
;
; 0x8400: 起動スタブ (SP 設定 + バンク切り替え + JMP vm_start)
; 0x1000: VM 本体コード (拡張 RAM 領域)
;
; bank_init が事前に ROM → 拡張 RAM クローンを実行する。
; hex ロードは拡張 RAM モード (ポート 9C bit3=1) のまま行われるため、
; 0x1000-0x7FFF のデータは直接拡張 RAM に書き込まれる。
;
; asm80 -m I8080 vm_main.a80

.include "vm_constants.a80"

; ===============================================================
; 起動スタブ (通常 RAM 0x8400)
;
; 1. SP 設定
; 2. 拡張 RAM バンク切り替え (OUT PORT_9C, F8h)
; 3. vm_start へジャンプ
;
; bank_init が事前に ROM → 拡張 RAM クローンを実行済み。
; hex ロードは拡張 RAM モードのまま行われるため、
; VM コード・バイトコード・プールは直接拡張 RAM に書き込まれる。
; ===============================================================
  org 08400h

startup_stub:
  lxi sp, STACK_TOP + 1
  mvi a, 0F8h
  out PORT_9C
  jmp vm_start

; ===============================================================
; VM 本体コード (拡張 RAM 0x1000-)
; ===============================================================
  org 01000h

; ===============================================================
; サブルーチン群 (.include で取り込む)
; ===============================================================
.include "vm_util.a80"
.include "vm_fetch.a80"
.include "vm_load.a80"
.include "vm_arith.a80"
.include "vm_compare.a80"
.include "vm_jump.a80"
.include "vm_globals.a80"
.include "vm_send.a80"
.include "vm_frame.a80"
.include "vm_block.a80"
.include "vm_upvar.a80"
.include "vm_class.a80"
.include "vm_display.a80"

; ===============================================================
; OP_RETURN (B): フレーム種別に応じて復帰
;
; frame_sp == 0 → トップレベル: 表示して停止
; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
; それ以外 (反復のフレーム) → ブロック内: advance_iteration
; ===============================================================
do_op_return:
  call fetch_byte         ; A = a (戻り値のレジスタ)
  sta return_reg_a

  ; フレームスタックが空ならトップレベル
  lda VM_STATE_BASE + OFF_FRAME_SP
  ora a
  jz do_op_return_top

  ; フレーム種別を確認
  call cur_frame_addr     ; HL = 現在のフレーム
  lxi d, FRAME_OFF_KIND
  dad d
  mov a, m                ; A = kind
  cpi FRAME_KIND_CALL
  jz return_call
  cpi FRAME_KIND_NEW
  jz return_new
  ; 反復のフレーム (ITERATE / EACH / HASH_EACH / LOOP)
  jmp advance_iteration

return_call:
  ; R[a] の値を R[0] にコピー
  lda return_reg_a
  call get_reg_addr       ; HL = R[a]
  push h
  mvi a, 0
  call get_reg_addr       ; HL = R[0]
  xchg                    ; DE = R[0] (コピー先)
  pop h                   ; HL = R[a] (コピー元)
  call copy_slot          ; R[0] = R[a]
  call pop_frame
  jmp vm_loop

return_new:
  ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
  call pop_frame
  jmp vm_loop

do_op_return_top:
  lda return_reg_a
  call get_reg_addr       ; HL = R[a]
  call slot_to_value      ; HL = R[a] の値先頭
  call display_hex16
  mvi a, VM_FINISHED
  sta VM_STATE_BASE + OFF_STATUS
  jmp vm_halt

return_reg_a: db 0

; ===============================================================
; advance_iteration — ブロックの 1 反復が終わった後の処理
;
; ITERATE (times / upto): index++ して limit と比較。超えたら pop_frame。
; EACH / HASH_EACH: 同じ数え方で、ブロックに渡す値だけが違う。
; LOOP: 常に PC=0 で再実行 (無限ループ)。
; ===============================================================
advance_iteration:
  ; フレーム種別を確認
  call cur_frame_addr     ; HL = 現在のフレーム
  lxi d, FRAME_OFF_KIND
  dad d
  mov a, m                ; A = kind
  cpi FRAME_KIND_LOOP
  jz adv_reenter          ; loop → 常に再実行
  sta adv_kind            ; kind を退避

  ; **述語はここでブロックの値を見る。** 打ち切るなら R[0] に答えが入る
  call predicate_decision
  ora a
  jnz adv_stopped

  ; --- 反復に共通: index インクリメント + limit チェック ---
  call cur_frame_addr
  lxi d, FRAME_OFF_INDEX
  dad d
  mov c, m                ; C = index_lo
  inx h
  mov b, m                ; B = index_hi
  inx b                   ; BC = index + 1
  ; 書き戻す
  mov m, b                ; index_hi
  dcx h
  mov m, c                ; index_lo

  ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
  inx h                   ; → &index_hi
  inx h                   ; → &limit_lo
  mov e, m                ; E = limit_lo
  inx h                   ; → &limit_hi
  mov d, m                ; D = limit_hi

  ; BC = new index, DE = limit
  ; index > limit なら反復終了 (DE - BC でボロー発生)
  mov a, e
  sub c
  mov a, d
  sbb b
  jc adv_done             ; index > limit → 反復終了

  ; kind で R[1] の設定を分岐
  ; ITERATE (times / upto) だけが添字。残りはコレクションの反復
  lda adv_kind
  cpi FRAME_KIND_ITERATE
  jnz adv_each_load

  ; --- ITERATE (times): R[1] = index ---
  mvi a, 1
  call get_reg_addr       ; HL = R[1] (BC は保存される)
  call set_slot_int16     ; R[1] = index (ブロック引数 |i|)
  jmp adv_reenter

  ; --- EACH / HASH_EACH: ブロックの引数を入れ直す ---
  ;
  ; **値の出し方は sendb_each と同じものを呼びます。** 配列なら要素、
  ; ハッシュなら鍵と値で、分けているのは each_block_args の中だけです。
adv_each_load:
  ; BC = index のうち下位バイトだけ使う (配列 8 要素・ハッシュ 4 ペアまで)
  mov a, c
  sta each_index
  lda adv_kind
  sta each_arg_kind
  ; フレーム +11 からコレクションスロット番号を読む
  call cur_frame_addr     ; BC を破壊するが、添字は退避済み
  lxi d, 11
  dad d
  mov a, m                ; A = col_slot
  sta each_col_slot
  call each_block_args

adv_reenter:
  ; PC = 0 で再実行
  lxi h, 0
  shld VM_STATE_BASE + OFF_PC
  jmp vm_loop

adv_done:
  ; 反復完了 → フレームを破棄して親に戻る
  ; **述語だけは R[0] を答えに書き換える** (止まったときの逆)
  call predicate_exhausted
adv_stopped:
  ; 打ち切り。R[0] には predicate_decision が答えを書いてある
  call pop_frame
  jmp vm_loop

adv_kind: db 0

; ===============================================================
; predicate_decision — ブロックの値を見て打ち切るか決める
;
;   入力: adv_kind (フレーム種別) / return_reg_a (ブロックの戻り値)
;   出力: A = 1 なら打ち切った (R[0] に答えを書いた)、0 なら続ける
;
; **R[0] を潰してよい。** もう要素を取り出さないので、レシーバの場所が
; そのまま答えの置き場になる (呼んだ側の R[a] と同じ場所)。
;
;   any?  真で止まって true、尽きたら false
;   all?  偽で止まって false、尽きたら true
;   none? 真で止まって false、尽きたら true
; ===============================================================
predicate_decision:
  lda adv_kind
  cpi FRAME_KIND_ANY
  jc pd_continue          ; ANY 未満 → 述語ではない

  ; ブロックの戻り値の型タグ。TT_FALSE 以下が偽 (nil / false)
  lda return_reg_a
  call get_reg_addr       ; HL = R[a]
  mov a, m                ; A = 型タグ
  cpi TT_FALSE + 1
  jc pd_falsy

  ; --- 真だった ---
  lda adv_kind
  cpi FRAME_KIND_ALL
  jz pd_continue          ; all? は真では止まらない
  cpi FRAME_KIND_ANY
  jz pd_stop_true         ; any? → true
  jmp pd_stop_false       ; none? → false

  ; --- 偽だった ---
pd_falsy:
  lda adv_kind
  cpi FRAME_KIND_ALL
  jnz pd_continue         ; any? / none? は偽では止まらない
  jmp pd_stop_false       ; all? → false

pd_stop_true:
  mvi a, TT_TRUE
  jmp pd_write
pd_stop_false:
  mvi a, TT_FALSE
pd_write:
  sta pd_tag
  mvi a, 0
  call get_reg_addr       ; HL = R[0]
  lda pd_tag
  call set_slot_special
  mvi a, 1                ; 打ち切った
  ret

pd_continue:
  xra a
  ret

pd_tag: db 0

; ===============================================================
; predicate_exhausted — 最後まで打ち切られなかったときの答え
;
; **止まったときの逆**です。any? は false、all? と none? は true。
; 述語でなければ何もしません (R[0] のレシーバがそのまま値になる)。
; ===============================================================
predicate_exhausted:
  lda adv_kind
  cpi FRAME_KIND_ANY
  jc pe_ret               ; 述語ではない
  cpi FRAME_KIND_ANY
  jz pe_false             ; any? → 尽きたら false
  mvi a, TT_TRUE          ; all? / none? → 尽きたら true
  jmp pe_write
pe_false:
  mvi a, TT_FALSE
pe_write:
  sta pe_tag
  mvi a, 0
  call get_reg_addr       ; HL = R[0]
  lda pe_tag
  call set_slot_special
pe_ret:
  ret

pe_tag: db 0

; ===============================================================
; OP_STOP (Z): VM 停止
; ===============================================================
do_op_stop:
  mvi a, VM_FINISHED
  sta VM_STATE_BASE + OFF_STATUS
  ; R[1] の値を 7 セグに表示
  mvi a, 1
  call get_reg_addr       ; HL = R[1]
  call slot_to_value      ; HL = R[1] の値先頭
  call display_hex16
  jmp vm_halt

; ===============================================================
; エラー停止
;
; 未対応のオペコードを踏んだとき。
; 現在のオペコードをエラーコードとして保存する。
; ===============================================================
vm_error:
  lda VM_STATE_BASE + OFF_CURRENT_OPCODE
  sta VM_STATE_BASE + OFF_ERROR
  mvi a, VM_ERROR
  sta VM_STATE_BASE + OFF_STATUS
  jmp vm_halt

; ===============================================================
; 停止 — ND80Z モニタのリモートモードへ復帰
;
; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
; これにより自動的にリモートモードへ復帰する。
; エミュレータでは ROM 領域へのジャンプを検出して停止する。
; ===============================================================
vm_halt:
  ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
  ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
  ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
  mvi b, 4
vm_halt_outer:
  lxi d, 0
vm_halt_inner:
  dcx d
  mov a, d
  ora e
  jnz vm_halt_inner
  dcr b
  jnz vm_halt_outer
  jmp 00821h        ; N80MON2D REMOTE: リモートモード再入口

; ===============================================================
; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
; ===============================================================

; ===============================================================
; メインループ (fetch-decode-execute)
; ===============================================================
vm_loop:
  ; --- 実行状態の確認 ---
  lda VM_STATE_BASE + OFF_STATUS
  cpi VM_RUNNING
  jnz vm_halt

  ; --- PC がバイトコード長を超えていないか ---
  lhld VM_STATE_BASE + OFF_PC
  xchg                      ; DE = PC
  lhld VM_STATE_BASE + OFF_BYTECODE_LEN
  ; HL = bytecode_len, DE = PC
  ; PC >= bytecode_len ならエラー
  mov a, e
  sub l
  mov a, d
  sbb h                     ; DE - HL (PC - len)
  jnc vm_error               ; PC >= len → エラー

  ; --- オペコードフェッチ ---
  call fetch_byte           ; A = opcode
  sta VM_STATE_BASE + OFF_CURRENT_OPCODE

  ; --- ステップカウント ---
  lhld VM_STATE_BASE + OFF_STEP_COUNT
  inx h
  shld VM_STATE_BASE + OFF_STEP_COUNT
  ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
  mov a, h
  ora l
  jnz vm_dispatch
  lhld VM_STATE_BASE + OFF_STEP_COUNT + 2
  inx h
  shld VM_STATE_BASE + OFF_STEP_COUNT + 2

  ; --- ディスパッチ ---
vm_dispatch:
  lda VM_STATE_BASE + OFF_CURRENT_OPCODE
  ; オペコード × 2 でジャンプテーブルのオフセットを求める
  add a                     ; A = opcode * 2 (テーブルエントリは 2 バイト)
  jc vm_error               ; オーバーフロー → 未対応
  mov e, a
  mvi d, 0                  ; DE = opcode * 2
  lxi h, dispatch_table
  dad d                     ; HL = &dispatch_table[opcode]
  ; テーブル上限チェック
  lxi d, dispatch_table_end
  mov a, e
  sub l
  mov a, d
  sbb h                     ; DE - HL → dispatch_table_end - 現在位置
  jc vm_error               ; テーブル範囲外
  ; アドレスを読んでジャンプ
  mov e, m                  ; E = 下位バイト
  inx h
  mov d, m                  ; D = 上位バイト
  xchg                      ; HL = ハンドラアドレス
  ; 0000h ならエラー (未実装マーカー)
  mov a, h
  ora l
  jz vm_error
  pchl                      ; ハンドラへジャンプ

; ===============================================================
; ディスパッチテーブル
;
; オペコード番号順に 2 バイトのアドレスを並べる。
; 未実装のオペコードは 0000h (vm_error で捕捉)。
; ===============================================================
dispatch_table:
  dw do_op_nop        ; 00 OP_NOP
  dw do_op_move       ; 01 OP_MOVE
  dw 0000h            ; 02 OP_LOADL
  dw do_op_loadi      ; 03 OP_LOADI
  dw do_op_loadineg   ; 04 OP_LOADINEG
  dw do_op_loadi__1   ; 05 OP_LOADI__1
  dw do_op_loadi_0    ; 06 OP_LOADI_0
  dw do_op_loadi_1    ; 07 OP_LOADI_1
  dw do_op_loadi_2    ; 08 OP_LOADI_2
  dw do_op_loadi_3    ; 09 OP_LOADI_3
  dw do_op_loadi_4    ; 0A OP_LOADI_4
  dw do_op_loadi_5    ; 0B OP_LOADI_5
  dw do_op_loadi_6    ; 0C OP_LOADI_6
  dw do_op_loadi_7    ; 0D OP_LOADI_7
  dw do_op_loadi16    ; 0E OP_LOADI16
  dw 0000h            ; 0F OP_LOADI32
  dw 0000h            ; 10 OP_LOADSYM
  dw do_op_loadnil    ; 11 OP_LOADNIL
  dw do_op_loadself   ; 12 OP_LOADSELF
  dw do_op_loadt      ; 13 OP_LOADT
  dw do_op_loadf      ; 14 OP_LOADF
  dw do_op_getgv      ; 15 OP_GETGV
  dw do_op_setgv      ; 16 OP_SETGV
  dw 0000h            ; 17 OP_GETSV
  dw 0000h            ; 18 OP_SETSV
  dw do_op_getgv      ; 19 OP_GETIV (= OP_GETGV)
  dw do_op_setgv      ; 1A OP_SETIV (= OP_SETGV)
  dw do_op_getgv      ; 1B OP_GETCV (= OP_GETGV)
  dw do_op_setgv      ; 1C OP_SETCV (= OP_SETGV)
  dw do_op_getconst   ; 1D OP_GETCONST
  dw do_op_setgv      ; 1E OP_SETCONST (= OP_SETGV)
  dw 0000h            ; 1F OP_GETMCNST
  dw 0000h            ; 20 OP_SETMCNST
  dw do_op_getupvar   ; 21 OP_GETUPVAR
  dw do_op_setupvar   ; 22 OP_SETUPVAR
  dw do_op_getidx     ; 23 OP_GETIDX
  dw do_op_setidx     ; 24 OP_SETIDX
  dw do_op_jmp        ; 25 OP_JMP
  dw do_op_jmpif      ; 26 OP_JMPIF
  dw do_op_jmpnot     ; 27 OP_JMPNOT
  dw 0000h            ; 28 OP_JMPNIL
  dw do_op_jmp        ; 29 OP_JMPUW (= OP_JMP)
  dw 0000h            ; 2A OP_EXCEPT
  dw 0000h            ; 2B OP_RESCUE
  dw 0000h            ; 2C OP_RAISEIF
  dw do_op_ssend      ; 2D OP_SSEND
  dw do_op_ssendb     ; 2E OP_SSENDB
  dw do_op_send       ; 2F OP_SEND
  dw do_op_sendb      ; 30 OP_SENDB
  dw 0000h            ; 31 OP_CALL
  dw 0000h            ; 32 OP_SUPER
  dw 0000h            ; 33 OP_ARGARY
  dw do_op_enter      ; 34 OP_ENTER
  dw 0000h            ; 35 OP_KEY_P
  dw 0000h            ; 36 OP_KEYEND
  dw 0000h            ; 37 OP_KARG
  dw do_op_return     ; 38 OP_RETURN
  dw 0000h            ; 39 OP_RETURN_BLK
  dw do_op_break      ; 3A OP_BREAK
  dw 0000h            ; 3B OP_BLKPUSH
  dw do_op_add        ; 3C OP_ADD
  dw do_op_addi       ; 3D OP_ADDI
  dw do_op_sub        ; 3E OP_SUB
  dw do_op_subi       ; 3F OP_SUBI
  dw do_op_mul        ; 40 OP_MUL
  dw do_op_div        ; 41 OP_DIV
  dw do_op_eq         ; 42 OP_EQ
  dw do_op_lt         ; 43 OP_LT
  dw do_op_le         ; 44 OP_LE
  dw do_op_gt         ; 45 OP_GT
  dw do_op_ge         ; 46 OP_GE
  dw do_op_array      ; 47 OP_ARRAY
  dw do_op_array2     ; 48 OP_ARRAY2
  dw 0000h            ; 49 OP_ARYCAT
  dw do_op_arypush    ; 4A OP_ARYPUSH
  dw 0000h            ; 4B OP_ARYSPLAT
  dw 0000h            ; 4C OP_AREF
  dw 0000h            ; 4D OP_ASET
  dw 0000h            ; 4E OP_APOST
  dw 0000h            ; 4F OP_INTERN
  dw 0000h            ; 50 OP_SYMBOL
  dw do_op_string     ; 51 OP_STRING
  dw do_op_strcat     ; 52 OP_STRCAT
  dw do_op_hash       ; 53 OP_HASH
  dw 0000h            ; 54 OP_HASHADD
  dw 0000h            ; 55 OP_HASHCAT
  dw 0000h            ; 56 OP_LAMBDA
  dw do_op_block      ; 57 OP_BLOCK
  dw do_op_method     ; 58 OP_METHOD
  dw 0000h            ; 59 OP_RANGE_INC
  dw 0000h            ; 5A OP_RANGE_EXC
  dw 0000h            ; 5B OP_OCLASS
  dw do_op_class      ; 5C OP_CLASS
  dw 0000h            ; 5D OP_MODULE
  dw do_op_exec       ; 5E OP_EXEC
  dw do_op_def        ; 5F OP_DEF
  dw 0000h            ; 60 OP_ALIAS
  dw 0000h            ; 61 OP_UNDEF
  dw 0000h            ; 62 OP_SCLASS
  dw do_op_tclass     ; 63 OP_TCLASS
  dw 0000h            ; 64 OP_DEBUG
  dw 0000h            ; 65 OP_ERR
  dw 0000h            ; 66 OP_EXT1
  dw 0000h            ; 67 OP_EXT2
  dw 0000h            ; 68 OP_EXT3
  dw do_op_stop       ; 69 OP_STOP
dispatch_table_end:

; ===============================================================
; clear_pages — B ページ (256 バイト × B) をゼロクリア
;
; 入力: HL = 先頭アドレス, B = ページ数
; 破壊: A, B, C, HL
; ===============================================================
clear_pages:
  mvi c, 0              ; 256 回
clear_pages_byte:
  mvi m, 0
  inx h
  dcr c
  jnz clear_pages_byte
  dcr b
  jnz clear_pages
  ret

; ===============================================================
; 初期化 (起動時 1 回だけ)
; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
; ===============================================================
vm_start:
  ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
  lxi h, VM_STATE_BASE
  mvi b, 1
  call clear_pages

  ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
  lxi h, REG_FILE_BASE
  mvi b, 1
  call clear_pages

  ; メソッド表をゼロクリア (256 バイト = 1 ページ)
  lxi h, METHOD_TABLE_BASE
  mvi b, 1
  call clear_pages

  ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
  lxi h, OBJECT_POOL_BASE
  mvi b, 4
  call clear_pages

  ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
  lxi h, COLLECTION_POOL_BASE
  mvi b, 9
  call clear_pages

  ; IREP 0 のバイトコード長を VM 状態に設定
  ; IREP テーブルの先頭エントリから読む
  lda IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN
  sta VM_STATE_BASE + OFF_BYTECODE_LEN
  lda IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1
  sta VM_STATE_BASE + OFF_BYTECODE_LEN + 1

  ; レジスタベースを初期化 (REG_FILE_BASE)
  lxi h, REG_FILE_BASE
  shld VM_STATE_BASE + OFF_REG_BASE

  ; バイトコードベースを IREP 0 から読んで設定
  lda IREP_TABLE_BASE + IREP_OFF_BYTECODE
  sta VM_STATE_BASE + OFF_BC_BASE
  lda IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1
  sta VM_STATE_BASE + OFF_BC_BASE + 1

  ; シンボルテーブルベースを IREP 0 から読んで設定
  lda IREP_TABLE_BASE + IREP_OFF_SYM_TABLE
  sta VM_STATE_BASE + OFF_SYM_BASE
  lda IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1
  sta VM_STATE_BASE + OFF_SYM_BASE + 1

  ; 定数プールベースを IREP 0 から読んで設定
  lda IREP_TABLE_BASE + IREP_OFF_POOL
  sta VM_STATE_BASE + OFF_POOL_BASE
  lda IREP_TABLE_BASE + IREP_OFF_POOL + 1
  sta VM_STATE_BASE + OFF_POOL_BASE + 1

  ; フレーム SP = 0 (ゼロクリア済み)
  ; PC = 0 (ゼロクリア済み)

  ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
  ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
  lda INIT_METHOD_ID_STORE
  sta VM_STATE_BASE + OFF_INIT_METHOD_ID

  ; R[0] = self (TT_OBJECT, 値 = 0)
  lxi h, REG_FILE_BASE
  mvi m, TT_OBJECT      ; +0: 型タグ
  inx h
  mvi m, 0               ; +1: 予約
  inx h
  mvi m, 0               ; +2: val_lo
  inx h
  mvi m, 0               ; +3: val_hi

  ; 実行状態を RUNNING に設定
  mvi a, VM_RUNNING
  sta VM_STATE_BASE + OFF_STATUS

  ; メインループへ
  jmp vm_loop

; ===============================================================
; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
;
; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
; ===============================================================
do_op_string:
  call fetch_byte       ; A = a
  sta ops_reg_a
  call fetch_byte       ; A = b (プールインデックス)
  ; pool_base + b * 4 を計算
  add a                 ; b * 2
  add a                 ; b * 4
  mov e, a
  mvi d, 0
  lhld VM_STATE_BASE + OFF_POOL_BASE
  dad d                 ; HL = &Pool[b]
  ; Pool[b] の val (文字列データアドレス) を取得
  inx h                 ; +1: 予約
  inx h                 ; +2: val_lo
  mov e, m
  inx h                 ; +3: val_hi
  mov d, m              ; DE = 文字列データアドレス
  ; DE → 長さバイト + ASCII データ
  ldax d                ; A = 文字列長
  sta ops_str_len
  inx d                 ; DE → 最初のバイト
  push d                ; 文字列データソース退避

  ; コレクションスロットを確保
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta ops_slot_num

  ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
  mvi m, COL_TYPE_STRING ; +0: type
  inx h
  lda ops_str_len
  cpi COL_MAX_STRING_LEN + 1
  jc ops_len_ok
  mvi a, COL_MAX_STRING_LEN  ; 最大 30 文字に切り詰め
ops_len_ok:
  mov m, a              ; +1: count
  sta ops_str_len       ; 切り詰め後の長さ
  inx h                 ; HL → データ領域先頭

  ; 文字列データをコピー
  pop d                 ; DE = ソースデータ
  lda ops_str_len
  ora a
  jz ops_set_reg        ; 空文字列
  mov c, a
ops_str_copy:
  ldax d
  mov m, a
  inx h
  inx d
  dcr c
  jnz ops_str_copy

ops_set_reg:
  ; R[a] = TT_STRING, val_lo = slot+1
  lda ops_reg_a
  call get_reg_addr     ; HL = &R[a]
  mvi m, TT_STRING      ; +0: 型タグ
  inx h
  mvi m, 0              ; +1: 予約
  inx h
  lda ops_slot_num
  inr a                 ; slot + 1
  mov m, a              ; +2: val_lo
  inx h
  mvi m, 0              ; +3: val_hi
  jmp vm_loop

ops_reg_a:   db 0
ops_str_len: db 0
ops_slot_num: db 0

; ===============================================================
; send_display — display(value): 7 セグに hex 表示
;
; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
; R[a] に nil を返す。
; ===============================================================
send_display:
  lda send_reg_a
  inr a
  call get_reg_addr      ; HL = R[a+1]
  call slot_to_value     ; HL = 値先頭
  call display_hex16     ; 7 セグに書く
  ; return nil
  lda send_reg_a
  call get_reg_addr
  mvi a, TT_NIL
  call set_slot_special
  jmp vm_loop

; ===============================================================
; send_getkey — getkey / getkey(timeout)
;
; getkey (引数なし): KEYIN1 でブロッキング入力
;   ROM なし → -1
;   キー押下 → キーコード (0x00-0x17)
;
; getkey(n) (引数あり): KEY でノンブロッキングポーリング
;   最大 n 回スキャン、キー押下 → キーコード
;   タイムアウト / ROM なし → nil
;
; キーコード割り当て (KEYIN1/KEY 共通):
;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
;                                           0x17: LOAD
; ===============================================================
send_getkey:
  ; 引数ありならタイムアウト版へ (オーバーフロー領域)
  lda send_argc
  ora a
  jnz send_getkey_timeout

  ; --- ブロッキング版 (引数なし) ---
  lda KEYIN1_ADDR       ; ROM 先頭バイト
  ora a
  jz getkey_no_key      ; ROM なし → -1

  ; キー入力をポーリングしながら LFSR を回す。
  ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
  ; 乱数の種が毎回異なる。
getkey_poll:
  call KEY_ADDR         ; A = キーコード (0xFF = なし)
  cpi 0FFh
  jnz getkey_got_key
  call lfsr_next        ; 待機中に LFSR を進める
  jmp getkey_poll

getkey_got_key:
  ; キーコードを R[a] に返す
  mov c, a
  mvi b, 0
  lda send_reg_a
  call get_reg_addr
  call set_slot_int16
  jmp vm_loop

getkey_no_key:
  lda send_reg_a
  call get_reg_addr
  mvi b, 0FFh
  mvi c, 0FFh           ; -1
  call set_slot_int16
  jmp vm_loop

; ===============================================================
; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
;
; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
; E レジスタにメソッド ID が入っている。
; ===============================================================
send_builtin_ext:
  mov a, e
  cpi METHOD_PUTS
  jz send_puts
  cpi METHOD_SETSEG
  jz send_setseg
  cpi METHOD_RAND
  jz send_rand
  cpi METHOD_LENGTH
  jz send_length
  cpi METHOD_CONCAT
  jz send_concat
  cpi METHOD_PUSH
  jz concat_array       ; push は concat_array と同じ
  cpi METHOD_SLICE
  jz send_slice
  jmp vm_error          ; 未対応メソッド

; ===============================================================
; send_puts — puts(value): 文字列を 7 セグに表示
;
; R[a+1] が TT_STRING の場合:
;   文字列データのアドレスから長さとバイト列を読み、
;   各 ASCII コードを 7 セグパターンに変換して表示する。
;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
;
; R[a+1] が TT_INTEGER の場合:
;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
;   表示バッファは左に 2 桁スクロールする (従来互換)。
;
; 使い方:
;   puts "HELLO"          # 文字列を表示
;   puts(0x4849)          # "HI" を表示 (整数パック)
; ===============================================================
send_puts:
  lda send_reg_a
  inr a
  call get_reg_addr      ; HL = R[a+1]
  mov a, m               ; A = 型タグ
  cpi TT_STRING
  jz puts_string
  ; TT_INTEGER: 従来のパック ASCII 処理
  cpi TT_INTEGER
  jnz vm_error

  ; --- 整数パス (2 文字スクロール表示) ---
  lda send_reg_a
  inr a
  call get_reg_addr
  call slot_to_value     ; HL = 値先頭 (val_lo)
  mov c, m               ; C = val_lo (右の文字)
  inx h
  mov b, m               ; B = val_hi (左の文字)
  push b

  ; 表示バッファを左に 2 桁スクロール
  lxi h, DISPLAY_BASE + 2
  lxi d, DISPLAY_BASE
  mvi b, 6
puts_scroll:
  mov a, m
  stax d
  inx h
  inx d
  dcr b
  jnz puts_scroll

  pop b
  push b
  mov a, b
  call ascii_to_seg
  sta DISPLAY_BASE + 6

  pop b
  mov a, c
  call ascii_to_seg
  sta DISPLAY_BASE + 7
  jmp puts_ret_nil

  ; --- 文字列パス (全桁クリア + 左詰め表示) ---
puts_string:
  lda send_reg_a
  inr a
  call get_reg_addr      ; HL = R[a+1]
  call col_from_reg      ; HL = コレクションスロットアドレス

  ; +1: count (文字列長)
  inx h
  mov a, m               ; A = 文字列長
  ora a
  jz puts_ret_nil        ; 空文字列 → nil を返すだけ
  cpi 9
  jc sp_len_ok
  mvi a, 8               ; 最大 8 文字
sp_len_ok:
  sta sp_count
  inx h                  ; HL → データ領域先頭
  shld sp_src            ; 文字列ソースポインタ退避

  ; 表示バッファ全体をクリア
  lxi h, DISPLAY_BASE
  mvi c, DISPLAY_SIZE
puts_str_clear:
  mvi m, 0
  inx h
  dcr c
  jnz puts_str_clear

  ; 文字列の各バイトを変換して表示
  lxi h, DISPLAY_BASE
  shld sp_dst            ; 表示書き込みポインタ
puts_str_loop:
  lhld sp_src
  mov a, m               ; A = ASCII コード
  inx h
  shld sp_src
  call ascii_to_seg      ; A = セグメントパターン (HL, BC 破壊)
  lhld sp_dst
  mov m, a
  inx h
  shld sp_dst
  lda sp_count
  dcr a
  sta sp_count
  jnz puts_str_loop

puts_ret_nil:
  lda send_reg_a
  call get_reg_addr
  mvi a, TT_NIL
  call set_slot_special
  jmp vm_loop

sp_count: db 0
sp_src:   dw 0
sp_dst:   dw 0

; ===============================================================
; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
;
; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
; ===============================================================
send_setseg:
  ; 桁位置を取得
  lda send_reg_a
  inr a
  call get_reg_addr      ; HL = R[a+1]
  call slot_to_value
  mov a, m               ; A = 桁位置 (val_lo)
  cpi DISPLAY_SIZE
  jnc vm_error           ; 桁位置 >= 8 → エラー
  sta ss_pos

  ; パターンを取得
  lda send_reg_a
  inr a
  inr a
  call get_reg_addr      ; HL = R[a+2]
  call slot_to_value
  mov b, m               ; B = パターン (val_lo)

  ; DISPLAY_BASE + pos にパターンを書く
  lda ss_pos
  mov l, a
  mvi h, 0
  lxi d, DISPLAY_BASE
  dad d                  ; HL = DISPLAY_BASE + pos
  mov m, b

  ; R[a] に nil を返す
  lda send_reg_a
  call get_reg_addr
  mvi a, TT_NIL
  call set_slot_special
  jmp vm_loop

ss_pos: db 0

; ===============================================================
; ascii_to_seg — ASCII コードを 7 セグパターンに変換
;
;   入力: A = ASCII コード
;   出力: A = セグメントパターン
;   破壊: HL, BC
;
; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
; 0x20-0x5F は 64 エントリのテーブルで変換する。
; 範囲外はブランク (0x00) を返す。
; ===============================================================
ascii_to_seg:
  cpi 60h
  jc ats_no_fold
  sui 20h               ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
ats_no_fold:
  sui 20h               ; 0x20-0x5F → 0x00-0x3F
  jc ats_blank           ; 元が < 0x20 → ブランク
  cpi 40h
  jnc ats_blank          ; >= 64 → ブランク
  ; テーブル参照
  mov l, a
  mvi h, 0
  lxi b, ascii_seg_table
  dad b                  ; HL = ascii_seg_table + index
  mov a, m
  ret
ats_blank:
  xra a                  ; A = 0 (ブランク)
  ret

; ===============================================================
; ASCII → 7 セグパターン変換テーブル (64 エントリ)
;
; ASCII 0x20 (' ') から 0x5F ('_') まで。
; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
;
; セグメント配置:
;     aaa        bit 0 = a (上)
;    f   b       bit 1 = b (右上)
;     ggg        bit 2 = c (右下)
;    e   c       bit 3 = d (下)
;     ddd        bit 4 = e (左下)
;                bit 5 = f (左上)
;                bit 6 = g (中)
;
; 表現できない文字は 0x00 (消灯)。
; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
; ===============================================================
ascii_seg_table:
  ; 0x20-0x2F: 記号
  db 00h          ; 0x20 ' ' (スペース)
  db 06h          ; 0x21 '!' (bc)
  db 22h          ; 0x22 '"' (bf)
  db 63h          ; 0x23 '#' (abfg = 上の丸 °)
  db 6Dh          ; 0x24 '$' (= S)
  db 58h          ; 0x25 '%' (deg = 小文字 c)
  db 4Ch          ; 0x26 '&' (cdg = 反転 c)
  db 02h          ; 0x27 "'" (b)
  db 39h          ; 0x28 '(' (= C)
  db 0Fh          ; 0x29 ')' (abcd)
  db 49h          ; 0x2A '*' (adg = 三)
  db 41h          ; 0x2B '+' (ag = 三の下なし)
  db 04h          ; 0x2C ',' (c)
  db 40h          ; 0x2D '-' (g)
  db 08h          ; 0x2E '.' (d)
  db 61h          ; 0x2F '/' (afg = 上の c)
  ; 0x30-0x39: 数字 (ND8080 ROM パターン)
  db 5Ch          ; 0x30 '0'
  db 06h          ; 0x31 '1'
  db 5Bh          ; 0x32 '2'
  db 4Fh          ; 0x33 '3'
  db 66h          ; 0x34 '4'
  db 6Dh          ; 0x35 '5'
  db 7Dh          ; 0x36 '6'
  db 27h          ; 0x37 '7'
  db 7Fh          ; 0x38 '8'
  db 6Fh          ; 0x39 '9'
  ; 0x3A-0x40: 記号
  db 09h          ; 0x3A ':' (ad)
  db 00h          ; 0x3B ';'
  db 00h          ; 0x3C '<'
  db 48h          ; 0x3D '=' (dg)
  db 00h          ; 0x3E '>'
  db 23h          ; 0x3F '?' (abf = 上コの字)
  db 5Ch          ; 0x40 '@' (cdeg = 下の丸)
  ; 0x41-0x5A: 英字
  db 77h          ; 0x41 'A' (abcefg)
  db 7Ch          ; 0x42 'B' (cdefg = b)
  db 39h          ; 0x43 'C' (adef)
  db 5Eh          ; 0x44 'D' (bcdeg = d)
  db 79h          ; 0x45 'E' (adefg)
  db 71h          ; 0x46 'F' (aefg)
  db 3Dh          ; 0x47 'G' (acdef)
  db 76h          ; 0x48 'H' (bcefg)
  db 06h          ; 0x49 'I' (bc)
  db 1Eh          ; 0x4A 'J' (bcde)
  db 74h          ; 0x4B 'K' (cefg = h)
  db 38h          ; 0x4C 'L' (def)
  db 55h          ; 0x4D 'M' (aceg = n + ~)
  db 54h          ; 0x4E 'N' (ceg = n)
  db 5Ch          ; 0x4F 'O' (= 0)
  db 73h          ; 0x50 'P' (abefg)
  db 67h          ; 0x51 'Q' (abcfg)
  db 50h          ; 0x52 'R' (eg = r)
  db 6Dh          ; 0x53 'S' (= 5)
  db 78h          ; 0x54 'T' (defg = t)
  db 1Ch          ; 0x55 'U' (cde = 小文字 u)
  db 3Eh          ; 0x56 'V' (= U)
  db 7Eh          ; 0x57 'W' (bcdefg = 逆 A)
  db 76h          ; 0x58 'X' (bcefg = H)
  db 6Eh          ; 0x59 'Y' (bcdfg)
  db 5Bh          ; 0x5A 'Z' (= 2)
  ; 0x5B-0x5F: 記号
  db 39h          ; 0x5B '[' (= C)
  db 00h          ; 0x5C '\'
  db 0Fh          ; 0x5D ']' (= ))
  db 01h          ; 0x5E '^' (a = 上一本, ~ もここに折畳)
  db 08h          ; 0x5F '_' (d)

; ===============================================================
; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
;
;   入力: なし
;   出力: HL = 新しい乱数値
;   破壊: A, HL
;
; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
; 周期: 65535
; ===============================================================
lfsr_next:
  lhld lfsr_state
  mov a, l
  ani 1               ; LSB チェック
  jz lfsr_no_tap
  ; LSB=1: 右シフト + XOR タップ
  mov a, h
  ora a               ; CY=0 クリア
  rar
  mov h, a
  mov a, l
  rar
  mov l, a
  mov a, h
  xri 0B4h
  mov h, a
  shld lfsr_state
  ret
lfsr_no_tap:
  ; LSB=0: 右シフトのみ
  mov a, h
  ora a
  rar
  mov h, a
  mov a, l
  rar
  mov l, a
  shld lfsr_state
  ret

lfsr_state:  dw 0ACE1h  ; 初期シード (0 以外)

; ===============================================================
; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
;
; R[a+1] = n (上限)。n == 0 なら 0 を返す。
; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
; ===============================================================
send_rand:
  ; R[a+1] から n を取得
  lda send_reg_a
  inr a
  call get_reg_addr    ; HL = R[a+1]
  call slot_to_value   ; HL = 値先頭
  mov e, m
  inx h
  mov d, m             ; DE = n

  ; n == 0 チェック
  mov a, d
  ora e
  jz rand_zero

  push d               ; n を退避
  call lfsr_next       ; HL = 乱数
  mov b, h
  mov c, l             ; BC = 乱数 (被除数)
  pop d                ; DE = n (除数)
  call udiv16          ; BC=商, HL=剰余

  ; HL (剰余) → BC → R[a]
  mov b, h
  mov c, l
  lda send_reg_a
  call get_reg_addr
  call set_slot_int16
  jmp vm_loop

rand_zero:
  mvi b, 0
  mvi c, 0
  lda send_reg_a
  call get_reg_addr
  call set_slot_int16
  jmp vm_loop

; ===============================================================
; コレクションプール基盤ルーチン
; ===============================================================

; ---------------------------------------------------------------
; col_slot_addr — スロット番号からアドレスを計算
;
;   入力: A = スロット番号 (0-based)
;   出力: HL = COLLECTION_POOL_BASE + slot * 36
;   破壊: A, DE
; ---------------------------------------------------------------
col_slot_addr:
  ; slot_number * 36 = slot_number * 32 + slot_number * 4
  ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
  mov l, a
  mvi h, 0              ; HL = slot_number
  dad h                 ; HL = slot_number × 2
  dad h                 ; HL = slot_number × 4
  mov d, h
  mov e, l              ; DE = slot_number × 4 (退避)
  dad h                 ; HL = slot_number × 8
  dad h                 ; HL = slot_number × 16
  dad h                 ; HL = slot_number × 32
  dad d                 ; HL = slot_number × 36
  lxi d, COLLECTION_POOL_BASE
  dad d
  ret

; ---------------------------------------------------------------
; col_alloc — コレクションスロットを確保
;
;   入力: なし
;   出力: A = スロット番号 (0-based), HL = スロットアドレス
;   破壊: DE
;   エラー: プール満杯かつ GC で回収不可 → vm_error
; ---------------------------------------------------------------
col_alloc:
  lda VM_STATE_BASE + OFF_COL_SP
  cpi MAX_COL_SLOTS
  jnc col_gc_alloc      ; プール満杯 → GC 試行
  push psw              ; スロット番号を退避
  call col_slot_addr    ; HL = スロットアドレス
  ; COL_SP++
  lda VM_STATE_BASE + OFF_COL_SP
  inr a
  sta VM_STATE_BASE + OFF_COL_SP
  pop psw               ; A = スロット番号
  ret

; ---------------------------------------------------------------
; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
;
;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
;   出力: HL = コレクションスロットアドレス
;   破壊: A, DE
; ---------------------------------------------------------------
col_from_reg:
  call slot_to_value    ; HL = val アドレス
  mov a, m              ; A = val_lo = slot+1
  dcr a                 ; A = slot_number (0-based)
  jmp col_slot_addr

; ===============================================================
; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
;
; R[a] の型で分岐:
;   TT_STRING: 1 文字を新しい文字列スロットとして返す
;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
; ===============================================================
do_op_getidx:
  call fetch_byte       ; A = a
  sta gidx_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m              ; A = 型タグ
  cpi TT_STRING
  jz gidx_string
  cpi TT_ARRAY
  jz gidx_array
  cpi TT_HASH
  jz gidx_hash
  jmp vm_error

gidx_string:
  ; R[a] のコレクションスロットを取得
  lda gidx_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov b, m              ; B = 文字列長
  inx h                 ; HL → データ領域先頭
  shld gidx_data_addr

  ; R[a+1] からインデックスを取得
  lda gidx_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = index (val_lo)
  ; 範囲チェック: index < 文字列長
  cmp b
  jnc vm_error          ; index >= 長さ → エラー
  ; データ先頭 + index で 1 文字を取得
  mov e, a
  mvi d, 0
  lhld gidx_data_addr
  dad d                 ; HL = &data[index]
  mov c, m              ; C = 文字コード

  ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
  push b                ; C = 文字コード退避
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta gidx_new_slot
  mvi m, COL_TYPE_STRING ; +0: type
  inx h
  mvi m, 1              ; +1: count = 1
  inx h
  pop b
  mov m, c              ; +2: data[0] = 文字コード

  ; R[a] = TT_STRING, val_lo = new_slot+1
  lda gidx_reg_a
  call get_reg_addr
  mvi m, TT_STRING
  inx h
  mvi m, 0
  inx h
  lda gidx_new_slot
  inr a
  mov m, a
  inx h
  mvi m, 0
  jmp vm_loop

gidx_array:
  ; R[a] のコレクションスロットを取得
  lda gidx_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov b, m              ; B = 要素数
  inx h                 ; HL → データ領域先頭
  shld gidx_data_addr

  ; R[a+1] からインデックスを取得
  lda gidx_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = index (val_lo)
  ; 範囲チェック: index < 要素数
  cmp b
  jnc vm_error
  ; data + index * 4 で要素スロットの先頭を求める
  add a                 ; ×2
  add a                 ; ×4
  mov e, a
  mvi d, 0
  lhld gidx_data_addr
  dad d                 ; HL = &data[index * 4] (コピー元)
  xchg                  ; DE = &data[index * 4]

  ; R[a] にコピー (4 バイト)
  lda gidx_reg_a
  call get_reg_addr     ; HL = R[a] (コピー先)
  mvi c, SLOT_BYTES
gidx_ary_copy:
  ldax d
  mov m, a
  inx h
  inx d
  dcr c
  jnz gidx_ary_copy
  jmp vm_loop

gidx_reg_a:    db 0
gidx_data_addr: dw 0
gidx_new_slot: db 0

; ===============================================================
; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
;
; R[a] の型で分岐:
;   TT_STRING: インデックス位置に 1 文字を書き込む
;   TT_ARRAY:  インデックス位置にスロットをコピー
; ===============================================================
do_op_setidx:
  call fetch_byte       ; A = a
  sta sidx_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m              ; A = 型タグ
  cpi TT_STRING
  jz sidx_string
  cpi TT_ARRAY
  jz sidx_array
  cpi TT_HASH
  jz sidx_hash
  jmp vm_error

sidx_string:
  ; R[a] のコレクションスロットを取得
  lda sidx_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov b, m              ; B = 文字列長
  inx h                 ; HL → データ領域先頭
  shld sidx_data_addr

  ; R[a+1] からインデックスを取得
  lda sidx_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = index
  cmp b
  jnc vm_error          ; index >= 長さ

  ; data[index] に R[a+2] の文字を書き込む
  mov e, a
  mvi d, 0
  lhld sidx_data_addr
  dad d                 ; HL = &data[index]

  ; R[a+2] から文字コードを取得
  lda sidx_reg_a
  inr a
  inr a
  call get_reg_addr
  ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
  mov a, m              ; 型タグ
  cpi TT_STRING
  jz sidx_str_char
  ; TT_INTEGER: val_lo を文字コードとして使う
  call slot_to_value
  mov a, m
  jmp sidx_write_char
sidx_str_char:
  ; TT_STRING: コレクションスロットの先頭文字
  call col_from_reg
  inx h                 ; +1: count
  inx h                 ; +2: data[0]
  mov a, m
sidx_write_char:
  lhld sidx_data_addr
  mov e, a              ; E = 文字コード
  lda sidx_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = index
  mov c, a
  mvi b, 0
  lhld sidx_data_addr
  dad b                 ; HL = &data[index]
  mov m, e              ; 書き込み
  jmp vm_loop

sidx_array:
  ; R[a] のコレクションスロットを取得
  lda sidx_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov b, m              ; B = 要素数
  inx h                 ; HL → データ領域先頭
  shld sidx_data_addr

  ; R[a+1] からインデックスを取得
  lda sidx_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = index
  cmp b
  jnc vm_error

  ; data[index * 4] に R[a+2] をコピー
  add a                 ; ×2
  add a                 ; ×4
  mov e, a
  mvi d, 0
  lhld sidx_data_addr
  dad d                 ; HL = &data[index * 4] (コピー先)
  xchg                  ; DE = コピー先

  ; R[a+2] を取得 (コピー元)
  lda sidx_reg_a
  inr a
  inr a
  call get_reg_addr     ; HL = R[a+2]
  mvi c, SLOT_BYTES
sidx_ary_copy:
  mov a, m
  stax d
  inx h
  inx d
  dcr c
  jnz sidx_ary_copy
  jmp vm_loop

sidx_reg_a:    db 0
sidx_data_addr: dw 0

; ===============================================================
; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
;
; b 個のレジスタからコレクションプールに配列を構築する。
; ===============================================================
do_op_array:
  call fetch_byte       ; A = a
  sta oary_reg_a
  sta oary_src_reg      ; BB 形式: ソース = a
  call fetch_byte       ; A = b (要素数)
oa2_join:               ; OP_ARRAY2 からの合流点
  sta oary_count
  ora a
  jz oary_empty         ; 空配列

  ; 要素数チェック
  cpi COL_MAX_ARRAY_ELEMS + 1
  jnc vm_error          ; 要素数 > 7

  ; コレクションスロットを確保
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta oary_slot_num
  mvi m, COL_TYPE_ARRAY ; +0: type
  inx h
  lda oary_count
  mov m, a              ; +1: count
  inx h                 ; HL → データ領域先頭
  xchg                  ; DE = データ領域先頭 (コピー先)

  ; ソースレジスタから b 個のスロットをコピー
  lda oary_src_reg
  mov b, a              ; B = 現在のレジスタ番号
  lda oary_count
  mov c, a              ; C = 残り要素数
oary_copy_loop:
  mvi a, SLOT_BYTES
  sta oary_elem_cnt     ; 毎回初期化 (2 回目以降のため)
  push b
  push d
  mov a, b
  call get_reg_addr     ; HL = R[reg] (コピー元)
  pop d
oary_copy_elem:
  mov b, m              ; SLOT_BYTES 分のコピー (HL → DE)
  inx h
  mov a, b
  stax d
  inx d
  push h
  lxi h, oary_elem_cnt
  dcr m
  pop h
  jnz oary_copy_elem
  pop b
  inr b                 ; 次のレジスタ
  dcr c
  jz oary_done
  jmp oary_copy_loop

oary_done:
  ; R[a] = TT_ARRAY, val_lo = slot+1
  lda oary_reg_a
  call get_reg_addr
  mvi m, TT_ARRAY
  inx h
  mvi m, 0
  inx h
  lda oary_slot_num
  inr a
  mov m, a
  inx h
  mvi m, 0
  jmp vm_loop

oary_empty:
  ; 空配列: スロット確保して count=0
  call col_alloc
  sta oary_slot_num
  mvi m, COL_TYPE_ARRAY
  inx h
  mvi m, 0              ; count = 0
  jmp oary_done

oary_reg_a:    db 0
oary_src_reg:  db 0
oary_count:    db 0
oary_slot_num: db 0
oary_elem_cnt: db SLOT_BYTES

; ===============================================================
; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
;
; R[a] の配列の末尾に要素を追加する。
; ===============================================================
do_op_arypush:
  call fetch_byte       ; A = a
  sta apush_reg_a
  call fetch_byte       ; A = b (追加する要素数)
  sta apush_add_count

  ; R[a] のコレクションスロットを取得
  lda apush_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov a, m              ; A = 現在の要素数
  sta apush_cur_count
  ; 容量チェック: count + add_count <= MAX
  lda apush_add_count
  mov b, a
  lda apush_cur_count
  add b
  cpi COL_MAX_ARRAY_ELEMS + 1
  jnc vm_error          ; オーバーフロー

  ; 書き込み先: data + count * 4
  lda apush_cur_count
  add a                 ; ×2
  add a                 ; ×4
  mov e, a
  mvi d, 0
  inx h                 ; HL → データ領域先頭
  dad d                 ; HL = 書き込み位置
  xchg                  ; DE = 書き込み位置

  ; R[a+1] から b 個のスロットをコピー
  lda apush_reg_a
  inr a
  mov b, a              ; B = 現在のレジスタ番号
  lda apush_add_count
  mov c, a              ; C = 残り要素数
apush_loop:
  mvi a, SLOT_BYTES
  sta apush_byte_cnt    ; 毎回初期化
  push b
  push d
  mov a, b
  call get_reg_addr     ; HL = R[reg]
  pop d
apush_copy:
  mov b, m
  mov a, b
  stax d
  inx h
  inx d
  push h
  lxi h, apush_byte_cnt
  dcr m
  pop h
  jnz apush_copy
  pop b
  inr b
  dcr c
  jz apush_done
  jmp apush_loop

apush_done:
  ; count を更新
  lda apush_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  lda apush_cur_count
  mov b, a
  lda apush_add_count
  add b
  mov m, a              ; count = old + added
  jmp vm_loop

apush_reg_a:     db 0
apush_add_count: db 0
apush_cur_count: db 0
apush_byte_cnt:  db SLOT_BYTES

; ===============================================================
; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
;
; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
; ===============================================================
do_op_strcat:
  call fetch_byte       ; A = a
  sta scat_reg_a
strcat_body:            ; OP_ADD 文字列パスからも使う (A = a)

  ; R[a+1] のコレクションスロット (ソース)
  inr a
  call get_reg_addr
  call col_from_reg     ; HL = ソーススロット
  inx h                 ; +1: count
  mov a, m              ; A = ソース文字列長
  sta scat_src_len
  inx h                 ; HL → データ先頭
  shld scat_src_data

  ; R[a] のコレクションスロット (デスト)
  lda scat_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = デストスロット
  inx h                 ; +1: count
  mov a, m              ; A = デスト文字列長
  sta scat_dst_len

  ; 合計長チェック
  lda scat_src_len
  mov b, a
  lda scat_dst_len
  add b
  cpi COL_MAX_STRING_LEN + 1
  jc scat_len_ok
  ; 切り詰め: 追記できる分だけ
  mvi a, COL_MAX_STRING_LEN
  mov b, a
  lda scat_dst_len
  sub b                 ; この結果は負 (使わない)
  mvi a, COL_MAX_STRING_LEN
  mov b, a
  lda scat_dst_len
  mov c, a
  mov a, b
  sub c                 ; A = MAX - dst_len = コピー可能バイト数
  sta scat_src_len
  ; 合計を MAX に
  mvi a, COL_MAX_STRING_LEN
scat_len_ok:
  sta scat_total_len

  ; デスト count を更新
  lda scat_reg_a
  call get_reg_addr
  call col_from_reg
  inx h
  lda scat_total_len
  mov m, a              ; count = 合計長
  inx h                 ; HL → データ先頭

  ; デストデータ末尾 = data + dst_len
  lda scat_dst_len
  mov e, a
  mvi d, 0
  dad d                 ; HL = 書き込み位置

  ; ソースデータをコピー
  xchg                  ; DE = 書き込み位置
  lhld scat_src_data    ; HL = ソースデータ
  lda scat_src_len
  ora a
  jz scat_done
  mov c, a
scat_copy:
  mov a, m
  stax d
  inx h
  inx d
  dcr c
  jnz scat_copy

scat_done:
  jmp vm_loop

scat_reg_a:     db 0
scat_src_len:   db 0
scat_dst_len:   db 0
scat_total_len: db 0
scat_src_data:  dw 0

; ===============================================================
; send_length — length / size: 文字列長・配列長を返す
;
; R[a] のコレクションスロットの count を TT_INTEGER として返す。
; ===============================================================
send_length:
  lda send_reg_a
  call get_reg_addr     ; HL = R[a]
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov c, m              ; C = count
  mvi b, 0              ; BC = count (16-bit)
  lda send_reg_a
  call get_reg_addr
  call set_slot_int16   ; R[a] = count
  jmp vm_loop

; ===============================================================
; send_concat — << (文字列追記 / 配列追加)
;
; R[a] の型で分岐:
;   TT_STRING: R[a+1] の文字列を R[a] に追記
;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
; ===============================================================
send_concat:
  lda send_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m              ; A = 型タグ
  cpi TT_STRING
  jz concat_string
  cpi TT_ARRAY
  jz concat_array
  jmp vm_error

concat_string:
  ; R[a+1] の型を確認
  lda send_reg_a
  inr a
  call get_reg_addr
  mov a, m              ; A = R[a+1] の型タグ
  cpi TT_STRING
  jz concat_str_str
  cpi TT_INTEGER
  jz concat_str_int
  jmp vm_error

concat_str_str:
  ; R[a+1] のコレクションスロット (ソース)
  lda send_reg_a
  inr a
  call get_reg_addr
  call col_from_reg     ; HL = ソーススロット
  inx h                 ; +1: count
  mov a, m              ; A = ソース文字列長
  sta cc_src_len
  inx h                 ; HL → データ先頭
  shld cc_src_data

  ; R[a] のコレクションスロット (デスト)
  lda send_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = デストスロット
  inx h                 ; +1: count
  mov a, m
  sta cc_dst_len

  ; コピー可能バイト数を計算
  lda cc_src_len
  mov b, a
  lda cc_dst_len
  add b
  cpi COL_MAX_STRING_LEN + 1
  jc cc_str_len_ok
  ; 切り詰め
  mvi a, COL_MAX_STRING_LEN
  mov b, a
  lda cc_dst_len
  mov c, a
  mov a, b
  sub c
  sta cc_src_len
  lda cc_dst_len
  add a                 ; ここでは使わない — 合計は MAX
  mvi a, COL_MAX_STRING_LEN
cc_str_len_ok:
  sta cc_total_len

  ; count を更新
  lda send_reg_a
  call get_reg_addr
  call col_from_reg
  inx h
  lda cc_total_len
  mov m, a
  inx h                 ; HL → データ先頭

  ; 書き込み位置 = data + dst_len
  lda cc_dst_len
  mov e, a
  mvi d, 0
  dad d

  ; コピー
  xchg
  lhld cc_src_data
  lda cc_src_len
  ora a
  jz cc_str_done
  mov c, a
cc_str_copy:
  mov a, m
  stax d
  inx h
  inx d
  dcr c
  jnz cc_str_copy
cc_str_done:
  ; R[a] をそのまま返す (破壊的操作)
  jmp vm_loop

concat_str_int:
  ; R[a+1] の val_lo を 1 バイトとして追記
  lda send_reg_a
  inr a
  call get_reg_addr
  call slot_to_value
  mov c, m              ; C = 文字コード (val_lo)

  ; R[a] のコレクションスロット
  lda send_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = デストスロット
  inx h                 ; +1: count
  mov a, m
  cpi COL_MAX_STRING_LEN
  jnc vm_loop           ; 満杯なら何もしない
  inr m                 ; count++
  mov e, a              ; E = 旧 count (= 書き込みオフセット)
  inx h                 ; HL → データ先頭
  mvi d, 0
  dad d                 ; HL = &data[old_count]
  mov m, c              ; 書き込み
  jmp vm_loop

concat_array:
  ; R[a] のコレクションスロット
  lda send_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov a, m
  cpi COL_MAX_ARRAY_ELEMS
  jnc vm_error          ; 満杯
  sta cc_ary_count
  inr m                 ; count++

  ; 書き込み位置: data + count * 4
  inx h                 ; HL → データ先頭
  lda cc_ary_count
  add a                 ; ×2
  add a                 ; ×4
  mov e, a
  mvi d, 0
  dad d                 ; HL = 書き込み位置
  xchg                  ; DE = 書き込み位置

  ; R[a+1] をコピー
  lda send_reg_a
  inr a
  call get_reg_addr     ; HL = R[a+1]
  mvi c, SLOT_BYTES
cc_ary_copy:
  mov a, m
  stax d
  inx h
  inx d
  dcr c
  jnz cc_ary_copy
  jmp vm_loop

; --- concat 一時変数 ---
; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
cc_src_len    EQU VM_STATE_BASE + 20h   ; 1B
cc_dst_len    EQU VM_STATE_BASE + 21h   ; 1B
cc_total_len  EQU VM_STATE_BASE + 22h   ; 1B
cc_src_data   EQU VM_STATE_BASE + 23h   ; 2B (LE)
cc_ary_count  EQU VM_STATE_BASE + 25h   ; 1B

.include "vm_hash.a80"

  end
