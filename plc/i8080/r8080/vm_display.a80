; vm_display.a80 — 7 セグメント表示
;
; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
; 上位 4 桁はブランク（消灯）にする。
; セグメントパターンは seg_table にまとめる。

; ---------------------------------------------------------------
; display_hex16 — 16 ビット値を 7 セグに表示
;
;   入力: HL = 値の先頭 (val_lo の位置)
;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
;   破壊: A, B, C, HL, DE
;
; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
; ---------------------------------------------------------------
display_hex16:
  push h                ; 値のアドレスを退避
  ; 上位 4 桁をブランク (消灯) にする
  lxi d, DISPLAY_BASE
  xra a                 ; A = 0 (全セグメント消灯)
  stax d
  inx d
  stax d
  inx d
  stax d
  inx d
  stax d
  inx d                 ; DE = DISPLAY_BASE + 4
  ; 値の byte1 (val_hi) から表示
  pop h                 ; HL = val_lo
  inx h                 ; HL = val_hi
  mvi c, 2              ; 2 バイト (= 4 ニブル)
display_byte_loop:
  ; 上位ニブル
  mov a, m
  rrc
  rrc
  rrc
  rrc
  ani 0Fh
  call nibble_to_seg
  stax d
  inx d
  ; 下位ニブル
  mov a, m
  ani 0Fh
  call nibble_to_seg
  stax d
  inx d
  ; 次のバイト (val_hi → val_lo)
  dcx h
  dcr c
  jnz display_byte_loop
  ret

; ---------------------------------------------------------------
; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
;
;   入力: A = 0-F
;   出力: A = セグメントパターン
;   破壊: なし (HL, BC は内部で退避・復元)
; ---------------------------------------------------------------
nibble_to_seg:
  push h
  push b          ; BC を退避 (C = ループカウンタ)
  mov l, a
  mvi h, 0
  lxi b, seg_table
  dad b           ; HL = seg_table + nibble
  mov a, m
  pop b           ; BC を復元
  pop h
  ret

; ---------------------------------------------------------------
; 7 セグメントパターンテーブル
;
;   bit 0 = a (上)
;   bit 1 = b (右上)
;   bit 2 = c (右下)
;   bit 3 = d (下)
;   bit 4 = e (左下)
;   bit 5 = f (左上)
;   bit 6 = g (中)
;
;       aaa
;      f   b
;       ggg
;      e   c
;       ddd
; ---------------------------------------------------------------
seg_table:
  db 5Ch          ; 0  (ND8080 ROM パターン)
  db 06h          ; 1
  db 5Bh          ; 2
  db 4Fh          ; 3
  db 66h          ; 4
  db 6Dh          ; 5
  db 7Dh          ; 6
  db 27h          ; 7  (ND8080 ROM パターン)
  db 7Fh          ; 8
  db 6Fh          ; 9
  db 77h          ; A
  db 7Ch          ; b
  db 39h          ; C
  db 5Eh          ; d
  db 79h          ; E
  db 71h          ; F
