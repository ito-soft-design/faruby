; vm_globals.a80 — グローバル変数アクセス (16 ビット整数)
;
; OP_GETGV, OP_SETGV
;
; シンボルテーブル (SYM_TABLE_BASE, 0x8300):
;   エントリ i (2 バイト): グローバルスロットのアドレス (LE)
;     0x0000 = 未対応のシンボル (メソッド名等)
;
; グローバルスロット (GLOBALS_BASE, 0xB000):
;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)

; ---------------------------------------------------------------
; OP_GETGV (BB): R[a] = global[symbols[b]]
; ---------------------------------------------------------------
do_op_getgv:
  call fetch_byte       ; A = a (レジスタ番号)
  push psw
  call fetch_byte       ; A = b (シンボルインデックス)
  ; シンボルテーブルからグローバルスロットのアドレスを取得
  ; SYM_TABLE_BASE + b * 2
  add a                 ; A = b * 2
  mov e, a
  mvi d, 0
  lhld VM_STATE_BASE + OFF_SYM_BASE
  dad d                 ; HL = &sym_table[b]
  mov e, m
  inx h
  mov d, m              ; DE = グローバルスロットアドレス
  ; アドレスが 0 なら未対応シンボル
  mov a, d
  ora e
  jnz getgv_ok
  pop psw
  jmp vm_error
getgv_ok:
  pop psw               ; A = a
  push d                ; グローバルアドレスを退避
  call get_reg_addr     ; HL = R[a] (コピー先)
  xchg                  ; DE = R[a]
  pop h                 ; HL = グローバルスロット (コピー元)
  call copy_slot        ; [HL] → [DE]
  jmp vm_loop

; ---------------------------------------------------------------
; OP_SETGV (BB): global[symbols[b]] = R[a]
; ---------------------------------------------------------------
do_op_setgv:
  call fetch_byte       ; A = a (レジスタ番号)
  push psw
  call fetch_byte       ; A = b (シンボルインデックス)
  add a
  mov e, a
  mvi d, 0
  lhld VM_STATE_BASE + OFF_SYM_BASE
  dad d                 ; HL = &sym_table[b]
  mov e, m
  inx h
  mov d, m              ; DE = グローバルスロットアドレス
  mov a, d
  ora e
  jnz setgv_ok
  pop psw
  jmp vm_error
setgv_ok:
  pop psw               ; A = a
  call get_reg_addr     ; HL = R[a] (コピー元)
  ; copy_slot: [HL] → [DE]
  call copy_slot
  jmp vm_loop
