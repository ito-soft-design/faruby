; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
;
; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
; マルチバイトオペランド (S 形式) はビッグエンディアンです。

; ---------------------------------------------------------------
; fetch_byte — バイトコードから 1 バイト読み、PC を進める
;
;   入力: なし
;   出力: A = 読んだバイト
;   破壊: HL, DE
;
; PC はバイトコード領域内のオフセット。絶対アドレスは
; BYTECODE_BASE + PC で求めます。
; ---------------------------------------------------------------
fetch_byte:
  lhld VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
  lxi d, BYTECODE_BASE
  dad d                          ; HL = 絶対アドレス
  mov a, m                       ; A = bytecode[PC]
  ; PC をインクリメント
  lhld VM_STATE_BASE + OFF_PC
  inx h
  shld VM_STATE_BASE + OFF_PC
  ret

; ---------------------------------------------------------------
; fetch_u16be — ビッグエンディアン 16 ビットを読む
;
;   入力: なし
;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
;   破壊: A, B, DE
;
; mruby は S 形式のオペランドをビッグエンディアンで格納する。
; 1 バイト目が上位、2 バイト目が下位。
; ---------------------------------------------------------------
fetch_u16be:
  call fetch_byte       ; A = 上位バイト
  mov b, a              ; B に退避 (fetch_byte は HL を壊す)
  call fetch_byte       ; A = 下位バイト
  mov l, a
  mov h, b
  ret

; ---------------------------------------------------------------
; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
;
;   入力: なし
;   出力: HL = 読んだ符号付き 16 ビット値
;   破壊: A, DE
;
; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
; ---------------------------------------------------------------
fetch_s16be:
  jmp fetch_u16be       ; 表現は同じ。解釈が違うだけ
