; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
; このファイルは手で書き換えないでください

; --- メモリマップ ---

VM_CODE_ORG              EQU  8400h
BYTECODE_BASE            EQU  9000h
BYTECODE_SIZE            EQU  1000h
POOL_BASE                EQU  0A000h
IREP_TABLE_BASE          EQU  8200h
VM_STATE_BASE            EQU  8000h
REG_FILE_BASE            EQU  8100h
REG_FILE_BASE_HI         EQU  81h  ; REG_FILE_BASE の上位バイト
MAX_REGS                 EQU  40h
STACK_TOP                EQU  0FDFFh
DISPLAY_BASE             EQU  0FFF8h
DISPLAY_SIZE             EQU  08h
INIT_METHOD_ID_STORE     EQU  82FEh  ; initialize の method_id 格納アドレス

; --- バリュースロット ---

SLOT_BYTES               EQU  04h  ; 1 スロットのバイト数
SLOT_TYPE_OFFSET         EQU  00h  ; 型タグのバイトオフセット
SLOT_VALUE_OFFSET        EQU  02h  ; 値のバイトオフセット

; --- VM 状態領域のオフセット ---

OFF_PC                   EQU  00h  ; 2B
OFF_STATUS               EQU  02h  ; 2B
OFF_ERROR                EQU  04h  ; 2B
OFF_STEP_COUNT           EQU  06h  ; 4B
OFF_CURRENT_OPCODE       EQU  0Ah  ; 1B
OFF_OPERAND_A            EQU  0Bh  ; 1B
OFF_OPERAND_B            EQU  0Ch  ; 1B
OFF_OPERAND_C            EQU  0Dh  ; 1B
OFF_BYTECODE_LEN         EQU  0Eh  ; 2B
OFF_NREGS                EQU  10h  ; 1B
OFF_CUR_IREP             EQU  11h  ; 1B
OFF_NUM_IREPS            EQU  12h  ; 1B
OFF_REG_BASE             EQU  14h  ; 2B  レジスタウィンドウのベースアドレス
OFF_BC_BASE              EQU  16h  ; 2B  現在の IREP のバイトコード先頭
OFF_FRAME_SP             EQU  18h  ; 1B  フレームスタックポインタ
OFF_SYM_BASE             EQU  19h  ; 2B  現在の IREP のシンボルテーブルアドレス
OFF_OBJ_SP               EQU  1Bh  ; 1B  次の空きオブジェクトスロット
OFF_INIT_METHOD_ID       EQU  1Ch  ; 1B  initialize のメソッド ID
OFF_POOL_BASE            EQU  1Dh  ; 2B  現在の IREP の定数プール先頭
OFF_COL_SP               EQU  1Fh  ; 1B  次の空きコレクションスロット

; --- IREP テーブルエントリ ---

IREP_ENTRY_BYTES         EQU  0Ah
IREP_OFF_BYTECODE        EQU  00h  ; 2B
IREP_OFF_BYTECODE_LEN    EQU  02h  ; 2B
IREP_OFF_POOL            EQU  04h  ; 2B
IREP_OFF_NREGS           EQU  06h  ; 1B
IREP_OFF_SUBTREE_SIZE    EQU  07h  ; 1B  DFS 前順サブツリーサイズ
IREP_OFF_SYM_TABLE       EQU  08h  ; 2B  シンボルテーブル先頭アドレス

; --- 型タグ ---
; TT_FALSY_MAX 以下が偽 (nil, false)

TT_EMPTY                 EQU  00h
TT_NIL                   EQU  01h
TT_FALSE                 EQU  02h
TT_TRUE                  EQU  03h
TT_INTEGER               EQU  04h
TT_STRING                EQU  07h
TT_ARRAY                 EQU  08h
TT_HASH                  EQU  09h
TT_OBJECT                EQU  0Ah
TT_PROC                  EQU  0Ch
TT_CLASS                 EQU  0Dh
TT_FALSY_MAX             EQU  02h

; --- VM 実行状態 ---

VM_STOPPED               EQU  00h
VM_RUNNING               EQU  01h
VM_FINISHED              EQU  02h
VM_ERROR                 EQU  03h

; --- シンボルテーブル / グローバル変数 ---

SYM_TABLE_BASE           EQU  8300h
GLOBALS_BASE             EQU  0B000h

; シンボル種別コード (上位バイト)
SYM_KIND_USER_METHOD     EQU  01h  ; ユーザー定義メソッド
SYM_KIND_CLASS           EQU  02h  ; クラス名
SYM_KIND_IVAR            EQU  03h  ; インスタンス変数

; --- フレームスタック ---

FRAME_STACK_BASE         EQU  0B100h
FRAME_BYTES              EQU  0Ch  ; 12 バイト/フレーム
MAX_FRAMES               EQU  08h

; フレームフィールドのバイトオフセット
FRAME_OFF_RETURN_PC      EQU  00h  ; 2B
FRAME_OFF_RETURN_IREP    EQU  02h  ; 1B
FRAME_OFF_RETURN_REG_BASE EQU  03h  ; 2B
FRAME_OFF_KIND           EQU  05h  ; 1B
FRAME_OFF_INDEX          EQU  06h  ; 2B
FRAME_OFF_LIMIT          EQU  08h  ; 2B
FRAME_OFF_OUTER          EQU  0Ah  ; 1B

; フレーム種別
FRAME_KIND_CALL          EQU  00h
FRAME_KIND_ITERATE       EQU  01h  ; times / upto
FRAME_KIND_LOOP          EQU  04h  ; loop (無限)
FRAME_KIND_NEW           EQU  05h  ; Class#new → initialize

; 外側フレームなし (トップレベル)
FRAME_NONE               EQU  0FFh

; --- メソッド表 ---

METHOD_TABLE_BASE        EQU  0B160h
MAX_CLASSES              EQU  04h
MAX_METHODS_PER_CLASS    EQU  20h
METHOD_TABLE_SIZE        EQU  80h
CLASS_MAIN               EQU  00h
METHOD_NEW               EQU  1Ch  ; Class#new
METHOD_DISPLAY           EQU  1Dh  ; display(value)
METHOD_GETKEY            EQU  1Eh  ; getkey
METHOD_PUTS              EQU  1Fh  ; puts(value): ASCII 2 文字表示
METHOD_SETSEG            EQU  20h  ; setseg(pos, pattern)
METHOD_RAND              EQU  21h  ; rand(n)
METHOD_LENGTH            EQU  12h  ; length / size
METHOD_CONCAT            EQU  14h  ; << (文字列追記/配列追加)
METHOD_PUSH              EQU  16h  ; push (配列追加)
KEYIN1_ADDR              EQU  0616h  ; ND80Z モニタキー入力ルーチン

; --- オブジェクトプール ---

OBJECT_POOL_BASE         EQU  0B1E0h
MAX_OBJECTS              EQU  08h
OBJECT_SLOT_SIZE         EQU  20h  ; 32B/スロット
OBJECT_HEADER_SIZE       EQU  04h
MAX_IVARS                EQU  07h

; --- コレクションプール (文字列・配列) ---

COLLECTION_POOL_BASE     EQU  0B2E0h
MAX_COL_SLOTS            EQU  10h
COL_SLOT_SIZE            EQU  20h  ; 32B/スロット
COL_HEADER_SIZE          EQU  02h  ; +0: type, +1: count
COL_DATA_SIZE            EQU  1Eh  ; データ領域 (30B)
COL_MAX_STRING_LEN       EQU  1Eh
COL_MAX_ARRAY_ELEMS      EQU  07h
COL_TYPE_FREE            EQU  00h
COL_TYPE_STRING          EQU  01h
COL_TYPE_ARRAY           EQU  02h
COL_TYPE_HASH            EQU  03h
HASH_PAIR_BYTES          EQU  08h  ; 8B/ペア (key+value)
COL_MAX_HASH_PAIRS       EQU  03h  ; 最大3ペア

; --- Phase 1 オペコード ---

OP_NOP                   EQU  00h
OP_MOVE                  EQU  01h
OP_LOADI                 EQU  03h
OP_LOADINEG              EQU  04h
OP_LOADI__1              EQU  05h
OP_LOADI_0               EQU  06h
OP_LOADI_1               EQU  07h
OP_LOADI_2               EQU  08h
OP_LOADI_3               EQU  09h
OP_LOADI_4               EQU  0Ah
OP_LOADI_5               EQU  0Bh
OP_LOADI_6               EQU  0Ch
OP_LOADI_7               EQU  0Dh
OP_LOADI16               EQU  0Eh
OP_LOADNIL               EQU  11h
OP_LOADT                 EQU  13h
OP_LOADF                 EQU  14h
OP_ADD                   EQU  3Ch
OP_SUB                   EQU  3Eh
OP_EQ                    EQU  42h
OP_LT                    EQU  43h
OP_LE                    EQU  44h
OP_GT                    EQU  45h
OP_GE                    EQU  46h
OP_JMP                   EQU  25h
OP_JMPIF                 EQU  26h
OP_JMPNOT                EQU  27h
OP_STOP                  EQU  69h

; --- 命令形式ごとのオペランドバイト数 ---
; 命令長 = 1 (オペコード) + オペランドバイト数

FMT_Z                    EQU  00h  ; Z 形式のオペランドバイト数
FMT_B                    EQU  01h  ; B 形式のオペランドバイト数
FMT_BB                   EQU  02h  ; BB 形式のオペランドバイト数
FMT_BBB                  EQU  03h  ; BBB 形式のオペランドバイト数
FMT_S                    EQU  02h  ; S 形式のオペランドバイト数
FMT_BS                   EQU  03h  ; BS 形式のオペランドバイト数
FMT_BSS                  EQU  05h  ; BSS 形式のオペランドバイト数
FMT_W                    EQU  03h  ; W 形式のオペランドバイト数

