; vm_arith.a80 — 算術命令 (16 ビット整数)
;
; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI

; ---------------------------------------------------------------
; OP_ADD (B): R[a] = R[a] + R[a+1]
;
; Phase 2 は整数のみ。型タグの検査は省略し、TT_INTEGER として扱う。
; ---------------------------------------------------------------
do_op_add:
  call fetch_byte       ; A = a
  push psw              ; a を退避
  ; R[a+1] のスロットアドレスを求める
  call get_reg_addr_next ; HL = R[a+1]
  call slot_to_value    ; HL = R[a+1] の値先頭
  xchg                  ; DE = R[a+1] の値先頭
  pop psw               ; A = a
  ; R[a] のスロットアドレスを求める
  call get_reg_addr     ; HL = R[a]
  call slot_to_value    ; HL = R[a] の値先頭
  ; 16 ビット加算: val[a] += val[a+1]
  call add_value16
  jmp vm_loop

; ---------------------------------------------------------------
; OP_SUB (B): R[a] = R[a] - R[a+1]
; ---------------------------------------------------------------
do_op_sub:
  call fetch_byte       ; A = a
  push psw
  call get_reg_addr_next ; HL = R[a+1]
  call slot_to_value
  xchg                  ; DE = R[a+1] の値先頭
  pop psw               ; A = a
  call get_reg_addr     ; HL = R[a]
  call slot_to_value    ; HL = R[a] の値先頭
  call sub_value16
  jmp vm_loop

; ---------------------------------------------------------------
; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
;
; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
; ---------------------------------------------------------------
do_op_addi:
  call fetch_byte       ; A = a
  push psw
  call fetch_byte       ; A = b (即値)
  mov c, a              ; C = b
  pop psw               ; A = a
  call get_reg_addr     ; HL = R[a]
  call slot_to_value    ; HL = 値の先頭 (+2)
  mov a, m              ; val_lo
  add c                 ; val_lo + b (CY = 桁上げ)
  mov m, a
  inx h
  mov a, m              ; val_hi (MOV はフラグを変えない)
  aci 0                 ; val_hi + CY
  mov m, a
  jmp vm_loop

; ---------------------------------------------------------------
; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
; ---------------------------------------------------------------
do_op_subi:
  call fetch_byte       ; A = a
  push psw
  call fetch_byte       ; A = b (即値)
  mov c, a              ; C = b
  pop psw               ; A = a
  call get_reg_addr     ; HL = R[a]
  call slot_to_value    ; HL = 値の先頭 (+2)
  mov a, m              ; val_lo
  sub c                 ; val_lo - b (CY = 借り)
  mov m, a
  inx h
  mov a, m              ; val_hi
  sbi 0                 ; val_hi - CY
  mov m, a
  jmp vm_loop
