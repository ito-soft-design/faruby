AE9F   3A E3 AE               LDA   scat_dst_len   
AEA2   90                     SUB   b   ; この結果は負 (使わない)
AEA3   3E 1E                  MVI   a,COL_MAX_STRING_LEN   
AEA5   47                     MOV   b,a   
AEA6   3A E3 AE               LDA   scat_dst_len   
