ADFF   3A 67 AE               LDA   apush_reg_a   
AE02   CD 03 84               CALL   get_reg_addr   
AE05   CD 12 AC               CALL   col_from_reg   ; HL = コレクションスロット
AE08   23                     INX   h   ; +1: count
AE09   7E                     MOV   a,m   ; A = 現在の要素数
AE0A   32 69 AE               STA   apush_cur_count   
AE0D                             ; 容量チェック: count + add_count <= MAX
AE0D   3A 68 AE               LDA   apush_add_count   
AE10   47                     MOV   b,a   
AE11   3A 69 AE               LDA   apush_cur_count   
AE14   80                     ADD   b   
