AEF1   4E                     MOV   c,m   ; C = count
AEF2   06 00                  MVI   b,0   ; BC = count (16-bit)
AEF4   3A 58 8A               LDA   send_reg_a   
AEF7   CD 03 84               CALL   get_reg_addr   
AEFA   CD 13 84               CALL   set_slot_int16   ; R[a] = count
AEFD   C3 4F 8F               JMP   vm_loop   
