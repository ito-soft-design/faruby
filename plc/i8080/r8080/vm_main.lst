AD0A   7E                     MOV   a,m   ; 型タグ
AD0B   FE 07                  CPI   TT_STRING   
AD0D   CA 17 AD               JZ   sidx_str_char   
AD10                             ; TT_INTEGER: val_lo を文字コードとして使う
AD10   CD 35 84               CALL   slot_to_value   
AD13   7E                     MOV   a,m   
AD14   C3 1D AD               JMP   sidx_write_char   
AD17                SIDX_STR_CHAR:      
AD17                             ; TT_STRING: コレクションスロットの先頭文字
AD17   CD 12 AC               CALL   col_from_reg   
AD1A   23                     INX   h   ; +1: count
AD1B   23                     INX   h   ; +2: data[0]
AD1C   7E                     MOV   a,m   
AD1D                SIDX_WRITE_CHAR:      
AD1D   2A 75 AD               LHLD   sidx_data_addr   
AD20   5F                     MOV   e,a   ; E = 文字コード
AD21   3A 74 AD               LDA   sidx_reg_a   
AD24   3C                     INR   a   
AD25   CD 03 84               CALL   get_reg_addr   
AD28   CD 35 84               CALL   slot_to_value   
AD2B   7E                     MOV   a,m   ; A = index
AD2C   4F                     MOV   c,a   
AD2D   06 00                  MVI   b,0   
AD2F   2A 75 AD               LHLD   sidx_data_addr   
AD32   09                     DAD   b   ; HL = &data[index]
AD33   73                     MOV   m,e   ; 書き込み
AD34   C3 4F 8F               JMP   vm_loop   
AD37                SIDX_ARRAY:      
AD37                             ; R[a] のコレクションスロットを取得
AD37   3A 74 AD               LDA   sidx_reg_a   
AD3A   CD 03 84               CALL   get_reg_addr   
AD3D   CD 12 AC               CALL   col_from_reg   ; HL = コレクションスロット
AD40   23                     INX   h   ; +1: count
AD41   46                     MOV   b,m   ; B = 要素数
AD42   23                     INX   h   ; HL → データ領域先頭
AD43   22 75 AD               SHLD   sidx_data_addr   
AD46                             ; R[a+1] からインデックスを取得
AD46   3A 74 AD               LDA   sidx_reg_a   
AD49   3C                     INR   a   
AD4A   CD 03 84               CALL   get_reg_addr   
AD4D   CD 35 84               CALL   slot_to_value   
AD50   7E                     MOV   a,m   ; A = index
AD51   B8                     CMP   b   
AD52   D2 03 00               JNC   vm_error   
AD55                             ; data[index * 4] に R[a+2] をコピー
AD55   87                     ADD   a   ; ×2
AD56   87                     ADD   a   ; ×4
AD57   5F                     MOV   e,a   
AD58   16 00                  MVI   d,0   
AD5A   2A 75 AD               LHLD   sidx_data_addr   
AD5D   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
AD5E   EB                     XCHG      ; DE = コピー先
AD5F                             ; R[a+2] を取得 (コピー元)
AD5F   3A 74 AD               LDA   sidx_reg_a   
AD62   3C                     INR   a   
AD63   3C                     INR   a   
AD64   CD 03 84               CALL   get_reg_addr   ; HL = R[a+2]
AD67   0E 04                  MVI   c,SLOT_BYTES   
AD69                SIDX_ARY_COPY:      
AD69   7E                     MOV   a,m   
AD6A   12                     STAX   d   
AD6B   23                     INX   h   
AD6C   13                     INX   d   
AD6D   0D                     DCR   c   
AD6E   C2 69 AD               JNZ   sidx_ary_copy   
AD71   C3 4F 8F               JMP   vm_loop   
AD74   00           SIDX_REG_A:   DB   0   
AD75   00 00        SIDX_DATA_ADDR:   DW   0   
AD77                             ; ===============================================================
AD77                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
AD77                             ; 
AD77                             ; b 個のレジスタからコレクションプールに配列を構築する。
AD77                             ; ===============================================================
AD77                DO_OP_ARRAY:      
AD77   CD C3 84               CALL   fetch_byte   ; A = a
AD7A   32 EE AD               STA   oary_reg_a   
AD7D   32 EF AD               STA   oary_src_reg   ; BB 形式: ソース = a
AD80   CD C3 84               CALL   fetch_byte   ; A = b (要素数)
AD83                OA2_JOIN:      ; OP_ARRAY2 からの合流点
AD83   32 F0 AD               STA   oary_count   
AD86   B7                     ORA   a   
AD87   CA E0 AD               JZ   oary_empty   ; 空配列
AD8A                             ; 要素数チェック
AD8A   FE 08                  CPI   COL_MAX_ARRAY_ELEMS + 1   
AD8C   D2 03 00               JNC   vm_error   ; 要素数 > 7
AD8F                             ; コレクションスロットを確保
AD8F   CD FD AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
AD92   32 F1 AD               STA   oary_slot_num   
AD95   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
AD97   23                     INX   h   
AD98   3A F0 AD               LDA   oary_count   
AD9B   77                     MOV   m,a   ; +1: count
AD9C   23                     INX   h   ; HL → データ領域先頭
AD9D   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
AD9E                             ; ソースレジスタから b 個のスロットをコピー
AD9E   3A EF AD               LDA   oary_src_reg   
ADA1   47                     MOV   b,a   ; B = 現在のレジスタ番号
ADA2   3A F0 AD               LDA   oary_count   
ADA5   4F                     MOV   c,a   ; C = 残り要素数
ADA6                OARY_COPY_LOOP:      
ADA6   3E 04                  MVI   a,SLOT_BYTES   
ADA8   32 F2 AD               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
ADAB   C5                     PUSH   b   
ADAC   D5                     PUSH   d   
ADAD   78                     MOV   a,b   
ADAE   CD 03 84               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
ADB1   D1                     POP   d   
ADB2                OARY_COPY_ELEM:      
ADB2   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
ADB3   23                     INX   h   
ADB4   78                     MOV   a,b   
ADB5   12                     STAX   d   
ADB6   13                     INX   d   
ADB7   E5                     PUSH   h   
ADB8   21 F2 AD               LXI   h,oary_elem_cnt   
ADBB   35                     DCR   m   
ADBC   E1                     POP   h   
ADBD   C2 B2 AD               JNZ   oary_copy_elem   
ADC0   C1                     POP   b   
ADC1   04                     INR   b   ; 次のレジスタ
ADC2   0D                     DCR   c   
ADC3   CA C9 AD               JZ   oary_done   
ADC6   C3 A6 AD               JMP   oary_copy_loop   
ADC9                OARY_DONE:      
ADC9                             ; R[a] = TT_ARRAY, val_lo = slot+1
ADC9   3A EE AD               LDA   oary_reg_a   
ADCC   CD 03 84               CALL   get_reg_addr   
ADCF   36 08                  MVI   m,TT_ARRAY   
ADD1   23                     INX   h   
ADD2   36 00                  MVI   m,0   
ADD4   23                     INX   h   
ADD5   3A F1 AD               LDA   oary_slot_num   
ADD8   3C                     INR   a   
ADD9   77                     MOV   m,a   
ADDA   23                     INX   h   
ADDB   36 00                  MVI   m,0   
ADDD   C3 4F 8F               JMP   vm_loop   
ADE0                OARY_EMPTY:      
ADE0                             ; 空配列: スロット確保して count=0
ADE0   CD FD AB               CALL   col_alloc   
ADE3   32 F1 AD               STA   oary_slot_num   
ADE6   36 02                  MVI   m,COL_TYPE_ARRAY   
