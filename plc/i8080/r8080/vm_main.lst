163D   3A 4D 17               LDA   send_reg_a   
1640   CD 00 10               CALL   get_reg_addr   
1643   36 08                  MVI   m,TT_ARRAY   
1645   23                     INX   h   
1646   36 00                  MVI   m,0   
1648   23                     INX   h   
1649   3A A0 16               LDA   snb_slot   
164C   3C                     INR   a   
164D   77                     MOV   m,a   
164E   23                     INX   h   
164F   36 00                  MVI   m,0   
1651   C3 74 1D               JMP   vm_loop   
1654                             ; 
1654                             ; 空配列。count = 0 のスロットを 1 つ取る
