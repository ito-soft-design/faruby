1621                             ; R[a+2] の写し
1621   3A 4D 17               LDA   send_reg_a   
1624   3C                     INR   a   
1625   3C                     INR   a   
1626   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
1629   CD 25 10               CALL   copy_slot   ; DE へ 4 バイト
162C                             ; 
162C                SNB_FILL_NEXT:      
162C                             ; 書き先を 1 スロット進める
162C   2A A2 16               LHLD   snb_data   
162F   11 04 00               LXI   d,SLOT_BYTES   
1632   19                     DAD   d   
1633   22 A2 16               SHLD   snb_data   
1636   21 A1 16               LXI   h,snb_left   
1639   35                     DCR   m   
163A   C2 07 16               JNZ   snb_fill_loop   
