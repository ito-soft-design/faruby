0000                             ; vm_main.a80 — faRuby i8080 VM エントリポイント
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (32KB RAM: 0x8000-0xFFFF) を想定。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; --- メモリマップ ---
0000                VM_CODE_ORG:   EQU   8400h   
0000                BYTECODE_BASE:   EQU   9000h   
0000                BYTECODE_SIZE:   EQU   1000h   
0000                POOL_BASE:   EQU   0A000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                             ; --- バリュースロット ---
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; --- VM 状態領域のオフセット ---
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                             ; --- IREP テーブルエントリ ---
0000                IREP_ENTRY_BYTES:   EQU   0Ah   ; 10 バイト/エントリ
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_FIRST_CHILD:   EQU   07h   ; 1B  最初の子 IREP 番号 (FFh=子なし)
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_OBJECT:   EQU   0Ah   ; self (main)
0000                TT_PROC:   EQU   0Ch   ; ブロック (値 = irep 番号)
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; --- VM 実行状態 ---
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   0B000h   
0000                             ; --- フレームスタック ---
0000                FRAME_STACK_BASE:   EQU   0B100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   08h   
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; --- Phase 1 オペコード ---
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
8400                          .ORG   08400h   
8400                             ; ===============================================================
8400                             ; リセットベクタ
8400                             ; ===============================================================
8400   C3 AF 8C               JMP   vm_start   
8403                             ; ===============================================================
8403                             ; サブルーチン群 (.include で取り込む)
8403                             ; ===============================================================
8403                             ; vm_util.a80 — ユーティリティサブルーチン
8403                             ; 
8403                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
8403                             ; 他のすべてのモジュールがここに依存します。
8403                             ; 
8403                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
8403                             ;   +0: 型タグ (1B)
8403                             ;   +1: 予約   (1B, 常に 0)
8403                             ;   +2: val_lo (1B)
8403                             ;   +3: val_hi (1B)
8403                             ; ---------------------------------------------------------------
8403                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
8403                             ; 
8403                             ;   入力: A = レジスタ番号 (0-63)
8403                             ;   出力: HL = スロット先頭アドレス
8403                             ;   破壊: A
8403                             ; 
8403                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
8403                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
8403                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
8403                             ; ---------------------------------------------------------------
8403                GET_REG_ADDR:      
8403   87                     ADD   a   ; ×2
8404   87                     ADD   a   ; ×4 (オフセット、A に残る)
8405   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
8408   85                     ADD   l   ; A = base_lo + offset
8409   6F                     MOV   l,a   
840A   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
840C   8C                     ADC   h   ; A = base_hi + CY
840D   67                     MOV   h,a   
840E   C9                     RET      
840F                             ; ---------------------------------------------------------------
840F                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
840F                             ; 
840F                             ;   入力: A = レジスタ番号 a
840F                             ;   出力: HL = R[a+1] のスロット先頭アドレス
840F                             ;   破壊: A
840F                             ; ---------------------------------------------------------------
840F                GET_REG_ADDR_NEXT:      
840F   3C                     INR   a   
8410   C3 03 84               JMP   get_reg_addr   
8413                             ; ---------------------------------------------------------------
8413                             ; set_slot_int16 — スロットに 16 ビット整数を書く
8413                             ; 
8413                             ;   入力: HL = スロット先頭アドレス
8413                             ;          B  = val_hi (上位バイト)
8413                             ;          C  = val_lo (下位バイト)
8413                             ;   出力: なし
8413                             ;   破壊: HL
8413                             ; ---------------------------------------------------------------
8413                SET_SLOT_INT16:      
8413   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
8415   23                     INX   h   
8416   36 00                  MVI   m,0   ; +1: 予約
8418   23                     INX   h   
8419   71                     MOV   m,c   ; +2: val_lo
841A   23                     INX   h   
841B   70                     MOV   m,b   ; +3: val_hi
841C   C9                     RET      
841D                             ; ---------------------------------------------------------------
841D                             ; set_slot_special — 値を持たない型をスロットに書く
841D                             ; 
841D                             ;   入力: HL = スロット先頭アドレス
841D                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
841D                             ;   出力: なし
841D                             ;   破壊: A, HL
841D                             ; ---------------------------------------------------------------
841D                SET_SLOT_SPECIAL:      
841D   77                     MOV   m,a   ; +0: 型タグ
841E   23                     INX   h   
841F   36 00                  MVI   m,0   ; +1: 予約
8421   23                     INX   h   
8422   36 00                  MVI   m,0   ; +2: val_lo = 0
8424   23                     INX   h   
8425   36 00                  MVI   m,0   ; +3: val_hi = 0
8427   C9                     RET      
8428                             ; ---------------------------------------------------------------
8428                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
8428                             ; 
8428                             ;   入力: HL = コピー元先頭
8428                             ;         DE = コピー先先頭
8428                             ;   出力: なし
8428                             ;   破壊: A, C, HL, DE
8428                             ; ---------------------------------------------------------------
8428                COPY_SLOT:      
8428   0E 04                  MVI   c,SLOT_BYTES   
842A                COPY_SLOT_LOOP:      
842A   7E                     MOV   a,m   
842B   12                     STAX   d   
842C   23                     INX   h   
842D   13                     INX   d   
842E   0D                     DCR   c   
842F   C2 2A 84               JNZ   copy_slot_loop   
8432   C9                     RET      
8433                             ; ---------------------------------------------------------------
8433                             ; get_slot_type — スロットの型タグを読む
8433                             ; 
8433                             ;   入力: HL = スロット先頭アドレス
8433                             ;   出力: A = 型タグ
8433                             ;   破壊: なし (HL 保存)
8433                             ; ---------------------------------------------------------------
8433                GET_SLOT_TYPE:      
8433   7E                     MOV   a,m   
8434   C9                     RET      
8435                             ; ---------------------------------------------------------------
8435                             ; slot_to_value — スロット先頭から値の先頭へ進める
8435                             ; 
8435                             ;   入力: HL = スロット先頭アドレス
8435                             ;   出力: HL = 値の先頭 (スロット +2)
8435                             ;   破壊: なし
8435                             ; ---------------------------------------------------------------
8435                SLOT_TO_VALUE:      
8435   23                     INX   h   
8436   23                     INX   h   
8437   C9                     RET      
8438                             ; ---------------------------------------------------------------
8438                             ; add_value16 — 16 ビット加算 (val1 += val2)
8438                             ; 
8438                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8438                             ;         DE = 値 2 の先頭
8438                             ;   出力: 結果を HL の元の位置に上書き
8438                             ;   破壊: A, HL, DE
8438                             ; 
8438                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
8438                             ; ---------------------------------------------------------------
8438                ADD_VALUE16:      
8438   1A                     LDAX   d   ; A = val2[lo]
8439   86                     ADD   m   ; A += val1[lo]
843A   77                     MOV   m,a   ; val1[lo] = result
843B   23                     INX   h   
843C   13                     INX   d   
843D   1A                     LDAX   d   ; A = val2[hi]
843E   8E                     ADC   m   ; A += val1[hi] + CY
843F   77                     MOV   m,a   
8440   C9                     RET      
8441                             ; ---------------------------------------------------------------
8441                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
8441                             ; 
8441                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8441                             ;         DE = 値 2 の先頭
8441                             ;   出力: 結果を HL の元の位置に上書き
8441                             ;   破壊: A, HL, DE
8441                             ; 
8441                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
8441                             ; ---------------------------------------------------------------
8441                SUB_VALUE16:      
8441   7E                     MOV   a,m   ; A = val1[lo]
8442   EB                     XCHG      ; HL=val2, DE=val1
8443   96                     SUB   m   ; A -= val2[lo]
8444   EB                     XCHG      ; HL=val1, DE=val2
8445   77                     MOV   m,a   ; val1[lo] = result
8446   23                     INX   h   
8447   13                     INX   d   
8448   7E                     MOV   a,m   ; A = val1[hi]
8449   EB                     XCHG      
844A   9E                     SBB   m   ; A -= val2[hi] - CY
844B   EB                     XCHG      
844C   77                     MOV   m,a   
844D   C9                     RET      
844E                             ; ---------------------------------------------------------------
844E                             ; cmp_value16 — 16 ビット符号付き比較
844E                             ; 
844E                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
844E                             ;         DE = 値 2 の先頭 (byte0 の位置)
844E                             ;   出力: A = 比較結果
844E                             ;           00h → val1 == val2
844E                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
844E                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
844E                             ;   破壊: A, B, HL, DE
844E                             ; 
844E                             ; 手順:
844E                             ;   1. 上位バイト (byte1) の符号ビットを比べる
844E                             ;   2. 符号が違えば、負の方が小さい
844E                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
844E                             ; ---------------------------------------------------------------
844E                CMP_VALUE16:      
844E                             ; byte1 (上位) の位置を求める
844E   23                     INX   h   ; HL = val1+1 (hi)
844F   13                     INX   d   ; DE = val2+1 (hi)
8450                             ; 符号ビットを比べる
8450   7E                     MOV   a,m   ; A = val1[hi]
8451   47                     MOV   b,a   ; B = val1[hi] (退避)
8452   1A                     LDAX   d   ; A = val2[hi]
8453   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
8454   F2 60 84               JP   cmp16_same_sign   
8457                             ; 符号が違う: val1 が負なら val1 < val2
8457   78                     MOV   a,b   ; A = val1[hi]
8458   E6 80                  ANI   80h   ; bit7 を取り出す
845A   C2 74 84               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
845D   C3 77 84               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
8460                CMP16_SAME_SIGN:      
8460                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
8460   1A                     LDAX   d   
8461   BE                     CMP   m   ; val2[hi] - val1[hi]
8462   DA 77 84               JC   cmp16_ret_pos   
8465   C2 74 84               JNZ   cmp16_ret_neg   
8468   2B                     DCX   h   
8469   1B                     DCX   d   
846A   1A                     LDAX   d   
846B   BE                     CMP   m   ; val2[lo] - val1[lo]
846C   DA 77 84               JC   cmp16_ret_pos   
846F   C2 74 84               JNZ   cmp16_ret_neg   
8472                             ; すべて等しい
8472   AF                     XRA   a   ; A = 00h
8473   C9                     RET      
8474                CMP16_RET_NEG:      
8474   3E FF                  MVI   a,0FFh   ; val1 < val2
8476   C9                     RET      
8477                CMP16_RET_POS:      
8477   3E 01                  MVI   a,01h   ; val1 > val2
8479   C9                     RET      
847A                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
847A                             ; 
847A                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
847A                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
847A                             ; ---------------------------------------------------------------
847A                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
847A                             ; 
847A                             ;   入力: なし
847A                             ;   出力: A = 読んだバイト
847A                             ;   破壊: HL, DE
847A                             ; 
847A                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
847A                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
847A                             ; 子 irep の先頭に変わります。
847A                             ; ---------------------------------------------------------------
847A                FETCH_BYTE:      
847A   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
847D   EB                     XCHG      ; DE = PC
847E   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
8481   19                     DAD   d   ; HL = 絶対アドレス
8482   7E                     MOV   a,m   ; A = bytecode[PC]
8483                             ; PC をインクリメント
8483   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
8486   23                     INX   h   
8487   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
848A   C9                     RET      
848B                             ; ---------------------------------------------------------------
848B                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
848B                             ; 
848B                             ;   入力: なし
848B                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
848B                             ;   破壊: A, B, DE
848B                             ; 
848B                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
848B                             ; 1 バイト目が上位、2 バイト目が下位。
848B                             ; ---------------------------------------------------------------
848B                FETCH_U16BE:      
848B   CD 7A 84               CALL   fetch_byte   ; A = 上位バイト
848E   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
848F   CD 7A 84               CALL   fetch_byte   ; A = 下位バイト
8492   6F                     MOV   l,a   
8493   60                     MOV   h,b   
8494   C9                     RET      
8495                             ; ---------------------------------------------------------------
8495                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
8495                             ; 
8495                             ;   入力: なし
8495                             ;   出力: HL = 読んだ符号付き 16 ビット値
8495                             ;   破壊: A, DE
8495                             ; 
8495                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
8495                             ; ---------------------------------------------------------------
8495                FETCH_S16BE:      
8495   C3 8B 84               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
8498                             ; vm_load.a80 — ロード命令
8498                             ; 
8498                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
8498                             ; 
8498                             ; Phase 2: 16 ビットスロット (4 バイト)
8498                             ;   set_slot_int16: B=val_hi, C=val_lo
8498                             ; ---------------------------------------------------------------
8498                             ; OP_NOP (Z): 何もしない
8498                             ; ---------------------------------------------------------------
8498                DO_OP_NOP:      
8498   C3 07 8D               JMP   vm_loop   
849B                             ; ---------------------------------------------------------------
849B                             ; OP_MOVE (BB): R[a] = R[b]
849B                             ; ---------------------------------------------------------------
849B                DO_OP_MOVE:      
849B   CD 7A 84               CALL   fetch_byte   ; A = a (コピー先)
849E   F5                     PUSH   psw   
849F   CD 7A 84               CALL   fetch_byte   ; A = b (コピー元)
84A2   CD 03 84               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
84A5   EB                     XCHG      ; DE = R[b]
84A6   F1                     POP   psw   ; A = a
84A7   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84AA   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
84AB   CD 28 84               CALL   copy_slot   
84AE   C3 07 8D               JMP   vm_loop   
84B1                             ; ---------------------------------------------------------------
84B1                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
84B1                             ; ---------------------------------------------------------------
84B1                DO_OP_LOADI:      
84B1   CD 7A 84               CALL   fetch_byte   ; A = a
84B4   F5                     PUSH   psw   
84B5   CD 7A 84               CALL   fetch_byte   ; A = b (値)
84B8   4F                     MOV   c,a   ; C = val_lo
84B9   F1                     POP   psw   ; A = a
84BA   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84BD   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
84BE   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
84C0   CD 13 84               CALL   set_slot_int16   
84C3   C3 07 8D               JMP   vm_loop   
84C6                             ; ---------------------------------------------------------------
84C6                             ; OP_LOADINEG (BB): R[a] = -b
84C6                             ; ---------------------------------------------------------------
84C6                DO_OP_LOADINEG:      
84C6   CD 7A 84               CALL   fetch_byte   ; A = a
84C9   F5                     PUSH   psw   
84CA   CD 7A 84               CALL   fetch_byte   ; A = b
84CD                             ; -b を計算 (0 - b)
84CD   4F                     MOV   c,a   ; C = b (退避)
84CE   AF                     XRA   a   ; A = 0
84CF   91                     SUB   c   ; A = -b
84D0   4F                     MOV   c,a   ; C = val_lo (-b)
84D1   F1                     POP   psw   ; A = a
84D2   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84D5   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
84D7   CD 13 84               CALL   set_slot_int16   
84DA   C3 07 8D               JMP   vm_loop   
84DD                             ; ---------------------------------------------------------------
84DD                             ; OP_LOADI__1 (B): R[a] = -1
84DD                             ; ---------------------------------------------------------------
84DD                DO_OP_LOADI__1:      
84DD   CD 7A 84               CALL   fetch_byte   ; A = a
84E0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84E3   0E FF                  MVI   c,0FFh   ; val_lo = FFh
84E5   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
84E7   CD 13 84               CALL   set_slot_int16   
84EA   C3 07 8D               JMP   vm_loop   
84ED                             ; ---------------------------------------------------------------
84ED                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
84ED                             ; ---------------------------------------------------------------
84ED                DO_OP_LOADI_0:      
84ED   0E 00                  MVI   c,0   
84EF   C3 12 85               JMP   loadi_small   
84F2                DO_OP_LOADI_1:      
84F2   0E 01                  MVI   c,1   
84F4   C3 12 85               JMP   loadi_small   
84F7                DO_OP_LOADI_2:      
84F7   0E 02                  MVI   c,2   
84F9   C3 12 85               JMP   loadi_small   
84FC                DO_OP_LOADI_3:      
84FC   0E 03                  MVI   c,3   
84FE   C3 12 85               JMP   loadi_small   
8501                DO_OP_LOADI_4:      
8501   0E 04                  MVI   c,4   
8503   C3 12 85               JMP   loadi_small   
8506                DO_OP_LOADI_5:      
8506   0E 05                  MVI   c,5   
8508   C3 12 85               JMP   loadi_small   
850B                DO_OP_LOADI_6:      
850B   0E 06                  MVI   c,6   
850D   C3 12 85               JMP   loadi_small   
8510                DO_OP_LOADI_7:      
8510   0E 07                  MVI   c,7   
8512                LOADI_SMALL:      
8512                             ; C = 即値 (0-7)
8512   CD 7A 84               CALL   fetch_byte   ; A = a
8515   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8518   06 00                  MVI   b,0   ; val_hi = 0 (正)
851A   CD 13 84               CALL   set_slot_int16   
851D   C3 07 8D               JMP   vm_loop   
8520                             ; ---------------------------------------------------------------
8520                             ; OP_LOADI16 (BS): R[a] = signed16(b)
8520                             ; 
8520                             ; b は符号付き 16 ビット (ビッグエンディアン)。
8520                             ; 16 ビットスロットではそのままネイティブサイズ。
8520                             ; 符号拡張は不要。
8520                             ; ---------------------------------------------------------------
8520                DO_OP_LOADI16:      
8520   CD 7A 84               CALL   fetch_byte   ; A = a
8523   F5                     PUSH   psw   
8524   CD 95 84               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
8527   4D                     MOV   c,l   ; C = val_lo
8528   44                     MOV   b,h   ; B = val_hi
8529   F1                     POP   psw   ; A = a
852A   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
852D                             ; 型タグと値を書く
852D   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
852F   23                     INX   h   
8530   36 00                  MVI   m,0   ; +1: 予約
8532   23                     INX   h   
8533   71                     MOV   m,c   ; +2: val_lo
8534   23                     INX   h   
8535   70                     MOV   m,b   ; +3: val_hi
8536   C3 07 8D               JMP   vm_loop   
8539                             ; ---------------------------------------------------------------
8539                             ; OP_LOADNIL (B): R[a] = nil
8539                             ; ---------------------------------------------------------------
8539                DO_OP_LOADNIL:      
8539   CD 7A 84               CALL   fetch_byte   ; A = a
853C   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
853F   3E 01                  MVI   a,TT_NIL   
8541   CD 1D 84               CALL   set_slot_special   
8544   C3 07 8D               JMP   vm_loop   
8547                             ; ---------------------------------------------------------------
8547                             ; OP_LOADT (B): R[a] = true
8547                             ; ---------------------------------------------------------------
8547                DO_OP_LOADT:      
8547   CD 7A 84               CALL   fetch_byte   ; A = a
854A   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
854D   3E 03                  MVI   a,TT_TRUE   
854F   CD 1D 84               CALL   set_slot_special   
8552   C3 07 8D               JMP   vm_loop   
8555                             ; ---------------------------------------------------------------
8555                             ; OP_LOADF (B): R[a] = false
8555                             ; ---------------------------------------------------------------
8555                DO_OP_LOADF:      
8555   CD 7A 84               CALL   fetch_byte   ; A = a
8558   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
855B   3E 02                  MVI   a,TT_FALSE   
855D   CD 1D 84               CALL   set_slot_special   
8560   C3 07 8D               JMP   vm_loop   
8563                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
8563                             ; 
8563                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
8563                             ; ---------------------------------------------------------------
8563                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
8563                             ; 
8563                             ; Phase 2 は整数のみ。型タグの検査は省略し、TT_INTEGER として扱う。
8563                             ; ---------------------------------------------------------------
8563                DO_OP_ADD:      
8563   CD 7A 84               CALL   fetch_byte   ; A = a
8566   F5                     PUSH   psw   ; a を退避
8567                             ; R[a+1] のスロットアドレスを求める
8567   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
856A   CD 35 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
856D   EB                     XCHG      ; DE = R[a+1] の値先頭
856E   F1                     POP   psw   ; A = a
856F                             ; R[a] のスロットアドレスを求める
856F   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8572   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8575                             ; 16 ビット加算: val[a] += val[a+1]
8575   CD 38 84               CALL   add_value16   
8578   C3 07 8D               JMP   vm_loop   
857B                             ; ---------------------------------------------------------------
857B                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
857B                             ; ---------------------------------------------------------------
857B                DO_OP_SUB:      
857B   CD 7A 84               CALL   fetch_byte   ; A = a
857E   F5                     PUSH   psw   
857F   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8582   CD 35 84               CALL   slot_to_value   
8585   EB                     XCHG      ; DE = R[a+1] の値先頭
8586   F1                     POP   psw   ; A = a
8587   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
858A   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
858D   CD 41 84               CALL   sub_value16   
8590   C3 07 8D               JMP   vm_loop   
8593                             ; ---------------------------------------------------------------
8593                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
8593                             ; 
8593                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
8593                             ; ---------------------------------------------------------------
8593                DO_OP_ADDI:      
8593   CD 7A 84               CALL   fetch_byte   ; A = a
8596   F5                     PUSH   psw   
8597   CD 7A 84               CALL   fetch_byte   ; A = b (即値)
859A   4F                     MOV   c,a   ; C = b
859B   F1                     POP   psw   ; A = a
859C   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
859F   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85A2   7E                     MOV   a,m   ; val_lo
85A3   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
85A4   77                     MOV   m,a   
85A5   23                     INX   h   
85A6   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
85A7   CE 00                  ACI   0   ; val_hi + CY
85A9   77                     MOV   m,a   
85AA   C3 07 8D               JMP   vm_loop   
85AD                             ; ---------------------------------------------------------------
85AD                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
85AD                             ; ---------------------------------------------------------------
85AD                DO_OP_SUBI:      
85AD   CD 7A 84               CALL   fetch_byte   ; A = a
85B0   F5                     PUSH   psw   
85B1   CD 7A 84               CALL   fetch_byte   ; A = b (即値)
85B4   4F                     MOV   c,a   ; C = b
85B5   F1                     POP   psw   ; A = a
85B6   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85B9   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85BC   7E                     MOV   a,m   ; val_lo
85BD   91                     SUB   c   ; val_lo - b (CY = 借り)
85BE   77                     MOV   m,a   
85BF   23                     INX   h   
85C0   7E                     MOV   a,m   ; val_hi
85C1   DE 00                  SBI   0   ; val_hi - CY
85C3   77                     MOV   m,a   
85C4   C3 07 8D               JMP   vm_loop   
85C7                             ; ---------------------------------------------------------------
85C7                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
85C7                             ; 
85C7                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
85C7                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
85C7                             ; ---------------------------------------------------------------
85C7                DO_OP_MUL:      
85C7   CD 7A 84               CALL   fetch_byte   ; A = a
85CA   F5                     PUSH   psw   
85CB   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85CE   CD 35 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
85D1   5E                     MOV   e,m   ; E = val2_lo
85D2   23                     INX   h   
85D3   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
85D4   F1                     POP   psw   ; A = a
85D5   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85D8   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85DB   E5                     PUSH   h   ; 書き戻し先を退避
85DC   4E                     MOV   c,m   
85DD   23                     INX   h   
85DE   46                     MOV   b,m   ; BC = 被乗数
85DF   CD 16 86               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
85E2   D1                     POP   d   ; DE = 書き戻し先
85E3   7D                     MOV   a,l   
85E4   12                     STAX   d   
85E5   13                     INX   d   
85E6   7C                     MOV   a,h   
85E7   12                     STAX   d   
85E8   C3 07 8D               JMP   vm_loop   
85EB                             ; ---------------------------------------------------------------
85EB                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
85EB                             ; 
85EB                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
85EB                             ; 除数 0 はエラー停止。
85EB                             ; ---------------------------------------------------------------
85EB                DO_OP_DIV:      
85EB   CD 7A 84               CALL   fetch_byte   ; A = a
85EE   F5                     PUSH   psw   
85EF   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85F2   CD 35 84               CALL   slot_to_value   
85F5   5E                     MOV   e,m   
85F6   23                     INX   h   
85F7   56                     MOV   d,m   ; DE = 除数
85F8                             ; ゼロ除算チェック
85F8   7A                     MOV   a,d   
85F9   B3                     ORA   e   
85FA   C2 01 86               JNZ   do_div_nonzero   
85FD   F1                     POP   psw   
85FE   C3 03 00               JMP   vm_error   
8601                DO_DIV_NONZERO:      
8601   F1                     POP   psw   ; A = a
8602   CD 03 84               CALL   get_reg_addr   
8605   CD 35 84               CALL   slot_to_value   
8608   E5                     PUSH   h   ; 書き戻し先を退避
8609   4E                     MOV   c,m   
860A   23                     INX   h   
860B   46                     MOV   b,m   ; BC = 被除数
860C   CD 28 86               CALL   sdiv16   ; BC = 商
860F   E1                     POP   h   ; HL = 書き戻し先
8610   71                     MOV   m,c   
8611   23                     INX   h   
8612   70                     MOV   m,b   
8613   C3 07 8D               JMP   vm_loop   
8616                             ; ---------------------------------------------------------------
8616                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
8616                             ; 
8616                             ;   入力: BC = 被乗数, DE = 乗数
8616                             ;   出力: HL = 積の下位 16 ビット
8616                             ;   破壊: A, DE
8616                             ; ---------------------------------------------------------------
8616                UMUL16:      
8616   21 00 00               LXI   h,0   ; 積 = 0
8619   3E 10                  MVI   a,16   ; ビットカウンタ
861B                UMUL16_LOOP:      
861B   29                     DAD   h   ; 積 <<= 1
861C   EB                     XCHG      ; HL ↔ DE
861D   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
861E   EB                     XCHG      ; HL ↔ DE
861F   D2 23 86               JNC   umul16_noadd   
8622   09                     DAD   b   ; 積 += 被乗数
8623                UMUL16_NOADD:      
8623   3D                     DCR   a   
8624   C2 1B 86               JNZ   umul16_loop   
8627   C9                     RET      
8628                             ; ---------------------------------------------------------------
8628                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
8628                             ; 
8628                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
8628                             ;   出力: BC = 商
8628                             ;   破壊: A, DE, HL
8628                             ; 
8628                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
8628                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
8628                             ; ---------------------------------------------------------------
8628                SDIV16:      
8628   78                     MOV   a,b   
8629   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
862A   F5                     PUSH   psw   ; 符号情報を退避
862B                             ; 被除数を正にする
862B   78                     MOV   a,b   
862C   E6 80                  ANI   80h   
862E   CA 34 86               JZ   sdiv16_chk_div   
8631   CD 84 86               CALL   neg_bc   
8634                SDIV16_CHK_DIV:      
8634                             ; 除数を正にする
8634   7A                     MOV   a,d   
8635   E6 80                  ANI   80h   
8637   CA 3D 86               JZ   sdiv16_do   
863A   CD 8C 86               CALL   neg_de   
863D                SDIV16_DO:      
863D   CD 4D 86               CALL   udiv16   ; BC = |商|, HL = |剰余|
8640   F1                     POP   psw   
8641   E6 80                  ANI   80h   
8643   C8                     RZ      ; 同符号 → 正の商をそのまま返す
8644                             ; 異符号: 剰余があれば floor 調整
8644   7C                     MOV   a,h   
8645   B5                     ORA   l   
8646   CA 4A 86               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
8649   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
864A                SDIV16_NEG:      
864A   C3 84 86               JMP   neg_bc   
864D                             ; ---------------------------------------------------------------
864D                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
864D                             ; 
864D                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
864D                             ;   出力: BC = 商, HL = 剰余
864D                             ;   破壊: A
864D                             ; 
864D                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
864D                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
864D                             ; ---------------------------------------------------------------
864D                UDIV16:      
864D   21 00 00               LXI   h,0   ; 剰余 = 0
8650   3E 10                  MVI   a,16   
8652   32 83 86               STA   udiv_cnt   
8655                UDIV16_LOOP:      
8655                             ; BC を 1 ビット左シフト (MSB → CY)
8655   79                     MOV   a,c   
8656   87                     ADD   a   ; C <<= 1, bit7 → CY
8657   4F                     MOV   c,a   
8658   78                     MOV   a,b   
8659   8F                     ADC   a   ; B <<= 1 + CY from C
865A   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
865B                             ; CY を剰余 (HL) にシフトイン
865B   7D                     MOV   a,l   
865C   17                     RAL      
865D   6F                     MOV   l,a   
865E   7C                     MOV   a,h   
865F   17                     RAL      
8660   67                     MOV   h,a   
8661                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
8661   DA 71 86               JC   udiv16_sub   
8664                             ; 剰余 (HL) と 除数 (DE) を比較
8664   7C                     MOV   a,h   
8665   BA                     CMP   d   
8666   DA 78 86               JC   udiv16_nosub   ; H < D → HL < DE
8669   C2 71 86               JNZ   udiv16_sub   ; H > D → HL > DE
866C   7D                     MOV   a,l   
866D   BB                     CMP   e   
866E   DA 78 86               JC   udiv16_nosub   ; L < E → HL < DE
8671                UDIV16_SUB:      
8671                             ; 剰余 ≧ 除数: 減算して商ビット = 1
8671   7D                     MOV   a,l   
8672   93                     SUB   e   
8673   6F                     MOV   l,a   
8674   7C                     MOV   a,h   
8675   9A                     SBB   d   
8676   67                     MOV   h,a   
8677   0C                     INR   c   ; 商の bit0 を立てる
8678                UDIV16_NOSUB:      
8678   3A 83 86               LDA   udiv_cnt   ; LDA は CY に影響しない
867B   3D                     DCR   a   ; DCR は CY に影響しない
867C   32 83 86               STA   udiv_cnt   
867F   C2 55 86               JNZ   udiv16_loop   
8682   C9                     RET      
8683                UDIV_CNT:      
8683   00                     DB   0   
8684                             ; ---------------------------------------------------------------
8684                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
8684                             ; ---------------------------------------------------------------
8684                NEG_BC:      
8684   79                     MOV   a,c   
8685   2F                     CMA      
8686   4F                     MOV   c,a   
8687   78                     MOV   a,b   
8688   2F                     CMA      
8689   47                     MOV   b,a   
868A   03                     INX   b   
868B   C9                     RET      
868C                NEG_DE:      
868C   7B                     MOV   a,e   
868D   2F                     CMA      
868E   5F                     MOV   e,a   
868F   7A                     MOV   a,d   
8690   2F                     CMA      
8691   57                     MOV   d,a   
8692   13                     INX   d   
8693   C9                     RET      
8694                             ; vm_compare.a80 — 比較命令
8694                             ; 
8694                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
8694                             ; 
8694                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
8694                             ; Phase 2 は整数のみ。
8694                             ; 
8694                             ; cmp_value16 は結果を A で返す:
8694                             ;   A = 00h → 等しい
8694                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
8694                             ;   A = 01h → val1 > val2
8694                             ; 
8694                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
8694                             ; ---------------------------------------------------------------
8694                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
8694                             ; 
8694                             ;   出力: A = 比較結果 (00h/FFh/01h)
8694                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
8694                             ;   破壊: A, B, HL, DE
8694                             ; ---------------------------------------------------------------
8694                CMP_REG_PAIR:      
8694   CD 7A 84               CALL   fetch_byte   
8697   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
869A                             ; R[a+1] の値先頭
869A   CD 0F 84               CALL   get_reg_addr_next   
869D   CD 35 84               CALL   slot_to_value   
86A0   EB                     XCHG      ; DE = R[a+1] 値先頭
86A1                             ; R[a] の値先頭
86A1   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86A4   CD 03 84               CALL   get_reg_addr   
86A7   CD 35 84               CALL   slot_to_value   ; HL = R[a] 値先頭
86AA   CD 4E 84               CALL   cmp_value16   ; A = 結果
86AD   C9                     RET      
86AE                             ; ---------------------------------------------------------------
86AE                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
86AE                             ; 
86AE                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
86AE                             ; ---------------------------------------------------------------
86AE                CMP_SET_TRUE:      
86AE   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86B1   CD 03 84               CALL   get_reg_addr   
86B4   3E 03                  MVI   a,TT_TRUE   
86B6   CD 1D 84               CALL   set_slot_special   
86B9   C3 07 8D               JMP   vm_loop   
86BC                CMP_SET_FALSE:      
86BC   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86BF   CD 03 84               CALL   get_reg_addr   
86C2   3E 02                  MVI   a,TT_FALSE   
86C4   CD 1D 84               CALL   set_slot_special   
86C7   C3 07 8D               JMP   vm_loop   
86CA                             ; ---------------------------------------------------------------
86CA                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
86CA                             ; 
86CA                             ; 型タグと値の両方が一致したときだけ true。
86CA                             ; ---------------------------------------------------------------
86CA                DO_OP_EQ:      
86CA   CD 7A 84               CALL   fetch_byte   
86CD   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
86D0                             ; R[a] と R[a+1] のスロットアドレスを求める
86D0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
86D3   E5                     PUSH   h   ; R[a] を退避
86D4   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86D7   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
86DA   D1                     POP   d   ; DE = R[a]
86DB                             ; HL = R[a+1], DE = R[a]
86DB                             ; 型タグを比べる
86DB   46                     MOV   b,m   ; B = R[a+1].type
86DC   1A                     LDAX   d   ; A = R[a].type
86DD   B8                     CMP   b   
86DE   C2 BC 86               JNZ   cmp_set_false   ; 型が違えば false
86E1                             ; 型が同じ → 値を 2 バイト比べる
86E1   23                     INX   h   
86E2   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
86E3   13                     INX   d   
86E4   13                     INX   d   ; DE = R[a] + 2 (値先頭)
86E5   1A                     LDAX   d   ; A = R[a].val_lo
86E6   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
86E7   C2 BC 86               JNZ   cmp_set_false   
86EA   23                     INX   h   
86EB   13                     INX   d   
86EC   1A                     LDAX   d   ; A = R[a].val_hi
86ED   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
86EE   C2 BC 86               JNZ   cmp_set_false   
86F1   C3 AE 86               JMP   cmp_set_true   ; すべて一致
86F4                             ; ---------------------------------------------------------------
86F4                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
86F4                             ; ---------------------------------------------------------------
86F4                DO_OP_LT:      
86F4   CD 94 86               CALL   cmp_reg_pair   ; A = 結果
86F7   B7                     ORA   a   
86F8   FA AE 86               JM   cmp_set_true   ; A = FFh → val1 < val2
86FB   C3 BC 86               JMP   cmp_set_false   
86FE                             ; ---------------------------------------------------------------
86FE                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
86FE                             ; ---------------------------------------------------------------
86FE                DO_OP_LE:      
86FE   CD 94 86               CALL   cmp_reg_pair   
8701   B7                     ORA   a   
8702   FA AE 86               JM   cmp_set_true   ; val1 < val2
8705   CA AE 86               JZ   cmp_set_true   ; val1 == val2
8708   C3 BC 86               JMP   cmp_set_false   
870B                             ; ---------------------------------------------------------------
870B                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
870B                             ; ---------------------------------------------------------------
870B                DO_OP_GT:      
870B   CD 94 86               CALL   cmp_reg_pair   
870E   B7                     ORA   a   
870F   CA BC 86               JZ   cmp_set_false   ; val1 == val2
8712   F2 AE 86               JP   cmp_set_true   ; A = 01h → val1 > val2
8715   C3 BC 86               JMP   cmp_set_false   ; A = FFh → val1 < val2
8718                             ; ---------------------------------------------------------------
8718                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
8718                             ; ---------------------------------------------------------------
8718                DO_OP_GE:      
8718   CD 94 86               CALL   cmp_reg_pair   
871B   B7                     ORA   a   
871C   FA BC 86               JM   cmp_set_false   ; val1 < val2
871F   C3 AE 86               JMP   cmp_set_true   ; val1 >= val2
8722                             ; vm_jump.a80 — ジャンプ命令
8722                             ; 
8722                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
8722                             ; 
8722                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
8722                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
8722                             ; ---------------------------------------------------------------
8722                             ; apply_jump — PC に符号付きオフセットを加える
8722                             ; 
8722                             ;   入力: HL = 符号付き 16 ビットオフセット
8722                             ;   出力: なし (PC が更新される)
8722                             ;   破壊: A, HL, DE
8722                             ; ---------------------------------------------------------------
8722                APPLY_JUMP:      
8722   EB                     XCHG      ; DE = オフセット
8723   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
8726   19                     DAD   d   ; HL = PC + オフセット
8727   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
872A   C9                     RET      
872B                             ; ---------------------------------------------------------------
872B                             ; OP_JMP (S): PC += signed16(a)
872B                             ; ---------------------------------------------------------------
872B                DO_OP_JMP:      
872B   CD 95 84               CALL   fetch_s16be   ; HL = オフセット
872E   CD 22 87               CALL   apply_jump   
8731   C3 07 8D               JMP   vm_loop   
8734                             ; ---------------------------------------------------------------
8734                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
8734                             ; 
8734                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
8734                             ; ---------------------------------------------------------------
8734                DO_OP_JMPIF:      
8734   CD 7A 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8737   F5                     PUSH   psw   
8738   CD 95 84               CALL   fetch_s16be   ; HL = オフセット
873B   E5                     PUSH   h   ; オフセットを退避
873C   D1                     POP   d   ; DE = オフセット
873D   F1                     POP   psw   ; A = a
873E   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
8741   CD 33 84               CALL   get_slot_type   ; A = 型タグ
8744   FE 03                  CPI   TT_FALSY_MAX + 1   
8746   DA 50 87               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
8749                             ; 真 → ジャンプする
8749   EB                     XCHG      ; HL = オフセット (DE にあった)
874A   CD 22 87               CALL   apply_jump   
874D   C3 07 8D               JMP   vm_loop   
8750                JMPIF_SKIP:      
8750   C3 07 8D               JMP   vm_loop   
8753                             ; ---------------------------------------------------------------
8753                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
8753                             ; ---------------------------------------------------------------
8753                DO_OP_JMPNOT:      
8753   CD 7A 84               CALL   fetch_byte   ; A = a
8756   F5                     PUSH   psw   
8757   CD 95 84               CALL   fetch_s16be   ; HL = オフセット
875A   E5                     PUSH   h   
875B   D1                     POP   d   ; DE = オフセット
875C   F1                     POP   psw   ; A = a
875D   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
8760   CD 33 84               CALL   get_slot_type   ; A = 型タグ
8763   FE 03                  CPI   TT_FALSY_MAX + 1   
8765   D2 6F 87               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
8768                             ; 偽 → ジャンプする
8768   EB                     XCHG      ; HL = オフセット
8769   CD 22 87               CALL   apply_jump   
876C   C3 07 8D               JMP   vm_loop   
876F                JMPNOT_SKIP:      
876F   C3 07 8D               JMP   vm_loop   
8772                             ; vm_globals.a80 — グローバル変数アクセス (16 ビット整数)
8772                             ; 
8772                             ; OP_GETGV, OP_SETGV
8772                             ; 
8772                             ; シンボルテーブル (SYM_TABLE_BASE, 0x8300):
8772                             ;   エントリ i (2 バイト): グローバルスロットのアドレス (LE)
8772                             ;     0x0000 = 未対応のシンボル (メソッド名等)
8772                             ; 
8772                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
8772                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
8772                             ; ---------------------------------------------------------------
8772                             ; OP_GETGV (BB): R[a] = global[symbols[b]]
8772                             ; ---------------------------------------------------------------
8772                DO_OP_GETGV:      
8772   CD 7A 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8775   F5                     PUSH   psw   
8776   CD 7A 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
8779                             ; シンボルテーブルからグローバルスロットのアドレスを取得
8779                             ; SYM_TABLE_BASE + b * 2
8779   87                     ADD   a   ; A = b * 2
877A   5F                     MOV   e,a   
877B   16 00                  MVI   d,0   
877D   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
8780   19                     DAD   d   ; HL = &sym_table[b]
8781   5E                     MOV   e,m   
8782   23                     INX   h   
8783   56                     MOV   d,m   ; DE = グローバルスロットアドレス
8784                             ; アドレスが 0 なら未対応シンボル
8784   7A                     MOV   a,d   
8785   B3                     ORA   e   
8786   C2 8D 87               JNZ   getgv_ok   
8789   F1                     POP   psw   
878A   C3 03 00               JMP   vm_error   
878D                GETGV_OK:      
878D   F1                     POP   psw   ; A = a
878E   D5                     PUSH   d   ; グローバルアドレスを退避
878F   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
8792   EB                     XCHG      ; DE = R[a]
8793   E1                     POP   h   ; HL = グローバルスロット (コピー元)
8794   CD 28 84               CALL   copy_slot   ; [HL] → [DE]
8797   C3 07 8D               JMP   vm_loop   
879A                             ; ---------------------------------------------------------------
879A                             ; OP_SETGV (BB): global[symbols[b]] = R[a]
879A                             ; ---------------------------------------------------------------
879A                DO_OP_SETGV:      
879A   CD 7A 84               CALL   fetch_byte   ; A = a (レジスタ番号)
879D   F5                     PUSH   psw   
879E   CD 7A 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
87A1   87                     ADD   a   
87A2   5F                     MOV   e,a   
87A3   16 00                  MVI   d,0   
87A5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
87A8   19                     DAD   d   ; HL = &sym_table[b]
87A9   5E                     MOV   e,m   
87AA   23                     INX   h   
87AB   56                     MOV   d,m   ; DE = グローバルスロットアドレス
87AC   7A                     MOV   a,d   
87AD   B3                     ORA   e   
87AE   C2 B5 87               JNZ   setgv_ok   
87B1   F1                     POP   psw   
87B2   C3 03 00               JMP   vm_error   
87B5                SETGV_OK:      
87B5   F1                     POP   psw   ; A = a
87B6   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
87B9                             ; copy_slot: [HL] → [DE]
87B9   CD 28 84               CALL   copy_slot   
87BC   C3 07 8D               JMP   vm_loop   
87BF                             ; vm_send.a80 — メソッド呼び出し (組み込みメソッド限定)
87BF                             ; 
87BF                             ; OP_SEND, OP_SSEND
87BF                             ; 
87BF                             ; 組み込みメソッドのみサポート。ユーザ定義メソッドは未対応。
87BF                             ; シンボルテーブルの値が 0x0001-0x00FF の場合メソッド ID として扱う:
87BF                             ;   1 = !=  (不等号)
87BF                             ;   2 = !   (論理否定)
87BF                             ;   3 = %   (剰余, Ruby floor modulo)
87BF                             ;   4 = abs (絶対値)
87BF                             ; ---------------------------------------------------------------
87BF                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
87BF                             ; 
87BF                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
87BF                             ; ---------------------------------------------------------------
87BF                DO_OP_SSEND:      
87BF   CD 7A 84               CALL   fetch_byte   ; A = a
87C2   F5                     PUSH   psw   
87C3   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
87C6   EB                     XCHG      ; DE = R[a]
87C7   AF                     XRA   a   ; A = 0
87C8   CD 03 84               CALL   get_reg_addr   ; HL = R[0] (self)
87CB   CD 28 84               CALL   copy_slot   ; R[a] = R[0]
87CE   F1                     POP   psw   ; A = a
87CF   32 C2 88               STA   send_reg_a   
87D2   CD 7A 84               CALL   fetch_byte   ; A = b (シンボル)
87D5   F5                     PUSH   psw   
87D6   CD 7A 84               CALL   fetch_byte   ; A = c (argc)
87D9   32 C3 88               STA   send_argc   
87DC   F1                     POP   psw   ; A = b
87DD   C3 F1 87               JMP   send_dispatch   
87E0                             ; ---------------------------------------------------------------
87E0                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
87E0                             ; ---------------------------------------------------------------
87E0                DO_OP_SEND:      
87E0   CD 7A 84               CALL   fetch_byte   ; A = a
87E3   32 C2 88               STA   send_reg_a   
87E6   CD 7A 84               CALL   fetch_byte   ; A = b (シンボル)
87E9   F5                     PUSH   psw   
87EA   CD 7A 84               CALL   fetch_byte   ; A = c (argc)
87ED   32 C3 88               STA   send_argc   
87F0   F1                     POP   psw   ; A = b
87F1                SEND_DISPATCH:      
87F1                             ; シンボルテーブルからメソッド ID を取得
87F1   87                     ADD   a   ; b * 2
87F2   5F                     MOV   e,a   
87F3   16 00                  MVI   d,0   
87F5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
87F8   19                     DAD   d   
87F9   5E                     MOV   e,m   
87FA   23                     INX   h   
87FB   56                     MOV   d,m   ; DE = エントリ値
87FC                             ; D != 0 ならグローバルアドレス → メソッドではない
87FC   7A                     MOV   a,d   
87FD   B7                     ORA   a   
87FE   C2 03 00               JNZ   vm_error   
8801                             ; E = メソッド ID (0 = 未対応)
8801   7B                     MOV   a,e   
8802   B7                     ORA   a   
8803   CA 03 00               JZ   vm_error   
8806                             ; メソッドディスパッチ
8806   FE 01                  CPI   1   
8808   CA 1D 88               JZ   send_ne   ; != (不等号)
880B   FE 02                  CPI   2   
880D   CA 52 88               JZ   send_not   ; !  (論理否定)
8810   FE 03                  CPI   3   
8812   CA 7A 88               JZ   send_mod   ; %  (剰余)
8815   FE 04                  CPI   4   
8817   CA A5 88               JZ   send_abs   ; abs (絶対値)
881A   C3 03 00               JMP   vm_error   ; 未対応メソッド
881D                             ; ---------------------------------------------------------------
881D                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
881D                             ; 
881D                             ; スロット全体 (4 バイト) をバイト比較する。
881D                             ; 型タグも含めて比較するので異なる型は常に true。
881D                             ; ---------------------------------------------------------------
881D                SEND_NE:      
881D   3A C2 88               LDA   send_reg_a   
8820   F5                     PUSH   psw   
8821   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8824   EB                     XCHG      ; DE = R[a+1]
8825   F1                     POP   psw   
8826   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8829   0E 04                  MVI   c,SLOT_BYTES   
882B                SEND_NE_CMP:      
882B   1A                     LDAX   d   
882C   BE                     CMP   m   
882D   C2 44 88               JNZ   send_ne_diff   
8830   23                     INX   h   
8831   13                     INX   d   
8832   0D                     DCR   c   
8833   C2 2B 88               JNZ   send_ne_cmp   
8836                             ; 全バイト一致 → 等しい → false
8836   3A C2 88               LDA   send_reg_a   
8839   CD 03 84               CALL   get_reg_addr   
883C   3E 02                  MVI   a,TT_FALSE   
883E   CD 1D 84               CALL   set_slot_special   
8841   C3 07 8D               JMP   vm_loop   
8844                SEND_NE_DIFF:      
8844   3A C2 88               LDA   send_reg_a   
8847   CD 03 84               CALL   get_reg_addr   
884A   3E 03                  MVI   a,TT_TRUE   
884C   CD 1D 84               CALL   set_slot_special   
884F   C3 07 8D               JMP   vm_loop   
8852                             ; ---------------------------------------------------------------
8852                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
8852                             ; 
8852                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
8852                             ; ---------------------------------------------------------------
8852                SEND_NOT:      
8852   3A C2 88               LDA   send_reg_a   
8855   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8858   7E                     MOV   a,m   ; A = 型タグ
8859   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
885B   DA 6C 88               JC   send_not_falsy   
885E                             ; 真だった → false
885E   3A C2 88               LDA   send_reg_a   
8861   CD 03 84               CALL   get_reg_addr   
8864   3E 02                  MVI   a,TT_FALSE   
8866   CD 1D 84               CALL   set_slot_special   
8869   C3 07 8D               JMP   vm_loop   
886C                SEND_NOT_FALSY:      
886C                             ; 偽だった → true
886C   3A C2 88               LDA   send_reg_a   
886F   CD 03 84               CALL   get_reg_addr   
8872   3E 03                  MVI   a,TT_TRUE   
8874   CD 1D 84               CALL   set_slot_special   
8877   C3 07 8D               JMP   vm_loop   
887A                             ; ---------------------------------------------------------------
887A                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
887A                             ; ---------------------------------------------------------------
887A                SEND_MOD:      
887A   3A C2 88               LDA   send_reg_a   
887D   F5                     PUSH   psw   
887E   CD 0F 84               CALL   get_reg_addr_next   
8881   CD 35 84               CALL   slot_to_value   
8884   5E                     MOV   e,m   
8885   23                     INX   h   
8886   56                     MOV   d,m   ; DE = 除数
8887   7A                     MOV   a,d   
8888   B3                     ORA   e   
8889   C2 90 88               JNZ   send_mod_ok   
888C   F1                     POP   psw   
888D   C3 03 00               JMP   vm_error   ; ゼロ除算
8890                SEND_MOD_OK:      
8890   F1                     POP   psw   
8891   CD 03 84               CALL   get_reg_addr   
8894   CD 35 84               CALL   slot_to_value   
8897   E5                     PUSH   h   ; 書き戻し先
8898   4E                     MOV   c,m   
8899   23                     INX   h   
889A   46                     MOV   b,m   ; BC = 被除数
889B   CD C4 88               CALL   smod16   ; BC = 剰余 (除数と同符号)
889E   E1                     POP   h   
889F   71                     MOV   m,c   
88A0   23                     INX   h   
88A1   70                     MOV   m,b   
88A2   C3 07 8D               JMP   vm_loop   
88A5                             ; ---------------------------------------------------------------
88A5                             ; abs (絶対値): R[a] = |R[a]|
88A5                             ; ---------------------------------------------------------------
88A5                SEND_ABS:      
88A5   3A C2 88               LDA   send_reg_a   
88A8   CD 03 84               CALL   get_reg_addr   
88AB   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭
88AE   23                     INX   h   ; HL → val_hi
88AF   7E                     MOV   a,m   
88B0   E6 80                  ANI   80h   
88B2   CA 07 8D               JZ   vm_loop   ; 正ならそのまま
88B5   2B                     DCX   h   ; HL → val_lo
88B6   4E                     MOV   c,m   
88B7   23                     INX   h   
88B8   46                     MOV   b,m   ; BC = 値
88B9   CD 84 86               CALL   neg_bc   
88BC   70                     MOV   m,b   ; val_hi
88BD   2B                     DCX   h   
88BE   71                     MOV   m,c   ; val_lo
88BF   C3 07 8D               JMP   vm_loop   
88C2                             ; --- 一時変数 ---
88C2                SEND_REG_A:      
88C2   00                     DB   0   
88C3                SEND_ARGC:      
88C3   00                     DB   0   
88C4                             ; ---------------------------------------------------------------
88C4                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
88C4                             ; 
88C4                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
88C4                             ;   出力: BC = 剰余 (除数と同符号)
88C4                             ;   破壊: A, DE, HL
88C4                             ; 
88C4                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
88C4                             ; ---------------------------------------------------------------
88C4                SMOD16:      
88C4                             ; 除数の符号を保存
88C4   7A                     MOV   a,d   
88C5   F5                     PUSH   psw   
88C6                             ; 符号の差を保存 (bit7: 異符号なら 1)
88C6   78                     MOV   a,b   
88C7   AA                     XRA   d   
88C8   F5                     PUSH   psw   
88C9                             ; 被除数を正にする
88C9   78                     MOV   a,b   
88CA   E6 80                  ANI   80h   
88CC   CA D2 88               JZ   smod_chk_div   
88CF   CD 84 86               CALL   neg_bc   
88D2                SMOD_CHK_DIV:      
88D2   7A                     MOV   a,d   
88D3   E6 80                  ANI   80h   
88D5   CA DB 88               JZ   smod_do   
88D8   CD 8C 86               CALL   neg_de   
88DB                SMOD_DO:      
88DB   D5                     PUSH   d   ; |除数| を退避
88DC   CD 4D 86               CALL   udiv16   ; BC = 商, HL = 剰余
88DF   44                     MOV   b,h   
88E0   4D                     MOV   c,l   ; BC = |剰余|
88E1   78                     MOV   a,b   
88E2   B1                     ORA   c   
88E3   D1                     POP   d   ; DE = |除数|
88E4   F1                     POP   psw   ; 符号差 (bit7)
88E5   CA FA 88               JZ   smod_zero   ; 剰余 = 0
88E8   E6 80                  ANI   80h   
88EA   CA F3 88               JZ   smod_sign   ; 同符号 → 大きさはそのまま
88ED                             ; 異符号: 大きさ = |除数| - |剰余|
88ED   7B                     MOV   a,e   
88EE   91                     SUB   c   
88EF   4F                     MOV   c,a   
88F0   7A                     MOV   a,d   
88F1   98                     SBB   b   
88F2   47                     MOV   b,a   
88F3                SMOD_SIGN:      
88F3   F1                     POP   psw   ; 除数の符号 (bit7)
88F4   E6 80                  ANI   80h   
88F6   C8                     RZ      ; 除数が正 → 正の剰余
88F7   C3 84 86               JMP   neg_bc   ; 除数が負 → 負にする
88FA                SMOD_ZERO:      
88FA   F1                     POP   psw   ; 除数の符号を捨てる
88FB   C9                     RET      
88FC                             ; vm_frame.a80 — フレームスタック管理
88FC                             ; 
88FC                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
88FC                             ; 
88FC                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
88FC                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
88FC                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
88FC                             ;   get_frame_addr : フレーム番号 → メモリアドレス
88FC                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
88FC                             ; ---------------------------------------------------------------
88FC                             ; get_frame_addr — フレーム番号 → アドレス
88FC                             ; 
88FC                             ;   入力: A = フレーム番号 (0-7)
88FC                             ;   出力: HL = FRAME_STACK_BASE + A * 12
88FC                             ;   破壊: A, B, DE
88FC                             ; ---------------------------------------------------------------
88FC                GET_FRAME_ADDR:      
88FC   4F                     MOV   c,a   ; C = 元の値 (退避)
88FD   87                     ADD   a   ; ×2
88FE   47                     MOV   b,a   ; B = ×2
88FF   87                     ADD   a   ; ×4
8900   80                     ADD   b   ; ×4 + ×2 = ×6
8901   87                     ADD   a   ; ×12
8902   5F                     MOV   e,a   
8903   16 00                  MVI   d,0   ; DE = frame * 12
8905   21 00 B1               LXI   h,FRAME_STACK_BASE   
8908   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
8909   C9                     RET      
890A                             ; ---------------------------------------------------------------
890A                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
890A                             ; 
890A                             ;   入力: なし
890A                             ;   出力: HL = 現在のフレームのアドレス
890A                             ;   破壊: A, B, C, DE
890A                             ; ---------------------------------------------------------------
890A                CUR_FRAME_ADDR:      
890A   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
890D   3D                     DCR   a   
890E   C3 FC 88               JMP   get_frame_addr   
8911                             ; ---------------------------------------------------------------
8911                             ; push_frame — 現在の状態をフレームに保存
8911                             ; 
8911                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
8911                             ;          B = フレーム種別 (FRAME_KIND_*)
8911                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
8911                             ;   出力: なし
8911                             ;   破壊: A, B, C, HL, DE
8911                             ; 
8911                             ; frame_sp のスロットに保存して frame_sp++。
8911                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
8911                             ; ---------------------------------------------------------------
8911                PUSH_FRAME:      
8911                             ; パラメータを退避
8911   32 69 89               STA   pf_shift_reg   
8914   78                     MOV   a,b   
8915   32 6A 89               STA   pf_kind   
8918   79                     MOV   a,c   
8919   32 6B 89               STA   pf_outer   
891C                             ; HL = frame[frame_sp]
891C   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
891F   CD FC 88               CALL   get_frame_addr   
8922                             ; +0,+1: return_pc
8922   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
8925   77                     MOV   m,a   
8926   23                     INX   h   
8927   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
892A   77                     MOV   m,a   
892B   23                     INX   h   
892C                             ; +2: return_irep
892C   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
892F   77                     MOV   m,a   
8930   23                     INX   h   
8931                             ; +3,+4: return_reg_base
8931   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
8934   77                     MOV   m,a   
8935   23                     INX   h   
8936   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
8939   77                     MOV   m,a   
893A   23                     INX   h   
893B                             ; +5: kind
893B   3A 6A 89               LDA   pf_kind   
893E   77                     MOV   m,a   
893F   23                     INX   h   
8940                             ; +6,+7: index = 0
8940   36 00                  MVI   m,0   
8942   23                     INX   h   
8943   36 00                  MVI   m,0   
8945   23                     INX   h   
8946                             ; +8,+9: limit = 0
8946   36 00                  MVI   m,0   
8948   23                     INX   h   
8949   36 00                  MVI   m,0   
894B   23                     INX   h   
894C                             ; +10: outer
894C   3A 6B 89               LDA   pf_outer   
894F   77                     MOV   m,a   
8950                             ; reg_base += shift_reg * 4
8950   3A 69 89               LDA   pf_shift_reg   
8953   87                     ADD   a   ; ×2
8954   87                     ADD   a   ; ×4
8955   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
8958   85                     ADD   l   
8959   6F                     MOV   l,a   
895A   3E 00                  MVI   a,0   
895C   8C                     ADC   h   
895D   67                     MOV   h,a   
895E   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
8961                             ; frame_sp++
8961   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8964   3C                     INR   a   
8965   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
8968   C9                     RET      
8969                             ; push_frame の一時変数
8969   00           PF_SHIFT_REG:   DB   0   
896A   00           PF_KIND:   DB   0   
896B   00           PF_OUTER:   DB   0   
896C                             ; ---------------------------------------------------------------
896C                             ; pop_frame — frame_sp-- して保存した状態を復帰
896C                             ; 
896C                             ;   入力: なし
896C                             ;   出力: なし
896C                             ;   破壊: A, B, C, HL, DE
896C                             ; 
896C                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
896C                             ; ---------------------------------------------------------------
896C                POP_FRAME:      
896C                             ; frame_sp--
896C   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
896F   3D                     DCR   a   
8970   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
8973                             ; HL = frame[frame_sp] (decremented value)
8973   CD FC 88               CALL   get_frame_addr   
8976                             ; +0,+1: restore return_pc
8976   7E                     MOV   a,m   
8977   32 00 80               STA   VM_STATE_BASE + OFF_PC   
897A   23                     INX   h   
897B   7E                     MOV   a,m   
897C   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
897F   23                     INX   h   
8980                             ; +2: return_irep → switch_irep 用に退避
8980   7E                     MOV   a,m   
8981   32 95 89               STA   popf_ret_irep   
8984   23                     INX   h   
8985                             ; +3,+4: restore return_reg_base
8985   7E                     MOV   a,m   
8986   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
8989   23                     INX   h   
898A   7E                     MOV   a,m   
898B   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
898E                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
898E   3A 95 89               LDA   popf_ret_irep   
8991   CD 96 89               CALL   switch_irep   
8994   C9                     RET      
8995   00           POPF_RET_IREP:   DB   0   
8996                             ; ---------------------------------------------------------------
8996                             ; switch_irep — IREP テーブルから実行情報をロード
8996                             ; 
8996                             ;   入力: A = IREP 番号
8996                             ;   出力: なし
8996                             ;   破壊: A, B, C, HL, DE
8996                             ; 
8996                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
8996                             ; ---------------------------------------------------------------
8996                SWITCH_IREP:      
8996   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
8999                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
8999                             ; A * 10 = A * 8 + A * 2
8999   4F                     MOV   c,a   ; C = A (退避)
899A   87                     ADD   a   ; ×2
899B   47                     MOV   b,a   ; B = A*2
899C   79                     MOV   a,c   
899D   87                     ADD   a   ; ×2
899E   87                     ADD   a   ; ×4
899F   87                     ADD   a   ; ×8
89A0   80                     ADD   b   ; A*8 + A*2 = A*10
89A1   5F                     MOV   e,a   
89A2   16 00                  MVI   d,0   
89A4   21 00 82               LXI   h,IREP_TABLE_BASE   
89A7   19                     DAD   d   ; HL = エントリアドレス
89A8                             ; +0,+1: bytecode base → BC_BASE
89A8   7E                     MOV   a,m   
89A9   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
89AC   23                     INX   h   
89AD   7E                     MOV   a,m   
89AE   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
89B1   23                     INX   h   
89B2                             ; +2,+3: bytecode len → BC_LEN
89B2   7E                     MOV   a,m   
89B3   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
89B6   23                     INX   h   
89B7   7E                     MOV   a,m   
89B8   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
89BB   23                     INX   h   
89BC                             ; +4,+5: pool base (スキップ)
89BC   23                     INX   h   
89BD   23                     INX   h   
89BE                             ; +6: nregs
89BE   7E                     MOV   a,m   
89BF   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
89C2                             ; +7: first_child (スキップ)
89C2   23                     INX   h   
89C3                             ; +8,+9: sym_table_base → SYM_BASE
89C3   23                     INX   h   
89C4   7E                     MOV   a,m   
89C5   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
89C8   23                     INX   h   
89C9   7E                     MOV   a,m   
89CA   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
89CD   C9                     RET      
89CE                             ; vm_block.a80 — ブロック関連オペコード
89CE                             ; 
89CE                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
89CE                             ; ---------------------------------------------------------------
89CE                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
89CE                             ; ---------------------------------------------------------------
89CE                DO_OP_LOADSELF:      
89CE   CD 7A 84               CALL   fetch_byte   ; A = a
89D1   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
89D4   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
89D6   23                     INX   h   
89D7   36 00                  MVI   m,0   ; +1: 予約
89D9   23                     INX   h   
89DA   36 00                  MVI   m,0   ; +2: val_lo = 0
89DC   23                     INX   h   
89DD   36 00                  MVI   m,0   ; +3: val_hi = 0
89DF   C3 07 8D               JMP   vm_loop   
89E2                             ; ---------------------------------------------------------------
89E2                             ; OP_BLOCK (BB): R[a] = Proc(irep=first_child+b, outer=frame_sp)
89E2                             ; 
89E2                             ; ブロックを TT_PROC としてレジスタに格納する。
89E2                             ;   値の下位バイト = 子 irep 番号
89E2                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
89E2                             ; ---------------------------------------------------------------
89E2                DO_OP_BLOCK:      
89E2   CD 7A 84               CALL   fetch_byte   ; A = a
89E5   32 2B 8A               STA   blk_reg_a   
89E8   CD 7A 84               CALL   fetch_byte   ; A = b (子 irep インデックス)
89EB   32 2C 8A               STA   blk_child_idx   
89EE                             ; 子 irep 番号 = IREP テーブル[cur_irep].first_child + b
89EE                             ; まず cur_irep のエントリアドレスを求める
89EE   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
89F1                             ; A * 10 (IREP_ENTRY_BYTES)
89F1   4F                     MOV   c,a   
89F2   87                     ADD   a   ; ×2
89F3   47                     MOV   b,a   ; B = ×2
89F4   79                     MOV   a,c   
89F5   87                     ADD   a   ; ×2
89F6   87                     ADD   a   ; ×4
89F7   87                     ADD   a   ; ×8
89F8   80                     ADD   b   ; ×10
89F9   5F                     MOV   e,a   
89FA   16 00                  MVI   d,0   
89FC   21 00 82               LXI   h,IREP_TABLE_BASE   
89FF   19                     DAD   d   ; HL = エントリアドレス
8A00                             ; +7 = IREP_OFF_FIRST_CHILD
8A00   11 07 00               LXI   d,IREP_OFF_FIRST_CHILD   
8A03   19                     DAD   d   
8A04   7E                     MOV   a,m   ; A = first_child
8A05   3A 2C 8A               LDA   blk_child_idx   
8A08   47                     MOV   b,a   ; B = child index
8A09   7E                     MOV   a,m   ; A = first_child (re-read)
8A0A   80                     ADD   b   ; A = first_child + b = 子 irep 番号
8A0B                             ; R[a] に TT_PROC を書く
8A0B   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
8A0C   3A 2B 8A               LDA   blk_reg_a   
8A0F   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8A12   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
8A14   23                     INX   h   
8A15   36 00                  MVI   m,0   ; +1: 予約
8A17   23                     INX   h   
8A18   71                     MOV   m,c   ; +2: val_lo = irep 番号
8A19   23                     INX   h   
8A1A                             ; val_hi = 外側フレーム番号
8A1A                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
8A1A                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
8A1A   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8A1D   B7                     ORA   a   
8A1E   C2 26 8A               JNZ   block_in_frame   
8A21   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
8A23   C3 27 8A               JMP   block_set_outer   
8A26                BLOCK_IN_FRAME:      
8A26   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
8A27                BLOCK_SET_OUTER:      
8A27   77                     MOV   m,a   ; +3: val_hi = outer frame
8A28   C3 07 8D               JMP   vm_loop   
8A2B   00           BLK_REG_A:   DB   0   
8A2C   00           BLK_CHILD_IDX:   DB   0   
8A2D                             ; ---------------------------------------------------------------
8A2D                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
8A2D                             ; 
8A2D                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
8A2D                             ; ---------------------------------------------------------------
8A2D                DO_OP_ENTER:      
8A2D   CD 7A 84               CALL   fetch_byte   ; 読み飛ばし (byte 1)
8A30   CD 7A 84               CALL   fetch_byte   ; 読み飛ばし (byte 2)
8A33   CD 7A 84               CALL   fetch_byte   ; 読み飛ばし (byte 3)
8A36   C3 07 8D               JMP   vm_loop   
8A39                             ; ---------------------------------------------------------------
8A39                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
8A39                             ; 
8A39                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
8A39                             ; ブロック付きメソッド呼び出しを行う。
8A39                             ; ---------------------------------------------------------------
8A39                DO_OP_SSENDB:      
8A39                             ; オペランドをプリフェッチ
8A39   CD 7A 84               CALL   fetch_byte   ; A = a
8A3C   32 29 8B               STA   sendb_reg_a   
8A3F   CD 7A 84               CALL   fetch_byte   ; A = b (シンボル番号)
8A42   32 2A 8B               STA   sendb_sym_b   
8A45   CD 7A 84               CALL   fetch_byte   ; A = c (argc)
8A48   32 2B 8B               STA   sendb_argc   
8A4B                             ; R[0] → R[a] コピー (self を設定)
8A4B   3E 00                  MVI   a,0   
8A4D   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8A50   E5                     PUSH   h   ; R[0] アドレス退避
8A51   3A 29 8B               LDA   sendb_reg_a   
8A54   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8A57   EB                     XCHG      ; DE = R[a]
8A58   E1                     POP   h   ; HL = R[0]
8A59   CD 28 84               CALL   copy_slot   ; R[a] = R[0]
8A5C   C3 71 8A               JMP   sendb_dispatch   
8A5F                             ; ---------------------------------------------------------------
8A5F                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
8A5F                             ; 
8A5F                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
8A5F                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
8A5F                             ; ---------------------------------------------------------------
8A5F                DO_OP_SENDB:      
8A5F   CD 7A 84               CALL   fetch_byte   ; A = a
8A62   32 29 8B               STA   sendb_reg_a   
8A65   CD 7A 84               CALL   fetch_byte   ; A = b (シンボル番号)
8A68   32 2A 8B               STA   sendb_sym_b   
8A6B   CD 7A 84               CALL   fetch_byte   ; A = c (argc)
8A6E   32 2B 8B               STA   sendb_argc   
8A71                SENDB_DISPATCH:      
8A71                             ; シンボルテーブルからメソッド ID を取得
8A71   3A 2A 8B               LDA   sendb_sym_b   
8A74   87                     ADD   a   ; ×2
8A75   5F                     MOV   e,a   
8A76   16 00                  MVI   d,0   
8A78   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
8A7B   19                     DAD   d   ; HL = sym_table[b]
8A7C   7E                     MOV   a,m   ; メソッド ID (下位)
8A7D   32 2C 8B               STA   sendb_method_id   
8A80                             ; メソッド ID で振り分け
8A80   3A 2C 8B               LDA   sendb_method_id   
8A83   FE 0B                  CPI   11   ; METHOD_TIMES
8A85   CA 90 8A               JZ   sendb_times   
8A88   FE 1B                  CPI   27   ; METHOD_LOOP
8A8A   CA F3 8A               JZ   sendb_loop   
8A8D                             ; 未対応のブロックメソッド
8A8D   C3 03 00               JMP   vm_error   
8A90                             ; --- times ---
8A90                SENDB_TIMES:      
8A90                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
8A90   3A 29 8B               LDA   sendb_reg_a   
8A93   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8A96   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
8A99   4E                     MOV   c,m   ; C = val_lo
8A9A   23                     INX   h   
8A9B   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
8A9C                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
8A9C   78                     MOV   a,b   
8A9D   B1                     ORA   c   
8A9E   CA 07 8D               JZ   vm_loop   ; receiver == 0 → スキップ
8AA1                             ; limit = BC - 1
8AA1   0B                     DCX   b   ; BC = limit
8AA2                             ; push_frame: A=レジスタ番号, B=kind, C=outer
8AA2                             ; ブロックの位置: R[a + argc + 1]
8AA2   3A 29 8B               LDA   sendb_reg_a   
8AA5   C5                     PUSH   b   ; limit を退避
8AA6                             ; ブロック (TT_PROC) の情報を読む
8AA6   3A 2B 8B               LDA   sendb_argc   
8AA9   3C                     INR   a   ; argc + 1
8AAA   47                     MOV   b,a   
8AAB   3A 29 8B               LDA   sendb_reg_a   
8AAE   80                     ADD   b   ; A = a + argc + 1
8AAF   CD 03 84               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
8AB2   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
8AB5   7E                     MOV   a,m   ; A = irep 番号
8AB6   32 2D 8B               STA   sendb_block_irep   
8AB9   23                     INX   h   
8ABA   7E                     MOV   a,m   ; A = outer frame (val_hi)
8ABB   32 2E 8B               STA   sendb_block_outer   
8ABE                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
8ABE   3A 29 8B               LDA   sendb_reg_a   
8AC1   06 01                  MVI   b,FRAME_KIND_ITERATE   
8AC3   3A 2E 8B               LDA   sendb_block_outer   
8AC6   4F                     MOV   c,a   
8AC7   3A 29 8B               LDA   sendb_reg_a   
8ACA   CD 11 89               CALL   push_frame   
8ACD                             ; フレームに limit を設定
8ACD                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
8ACD   CD 0A 89               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
8AD0   11 08 00               LXI   d,FRAME_OFF_LIMIT   
8AD3   19                     DAD   d   ; HL = &limit
8AD4   C1                     POP   b   ; BC = limit (ここで復帰)
8AD5   71                     MOV   m,c   ; limit_lo
8AD6   23                     INX   h   
8AD7   70                     MOV   m,b   ; limit_hi
8AD8                             ; ブロック引数 R[1] = 0 (初期カウンタ)
8AD8                             ; R[1] は新しい reg_base から見た R[1]
8AD8   3E 01                  MVI   a,1   
8ADA   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8ADD   06 00                  MVI   b,0   
8ADF   0E 00                  MVI   c,0   
8AE1   CD 13 84               CALL   set_slot_int16   ; R[1] = 0
8AE4                             ; 子 irep に切り替え
8AE4   3A 2D 8B               LDA   sendb_block_irep   
8AE7   CD 96 89               CALL   switch_irep   
8AEA                             ; PC = 0
8AEA   21 00 00               LXI   h,0   
8AED   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8AF0   C3 07 8D               JMP   vm_loop   
8AF3                             ; --- loop ---
8AF3                SENDB_LOOP:      
8AF3                             ; ブロックの位置: R[a + argc + 1]
8AF3   3A 2B 8B               LDA   sendb_argc   
8AF6   3C                     INR   a   
8AF7   47                     MOV   b,a   
8AF8   3A 29 8B               LDA   sendb_reg_a   
8AFB   80                     ADD   b   ; A = a + argc + 1
8AFC   CD 03 84               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
8AFF   CD 35 84               CALL   slot_to_value   
8B02   7E                     MOV   a,m   ; irep 番号
8B03   32 2D 8B               STA   sendb_block_irep   
8B06   23                     INX   h   
8B07   7E                     MOV   a,m   ; outer
8B08   32 2E 8B               STA   sendb_block_outer   
8B0B                             ; push_frame(a, FRAME_KIND_LOOP, outer)
8B0B   3A 29 8B               LDA   sendb_reg_a   
8B0E   06 04                  MVI   b,FRAME_KIND_LOOP   
8B10   3A 2E 8B               LDA   sendb_block_outer   
8B13   4F                     MOV   c,a   
8B14   3A 29 8B               LDA   sendb_reg_a   
8B17   CD 11 89               CALL   push_frame   
8B1A                             ; 子 irep に切り替え
8B1A   3A 2D 8B               LDA   sendb_block_irep   
8B1D   CD 96 89               CALL   switch_irep   
8B20                             ; PC = 0
8B20   21 00 00               LXI   h,0   
8B23   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8B26   C3 07 8D               JMP   vm_loop   
8B29                             ; OP_SENDB の一時変数
8B29   00           SENDB_REG_A:   DB   0   
8B2A   00           SENDB_SYM_B:   DB   0   
8B2B   00           SENDB_ARGC:   DB   0   
8B2C   00           SENDB_METHOD_ID:   DB   0   
8B2D   00           SENDB_BLOCK_IREP:   DB   0   
8B2E   00           SENDB_BLOCK_OUTER:   DB   0   
8B2F                             ; ---------------------------------------------------------------
8B2F                             ; OP_BREAK (B): ブロックから脱出
8B2F                             ; 
8B2F                             ; R[a] の値を R[0] にコピーして pop_frame。
8B2F                             ; ---------------------------------------------------------------
8B2F                DO_OP_BREAK:      
8B2F   CD 7A 84               CALL   fetch_byte   ; A = a
8B32                             ; R[a] → R[0] コピー
8B32   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8B35   E5                     PUSH   h   ; R[a] アドレス退避
8B36   3E 00                  MVI   a,0   
8B38   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8B3B   EB                     XCHG      ; DE = R[0]
8B3C   E1                     POP   h   ; HL = R[a]
8B3D   CD 28 84               CALL   copy_slot   ; R[0] = R[a]
8B40   CD 6C 89               CALL   pop_frame   
8B43   C3 07 8D               JMP   vm_loop   
8B46                             ; vm_upvar.a80 — 外側スコープの変数アクセス
8B46                             ; 
8B46                             ; OP_GETUPVAR, OP_SETUPVAR
8B46                             ; 
8B46                             ; ブロック内から外側のローカル変数にアクセスする。
8B46                             ; outer フレーム chain を level 段辿って reg_base を求める。
8B46                             ; ---------------------------------------------------------------
8B46                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
8B46                             ; 
8B46                             ;   入力: A = level (何段外側か)
8B46                             ;   出力: HL = 外側スコープの reg_base アドレス
8B46                             ;   破壊: A, B, C, DE
8B46                             ; 
8B46                             ; outer chain を level 段辿る。FRAME_NONE に達したら
8B46                             ; REG_FILE_BASE (トップレベル) を返す。
8B46                             ; ---------------------------------------------------------------
8B46                UPVAR_BASE:      
8B46   47                     MOV   b,a   ; B = level (残り段数)
8B47                             ; まず現在のフレームの outer を読む
8B47   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8B4A   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
8B4B   32 78 8B               STA   upvar_frame   
8B4E                UPVAR_LOOP:      
8B4E                             ; outer フレーム番号を読む
8B4E   3A 78 8B               LDA   upvar_frame   
8B51   CD FC 88               CALL   get_frame_addr   ; HL = フレームアドレス
8B54   11 0A 00               LXI   d,FRAME_OFF_OUTER   
8B57   19                     DAD   d   
8B58   7E                     MOV   a,m   ; A = outer frame 番号
8B59   FE FF                  CPI   FRAME_NONE   
8B5B   CA 74 8B               JZ   upvar_toplevel   ; トップレベルに達した
8B5E   32 78 8B               STA   upvar_frame   ; 次のフレーム
8B61   05                     DCR   b   
8B62   C2 4E 8B               JNZ   upvar_loop   ; まだ辿る段がある
8B65                             ; level 回辿り終わった — upvar_frame の reg_base を返す
8B65   3A 78 8B               LDA   upvar_frame   
8B68   CD FC 88               CALL   get_frame_addr   ; HL = フレームアドレス
8B6B   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
8B6E   19                     DAD   d   
8B6F   5E                     MOV   e,m   
8B70   23                     INX   h   
8B71   56                     MOV   d,m   ; DE = return_reg_base
8B72   EB                     XCHG      ; HL = return_reg_base
8B73   C9                     RET      
8B74                UPVAR_TOPLEVEL:      
8B74   21 00 81               LXI   h,REG_FILE_BASE   
8B77   C9                     RET      
8B78   00           UPVAR_FRAME:   DB   0   
8B79                             ; ---------------------------------------------------------------
8B79                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
8B79                             ; 
8B79                             ;   a = コピー先レジスタ
8B79                             ;   b = 外側スコープのレジスタ番号
8B79                             ;   c = level (何段外側か)
8B79                             ; ---------------------------------------------------------------
8B79                DO_OP_GETUPVAR:      
8B79   CD 7A 84               CALL   fetch_byte   ; A = a
8B7C   32 CF 8B               STA   upvar_reg_a   
8B7F   CD 7A 84               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
8B82   32 D0 8B               STA   upvar_reg_b   
8B85   CD 7A 84               CALL   fetch_byte   ; A = c (level)
8B88                             ; 外側の reg_base を求める
8B88   CD 46 8B               CALL   upvar_base   ; HL = 外側の reg_base
8B8B                             ; 外側の R[b] のアドレス = base + b * 4
8B8B   3A D0 8B               LDA   upvar_reg_b   
8B8E   87                     ADD   a   ; ×2
8B8F   87                     ADD   a   ; ×4
8B90   85                     ADD   l   
8B91   6F                     MOV   l,a   
8B92   3E 00                  MVI   a,0   
8B94   8C                     ADC   h   
8B95   67                     MOV   h,a   ; HL = 外側の R[b]
8B96                             ; R[a] にコピー
8B96   E5                     PUSH   h   ; コピー元退避
8B97   3A CF 8B               LDA   upvar_reg_a   
8B9A   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8B9D   EB                     XCHG      ; DE = R[a] (コピー先)
8B9E   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
8B9F   CD 28 84               CALL   copy_slot   
8BA2   C3 07 8D               JMP   vm_loop   
8BA5                             ; ---------------------------------------------------------------
8BA5                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
8BA5                             ; 
8BA5                             ;   a = コピー元レジスタ
8BA5                             ;   b = 外側スコープのレジスタ番号
8BA5                             ;   c = level (何段外側か)
8BA5                             ; ---------------------------------------------------------------
8BA5                DO_OP_SETUPVAR:      
8BA5   CD 7A 84               CALL   fetch_byte   ; A = a
8BA8   32 CF 8B               STA   upvar_reg_a   
8BAB   CD 7A 84               CALL   fetch_byte   ; A = b
8BAE   32 D0 8B               STA   upvar_reg_b   
8BB1   CD 7A 84               CALL   fetch_byte   ; A = c (level)
8BB4                             ; 外側の reg_base を求める
8BB4   CD 46 8B               CALL   upvar_base   ; HL = 外側の reg_base
8BB7                             ; 外側の R[b] のアドレス = base + b * 4
8BB7   3A D0 8B               LDA   upvar_reg_b   
8BBA   87                     ADD   a   
8BBB   87                     ADD   a   
8BBC   85                     ADD   l   
8BBD   6F                     MOV   l,a   
8BBE   3E 00                  MVI   a,0   
8BC0   8C                     ADC   h   
8BC1   67                     MOV   h,a   ; HL = 外側の R[b]
8BC2   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
8BC3                             ; R[a] からコピー
8BC3   3A CF 8B               LDA   upvar_reg_a   
8BC6   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
8BC9   CD 28 84               CALL   copy_slot   
8BCC   C3 07 8D               JMP   vm_loop   
8BCF   00           UPVAR_REG_A:   DB   0   
8BD0   00           UPVAR_REG_B:   DB   0   
8BD1                             ; vm_display.a80 — 7 セグメント表示
8BD1                             ; 
8BD1                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
8BD1                             ; 上位 4 桁はブランク（消灯）にする。
8BD1                             ; セグメントパターンは seg_table にまとめる。
8BD1                             ; ---------------------------------------------------------------
8BD1                             ; display_hex16 — 16 ビット値を 7 セグに表示
8BD1                             ; 
8BD1                             ;   入力: HL = 値の先頭 (val_lo の位置)
8BD1                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
8BD1                             ;   破壊: A, B, C, HL, DE
8BD1                             ; 
8BD1                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
8BD1                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
8BD1                             ; ---------------------------------------------------------------
8BD1                DISPLAY_HEX16:      
8BD1   E5                     PUSH   h   ; 値のアドレスを退避
8BD2                             ; 上位 4 桁をブランク (消灯) にする
8BD2   11 F8 FF               LXI   d,DISPLAY_BASE   
8BD5   AF                     XRA   a   ; A = 0 (全セグメント消灯)
8BD6   12                     STAX   d   
8BD7   13                     INX   d   
8BD8   12                     STAX   d   
8BD9   13                     INX   d   
8BDA   12                     STAX   d   
8BDB   13                     INX   d   
8BDC   12                     STAX   d   
8BDD   13                     INX   d   ; DE = DISPLAY_BASE + 4
8BDE                             ; 値の byte1 (val_hi) から表示
8BDE   E1                     POP   h   ; HL = val_lo
8BDF   23                     INX   h   ; HL = val_hi
8BE0   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
8BE2                DISPLAY_BYTE_LOOP:      
8BE2                             ; 上位ニブル
8BE2   7E                     MOV   a,m   
8BE3   0F                     RRC      
8BE4   0F                     RRC      
8BE5   0F                     RRC      
8BE6   0F                     RRC      
8BE7   E6 0F                  ANI   0Fh   
8BE9   CD FC 8B               CALL   nibble_to_seg   
8BEC   12                     STAX   d   
8BED   13                     INX   d   
8BEE                             ; 下位ニブル
8BEE   7E                     MOV   a,m   
8BEF   E6 0F                  ANI   0Fh   
8BF1   CD FC 8B               CALL   nibble_to_seg   
8BF4   12                     STAX   d   
8BF5   13                     INX   d   
8BF6                             ; 次のバイト (val_hi → val_lo)
8BF6   2B                     DCX   h   
8BF7   0D                     DCR   c   
8BF8   C2 E2 8B               JNZ   display_byte_loop   
8BFB   C9                     RET      
8BFC                             ; ---------------------------------------------------------------
8BFC                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
8BFC                             ; 
8BFC                             ;   入力: A = 0-F
8BFC                             ;   出力: A = セグメントパターン
8BFC                             ;   破壊: なし (HL, BC は内部で退避・復元)
8BFC                             ; ---------------------------------------------------------------
8BFC                NIBBLE_TO_SEG:      
8BFC   E5                     PUSH   h   
8BFD   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
8BFE   6F                     MOV   l,a   
8BFF   26 00                  MVI   h,0   
8C01   01 09 8C               LXI   b,seg_table   
8C04   09                     DAD   b   ; HL = seg_table + nibble
8C05   7E                     MOV   a,m   
8C06   C1                     POP   b   ; BC を復元
8C07   E1                     POP   h   
8C08   C9                     RET      
8C09                             ; ---------------------------------------------------------------
8C09                             ; 7 セグメントパターンテーブル
8C09                             ; 
8C09                             ;   bit 0 = a (上)
8C09                             ;   bit 1 = b (右上)
8C09                             ;   bit 2 = c (右下)
8C09                             ;   bit 3 = d (下)
8C09                             ;   bit 4 = e (左下)
8C09                             ;   bit 5 = f (左上)
8C09                             ;   bit 6 = g (中)
8C09                             ; 
8C09                             ;       aaa
8C09                             ;      f   b
8C09                             ;       ggg
8C09                             ;      e   c
8C09                             ;       ddd
8C09                             ; ---------------------------------------------------------------
8C09                SEG_TABLE:      
8C09   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
8C0A   06                     DB   06h   ; 1
8C0B   5B                     DB   5Bh   ; 2
8C0C   4F                     DB   4Fh   ; 3
8C0D   66                     DB   66h   ; 4
8C0E   6D                     DB   6Dh   ; 5
8C0F   7D                     DB   7Dh   ; 6
8C10   27                     DB   27h   ; 7  (ND8080 ROM パターン)
8C11   7F                     DB   7Fh   ; 8
8C12   6F                     DB   6Fh   ; 9
8C13   77                     DB   77h   ; A
8C14   7C                     DB   7Ch   ; b
8C15   39                     DB   39h   ; C
8C16   5E                     DB   5Eh   ; d
8C17   79                     DB   79h   ; E
8C18   71                     DB   71h   ; F
8C19                             ; ===============================================================
8C19                             ; OP_RETURN (B): ブロック内なら反復継続、トップレベルなら停止
8C19                             ; 
8C19                             ; frame_sp == 0 → トップレベル: 表示して停止
8C19                             ; frame_sp > 0  → ブロック内: advance_iteration
8C19                             ; ===============================================================
8C19                DO_OP_RETURN:      
8C19   CD 7A 84               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
8C1C   32 3D 8C               STA   return_reg_a   
8C1F                             ; フレームスタックが空ならトップレベル
8C1F   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8C22   B7                     ORA   a   
8C23   CA 29 8C               JZ   do_op_return_top   
8C26                             ; ブロック内 → 反復を進める
8C26   C3 3E 8C               JMP   advance_iteration   
8C29                DO_OP_RETURN_TOP:      
8C29   3A 3D 8C               LDA   return_reg_a   
8C2C   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8C2F   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8C32   CD D1 8B               CALL   display_hex16   
8C35   3E 02                  MVI   a,VM_FINISHED   
8C37   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8C3A   C3 9D 8C               JMP   vm_halt   
8C3D   00           RETURN_REG_A:   DB   0   
8C3E                             ; ===============================================================
8C3E                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
8C3E                             ; 
8C3E                             ; ITERATE (times): index++ して limit と比較。超えたら pop_frame。
8C3E                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
8C3E                             ; ===============================================================
8C3E                ADVANCE_ITERATION:      
8C3E                             ; フレーム種別を確認
8C3E   CD 0A 89               CALL   cur_frame_addr   ; HL = 現在のフレーム
8C41   11 05 00               LXI   d,FRAME_OFF_KIND   
8C44   19                     DAD   d   
8C45   7E                     MOV   a,m   ; A = kind
8C46   FE 04                  CPI   FRAME_KIND_LOOP   
8C48   CA 6D 8C               JZ   adv_reenter   ; loop → 常に再実行
8C4B                             ; --- ITERATE (times) ---
8C4B                             ; index をインクリメント
8C4B   CD 0A 89               CALL   cur_frame_addr   
8C4E   11 06 00               LXI   d,FRAME_OFF_INDEX   
8C51   19                     DAD   d   
8C52   4E                     MOV   c,m   ; C = index_lo
8C53   23                     INX   h   
8C54   46                     MOV   b,m   ; B = index_hi
8C55   03                     INX   b   ; BC = index + 1
8C56                             ; 書き戻す
8C56   70                     MOV   m,b   ; index_hi
8C57   2B                     DCX   h   
8C58   71                     MOV   m,c   ; index_lo
8C59                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
8C59   23                     INX   h   ; → &index_hi
8C5A   23                     INX   h   ; → &limit_lo
8C5B   5E                     MOV   e,m   ; E = limit_lo
8C5C   23                     INX   h   ; → &limit_hi
8C5D   56                     MOV   d,m   ; D = limit_hi
8C5E                             ; BC = new index, DE = limit
8C5E                             ; index > limit なら反復終了 (DE - BC でボロー発生)
8C5E   7B                     MOV   a,e   
8C5F   91                     SUB   c   
8C60   7A                     MOV   a,d   
8C61   98                     SBB   b   
8C62   DA 76 8C               JC   adv_done   ; index > limit → 反復終了
8C65                             ; まだ反復が残っている: R[1] = index, PC = 0
8C65   3E 01                  MVI   a,1   
8C67   CD 03 84               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
8C6A   CD 13 84               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
8C6D                ADV_REENTER:      
8C6D                             ; PC = 0 で再実行
8C6D   21 00 00               LXI   h,0   
8C70   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8C73   C3 07 8D               JMP   vm_loop   
8C76                ADV_DONE:      
8C76                             ; 反復完了 → フレームを破棄して親に戻る
8C76   CD 6C 89               CALL   pop_frame   
8C79   C3 07 8D               JMP   vm_loop   
8C7C                             ; ===============================================================
8C7C                             ; OP_STOP (Z): VM 停止
8C7C                             ; ===============================================================
8C7C                DO_OP_STOP:      
8C7C   3E 02                  MVI   a,VM_FINISHED   
8C7E   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8C81                             ; R[1] の値を 7 セグに表示
8C81   3E 01                  MVI   a,1   
8C83   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8C86   CD 35 84               CALL   slot_to_value   ; HL = R[1] の値先頭
8C89   CD D1 8B               CALL   display_hex16   
8C8C   C3 9D 8C               JMP   vm_halt   
8C8F                             ; ===============================================================
8C8F                             ; エラー停止
8C8F                             ; 
8C8F                             ; 未対応のオペコードを踏んだとき。
8C8F                             ; 現在のオペコードをエラーコードとして保存する。
8C8F                             ; ===============================================================
8C8F                VM_ERROR:      
8C8F   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8C92   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
8C95   3E 03                  MVI   a,VM_ERROR   
8C97   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8C9A   C3 9D 8C               JMP   vm_halt   
8C9D                             ; ===============================================================
8C9D                             ; 停止 — ND80Z モニタのリモートモードへ復帰
8C9D                             ; 
8C9D                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
8C9D                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
8C9D                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
8C9D                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
8C9D                             ; これにより自動的にリモートモードへ復帰する。
8C9D                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
8C9D                             ; ===============================================================
8C9D                VM_HALT:      
8C9D                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
8C9D                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
8C9D                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
8C9D   06 04                  MVI   b,4   
8C9F                VM_HALT_OUTER:      
8C9F   11 00 00               LXI   d,0   
8CA2                VM_HALT_INNER:      
8CA2   1B                     DCX   d   
8CA3   7A                     MOV   a,d   
8CA4   B3                     ORA   e   
8CA5   C2 A2 8C               JNZ   vm_halt_inner   
8CA8   05                     DCR   b   
8CA9   C2 9F 8C               JNZ   vm_halt_outer   
8CAC   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
8CAF                             ; ===============================================================
8CAF                             ; 初期化
8CAF                             ; ===============================================================
8CAF                VM_START:      
8CAF                             ; スタックポインタを設定
8CAF   31 00 FE               LXI   sp,STACK_TOP + 1   
8CB2                             ; VM 状態領域をゼロクリア (256 バイト)
8CB2   21 00 80               LXI   h,VM_STATE_BASE   
8CB5   0E 00                  MVI   c,0   ; 256 回 (0 は 256 として扱う)
8CB7                VM_CLEAR_STATE:      
8CB7   36 00                  MVI   m,0   
8CB9   23                     INX   h   
8CBA   0D                     DCR   c   
8CBB   C2 B7 8C               JNZ   vm_clear_state   
8CBE                             ; レジスタファイルをゼロクリア (256 バイト)
8CBE   21 00 81               LXI   h,REG_FILE_BASE   
8CC1   0E 00                  MVI   c,0   
8CC3                VM_CLEAR_REGS:      
8CC3   36 00                  MVI   m,0   
8CC5   23                     INX   h   
8CC6   0D                     DCR   c   
8CC7   C2 C3 8C               JNZ   vm_clear_regs   
8CCA                             ; IREP 0 のバイトコード長を VM 状態に設定
8CCA                             ; IREP テーブルの先頭エントリから読む
8CCA   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
8CCD   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
8CD0   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
8CD3   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
8CD6                             ; レジスタベースを初期化 (REG_FILE_BASE)
8CD6   21 00 81               LXI   h,REG_FILE_BASE   
8CD9   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
8CDC                             ; バイトコードベースを IREP 0 から読んで設定
8CDC   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
8CDF   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
8CE2   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
8CE5   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
8CE8                             ; シンボルテーブルベースを IREP 0 から読んで設定
8CE8   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
8CEB   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
8CEE   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
8CF1   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
8CF4                             ; フレーム SP = 0 (ゼロクリア済み)
8CF4                             ; PC = 0 (ゼロクリア済み)
8CF4                             ; R[0] = self (TT_OBJECT, 値 = 0)
8CF4   21 00 81               LXI   h,REG_FILE_BASE   
8CF7   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
8CF9   23                     INX   h   
8CFA   36 00                  MVI   m,0   ; +1: 予約
8CFC   23                     INX   h   
8CFD   36 00                  MVI   m,0   ; +2: val_lo
8CFF   23                     INX   h   
8D00   36 00                  MVI   m,0   ; +3: val_hi
8D02                             ; 実行状態を RUNNING に設定
8D02   3E 01                  MVI   a,VM_RUNNING   
8D04   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8D07                             ; メインループへ
8D07                             ; fall through
8D07                             ; ===============================================================
8D07                             ; メインループ (fetch-decode-execute)
8D07                             ; ===============================================================
8D07                VM_LOOP:      
8D07                             ; --- 実行状態の確認 ---
8D07   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
8D0A   FE 01                  CPI   VM_RUNNING   
8D0C   C2 9D 8C               JNZ   vm_halt   
8D0F                             ; --- PC がバイトコード長を超えていないか ---
8D0F   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
8D12   EB                     XCHG      ; DE = PC
8D13   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
8D16                             ; HL = bytecode_len, DE = PC
8D16                             ; PC >= bytecode_len ならエラー
8D16   7B                     MOV   a,e   
8D17   95                     SUB   l   
8D18   7A                     MOV   a,d   
8D19   9C                     SBB   h   ; DE - HL (PC - len)
8D1A   D2 03 00               JNC   vm_error   ; PC >= len → エラー
8D1D                             ; --- オペコードフェッチ ---
8D1D   CD 7A 84               CALL   fetch_byte   ; A = opcode
8D20   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8D23                             ; --- ステップカウント ---
8D23   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
8D26   23                     INX   h   
8D27   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
8D2A                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
8D2A   7C                     MOV   a,h   
8D2B   B5                     ORA   l   
8D2C   C2 36 8D               JNZ   vm_dispatch   
8D2F   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
8D32   23                     INX   h   
8D33   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
8D36                             ; --- ディスパッチ ---
8D36                VM_DISPATCH:      
8D36   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8D39                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
8D39   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
8D3A   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
8D3D   5F                     MOV   e,a   
8D3E   16 00                  MVI   d,0   ; DE = opcode * 2
8D40   21 58 8D               LXI   h,dispatch_table   
8D43   19                     DAD   d   ; HL = &dispatch_table[opcode]
8D44                             ; テーブル上限チェック
8D44   11 2C 8E               LXI   d,dispatch_table_end   
8D47   7B                     MOV   a,e   
8D48   95                     SUB   l   
8D49   7A                     MOV   a,d   
8D4A   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
8D4B   DA 03 00               JC   vm_error   ; テーブル範囲外
8D4E                             ; アドレスを読んでジャンプ
8D4E   5E                     MOV   e,m   ; E = 下位バイト
8D4F   23                     INX   h   
8D50   56                     MOV   d,m   ; D = 上位バイト
8D51   EB                     XCHG      ; HL = ハンドラアドレス
8D52                             ; 0000h ならエラー (未実装マーカー)
8D52   7C                     MOV   a,h   
8D53   B5                     ORA   l   
8D54   CA 03 00               JZ   vm_error   
8D57   E9                     PCHL      ; ハンドラへジャンプ
8D58                             ; ===============================================================
8D58                             ; ディスパッチテーブル
8D58                             ; 
8D58                             ; オペコード番号順に 2 バイトのアドレスを並べる。
8D58                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
8D58                             ; ===============================================================
8D58                DISPATCH_TABLE:      
8D58   98 84                  DW   do_op_nop   ; 00 OP_NOP
8D5A   9B 84                  DW   do_op_move   ; 01 OP_MOVE
8D5C   00 00                  DW   0000h   ; 02 OP_LOADL
