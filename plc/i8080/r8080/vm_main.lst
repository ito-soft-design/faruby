0000                             ; vm_main.a80 — faRuby i8080 VM エントリポイント
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (32KB RAM: 0x8000-0xFFFF) を想定。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; --- メモリマップ ---
0000                VM_CODE_ORG:   EQU   8400h   
0000                BYTECODE_BASE:   EQU   9000h   
0000                BYTECODE_SIZE:   EQU   1000h   
0000                POOL_BASE:   EQU   0A000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                             ; --- バリュースロット ---
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; --- VM 状態領域のオフセット ---
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                             ; --- IREP テーブルエントリ ---
0000                IREP_ENTRY_BYTES:   EQU   08h   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; --- VM 実行状態 ---
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; --- Phase 1 オペコード ---
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
8400                          .ORG   08400h   
8400                             ; ===============================================================
8400                             ; リセットベクタ
8400                             ; ===============================================================
8400   C3 22 87               JMP   vm_start   
8403                             ; ===============================================================
8403                             ; サブルーチン群 (.include で取り込む)
8403                             ; ===============================================================
8403                             ; vm_util.a80 — ユーティリティサブルーチン
8403                             ; 
8403                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
8403                             ; 他のすべてのモジュールがここに依存します。
8403                             ; 
8403                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
8403                             ;   +0: 型タグ (1B)
8403                             ;   +1: 予約   (1B, 常に 0)
8403                             ;   +2: val_lo (1B)
8403                             ;   +3: val_hi (1B)
8403                             ; ---------------------------------------------------------------
8403                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
8403                             ; 
8403                             ;   入力: A = レジスタ番号 (0-63)
8403                             ;   出力: HL = スロット先頭アドレス
8403                             ;   破壊: A
8403                             ; 
8403                             ; REG_FILE_BASE = 0x8100 (下位バイト 0x00) なので、
8403                             ; レジスタ番号 × 4 がそのまま L になり、H は固定。
8403                             ; ---------------------------------------------------------------
8403                GET_REG_ADDR:      
8403   87                     ADD   a   ; ×2
8404   87                     ADD   a   ; ×4
8405   6F                     MOV   l,a   
8406   26 81                  MVI   h,REG_FILE_BASE_HI   
8408   C9                     RET      
8409                             ; ---------------------------------------------------------------
8409                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
8409                             ; 
8409                             ;   入力: A = レジスタ番号 a
8409                             ;   出力: HL = R[a+1] のスロット先頭アドレス
8409                             ;   破壊: A
8409                             ; ---------------------------------------------------------------
8409                GET_REG_ADDR_NEXT:      
8409   3C                     INR   a   
840A   C3 03 84               JMP   get_reg_addr   
840D                             ; ---------------------------------------------------------------
840D                             ; set_slot_int16 — スロットに 16 ビット整数を書く
840D                             ; 
840D                             ;   入力: HL = スロット先頭アドレス
840D                             ;          B  = val_hi (上位バイト)
840D                             ;          C  = val_lo (下位バイト)
840D                             ;   出力: なし
840D                             ;   破壊: HL
840D                             ; ---------------------------------------------------------------
840D                SET_SLOT_INT16:      
840D   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
840F   23                     INX   h   
8410   36 00                  MVI   m,0   ; +1: 予約
8412   23                     INX   h   
8413   71                     MOV   m,c   ; +2: val_lo
8414   23                     INX   h   
8415   70                     MOV   m,b   ; +3: val_hi
8416   C9                     RET      
8417                             ; ---------------------------------------------------------------
8417                             ; set_slot_special — 値を持たない型をスロットに書く
8417                             ; 
8417                             ;   入力: HL = スロット先頭アドレス
8417                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
8417                             ;   出力: なし
8417                             ;   破壊: A, HL
8417                             ; ---------------------------------------------------------------
8417                SET_SLOT_SPECIAL:      
8417   77                     MOV   m,a   ; +0: 型タグ
8418   23                     INX   h   
8419   36 00                  MVI   m,0   ; +1: 予約
841B   23                     INX   h   
841C   36 00                  MVI   m,0   ; +2: val_lo = 0
841E   23                     INX   h   
841F   36 00                  MVI   m,0   ; +3: val_hi = 0
8421   C9                     RET      
8422                             ; ---------------------------------------------------------------
8422                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
8422                             ; 
8422                             ;   入力: HL = コピー元先頭
8422                             ;         DE = コピー先先頭
8422                             ;   出力: なし
8422                             ;   破壊: A, C, HL, DE
8422                             ; ---------------------------------------------------------------
8422                COPY_SLOT:      
8422   0E 04                  MVI   c,SLOT_BYTES   
8424                COPY_SLOT_LOOP:      
8424   7E                     MOV   a,m   
8425   12                     STAX   d   
8426   23                     INX   h   
8427   13                     INX   d   
8428   0D                     DCR   c   
8429   C2 24 84               JNZ   copy_slot_loop   
842C   C9                     RET      
842D                             ; ---------------------------------------------------------------
842D                             ; get_slot_type — スロットの型タグを読む
842D                             ; 
842D                             ;   入力: HL = スロット先頭アドレス
842D                             ;   出力: A = 型タグ
842D                             ;   破壊: なし (HL 保存)
842D                             ; ---------------------------------------------------------------
842D                GET_SLOT_TYPE:      
842D   7E                     MOV   a,m   
842E   C9                     RET      
842F                             ; ---------------------------------------------------------------
842F                             ; slot_to_value — スロット先頭から値の先頭へ進める
842F                             ; 
842F                             ;   入力: HL = スロット先頭アドレス
842F                             ;   出力: HL = 値の先頭 (スロット +2)
842F                             ;   破壊: なし
842F                             ; ---------------------------------------------------------------
842F                SLOT_TO_VALUE:      
842F   23                     INX   h   
8430   23                     INX   h   
8431   C9                     RET      
8432                             ; ---------------------------------------------------------------
8432                             ; add_value16 — 16 ビット加算 (val1 += val2)
8432                             ; 
8432                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8432                             ;         DE = 値 2 の先頭
8432                             ;   出力: 結果を HL の元の位置に上書き
8432                             ;   破壊: A, HL, DE
8432                             ; 
8432                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
8432                             ; ---------------------------------------------------------------
8432                ADD_VALUE16:      
8432   1A                     LDAX   d   ; A = val2[lo]
8433   86                     ADD   m   ; A += val1[lo]
8434   77                     MOV   m,a   ; val1[lo] = result
8435   23                     INX   h   
8436   13                     INX   d   
8437   1A                     LDAX   d   ; A = val2[hi]
8438   8E                     ADC   m   ; A += val1[hi] + CY
8439   77                     MOV   m,a   
843A   C9                     RET      
843B                             ; ---------------------------------------------------------------
843B                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
843B                             ; 
843B                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
843B                             ;         DE = 値 2 の先頭
843B                             ;   出力: 結果を HL の元の位置に上書き
843B                             ;   破壊: A, HL, DE
843B                             ; 
843B                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
843B                             ; ---------------------------------------------------------------
843B                SUB_VALUE16:      
843B   7E                     MOV   a,m   ; A = val1[lo]
843C   EB                     XCHG      ; HL=val2, DE=val1
843D   96                     SUB   m   ; A -= val2[lo]
843E   EB                     XCHG      ; HL=val1, DE=val2
843F   77                     MOV   m,a   ; val1[lo] = result
8440   23                     INX   h   
8441   13                     INX   d   
8442   7E                     MOV   a,m   ; A = val1[hi]
8443   EB                     XCHG      
8444   9E                     SBB   m   ; A -= val2[hi] - CY
8445   EB                     XCHG      
8446   77                     MOV   m,a   
8447   C9                     RET      
8448                             ; ---------------------------------------------------------------
8448                             ; cmp_value16 — 16 ビット符号付き比較
8448                             ; 
8448                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
8448                             ;         DE = 値 2 の先頭 (byte0 の位置)
8448                             ;   出力: A = 比較結果
8448                             ;           00h → val1 == val2
8448                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
8448                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
8448                             ;   破壊: A, B, HL, DE
8448                             ; 
8448                             ; 手順:
8448                             ;   1. 上位バイト (byte1) の符号ビットを比べる
8448                             ;   2. 符号が違えば、負の方が小さい
8448                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
8448                             ; ---------------------------------------------------------------
8448                CMP_VALUE16:      
8448                             ; byte1 (上位) の位置を求める
8448   23                     INX   h   ; HL = val1+1 (hi)
8449   13                     INX   d   ; DE = val2+1 (hi)
844A                             ; 符号ビットを比べる
844A   7E                     MOV   a,m   ; A = val1[hi]
844B   47                     MOV   b,a   ; B = val1[hi] (退避)
844C   1A                     LDAX   d   ; A = val2[hi]
844D   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
844E   F2 5A 84               JP   cmp16_same_sign   
8451                             ; 符号が違う: val1 が負なら val1 < val2
8451   78                     MOV   a,b   ; A = val1[hi]
8452   E6 80                  ANI   80h   ; bit7 を取り出す
8454   C2 6E 84               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
8457   C3 71 84               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
845A                CMP16_SAME_SIGN:      
845A                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
845A   1A                     LDAX   d   
845B   BE                     CMP   m   ; val2[hi] - val1[hi]
845C   DA 71 84               JC   cmp16_ret_pos   
845F   C2 6E 84               JNZ   cmp16_ret_neg   
8462   2B                     DCX   h   
8463   1B                     DCX   d   
8464   1A                     LDAX   d   
8465   BE                     CMP   m   ; val2[lo] - val1[lo]
8466   DA 71 84               JC   cmp16_ret_pos   
8469   C2 6E 84               JNZ   cmp16_ret_neg   
846C                             ; すべて等しい
846C   AF                     XRA   a   ; A = 00h
846D   C9                     RET      
846E                CMP16_RET_NEG:      
846E   3E FF                  MVI   a,0FFh   ; val1 < val2
8470   C9                     RET      
8471                CMP16_RET_POS:      
8471   3E 01                  MVI   a,01h   ; val1 > val2
8473   C9                     RET      
8474                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
8474                             ; 
8474                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
8474                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
8474                             ; ---------------------------------------------------------------
8474                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
8474                             ; 
8474                             ;   入力: なし
8474                             ;   出力: A = 読んだバイト
8474                             ;   破壊: HL, DE
8474                             ; 
8474                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
8474                             ; BYTECODE_BASE + PC で求めます。
8474                             ; ---------------------------------------------------------------
8474                FETCH_BYTE:      
8474   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
8477   11 00 90               LXI   d,BYTECODE_BASE   
847A   19                     DAD   d   ; HL = 絶対アドレス
847B   7E                     MOV   a,m   ; A = bytecode[PC]
847C                             ; PC をインクリメント
847C   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
847F   23                     INX   h   
8480   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8483   C9                     RET      
8484                             ; ---------------------------------------------------------------
8484                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
8484                             ; 
8484                             ;   入力: なし
8484                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
8484                             ;   破壊: A, B, DE
8484                             ; 
8484                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
8484                             ; 1 バイト目が上位、2 バイト目が下位。
8484                             ; ---------------------------------------------------------------
8484                FETCH_U16BE:      
8484   CD 74 84               CALL   fetch_byte   ; A = 上位バイト
8487   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
8488   CD 74 84               CALL   fetch_byte   ; A = 下位バイト
848B   6F                     MOV   l,a   
848C   60                     MOV   h,b   
848D   C9                     RET      
848E                             ; ---------------------------------------------------------------
848E                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
848E                             ; 
848E                             ;   入力: なし
848E                             ;   出力: HL = 読んだ符号付き 16 ビット値
848E                             ;   破壊: A, DE
848E                             ; 
848E                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
848E                             ; ---------------------------------------------------------------
848E                FETCH_S16BE:      
848E   C3 84 84               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
8491                             ; vm_load.a80 — ロード命令
8491                             ; 
8491                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
8491                             ; 
8491                             ; Phase 2: 16 ビットスロット (4 バイト)
8491                             ;   set_slot_int16: B=val_hi, C=val_lo
8491                             ; ---------------------------------------------------------------
8491                             ; OP_NOP (Z): 何もしない
8491                             ; ---------------------------------------------------------------
8491                DO_OP_NOP:      
8491   C3 4E 87               JMP   vm_loop   
8494                             ; ---------------------------------------------------------------
8494                             ; OP_MOVE (BB): R[a] = R[b]
8494                             ; ---------------------------------------------------------------
8494                DO_OP_MOVE:      
8494   CD 74 84               CALL   fetch_byte   ; A = a (コピー先)
8497   F5                     PUSH   psw   
8498   CD 74 84               CALL   fetch_byte   ; A = b (コピー元)
849B   CD 03 84               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
849E   EB                     XCHG      ; DE = R[b]
849F   F1                     POP   psw   ; A = a
84A0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84A3   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
84A4   CD 22 84               CALL   copy_slot   
84A7   C3 4E 87               JMP   vm_loop   
84AA                             ; ---------------------------------------------------------------
84AA                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
84AA                             ; ---------------------------------------------------------------
84AA                DO_OP_LOADI:      
84AA   CD 74 84               CALL   fetch_byte   ; A = a
84AD   F5                     PUSH   psw   
84AE   CD 74 84               CALL   fetch_byte   ; A = b (値)
84B1   4F                     MOV   c,a   ; C = val_lo
84B2   F1                     POP   psw   ; A = a
84B3   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84B6   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
84B7   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
84B9   CD 0D 84               CALL   set_slot_int16   
84BC   C3 4E 87               JMP   vm_loop   
84BF                             ; ---------------------------------------------------------------
84BF                             ; OP_LOADINEG (BB): R[a] = -b
84BF                             ; ---------------------------------------------------------------
84BF                DO_OP_LOADINEG:      
84BF   CD 74 84               CALL   fetch_byte   ; A = a
84C2   F5                     PUSH   psw   
84C3   CD 74 84               CALL   fetch_byte   ; A = b
84C6                             ; -b を計算 (0 - b)
84C6   4F                     MOV   c,a   ; C = b (退避)
84C7   AF                     XRA   a   ; A = 0
84C8   91                     SUB   c   ; A = -b
84C9   4F                     MOV   c,a   ; C = val_lo (-b)
84CA   F1                     POP   psw   ; A = a
84CB   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84CE   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
84D0   CD 0D 84               CALL   set_slot_int16   
84D3   C3 4E 87               JMP   vm_loop   
84D6                             ; ---------------------------------------------------------------
84D6                             ; OP_LOADI__1 (B): R[a] = -1
84D6                             ; ---------------------------------------------------------------
84D6                DO_OP_LOADI__1:      
84D6   CD 74 84               CALL   fetch_byte   ; A = a
84D9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84DC   0E FF                  MVI   c,0FFh   ; val_lo = FFh
84DE   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
84E0   CD 0D 84               CALL   set_slot_int16   
84E3   C3 4E 87               JMP   vm_loop   
84E6                             ; ---------------------------------------------------------------
84E6                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
84E6                             ; ---------------------------------------------------------------
84E6                DO_OP_LOADI_0:      
84E6   0E 00                  MVI   c,0   
84E8   C3 0B 85               JMP   loadi_small   
84EB                DO_OP_LOADI_1:      
84EB   0E 01                  MVI   c,1   
84ED   C3 0B 85               JMP   loadi_small   
84F0                DO_OP_LOADI_2:      
84F0   0E 02                  MVI   c,2   
84F2   C3 0B 85               JMP   loadi_small   
84F5                DO_OP_LOADI_3:      
84F5   0E 03                  MVI   c,3   
84F7   C3 0B 85               JMP   loadi_small   
84FA                DO_OP_LOADI_4:      
84FA   0E 04                  MVI   c,4   
84FC   C3 0B 85               JMP   loadi_small   
84FF                DO_OP_LOADI_5:      
84FF   0E 05                  MVI   c,5   
8501   C3 0B 85               JMP   loadi_small   
8504                DO_OP_LOADI_6:      
8504   0E 06                  MVI   c,6   
8506   C3 0B 85               JMP   loadi_small   
8509                DO_OP_LOADI_7:      
8509   0E 07                  MVI   c,7   
850B                LOADI_SMALL:      
850B                             ; C = 即値 (0-7)
850B   CD 74 84               CALL   fetch_byte   ; A = a
850E   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8511   06 00                  MVI   b,0   ; val_hi = 0 (正)
8513   CD 0D 84               CALL   set_slot_int16   
8516   C3 4E 87               JMP   vm_loop   
8519                             ; ---------------------------------------------------------------
8519                             ; OP_LOADI16 (BS): R[a] = signed16(b)
8519                             ; 
8519                             ; b は符号付き 16 ビット (ビッグエンディアン)。
8519                             ; 16 ビットスロットではそのままネイティブサイズ。
8519                             ; 符号拡張は不要。
8519                             ; ---------------------------------------------------------------
8519                DO_OP_LOADI16:      
8519   CD 74 84               CALL   fetch_byte   ; A = a
851C   F5                     PUSH   psw   
851D   CD 8E 84               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
8520   4D                     MOV   c,l   ; C = val_lo
8521   44                     MOV   b,h   ; B = val_hi
8522   F1                     POP   psw   ; A = a
8523   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8526                             ; 型タグと値を書く
8526   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
8528   23                     INX   h   
8529   36 00                  MVI   m,0   ; +1: 予約
852B   23                     INX   h   
852C   71                     MOV   m,c   ; +2: val_lo
852D   23                     INX   h   
852E   70                     MOV   m,b   ; +3: val_hi
852F   C3 4E 87               JMP   vm_loop   
8532                             ; ---------------------------------------------------------------
8532                             ; OP_LOADNIL (B): R[a] = nil
8532                             ; ---------------------------------------------------------------
8532                DO_OP_LOADNIL:      
8532   CD 74 84               CALL   fetch_byte   ; A = a
8535   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8538   3E 01                  MVI   a,TT_NIL   
853A   CD 17 84               CALL   set_slot_special   
853D   C3 4E 87               JMP   vm_loop   
8540                             ; ---------------------------------------------------------------
8540                             ; OP_LOADT (B): R[a] = true
8540                             ; ---------------------------------------------------------------
8540                DO_OP_LOADT:      
8540   CD 74 84               CALL   fetch_byte   ; A = a
8543   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8546   3E 03                  MVI   a,TT_TRUE   
8548   CD 17 84               CALL   set_slot_special   
854B   C3 4E 87               JMP   vm_loop   
854E                             ; ---------------------------------------------------------------
854E                             ; OP_LOADF (B): R[a] = false
854E                             ; ---------------------------------------------------------------
854E                DO_OP_LOADF:      
854E   CD 74 84               CALL   fetch_byte   ; A = a
8551   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8554   3E 02                  MVI   a,TT_FALSE   
8556   CD 17 84               CALL   set_slot_special   
8559   C3 4E 87               JMP   vm_loop   
855C                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
855C                             ; 
855C                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI
855C                             ; ---------------------------------------------------------------
855C                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
855C                             ; 
855C                             ; Phase 2 は整数のみ。型タグの検査は省略し、TT_INTEGER として扱う。
855C                             ; ---------------------------------------------------------------
855C                DO_OP_ADD:      
855C   CD 74 84               CALL   fetch_byte   ; A = a
855F   F5                     PUSH   psw   ; a を退避
8560                             ; R[a+1] のスロットアドレスを求める
8560   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8563   CD 2F 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
8566   EB                     XCHG      ; DE = R[a+1] の値先頭
8567   F1                     POP   psw   ; A = a
8568                             ; R[a] のスロットアドレスを求める
8568   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
856B   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
856E                             ; 16 ビット加算: val[a] += val[a+1]
856E   CD 32 84               CALL   add_value16   
8571   C3 4E 87               JMP   vm_loop   
8574                             ; ---------------------------------------------------------------
8574                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
8574                             ; ---------------------------------------------------------------
8574                DO_OP_SUB:      
8574   CD 74 84               CALL   fetch_byte   ; A = a
8577   F5                     PUSH   psw   
8578   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
857B   CD 2F 84               CALL   slot_to_value   
857E   EB                     XCHG      ; DE = R[a+1] の値先頭
857F   F1                     POP   psw   ; A = a
8580   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8583   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8586   CD 3B 84               CALL   sub_value16   
8589   C3 4E 87               JMP   vm_loop   
858C                             ; ---------------------------------------------------------------
858C                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
858C                             ; 
858C                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
858C                             ; ---------------------------------------------------------------
858C                DO_OP_ADDI:      
858C   CD 74 84               CALL   fetch_byte   ; A = a
858F   F5                     PUSH   psw   
8590   CD 74 84               CALL   fetch_byte   ; A = b (即値)
8593   4F                     MOV   c,a   ; C = b
8594   F1                     POP   psw   ; A = a
8595   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8598   CD 2F 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
859B   7E                     MOV   a,m   ; val_lo
859C   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
859D   77                     MOV   m,a   
859E   23                     INX   h   
859F   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
85A0   CE 00                  ACI   0   ; val_hi + CY
85A2   77                     MOV   m,a   
85A3   C3 4E 87               JMP   vm_loop   
85A6                             ; ---------------------------------------------------------------
85A6                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
85A6                             ; ---------------------------------------------------------------
85A6                DO_OP_SUBI:      
85A6   CD 74 84               CALL   fetch_byte   ; A = a
85A9   F5                     PUSH   psw   
85AA   CD 74 84               CALL   fetch_byte   ; A = b (即値)
85AD   4F                     MOV   c,a   ; C = b
85AE   F1                     POP   psw   ; A = a
85AF   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85B2   CD 2F 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85B5   7E                     MOV   a,m   ; val_lo
85B6   91                     SUB   c   ; val_lo - b (CY = 借り)
85B7   77                     MOV   m,a   
85B8   23                     INX   h   
85B9   7E                     MOV   a,m   ; val_hi
85BA   DE 00                  SBI   0   ; val_hi - CY
85BC   77                     MOV   m,a   
85BD   C3 4E 87               JMP   vm_loop   
85C0                             ; vm_compare.a80 — 比較命令
85C0                             ; 
85C0                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
85C0                             ; 
85C0                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
85C0                             ; Phase 2 は整数のみ。
85C0                             ; 
85C0                             ; cmp_value16 は結果を A で返す:
85C0                             ;   A = 00h → 等しい
85C0                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
85C0                             ;   A = 01h → val1 > val2
85C0                             ; 
85C0                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
85C0                             ; ---------------------------------------------------------------
85C0                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
85C0                             ; 
85C0                             ;   出力: A = 比較結果 (00h/FFh/01h)
85C0                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
85C0                             ;   破壊: A, B, HL, DE
85C0                             ; ---------------------------------------------------------------
85C0                CMP_REG_PAIR:      
85C0   CD 74 84               CALL   fetch_byte   
85C3   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
85C6                             ; R[a+1] の値先頭
85C6   CD 09 84               CALL   get_reg_addr_next   
85C9   CD 2F 84               CALL   slot_to_value   
85CC   EB                     XCHG      ; DE = R[a+1] 値先頭
85CD                             ; R[a] の値先頭
85CD   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
85D0   CD 03 84               CALL   get_reg_addr   
85D3   CD 2F 84               CALL   slot_to_value   ; HL = R[a] 値先頭
85D6   CD 48 84               CALL   cmp_value16   ; A = 結果
85D9   C9                     RET      
85DA                             ; ---------------------------------------------------------------
85DA                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
85DA                             ; 
85DA                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
85DA                             ; ---------------------------------------------------------------
85DA                CMP_SET_TRUE:      
85DA   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
85DD   CD 03 84               CALL   get_reg_addr   
85E0   3E 03                  MVI   a,TT_TRUE   
85E2   CD 17 84               CALL   set_slot_special   
85E5   C3 4E 87               JMP   vm_loop   
85E8                CMP_SET_FALSE:      
85E8   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
85EB   CD 03 84               CALL   get_reg_addr   
85EE   3E 02                  MVI   a,TT_FALSE   
85F0   CD 17 84               CALL   set_slot_special   
85F3   C3 4E 87               JMP   vm_loop   
85F6                             ; ---------------------------------------------------------------
85F6                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
85F6                             ; 
85F6                             ; 型タグと値の両方が一致したときだけ true。
85F6                             ; ---------------------------------------------------------------
85F6                DO_OP_EQ:      
85F6   CD 74 84               CALL   fetch_byte   
85F9   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
85FC                             ; R[a] と R[a+1] のスロットアドレスを求める
85FC   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85FF   E5                     PUSH   h   ; R[a] を退避
8600   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8603   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8606   D1                     POP   d   ; DE = R[a]
8607                             ; HL = R[a+1], DE = R[a]
8607                             ; 型タグを比べる
8607   46                     MOV   b,m   ; B = R[a+1].type
8608   1A                     LDAX   d   ; A = R[a].type
8609   B8                     CMP   b   
860A   C2 E8 85               JNZ   cmp_set_false   ; 型が違えば false
860D                             ; 型が同じ → 値を 2 バイト比べる
860D   23                     INX   h   
860E   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
860F   13                     INX   d   
8610   13                     INX   d   ; DE = R[a] + 2 (値先頭)
8611   1A                     LDAX   d   ; A = R[a].val_lo
8612   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
8613   C2 E8 85               JNZ   cmp_set_false   
8616   23                     INX   h   
8617   13                     INX   d   
8618   1A                     LDAX   d   ; A = R[a].val_hi
8619   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
861A   C2 E8 85               JNZ   cmp_set_false   
861D   C3 DA 85               JMP   cmp_set_true   ; すべて一致
8620                             ; ---------------------------------------------------------------
8620                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
8620                             ; ---------------------------------------------------------------
8620                DO_OP_LT:      
8620   CD C0 85               CALL   cmp_reg_pair   ; A = 結果
8623   B7                     ORA   a   
8624   FA DA 85               JM   cmp_set_true   ; A = FFh → val1 < val2
8627   C3 E8 85               JMP   cmp_set_false   
862A                             ; ---------------------------------------------------------------
862A                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
862A                             ; ---------------------------------------------------------------
862A                DO_OP_LE:      
862A   CD C0 85               CALL   cmp_reg_pair   
862D   B7                     ORA   a   
862E   FA DA 85               JM   cmp_set_true   ; val1 < val2
8631   CA DA 85               JZ   cmp_set_true   ; val1 == val2
8634   C3 E8 85               JMP   cmp_set_false   
8637                             ; ---------------------------------------------------------------
8637                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
8637                             ; ---------------------------------------------------------------
8637                DO_OP_GT:      
8637   CD C0 85               CALL   cmp_reg_pair   
863A   B7                     ORA   a   
863B   CA E8 85               JZ   cmp_set_false   ; val1 == val2
863E   F2 DA 85               JP   cmp_set_true   ; A = 01h → val1 > val2
8641   C3 E8 85               JMP   cmp_set_false   ; A = FFh → val1 < val2
8644                             ; ---------------------------------------------------------------
8644                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
8644                             ; ---------------------------------------------------------------
8644                DO_OP_GE:      
8644   CD C0 85               CALL   cmp_reg_pair   
8647   B7                     ORA   a   
8648   FA E8 85               JM   cmp_set_false   ; val1 < val2
864B   C3 DA 85               JMP   cmp_set_true   ; val1 >= val2
864E                             ; vm_jump.a80 — ジャンプ命令
864E                             ; 
864E                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
864E                             ; 
864E                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
864E                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
864E                             ; ---------------------------------------------------------------
864E                             ; apply_jump — PC に符号付きオフセットを加える
864E                             ; 
864E                             ;   入力: HL = 符号付き 16 ビットオフセット
864E                             ;   出力: なし (PC が更新される)
864E                             ;   破壊: A, HL, DE
864E                             ; ---------------------------------------------------------------
864E                APPLY_JUMP:      
864E   EB                     XCHG      ; DE = オフセット
864F   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
8652   19                     DAD   d   ; HL = PC + オフセット
8653   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8656   C9                     RET      
8657                             ; ---------------------------------------------------------------
8657                             ; OP_JMP (S): PC += signed16(a)
8657                             ; ---------------------------------------------------------------
8657                DO_OP_JMP:      
8657   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
865A   CD 4E 86               CALL   apply_jump   
865D   C3 4E 87               JMP   vm_loop   
8660                             ; ---------------------------------------------------------------
8660                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
8660                             ; 
8660                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
8660                             ; ---------------------------------------------------------------
8660                DO_OP_JMPIF:      
8660   CD 74 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8663   F5                     PUSH   psw   
8664   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
8667   E5                     PUSH   h   ; オフセットを退避
8668   D1                     POP   d   ; DE = オフセット
8669   F1                     POP   psw   ; A = a
866A   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
866D   CD 2D 84               CALL   get_slot_type   ; A = 型タグ
8670   FE 03                  CPI   TT_FALSY_MAX + 1   
8672   DA 7C 86               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
8675                             ; 真 → ジャンプする
8675   EB                     XCHG      ; HL = オフセット (DE にあった)
8676   CD 4E 86               CALL   apply_jump   
8679   C3 4E 87               JMP   vm_loop   
867C                JMPIF_SKIP:      
867C   C3 4E 87               JMP   vm_loop   
867F                             ; ---------------------------------------------------------------
867F                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
867F                             ; ---------------------------------------------------------------
867F                DO_OP_JMPNOT:      
867F   CD 74 84               CALL   fetch_byte   ; A = a
8682   F5                     PUSH   psw   
8683   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
8686   E5                     PUSH   h   
8687   D1                     POP   d   ; DE = オフセット
8688   F1                     POP   psw   ; A = a
8689   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
868C   CD 2D 84               CALL   get_slot_type   ; A = 型タグ
868F   FE 03                  CPI   TT_FALSY_MAX + 1   
8691   D2 9B 86               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
8694                             ; 偽 → ジャンプする
8694   EB                     XCHG      ; HL = オフセット
8695   CD 4E 86               CALL   apply_jump   
8698   C3 4E 87               JMP   vm_loop   
869B                JMPNOT_SKIP:      
869B   C3 4E 87               JMP   vm_loop   
869E                             ; vm_display.a80 — 7 セグメント表示
869E                             ; 
869E                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
869E                             ; 上位 4 桁は "0000" で埋める。
869E                             ; セグメントパターンは seg_table にまとめる。
869E                             ; ---------------------------------------------------------------
869E                             ; display_hex16 — 16 ビット値を 7 セグに表示
869E                             ; 
869E                             ;   入力: HL = 値の先頭 (val_lo の位置)
869E                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
869E                             ;   破壊: A, B, C, HL, DE
869E                             ; 
869E                             ; 8 桁表示: 上位 4 桁は "0" (0x3F), 下位 4 桁が値。
869E                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
869E                             ; ---------------------------------------------------------------
869E                DISPLAY_HEX16:      
869E   E5                     PUSH   h   ; 値のアドレスを退避
869F                             ; 上位 4 桁を "0" で埋める
869F   11 F8 FF               LXI   d,DISPLAY_BASE   
86A2   3E 5C                  MVI   a,5Ch   ; "0" のセグメントパターン (ND8080)
86A4   12                     STAX   d   
86A5   13                     INX   d   
86A6   12                     STAX   d   
86A7   13                     INX   d   
86A8   12                     STAX   d   
86A9   13                     INX   d   
86AA   12                     STAX   d   
86AB   13                     INX   d   ; DE = DISPLAY_BASE + 4
86AC                             ; 値の byte1 (val_hi) から表示
86AC   E1                     POP   h   ; HL = val_lo
86AD   23                     INX   h   ; HL = val_hi
86AE   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
86B0                DISPLAY_BYTE_LOOP:      
86B0                             ; 上位ニブル
86B0   7E                     MOV   a,m   
86B1   0F                     RRC      
86B2   0F                     RRC      
86B3   0F                     RRC      
86B4   0F                     RRC      
86B5   E6 0F                  ANI   0Fh   
86B7   CD CA 86               CALL   nibble_to_seg   
86BA   12                     STAX   d   
86BB   13                     INX   d   
86BC                             ; 下位ニブル
86BC   7E                     MOV   a,m   
86BD   E6 0F                  ANI   0Fh   
86BF   CD CA 86               CALL   nibble_to_seg   
86C2   12                     STAX   d   
86C3   13                     INX   d   
86C4                             ; 次のバイト (val_hi → val_lo)
86C4   2B                     DCX   h   
86C5   0D                     DCR   c   
86C6   C2 B0 86               JNZ   display_byte_loop   
86C9   C9                     RET      
86CA                             ; ---------------------------------------------------------------
86CA                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
86CA                             ; 
86CA                             ;   入力: A = 0-F
86CA                             ;   出力: A = セグメントパターン
86CA                             ;   破壊: なし (HL, BC は内部で退避・復元)
86CA                             ; ---------------------------------------------------------------
86CA                NIBBLE_TO_SEG:      
86CA   E5                     PUSH   h   
86CB   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
86CC   6F                     MOV   l,a   
86CD   26 00                  MVI   h,0   
86CF   01 D7 86               LXI   b,seg_table   
86D2   09                     DAD   b   ; HL = seg_table + nibble
86D3   7E                     MOV   a,m   
86D4   C1                     POP   b   ; BC を復元
86D5   E1                     POP   h   
86D6   C9                     RET      
86D7                             ; ---------------------------------------------------------------
86D7                             ; 7 セグメントパターンテーブル
86D7                             ; 
86D7                             ;   bit 0 = a (上)
86D7                             ;   bit 1 = b (右上)
86D7                             ;   bit 2 = c (右下)
86D7                             ;   bit 3 = d (下)
86D7                             ;   bit 4 = e (左下)
86D7                             ;   bit 5 = f (左上)
86D7                             ;   bit 6 = g (中)
86D7                             ; 
86D7                             ;       aaa
86D7                             ;      f   b
86D7                             ;       ggg
86D7                             ;      e   c
86D7                             ;       ddd
86D7                             ; ---------------------------------------------------------------
86D7                SEG_TABLE:      
86D7   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
86D8   06                     DB   06h   ; 1
86D9   5B                     DB   5Bh   ; 2
86DA   4F                     DB   4Fh   ; 3
86DB   66                     DB   66h   ; 4
86DC   6D                     DB   6Dh   ; 5
86DD   7D                     DB   7Dh   ; 6
86DE   27                     DB   27h   ; 7  (ND8080 ROM パターン)
86DF   7F                     DB   7Fh   ; 8
86E0   6F                     DB   6Fh   ; 9
86E1   77                     DB   77h   ; A
86E2   7C                     DB   7Ch   ; b
86E3   39                     DB   39h   ; C
86E4   5E                     DB   5Eh   ; d
86E5   79                     DB   79h   ; E
86E6   71                     DB   71h   ; F
86E7                             ; ===============================================================
86E7                             ; OP_RETURN (B): トップレベルでは VM 停止
86E7                             ; 
86E7                             ; Phase 1 ではメソッド呼び出しが無いため、常にトップレベル。
86E7                             ; R[a] の値を 7 セグに表示して停止する。
86E7                             ; ===============================================================
86E7                DO_OP_RETURN:      
86E7   CD 74 84               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
86EA   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
86ED   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
86F0   CD 9E 86               CALL   display_hex16   
86F3   3E 02                  MVI   a,VM_FINISHED   
86F5   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
86F8   C3 1C 87               JMP   vm_halt   
86FB                             ; ===============================================================
86FB                             ; OP_STOP (Z): VM 停止
86FB                             ; ===============================================================
86FB                DO_OP_STOP:      
86FB   3E 02                  MVI   a,VM_FINISHED   
86FD   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8700                             ; R[1] の値を 7 セグに表示
8700   3E 01                  MVI   a,1   
8702   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8705   CD 2F 84               CALL   slot_to_value   ; HL = R[1] の値先頭
8708   CD 9E 86               CALL   display_hex16   
870B   C3 1C 87               JMP   vm_halt   
870E                             ; ===============================================================
870E                             ; エラー停止
870E                             ; 
870E                             ; 未対応のオペコードを踏んだとき。
870E                             ; 現在のオペコードをエラーコードとして保存する。
870E                             ; ===============================================================
870E                VM_ERROR:      
870E   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8711   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
8714   3E 03                  MVI   a,VM_ERROR   
8716   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8719   C3 1C 87               JMP   vm_halt   
871C                             ; ===============================================================
871C                             ; 停止 — ND80Z モニタのリモートモードへ復帰
871C                             ; 
871C                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
871C                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
871C                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
871C                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
871C                             ; これにより自動的にリモートモードへ復帰する。
871C                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
871C                             ; ===============================================================
871C                VM_HALT:      
871C   31 B8 FF               LXI   sp,0FFB8h   ; MONSP: モニタのスタックポインタを復元
871F   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
8722                             ; ===============================================================
8722                             ; 初期化
8722                             ; ===============================================================
8722                VM_START:      
8722                             ; スタックポインタを設定
8722   31 00 FE               LXI   sp,STACK_TOP + 1   
8725                             ; VM 状態領域をゼロクリア (256 バイト)
8725   21 00 80               LXI   h,VM_STATE_BASE   
8728   0E 00                  MVI   c,0   ; 256 回 (0 は 256 として扱う)
872A                VM_CLEAR_STATE:      
872A   36 00                  MVI   m,0   
872C   23                     INX   h   
872D   0D                     DCR   c   
872E   C2 2A 87               JNZ   vm_clear_state   
8731                             ; レジスタファイルをゼロクリア (256 バイト)
8731   21 00 81               LXI   h,REG_FILE_BASE   
8734   0E 00                  MVI   c,0   
8736                VM_CLEAR_REGS:      
8736   36 00                  MVI   m,0   
8738   23                     INX   h   
8739   0D                     DCR   c   
873A   C2 36 87               JNZ   vm_clear_regs   
873D                             ; IREP 0 のバイトコード長を VM 状態に設定
873D                             ; IREP テーブルの先頭エントリから読む
873D   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
8740   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
8743   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
8746   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
8749                             ; PC = 0 (ゼロクリア済み)
8749                             ; 実行状態を RUNNING に設定
8749   3E 01                  MVI   a,VM_RUNNING   
874B   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
874E                             ; メインループへ
874E                             ; fall through
874E                             ; ===============================================================
874E                             ; メインループ (fetch-decode-execute)
874E                             ; ===============================================================
874E                VM_LOOP:      
874E                             ; --- 実行状態の確認 ---
874E   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
8751   FE 01                  CPI   VM_RUNNING   
8753   C2 1C 87               JNZ   vm_halt   
8756                             ; --- PC がバイトコード長を超えていないか ---
8756   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
8759   EB                     XCHG      ; DE = PC
875A   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
875D                             ; HL = bytecode_len, DE = PC
875D                             ; PC >= bytecode_len ならエラー
875D   7B                     MOV   a,e   
875E   95                     SUB   l   
875F   7A                     MOV   a,d   
8760   9C                     SBB   h   ; DE - HL (PC - len)
8761   D2 03 00               JNC   vm_error   ; PC >= len → エラー
8764                             ; --- オペコードフェッチ ---
8764   CD 74 84               CALL   fetch_byte   ; A = opcode
8767   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
876A                             ; --- ステップカウント ---
876A   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
876D   23                     INX   h   
876E   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
8771                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
8771   7C                     MOV   a,h   
8772   B5                     ORA   l   
8773   C2 7D 87               JNZ   vm_dispatch   
8776   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
8779   23                     INX   h   
877A   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
877D                             ; --- ディスパッチ ---
877D                VM_DISPATCH:      
877D   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8780                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
8780   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
8781   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
8784   5F                     MOV   e,a   
8785   16 00                  MVI   d,0   ; DE = opcode * 2
8787   21 9F 87               LXI   h,dispatch_table   
878A   19                     DAD   d   ; HL = &dispatch_table[opcode]
878B                             ; テーブル上限チェック
878B   11 73 88               LXI   d,dispatch_table_end   
878E   7B                     MOV   a,e   
878F   95                     SUB   l   
8790   7A                     MOV   a,d   
8791   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
8792   DA 03 00               JC   vm_error   ; テーブル範囲外
8795                             ; アドレスを読んでジャンプ
8795   5E                     MOV   e,m   ; E = 下位バイト
8796   23                     INX   h   
8797   56                     MOV   d,m   ; D = 上位バイト
8798   EB                     XCHG      ; HL = ハンドラアドレス
8799                             ; 0000h ならエラー (未実装マーカー)
8799   7C                     MOV   a,h   
879A   B5                     ORA   l   
879B   CA 03 00               JZ   vm_error   
879E   E9                     PCHL      ; ハンドラへジャンプ
879F                             ; ===============================================================
879F                             ; ディスパッチテーブル
879F                             ; 
879F                             ; オペコード番号順に 2 バイトのアドレスを並べる。
879F                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
879F                             ; ===============================================================
879F                DISPATCH_TABLE:      
879F   91 84                  DW   do_op_nop   ; 00 OP_NOP
87A1   94 84                  DW   do_op_move   ; 01 OP_MOVE
