0000                             ; vm_main.a80 — faRuby i8080 VM
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (拡張 RAM 搭載: 0x0000-0xFFFF) を想定。
0000                             ; 
0000                             ; 0x8400: 起動スタブ (SP 設定 + バンク切り替え + JMP vm_start)
0000                             ; 0x1000: VM 本体コード (拡張 RAM 領域)
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行する。
0000                             ; hex ロードは拡張 RAM モード (ポート 9C bit3=1) のまま行われるため、
0000                             ; 0x1000-0x7FFF のデータは直接拡張 RAM に書き込まれる。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; 
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; 
0000                             ; --- メモリマップ ---
0000                             ; 
0000                VM_CODE_ORG:   EQU   1000h   
0000                VM_ENTRY_POINT:   EQU   8400h   ; 起動スタブ (通常 RAM)
0000                BYTECODE_BASE:   EQU   5000h   
0000                BYTECODE_SIZE:   EQU   2000h   
0000                POOL_BASE:   EQU   7000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                INIT_METHOD_ID_STORE:   EQU   82FEh   ; initialize の method_id 格納アドレス
0000                IDENTITY_IREP_STORE:   EQU   82FFh   ; 恒等ブロックの irep 番号 (0 = 無し)
0000                             ; 
0000                             ; --- バリュースロット ---
0000                             ; 
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; 
0000                             ; --- VM 状態領域のオフセット ---
0000                             ; 
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                OFF_OBJ_SP:   EQU   1Bh   ; 1B  次の空きオブジェクトスロット
0000                OFF_INIT_METHOD_ID:   EQU   1Ch   ; 1B  initialize のメソッド ID
0000                OFF_POOL_BASE:   EQU   1Dh   ; 2B  現在の IREP の定数プール先頭
0000                OFF_COL_SP:   EQU   1Fh   ; 1B  次の空きコレクションスロット
0000                             ; 
0000                             ; --- IREP テーブルエントリ ---
0000                             ; 
0000                IREP_ENTRY_BYTES:   EQU   0Ah   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_SUBTREE_SIZE:   EQU   07h   ; 1B  DFS 前順サブツリーサイズ
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; 
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                             ; 
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_STRING:   EQU   07h   
0000                TT_ARRAY:   EQU   08h   
0000                TT_HASH:   EQU   09h   
0000                TT_OBJECT:   EQU   0Ah   
0000                TT_PROC:   EQU   0Ch   
0000                TT_CLASS:   EQU   0Dh   
0000                TT_BUILTIN_CLASS:   EQU   0Eh   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; 
0000                             ; --- VM 実行状態 ---
0000                             ; 
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; 
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                             ; 
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   9000h   
0000                MAX_GLOBALS:   EQU   40h   ; グローバル変数の数
0000                             ; 
0000                             ; シンボル種別コード (上位バイト)
0000                SYM_KIND_USER_METHOD:   EQU   01h   ; ユーザー定義メソッド
0000                SYM_KIND_CLASS:   EQU   02h   ; クラス名
0000                SYM_KIND_IVAR:   EQU   03h   ; インスタンス変数
0000                SYM_KIND_BUILTIN_CLASS:   EQU   04h   ; Array / Hash
0000                BUILTIN_CLASS_ARRAY:   EQU   01h   ; Array.new
0000                BUILTIN_CLASS_HASH:   EQU   02h   ; Hash.new
0000                             ; 
0000                             ; --- フレームスタック ---
0000                             ; 
0000                FRAME_STACK_BASE:   EQU   9100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   10h   
0000                             ; 
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; 
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_EACH:   EQU   02h   ; each (配列要素反復)
0000                FRAME_KIND_HASH_EACH:   EQU   03h   ; each (ハッシュの鍵と値)
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                FRAME_KIND_NEW:   EQU   05h   ; Class#new → initialize
0000                FRAME_KIND_ANY:   EQU   06h   ; any?
0000                FRAME_KIND_ALL:   EQU   07h   ; all?
0000                FRAME_KIND_NONE:   EQU   08h   ; none?
0000                FRAME_KIND_ARRAY_FILL:   EQU   09h   ; Array.new(n) 00bbIA==
0000                             ; 
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; 
0000                             ; --- メソッド表 ---
0000                             ; 
0000                METHOD_TABLE_BASE:   EQU   91C0h   
0000                MAX_CLASSES:   EQU   08h   
0000                MAX_METHODS_PER_CLASS:   EQU   20h   
0000                METHOD_TABLE_SIZE:   EQU   0100h   
0000                CLASS_MAIN:   EQU   00h   
0000                METHOD_NEW:   EQU   1Ch   ; Class#new
0000                METHOD_DISPLAY:   EQU   1Dh   ; display(value)
0000                METHOD_GETKEY:   EQU   1Eh   ; getkey
0000                METHOD_PUTS:   EQU   1Fh   ; puts(value): ASCII 2 文字表示
0000                METHOD_SETSEG:   EQU   20h   ; setseg(pos, pattern)
0000                METHOD_RAND:   EQU   21h   ; rand(n)
0000                METHOD_SLICE:   EQU   22h   ; [](offset, length) 文字列スライス
0000                METHOD_LENGTH:   EQU   12h   ; length / size
0000                METHOD_CONCAT:   EQU   14h   ; << (文字列追記/配列追加)
0000                METHOD_EACH:   EQU   15h   ; each (配列要素反復)
0000                METHOD_PUSH:   EQU   16h   ; push (配列追加)
0000                METHOD_ANY_P:   EQU   23h   ; any?
0000                METHOD_ALL_P:   EQU   24h   ; all?
0000                METHOD_NONE_P:   EQU   25h   ; none?
0000                KEYIN1_ADDR:   EQU   0616h   ; ND80Z モニタキー入力 (ブロッキング)
0000                KEY_ADDR:   EQU   0647h   ; ND80Z キー 1 回スキャン (ノンブロッキング)
0000                             ; 
0000                             ; バンク切り替え (ND8080 拡張 RAM)
0000                PORT_9C:   EQU   9Ch   ; I/O ポート 9C
0000                PORT_9C_BANK_BIT:   EQU   08h   ; bit3: ROM/RAM 切替
0000                CLONE_BUF:   EQU   0EF00h   ; ROM クローン用バッファ
0000                             ; 
0000                             ; --- オブジェクトプール ---
0000                             ; 
0000                OBJECT_POOL_BASE:   EQU   92C0h   
0000                MAX_OBJECTS:   EQU   20h   
0000                OBJECT_SLOT_SIZE:   EQU   20h   ; 32B/スロット
0000                OBJECT_HEADER_SIZE:   EQU   04h   
0000                MAX_IVARS:   EQU   07h   
0000                             ; 
0000                             ; --- コレクションプール (文字列・配列) ---
0000                             ; 
0000                COLLECTION_POOL_BASE:   EQU   96C0h   
0000                MAX_COL_SLOTS:   EQU   40h   
0000                COL_SLOT_SIZE:   EQU   24h   ; 36B/スロット
0000                COL_HEADER_SIZE:   EQU   02h   ; +0: type, +1: count
0000                COL_DATA_SIZE:   EQU   22h   ; データ領域 (34B)
0000                COL_MAX_STRING_LEN:   EQU   22h   
0000                COL_MAX_ARRAY_ELEMS:   EQU   08h   
0000                COL_TYPE_FREE:   EQU   00h   
0000                COL_TYPE_STRING:   EQU   01h   
0000                COL_TYPE_ARRAY:   EQU   02h   
0000                COL_TYPE_HASH:   EQU   03h   
0000                HASH_PAIR_BYTES:   EQU   08h   ; 8B/ペア (key+value)
0000                COL_MAX_HASH_PAIRS:   EQU   04h   ; 最大4ペア
0000                             ; 
0000                             ; --- Phase 1 オペコード ---
0000                             ; 
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; 
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                             ; 
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
0000                             ; 
0000                             ; 
0000                             ; ===============================================================
0000                             ; 起動スタブ (通常 RAM 0x8400)
0000                             ; 
0000                             ; 1. SP 設定
0000                             ; 2. 拡張 RAM バンク切り替え (OUT PORT_9C, F8h)
0000                             ; 3. vm_start へジャンプ
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行済み。
0000                             ; hex ロードは拡張 RAM モードのまま行われるため、
0000                             ; VM コード・バイトコード・プールは直接拡張 RAM に書き込まれる。
0000                             ; ===============================================================
8400                          .ORG   08400h   
8400                             ; 
8400                STARTUP_STUB:      
8400   31 00 FE               LXI   sp,STACK_TOP + 1   
8403   3E F8                  MVI   a,0F8h   
8405   D3 9C                  OUT   PORT_9C   
8407   C3 AB 1E               JMP   vm_start   
840A                             ; 
840A                             ; ===============================================================
840A                             ; VM 本体コード (拡張 RAM 0x1000-)
840A                             ; ===============================================================
1000                          .ORG   01000h   
1000                             ; 
1000                             ; ===============================================================
1000                             ; サブルーチン群 (.include で取り込む)
1000                             ; ===============================================================
1000                             ; vm_util.a80 — ユーティリティサブルーチン
1000                             ; 
1000                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
1000                             ; 他のすべてのモジュールがここに依存します。
1000                             ; 
1000                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
1000                             ;   +0: 型タグ (1B)
1000                             ;   +1: 予約   (1B, 常に 0)
1000                             ;   +2: val_lo (1B)
1000                             ;   +3: val_hi (1B)
1000                             ; 
1000                             ; ---------------------------------------------------------------
1000                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
1000                             ; 
1000                             ;   入力: A = レジスタ番号 (0-63)
1000                             ;   出力: HL = スロット先頭アドレス
1000                             ;   破壊: A
1000                             ; 
1000                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
1000                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
1000                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
1000                             ; ---------------------------------------------------------------
1000                GET_REG_ADDR:      
1000   87                     ADD   a   ; ×2
1001   87                     ADD   a   ; ×4 (オフセット、A に残る)
1002   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
1005   85                     ADD   l   ; A = base_lo + offset
1006   6F                     MOV   l,a   
1007   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
1009   8C                     ADC   h   ; A = base_hi + CY
100A   67                     MOV   h,a   
100B   C9                     RET      
100C                             ; 
100C                             ; ---------------------------------------------------------------
100C                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
100C                             ; 
100C                             ;   入力: A = レジスタ番号 a
100C                             ;   出力: HL = R[a+1] のスロット先頭アドレス
100C                             ;   破壊: A
100C                             ; ---------------------------------------------------------------
100C                GET_REG_ADDR_NEXT:      
100C   3C                     INR   a   
100D   C3 00 10               JMP   get_reg_addr   
1010                             ; 
1010                             ; ---------------------------------------------------------------
1010                             ; set_slot_int16 — スロットに 16 ビット整数を書く
1010                             ; 
1010                             ;   入力: HL = スロット先頭アドレス
1010                             ;          B  = val_hi (上位バイト)
1010                             ;          C  = val_lo (下位バイト)
1010                             ;   出力: なし
1010                             ;   破壊: HL
1010                             ; ---------------------------------------------------------------
1010                SET_SLOT_INT16:      
1010   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1012   23                     INX   h   
1013   36 00                  MVI   m,0   ; +1: 予約
1015   23                     INX   h   
1016   71                     MOV   m,c   ; +2: val_lo
1017   23                     INX   h   
1018   70                     MOV   m,b   ; +3: val_hi
1019   C9                     RET      
101A                             ; 
101A                             ; ---------------------------------------------------------------
101A                             ; set_slot_special — 値を持たない型をスロットに書く
101A                             ; 
101A                             ;   入力: HL = スロット先頭アドレス
101A                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
101A                             ;   出力: なし
101A                             ;   破壊: A, HL
101A                             ; ---------------------------------------------------------------
101A                SET_SLOT_SPECIAL:      
101A   77                     MOV   m,a   ; +0: 型タグ
101B   23                     INX   h   
101C   36 00                  MVI   m,0   ; +1: 予約
101E   23                     INX   h   
101F   36 00                  MVI   m,0   ; +2: val_lo = 0
1021   23                     INX   h   
1022   36 00                  MVI   m,0   ; +3: val_hi = 0
1024   C9                     RET      
1025                             ; 
1025                             ; ---------------------------------------------------------------
1025                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
1025                             ; 
1025                             ;   入力: HL = コピー元先頭
1025                             ;         DE = コピー先先頭
1025                             ;   出力: なし
1025                             ;   破壊: A, C, HL, DE
1025                             ; ---------------------------------------------------------------
1025                COPY_SLOT:      
1025   0E 04                  MVI   c,SLOT_BYTES   
1027                COPY_SLOT_LOOP:      
1027   7E                     MOV   a,m   
1028   12                     STAX   d   
1029   23                     INX   h   
102A   13                     INX   d   
102B   0D                     DCR   c   
102C   C2 27 10               JNZ   copy_slot_loop   
102F   C9                     RET      
1030                             ; 
1030                             ; ---------------------------------------------------------------
1030                             ; get_slot_type — スロットの型タグを読む
1030                             ; 
1030                             ;   入力: HL = スロット先頭アドレス
1030                             ;   出力: A = 型タグ
1030                             ;   破壊: なし (HL 保存)
1030                             ; ---------------------------------------------------------------
1030                GET_SLOT_TYPE:      
1030   7E                     MOV   a,m   
1031   C9                     RET      
1032                             ; 
1032                             ; ---------------------------------------------------------------
1032                             ; slot_to_value — スロット先頭から値の先頭へ進める
1032                             ; 
1032                             ;   入力: HL = スロット先頭アドレス
1032                             ;   出力: HL = 値の先頭 (スロット +2)
1032                             ;   破壊: なし
1032                             ; ---------------------------------------------------------------
1032                SLOT_TO_VALUE:      
1032   23                     INX   h   
1033   23                     INX   h   
1034   C9                     RET      
1035                             ; 
1035                             ; ---------------------------------------------------------------
1035                             ; add_value16 — 16 ビット加算 (val1 += val2)
1035                             ; 
1035                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
1035                             ;         DE = 値 2 の先頭
1035                             ;   出力: 結果を HL の元の位置に上書き
1035                             ;   破壊: A, HL, DE
1035                             ; 
1035                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
1035                             ; ---------------------------------------------------------------
1035                ADD_VALUE16:      
1035   1A                     LDAX   d   ; A = val2[lo]
1036   86                     ADD   m   ; A += val1[lo]
1037   77                     MOV   m,a   ; val1[lo] = result
1038   23                     INX   h   
1039   13                     INX   d   
103A   1A                     LDAX   d   ; A = val2[hi]
103B   8E                     ADC   m   ; A += val1[hi] + CY
103C   77                     MOV   m,a   
103D   C9                     RET      
103E                             ; 
103E                             ; ---------------------------------------------------------------
103E                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
103E                             ; 
103E                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
103E                             ;         DE = 値 2 の先頭
103E                             ;   出力: 結果を HL の元の位置に上書き
103E                             ;   破壊: A, HL, DE
103E                             ; 
103E                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
103E                             ; ---------------------------------------------------------------
103E                SUB_VALUE16:      
103E   7E                     MOV   a,m   ; A = val1[lo]
103F   EB                     XCHG      ; HL=val2, DE=val1
1040   96                     SUB   m   ; A -= val2[lo]
1041   EB                     XCHG      ; HL=val1, DE=val2
1042   77                     MOV   m,a   ; val1[lo] = result
1043   23                     INX   h   
1044   13                     INX   d   
1045   7E                     MOV   a,m   ; A = val1[hi]
1046   EB                     XCHG      
1047   9E                     SBB   m   ; A -= val2[hi] - CY
1048   EB                     XCHG      
1049   77                     MOV   m,a   
104A   C9                     RET      
104B                             ; 
104B                             ; ---------------------------------------------------------------
104B                             ; cmp_value16 — 16 ビット符号付き比較
104B                             ; 
104B                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
104B                             ;         DE = 値 2 の先頭 (byte0 の位置)
104B                             ;   出力: A = 比較結果
104B                             ;           00h → val1 == val2
104B                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
104B                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
104B                             ;   破壊: A, B, HL, DE
104B                             ; 
104B                             ; 手順:
104B                             ;   1. 上位バイト (byte1) の符号ビットを比べる
104B                             ;   2. 符号が違えば、負の方が小さい
104B                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
104B                             ; ---------------------------------------------------------------
104B                CMP_VALUE16:      
104B                             ; byte1 (上位) の位置を求める
104B   23                     INX   h   ; HL = val1+1 (hi)
104C   13                     INX   d   ; DE = val2+1 (hi)
104D                             ; 符号ビットを比べる
104D   7E                     MOV   a,m   ; A = val1[hi]
104E   47                     MOV   b,a   ; B = val1[hi] (退避)
104F   1A                     LDAX   d   ; A = val2[hi]
1050   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
1051   F2 5D 10               JP   cmp16_same_sign   
1054                             ; 符号が違う: val1 が負なら val1 < val2
1054   78                     MOV   a,b   ; A = val1[hi]
1055   E6 80                  ANI   80h   ; bit7 を取り出す
1057   C2 71 10               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
105A   C3 74 10               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
105D                CMP16_SAME_SIGN:      
105D                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
105D   1A                     LDAX   d   
105E   BE                     CMP   m   ; val2[hi] - val1[hi]
105F   DA 74 10               JC   cmp16_ret_pos   
1062   C2 71 10               JNZ   cmp16_ret_neg   
1065   2B                     DCX   h   
1066   1B                     DCX   d   
1067   1A                     LDAX   d   
1068   BE                     CMP   m   ; val2[lo] - val1[lo]
1069   DA 74 10               JC   cmp16_ret_pos   
106C   C2 71 10               JNZ   cmp16_ret_neg   
106F                             ; すべて等しい
106F   AF                     XRA   a   ; A = 00h
1070   C9                     RET      
1071                CMP16_RET_NEG:      
1071   3E FF                  MVI   a,0FFh   ; val1 < val2
1073   C9                     RET      
1074                CMP16_RET_POS:      
1074   3E 01                  MVI   a,01h   ; val1 > val2
1076   C9                     RET      
1077                             ; 
1077                             ; ---------------------------------------------------------------
1077                             ; calc_child_irep — 子 irep 番号を算出
1077                             ; 
1077                             ;   入力: A = 子インデックス (オペランド b)
1077                             ;   出力: A = irep 番号
1077                             ;   破壊: B, C, DE, HL
1077                             ; 
1077                             ; pos = cur_irep + 1 から開始し、b 個のサブツリーを
1077                             ; subtree_size で飛ばして目的の子 irep 番号を求める。
1077                             ; OP_BLOCK, OP_METHOD, OP_EXEC の共通サブルーチン。
1077                             ; レジスタのみ使用 (メモリ変数なし): B=残りカウント, C=pos。
1077                             ; ---------------------------------------------------------------
1077                CALC_CHILD_IREP:      
1077   47                     MOV   b,a   ; B = スキップ回数
1078   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
107B   3C                     INR   a   ; A = cur_irep + 1
107C   4F                     MOV   c,a   ; C = pos
107D   78                     MOV   a,b   
107E   B7                     ORA   a   
107F   CA 99 10               JZ   cci_done   ; b == 0 → C をそのまま返す
1082                             ; 
1082                CCI_LOOP:      
1082                             ; HL = IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE + pos * 10
1082   79                     MOV   a,c   ; A = pos
1083   57                     MOV   d,a   ; D = pos (退避)
1084   87                     ADD   a   ; ×2
1085   5F                     MOV   e,a   ; E = ×2
1086   7A                     MOV   a,d   
1087   87                     ADD   a   ; ×2
1088   87                     ADD   a   ; ×4
1089   87                     ADD   a   ; ×8
108A   83                     ADD   e   ; ×10
108B   5F                     MOV   e,a   
108C   16 00                  MVI   d,0   
108E   21 07 82               LXI   h,IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE   
1091   19                     DAD   d   ; HL = &subtree_size[pos]
1092                             ; 
1092                             ; pos += subtree_size
1092   79                     MOV   a,c   
1093   86                     ADD   m   ; A = pos + subtree_size
1094   4F                     MOV   c,a   ; C = 新しい pos
1095                             ; 
1095   05                     DCR   b   
1096   C2 82 10               JNZ   cci_loop   
1099                             ; 
1099                CCI_DONE:      
1099   79                     MOV   a,c   ; A = 最終的な pos
109A   C9                     RET      
109B                             ; 
109B                             ; ---------------------------------------------------------------
109B                             ; class_of_reg — レジスタスロットからクラス番号を求める
109B                             ; 
109B                             ;   入力: HL = スロットアドレス
109B                             ;   出力: A = class_number
109B                             ;   破壊: B, DE, HL
109B                             ; 
109B                             ; - TT_CLASS  → val_lo (クラス自身の番号)
109B                             ; - TT_OBJECT, val_lo=0 → 0 (main)
109B                             ; - TT_OBJECT, val_lo>0 → OBJECT_POOL_BASE + (val-1)*32 のヘッダから読む
109B                             ; - その他 → 0 (main)
109B                             ; ---------------------------------------------------------------
109B                CLASS_OF_REG:      
109B   7E                     MOV   a,m   ; A = 型タグ
109C   FE 0D                  CPI   TT_CLASS   
109E   CA A8 10               JZ   cor_class   
10A1   FE 0A                  CPI   TT_OBJECT   
10A3   CA AC 10               JZ   cor_object   
10A6                             ; その他 → main (class 0)
10A6   AF                     XRA   a   
10A7   C9                     RET      
10A8                COR_CLASS:      
10A8                             ; val_lo = class_number
10A8   23                     INX   h   
10A9   23                     INX   h   
10AA   7E                     MOV   a,m   ; A = val_lo = class_number
10AB   C9                     RET      
10AC                COR_OBJECT:      
10AC                             ; val_lo = slot+1 (0=main)
10AC   23                     INX   h   
10AD   23                     INX   h   
10AE   7E                     MOV   a,m   ; A = val_lo
10AF   B7                     ORA   a   
10B0   C8                     RZ      ; val_lo==0 → main (A=0)
10B1                             ; slot = val_lo - 1, ヘッダアドレス = OBJECT_POOL_BASE + slot * 32
10B1   3D                     DCR   a   ; A = slot
10B2                             ; × 32 = 5 回の add a
10B2   87                     ADD   a   ; ×2
10B3   87                     ADD   a   ; ×4
10B4   87                     ADD   a   ; ×8
10B5   87                     ADD   a   ; ×16
10B6   87                     ADD   a   ; ×32
10B7   5F                     MOV   e,a   
10B8   16 00                  MVI   d,0   
10BA   21 C0 92               LXI   h,OBJECT_POOL_BASE   
10BD   19                     DAD   d   ; HL = スロット先頭
10BE   7E                     MOV   a,m   ; A = class_number (ヘッダ +0)
10BF   C9                     RET      
10C0                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
10C0                             ; 
10C0                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
10C0                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
10C0                             ; 
10C0                             ; ---------------------------------------------------------------
10C0                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
10C0                             ; 
10C0                             ;   入力: なし
10C0                             ;   出力: A = 読んだバイト
10C0                             ;   破壊: HL, DE
10C0                             ; 
10C0                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
10C0                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
10C0                             ; 子 irep の先頭に変わります。
10C0                             ; ---------------------------------------------------------------
10C0                FETCH_BYTE:      
10C0   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
10C3   EB                     XCHG      ; DE = PC
10C4   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
10C7   19                     DAD   d   ; HL = 絶対アドレス
10C8   7E                     MOV   a,m   ; A = bytecode[PC]
10C9                             ; PC をインクリメント
10C9   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
10CC   23                     INX   h   
10CD   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
10D0   C9                     RET      
10D1                             ; 
10D1                             ; ---------------------------------------------------------------
10D1                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
10D1                             ; 
10D1                             ;   入力: なし
10D1                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
10D1                             ;   破壊: A, B, DE
10D1                             ; 
10D1                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
10D1                             ; 1 バイト目が上位、2 バイト目が下位。
10D1                             ; ---------------------------------------------------------------
10D1                FETCH_U16BE:      
10D1   CD C0 10               CALL   fetch_byte   ; A = 上位バイト
10D4   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
10D5   CD C0 10               CALL   fetch_byte   ; A = 下位バイト
10D8   6F                     MOV   l,a   
10D9   60                     MOV   h,b   
10DA   C9                     RET      
10DB                             ; 
10DB                             ; ---------------------------------------------------------------
10DB                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
10DB                             ; 
10DB                             ;   入力: なし
10DB                             ;   出力: HL = 読んだ符号付き 16 ビット値
10DB                             ;   破壊: A, DE
10DB                             ; 
10DB                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
10DB                             ; ---------------------------------------------------------------
10DB                FETCH_S16BE:      
10DB   C3 D1 10               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
10DE                             ; vm_load.a80 — ロード命令
10DE                             ; 
10DE                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
10DE                             ; 
10DE                             ; Phase 2: 16 ビットスロット (4 バイト)
10DE                             ;   set_slot_int16: B=val_hi, C=val_lo
10DE                             ; 
10DE                             ; ---------------------------------------------------------------
10DE                             ; OP_NOP (Z): 何もしない
10DE                             ; ---------------------------------------------------------------
10DE                DO_OP_NOP:      
10DE   C3 78 1D               JMP   vm_loop   
10E1                             ; 
10E1                             ; ---------------------------------------------------------------
10E1                             ; OP_MOVE (BB): R[a] = R[b]
10E1                             ; ---------------------------------------------------------------
10E1                DO_OP_MOVE:      
10E1   CD C0 10               CALL   fetch_byte   ; A = a (コピー先)
10E4   F5                     PUSH   psw   
10E5   CD C0 10               CALL   fetch_byte   ; A = b (コピー元)
10E8   CD 00 10               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
10EB   EB                     XCHG      ; DE = R[b]
10EC   F1                     POP   psw   ; A = a
10ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
10F0   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
10F1   CD 25 10               CALL   copy_slot   
10F4   C3 78 1D               JMP   vm_loop   
10F7                             ; 
10F7                             ; ---------------------------------------------------------------
10F7                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
10F7                             ; ---------------------------------------------------------------
10F7                DO_OP_LOADI:      
10F7   CD C0 10               CALL   fetch_byte   ; A = a
10FA   F5                     PUSH   psw   
10FB   CD C0 10               CALL   fetch_byte   ; A = b (値)
10FE   4F                     MOV   c,a   ; C = val_lo
10FF   F1                     POP   psw   ; A = a
1100   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1103   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
1104   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
1106   CD 10 10               CALL   set_slot_int16   
1109   C3 78 1D               JMP   vm_loop   
110C                             ; 
110C                             ; ---------------------------------------------------------------
110C                             ; OP_LOADINEG (BB): R[a] = -b
110C                             ; ---------------------------------------------------------------
110C                DO_OP_LOADINEG:      
110C   CD C0 10               CALL   fetch_byte   ; A = a
110F   F5                     PUSH   psw   
1110   CD C0 10               CALL   fetch_byte   ; A = b
1113                             ; -b を計算 (0 - b)
1113   4F                     MOV   c,a   ; C = b (退避)
1114   AF                     XRA   a   ; A = 0
1115   91                     SUB   c   ; A = -b
1116   4F                     MOV   c,a   ; C = val_lo (-b)
1117   F1                     POP   psw   ; A = a
1118   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
111B   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
111D   CD 10 10               CALL   set_slot_int16   
1120   C3 78 1D               JMP   vm_loop   
1123                             ; 
1123                             ; ---------------------------------------------------------------
1123                             ; OP_LOADI__1 (B): R[a] = -1
1123                             ; ---------------------------------------------------------------
1123                DO_OP_LOADI__1:      
1123   CD C0 10               CALL   fetch_byte   ; A = a
1126   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1129   0E FF                  MVI   c,0FFh   ; val_lo = FFh
112B   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
112D   CD 10 10               CALL   set_slot_int16   
1130   C3 78 1D               JMP   vm_loop   
1133                             ; 
1133                             ; ---------------------------------------------------------------
1133                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
1133                             ; ---------------------------------------------------------------
1133                DO_OP_LOADI_0:      
1133   0E 00                  MVI   c,0   
1135   C3 58 11               JMP   loadi_small   
1138                DO_OP_LOADI_1:      
1138   0E 01                  MVI   c,1   
113A   C3 58 11               JMP   loadi_small   
113D                DO_OP_LOADI_2:      
113D   0E 02                  MVI   c,2   
113F   C3 58 11               JMP   loadi_small   
1142                DO_OP_LOADI_3:      
1142   0E 03                  MVI   c,3   
1144   C3 58 11               JMP   loadi_small   
1147                DO_OP_LOADI_4:      
1147   0E 04                  MVI   c,4   
1149   C3 58 11               JMP   loadi_small   
114C                DO_OP_LOADI_5:      
114C   0E 05                  MVI   c,5   
114E   C3 58 11               JMP   loadi_small   
1151                DO_OP_LOADI_6:      
1151   0E 06                  MVI   c,6   
1153   C3 58 11               JMP   loadi_small   
1156                DO_OP_LOADI_7:      
1156   0E 07                  MVI   c,7   
1158                LOADI_SMALL:      
1158                             ; C = 即値 (0-7)
1158   CD C0 10               CALL   fetch_byte   ; A = a
115B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
115E   06 00                  MVI   b,0   ; val_hi = 0 (正)
1160   CD 10 10               CALL   set_slot_int16   
1163   C3 78 1D               JMP   vm_loop   
1166                             ; 
1166                             ; ---------------------------------------------------------------
1166                             ; OP_LOADI16 (BS): R[a] = signed16(b)
1166                             ; 
1166                             ; b は符号付き 16 ビット (ビッグエンディアン)。
1166                             ; 16 ビットスロットではそのままネイティブサイズ。
1166                             ; 符号拡張は不要。
1166                             ; ---------------------------------------------------------------
1166                DO_OP_LOADI16:      
1166   CD C0 10               CALL   fetch_byte   ; A = a
1169   F5                     PUSH   psw   
116A   CD DB 10               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
116D   4D                     MOV   c,l   ; C = val_lo
116E   44                     MOV   b,h   ; B = val_hi
116F   F1                     POP   psw   ; A = a
1170   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1173                             ; 型タグと値を書く
1173   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1175   23                     INX   h   
1176   36 00                  MVI   m,0   ; +1: 予約
1178   23                     INX   h   
1179   71                     MOV   m,c   ; +2: val_lo
117A   23                     INX   h   
117B   70                     MOV   m,b   ; +3: val_hi
117C   C3 78 1D               JMP   vm_loop   
117F                             ; 
117F                             ; ---------------------------------------------------------------
117F                             ; OP_LOADNIL (B): R[a] = nil
117F                             ; ---------------------------------------------------------------
117F                DO_OP_LOADNIL:      
117F   CD C0 10               CALL   fetch_byte   ; A = a
1182   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1185   3E 01                  MVI   a,TT_NIL   
1187   CD 1A 10               CALL   set_slot_special   
118A   C3 78 1D               JMP   vm_loop   
118D                             ; 
118D                             ; ---------------------------------------------------------------
118D                             ; OP_LOADT (B): R[a] = true
118D                             ; ---------------------------------------------------------------
118D                DO_OP_LOADT:      
118D   CD C0 10               CALL   fetch_byte   ; A = a
1190   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1193   3E 03                  MVI   a,TT_TRUE   
1195   CD 1A 10               CALL   set_slot_special   
1198   C3 78 1D               JMP   vm_loop   
119B                             ; 
119B                             ; ---------------------------------------------------------------
119B                             ; OP_LOADF (B): R[a] = false
119B                             ; ---------------------------------------------------------------
119B                DO_OP_LOADF:      
119B   CD C0 10               CALL   fetch_byte   ; A = a
119E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11A1   3E 02                  MVI   a,TT_FALSE   
11A3   CD 1A 10               CALL   set_slot_special   
11A6   C3 78 1D               JMP   vm_loop   
11A9                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
11A9                             ; 
11A9                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
11A9                             ; 
11A9                             ; ---------------------------------------------------------------
11A9                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
11A9                             ; 
11A9                             ; R[a] の型で分岐:
11A9                             ;   TT_INTEGER: 16 ビット加算
11A9                             ;   TT_STRING:  文字列連結 (STRCAT と同じ)
11A9                             ; ---------------------------------------------------------------
11A9                DO_OP_ADD:      
11A9   CD C0 10               CALL   fetch_byte   ; A = a
11AC   F5                     PUSH   psw   
11AD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11B0   7E                     MOV   a,m   ; A = 型タグ
11B1   FE 07                  CPI   TT_STRING   
11B3   CA CC 11               JZ   add_string   
11B6                             ; --- 整数パス ---
11B6   F1                     POP   psw   ; A = a
11B7   F5                     PUSH   psw   
11B8                             ; R[a+1] のスロットアドレスを求める
11B8   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11BB   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
11BE   EB                     XCHG      ; DE = R[a+1] の値先頭
11BF   F1                     POP   psw   ; A = a
11C0                             ; R[a] のスロットアドレスを求める
11C0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11C3   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11C6                             ; 16 ビット加算: val[a] += val[a+1]
11C6   CD 35 10               CALL   add_value16   
11C9   C3 78 1D               JMP   vm_loop   
11CC                             ; --- 文字列パス ---
11CC                ADD_STRING:      
11CC   F1                     POP   psw   ; A = a
11CD   32 9D 24               STA   scat_reg_a   
11D0   C3 2D 24               JMP   strcat_body   ; do_op_strcat の本体を再利用
11D3                             ; 
11D3                             ; ---------------------------------------------------------------
11D3                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
11D3                             ; ---------------------------------------------------------------
11D3                DO_OP_SUB:      
11D3   CD C0 10               CALL   fetch_byte   ; A = a
11D6   F5                     PUSH   psw   
11D7   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11DA   CD 32 10               CALL   slot_to_value   
11DD   EB                     XCHG      ; DE = R[a+1] の値先頭
11DE   F1                     POP   psw   ; A = a
11DF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11E2   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11E5   CD 3E 10               CALL   sub_value16   
11E8   C3 78 1D               JMP   vm_loop   
11EB                             ; 
11EB                             ; ---------------------------------------------------------------
11EB                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
11EB                             ; 
11EB                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
11EB                             ; ---------------------------------------------------------------
11EB                DO_OP_ADDI:      
11EB   CD C0 10               CALL   fetch_byte   ; A = a
11EE   F5                     PUSH   psw   
11EF   CD C0 10               CALL   fetch_byte   ; A = b (即値)
11F2   4F                     MOV   c,a   ; C = b
11F3   F1                     POP   psw   ; A = a
11F4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11F7   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
11FA   7E                     MOV   a,m   ; val_lo
11FB   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
11FC   77                     MOV   m,a   
11FD   23                     INX   h   
11FE   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
11FF   CE 00                  ACI   0   ; val_hi + CY
1201   77                     MOV   m,a   
1202   C3 78 1D               JMP   vm_loop   
1205                             ; 
1205                             ; ---------------------------------------------------------------
1205                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
1205                             ; ---------------------------------------------------------------
1205                DO_OP_SUBI:      
1205   CD C0 10               CALL   fetch_byte   ; A = a
1208   F5                     PUSH   psw   
1209   CD C0 10               CALL   fetch_byte   ; A = b (即値)
120C   4F                     MOV   c,a   ; C = b
120D   F1                     POP   psw   ; A = a
120E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1211   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
1214   7E                     MOV   a,m   ; val_lo
1215   91                     SUB   c   ; val_lo - b (CY = 借り)
1216   77                     MOV   m,a   
1217   23                     INX   h   
1218   7E                     MOV   a,m   ; val_hi
1219   DE 00                  SBI   0   ; val_hi - CY
121B   77                     MOV   m,a   
121C   C3 78 1D               JMP   vm_loop   
121F                             ; 
121F                             ; ---------------------------------------------------------------
121F                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
121F                             ; 
121F                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
121F                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
121F                             ; ---------------------------------------------------------------
121F                DO_OP_MUL:      
121F   CD C0 10               CALL   fetch_byte   ; A = a
1222   F5                     PUSH   psw   
1223   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1226   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
1229   5E                     MOV   e,m   ; E = val2_lo
122A   23                     INX   h   
122B   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
122C   F1                     POP   psw   ; A = a
122D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1230   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1233   E5                     PUSH   h   ; 書き戻し先を退避
1234   4E                     MOV   c,m   
1235   23                     INX   h   
1236   46                     MOV   b,m   ; BC = 被乗数
1237   CD 6E 12               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
123A   D1                     POP   d   ; DE = 書き戻し先
123B   7D                     MOV   a,l   
123C   12                     STAX   d   
123D   13                     INX   d   
123E   7C                     MOV   a,h   
123F   12                     STAX   d   
1240   C3 78 1D               JMP   vm_loop   
1243                             ; 
1243                             ; ---------------------------------------------------------------
1243                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
1243                             ; 
1243                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
1243                             ; 除数 0 はエラー停止。
1243                             ; ---------------------------------------------------------------
1243                DO_OP_DIV:      
1243   CD C0 10               CALL   fetch_byte   ; A = a
1246   F5                     PUSH   psw   
1247   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
124A   CD 32 10               CALL   slot_to_value   
124D   5E                     MOV   e,m   
124E   23                     INX   h   
124F   56                     MOV   d,m   ; DE = 除数
1250                             ; ゼロ除算チェック
1250   7A                     MOV   a,d   
1251   B3                     ORA   e   
1252   C2 59 12               JNZ   do_div_nonzero   
1255   F1                     POP   psw   
1256   C3 58 1D               JMP   vm_fail   
1259                DO_DIV_NONZERO:      
1259   F1                     POP   psw   ; A = a
125A   CD 00 10               CALL   get_reg_addr   
125D   CD 32 10               CALL   slot_to_value   
1260   E5                     PUSH   h   ; 書き戻し先を退避
1261   4E                     MOV   c,m   
1262   23                     INX   h   
1263   46                     MOV   b,m   ; BC = 被除数
1264   CD 80 12               CALL   sdiv16   ; BC = 商
1267   E1                     POP   h   ; HL = 書き戻し先
1268   71                     MOV   m,c   
1269   23                     INX   h   
126A   70                     MOV   m,b   
126B   C3 78 1D               JMP   vm_loop   
126E                             ; 
126E                             ; ---------------------------------------------------------------
126E                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
126E                             ; 
126E                             ;   入力: BC = 被乗数, DE = 乗数
126E                             ;   出力: HL = 積の下位 16 ビット
126E                             ;   破壊: A, DE
126E                             ; ---------------------------------------------------------------
126E                UMUL16:      
126E   21 00 00               LXI   h,0   ; 積 = 0
1271   3E 10                  MVI   a,16   ; ビットカウンタ
1273                UMUL16_LOOP:      
1273   29                     DAD   h   ; 積 <<= 1
1274   EB                     XCHG      ; HL ↔ DE
1275   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
1276   EB                     XCHG      ; HL ↔ DE
1277   D2 7B 12               JNC   umul16_noadd   
127A   09                     DAD   b   ; 積 += 被乗数
127B                UMUL16_NOADD:      
127B   3D                     DCR   a   
127C   C2 73 12               JNZ   umul16_loop   
127F   C9                     RET      
1280                             ; 
1280                             ; ---------------------------------------------------------------
1280                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
1280                             ; 
1280                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1280                             ;   出力: BC = 商
1280                             ;   破壊: A, DE, HL
1280                             ; 
1280                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
1280                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
1280                             ; ---------------------------------------------------------------
1280                SDIV16:      
1280   78                     MOV   a,b   
1281   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
1282   F5                     PUSH   psw   ; 符号情報を退避
1283                             ; 被除数を正にする
1283   78                     MOV   a,b   
1284   E6 80                  ANI   80h   
1286   CA 8C 12               JZ   sdiv16_chk_div   
1289   CD DC 12               CALL   neg_bc   
128C                SDIV16_CHK_DIV:      
128C                             ; 除数を正にする
128C   7A                     MOV   a,d   
128D   E6 80                  ANI   80h   
128F   CA 95 12               JZ   sdiv16_do   
1292   CD E4 12               CALL   neg_de   
1295                SDIV16_DO:      
1295   CD A5 12               CALL   udiv16   ; BC = |商|, HL = |剰余|
1298   F1                     POP   psw   
1299   E6 80                  ANI   80h   
129B   C8                     RZ      ; 同符号 → 正の商をそのまま返す
129C                             ; 異符号: 剰余があれば floor 調整
129C   7C                     MOV   a,h   
129D   B5                     ORA   l   
129E   CA A2 12               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
12A1   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
12A2                SDIV16_NEG:      
12A2   C3 DC 12               JMP   neg_bc   
12A5                             ; 
12A5                             ; ---------------------------------------------------------------
12A5                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
12A5                             ; 
12A5                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
12A5                             ;   出力: BC = 商, HL = 剰余
12A5                             ;   破壊: A
12A5                             ; 
12A5                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
12A5                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
12A5                             ; ---------------------------------------------------------------
12A5                UDIV16:      
12A5   21 00 00               LXI   h,0   ; 剰余 = 0
12A8   3E 10                  MVI   a,16   
12AA   32 DB 12               STA   udiv_cnt   
12AD                UDIV16_LOOP:      
12AD                             ; BC を 1 ビット左シフト (MSB → CY)
12AD   79                     MOV   a,c   
12AE   87                     ADD   a   ; C <<= 1, bit7 → CY
12AF   4F                     MOV   c,a   
12B0   78                     MOV   a,b   
12B1   8F                     ADC   a   ; B <<= 1 + CY from C
12B2   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
12B3                             ; CY を剰余 (HL) にシフトイン
12B3   7D                     MOV   a,l   
12B4   17                     RAL      
12B5   6F                     MOV   l,a   
12B6   7C                     MOV   a,h   
12B7   17                     RAL      
12B8   67                     MOV   h,a   
12B9                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
12B9   DA C9 12               JC   udiv16_sub   
12BC                             ; 剰余 (HL) と 除数 (DE) を比較
12BC   7C                     MOV   a,h   
12BD   BA                     CMP   d   
12BE   DA D0 12               JC   udiv16_nosub   ; H < D → HL < DE
12C1   C2 C9 12               JNZ   udiv16_sub   ; H > D → HL > DE
12C4   7D                     MOV   a,l   
12C5   BB                     CMP   e   
12C6   DA D0 12               JC   udiv16_nosub   ; L < E → HL < DE
12C9                UDIV16_SUB:      
12C9                             ; 剰余 ≧ 除数: 減算して商ビット = 1
12C9   7D                     MOV   a,l   
12CA   93                     SUB   e   
12CB   6F                     MOV   l,a   
12CC   7C                     MOV   a,h   
12CD   9A                     SBB   d   
12CE   67                     MOV   h,a   
12CF   0C                     INR   c   ; 商の bit0 を立てる
12D0                UDIV16_NOSUB:      
12D0   3A DB 12               LDA   udiv_cnt   ; LDA は CY に影響しない
12D3   3D                     DCR   a   ; DCR は CY に影響しない
12D4   32 DB 12               STA   udiv_cnt   
12D7   C2 AD 12               JNZ   udiv16_loop   
12DA   C9                     RET      
12DB                             ; 
12DB                UDIV_CNT:      
12DB   00                     DB   0   
12DC                             ; 
12DC                             ; ---------------------------------------------------------------
12DC                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
12DC                             ; ---------------------------------------------------------------
12DC                NEG_BC:      
12DC   79                     MOV   a,c   
12DD   2F                     CMA      
12DE   4F                     MOV   c,a   
12DF   78                     MOV   a,b   
12E0   2F                     CMA      
12E1   47                     MOV   b,a   
12E2   03                     INX   b   
12E3   C9                     RET      
12E4                             ; 
12E4                NEG_DE:      
12E4   7B                     MOV   a,e   
12E5   2F                     CMA      
12E6   5F                     MOV   e,a   
12E7   7A                     MOV   a,d   
12E8   2F                     CMA      
12E9   57                     MOV   d,a   
12EA   13                     INX   d   
12EB   C9                     RET      
12EC                             ; vm_compare.a80 — 比較命令
12EC                             ; 
12EC                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
12EC                             ; 
12EC                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
12EC                             ; Phase 2 は整数のみ。
12EC                             ; 
12EC                             ; cmp_value16 は結果を A で返す:
12EC                             ;   A = 00h → 等しい
12EC                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
12EC                             ;   A = 01h → val1 > val2
12EC                             ; 
12EC                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
12EC                             ; 
12EC                             ; ---------------------------------------------------------------
12EC                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
12EC                             ; 
12EC                             ;   出力: A = 比較結果 (00h/FFh/01h)
12EC                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
12EC                             ;   破壊: A, B, HL, DE
12EC                             ; ---------------------------------------------------------------
12EC                CMP_REG_PAIR:      
12EC   CD C0 10               CALL   fetch_byte   
12EF   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
12F2                             ; R[a+1] の値先頭
12F2   CD 0C 10               CALL   get_reg_addr_next   
12F5   CD 32 10               CALL   slot_to_value   
12F8   EB                     XCHG      ; DE = R[a+1] 値先頭
12F9                             ; R[a] の値先頭
12F9   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
12FC   CD 00 10               CALL   get_reg_addr   
12FF   CD 32 10               CALL   slot_to_value   ; HL = R[a] 値先頭
1302   CD 4B 10               CALL   cmp_value16   ; A = 結果
1305   C9                     RET      
1306                             ; 
1306                             ; ---------------------------------------------------------------
1306                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
1306                             ; 
1306                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
1306                             ; ---------------------------------------------------------------
1306                CMP_SET_TRUE:      
1306   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1309   CD 00 10               CALL   get_reg_addr   
130C   3E 03                  MVI   a,TT_TRUE   
130E   CD 1A 10               CALL   set_slot_special   
1311   C3 78 1D               JMP   vm_loop   
1314                CMP_SET_FALSE:      
1314   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1317   CD 00 10               CALL   get_reg_addr   
131A   3E 02                  MVI   a,TT_FALSE   
131C   CD 1A 10               CALL   set_slot_special   
131F   C3 78 1D               JMP   vm_loop   
1322                             ; 
1322                             ; ---------------------------------------------------------------
1322                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
1322                             ; 
1322                             ; 型タグと値の両方が一致したときだけ true。
1322                             ; ---------------------------------------------------------------
1322                DO_OP_EQ:      
1322   CD C0 10               CALL   fetch_byte   
1325   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
1328                             ; R[a] と R[a+1] のスロットアドレスを求める
1328   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
132B   E5                     PUSH   h   ; R[a] を退避
132C   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
132F   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1332   D1                     POP   d   ; DE = R[a]
1333                             ; HL = R[a+1], DE = R[a]
1333                             ; 型タグを比べる
1333   46                     MOV   b,m   ; B = R[a+1].type
1334   1A                     LDAX   d   ; A = R[a].type
1335   B8                     CMP   b   
1336   C2 14 13               JNZ   cmp_set_false   ; 型が違えば false
1339                             ; 型が同じ → 値を 2 バイト比べる
1339   23                     INX   h   
133A   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
133B   13                     INX   d   
133C   13                     INX   d   ; DE = R[a] + 2 (値先頭)
133D   1A                     LDAX   d   ; A = R[a].val_lo
133E   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
133F   C2 14 13               JNZ   cmp_set_false   
1342   23                     INX   h   
1343   13                     INX   d   
1344   1A                     LDAX   d   ; A = R[a].val_hi
1345   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
1346   C2 14 13               JNZ   cmp_set_false   
1349   C3 06 13               JMP   cmp_set_true   ; すべて一致
134C                             ; 
134C                             ; ---------------------------------------------------------------
134C                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
134C                             ; ---------------------------------------------------------------
134C                DO_OP_LT:      
134C   CD EC 12               CALL   cmp_reg_pair   ; A = 結果
134F   B7                     ORA   a   
1350   FA 06 13               JM   cmp_set_true   ; A = FFh → val1 < val2
1353   C3 14 13               JMP   cmp_set_false   
1356                             ; 
1356                             ; ---------------------------------------------------------------
1356                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
1356                             ; ---------------------------------------------------------------
1356                DO_OP_LE:      
1356   CD EC 12               CALL   cmp_reg_pair   
1359   B7                     ORA   a   
135A   FA 06 13               JM   cmp_set_true   ; val1 < val2
135D   CA 06 13               JZ   cmp_set_true   ; val1 == val2
1360   C3 14 13               JMP   cmp_set_false   
1363                             ; 
1363                             ; ---------------------------------------------------------------
1363                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
1363                             ; ---------------------------------------------------------------
1363                DO_OP_GT:      
1363   CD EC 12               CALL   cmp_reg_pair   
1366   B7                     ORA   a   
1367   CA 14 13               JZ   cmp_set_false   ; val1 == val2
136A   F2 06 13               JP   cmp_set_true   ; A = 01h → val1 > val2
136D   C3 14 13               JMP   cmp_set_false   ; A = FFh → val1 < val2
1370                             ; 
1370                             ; ---------------------------------------------------------------
1370                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
1370                             ; ---------------------------------------------------------------
1370                DO_OP_GE:      
1370   CD EC 12               CALL   cmp_reg_pair   
1373   B7                     ORA   a   
1374   FA 14 13               JM   cmp_set_false   ; val1 < val2
1377   C3 06 13               JMP   cmp_set_true   ; val1 >= val2
137A                             ; vm_jump.a80 — ジャンプ命令
137A                             ; 
137A                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
137A                             ; 
137A                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
137A                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
137A                             ; 
137A                             ; ---------------------------------------------------------------
137A                             ; apply_jump — PC に符号付きオフセットを加える
137A                             ; 
137A                             ;   入力: HL = 符号付き 16 ビットオフセット
137A                             ;   出力: なし (PC が更新される)
137A                             ;   破壊: A, HL, DE
137A                             ; ---------------------------------------------------------------
137A                APPLY_JUMP:      
137A   EB                     XCHG      ; DE = オフセット
137B   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
137E   19                     DAD   d   ; HL = PC + オフセット
137F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1382   C9                     RET      
1383                             ; 
1383                             ; ---------------------------------------------------------------
1383                             ; OP_JMP (S): PC += signed16(a)
1383                             ; ---------------------------------------------------------------
1383                DO_OP_JMP:      
1383   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1386   CD 7A 13               CALL   apply_jump   
1389   C3 78 1D               JMP   vm_loop   
138C                             ; 
138C                             ; ---------------------------------------------------------------
138C                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
138C                             ; 
138C                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
138C                             ; ---------------------------------------------------------------
138C                DO_OP_JMPIF:      
138C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
138F   F5                     PUSH   psw   
1390   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1393   E5                     PUSH   h   ; オフセットを退避
1394   D1                     POP   d   ; DE = オフセット
1395   F1                     POP   psw   ; A = a
1396   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
1399   CD 30 10               CALL   get_slot_type   ; A = 型タグ
139C   FE 03                  CPI   TT_FALSY_MAX + 1   
139E   DA A8 13               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
13A1                             ; 真 → ジャンプする
13A1   EB                     XCHG      ; HL = オフセット (DE にあった)
13A2   CD 7A 13               CALL   apply_jump   
13A5   C3 78 1D               JMP   vm_loop   
13A8                JMPIF_SKIP:      
13A8   C3 78 1D               JMP   vm_loop   
13AB                             ; 
13AB                             ; ---------------------------------------------------------------
13AB                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
13AB                             ; ---------------------------------------------------------------
13AB                DO_OP_JMPNOT:      
13AB   CD C0 10               CALL   fetch_byte   ; A = a
13AE   F5                     PUSH   psw   
13AF   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
13B2   E5                     PUSH   h   
13B3   D1                     POP   d   ; DE = オフセット
13B4   F1                     POP   psw   ; A = a
13B5   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
13B8   CD 30 10               CALL   get_slot_type   ; A = 型タグ
13BB   FE 03                  CPI   TT_FALSY_MAX + 1   
13BD   D2 C7 13               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
13C0                             ; 偽 → ジャンプする
13C0   EB                     XCHG      ; HL = オフセット
13C1   CD 7A 13               CALL   apply_jump   
13C4   C3 78 1D               JMP   vm_loop   
13C7                JMPNOT_SKIP:      
13C7   C3 78 1D               JMP   vm_loop   
13CA                             ; vm_globals.a80 — グローバル変数・インスタンス変数アクセス
13CA                             ; 
13CA                             ; OP_GETGV, OP_SETGV, OP_GETIV, OP_SETIV
13CA                             ; 
13CA                             ; シンボルテーブル (SYM_TABLE_BASE) の 2 バイトエントリ (D,E) で振り分ける:
13CA                             ;   D >= 0x80      : グローバル変数アドレス (DE = アドレス)
13CA                             ;   D == 0x03      : インスタンス変数 (E = ivar_index)
13CA                             ;   D == 0, E == 0 : 未対応シンボル → エラー
13CA                             ; 
13CA                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
13CA                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
13CA                             ; 
13CA                             ; ---------------------------------------------------------------
13CA                             ; OP_GETGV / OP_GETIV (BB): R[a] = global[symbols[b]]
13CA                             ; ---------------------------------------------------------------
13CA                DO_OP_GETGV:      
13CA   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
13CD   F5                     PUSH   psw   
13CE   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
13D1                             ; シンボルテーブルからエントリを取得
13D1   87                     ADD   a   ; A = b * 2
13D2   5F                     MOV   e,a   
13D3   16 00                  MVI   d,0   
13D5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
13D8   19                     DAD   d   ; HL = &sym_table[b]
13D9   5E                     MOV   e,m   
13DA   23                     INX   h   
13DB   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
13DC                             ; 
13DC                             ; D == SYM_KIND_IVAR → インスタンス変数
13DC   7A                     MOV   a,d   
13DD   FE 03                  CPI   SYM_KIND_IVAR   
13DF   CA F8 13               JZ   getiv_handler   
13E2                             ; 
13E2                             ; アドレスが 0 なら未対応シンボル
13E2   7A                     MOV   a,d   
13E3   B3                     ORA   e   
13E4   C2 EB 13               JNZ   getgv_ok   
13E7   F1                     POP   psw   
13E8   C3 58 1D               JMP   vm_fail   
13EB                GETGV_OK:      
13EB   F1                     POP   psw   ; A = a
13EC   D5                     PUSH   d   ; グローバルアドレスを退避
13ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
13F0   EB                     XCHG      ; DE = R[a]
13F1   E1                     POP   h   ; HL = グローバルスロット (コピー元)
13F2   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
13F5   C3 78 1D               JMP   vm_loop   
13F8                             ; 
13F8                             ; --- IVAR GET ---
13F8                             ; E = ivar_index, スタックに a が積まれている
13F8                GETIV_HANDLER:      
13F8   7B                     MOV   a,e   
13F9   32 6C 14               STA   gv_ivar_idx   
13FC   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
13FF   F1                     POP   psw   ; A = a
1400   E5                     PUSH   h   ; IVAR アドレスを退避
1401   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1404   EB                     XCHG      ; DE = R[a]
1405   E1                     POP   h   ; HL = IVAR スロット (コピー元)
1406   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1409   C3 78 1D               JMP   vm_loop   
140C                             ; 
140C                             ; ---------------------------------------------------------------
140C                             ; OP_SETGV / OP_SETIV (BB): global[symbols[b]] = R[a]
140C                             ; ---------------------------------------------------------------
140C                DO_OP_SETGV:      
140C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
140F   F5                     PUSH   psw   
1410   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1413   87                     ADD   a   
1414   5F                     MOV   e,a   
1415   16 00                  MVI   d,0   
1417   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
141A   19                     DAD   d   ; HL = &sym_table[b]
141B   5E                     MOV   e,m   
141C   23                     INX   h   
141D   56                     MOV   d,m   ; DE = エントリ値
141E                             ; 
141E                             ; D == SYM_KIND_IVAR → インスタンス変数
141E   7A                     MOV   a,d   
141F   FE 03                  CPI   SYM_KIND_IVAR   
1421   CA 37 14               JZ   setiv_handler   
1424                             ; 
1424   7A                     MOV   a,d   
1425   B3                     ORA   e   
1426   C2 2D 14               JNZ   setgv_ok   
1429   F1                     POP   psw   
142A   C3 58 1D               JMP   vm_fail   
142D                SETGV_OK:      
142D   F1                     POP   psw   ; A = a
142E   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1431                             ; copy_slot: [HL] → [DE]
1431   CD 25 10               CALL   copy_slot   
1434   C3 78 1D               JMP   vm_loop   
1437                             ; 
1437                             ; --- IVAR SET ---
1437                             ; E = ivar_index, スタックに a が積まれている
1437                SETIV_HANDLER:      
1437   7B                     MOV   a,e   
1438   32 6C 14               STA   gv_ivar_idx   
143B   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
143E   EB                     XCHG      ; DE = IVAR スロット (コピー先)
143F   F1                     POP   psw   ; A = a
1440   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1443   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1446   C3 78 1D               JMP   vm_loop   
1449                             ; 
1449                             ; ---------------------------------------------------------------
1449                             ; calc_ivar_addr — R[0] (self) から IVAR スロットアドレスを算出
1449                             ; 
1449                             ;   入力: gv_ivar_idx = ivar_index
1449                             ;   出力: HL = OBJECT_POOL_BASE + (val_lo-1)*32 + 4 + ivar_index*4
1449                             ;   破壊: A, B, DE
1449                             ; 
1449                             ; R[0].val_lo = slot+1 (TT_OBJECT)
1449                             ; ---------------------------------------------------------------
1449                CALC_IVAR_ADDR:      
1449                             ; R[0] の val_lo を読む
1449   3E 00                  MVI   a,0   
144B   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
144E   23                     INX   h   
144F   23                     INX   h   
1450   7E                     MOV   a,m   ; A = val_lo (slot+1)
1451   3D                     DCR   a   ; A = slot
1452                             ; slot * 32
1452   87                     ADD   a   ; ×2
1453   87                     ADD   a   ; ×4
1454   87                     ADD   a   ; ×8
1455   87                     ADD   a   ; ×16
1456   87                     ADD   a   ; ×32
1457   5F                     MOV   e,a   
1458   16 00                  MVI   d,0   
145A   21 C0 92               LXI   h,OBJECT_POOL_BASE   
145D   19                     DAD   d   ; HL = スロット先頭
145E                             ; + OBJECT_HEADER_SIZE (4)
145E   11 04 00               LXI   d,OBJECT_HEADER_SIZE   
1461   19                     DAD   d   
1462                             ; + ivar_index * 4
1462   3A 6C 14               LDA   gv_ivar_idx   
1465   87                     ADD   a   ; ×2
1466   87                     ADD   a   ; ×4
1467   5F                     MOV   e,a   
1468   16 00                  MVI   d,0   
146A   19                     DAD   d   ; HL = IVAR スロットアドレス
146B   C9                     RET      
146C                             ; 
146C   00           GV_IVAR_IDX:   DB   0   
146D                             ; vm_send.a80 — メソッド呼び出し
146D                             ; 
146D                             ; OP_SEND, OP_SSEND
146D                             ; 
146D                             ; シンボルテーブルの 2 バイトエントリで振り分ける:
146D                             ;   D=0x00, E=1-31 : 組み込みメソッド
146D                             ;   D=0x01, E=id   : ユーザー定義メソッド
146D                             ;   D>=0x80         : グローバルアドレス (メソッドではない → エラー)
146D                             ; 
146D                             ; ---------------------------------------------------------------
146D                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
146D                             ; 
146D                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
146D                             ; ---------------------------------------------------------------
146D                DO_OP_SSEND:      
146D   CD C0 10               CALL   fetch_byte   ; A = a
1470   F5                     PUSH   psw   
1471   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1474   EB                     XCHG      ; DE = R[a]
1475   AF                     XRA   a   ; A = 0
1476   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (self)
1479   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
147C   F1                     POP   psw   ; A = a
147D   32 4D 17               STA   send_reg_a   
1480   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1483   F5                     PUSH   psw   
1484   CD C0 10               CALL   fetch_byte   ; A = c (argc)
1487   32 4E 17               STA   send_argc   
148A   F1                     POP   psw   ; A = b
148B   C3 9F 14               JMP   send_dispatch   
148E                             ; 
148E                             ; ---------------------------------------------------------------
148E                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
148E                             ; ---------------------------------------------------------------
148E                DO_OP_SEND:      
148E   CD C0 10               CALL   fetch_byte   ; A = a
1491   32 4D 17               STA   send_reg_a   
1494   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1497   F5                     PUSH   psw   
1498   CD C0 10               CALL   fetch_byte   ; A = c (argc)
149B   32 4E 17               STA   send_argc   
149E   F1                     POP   psw   ; A = b
149F                             ; 
149F                SEND_DISPATCH:      
149F                             ; シンボルテーブルからメソッド ID を取得
149F   87                     ADD   a   ; b * 2
14A0   5F                     MOV   e,a   
14A1   16 00                  MVI   d,0   
14A3   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
14A6   19                     DAD   d   
14A7   5E                     MOV   e,m   
14A8   23                     INX   h   
14A9   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=id)
14AA                             ; 
14AA                             ; D で振り分け
14AA   7A                     MOV   a,d   
14AB   B7                     ORA   a   
14AC   CA B7 14               JZ   send_builtin   ; D=0x00 → 組み込みメソッド
14AF   FE 01                  CPI   SYM_KIND_USER_METHOD   
14B1   CA E2 14               JZ   send_user_method   ; D=0x01 → ユーザー定義メソッド
14B4                             ; D >= 0x80 or other → エラー
14B4   C3 58 1D               JMP   vm_fail   
14B7                             ; 
14B7                SEND_BUILTIN:      
14B7                             ; E = メソッド ID (0 = 未対応)
14B7   7B                     MOV   a,e   
14B8   B7                     ORA   a   
14B9   CA 58 1D               JZ   vm_fail   
14BC                             ; 組み込みメソッドディスパッチ
14BC   FE 01                  CPI   1   
14BE   CA A8 16               JZ   send_ne   ; != (不等号)
14C1   FE 02                  CPI   2   
14C3   CA DD 16               JZ   send_not   ; !  (論理否定)
14C6   FE 03                  CPI   3   
14C8   CA 05 17               JZ   send_mod   ; %  (剰余)
14CB   FE 04                  CPI   4   
14CD   CA 30 17               JZ   send_abs   ; abs (絶対値)
14D0   FE 1C                  CPI   METHOD_NEW   
14D2   CA 25 15               JZ   send_new   ; Class#new
14D5   FE 1D                  CPI   METHOD_DISPLAY   
14D7   CA 85 1F               JZ   send_display   ; display(value)
14DA   FE 1E                  CPI   METHOD_GETKEY   
14DC   CA A0 1F               JZ   send_getkey   ; getkey
14DF   C3 DB 1F               JMP   send_builtin_ext   ; 拡張ビルトイン (0xA800+ 領域)
14E2                             ; 
14E2                             ; ---------------------------------------------------------------
14E2                             ; send_user_method — ユーザー定義メソッド呼び出し
14E2                             ; 
14E2                             ; E = method_id。メソッド表から irep 番号を引き、
14E2                             ; push_frame + switch_irep で呼び出す。
14E2                             ; ---------------------------------------------------------------
14E2                SEND_USER_METHOD:      
14E2                             ; method_id を退避
14E2   7B                     MOV   a,e   
14E3   32 23 15               STA   sum_method_id   
14E6                             ; 
14E6                             ; R[a] から class_number を取得
14E6   3A 4D 17               LDA   send_reg_a   
14E9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
14EC   CD 9B 10               CALL   class_of_reg   ; A = class_number
14EF                             ; 
14EF                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
14EF   87                     ADD   a   ; ×2
14F0   87                     ADD   a   ; ×4
14F1   87                     ADD   a   ; ×8
14F2   87                     ADD   a   ; ×16
14F3   87                     ADD   a   ; ×32
14F4   5F                     MOV   e,a   
14F5   16 00                  MVI   d,0   
14F7   21 C0 91               LXI   h,METHOD_TABLE_BASE   
14FA   19                     DAD   d   
14FB   3A 23 15               LDA   sum_method_id   
14FE   5F                     MOV   e,a   
14FF   16 00                  MVI   d,0   
1501   19                     DAD   d   ; HL = メソッド表エントリ
1502   7E                     MOV   a,m   ; A = irep 番号
1503   B7                     ORA   a   
1504   CA 58 1D               JZ   vm_fail   ; 0 = 未定義
1507   32 24 15               STA   sum_irep   
150A                             ; 
150A                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
150A   3A 4D 17               LDA   send_reg_a   
150D   06 00                  MVI   b,FRAME_KIND_CALL   
150F   0E FF                  MVI   c,FRAME_NONE   
1511   CD 9C 17               CALL   push_frame   
1514                             ; 
1514                             ; 子 irep に切り替え
1514   3A 24 15               LDA   sum_irep   
1517   CD 21 18               CALL   switch_irep   
151A                             ; 
151A                             ; PC = 0
151A   21 00 00               LXI   h,0   
151D   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1520   C3 78 1D               JMP   vm_loop   
1523                             ; 
1523   00           SUM_METHOD_ID:   DB   0   
1524   00           SUM_IREP:   DB   0   
1525                             ; 
1525                             ; ---------------------------------------------------------------
1525                             ; send_new — Class#new (オブジェクト生成)
1525                             ; 
1525                             ; 1. オブジェクトプールにスロットを確保
1525                             ; 2. R[a] を TT_OBJECT に設定 (val_lo = slot+1)
1525                             ; 3. initialize メソッドがあれば呼び出す
1525                             ; ---------------------------------------------------------------
1525                SEND_NEW:      
1525                             ; **組み込みクラスは作るものが違う。** メソッド表の行も持たない
1525   3A 4D 17               LDA   send_reg_a   
1528   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
152B   7E                     MOV   a,m   ; A = 型タグ
152C   FE 0E                  CPI   TT_BUILTIN_CLASS   
152E   CA B8 15               JZ   send_new_builtin   
1531                             ; 
1531                             ; OBJ_SP < MAX_OBJECTS を確認
1531   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1534   FE 20                  CPI   MAX_OBJECTS   
1536   D2 58 1D               JNC   vm_fail   ; オブジェクトプール満杯
1539                             ; 
1539                             ; R[a] (TT_CLASS) から class_number を取得
1539   32 A4 16               STA   sn_slot   ; OBJ_SP = slot 番号
153C   3A 4D 17               LDA   send_reg_a   
153F   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1542   CD 32 10               CALL   slot_to_value   
1545   7E                     MOV   a,m   ; A = class_number
1546   32 A5 16               STA   sn_class_num   
1549                             ; 
1549                             ; オブジェクトプールにヘッダを書く
1549                             ; OBJECT_POOL_BASE + slot * 32
1549   3A A4 16               LDA   sn_slot   
154C   87                     ADD   a   ; ×2
154D   87                     ADD   a   ; ×4
154E   87                     ADD   a   ; ×8
154F   87                     ADD   a   ; ×16
1550   87                     ADD   a   ; ×32
1551   5F                     MOV   e,a   
1552   16 00                  MVI   d,0   
1554   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1557   19                     DAD   d   ; HL = スロット先頭
1558   3A A5 16               LDA   sn_class_num   
155B   77                     MOV   m,a   ; +0: class_number
155C                             ; 
155C                             ; R[a] = TT_OBJECT, val_lo = slot+1
155C   3A 4D 17               LDA   send_reg_a   
155F   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1562   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1564   23                     INX   h   
1565   36 00                  MVI   m,0   ; +1: 予約
1567   23                     INX   h   
1568   3A A4 16               LDA   sn_slot   
156B   3C                     INR   a   ; slot + 1
156C   77                     MOV   m,a   ; +2: val_lo
156D   23                     INX   h   
156E   36 00                  MVI   m,0   ; +3: val_hi = 0
1570                             ; 
1570                             ; OBJ_SP++
1570   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1573   3C                     INR   a   
1574   32 1B 80               STA   VM_STATE_BASE + OFF_OBJ_SP   
1577                             ; 
1577                             ; initialize メソッドがあれば呼び出す
1577   3A 1C 80               LDA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
157A   B7                     ORA   a   
157B   CA 78 1D               JZ   vm_loop   ; INIT_METHOD_ID=0 → initialize なし
157E                             ; 
157E                             ; method_table[class * 32 + init_id] を引く
157E   32 A6 16               STA   sn_init_id   
1581   3A A5 16               LDA   sn_class_num   
1584   87                     ADD   a   
1585   87                     ADD   a   
1586   87                     ADD   a   
1587   87                     ADD   a   
1588   87                     ADD   a   ; class * 32
1589   5F                     MOV   e,a   
158A   16 00                  MVI   d,0   
158C   21 C0 91               LXI   h,METHOD_TABLE_BASE   
158F   19                     DAD   d   
1590   3A A6 16               LDA   sn_init_id   
1593   5F                     MOV   e,a   
1594   16 00                  MVI   d,0   
1596   19                     DAD   d   ; HL = メソッド表エントリ
1597   7E                     MOV   a,m   ; A = irep 番号
1598   B7                     ORA   a   
1599   CA 78 1D               JZ   vm_loop   ; 未定義 → 呼ばない
159C   32 A7 16               STA   sn_init_irep   
159F                             ; 
159F                             ; push_frame(a, FRAME_KIND_NEW, FRAME_NONE)
159F   3A 4D 17               LDA   send_reg_a   
15A2   06 05                  MVI   b,FRAME_KIND_NEW   
15A4   0E FF                  MVI   c,FRAME_NONE   
15A6   CD 9C 17               CALL   push_frame   
15A9                             ; 
15A9                             ; 子 irep に切り替え
15A9   3A A7 16               LDA   sn_init_irep   
15AC   CD 21 18               CALL   switch_irep   
15AF                             ; 
15AF                             ; PC = 0
15AF   21 00 00               LXI   h,0   
15B2   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
15B5   C3 78 1D               JMP   vm_loop   
15B8                             ; 
15B8                             ; ===============================================================
15B8                             ; send_new_builtin — Array.new / Hash.new
15B8                             ; 
15B8                             ; **引数の数はここで見る。** `new` は表と突き合わせない (クラスごとに
15B8                             ; 違うため) ので、組み込みは自分で数える。
15B8                             ; 
15B8                             ;   Array.new            空配列
15B8                             ;   Array.new(n)         nil で埋める
15B8                             ;   Array.new(n, v)      v の写しで埋める
15B8                             ;   Hash.new             空ハッシュ (引数は取れない)
15B8                             ; ===============================================================
15B8                SEND_NEW_BUILTIN:      
15B8   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値
15BB   7E                     MOV   a,m   ; A = BUILTIN_CLASS_*
15BC   FE 02                  CPI   BUILTIN_CLASS_HASH   
15BE   CA 76 16               JZ   send_new_hash   
15C1                             ; 
15C1                             ; --- Array.new ---
15C1   3A 4E 17               LDA   send_argc   
15C4   FE 03                  CPI   3   
15C6   D2 58 1D               JNC   vm_fail   ; 取るのは 0-2 個
15C9   B7                     ORA   a   
15CA   CA 54 16               JZ   snb_empty   ; 引数なし → 空配列
15CD                             ; 
15CD                             ; 大きさは R[a+1]。整数で 0-COL_MAX_ARRAY_ELEMS のこと
15CD   3A 4D 17               LDA   send_reg_a   
15D0   3C                     INR   a   
15D1   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
15D4   7E                     MOV   a,m   ; A = 型タグ
15D5   FE 04                  CPI   TT_INTEGER   
15D7   C2 58 1D               JNZ   vm_fail   
15DA   23                     INX   h   ; +1: 予約
15DB   23                     INX   h   ; +2: val_lo
15DC   4E                     MOV   c,m   ; C = 下位バイト
15DD   23                     INX   h   
15DE   7E                     MOV   a,m   ; A = 上位バイト
15DF   B7                     ORA   a   
15E0   C2 58 1D               JNZ   vm_fail   ; 上位があれば負か大きすぎる (負は FFh)
15E3   79                     MOV   a,c   
15E4   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
15E6   D2 58 1D               JNC   vm_fail   ; 1 スロットに収まらない
15E9   32 9F 16               STA   snb_count   
15EC   B7                     ORA   a   
15ED   CA 54 16               JZ   snb_empty   ; 0 個 → 空配列
15F0                             ; 
15F0                             ; スロットを確保して見出しを書く
15F0   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
15F3   32 A0 16               STA   snb_slot   
15F6   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
15F8   23                     INX   h   
15F9   3A 9F 16               LDA   snb_count   
15FC   77                     MOV   m,a   ; +1: count
15FD   23                     INX   h   ; HL → データ領域
15FE   22 A2 16               SHLD   snb_data   
1601                             ; 
1601                             ; 要素を埋める。引数が 2 つなら R[a+2]、1 つなら nil
1601   3A 9F 16               LDA   snb_count   
1604   32 A1 16               STA   snb_left   
1607                SNB_FILL_LOOP:      
1607   2A A2 16               LHLD   snb_data   
160A   EB                     XCHG      ; DE = 書き先
160B   3A 4E 17               LDA   send_argc   
160E   FE 02                  CPI   2   
1610   CA 21 16               JZ   snb_fill_value   
1613                             ; 
1613                             ; nil で埋める
1613   3E 01                  MVI   a,TT_NIL   
1615   12                     STAX   d   
1616   13                     INX   d   
1617   AF                     XRA   a   
1618   12                     STAX   d   
1619   13                     INX   d   
161A   12                     STAX   d   
161B   13                     INX   d   
161C   12                     STAX   d   
161D   13                     INX   d   
