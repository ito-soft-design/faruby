163D   3A 4D 17               LDA   send_reg_a   
1640   CD 00 10               CALL   get_reg_addr   
1643   36 08                  MVI   m,TT_ARRAY   
1645   23                     INX   h   
1646   36 00                  MVI   m,0   
1648   23                     INX   h   
1649   3A A0 16               LDA   snb_slot   
164C   3C                     INR   a   
164D   77                     MOV   m,a   
164E   23                     INX   h   
164F   36 00                  MVI   m,0   
1651   C3 78 1D               JMP   vm_loop   
1654                             ; 
1654                             ; 空配列。count = 0 のスロットを 1 つ取る
1654                SNB_EMPTY:      
1654   CD B9 21               CALL   col_alloc   
1657   32 A0 16               STA   snb_slot   
165A   36 02                  MVI   m,COL_TYPE_ARRAY   
165C   23                     INX   h   
165D   36 00                  MVI   m,0   ; +1: count = 0
165F   3A 4D 17               LDA   send_reg_a   
1662   CD 00 10               CALL   get_reg_addr   
1665   36 08                  MVI   m,TT_ARRAY   
1667   23                     INX   h   
1668   36 00                  MVI   m,0   
166A   23                     INX   h   
166B   3A A0 16               LDA   snb_slot   
166E   3C                     INR   a   
166F   77                     MOV   m,a   
1670   23                     INX   h   
1671   36 00                  MVI   m,0   
1673   C3 78 1D               JMP   vm_loop   
1676                             ; 
1676                             ; Hash.new。**引数は取れない** — 既定値 (Hash.new(0)) を覚える場所が無い
1676                SEND_NEW_HASH:      
1676   3A 4E 17               LDA   send_argc   
1679   B7                     ORA   a   
167A   C2 58 1D               JNZ   vm_fail   
167D   CD B9 21               CALL   col_alloc   
1680   32 A0 16               STA   snb_slot   
1683   36 03                  MVI   m,COL_TYPE_HASH   
1685   23                     INX   h   
1686   36 00                  MVI   m,0   ; +1: ペア数 = 0
1688   3A 4D 17               LDA   send_reg_a   
168B   CD 00 10               CALL   get_reg_addr   
168E   36 09                  MVI   m,TT_HASH   
1690   23                     INX   h   
1691   36 00                  MVI   m,0   
1693   23                     INX   h   
1694   3A A0 16               LDA   snb_slot   
1697   3C                     INR   a   
1698   77                     MOV   m,a   
1699   23                     INX   h   
169A   36 00                  MVI   m,0   
169C   C3 78 1D               JMP   vm_loop   
169F                             ; 
169F   00           SNB_COUNT:   DB   0   
16A0   00           SNB_SLOT:   DB   0   
16A1   00           SNB_LEFT:   DB   0   
16A2   00 00        SNB_DATA:   DW   0   
16A4                             ; 
16A4   00           SN_SLOT:   DB   0   
16A5   00           SN_CLASS_NUM:   DB   0   
16A6   00           SN_INIT_ID:   DB   0   
16A7   00           SN_INIT_IREP:   DB   0   
16A8                             ; 
16A8                             ; ---------------------------------------------------------------
16A8                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
16A8                             ; 
16A8                             ; スロット全体 (4 バイト) をバイト比較する。
16A8                             ; 型タグも含めて比較するので異なる型は常に true。
16A8                             ; ---------------------------------------------------------------
16A8                SEND_NE:      
16A8   3A 4D 17               LDA   send_reg_a   
16AB   F5                     PUSH   psw   
16AC   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
16AF   EB                     XCHG      ; DE = R[a+1]
16B0   F1                     POP   psw   
16B1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
16B4   0E 04                  MVI   c,SLOT_BYTES   
16B6                SEND_NE_CMP:      
16B6   1A                     LDAX   d   
16B7   BE                     CMP   m   
16B8   C2 CF 16               JNZ   send_ne_diff   
16BB   23                     INX   h   
16BC   13                     INX   d   
16BD   0D                     DCR   c   
16BE   C2 B6 16               JNZ   send_ne_cmp   
16C1                             ; 全バイト一致 → 等しい → false
16C1   3A 4D 17               LDA   send_reg_a   
16C4   CD 00 10               CALL   get_reg_addr   
16C7   3E 02                  MVI   a,TT_FALSE   
16C9   CD 1A 10               CALL   set_slot_special   
16CC   C3 78 1D               JMP   vm_loop   
16CF                SEND_NE_DIFF:      
16CF   3A 4D 17               LDA   send_reg_a   
16D2   CD 00 10               CALL   get_reg_addr   
16D5   3E 03                  MVI   a,TT_TRUE   
16D7   CD 1A 10               CALL   set_slot_special   
16DA   C3 78 1D               JMP   vm_loop   
16DD                             ; 
16DD                             ; ---------------------------------------------------------------
16DD                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
16DD                             ; 
16DD                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
16DD                             ; ---------------------------------------------------------------
16DD                SEND_NOT:      
16DD   3A 4D 17               LDA   send_reg_a   
16E0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
16E3   7E                     MOV   a,m   ; A = 型タグ
16E4   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
16E6   DA F7 16               JC   send_not_falsy   
16E9                             ; 真だった → false
16E9   3A 4D 17               LDA   send_reg_a   
16EC   CD 00 10               CALL   get_reg_addr   
16EF   3E 02                  MVI   a,TT_FALSE   
16F1   CD 1A 10               CALL   set_slot_special   
16F4   C3 78 1D               JMP   vm_loop   
16F7                SEND_NOT_FALSY:      
16F7                             ; 偽だった → true
16F7   3A 4D 17               LDA   send_reg_a   
16FA   CD 00 10               CALL   get_reg_addr   
16FD   3E 03                  MVI   a,TT_TRUE   
16FF   CD 1A 10               CALL   set_slot_special   
1702   C3 78 1D               JMP   vm_loop   
1705                             ; 
1705                             ; ---------------------------------------------------------------
1705                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
1705                             ; ---------------------------------------------------------------
1705                SEND_MOD:      
1705   3A 4D 17               LDA   send_reg_a   
1708   F5                     PUSH   psw   
1709   CD 0C 10               CALL   get_reg_addr_next   
170C   CD 32 10               CALL   slot_to_value   
170F   5E                     MOV   e,m   
1710   23                     INX   h   
1711   56                     MOV   d,m   ; DE = 除数
1712   7A                     MOV   a,d   
1713   B3                     ORA   e   
1714   C2 1B 17               JNZ   send_mod_ok   
1717   F1                     POP   psw   
1718   C3 58 1D               JMP   vm_fail   ; ゼロ除算
171B                SEND_MOD_OK:      
171B   F1                     POP   psw   
171C   CD 00 10               CALL   get_reg_addr   
171F   CD 32 10               CALL   slot_to_value   
1722   E5                     PUSH   h   ; 書き戻し先
1723   4E                     MOV   c,m   
1724   23                     INX   h   
1725   46                     MOV   b,m   ; BC = 被除数
1726   CD 4F 17               CALL   smod16   ; BC = 剰余 (除数と同符号)
1729   E1                     POP   h   
172A   71                     MOV   m,c   
172B   23                     INX   h   
172C   70                     MOV   m,b   
172D   C3 78 1D               JMP   vm_loop   
1730                             ; 
1730                             ; ---------------------------------------------------------------
1730                             ; abs (絶対値): R[a] = |R[a]|
1730                             ; ---------------------------------------------------------------
1730                SEND_ABS:      
1730   3A 4D 17               LDA   send_reg_a   
1733   CD 00 10               CALL   get_reg_addr   
1736   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭
1739   23                     INX   h   ; HL → val_hi
173A   7E                     MOV   a,m   
173B   E6 80                  ANI   80h   
173D   CA 78 1D               JZ   vm_loop   ; 正ならそのまま
1740   2B                     DCX   h   ; HL → val_lo
1741   4E                     MOV   c,m   
1742   23                     INX   h   
1743   46                     MOV   b,m   ; BC = 値
1744   CD DC 12               CALL   neg_bc   
1747   70                     MOV   m,b   ; val_hi
1748   2B                     DCX   h   
1749   71                     MOV   m,c   ; val_lo
174A   C3 78 1D               JMP   vm_loop   
174D                             ; 
174D                             ; --- 一時変数 ---
174D                SEND_REG_A:      
174D   00                     DB   0   
174E                SEND_ARGC:      
174E   00                     DB   0   
174F                             ; 
174F                             ; ---------------------------------------------------------------
174F                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
174F                             ; 
174F                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
174F                             ;   出力: BC = 剰余 (除数と同符号)
174F                             ;   破壊: A, DE, HL
174F                             ; 
174F                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
174F                             ; ---------------------------------------------------------------
174F                SMOD16:      
174F                             ; 除数の符号を保存
174F   7A                     MOV   a,d   
1750   F5                     PUSH   psw   
1751                             ; 符号の差を保存 (bit7: 異符号なら 1)
1751   78                     MOV   a,b   
1752   AA                     XRA   d   
1753   F5                     PUSH   psw   
1754                             ; 被除数を正にする
1754   78                     MOV   a,b   
1755   E6 80                  ANI   80h   
1757   CA 5D 17               JZ   smod_chk_div   
175A   CD DC 12               CALL   neg_bc   
175D                SMOD_CHK_DIV:      
175D   7A                     MOV   a,d   
175E   E6 80                  ANI   80h   
1760   CA 66 17               JZ   smod_do   
1763   CD E4 12               CALL   neg_de   
1766                SMOD_DO:      
1766   D5                     PUSH   d   ; |除数| を退避
1767   CD A5 12               CALL   udiv16   ; BC = 商, HL = 剰余
176A   44                     MOV   b,h   
176B   4D                     MOV   c,l   ; BC = |剰余|
176C   78                     MOV   a,b   
176D   B1                     ORA   c   
176E   D1                     POP   d   ; DE = |除数|
176F   F1                     POP   psw   ; 符号差 (bit7)
1770   CA 85 17               JZ   smod_zero   ; 剰余 = 0
1773   E6 80                  ANI   80h   
1775   CA 7E 17               JZ   smod_sign   ; 同符号 → 大きさはそのまま
1778                             ; 異符号: 大きさ = |除数| - |剰余|
1778   7B                     MOV   a,e   
1779   91                     SUB   c   
177A   4F                     MOV   c,a   
177B   7A                     MOV   a,d   
177C   98                     SBB   b   
177D   47                     MOV   b,a   
177E                SMOD_SIGN:      
177E   F1                     POP   psw   ; 除数の符号 (bit7)
177F   E6 80                  ANI   80h   
1781   C8                     RZ      ; 除数が正 → 正の剰余
1782   C3 DC 12               JMP   neg_bc   ; 除数が負 → 負にする
1785                SMOD_ZERO:      
1785   F1                     POP   psw   ; 除数の符号を捨てる
1786   C9                     RET      
1787                             ; vm_frame.a80 — フレームスタック管理
1787                             ; 
1787                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
1787                             ; 
1787                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
1787                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
1787                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
1787                             ;   get_frame_addr : フレーム番号 → メモリアドレス
1787                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
1787                             ; 
1787                             ; ---------------------------------------------------------------
1787                             ; get_frame_addr — フレーム番号 → アドレス
1787                             ; 
1787                             ;   入力: A = フレーム番号 (0-7)
1787                             ;   出力: HL = FRAME_STACK_BASE + A * 12
1787                             ;   破壊: A, B, DE
1787                             ; ---------------------------------------------------------------
1787                GET_FRAME_ADDR:      
1787   4F                     MOV   c,a   ; C = 元の値 (退避)
1788   87                     ADD   a   ; ×2
1789   47                     MOV   b,a   ; B = ×2
178A   87                     ADD   a   ; ×4
178B   80                     ADD   b   ; ×4 + ×2 = ×6
178C   87                     ADD   a   ; ×12
178D   5F                     MOV   e,a   
178E   16 00                  MVI   d,0   ; DE = frame * 12
1790   21 00 91               LXI   h,FRAME_STACK_BASE   
1793   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
1794   C9                     RET      
1795                             ; 
1795                             ; ---------------------------------------------------------------
1795                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
1795                             ; 
1795                             ;   入力: なし
1795                             ;   出力: HL = 現在のフレームのアドレス
1795                             ;   破壊: A, B, C, DE
1795                             ; ---------------------------------------------------------------
1795                CUR_FRAME_ADDR:      
1795   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1798   3D                     DCR   a   
1799   C3 87 17               JMP   get_frame_addr   
179C                             ; 
179C                             ; ---------------------------------------------------------------
179C                             ; push_frame — 現在の状態をフレームに保存
179C                             ; 
179C                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
179C                             ;          B = フレーム種別 (FRAME_KIND_*)
179C                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
179C                             ;   出力: なし
179C                             ;   破壊: A, B, C, HL, DE
179C                             ; 
179C                             ; frame_sp のスロットに保存して frame_sp++。
179C                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
179C                             ; ---------------------------------------------------------------
179C                PUSH_FRAME:      
179C                             ; パラメータを退避
179C   32 F4 17               STA   pf_shift_reg   
179F   78                     MOV   a,b   
17A0   32 F5 17               STA   pf_kind   
17A3   79                     MOV   a,c   
17A4   32 F6 17               STA   pf_outer   
17A7                             ; 
17A7                             ; HL = frame[frame_sp]
17A7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17AA   CD 87 17               CALL   get_frame_addr   
17AD                             ; 
17AD                             ; +0,+1: return_pc
17AD   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
17B0   77                     MOV   m,a   
17B1   23                     INX   h   
17B2   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
17B5   77                     MOV   m,a   
17B6   23                     INX   h   
17B7                             ; 
17B7                             ; +2: return_irep
17B7   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
17BA   77                     MOV   m,a   
17BB   23                     INX   h   
17BC                             ; 
17BC                             ; +3,+4: return_reg_base
17BC   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
17BF   77                     MOV   m,a   
17C0   23                     INX   h   
17C1   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
17C4   77                     MOV   m,a   
17C5   23                     INX   h   
17C6                             ; 
17C6                             ; +5: kind
17C6   3A F5 17               LDA   pf_kind   
17C9   77                     MOV   m,a   
17CA   23                     INX   h   
17CB                             ; 
17CB                             ; +6,+7: index = 0
17CB   36 00                  MVI   m,0   
17CD   23                     INX   h   
17CE   36 00                  MVI   m,0   
17D0   23                     INX   h   
17D1                             ; 
17D1                             ; +8,+9: limit = 0
17D1   36 00                  MVI   m,0   
17D3   23                     INX   h   
17D4   36 00                  MVI   m,0   
17D6   23                     INX   h   
17D7                             ; 
17D7                             ; +10: outer
17D7   3A F6 17               LDA   pf_outer   
17DA   77                     MOV   m,a   
17DB                             ; 
17DB                             ; reg_base += shift_reg * 4
17DB   3A F4 17               LDA   pf_shift_reg   
17DE   87                     ADD   a   ; ×2
17DF   87                     ADD   a   ; ×4
17E0   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
17E3   85                     ADD   l   
17E4   6F                     MOV   l,a   
17E5   3E 00                  MVI   a,0   
17E7   8C                     ADC   h   
17E8   67                     MOV   h,a   
17E9   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
17EC                             ; 
17EC                             ; frame_sp++
17EC   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17EF   3C                     INR   a   
17F0   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
17F3   C9                     RET      
17F4                             ; 
17F4                             ; push_frame の一時変数
17F4   00           PF_SHIFT_REG:   DB   0   
17F5   00           PF_KIND:   DB   0   
17F6   00           PF_OUTER:   DB   0   
17F7                             ; 
17F7                             ; ---------------------------------------------------------------
17F7                             ; pop_frame — frame_sp-- して保存した状態を復帰
17F7                             ; 
17F7                             ;   入力: なし
17F7                             ;   出力: なし
17F7                             ;   破壊: A, B, C, HL, DE
17F7                             ; 
17F7                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
17F7                             ; ---------------------------------------------------------------
17F7                POP_FRAME:      
17F7                             ; frame_sp--
17F7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17FA   3D                     DCR   a   
17FB   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
17FE                             ; 
17FE                             ; HL = frame[frame_sp] (decremented value)
17FE   CD 87 17               CALL   get_frame_addr   
1801                             ; 
1801                             ; +0,+1: restore return_pc
1801   7E                     MOV   a,m   
1802   32 00 80               STA   VM_STATE_BASE + OFF_PC   
1805   23                     INX   h   
1806   7E                     MOV   a,m   
1807   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
180A   23                     INX   h   
180B                             ; 
180B                             ; +2: return_irep → switch_irep 用に退避
180B   7E                     MOV   a,m   
180C   32 20 18               STA   popf_ret_irep   
180F   23                     INX   h   
1810                             ; 
1810                             ; +3,+4: restore return_reg_base
1810   7E                     MOV   a,m   
1811   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
1814   23                     INX   h   
1815   7E                     MOV   a,m   
1816   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
1819                             ; 
1819                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
1819   3A 20 18               LDA   popf_ret_irep   
181C   CD 21 18               CALL   switch_irep   
181F   C9                     RET      
1820                             ; 
1820   00           POPF_RET_IREP:   DB   0   
1821                             ; 
1821                             ; ---------------------------------------------------------------
1821                             ; switch_irep — IREP テーブルから実行情報をロード
1821                             ; 
1821                             ;   入力: A = IREP 番号
1821                             ;   出力: なし
1821                             ;   破壊: A, B, C, HL, DE
1821                             ; 
1821                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
1821                             ; ---------------------------------------------------------------
1821                SWITCH_IREP:      
1821   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
1824                             ; 
1824                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
1824                             ; A * 10 = A * 8 + A * 2
1824   4F                     MOV   c,a   ; C = A (退避)
1825   87                     ADD   a   ; ×2
1826   47                     MOV   b,a   ; B = A*2
1827   79                     MOV   a,c   
1828   87                     ADD   a   ; ×2
1829   87                     ADD   a   ; ×4
182A   87                     ADD   a   ; ×8
182B   80                     ADD   b   ; A*8 + A*2 = A*10
182C   5F                     MOV   e,a   
182D   16 00                  MVI   d,0   
182F   21 00 82               LXI   h,IREP_TABLE_BASE   
1832   19                     DAD   d   ; HL = エントリアドレス
1833                             ; 
1833                             ; +0,+1: bytecode base → BC_BASE
1833   7E                     MOV   a,m   
1834   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1837   23                     INX   h   
1838   7E                     MOV   a,m   
1839   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
183C   23                     INX   h   
183D                             ; 
183D                             ; +2,+3: bytecode len → BC_LEN
183D   7E                     MOV   a,m   
183E   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1841   23                     INX   h   
1842   7E                     MOV   a,m   
1843   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1846   23                     INX   h   
1847                             ; 
1847                             ; +4,+5: pool base → POOL_BASE
1847   7E                     MOV   a,m   
1848   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
184B   23                     INX   h   
184C   7E                     MOV   a,m   
184D   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1850   23                     INX   h   
1851                             ; 
1851                             ; +6: nregs
1851   7E                     MOV   a,m   
1852   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
1855                             ; 
1855                             ; +7: subtree_size (スキップ)
1855   23                     INX   h   
1856                             ; 
1856                             ; +8,+9: sym_table_base → SYM_BASE
1856   23                     INX   h   
1857   7E                     MOV   a,m   
1858   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
185B   23                     INX   h   
185C   7E                     MOV   a,m   
185D   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1860                             ; 
1860   C9                     RET      
1861                             ; vm_block.a80 — ブロック関連オペコード
1861                             ; 
1861                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
1861                             ; 
1861                             ; ---------------------------------------------------------------
1861                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
1861                             ; ---------------------------------------------------------------
1861                DO_OP_LOADSELF:      
1861   CD C0 10               CALL   fetch_byte   ; A = a
1864   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1867   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1869   23                     INX   h   
186A   36 00                  MVI   m,0   ; +1: 予約
186C   23                     INX   h   
186D   36 00                  MVI   m,0   ; +2: val_lo = 0
186F   23                     INX   h   
1870   36 00                  MVI   m,0   ; +3: val_hi = 0
1872   C3 78 1D               JMP   vm_loop   
1875                             ; 
1875                             ; ---------------------------------------------------------------
1875                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
1875                             ; 
1875                             ; ブロックを TT_PROC としてレジスタに格納する。
1875                             ;   値の下位バイト = 子 irep 番号
1875                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
1875                             ; ---------------------------------------------------------------
1875                DO_OP_BLOCK:      
1875   CD C0 10               CALL   fetch_byte   ; A = a
1878   32 A1 18               STA   blk_reg_a   
187B   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
187E                             ; 
187E                             ; 子 irep 番号を算出 (共通サブルーチン)
187E   CD 77 10               CALL   calc_child_irep   ; A = child irep 番号
1881                             ; 
1881                             ; R[a] に TT_PROC を書く
1881   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1882   3A A1 18               LDA   blk_reg_a   
1885   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1888   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
188A   23                     INX   h   
188B   36 00                  MVI   m,0   ; +1: 予約
188D   23                     INX   h   
188E   71                     MOV   m,c   ; +2: val_lo = irep 番号
188F   23                     INX   h   
1890                             ; val_hi = 外側フレーム番号
1890                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
1890                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
1890   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1893   B7                     ORA   a   
1894   C2 9C 18               JNZ   block_in_frame   
1897   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
1899   C3 9D 18               JMP   block_set_outer   
189C                BLOCK_IN_FRAME:      
189C   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
189D                BLOCK_SET_OUTER:      
189D   77                     MOV   m,a   ; +3: val_hi = outer frame
189E   C3 78 1D               JMP   vm_loop   
18A1                             ; 
18A1   00           BLK_REG_A:   DB   0   
18A2                             ; 
18A2                             ; ---------------------------------------------------------------
18A2                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
18A2                             ; 
18A2                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
18A2                             ; ---------------------------------------------------------------
18A2                DO_OP_ENTER:      
18A2   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 1)
18A5   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 2)
18A8   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 3)
18AB   C3 78 1D               JMP   vm_loop   
18AE                             ; 
18AE                             ; ---------------------------------------------------------------
18AE                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
18AE                             ; 
18AE                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
18AE                             ; ブロック付きメソッド呼び出しを行う。
18AE                             ; ---------------------------------------------------------------
18AE                DO_OP_SSENDB:      
18AE                             ; オペランドをプリフェッチ
18AE   CD C0 10               CALL   fetch_byte   ; A = a
18B1   32 CD 19               STA   sendb_reg_a   
18B4   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
18B7   32 CE 19               STA   sendb_sym_b   
18BA   CD C0 10               CALL   fetch_byte   ; A = c (argc)
18BD   32 CF 19               STA   sendb_argc   
18C0                             ; 
18C0                             ; R[0] → R[a] コピー (self を設定)
18C0   3E 00                  MVI   a,0   
18C2   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
18C5   E5                     PUSH   h   ; R[0] アドレス退避
18C6   3A CD 19               LDA   sendb_reg_a   
18C9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
18CC   EB                     XCHG      ; DE = R[a]
18CD   E1                     POP   h   ; HL = R[0]
18CE   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
18D1                             ; 
18D1   C3 EA 18               JMP   sendb_dispatch   
18D4                             ; 
18D4                             ; ---------------------------------------------------------------
18D4                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
18D4                             ; 
18D4                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
18D4                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
18D4                             ; ---------------------------------------------------------------
18D4                DO_OP_SENDB:      
18D4                             ; **ブロックを渡された。** 恒等ブロックの旗を下ろす
18D4   AF                     XRA   a   
18D5   32 B4 2A               STA   pred_identity   
18D8   CD C0 10               CALL   fetch_byte   ; A = a
18DB   32 CD 19               STA   sendb_reg_a   
18DE   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
18E1   32 CE 19               STA   sendb_sym_b   
18E4   CD C0 10               CALL   fetch_byte   ; A = c (argc)
18E7   32 CF 19               STA   sendb_argc   
18EA                             ; 
18EA                SENDB_DISPATCH:      
18EA                             ; シンボルテーブルからメソッド ID を取得
18EA   3A CE 19               LDA   sendb_sym_b   
18ED   87                     ADD   a   ; ×2
18EE   5F                     MOV   e,a   
18EF   16 00                  MVI   d,0   
18F1   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
18F4   19                     DAD   d   ; HL = sym_table[b]
18F5   7E                     MOV   a,m   ; メソッド ID (下位)
18F6   32 D0 19               STA   sendb_method_id   
18F9                             ; 
18F9                             ; メソッド ID で振り分け
18F9   3A D0 19               LDA   sendb_method_id   
18FC   FE 0B                  CPI   11   ; METHOD_TIMES
18FE   CA 34 19               JZ   sendb_times   
1901   FE 15                  CPI   METHOD_EACH   
1903   CA D9 29               JZ   sendb_each   
1906   FE 1B                  CPI   27   ; METHOD_LOOP
1908   CA 97 19               JZ   sendb_loop   
190B                             ; any? / all? / none? は each と同じ反復。フレームの種別だけが違う
190B   FE 23                  CPI   METHOD_ANY_P   
190D   CA 22 19               JZ   sendb_any   
1910   FE 24                  CPI   METHOD_ALL_P   
1912   CA 27 19               JZ   sendb_all   
1915   FE 25                  CPI   METHOD_NONE_P   
1917   CA 2C 19               JZ   sendb_none   
191A   FE 1C                  CPI   METHOD_NEW   
191C   CA 17 2B               JZ   sendb_array_new   
191F                             ; 未対応のブロックメソッド
191F   C3 58 1D               JMP   vm_fail   
1922                             ; 
1922                             ; --- any? / all? / none? ---
1922                             ; 
1922                             ; **渡す値は each と同じ**なので sendb_each に合流します。種別が持つのは
1922                             ; 「ブロックの値をどう使うか」だけで、配列かハッシュかはスロットの
1922                             ; 見出しの種別 (COL_TYPE_*) で決まります。
1922                SENDB_ANY:      
1922   3E 06                  MVI   a,FRAME_KIND_ANY   
1924   C3 2E 19               JMP   sendb_pred   
1927                SENDB_ALL:      
1927   3E 07                  MVI   a,FRAME_KIND_ALL   
1929   C3 2E 19               JMP   sendb_pred   
192C                SENDB_NONE:      
192C   3E 08                  MVI   a,FRAME_KIND_NONE   
192E                SENDB_PRED:      
192E   32 54 2C               STA   each_arg_kind   
1931   C3 F4 29               JMP   sendb_each_join   
1934                             ; 
1934                             ; --- times ---
1934                SENDB_TIMES:      
1934                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
1934   3A CD 19               LDA   sendb_reg_a   
1937   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
193A   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
193D   4E                     MOV   c,m   ; C = val_lo
193E   23                     INX   h   
193F   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
1940                             ; 
1940                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
1940   78                     MOV   a,b   
1941   B1                     ORA   c   
1942   CA 78 1D               JZ   vm_loop   ; receiver == 0 → スキップ
1945                             ; 
1945                             ; limit = BC - 1
1945   0B                     DCX   b   ; BC = limit
1946                             ; 
1946                             ; push_frame: A=レジスタ番号, B=kind, C=outer
1946                             ; ブロックの位置: R[a + argc + 1]
1946   3A CD 19               LDA   sendb_reg_a   
1949   C5                     PUSH   b   ; limit を退避
194A                             ; ブロック (TT_PROC) の情報を読む
194A   3A CF 19               LDA   sendb_argc   
194D   3C                     INR   a   ; argc + 1
194E   47                     MOV   b,a   
194F   3A CD 19               LDA   sendb_reg_a   
1952   80                     ADD   b   ; A = a + argc + 1
1953   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1956   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1959   7E                     MOV   a,m   ; A = irep 番号
195A   32 D1 19               STA   sendb_block_irep   
195D   23                     INX   h   
195E   7E                     MOV   a,m   ; A = outer frame (val_hi)
195F   32 D2 19               STA   sendb_block_outer   
1962                             ; 
1962                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
1962   3A CD 19               LDA   sendb_reg_a   
1965   06 01                  MVI   b,FRAME_KIND_ITERATE   
1967   3A D2 19               LDA   sendb_block_outer   
196A   4F                     MOV   c,a   
196B   3A CD 19               LDA   sendb_reg_a   
196E   CD 9C 17               CALL   push_frame   
1971                             ; 
1971                             ; フレームに limit を設定
1971                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
1971   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
1974   11 08 00               LXI   d,FRAME_OFF_LIMIT   
1977   19                     DAD   d   ; HL = &limit
1978   C1                     POP   b   ; BC = limit (ここで復帰)
1979   71                     MOV   m,c   ; limit_lo
197A   23                     INX   h   
197B   70                     MOV   m,b   ; limit_hi
197C                             ; 
197C                             ; ブロック引数 R[1] = 0 (初期カウンタ)
197C                             ; R[1] は新しい reg_base から見た R[1]
197C   3E 01                  MVI   a,1   
197E   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1981   06 00                  MVI   b,0   
1983   0E 00                  MVI   c,0   
1985   CD 10 10               CALL   set_slot_int16   ; R[1] = 0
1988                             ; 
1988                             ; 子 irep に切り替え
1988   3A D1 19               LDA   sendb_block_irep   
198B   CD 21 18               CALL   switch_irep   
198E                             ; 
198E                             ; PC = 0
198E   21 00 00               LXI   h,0   
1991   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1994   C3 78 1D               JMP   vm_loop   
1997                             ; 
1997                             ; --- loop ---
1997                SENDB_LOOP:      
1997                             ; ブロックの位置: R[a + argc + 1]
1997   3A CF 19               LDA   sendb_argc   
199A   3C                     INR   a   
199B   47                     MOV   b,a   
199C   3A CD 19               LDA   sendb_reg_a   
199F   80                     ADD   b   ; A = a + argc + 1
19A0   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
19A3   CD 32 10               CALL   slot_to_value   
19A6   7E                     MOV   a,m   ; irep 番号
19A7   32 D1 19               STA   sendb_block_irep   
19AA   23                     INX   h   
19AB   7E                     MOV   a,m   ; outer
19AC   32 D2 19               STA   sendb_block_outer   
19AF                             ; 
19AF                             ; push_frame(a, FRAME_KIND_LOOP, outer)
19AF   3A CD 19               LDA   sendb_reg_a   
19B2   06 04                  MVI   b,FRAME_KIND_LOOP   
19B4   3A D2 19               LDA   sendb_block_outer   
19B7   4F                     MOV   c,a   
19B8   3A CD 19               LDA   sendb_reg_a   
19BB   CD 9C 17               CALL   push_frame   
19BE                             ; 
19BE                             ; 子 irep に切り替え
19BE   3A D1 19               LDA   sendb_block_irep   
19C1   CD 21 18               CALL   switch_irep   
19C4                             ; 
19C4                             ; PC = 0
19C4   21 00 00               LXI   h,0   
19C7   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
19CA   C3 78 1D               JMP   vm_loop   
19CD                             ; 
19CD                             ; OP_SENDB の一時変数
19CD   00           SENDB_REG_A:   DB   0   
19CE   00           SENDB_SYM_B:   DB   0   
19CF   00           SENDB_ARGC:   DB   0   
19D0   00           SENDB_METHOD_ID:   DB   0   
19D1   00           SENDB_BLOCK_IREP:   DB   0   
19D2   00           SENDB_BLOCK_OUTER:   DB   0   
19D3                             ; 
19D3                             ; ---------------------------------------------------------------
19D3                             ; OP_BREAK (B): ブロックから脱出
19D3                             ; 
19D3                             ; R[a] の値を R[0] にコピーして pop_frame。
19D3                             ; ---------------------------------------------------------------
19D3                DO_OP_BREAK:      
19D3   CD C0 10               CALL   fetch_byte   ; A = a
19D6                             ; R[a] → R[0] コピー
19D6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19D9   E5                     PUSH   h   ; R[a] アドレス退避
19DA   3E 00                  MVI   a,0   
19DC   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
19DF   EB                     XCHG      ; DE = R[0]
19E0   E1                     POP   h   ; HL = R[a]
19E1   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
19E4                             ; 
19E4   CD F7 17               CALL   pop_frame   
19E7   C3 78 1D               JMP   vm_loop   
19EA                             ; vm_upvar.a80 — 外側スコープの変数アクセス
19EA                             ; 
19EA                             ; OP_GETUPVAR, OP_SETUPVAR
19EA                             ; 
19EA                             ; ブロック内から外側のローカル変数にアクセスする。
19EA                             ; outer フレーム chain を level 段辿って reg_base を求める。
19EA                             ; 
19EA                             ; ---------------------------------------------------------------
19EA                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
19EA                             ; 
19EA                             ;   入力: A = level (何段外側か)
19EA                             ;   出力: HL = 外側スコープの reg_base アドレス
19EA                             ;   破壊: A, B, C, DE
19EA                             ; 
19EA                             ; outer chain を level 段辿る。FRAME_NONE に達したら
19EA                             ; REG_FILE_BASE (トップレベル) を返す。
19EA                             ; ---------------------------------------------------------------
19EA                UPVAR_BASE:      
19EA   47                     MOV   b,a   ; B = level (残り段数)
19EB                             ; まず現在のフレームの outer を読む
19EB   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
19EE   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
19EF   32 21 1A               STA   upvar_frame   
19F2                             ; 
19F2                             ; level == 0 なら outer chain を辿らずに
19F2                             ; 現在のフレームの return_reg_base をそのまま返す
19F2   78                     MOV   a,b   
19F3   B7                     ORA   a   
19F4   CA 0E 1A               JZ   upvar_found   
19F7                             ; 
19F7                UPVAR_LOOP:      
19F7                             ; outer フレーム番号を読む
19F7   3A 21 1A               LDA   upvar_frame   
19FA   CD 87 17               CALL   get_frame_addr   ; HL = フレームアドレス
19FD   11 0A 00               LXI   d,FRAME_OFF_OUTER   
1A00   19                     DAD   d   
1A01   7E                     MOV   a,m   ; A = outer frame 番号
1A02                             ; 
1A02   FE FF                  CPI   FRAME_NONE   
1A04   CA 1D 1A               JZ   upvar_toplevel   ; トップレベルに達した
1A07                             ; 
1A07   32 21 1A               STA   upvar_frame   ; 次のフレーム
1A0A                             ; 
1A0A   05                     DCR   b   
1A0B   C2 F7 19               JNZ   upvar_loop   ; まだ辿る段がある
1A0E                             ; 
1A0E                             ; level 回辿り終わった — upvar_frame の reg_base を返す
1A0E                UPVAR_FOUND:      
1A0E   3A 21 1A               LDA   upvar_frame   
1A11   CD 87 17               CALL   get_frame_addr   ; HL = フレームアドレス
1A14   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
1A17   19                     DAD   d   
1A18   5E                     MOV   e,m   
1A19   23                     INX   h   
1A1A   56                     MOV   d,m   ; DE = return_reg_base
1A1B   EB                     XCHG      ; HL = return_reg_base
1A1C   C9                     RET      
1A1D                             ; 
1A1D                UPVAR_TOPLEVEL:      
1A1D   21 00 81               LXI   h,REG_FILE_BASE   
1A20   C9                     RET      
1A21                             ; 
1A21   00           UPVAR_FRAME:   DB   0   
1A22                             ; 
1A22                             ; ---------------------------------------------------------------
1A22                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
1A22                             ; 
1A22                             ;   a = コピー先レジスタ
1A22                             ;   b = 外側スコープのレジスタ番号
1A22                             ;   c = level (何段外側か)
1A22                             ; ---------------------------------------------------------------
1A22                DO_OP_GETUPVAR:      
1A22   CD C0 10               CALL   fetch_byte   ; A = a
1A25   32 78 1A               STA   upvar_reg_a   
1A28   CD C0 10               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
1A2B   32 79 1A               STA   upvar_reg_b   
1A2E   CD C0 10               CALL   fetch_byte   ; A = c (level)
1A31                             ; 
1A31                             ; 外側の reg_base を求める
1A31   CD EA 19               CALL   upvar_base   ; HL = 外側の reg_base
1A34                             ; 
1A34                             ; 外側の R[b] のアドレス = base + b * 4
1A34   3A 79 1A               LDA   upvar_reg_b   
1A37   87                     ADD   a   ; ×2
1A38   87                     ADD   a   ; ×4
1A39   85                     ADD   l   
1A3A   6F                     MOV   l,a   
1A3B   3E 00                  MVI   a,0   
1A3D   8C                     ADC   h   
1A3E   67                     MOV   h,a   ; HL = 外側の R[b]
1A3F                             ; 
1A3F                             ; R[a] にコピー
1A3F   E5                     PUSH   h   ; コピー元退避
1A40   3A 78 1A               LDA   upvar_reg_a   
1A43   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A46   EB                     XCHG      ; DE = R[a] (コピー先)
1A47   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
1A48   CD 25 10               CALL   copy_slot   
1A4B   C3 78 1D               JMP   vm_loop   
1A4E                             ; 
1A4E                             ; ---------------------------------------------------------------
1A4E                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
1A4E                             ; 
1A4E                             ;   a = コピー元レジスタ
1A4E                             ;   b = 外側スコープのレジスタ番号
1A4E                             ;   c = level (何段外側か)
1A4E                             ; ---------------------------------------------------------------
1A4E                DO_OP_SETUPVAR:      
1A4E   CD C0 10               CALL   fetch_byte   ; A = a
1A51   32 78 1A               STA   upvar_reg_a   
1A54   CD C0 10               CALL   fetch_byte   ; A = b
1A57   32 79 1A               STA   upvar_reg_b   
1A5A   CD C0 10               CALL   fetch_byte   ; A = c (level)
1A5D                             ; 
1A5D                             ; 外側の reg_base を求める
1A5D   CD EA 19               CALL   upvar_base   ; HL = 外側の reg_base
1A60                             ; 
1A60                             ; 外側の R[b] のアドレス = base + b * 4
1A60   3A 79 1A               LDA   upvar_reg_b   
1A63   87                     ADD   a   
1A64   87                     ADD   a   
1A65   85                     ADD   l   
1A66   6F                     MOV   l,a   
1A67   3E 00                  MVI   a,0   
1A69   8C                     ADC   h   
1A6A   67                     MOV   h,a   ; HL = 外側の R[b]
1A6B   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
1A6C                             ; 
1A6C                             ; R[a] からコピー
1A6C   3A 78 1A               LDA   upvar_reg_a   
1A6F   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1A72   CD 25 10               CALL   copy_slot   
1A75   C3 78 1D               JMP   vm_loop   
1A78                             ; 
1A78   00           UPVAR_REG_A:   DB   0   
1A79   00           UPVAR_REG_B:   DB   0   
1A7A                             ; vm_class.a80 — クラス・メソッド定義オペコード
1A7A                             ; 
1A7A                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
1A7A                             ; 
1A7A                             ; ---------------------------------------------------------------
1A7A                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
1A7A                             ; 
1A7A                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
1A7A                             ; クラス本体内ではそのクラス (TT_CLASS)。
1A7A                             ; ---------------------------------------------------------------
1A7A                DO_OP_TCLASS:      
1A7A   CD C0 10               CALL   fetch_byte   ; A = a
1A7D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A80   EB                     XCHG      ; DE = R[a] (コピー先)
1A81   3E 00                  MVI   a,0   
1A83   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (コピー元)
1A86   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
1A89   C3 78 1D               JMP   vm_loop   
1A8C                             ; 
1A8C                             ; ---------------------------------------------------------------
1A8C                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
1A8C                             ; 
1A8C                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
1A8C                             ; ではないため、外側フレームへの参照を持たない)。
1A8C                             ; ---------------------------------------------------------------
1A8C                DO_OP_METHOD:      
1A8C   CD C0 10               CALL   fetch_byte   ; A = a
1A8F   32 AC 1A               STA   meth_reg_a   
1A92   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1A95   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1A98   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1A99                             ; 
1A99   3A AC 1A               LDA   meth_reg_a   
1A9C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A9F   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
1AA1   23                     INX   h   
1AA2   36 00                  MVI   m,0   ; +1: 予約
1AA4   23                     INX   h   
1AA5   71                     MOV   m,c   ; +2: val_lo = irep 番号
1AA6   23                     INX   h   
1AA7   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
1AA9   C3 78 1D               JMP   vm_loop   
1AAC                             ; 
1AAC   00           METH_REG_A:   DB   0   
1AAD                             ; 
1AAD                             ; ---------------------------------------------------------------
1AAD                             ; OP_DEF (BB): メソッド表に登録
1AAD                             ; 
1AAD                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
1AAD                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
1AAD                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
1AAD                             ; 
1AAD                             ; method_table[class_number * 32 + method_id] = irep 番号
1AAD                             ; ---------------------------------------------------------------
1AAD                DO_OP_DEF:      
1AAD   CD C0 10               CALL   fetch_byte   ; A = a
1AB0   32 11 1B               STA   def_reg_a   
1AB3   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1AB6                             ; 
1AB6                             ; シンボルテーブルから method_id を取得
1AB6   87                     ADD   a   ; ×2
1AB7   5F                     MOV   e,a   
1AB8   16 00                  MVI   d,0   
1ABA   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1ABD   19                     DAD   d   ; HL = &sym_table[b]
1ABE   5E                     MOV   e,m   ; E = method_id (下位)
1ABF   23                     INX   h   
1AC0   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
1AC1                             ; 種別チェックは省略 (バイトコードツールが保証)
1AC1                             ; 
1AC1                             ; method_id を退避
1AC1   7B                     MOV   a,e   
1AC2   32 12 1B               STA   def_method_id   
1AC5                             ; 
1AC5                             ; R[a] から class_number を取得
1AC5   3A 11 1B               LDA   def_reg_a   
1AC8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1ACB   CD 9B 10               CALL   class_of_reg   ; A = class_number
1ACE                             ; 
1ACE                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
1ACE                             ; A * 32
1ACE   87                     ADD   a   ; ×2
1ACF   87                     ADD   a   ; ×4
1AD0   87                     ADD   a   ; ×8
1AD1   87                     ADD   a   ; ×16
1AD2   87                     ADD   a   ; ×32
1AD3   5F                     MOV   e,a   
1AD4   16 00                  MVI   d,0   
1AD6   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1AD9   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
1ADA   3A 12 1B               LDA   def_method_id   
1ADD   5F                     MOV   e,a   
1ADE   16 00                  MVI   d,0   
1AE0   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
1AE1                             ; 
1AE1                             ; R[a+1].val_lo = irep 番号
1AE1   3A 11 1B               LDA   def_reg_a   
1AE4   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1AE7   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1AEA   7E                     MOV   a,m   ; A = val_lo = irep 番号
1AEB                             ; 
1AEB                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
1AEB   32 13 1B               STA   def_irep_num   
1AEE   3A 11 1B               LDA   def_reg_a   
1AF1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AF4   CD 9B 10               CALL   class_of_reg   ; A = class_number
1AF7   87                     ADD   a   
1AF8   87                     ADD   a   
1AF9   87                     ADD   a   
1AFA   87                     ADD   a   
1AFB   87                     ADD   a   ; A = class * 32
1AFC   5F                     MOV   e,a   
1AFD   16 00                  MVI   d,0   
1AFF   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1B02   19                     DAD   d   
1B03   3A 12 1B               LDA   def_method_id   
1B06   5F                     MOV   e,a   
1B07   16 00                  MVI   d,0   
1B09   19                     DAD   d   ; HL = メソッド表エントリ
1B0A   3A 13 1B               LDA   def_irep_num   
1B0D   77                     MOV   m,a   ; method_table[...] = irep 番号
1B0E   C3 78 1D               JMP   vm_loop   
1B11                             ; 
1B11   00           DEF_REG_A:   DB   0   
1B12   00           DEF_METHOD_ID:   DB   0   
1B13   00           DEF_IREP_NUM:   DB   0   
1B14                             ; 
1B14                             ; ---------------------------------------------------------------
1B14                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
1B14                             ; 
1B14                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
1B14                             ; ---------------------------------------------------------------
1B14                DO_OP_CLASS:      
1B14                             ; **クラス名と利用者の定数が同じ命令で来ます。** `Counter.new` の `Counter` も
1B14                             ; `LIMIT` も OP_GETCONST なので、シンボルテーブルの種別で分けます。
1B14                             ; ホスト側は `OP_CLASS` に出てきた名前だけをクラスとして登録するので、
1B14                             ; 残りは定数です (tools/i8080_bytecode_hex.rb)。
1B14                             ; 
1B14                             ; 定数はグローバル変数と同じ 4 バイトのスロットに置いてあるので、
1B14                             ; **写しは do_op_getgv の続き (getgv_ok) に合流させます。** 同じ並びを
1B14                             ; 2 か所に書くと、片方だけ直して食い違います。
1B14                DO_OP_GETCONST:      
1B14   CD C0 10               CALL   fetch_byte   ; A = a
1B17   F5                     PUSH   psw   
1B18   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1B1B                             ; 
1B1B                             ; シンボルテーブルのエントリを取る
1B1B   87                     ADD   a   ; ×2
1B1C   5F                     MOV   e,a   
1B1D   16 00                  MVI   d,0   
1B1F   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1B22   19                     DAD   d   ; HL = &sym_table[b]
1B23   5E                     MOV   e,m   
1B24   23                     INX   h   
1B25   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
1B26                             ; 
1B26   7A                     MOV   a,d   
1B27   FE 02                  CPI   SYM_KIND_CLASS   
1B29   CA 4B 1B               JZ   getconst_class   
1B2C   FE 04                  CPI   SYM_KIND_BUILTIN_CLASS   
1B2E   CA 3A 1B               JZ   getconst_builtin   
1B31                             ; 
1B31                             ; 利用者の定数。DE がグローバルスロットのアドレス
1B31   7A                     MOV   a,d   
1B32   B3                     ORA   e   
1B33   C2 EB 13               JNZ   getgv_ok   ; do_op_getgv の続きへ (a はスタックにある)
1B36   F1                     POP   psw   
1B37   C3 58 1D               JMP   vm_fail   ; クラスでも定数でもない
1B3A                             ; 
1B3A                             ; 組み込みクラス (Array / Hash)。**番号を置くだけ**
1B3A                             ; 
1B3A                             ; 利用者のクラスと別のタグにする。`new` で作るものが違い、
1B3A                             ; メソッド表の行も持たない
1B3A                GETCONST_BUILTIN:      
1B3A   F1                     POP   psw   ; A = a
1B3B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1B3E   36 0E                  MVI   m,TT_BUILTIN_CLASS   ; +0: 型タグ
1B40   23                     INX   h   
1B41   36 00                  MVI   m,0   ; +1: 予約
1B43   23                     INX   h   
1B44   73                     MOV   m,e   ; +2: val_lo = BUILTIN_CLASS_*
1B45   23                     INX   h   
1B46   36 00                  MVI   m,0   ; +3: val_hi = 0
1B48   C3 78 1D               JMP   vm_loop   
1B4B                             ; 
1B4B                GETCONST_CLASS:      
1B4B   F1                     POP   psw   ; A = a
1B4C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1B4F   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
1B51   23                     INX   h   
1B52   36 00                  MVI   m,0   ; +1: 予約
1B54   23                     INX   h   
1B55   73                     MOV   m,e   ; +2: val_lo = class_number
1B56   23                     INX   h   
1B57   36 00                  MVI   m,0   ; +3: val_hi = 0
1B59   C3 78 1D               JMP   vm_loop   
1B5C                             ; 
1B5C                             ; ---------------------------------------------------------------
1B5C                             ; OP_EXEC (BB): クラス本体を実行
1B5C                             ; 
1B5C                             ; push_frame して子 irep に切り替える。
1B5C                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
1B5C                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
1B5C                             ; ---------------------------------------------------------------
1B5C                DO_OP_EXEC:      
1B5C   CD C0 10               CALL   fetch_byte   ; A = a
1B5F   32 84 1B               STA   exec_reg_a   
1B62   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1B65   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1B68   32 85 1B               STA   exec_irep   
1B6B                             ; 
1B6B                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
1B6B   3A 84 1B               LDA   exec_reg_a   
1B6E   06 00                  MVI   b,FRAME_KIND_CALL   
1B70   0E FF                  MVI   c,FRAME_NONE   
1B72   CD 9C 17               CALL   push_frame   
1B75                             ; 
1B75                             ; 子 irep に切り替え
1B75   3A 85 1B               LDA   exec_irep   
1B78   CD 21 18               CALL   switch_irep   
1B7B                             ; 
1B7B                             ; PC = 0
1B7B   21 00 00               LXI   h,0   
1B7E   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1B81   C3 78 1D               JMP   vm_loop   
1B84                             ; 
1B84   00           EXEC_REG_A:   DB   0   
1B85   00           EXEC_IREP:   DB   0   
1B86                             ; vm_display.a80 — 7 セグメント表示
1B86                             ; 
1B86                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
1B86                             ; 上位 4 桁はブランク（消灯）にする。
1B86                             ; セグメントパターンは seg_table にまとめる。
1B86                             ; 
1B86                             ; ---------------------------------------------------------------
1B86                             ; display_hex16 — 16 ビット値を 7 セグに表示
1B86                             ; 
1B86                             ;   入力: HL = 値の先頭 (val_lo の位置)
1B86                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
1B86                             ;   破壊: A, B, C, HL, DE
1B86                             ; 
1B86                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
1B86                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
1B86                             ; ---------------------------------------------------------------
1B86                DISPLAY_HEX16:      
1B86   E5                     PUSH   h   ; 値のアドレスを退避
1B87                             ; 上位 4 桁をブランク (消灯) にする
1B87   11 F8 FF               LXI   d,DISPLAY_BASE   
1B8A   AF                     XRA   a   ; A = 0 (全セグメント消灯)
1B8B   12                     STAX   d   
1B8C   13                     INX   d   
1B8D   12                     STAX   d   
1B8E   13                     INX   d   
1B8F   12                     STAX   d   
1B90   13                     INX   d   
1B91   12                     STAX   d   
1B92   13                     INX   d   ; DE = DISPLAY_BASE + 4
1B93                             ; 値の byte1 (val_hi) から表示
1B93   E1                     POP   h   ; HL = val_lo
1B94   23                     INX   h   ; HL = val_hi
1B95   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
1B97                DISPLAY_BYTE_LOOP:      
1B97                             ; 上位ニブル
1B97   7E                     MOV   a,m   
1B98   0F                     RRC      
1B99   0F                     RRC      
1B9A   0F                     RRC      
1B9B   0F                     RRC      
1B9C   E6 0F                  ANI   0Fh   
1B9E   CD B1 1B               CALL   nibble_to_seg   
1BA1   12                     STAX   d   
1BA2   13                     INX   d   
1BA3                             ; 下位ニブル
1BA3   7E                     MOV   a,m   
1BA4   E6 0F                  ANI   0Fh   
1BA6   CD B1 1B               CALL   nibble_to_seg   
1BA9   12                     STAX   d   
1BAA   13                     INX   d   
1BAB                             ; 次のバイト (val_hi → val_lo)
1BAB   2B                     DCX   h   
1BAC   0D                     DCR   c   
1BAD   C2 97 1B               JNZ   display_byte_loop   
1BB0   C9                     RET      
1BB1                             ; 
1BB1                             ; ---------------------------------------------------------------
1BB1                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
1BB1                             ; 
1BB1                             ;   入力: A = 0-F
1BB1                             ;   出力: A = セグメントパターン
1BB1                             ;   破壊: なし (HL, BC は内部で退避・復元)
1BB1                             ; ---------------------------------------------------------------
1BB1                NIBBLE_TO_SEG:      
1BB1   E5                     PUSH   h   
1BB2   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
1BB3   6F                     MOV   l,a   
1BB4   26 00                  MVI   h,0   
1BB6   01 BE 1B               LXI   b,seg_table   
1BB9   09                     DAD   b   ; HL = seg_table + nibble
1BBA   7E                     MOV   a,m   
1BBB   C1                     POP   b   ; BC を復元
1BBC   E1                     POP   h   
1BBD   C9                     RET      
1BBE                             ; 
1BBE                             ; ---------------------------------------------------------------
1BBE                             ; 7 セグメントパターンテーブル
1BBE                             ; 
1BBE                             ;   bit 0 = a (上)
1BBE                             ;   bit 1 = b (右上)
1BBE                             ;   bit 2 = c (右下)
1BBE                             ;   bit 3 = d (下)
1BBE                             ;   bit 4 = e (左下)
1BBE                             ;   bit 5 = f (左上)
1BBE                             ;   bit 6 = g (中)
1BBE                             ; 
1BBE                             ;       aaa
1BBE                             ;      f   b
1BBE                             ;       ggg
1BBE                             ;      e   c
1BBE                             ;       ddd
1BBE                             ; ---------------------------------------------------------------
1BBE                SEG_TABLE:      
1BBE   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
1BBF   06                     DB   06h   ; 1
1BC0   5B                     DB   5Bh   ; 2
1BC1   4F                     DB   4Fh   ; 3
1BC2   66                     DB   66h   ; 4
1BC3   6D                     DB   6Dh   ; 5
1BC4   7D                     DB   7Dh   ; 6
1BC5   27                     DB   27h   ; 7  (ND8080 ROM パターン)
1BC6   7F                     DB   7Fh   ; 8
1BC7   6F                     DB   6Fh   ; 9
1BC8   77                     DB   77h   ; A
1BC9   7C                     DB   7Ch   ; b
1BCA   39                     DB   39h   ; C
1BCB   5E                     DB   5Eh   ; d
1BCC   79                     DB   79h   ; E
1BCD   71                     DB   71h   ; F
1BCE                             ; 
1BCE                             ; ===============================================================
1BCE                             ; OP_RETURN (B): フレーム種別に応じて復帰
1BCE                             ; 
1BCE                             ; frame_sp == 0 → トップレベル: 表示して停止
1BCE                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
1BCE                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
1BCE                             ; それ以外 (反復のフレーム) → ブロック内: advance_iteration
1BCE                             ; ===============================================================
1BCE                DO_OP_RETURN:      
1BCE   CD C0 10               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
1BD1   32 21 1C               STA   return_reg_a   
1BD4                             ; 
1BD4                             ; フレームスタックが空ならトップレベル
1BD4   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1BD7   B7                     ORA   a   
1BD8   CA 0D 1C               JZ   do_op_return_top   
1BDB                             ; 
1BDB                             ; フレーム種別を確認
1BDB   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム
1BDE   11 05 00               LXI   d,FRAME_OFF_KIND   
1BE1   19                     DAD   d   
1BE2   7E                     MOV   a,m   ; A = kind
1BE3   FE 00                  CPI   FRAME_KIND_CALL   
1BE5   CA F0 1B               JZ   return_call   
1BE8   FE 05                  CPI   FRAME_KIND_NEW   
1BEA   CA 07 1C               JZ   return_new   
1BED                             ; 反復のフレーム (ITERATE / EACH / HASH_EACH / LOOP)
1BED   C3 22 1C               JMP   advance_iteration   
1BF0                             ; 
1BF0                RETURN_CALL:      
1BF0                             ; R[a] の値を R[0] にコピー
1BF0   3A 21 1C               LDA   return_reg_a   
1BF3   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1BF6   E5                     PUSH   h   
1BF7   3E 00                  MVI   a,0   
1BF9   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1BFC   EB                     XCHG      ; DE = R[0] (コピー先)
1BFD   E1                     POP   h   ; HL = R[a] (コピー元)
1BFE   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
1C01   CD F7 17               CALL   pop_frame   
1C04   C3 78 1D               JMP   vm_loop   
1C07                             ; 
1C07                RETURN_NEW:      
1C07                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
1C07   CD F7 17               CALL   pop_frame   
1C0A   C3 78 1D               JMP   vm_loop   
1C0D                             ; 
1C0D                DO_OP_RETURN_TOP:      
1C0D   3A 21 1C               LDA   return_reg_a   
1C10   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1C13   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1C16   CD 86 1B               CALL   display_hex16   
1C19   3E 02                  MVI   a,VM_FINISHED   
1C1B   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1C1E   C3 66 1D               JMP   vm_halt   
1C21                             ; 
1C21   00           RETURN_REG_A:   DB   0   
1C22                             ; 
1C22                             ; ===============================================================
1C22                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
1C22                             ; 
1C22                             ; ITERATE (times / upto): index++ して limit と比較。超えたら pop_frame。
1C22                             ; EACH / HASH_EACH: 同じ数え方で、ブロックに渡す値だけが違う。
1C22                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
1C22                             ; ===============================================================
1C22                ADVANCE_ITERATION:      
1C22                             ; フレーム種別を確認
1C22   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム
1C25   11 05 00               LXI   d,FRAME_OFF_KIND   
1C28   19                     DAD   d   
1C29   7E                     MOV   a,m   ; A = kind
1C2A   FE 04                  CPI   FRAME_KIND_LOOP   
1C2C   CA 86 1C               JZ   adv_reenter   ; loop → 常に再実行
1C2F   32 98 1C               STA   adv_kind   ; kind を退避
1C32                             ; 
1C32                             ; **Array.new はブロックの値をその回の要素へ書く**
1C32   CD 99 1C               CALL   array_fill_element   
1C35                             ; 
1C35                             ; **述語はここでブロックの値を見る。** 打ち切るなら R[0] に答えが入る
1C35   CD CD 1C               CALL   predicate_decision   
1C38   B7                     ORA   a   
1C39   C2 92 1C               JNZ   adv_stopped   
1C3C                             ; 
1C3C                             ; --- 反復に共通: index インクリメント + limit チェック ---
1C3C   CD 95 17               CALL   cur_frame_addr   
1C3F   11 06 00               LXI   d,FRAME_OFF_INDEX   
1C42   19                     DAD   d   
1C43   4E                     MOV   c,m   ; C = index_lo
1C44   23                     INX   h   
1C45   46                     MOV   b,m   ; B = index_hi
1C46   03                     INX   b   ; BC = index + 1
1C47                             ; 書き戻す
1C47   70                     MOV   m,b   ; index_hi
1C48   2B                     DCX   h   
1C49   71                     MOV   m,c   ; index_lo
1C4A                             ; 
1C4A                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
1C4A   23                     INX   h   ; → &index_hi
1C4B   23                     INX   h   ; → &limit_lo
1C4C   5E                     MOV   e,m   ; E = limit_lo
1C4D   23                     INX   h   ; → &limit_hi
1C4E   56                     MOV   d,m   ; D = limit_hi
1C4F                             ; 
1C4F                             ; BC = new index, DE = limit
1C4F                             ; index > limit なら反復終了 (DE - BC でボロー発生)
1C4F   7B                     MOV   a,e   
1C50   91                     SUB   c   
1C51   7A                     MOV   a,d   
1C52   98                     SBB   b   
1C53   DA 8F 1C               JC   adv_done   ; index > limit → 反復終了
1C56                             ; 
1C56                             ; kind で R[1] の設定を分岐
1C56                             ; 添字を渡すのは ITERATE (times / upto) と ARRAY_FILL。
1C56                             ; **Array.new は R[0] が配列なので、種別で見分けないといけない** —
1C56                             ; コレクションの枝に落ちると要素を渡してしまう
1C56   3A 98 1C               LDA   adv_kind   
1C59   FE 01                  CPI   FRAME_KIND_ITERATE   
1C5B   CA 63 1C               JZ   adv_index_load   
1C5E   FE 09                  CPI   FRAME_KIND_ARRAY_FILL   
1C60   C2 6E 1C               JNZ   adv_each_load   
1C63                ADV_INDEX_LOAD:      
1C63                             ; 
1C63                             ; --- ITERATE (times): R[1] = index ---
1C63   3E 01                  MVI   a,1   
1C65   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
1C68   CD 10 10               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
1C6B   C3 86 1C               JMP   adv_reenter   
1C6E                             ; 
1C6E                             ; --- EACH / HASH_EACH: ブロックの引数を入れ直す ---
1C6E                             ; 
1C6E                             ; **値の出し方は sendb_each と同じものを呼びます。** 配列なら要素、
1C6E                             ; ハッシュなら鍵と値で、分けているのは each_block_args の中だけです。
1C6E                ADV_EACH_LOAD:      
1C6E                             ; BC = index のうち下位バイトだけ使う (配列 8 要素・ハッシュ 4 ペアまで)
1C6E   79                     MOV   a,c   
1C6F   32 55 2C               STA   each_index   
1C72   3A 98 1C               LDA   adv_kind   
1C75   32 54 2C               STA   each_arg_kind   
1C78                             ; フレーム +11 からコレクションスロット番号を読む
1C78   CD 95 17               CALL   cur_frame_addr   ; BC を破壊するが、添字は退避済み
1C7B   11 0B 00               LXI   d,11   
1C7E   19                     DAD   d   
1C7F   7E                     MOV   a,m   ; A = col_slot
1C80   32 52 2C               STA   each_col_slot   
1C83   CD FE 2B               CALL   each_block_args   
1C86                             ; 
1C86                ADV_REENTER:      
1C86                             ; PC = 0 で再実行
1C86   21 00 00               LXI   h,0   
1C89   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1C8C   C3 78 1D               JMP   vm_loop   
1C8F                             ; 
1C8F                ADV_DONE:      
1C8F                             ; 反復完了 → フレームを破棄して親に戻る
1C8F                             ; **述語だけは R[0] を答えに書き換える** (止まったときの逆)
1C8F   CD 1C 1D               CALL   predicate_exhausted   
1C92                ADV_STOPPED:      
1C92                             ; 打ち切り。R[0] には predicate_decision が答えを書いてある
1C92   CD F7 17               CALL   pop_frame   
1C95   C3 78 1D               JMP   vm_loop   
1C98                             ; 
1C98   00           ADV_KIND:   DB   0   
1C99                             ; 
1C99                             ; ===============================================================
1C99                             ; array_fill_element — ブロックの値をその回の要素へ書く
1C99                             ; 
1C99                             ;   入力: adv_kind / return_reg_a / フレーム (+11 = col_slot, INDEX = 添字)
1C99                             ; 
1C99                             ; **添字は増やす前のもの。** いま終わった回の位置に書く。
1C99                             ; Array.new 以外では何もしない。
1C99                             ; ===============================================================
1C99                ARRAY_FILL_ELEMENT:      
1C99   3A 98 1C               LDA   adv_kind   
1C9C   FE 09                  CPI   FRAME_KIND_ARRAY_FILL   
1C9E   C0                     RNZ      
1C9F                             ; 
1C9F                             ; 書き先 = スロットのデータ領域 + 添字 * 4
1C9F   CD 95 17               CALL   cur_frame_addr   
1CA2   11 0B 00               LXI   d,11   
1CA5   19                     DAD   d   
1CA6   7E                     MOV   a,m   ; A = col_slot
1CA7   CD A9 21               CALL   col_slot_addr   
1CAA   23                     INX   h   ; skip type
1CAB   23                     INX   h   ; skip count → データ領域
1CAC   22 CB 1C               SHLD   afe_data   
1CAF   CD 95 17               CALL   cur_frame_addr   
1CB2   11 06 00               LXI   d,FRAME_OFF_INDEX   
1CB5   19                     DAD   d   
1CB6   7E                     MOV   a,m   ; A = 添字 (下位バイト。8 要素までなので足りる)
1CB7   87                     ADD   a   ; ×2
1CB8   87                     ADD   a   ; ×4
1CB9   5F                     MOV   e,a   
1CBA   16 00                  MVI   d,0   
1CBC   2A CB 1C               LHLD   afe_data   
1CBF   19                     DAD   d   ; HL = 書き先
1CC0   EB                     XCHG      ; DE = 書き先
1CC1                             ; 
1CC1                             ; ブロックの戻り値を写す
1CC1   3A 21 1C               LDA   return_reg_a   
1CC4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1CC7   CD 25 10               CALL   copy_slot   
1CCA   C9                     RET      
1CCB                             ; 
1CCB   00 00        AFE_DATA:   DW   0   
1CCD                             ; 
1CCD                             ; ===============================================================
1CCD                             ; predicate_decision — ブロックの値を見て打ち切るか決める
1CCD                             ; 
1CCD                             ;   入力: adv_kind (フレーム種別) / return_reg_a (ブロックの戻り値)
1CCD                             ;   出力: A = 1 なら打ち切った (R[0] に答えを書いた)、0 なら続ける
1CCD                             ; 
1CCD                             ; **R[0] を潰してよい。** もう要素を取り出さないので、レシーバの場所が
1CCD                             ; そのまま答えの置き場になる (呼んだ側の R[a] と同じ場所)。
1CCD                             ; 
1CCD                             ;   any?  真で止まって true、尽きたら false
1CCD                             ;   all?  偽で止まって false、尽きたら true
1CCD                             ;   none? 真で止まって false、尽きたら true
1CCD                             ; ===============================================================
1CCD                PREDICATE_DECISION:      
1CCD   3A 98 1C               LDA   adv_kind   
1CD0   FE 06                  CPI   FRAME_KIND_ANY   
1CD2   DA 19 1D               JC   pd_continue   ; ANY 未満 → 述語ではない
1CD5                             ; **上限も見る。** ARRAY_FILL は ANY より上だがブロックの値の使い方が
1CD5                             ; 違う。上限を見ないと none? として扱われ、1 回目で打ち切ってしまう
1CD5   FE 09                  CPI   FRAME_KIND_NONE + 1   
1CD7   D2 19 1D               JNC   pd_continue   
1CDA                             ; 
1CDA                             ; ブロックの戻り値の型タグ。TT_FALSE 以下が偽 (nil / false)
1CDA   3A 21 1C               LDA   return_reg_a   
1CDD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1CE0   7E                     MOV   a,m   ; A = 型タグ
1CE1   FE 03                  CPI   TT_FALSE + 1   
1CE3   DA F6 1C               JC   pd_falsy   
1CE6                             ; 
1CE6                             ; --- 真だった ---
1CE6   3A 98 1C               LDA   adv_kind   
1CE9   FE 07                  CPI   FRAME_KIND_ALL   
1CEB   CA 19 1D               JZ   pd_continue   ; all? は真では止まらない
1CEE   FE 06                  CPI   FRAME_KIND_ANY   
1CF0   CA 01 1D               JZ   pd_stop_true   ; any? → true
1CF3   C3 06 1D               JMP   pd_stop_false   ; none? → false
1CF6                             ; 
1CF6                             ; --- 偽だった ---
1CF6                PD_FALSY:      
1CF6   3A 98 1C               LDA   adv_kind   
1CF9   FE 07                  CPI   FRAME_KIND_ALL   
1CFB   C2 19 1D               JNZ   pd_continue   ; any? / none? は偽では止まらない
1CFE   C3 06 1D               JMP   pd_stop_false   ; all? → false
1D01                             ; 
1D01                PD_STOP_TRUE:      
1D01   3E 03                  MVI   a,TT_TRUE   
1D03   C3 08 1D               JMP   pd_write   
1D06                PD_STOP_FALSE:      
1D06   3E 02                  MVI   a,TT_FALSE   
1D08                PD_WRITE:      
1D08   32 1B 1D               STA   pd_tag   
1D0B   3E 00                  MVI   a,0   
1D0D   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1D10   3A 1B 1D               LDA   pd_tag   
1D13   CD 1A 10               CALL   set_slot_special   
1D16   3E 01                  MVI   a,1   ; 打ち切った
1D18   C9                     RET      
1D19                             ; 
1D19                PD_CONTINUE:      
1D19   AF                     XRA   a   
1D1A   C9                     RET      
1D1B                             ; 
1D1B   00           PD_TAG:   DB   0   
1D1C                             ; 
1D1C                             ; ===============================================================
1D1C                             ; predicate_exhausted — 最後まで打ち切られなかったときの答え
1D1C                             ; 
1D1C                             ; **止まったときの逆**です。any? は false、all? と none? は true。
1D1C                             ; 述語でなければ何もしません (R[0] のレシーバがそのまま値になる)。
1D1C                             ; ===============================================================
1D1C                PREDICATE_EXHAUSTED:      
1D1C   3A 98 1C               LDA   adv_kind   
1D1F   FE 06                  CPI   FRAME_KIND_ANY   
1D21   DA 43 1D               JC   pe_ret   ; 述語ではない
1D24   FE 09                  CPI   FRAME_KIND_NONE + 1   
1D26   D2 43 1D               JNC   pe_ret   ; ARRAY_FILL は答えを書かない (R[0] は配列)
1D29   FE 06                  CPI   FRAME_KIND_ANY   
1D2B   CA 33 1D               JZ   pe_false   ; any? → 尽きたら false
1D2E   3E 03                  MVI   a,TT_TRUE   ; all? / none? → 尽きたら true
1D30   C3 35 1D               JMP   pe_write   
1D33                PE_FALSE:      
1D33   3E 02                  MVI   a,TT_FALSE   
1D35                PE_WRITE:      
1D35   32 44 1D               STA   pe_tag   
1D38   3E 00                  MVI   a,0   
1D3A   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1D3D   3A 44 1D               LDA   pe_tag   
1D40   CD 1A 10               CALL   set_slot_special   
1D43                PE_RET:      
1D43   C9                     RET      
1D44                             ; 
1D44   00           PE_TAG:   DB   0   
1D45                             ; 
1D45                             ; ===============================================================
1D45                             ; OP_STOP (Z): VM 停止
1D45                             ; ===============================================================
1D45                DO_OP_STOP:      
1D45   3E 02                  MVI   a,VM_FINISHED   
1D47   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D4A                             ; R[1] の値を 7 セグに表示
1D4A   3E 01                  MVI   a,1   
1D4C   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1D4F   CD 32 10               CALL   slot_to_value   ; HL = R[1] の値先頭
1D52   CD 86 1B               CALL   display_hex16   
1D55   C3 66 1D               JMP   vm_halt   
1D58                             ; 
1D58                             ; ===============================================================
1D58                             ; エラー停止
1D58                             ; 
1D58                             ; 未対応のオペコードを踏んだとき。
1D58                             ; 現在のオペコードをエラーコードとして保存する。
1D58                             ; ===============================================================
1D58                VM_FAIL:      
1D58   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1D5B   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
1D5E   3E 03                  MVI   a,VM_ERROR   
1D60   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D63   C3 66 1D               JMP   vm_halt   
1D66                             ; 
1D66                             ; ===============================================================
1D66                             ; 停止 — ND80Z モニタのリモートモードへ復帰
1D66                             ; 
1D66                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
1D66                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
1D66                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
1D66                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
1D66                             ; これにより自動的にリモートモードへ復帰する。
1D66                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
1D66                             ; ===============================================================
1D66                VM_HALT:      
1D66                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
1D66                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
1D66                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
1D66   06 04                  MVI   b,4   
1D68                VM_HALT_OUTER:      
1D68   11 00 00               LXI   d,0   
1D6B                VM_HALT_INNER:      
1D6B   1B                     DCX   d   
1D6C   7A                     MOV   a,d   
1D6D   B3                     ORA   e   
1D6E   C2 6B 1D               JNZ   vm_halt_inner   
1D71   05                     DCR   b   
1D72   C2 68 1D               JNZ   vm_halt_outer   
1D75   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
1D78                             ; 
1D78                             ; ===============================================================
1D78                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
1D78                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
1D78                             ; ===============================================================
1D78                             ; 
1D78                             ; ===============================================================
1D78                             ; メインループ (fetch-decode-execute)
1D78                             ; ===============================================================
1D78                VM_LOOP:      
1D78                             ; --- 実行状態の確認 ---
1D78   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
1D7B   FE 01                  CPI   VM_RUNNING   
1D7D   C2 66 1D               JNZ   vm_halt   
1D80                             ; 
1D80                             ; --- PC がバイトコード長を超えていないか ---
1D80   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
1D83   EB                     XCHG      ; DE = PC
1D84   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
1D87                             ; HL = bytecode_len, DE = PC
1D87                             ; PC >= bytecode_len ならエラー
1D87   7B                     MOV   a,e   
1D88   95                     SUB   l   
1D89   7A                     MOV   a,d   
1D8A   9C                     SBB   h   ; DE - HL (PC - len)
1D8B   D2 58 1D               JNC   vm_fail   ; PC >= len → エラー
1D8E                             ; 
1D8E                             ; --- オペコードフェッチ ---
1D8E   CD C0 10               CALL   fetch_byte   ; A = opcode
1D91   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1D94                             ; 
1D94                             ; --- ステップカウント ---
1D94   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1D97   23                     INX   h   
1D98   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1D9B                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
1D9B   7C                     MOV   a,h   
1D9C   B5                     ORA   l   
1D9D   C2 A7 1D               JNZ   vm_dispatch   
1DA0   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1DA3   23                     INX   h   
1DA4   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1DA7                             ; 
1DA7                             ; --- ディスパッチ ---
1DA7                VM_DISPATCH:      
1DA7   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1DAA                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
1DAA   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
1DAB   DA 58 1D               JC   vm_fail   ; オーバーフロー → 未対応
1DAE   5F                     MOV   e,a   
1DAF   16 00                  MVI   d,0   ; DE = opcode * 2
1DB1   21 C9 1D               LXI   h,dispatch_table   
1DB4   19                     DAD   d   ; HL = &dispatch_table[opcode]
1DB5                             ; テーブル上限チェック
1DB5   11 9D 1E               LXI   d,dispatch_table_end   
1DB8   7B                     MOV   a,e   
1DB9   95                     SUB   l   
1DBA   7A                     MOV   a,d   
1DBB   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
1DBC   DA 58 1D               JC   vm_fail   ; テーブル範囲外
1DBF                             ; アドレスを読んでジャンプ
1DBF   5E                     MOV   e,m   ; E = 下位バイト
1DC0   23                     INX   h   
1DC1   56                     MOV   d,m   ; D = 上位バイト
1DC2   EB                     XCHG      ; HL = ハンドラアドレス
1DC3                             ; 0000h ならエラー (未実装マーカー)
1DC3   7C                     MOV   a,h   
1DC4   B5                     ORA   l   
1DC5   CA 58 1D               JZ   vm_fail   
1DC8   E9                     PCHL      ; ハンドラへジャンプ
1DC9                             ; 
1DC9                             ; ===============================================================
1DC9                             ; ディスパッチテーブル
1DC9                             ; 
1DC9                             ; オペコード番号順に 2 バイトのアドレスを並べる。
1DC9                             ; 未実装のオペコードは 0000h (vm_fail で捕捉)。
1DC9                             ; ===============================================================
1DC9                DISPATCH_TABLE:      
1DC9   DE 10                  DW   do_op_nop   ; 00 OP_NOP
1DCB   E1 10                  DW   do_op_move   ; 01 OP_MOVE
1DCD   00 00                  DW   0000h   ; 02 OP_LOADL
1DCF   F7 10                  DW   do_op_loadi   ; 03 OP_LOADI
1DD1   0C 11                  DW   do_op_loadineg   ; 04 OP_LOADINEG
1DD3   23 11                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
1DD5   33 11                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
1DD7   38 11                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
1DD9   3D 11                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
1DDB   42 11                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
1DDD   47 11                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
1DDF   4C 11                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
1DE1   51 11                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
1DE3   56 11                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
1DE5   66 11                  DW   do_op_loadi16   ; 0E OP_LOADI16
1DE7   00 00                  DW   0000h   ; 0F OP_LOADI32
1DE9   00 00                  DW   0000h   ; 10 OP_LOADSYM
1DEB   7F 11                  DW   do_op_loadnil   ; 11 OP_LOADNIL
1DED   61 18                  DW   do_op_loadself   ; 12 OP_LOADSELF
1DEF   8D 11                  DW   do_op_loadt   ; 13 OP_LOADT
1DF1   9B 11                  DW   do_op_loadf   ; 14 OP_LOADF
1DF3   CA 13                  DW   do_op_getgv   ; 15 OP_GETGV
1DF5   0C 14                  DW   do_op_setgv   ; 16 OP_SETGV
1DF7   00 00                  DW   0000h   ; 17 OP_GETSV
1DF9   00 00                  DW   0000h   ; 18 OP_SETSV
1DFB   CA 13                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
1DFD   0C 14                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
1DFF   CA 13                  DW   do_op_getgv   ; 1B OP_GETCV (= OP_GETGV)
1E01   0C 14                  DW   do_op_setgv   ; 1C OP_SETCV (= OP_SETGV)
1E03   14 1B                  DW   do_op_getconst   ; 1D OP_GETCONST
1E05   0C 14                  DW   do_op_setgv   ; 1E OP_SETCONST (= OP_SETGV)
1E07   00 00                  DW   0000h   ; 1F OP_GETMCNST
1E09   00 00                  DW   0000h   ; 20 OP_SETMCNST
1E0B   22 1A                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
1E0D   4E 1A                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
1E0F   D6 21                  DW   do_op_getidx   ; 23 OP_GETIDX
1E11   7D 22                  DW   do_op_setidx   ; 24 OP_SETIDX
1E13   83 13                  DW   do_op_jmp   ; 25 OP_JMP
1E15   8C 13                  DW   do_op_jmpif   ; 26 OP_JMPIF
1E17   AB 13                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
1E19   00 00                  DW   0000h   ; 28 OP_JMPNIL
1E1B   83 13                  DW   do_op_jmp   ; 29 OP_JMPUW (= OP_JMP)
1E1D   00 00                  DW   0000h   ; 2A OP_EXCEPT
1E1F   00 00                  DW   0000h   ; 2B OP_RESCUE
1E21   00 00                  DW   0000h   ; 2C OP_RAISEIF
1E23   6D 14                  DW   do_op_ssend   ; 2D OP_SSEND
1E25   AE 18                  DW   do_op_ssendb   ; 2E OP_SSENDB
1E27   8E 14                  DW   do_op_send   ; 2F OP_SEND
1E29   D4 18                  DW   do_op_sendb   ; 30 OP_SENDB
1E2B   00 00                  DW   0000h   ; 31 OP_CALL
1E2D   00 00                  DW   0000h   ; 32 OP_SUPER
1E2F   00 00                  DW   0000h   ; 33 OP_ARGARY
1E31   A2 18                  DW   do_op_enter   ; 34 OP_ENTER
1E33   00 00                  DW   0000h   ; 35 OP_KEY_P
1E35   00 00                  DW   0000h   ; 36 OP_KEYEND
1E37   00 00                  DW   0000h   ; 37 OP_KARG
1E39   CE 1B                  DW   do_op_return   ; 38 OP_RETURN
1E3B   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
1E3D   D3 19                  DW   do_op_break   ; 3A OP_BREAK
1E3F   00 00                  DW   0000h   ; 3B OP_BLKPUSH
1E41   A9 11                  DW   do_op_add   ; 3C OP_ADD
1E43   EB 11                  DW   do_op_addi   ; 3D OP_ADDI
1E45   D3 11                  DW   do_op_sub   ; 3E OP_SUB
1E47   05 12                  DW   do_op_subi   ; 3F OP_SUBI
1E49   1F 12                  DW   do_op_mul   ; 40 OP_MUL
1E4B   43 12                  DW   do_op_div   ; 41 OP_DIV
1E4D   22 13                  DW   do_op_eq   ; 42 OP_EQ
1E4F   4C 13                  DW   do_op_lt   ; 43 OP_LT
1E51   56 13                  DW   do_op_le   ; 44 OP_LE
1E53   63 13                  DW   do_op_gt   ; 45 OP_GT
1E55   70 13                  DW   do_op_ge   ; 46 OP_GE
1E57   33 23                  DW   do_op_array   ; 47 OP_ARRAY
1E59   AD 25                  DW   do_op_array2   ; 48 OP_ARRAY2
1E5B   00 00                  DW   0000h   ; 49 OP_ARYCAT
1E5D   AF 23                  DW   do_op_arypush   ; 4A OP_ARYPUSH
1E5F   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
1E61   00 00                  DW   0000h   ; 4C OP_AREF
1E63   00 00                  DW   0000h   ; 4D OP_ASET
1E65   00 00                  DW   0000h   ; 4E OP_APOST
1E67   00 00                  DW   0000h   ; 4F OP_INTERN
1E69   00 00                  DW   0000h   ; 50 OP_SYMBOL
1E6B   25 1F                  DW   do_op_string   ; 51 OP_STRING
1E6D   27 24                  DW   do_op_strcat   ; 52 OP_STRCAT
1E6F   BF 25                  DW   do_op_hash   ; 53 OP_HASH
1E71   00 00                  DW   0000h   ; 54 OP_HASHADD
1E73   00 00                  DW   0000h   ; 55 OP_HASHCAT
1E75   00 00                  DW   0000h   ; 56 OP_LAMBDA
1E77   75 18                  DW   do_op_block   ; 57 OP_BLOCK
1E79   8C 1A                  DW   do_op_method   ; 58 OP_METHOD
1E7B   00 00                  DW   0000h   ; 59 OP_RANGE_INC
1E7D   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
1E7F   00 00                  DW   0000h   ; 5B OP_OCLASS
1E81   14 1B                  DW   do_op_class   ; 5C OP_CLASS
1E83   00 00                  DW   0000h   ; 5D OP_MODULE
1E85   5C 1B                  DW   do_op_exec   ; 5E OP_EXEC
1E87   AD 1A                  DW   do_op_def   ; 5F OP_DEF
1E89   00 00                  DW   0000h   ; 60 OP_ALIAS
1E8B   00 00                  DW   0000h   ; 61 OP_UNDEF
1E8D   00 00                  DW   0000h   ; 62 OP_SCLASS
1E8F   7A 1A                  DW   do_op_tclass   ; 63 OP_TCLASS
1E91   00 00                  DW   0000h   ; 64 OP_DEBUG
1E93   00 00                  DW   0000h   ; 65 OP_ERR
1E95   00 00                  DW   0000h   ; 66 OP_EXT1
1E97   00 00                  DW   0000h   ; 67 OP_EXT2
1E99   00 00                  DW   0000h   ; 68 OP_EXT3
1E9B   45 1D                  DW   do_op_stop   ; 69 OP_STOP
1E9D                DISPATCH_TABLE_END:      
1E9D                             ; 
1E9D                             ; ===============================================================
1E9D                             ; clear_pages — B ページ (256 バイト × B) をゼロクリア
1E9D                             ; 
1E9D                             ; 入力: HL = 先頭アドレス, B = ページ数
1E9D                             ; 破壊: A, B, C, HL
1E9D                             ; ===============================================================
1E9D                CLEAR_PAGES:      
1E9D   0E 00                  MVI   c,0   ; 256 回
1E9F                CLEAR_PAGES_BYTE:      
1E9F   36 00                  MVI   m,0   
1EA1   23                     INX   h   
1EA2   0D                     DCR   c   
1EA3   C2 9F 1E               JNZ   clear_pages_byte   
1EA6   05                     DCR   b   
1EA7   C2 9D 1E               JNZ   clear_pages   
1EAA   C9                     RET      
1EAB                             ; 
1EAB                             ; ===============================================================
1EAB                             ; 初期化 (起動時 1 回だけ)
1EAB                             ; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
1EAB                             ; ===============================================================
1EAB                VM_START:      
1EAB                             ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
1EAB   21 00 80               LXI   h,VM_STATE_BASE   
1EAE   06 01                  MVI   b,1   
1EB0   CD 9D 1E               CALL   clear_pages   
1EB3                             ; 
1EB3                             ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
1EB3   21 00 81               LXI   h,REG_FILE_BASE   
1EB6   06 01                  MVI   b,1   
1EB8   CD 9D 1E               CALL   clear_pages   
1EBB                             ; 
1EBB                             ; メソッド表をゼロクリア (256 バイト = 1 ページ)
1EBB   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1EBE   06 01                  MVI   b,1   
1EC0   CD 9D 1E               CALL   clear_pages   
1EC3                             ; 
1EC3                             ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
1EC3   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1EC6   06 04                  MVI   b,4   
1EC8   CD 9D 1E               CALL   clear_pages   
1ECB                             ; 
1ECB                             ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
1ECB   21 C0 96               LXI   h,COLLECTION_POOL_BASE   
1ECE   06 09                  MVI   b,9   
1ED0   CD 9D 1E               CALL   clear_pages   
1ED3                             ; 
1ED3                             ; IREP 0 のバイトコード長を VM 状態に設定
1ED3                             ; IREP テーブルの先頭エントリから読む
1ED3   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
1ED6   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1ED9   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
1EDC   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1EDF                             ; 
1EDF                             ; レジスタベースを初期化 (REG_FILE_BASE)
1EDF   21 00 81               LXI   h,REG_FILE_BASE   
1EE2   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
1EE5                             ; 
1EE5                             ; バイトコードベースを IREP 0 から読んで設定
1EE5   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
1EE8   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1EEB   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
1EEE   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1EF1                             ; 
1EF1                             ; シンボルテーブルベースを IREP 0 から読んで設定
1EF1   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
1EF4   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1EF7   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
1EFA   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1EFD                             ; 
1EFD                             ; 定数プールベースを IREP 0 から読んで設定
1EFD   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
1F00   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1F03   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
1F06   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1F09                             ; 
1F09                             ; フレーム SP = 0 (ゼロクリア済み)
1F09                             ; PC = 0 (ゼロクリア済み)
1F09                             ; 
1F09                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
1F09                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
1F09   3A FE 82               LDA   INIT_METHOD_ID_STORE   
1F0C   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
1F0F                             ; 
1F0F                             ; R[0] = self (TT_OBJECT, 値 = 0)
1F0F   21 00 81               LXI   h,REG_FILE_BASE   
1F12   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1F14   23                     INX   h   
1F15   36 00                  MVI   m,0   ; +1: 予約
1F17   23                     INX   h   
1F18   36 00                  MVI   m,0   ; +2: val_lo
1F1A   23                     INX   h   
1F1B   36 00                  MVI   m,0   ; +3: val_hi
1F1D                             ; 
1F1D                             ; 実行状態を RUNNING に設定
1F1D   3E 01                  MVI   a,VM_RUNNING   
1F1F   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1F22                             ; 
1F22                             ; メインループへ
1F22   C3 78 1D               JMP   vm_loop   
1F25                             ; 
1F25                             ; ===============================================================
1F25                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
1F25                             ; 
1F25                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
1F25                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
1F25                             ; ===============================================================
1F25                DO_OP_STRING:      
1F25   CD C0 10               CALL   fetch_byte   ; A = a
1F28   32 82 1F               STA   ops_reg_a   
1F2B   CD C0 10               CALL   fetch_byte   ; A = b (プールインデックス)
1F2E                             ; pool_base + b * 4 を計算
1F2E   87                     ADD   a   ; b * 2
1F2F   87                     ADD   a   ; b * 4
1F30   5F                     MOV   e,a   
1F31   16 00                  MVI   d,0   
1F33   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
1F36   19                     DAD   d   ; HL = &Pool[b]
1F37                             ; Pool[b] の val (文字列データアドレス) を取得
1F37   23                     INX   h   ; +1: 予約
1F38   23                     INX   h   ; +2: val_lo
1F39   5E                     MOV   e,m   
1F3A   23                     INX   h   ; +3: val_hi
1F3B   56                     MOV   d,m   ; DE = 文字列データアドレス
1F3C                             ; DE → 長さバイト + ASCII データ
1F3C   1A                     LDAX   d   ; A = 文字列長
1F3D   32 83 1F               STA   ops_str_len   
1F40   13                     INX   d   ; DE → 最初のバイト
1F41   D5                     PUSH   d   ; 文字列データソース退避
1F42                             ; 
1F42                             ; コレクションスロットを確保
1F42   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
1F45   32 84 1F               STA   ops_slot_num   
1F48                             ; 
1F48                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
1F48   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
1F4A   23                     INX   h   
1F4B   3A 83 1F               LDA   ops_str_len   
1F4E   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
1F50   DA 55 1F               JC   ops_len_ok   
1F53   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
1F55                OPS_LEN_OK:      
1F55   77                     MOV   m,a   ; +1: count
1F56   32 83 1F               STA   ops_str_len   ; 切り詰め後の長さ
1F59   23                     INX   h   ; HL → データ領域先頭
1F5A                             ; 
1F5A                             ; 文字列データをコピー
1F5A   D1                     POP   d   ; DE = ソースデータ
1F5B   3A 83 1F               LDA   ops_str_len   
1F5E   B7                     ORA   a   
1F5F   CA 6B 1F               JZ   ops_set_reg   ; 空文字列
1F62   4F                     MOV   c,a   
1F63                OPS_STR_COPY:      
1F63   1A                     LDAX   d   
1F64   77                     MOV   m,a   
1F65   23                     INX   h   
1F66   13                     INX   d   
1F67   0D                     DCR   c   
1F68   C2 63 1F               JNZ   ops_str_copy   
1F6B                             ; 
1F6B                OPS_SET_REG:      
1F6B                             ; R[a] = TT_STRING, val_lo = slot+1
1F6B   3A 82 1F               LDA   ops_reg_a   
1F6E   CD 00 10               CALL   get_reg_addr   ; HL = &R[a]
1F71   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
1F73   23                     INX   h   
1F74   36 00                  MVI   m,0   ; +1: 予約
1F76   23                     INX   h   
1F77   3A 84 1F               LDA   ops_slot_num   
1F7A   3C                     INR   a   ; slot + 1
1F7B   77                     MOV   m,a   ; +2: val_lo
1F7C   23                     INX   h   
1F7D   36 00                  MVI   m,0   ; +3: val_hi
1F7F   C3 78 1D               JMP   vm_loop   
1F82                             ; 
1F82   00           OPS_REG_A:   DB   0   
1F83   00           OPS_STR_LEN:   DB   0   
1F84   00           OPS_SLOT_NUM:   DB   0   
1F85                             ; 
1F85                             ; ===============================================================
1F85                             ; send_display — display(value): 7 セグに hex 表示
1F85                             ; 
1F85                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
1F85                             ; R[a] に nil を返す。
1F85                             ; ===============================================================
1F85                SEND_DISPLAY:      
1F85   3A 4D 17               LDA   send_reg_a   
1F88   3C                     INR   a   
1F89   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1F8C   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1F8F   CD 86 1B               CALL   display_hex16   ; 7 セグに書く
1F92                             ; return nil
1F92   3A 4D 17               LDA   send_reg_a   
1F95   CD 00 10               CALL   get_reg_addr   
1F98   3E 01                  MVI   a,TT_NIL   
1F9A   CD 1A 10               CALL   set_slot_special   
1F9D   C3 78 1D               JMP   vm_loop   
1FA0                             ; 
1FA0                             ; ===============================================================
1FA0                             ; send_getkey — getkey / getkey(timeout)
1FA0                             ; 
1FA0                             ; getkey (引数なし): KEYIN1 でブロッキング入力
1FA0                             ;   ROM なし → -1
1FA0                             ;   キー押下 → キーコード (0x00-0x17)
1FA0                             ; 
1FA0                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
1FA0                             ;   最大 n 回スキャン、キー押下 → キーコード
1FA0                             ;   タイムアウト / ROM なし → nil
1FA0                             ; 
1FA0                             ; キーコード割り当て (KEYIN1/KEY 共通):
1FA0                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
1FA0                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
1FA0                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
1FA0                             ;                                           0x17: LOAD
1FA0                             ; ===============================================================
1FA0                SEND_GETKEY:      
1FA0                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
1FA0   3A 4E 17               LDA   send_argc   
1FA3   B7                     ORA   a   
1FA4   C2 2E 27               JNZ   send_getkey_timeout   
1FA7                             ; 
1FA7                             ; --- ブロッキング版 (引数なし) ---
1FA7   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
1FAA   B7                     ORA   a   
1FAB   CA CB 1F               JZ   getkey_no_key   ; ROM なし → -1
1FAE                             ; 
1FAE                             ; キー入力をポーリングしながら LFSR を回す。
1FAE                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
1FAE                             ; 乱数の種が毎回異なる。
1FAE                GETKEY_POLL:      
1FAE   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
1FB1   FE FF                  CPI   0FFh   
1FB3   C2 BC 1F               JNZ   getkey_got_key   
1FB6   CD 4A 21               CALL   lfsr_next   ; 待機中に LFSR を進める
1FB9   C3 AE 1F               JMP   getkey_poll   
1FBC                             ; 
1FBC                GETKEY_GOT_KEY:      
1FBC                             ; キーコードを R[a] に返す
1FBC   4F                     MOV   c,a   
1FBD   06 00                  MVI   b,0   
1FBF   3A 4D 17               LDA   send_reg_a   
1FC2   CD 00 10               CALL   get_reg_addr   
1FC5   CD 10 10               CALL   set_slot_int16   
1FC8   C3 78 1D               JMP   vm_loop   
1FCB                             ; 
1FCB                GETKEY_NO_KEY:      
1FCB   3A 4D 17               LDA   send_reg_a   
1FCE   CD 00 10               CALL   get_reg_addr   
1FD1   06 FF                  MVI   b,0FFh   
1FD3   0E FF                  MVI   c,0FFh   ; -1
1FD5   CD 10 10               CALL   set_slot_int16   
1FD8   C3 78 1D               JMP   vm_loop   
1FDB                             ; 
1FDB                             ; ===============================================================
1FDB                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
1FDB                             ; 
1FDB                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
1FDB                             ; E レジスタにメソッド ID が入っている。
1FDB                             ; ===============================================================
1FDB                SEND_BUILTIN_EXT:      
1FDB   7B                     MOV   a,e   
1FDC   FE 1F                  CPI   METHOD_PUTS   
1FDE   CA 11 20               JZ   send_puts   
1FE1   FE 20                  CPI   METHOD_SETSEG   
1FE3   CA B5 20               JZ   send_setseg   
1FE6   FE 21                  CPI   METHOD_RAND   
1FE8   CA 6F 21               JZ   send_rand   
1FEB   FE 12                  CPI   METHOD_LENGTH   
1FED   CA A3 24               JZ   send_length   
1FF0   FE 14                  CPI   METHOD_CONCAT   
1FF2   CA BC 24               JZ   send_concat   
1FF5   FE 16                  CPI   METHOD_PUSH   
1FF7   CA 7A 25               JZ   concat_array   ; push は concat_array と同じ
1FFA   FE 22                  CPI   METHOD_SLICE   
1FFC   CA 77 27               JZ   send_slice   
1FFF                             ; **ブロック無しの述語。** `a.all?` は `a.all? 00bbIHx4fCB4IA==` と同じ
1FFF   FE 23                  CPI   METHOD_ANY_P   
2001   CA B5 2A               JZ   send_pred_any   
2004   FE 24                  CPI   METHOD_ALL_P   
2006   CA BA 2A               JZ   send_pred_all   
2009   FE 25                  CPI   METHOD_NONE_P   
200B   CA BF 2A               JZ   send_pred_none   
200E   C3 58 1D               JMP   vm_fail   ; 未対応メソッド
2011                             ; 
2011                             ; ===============================================================
2011                             ; send_puts — puts(value): 文字列を 7 セグに表示
2011                             ; 
2011                             ; R[a+1] が TT_STRING の場合:
2011                             ;   文字列データのアドレスから長さとバイト列を読み、
2011                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
2011                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
2011                             ; 
2011                             ; R[a+1] が TT_INTEGER の場合:
2011                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
2011                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
2011                             ; 
2011                             ; 使い方:
2011                             ;   puts "HELLO"          # 文字列を表示
2011                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
2011                             ; ===============================================================
2011                SEND_PUTS:      
2011   3A 4D 17               LDA   send_reg_a   
2014   3C                     INR   a   
2015   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2018   7E                     MOV   a,m   ; A = 型タグ
2019   FE 07                  CPI   TT_STRING   
201B   CA 55 20               JZ   puts_string   
201E                             ; TT_INTEGER: 従来のパック ASCII 処理
201E   FE 04                  CPI   TT_INTEGER   
2020   C2 58 1D               JNZ   vm_fail   
2023                             ; 
2023                             ; --- 整数パス (2 文字スクロール表示) ---
2023   3A 4D 17               LDA   send_reg_a   
2026   3C                     INR   a   
2027   CD 00 10               CALL   get_reg_addr   
202A   CD 32 10               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
202D   4E                     MOV   c,m   ; C = val_lo (右の文字)
202E   23                     INX   h   
202F   46                     MOV   b,m   ; B = val_hi (左の文字)
2030   C5                     PUSH   b   
2031                             ; 
2031                             ; 表示バッファを左に 2 桁スクロール
2031   21 FA FF               LXI   h,DISPLAY_BASE + 2   
2034   11 F8 FF               LXI   d,DISPLAY_BASE   
2037   06 06                  MVI   b,6   
2039                PUTS_SCROLL:      
2039   7E                     MOV   a,m   
203A   12                     STAX   d   
203B   23                     INX   h   
203C   13                     INX   d   
203D   05                     DCR   b   
203E   C2 39 20               JNZ   puts_scroll   
2041                             ; 
2041   C1                     POP   b   
2042   C5                     PUSH   b   
2043   78                     MOV   a,b   
2044   CD EE 20               CALL   ascii_to_seg   
2047   32 FE FF               STA   DISPLAY_BASE + 6   
204A                             ; 
204A   C1                     POP   b   
204B   79                     MOV   a,c   
204C   CD EE 20               CALL   ascii_to_seg   
204F   32 FF FF               STA   DISPLAY_BASE + 7   
2052   C3 A2 20               JMP   puts_ret_nil   
2055                             ; 
2055                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
2055                PUTS_STRING:      
2055   3A 4D 17               LDA   send_reg_a   
2058   3C                     INR   a   
2059   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
205C   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロットアドレス
205F                             ; 
205F                             ; +1: count (文字列長)
205F   23                     INX   h   
2060   7E                     MOV   a,m   ; A = 文字列長
2061   B7                     ORA   a   
2062   CA A2 20               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
2065   FE 09                  CPI   9   
2067   DA 6C 20               JC   sp_len_ok   
206A   3E 08                  MVI   a,8   ; 最大 8 文字
206C                SP_LEN_OK:      
206C   32 B0 20               STA   sp_count   
206F   23                     INX   h   ; HL → データ領域先頭
2070   22 B1 20               SHLD   sp_src   ; 文字列ソースポインタ退避
2073                             ; 
2073                             ; 表示バッファ全体をクリア
2073   21 F8 FF               LXI   h,DISPLAY_BASE   
2076   0E 08                  MVI   c,DISPLAY_SIZE   
2078                PUTS_STR_CLEAR:      
2078   36 00                  MVI   m,0   
207A   23                     INX   h   
207B   0D                     DCR   c   
207C   C2 78 20               JNZ   puts_str_clear   
207F                             ; 
207F                             ; 文字列の各バイトを変換して表示
207F   21 F8 FF               LXI   h,DISPLAY_BASE   
2082   22 B3 20               SHLD   sp_dst   ; 表示書き込みポインタ
2085                PUTS_STR_LOOP:      
2085   2A B1 20               LHLD   sp_src   
2088   7E                     MOV   a,m   ; A = ASCII コード
2089   23                     INX   h   
208A   22 B1 20               SHLD   sp_src   
208D   CD EE 20               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
2090   2A B3 20               LHLD   sp_dst   
2093   77                     MOV   m,a   
2094   23                     INX   h   
2095   22 B3 20               SHLD   sp_dst   
2098   3A B0 20               LDA   sp_count   
209B   3D                     DCR   a   
209C   32 B0 20               STA   sp_count   
209F   C2 85 20               JNZ   puts_str_loop   
20A2                             ; 
20A2                PUTS_RET_NIL:      
20A2   3A 4D 17               LDA   send_reg_a   
20A5   CD 00 10               CALL   get_reg_addr   
20A8   3E 01                  MVI   a,TT_NIL   
20AA   CD 1A 10               CALL   set_slot_special   
20AD   C3 78 1D               JMP   vm_loop   
20B0                             ; 
20B0   00           SP_COUNT:   DB   0   
20B1   00 00        SP_SRC:   DW   0   
20B3   00 00        SP_DST:   DW   0   
20B5                             ; 
20B5                             ; ===============================================================
20B5                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
20B5                             ; 
20B5                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
20B5                             ; ===============================================================
20B5                SEND_SETSEG:      
20B5                             ; 桁位置を取得
20B5   3A 4D 17               LDA   send_reg_a   
20B8   3C                     INR   a   
20B9   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
20BC   CD 32 10               CALL   slot_to_value   
20BF   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
20C0   FE 08                  CPI   DISPLAY_SIZE   
20C2   D2 58 1D               JNC   vm_fail   ; 桁位置 >= 8 → エラー
20C5   32 ED 20               STA   ss_pos   
20C8                             ; 
20C8                             ; パターンを取得
20C8   3A 4D 17               LDA   send_reg_a   
20CB   3C                     INR   a   
20CC   3C                     INR   a   
20CD   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
20D0   CD 32 10               CALL   slot_to_value   
20D3   46                     MOV   b,m   ; B = パターン (val_lo)
20D4                             ; 
20D4                             ; DISPLAY_BASE + pos にパターンを書く
20D4   3A ED 20               LDA   ss_pos   
20D7   6F                     MOV   l,a   
20D8   26 00                  MVI   h,0   
20DA   11 F8 FF               LXI   d,DISPLAY_BASE   
20DD   19                     DAD   d   ; HL = DISPLAY_BASE + pos
20DE   70                     MOV   m,b   
20DF                             ; 
20DF                             ; R[a] に nil を返す
20DF   3A 4D 17               LDA   send_reg_a   
20E2   CD 00 10               CALL   get_reg_addr   
20E5   3E 01                  MVI   a,TT_NIL   
20E7   CD 1A 10               CALL   set_slot_special   
20EA   C3 78 1D               JMP   vm_loop   
20ED                             ; 
20ED   00           SS_POS:   DB   0   
20EE                             ; 
20EE                             ; ===============================================================
20EE                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
20EE                             ; 
20EE                             ;   入力: A = ASCII コード
20EE                             ;   出力: A = セグメントパターン
20EE                             ;   破壊: HL, BC
20EE                             ; 
20EE                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
20EE                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
20EE                             ; 範囲外はブランク (0x00) を返す。
20EE                             ; ===============================================================
20EE                ASCII_TO_SEG:      
20EE   FE 60                  CPI   60h   
20F0   DA F5 20               JC   ats_no_fold   
20F3   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
20F5                ATS_NO_FOLD:      
20F5   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
20F7   DA 08 21               JC   ats_blank   ; 元が < 0x20 → ブランク
20FA   FE 40                  CPI   40h   
20FC   D2 08 21               JNC   ats_blank   ; >= 64 → ブランク
20FF                             ; テーブル参照
20FF   6F                     MOV   l,a   
2100   26 00                  MVI   h,0   
2102   01 0A 21               LXI   b,ascii_seg_table   
2105   09                     DAD   b   ; HL = ascii_seg_table + index
2106   7E                     MOV   a,m   
2107   C9                     RET      
2108                ATS_BLANK:      
2108   AF                     XRA   a   ; A = 0 (ブランク)
2109   C9                     RET      
210A                             ; 
210A                             ; ===============================================================
210A                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
210A                             ; 
210A                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
210A                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
210A                             ; 
210A                             ; セグメント配置:
210A                             ;     aaa        bit 0 = a (上)
210A                             ;    f   b       bit 1 = b (右上)
210A                             ;     ggg        bit 2 = c (右下)
210A                             ;    e   c       bit 3 = d (下)
210A                             ;     ddd        bit 4 = e (左下)
210A                             ;                bit 5 = f (左上)
210A                             ;                bit 6 = g (中)
210A                             ; 
210A                             ; 表現できない文字は 0x00 (消灯)。
210A                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
210A                             ; ===============================================================
210A                ASCII_SEG_TABLE:      
210A                             ; 0x20-0x2F: 記号
210A   00                     DB   00h   ; 0x20 " " (スペース)
210B   06                     DB   06h   ; 0x21 "!" (bc)
210C   22                     DB   22h   ; 0x22 """ (bf)
210D   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
210E   6D                     DB   6Dh   ; 0x24 "$" (= S)
210F   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
2110   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
2111   02                     DB   02h   ; 0x27 "'" (b)
2112   39                     DB   39h   ; 0x28 "(" (= C)
2113   0F                     DB   0Fh   ; 0x29 ")" (abcd)
2114   49                     DB   49h   ; 0x2A "*" (adg = 三)
2115   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
2116   04                     DB   04h   ; 0x2C "," (c)
2117   40                     DB   40h   ; 0x2D "-" (g)
2118   08                     DB   08h   ; 0x2E "." (d)
2119   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
211A                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
211A   5C                     DB   5Ch   ; 0x30 "0"
211B   06                     DB   06h   ; 0x31 "1"
211C   5B                     DB   5Bh   ; 0x32 "2"
211D   4F                     DB   4Fh   ; 0x33 "3"
211E   66                     DB   66h   ; 0x34 "4"
211F   6D                     DB   6Dh   ; 0x35 "5"
2120   7D                     DB   7Dh   ; 0x36 "6"
2121   27                     DB   27h   ; 0x37 "7"
2122   7F                     DB   7Fh   ; 0x38 "8"
2123   6F                     DB   6Fh   ; 0x39 "9"
2124                             ; 0x3A-0x40: 記号
2124   09                     DB   09h   ; 0x3A ":" (ad)
2125   00                     DB   00h   ; 0x3B ";"
2126   00                     DB   00h   ; 0x3C "<"
2127   48                     DB   48h   ; 0x3D "=" (dg)
2128   00                     DB   00h   ; 0x3E ">"
2129   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
212A   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
212B                             ; 0x41-0x5A: 英字
212B   77                     DB   77h   ; 0x41 "A" (abcefg)
212C   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
212D   39                     DB   39h   ; 0x43 "C" (adef)
212E   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
212F   79                     DB   79h   ; 0x45 "E" (adefg)
2130   71                     DB   71h   ; 0x46 "F" (aefg)
2131   3D                     DB   3Dh   ; 0x47 "G" (acdef)
2132   76                     DB   76h   ; 0x48 "H" (bcefg)
2133   06                     DB   06h   ; 0x49 "I" (bc)
2134   1E                     DB   1Eh   ; 0x4A "J" (bcde)
2135   74                     DB   74h   ; 0x4B "K" (cefg = h)
2136   38                     DB   38h   ; 0x4C "L" (def)
2137   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
2138   54                     DB   54h   ; 0x4E "N" (ceg = n)
2139   5C                     DB   5Ch   ; 0x4F "O" (= 0)
213A   73                     DB   73h   ; 0x50 "P" (abefg)
213B   67                     DB   67h   ; 0x51 "Q" (abcfg)
213C   50                     DB   50h   ; 0x52 "R" (eg = r)
213D   6D                     DB   6Dh   ; 0x53 "S" (= 5)
213E   78                     DB   78h   ; 0x54 "T" (defg = t)
213F   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
2140   3E                     DB   3Eh   ; 0x56 "V" (= U)
2141   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
2142   76                     DB   76h   ; 0x58 "X" (bcefg = H)
2143   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
2144   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
2145                             ; 0x5B-0x5F: 記号
2145   39                     DB   39h   ; 0x5B "[" (= C)
2146   00                     DB   00h   ; 0x5C "\"
2147   0F                     DB   0Fh   ; 0x5D "]" (= ))
2148   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
2149   08                     DB   08h   ; 0x5F "_" (d)
214A                             ; 
214A                             ; ===============================================================
214A                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
214A                             ; 
214A                             ;   入力: なし
214A                             ;   出力: HL = 新しい乱数値
214A                             ;   破壊: A, HL
214A                             ; 
214A                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
214A                             ; 周期: 65535
214A                             ; ===============================================================
214A                LFSR_NEXT:      
214A   2A 6D 21               LHLD   lfsr_state   
214D   7D                     MOV   a,l   
214E   E6 01                  ANI   1   ; LSB チェック
2150   CA 62 21               JZ   lfsr_no_tap   
2153                             ; LSB=1: 右シフト + XOR タップ
2153   7C                     MOV   a,h   
2154   B7                     ORA   a   ; CY=0 クリア
2155   1F                     RAR      
2156   67                     MOV   h,a   
2157   7D                     MOV   a,l   
2158   1F                     RAR      
2159   6F                     MOV   l,a   
215A   7C                     MOV   a,h   
215B   EE B4                  XRI   0B4h   
215D   67                     MOV   h,a   
215E   22 6D 21               SHLD   lfsr_state   
2161   C9                     RET      
2162                LFSR_NO_TAP:      
2162                             ; LSB=0: 右シフトのみ
2162   7C                     MOV   a,h   
2163   B7                     ORA   a   
2164   1F                     RAR      
2165   67                     MOV   h,a   
2166   7D                     MOV   a,l   
2167   1F                     RAR      
2168   6F                     MOV   l,a   
2169   22 6D 21               SHLD   lfsr_state   
216C   C9                     RET      
216D                             ; 
216D   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
216F                             ; 
216F                             ; ===============================================================
216F                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
216F                             ; 
216F                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
216F                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
216F                             ; ===============================================================
216F                SEND_RAND:      
216F                             ; R[a+1] から n を取得
216F   3A 4D 17               LDA   send_reg_a   
2172   3C                     INR   a   
2173   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2176   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
2179   5E                     MOV   e,m   
217A   23                     INX   h   
217B   56                     MOV   d,m   ; DE = n
217C                             ; 
217C                             ; n == 0 チェック
217C   7A                     MOV   a,d   
217D   B3                     ORA   e   
217E   CA 99 21               JZ   rand_zero   
2181                             ; 
2181   D5                     PUSH   d   ; n を退避
2182   CD 4A 21               CALL   lfsr_next   ; HL = 乱数
2185   44                     MOV   b,h   
2186   4D                     MOV   c,l   ; BC = 乱数 (被除数)
2187   D1                     POP   d   ; DE = n (除数)
2188   CD A5 12               CALL   udiv16   ; BC=商, HL=剰余
218B                             ; 
218B                             ; HL (剰余) → BC → R[a]
218B   44                     MOV   b,h   
218C   4D                     MOV   c,l   
218D   3A 4D 17               LDA   send_reg_a   
2190   CD 00 10               CALL   get_reg_addr   
2193   CD 10 10               CALL   set_slot_int16   
2196   C3 78 1D               JMP   vm_loop   
2199                             ; 
2199                RAND_ZERO:      
2199   06 00                  MVI   b,0   
219B   0E 00                  MVI   c,0   
219D   3A 4D 17               LDA   send_reg_a   
21A0   CD 00 10               CALL   get_reg_addr   
21A3   CD 10 10               CALL   set_slot_int16   
21A6   C3 78 1D               JMP   vm_loop   
21A9                             ; 
21A9                             ; ===============================================================
21A9                             ; コレクションプール基盤ルーチン
21A9                             ; ===============================================================
21A9                             ; 
21A9                             ; ---------------------------------------------------------------
21A9                             ; col_slot_addr — スロット番号からアドレスを計算
21A9                             ; 
21A9                             ;   入力: A = スロット番号 (0-based)
21A9                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
21A9                             ;   破壊: A, DE
21A9                             ; ---------------------------------------------------------------
21A9                COL_SLOT_ADDR:      
21A9                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
21A9                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
21A9   6F                     MOV   l,a   
21AA   26 00                  MVI   h,0   ; HL = slot_number
21AC   29                     DAD   h   ; HL = slot_number × 2
21AD   29                     DAD   h   ; HL = slot_number × 4
21AE   54                     MOV   d,h   
21AF   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
21B0   29                     DAD   h   ; HL = slot_number × 8
21B1   29                     DAD   h   ; HL = slot_number × 16
21B2   29                     DAD   h   ; HL = slot_number × 32
21B3   19                     DAD   d   ; HL = slot_number × 36
21B4   11 C0 96               LXI   d,COLLECTION_POOL_BASE   
21B7   19                     DAD   d   
21B8   C9                     RET      
21B9                             ; 
21B9                             ; ---------------------------------------------------------------
21B9                             ; col_alloc — コレクションスロットを確保
21B9                             ; 
21B9                             ;   入力: なし
21B9                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
21B9                             ;   破壊: DE
21B9                             ;   エラー: プール満杯かつ GC で回収不可 → vm_fail
21B9                             ; ---------------------------------------------------------------
21B9                COL_ALLOC:      
21B9   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
21BC   FE 40                  CPI   MAX_COL_SLOTS   
21BE   D2 24 28               JNC   col_gc_alloc   ; プール満杯 → GC 試行
21C1   F5                     PUSH   psw   ; スロット番号を退避
21C2   CD A9 21               CALL   col_slot_addr   ; HL = スロットアドレス
21C5                             ; COL_SP++
21C5   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
21C8   3C                     INR   a   
21C9   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
21CC   F1                     POP   psw   ; A = スロット番号
21CD   C9                     RET      
21CE                             ; 
21CE                             ; ---------------------------------------------------------------
21CE                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
21CE                             ; 
21CE                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
21CE                             ;   出力: HL = コレクションスロットアドレス
21CE                             ;   破壊: A, DE
21CE                             ; ---------------------------------------------------------------
21CE                COL_FROM_REG:      
21CE   CD 32 10               CALL   slot_to_value   ; HL = val アドレス
21D1   7E                     MOV   a,m   ; A = val_lo = slot+1
21D2   3D                     DCR   a   ; A = slot_number (0-based)
21D3   C3 A9 21               JMP   col_slot_addr   
21D6                             ; 
21D6                             ; ===============================================================
21D6                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
21D6                             ; 
21D6                             ; R[a] の型で分岐:
21D6                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
21D6                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
21D6                             ; ===============================================================
21D6                DO_OP_GETIDX:      
21D6   CD C0 10               CALL   fetch_byte   ; A = a
21D9   32 79 22               STA   gidx_reg_a   
21DC   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
21DF   7E                     MOV   a,m   ; A = 型タグ
21E0   FE 07                  CPI   TT_STRING   
21E2   CA F2 21               JZ   gidx_string   
21E5   FE 08                  CPI   TT_ARRAY   
21E7   CA 3E 22               JZ   gidx_array   
21EA   FE 09                  CPI   TT_HASH   
21EC   CA 2B 26               JZ   gidx_hash   
21EF   C3 58 1D               JMP   vm_fail   
21F2                             ; 
21F2                GIDX_STRING:      
21F2                             ; R[a] のコレクションスロットを取得
21F2   3A 79 22               LDA   gidx_reg_a   
21F5   CD 00 10               CALL   get_reg_addr   
21F8   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
21FB   23                     INX   h   ; +1: count
21FC   46                     MOV   b,m   ; B = 文字列長
21FD   23                     INX   h   ; HL → データ領域先頭
21FE   22 7A 22               SHLD   gidx_data_addr   
2201                             ; 
2201                             ; R[a+1] からインデックスを取得
2201   3A 79 22               LDA   gidx_reg_a   
2204   3C                     INR   a   
2205   CD 00 10               CALL   get_reg_addr   
2208   CD 32 10               CALL   slot_to_value   
220B   7E                     MOV   a,m   ; A = index (val_lo)
220C                             ; 範囲チェック: index < 文字列長
220C   B8                     CMP   b   
220D   D2 58 1D               JNC   vm_fail   ; index >= 長さ → エラー
2210                             ; データ先頭 + index で 1 文字を取得
2210   5F                     MOV   e,a   
2211   16 00                  MVI   d,0   
2213   2A 7A 22               LHLD   gidx_data_addr   
2216   19                     DAD   d   ; HL = &data[index]
2217   4E                     MOV   c,m   ; C = 文字コード
2218                             ; 
2218                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
2218   C5                     PUSH   b   ; C = 文字コード退避
2219   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
221C   32 7C 22               STA   gidx_new_slot   
221F   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2221   23                     INX   h   
2222   36 01                  MVI   m,1   ; +1: count = 1
2224   23                     INX   h   
2225   C1                     POP   b   
2226   71                     MOV   m,c   ; +2: data[0] = 文字コード
2227                             ; 
2227                             ; R[a] = TT_STRING, val_lo = new_slot+1
2227   3A 79 22               LDA   gidx_reg_a   
222A   CD 00 10               CALL   get_reg_addr   
222D   36 07                  MVI   m,TT_STRING   
222F   23                     INX   h   
2230   36 00                  MVI   m,0   
2232   23                     INX   h   
2233   3A 7C 22               LDA   gidx_new_slot   
2236   3C                     INR   a   
2237   77                     MOV   m,a   
2238   23                     INX   h   
2239   36 00                  MVI   m,0   
223B   C3 78 1D               JMP   vm_loop   
223E                             ; 
223E                GIDX_ARRAY:      
223E                             ; R[a] のコレクションスロットを取得
223E   3A 79 22               LDA   gidx_reg_a   
2241   CD 00 10               CALL   get_reg_addr   
2244   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
2247   23                     INX   h   ; +1: count
2248   46                     MOV   b,m   ; B = 要素数
2249   23                     INX   h   ; HL → データ領域先頭
224A   22 7A 22               SHLD   gidx_data_addr   
224D                             ; 
224D                             ; R[a+1] からインデックスを取得
224D   3A 79 22               LDA   gidx_reg_a   
2250   3C                     INR   a   
2251   CD 00 10               CALL   get_reg_addr   
2254   CD 32 10               CALL   slot_to_value   
2257   7E                     MOV   a,m   ; A = index (val_lo)
2258                             ; 範囲チェック: index < 要素数
2258   B8                     CMP   b   
2259   D2 58 1D               JNC   vm_fail   
225C                             ; data + index * 4 で要素スロットの先頭を求める
225C   87                     ADD   a   ; ×2
225D   87                     ADD   a   ; ×4
225E   5F                     MOV   e,a   
225F   16 00                  MVI   d,0   
2261   2A 7A 22               LHLD   gidx_data_addr   
2264   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
2265   EB                     XCHG      ; DE = &data[index * 4]
2266                             ; 
2266                             ; R[a] にコピー (4 バイト)
2266   3A 79 22               LDA   gidx_reg_a   
2269   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
226C   0E 04                  MVI   c,SLOT_BYTES   
226E                GIDX_ARY_COPY:      
226E   1A                     LDAX   d   
226F   77                     MOV   m,a   
2270   23                     INX   h   
2271   13                     INX   d   
2272   0D                     DCR   c   
2273   C2 6E 22               JNZ   gidx_ary_copy   
2276   C3 78 1D               JMP   vm_loop   
2279                             ; 
2279   00           GIDX_REG_A:   DB   0   
227A   00 00        GIDX_DATA_ADDR:   DW   0   
227C   00           GIDX_NEW_SLOT:   DB   0   
227D                             ; 
227D                             ; ===============================================================
227D                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
227D                             ; 
227D                             ; R[a] の型で分岐:
227D                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
227D                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
227D                             ; ===============================================================
227D                DO_OP_SETIDX:      
227D   CD C0 10               CALL   fetch_byte   ; A = a
2280   32 30 23               STA   sidx_reg_a   
2283   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2286   7E                     MOV   a,m   ; A = 型タグ
2287   FE 07                  CPI   TT_STRING   
2289   CA 99 22               JZ   sidx_string   
228C   FE 08                  CPI   TT_ARRAY   
228E   CA F3 22               JZ   sidx_array   
2291   FE 09                  CPI   TT_HASH   
2293   CA 93 26               JZ   sidx_hash   
2296   C3 58 1D               JMP   vm_fail   
2299                             ; 
2299                SIDX_STRING:      
2299                             ; R[a] のコレクションスロットを取得
2299   3A 30 23               LDA   sidx_reg_a   
229C   CD 00 10               CALL   get_reg_addr   
229F   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
22A2   23                     INX   h   ; +1: count
22A3   46                     MOV   b,m   ; B = 文字列長
22A4   23                     INX   h   ; HL → データ領域先頭
22A5   22 31 23               SHLD   sidx_data_addr   
22A8                             ; 
22A8                             ; R[a+1] からインデックスを取得
22A8   3A 30 23               LDA   sidx_reg_a   
22AB   3C                     INR   a   
22AC   CD 00 10               CALL   get_reg_addr   
22AF   CD 32 10               CALL   slot_to_value   
22B2   7E                     MOV   a,m   ; A = index
22B3   B8                     CMP   b   
22B4   D2 58 1D               JNC   vm_fail   ; index >= 長さ
22B7                             ; 
22B7                             ; data[index] に R[a+2] の文字を書き込む
22B7   5F                     MOV   e,a   
22B8   16 00                  MVI   d,0   
22BA   2A 31 23               LHLD   sidx_data_addr   
22BD   19                     DAD   d   ; HL = &data[index]
22BE                             ; 
22BE                             ; R[a+2] から文字コードを取得
22BE   3A 30 23               LDA   sidx_reg_a   
22C1   3C                     INR   a   
22C2   3C                     INR   a   
22C3   CD 00 10               CALL   get_reg_addr   
22C6                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
22C6   7E                     MOV   a,m   ; 型タグ
22C7   FE 07                  CPI   TT_STRING   
22C9   CA D3 22               JZ   sidx_str_char   
22CC                             ; TT_INTEGER: val_lo を文字コードとして使う
22CC   CD 32 10               CALL   slot_to_value   
22CF   7E                     MOV   a,m   
22D0   C3 D9 22               JMP   sidx_write_char   
22D3                SIDX_STR_CHAR:      
22D3                             ; TT_STRING: コレクションスロットの先頭文字
22D3   CD CE 21               CALL   col_from_reg   
22D6   23                     INX   h   ; +1: count
22D7   23                     INX   h   ; +2: data[0]
22D8   7E                     MOV   a,m   
22D9                SIDX_WRITE_CHAR:      
22D9   2A 31 23               LHLD   sidx_data_addr   
22DC   5F                     MOV   e,a   ; E = 文字コード
22DD   3A 30 23               LDA   sidx_reg_a   
22E0   3C                     INR   a   
22E1   CD 00 10               CALL   get_reg_addr   
22E4   CD 32 10               CALL   slot_to_value   
22E7   7E                     MOV   a,m   ; A = index
22E8   4F                     MOV   c,a   
22E9   06 00                  MVI   b,0   
22EB   2A 31 23               LHLD   sidx_data_addr   
22EE   09                     DAD   b   ; HL = &data[index]
22EF   73                     MOV   m,e   ; 書き込み
22F0   C3 78 1D               JMP   vm_loop   
22F3                             ; 
22F3                SIDX_ARRAY:      
22F3                             ; R[a] のコレクションスロットを取得
22F3   3A 30 23               LDA   sidx_reg_a   
22F6   CD 00 10               CALL   get_reg_addr   
22F9   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
22FC   23                     INX   h   ; +1: count
22FD   46                     MOV   b,m   ; B = 要素数
22FE   23                     INX   h   ; HL → データ領域先頭
22FF   22 31 23               SHLD   sidx_data_addr   
2302                             ; 
2302                             ; R[a+1] からインデックスを取得
2302   3A 30 23               LDA   sidx_reg_a   
2305   3C                     INR   a   
2306   CD 00 10               CALL   get_reg_addr   
2309   CD 32 10               CALL   slot_to_value   
230C   7E                     MOV   a,m   ; A = index
230D   B8                     CMP   b   
230E   D2 58 1D               JNC   vm_fail   
2311                             ; 
2311                             ; data[index * 4] に R[a+2] をコピー
2311   87                     ADD   a   ; ×2
2312   87                     ADD   a   ; ×4
2313   5F                     MOV   e,a   
2314   16 00                  MVI   d,0   
2316   2A 31 23               LHLD   sidx_data_addr   
2319   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
231A   EB                     XCHG      ; DE = コピー先
231B                             ; 
231B                             ; R[a+2] を取得 (コピー元)
231B   3A 30 23               LDA   sidx_reg_a   
231E   3C                     INR   a   
231F   3C                     INR   a   
2320   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
2323   0E 04                  MVI   c,SLOT_BYTES   
2325                SIDX_ARY_COPY:      
2325   7E                     MOV   a,m   
2326   12                     STAX   d   
2327   23                     INX   h   
2328   13                     INX   d   
2329   0D                     DCR   c   
232A   C2 25 23               JNZ   sidx_ary_copy   
232D   C3 78 1D               JMP   vm_loop   
2330                             ; 
2330   00           SIDX_REG_A:   DB   0   
2331   00 00        SIDX_DATA_ADDR:   DW   0   
2333                             ; 
2333                             ; ===============================================================
2333                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
2333                             ; 
2333                             ; b 個のレジスタからコレクションプールに配列を構築する。
2333                             ; ===============================================================
2333                DO_OP_ARRAY:      
2333   CD C0 10               CALL   fetch_byte   ; A = a
2336   32 AA 23               STA   oary_reg_a   
2339   32 AB 23               STA   oary_src_reg   ; BB 形式: ソース = a
233C   CD C0 10               CALL   fetch_byte   ; A = b (要素数)
233F                OA2_JOIN:      ; OP_ARRAY2 からの合流点
233F   32 AC 23               STA   oary_count   
2342   B7                     ORA   a   
2343   CA 9C 23               JZ   oary_empty   ; 空配列
2346                             ; 
2346                             ; 要素数チェック
2346   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2348   D2 58 1D               JNC   vm_fail   ; 要素数 > 7
234B                             ; 
234B                             ; コレクションスロットを確保
234B   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
234E   32 AD 23               STA   oary_slot_num   
2351   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
2353   23                     INX   h   
2354   3A AC 23               LDA   oary_count   
2357   77                     MOV   m,a   ; +1: count
2358   23                     INX   h   ; HL → データ領域先頭
2359   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
235A                             ; 
235A                             ; ソースレジスタから b 個のスロットをコピー
235A   3A AB 23               LDA   oary_src_reg   
235D   47                     MOV   b,a   ; B = 現在のレジスタ番号
235E   3A AC 23               LDA   oary_count   
2361   4F                     MOV   c,a   ; C = 残り要素数
2362                OARY_COPY_LOOP:      
2362   3E 04                  MVI   a,SLOT_BYTES   
2364   32 AE 23               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
2367   C5                     PUSH   b   
2368   D5                     PUSH   d   
2369   78                     MOV   a,b   
236A   CD 00 10               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
236D   D1                     POP   d   
236E                OARY_COPY_ELEM:      
236E   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
236F   23                     INX   h   
2370   78                     MOV   a,b   
2371   12                     STAX   d   
2372   13                     INX   d   
2373   E5                     PUSH   h   
2374   21 AE 23               LXI   h,oary_elem_cnt   
2377   35                     DCR   m   
2378   E1                     POP   h   
2379   C2 6E 23               JNZ   oary_copy_elem   
237C   C1                     POP   b   
237D   04                     INR   b   ; 次のレジスタ
237E   0D                     DCR   c   
237F   CA 85 23               JZ   oary_done   
2382   C3 62 23               JMP   oary_copy_loop   
2385                             ; 
2385                OARY_DONE:      
2385                             ; R[a] = TT_ARRAY, val_lo = slot+1
2385   3A AA 23               LDA   oary_reg_a   
2388   CD 00 10               CALL   get_reg_addr   
238B   36 08                  MVI   m,TT_ARRAY   
238D   23                     INX   h   
238E   36 00                  MVI   m,0   
2390   23                     INX   h   
2391   3A AD 23               LDA   oary_slot_num   
2394   3C                     INR   a   
2395   77                     MOV   m,a   
2396   23                     INX   h   
2397   36 00                  MVI   m,0   
2399   C3 78 1D               JMP   vm_loop   
239C                             ; 
239C                OARY_EMPTY:      
239C                             ; 空配列: スロット確保して count=0
239C   CD B9 21               CALL   col_alloc   
239F   32 AD 23               STA   oary_slot_num   
23A2   36 02                  MVI   m,COL_TYPE_ARRAY   
23A4   23                     INX   h   
23A5   36 00                  MVI   m,0   ; count = 0
23A7   C3 85 23               JMP   oary_done   
23AA                             ; 
23AA   00           OARY_REG_A:   DB   0   
23AB   00           OARY_SRC_REG:   DB   0   
23AC   00           OARY_COUNT:   DB   0   
23AD   00           OARY_SLOT_NUM:   DB   0   
23AE   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
23AF                             ; 
23AF                             ; ===============================================================
23AF                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
23AF                             ; 
23AF                             ; R[a] の配列の末尾に要素を追加する。
23AF                             ; ===============================================================
23AF                DO_OP_ARYPUSH:      
23AF   CD C0 10               CALL   fetch_byte   ; A = a
23B2   32 23 24               STA   apush_reg_a   
23B5   CD C0 10               CALL   fetch_byte   ; A = b (追加する要素数)
23B8   32 24 24               STA   apush_add_count   
23BB                             ; 
23BB                             ; R[a] のコレクションスロットを取得
23BB   3A 23 24               LDA   apush_reg_a   
23BE   CD 00 10               CALL   get_reg_addr   
23C1   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
23C4   23                     INX   h   ; +1: count
23C5   7E                     MOV   a,m   ; A = 現在の要素数
23C6   32 25 24               STA   apush_cur_count   
23C9                             ; 容量チェック: count + add_count <= MAX
23C9   3A 24 24               LDA   apush_add_count   
23CC   47                     MOV   b,a   
23CD   3A 25 24               LDA   apush_cur_count   
23D0   80                     ADD   b   
23D1   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
23D3   D2 58 1D               JNC   vm_fail   ; オーバーフロー
23D6                             ; 
23D6                             ; 書き込み先: data + count * 4
23D6   3A 25 24               LDA   apush_cur_count   
23D9   87                     ADD   a   ; ×2
23DA   87                     ADD   a   ; ×4
23DB   5F                     MOV   e,a   
23DC   16 00                  MVI   d,0   
23DE   23                     INX   h   ; HL → データ領域先頭
23DF   19                     DAD   d   ; HL = 書き込み位置
23E0   EB                     XCHG      ; DE = 書き込み位置
23E1                             ; 
23E1                             ; R[a+1] から b 個のスロットをコピー
23E1   3A 23 24               LDA   apush_reg_a   
23E4   3C                     INR   a   
23E5   47                     MOV   b,a   ; B = 現在のレジスタ番号
23E6   3A 24 24               LDA   apush_add_count   
23E9   4F                     MOV   c,a   ; C = 残り要素数
23EA                APUSH_LOOP:      
23EA   3E 04                  MVI   a,SLOT_BYTES   
23EC   32 26 24               STA   apush_byte_cnt   ; 毎回初期化
23EF   C5                     PUSH   b   
23F0   D5                     PUSH   d   
23F1   78                     MOV   a,b   
23F2   CD 00 10               CALL   get_reg_addr   ; HL = R[reg]
23F5   D1                     POP   d   
23F6                APUSH_COPY:      
23F6   46                     MOV   b,m   
23F7   78                     MOV   a,b   
23F8   12                     STAX   d   
23F9   23                     INX   h   
23FA   13                     INX   d   
23FB   E5                     PUSH   h   
23FC   21 26 24               LXI   h,apush_byte_cnt   
23FF   35                     DCR   m   
2400   E1                     POP   h   
2401   C2 F6 23               JNZ   apush_copy   
2404   C1                     POP   b   
2405   04                     INR   b   
2406   0D                     DCR   c   
2407   CA 0D 24               JZ   apush_done   
240A   C3 EA 23               JMP   apush_loop   
240D                             ; 
240D                APUSH_DONE:      
240D                             ; count を更新
240D   3A 23 24               LDA   apush_reg_a   
2410   CD 00 10               CALL   get_reg_addr   
2413   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
2416   23                     INX   h   ; +1: count
2417   3A 25 24               LDA   apush_cur_count   
241A   47                     MOV   b,a   
241B   3A 24 24               LDA   apush_add_count   
241E   80                     ADD   b   
241F   77                     MOV   m,a   ; count = old + added
2420   C3 78 1D               JMP   vm_loop   
2423                             ; 
2423   00           APUSH_REG_A:   DB   0   
2424   00           APUSH_ADD_COUNT:   DB   0   
2425   00           APUSH_CUR_COUNT:   DB   0   
2426   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
2427                             ; 
2427                             ; ===============================================================
2427                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
2427                             ; 
2427                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
2427                             ; ===============================================================
2427                DO_OP_STRCAT:      
2427   CD C0 10               CALL   fetch_byte   ; A = a
242A   32 9D 24               STA   scat_reg_a   
242D                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
242D                             ; 
242D                             ; R[a+1] のコレクションスロット (ソース)
242D   3C                     INR   a   
242E   CD 00 10               CALL   get_reg_addr   
2431   CD CE 21               CALL   col_from_reg   ; HL = ソーススロット
2434   23                     INX   h   ; +1: count
2435   7E                     MOV   a,m   ; A = ソース文字列長
2436   32 9E 24               STA   scat_src_len   
2439   23                     INX   h   ; HL → データ先頭
243A   22 A1 24               SHLD   scat_src_data   
243D                             ; 
243D                             ; R[a] のコレクションスロット (デスト)
243D   3A 9D 24               LDA   scat_reg_a   
2440   CD 00 10               CALL   get_reg_addr   
2443   CD CE 21               CALL   col_from_reg   ; HL = デストスロット
2446   23                     INX   h   ; +1: count
2447   7E                     MOV   a,m   ; A = デスト文字列長
2448   32 9F 24               STA   scat_dst_len   
244B                             ; 
244B                             ; 合計長チェック
244B   3A 9E 24               LDA   scat_src_len   
244E   47                     MOV   b,a   
244F   3A 9F 24               LDA   scat_dst_len   
2452   80                     ADD   b   
2453   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2455   DA 6D 24               JC   scat_len_ok   
2458                             ; 切り詰め: 追記できる分だけ
2458   3E 22                  MVI   a,COL_MAX_STRING_LEN   
245A   47                     MOV   b,a   
245B   3A 9F 24               LDA   scat_dst_len   
245E   90                     SUB   b   ; この結果は負 (使わない)
245F   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2461   47                     MOV   b,a   
2462   3A 9F 24               LDA   scat_dst_len   
2465   4F                     MOV   c,a   
2466   78                     MOV   a,b   
2467   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
2468   32 9E 24               STA   scat_src_len   
246B                             ; 合計を MAX に
246B   3E 22                  MVI   a,COL_MAX_STRING_LEN   
246D                SCAT_LEN_OK:      
246D   32 A0 24               STA   scat_total_len   
2470                             ; 
2470                             ; デスト count を更新
2470   3A 9D 24               LDA   scat_reg_a   
2473   CD 00 10               CALL   get_reg_addr   
2476   CD CE 21               CALL   col_from_reg   
2479   23                     INX   h   
247A   3A A0 24               LDA   scat_total_len   
247D   77                     MOV   m,a   ; count = 合計長
247E   23                     INX   h   ; HL → データ先頭
247F                             ; 
247F                             ; デストデータ末尾 = data + dst_len
247F   3A 9F 24               LDA   scat_dst_len   
2482   5F                     MOV   e,a   
2483   16 00                  MVI   d,0   
2485   19                     DAD   d   ; HL = 書き込み位置
2486                             ; 
2486                             ; ソースデータをコピー
2486   EB                     XCHG      ; DE = 書き込み位置
2487   2A A1 24               LHLD   scat_src_data   ; HL = ソースデータ
248A   3A 9E 24               LDA   scat_src_len   
248D   B7                     ORA   a   
248E   CA 9A 24               JZ   scat_done   
2491   4F                     MOV   c,a   
