0000                             ; vm_main.a80 — faRuby i8080 VM エントリポイント
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (32KB RAM: 0x8000-0xFFFF) を想定。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; --- メモリマップ ---
0000                VM_CODE_ORG:   EQU   8400h   
0000                BYTECODE_BASE:   EQU   9000h   
0000                BYTECODE_SIZE:   EQU   1000h   
0000                POOL_BASE:   EQU   0A000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   20h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FE00h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                             ; --- バリュースロット ---
0000                SLOT_BYTES:   EQU   08h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; --- VM 状態領域のオフセット ---
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                             ; --- IREP テーブルエントリ ---
0000                IREP_ENTRY_BYTES:   EQU   08h   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; --- VM 実行状態 ---
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; --- Phase 1 オペコード ---
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
8400                          .ORG   08400h   
8400                             ; ===============================================================
8400                             ; リセットベクタ
8400                             ; ===============================================================
8400   C3 79 87               JMP   vm_start   
8403                             ; ===============================================================
8403                             ; サブルーチン群 (.include で取り込む)
8403                             ; ===============================================================
8403                             ; vm_util.a80 — ユーティリティサブルーチン
8403                             ; 
8403                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
8403                             ; 他のすべてのモジュールがここに依存します。
8403                             ; ---------------------------------------------------------------
8403                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
8403                             ; 
8403                             ;   入力: A = レジスタ番号 (0-31)
8403                             ;   出力: HL = スロット先頭アドレス
8403                             ;   破壊: A
8403                             ; 
8403                             ; REG_FILE_BASE = 0x8100 (下位バイト 0x00) なので、
8403                             ; レジスタ番号 × 8 がそのまま L になり、H は固定。
8403                             ; ---------------------------------------------------------------
8403                GET_REG_ADDR:      
8403   87                     ADD   a   ; ×2
8404   87                     ADD   a   ; ×4
8405   87                     ADD   a   ; ×8
8406   6F                     MOV   l,a   
8407   26 81                  MVI   h,REG_FILE_BASE_HI   
8409   C9                     RET      
840A                             ; ---------------------------------------------------------------
840A                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
840A                             ; 
840A                             ;   入力: A = レジスタ番号 a
840A                             ;   出力: HL = R[a+1] のスロット先頭アドレス
840A                             ;   破壊: A
840A                             ; ---------------------------------------------------------------
840A                GET_REG_ADDR_NEXT:      
840A   3C                     INR   a   
840B   C3 03 84               JMP   get_reg_addr   
840E                             ; ---------------------------------------------------------------
840E                             ; set_slot_int_small — スロットに小さい整数を書く
840E                             ; 
840E                             ;   入力: HL = スロット先頭アドレス
840E                             ;          A  = 値の byte0 (LSB)
840E                             ;          B  = 符号拡張バイト (正なら 00h, 負なら FFh)
840E                             ;   出力: なし
840E                             ;   破壊: A, HL
840E                             ; ---------------------------------------------------------------
840E                SET_SLOT_INT_SMALL:      
840E   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ下位
8410   23                     INX   h   
8411   36 00                  MVI   m,0   ; +1: 型タグ上位
8413   23                     INX   h   
8414   77                     MOV   m,a   ; +2: 値 byte0 (LSB)
8415   23                     INX   h   
8416   70                     MOV   m,b   ; +3: 値 byte1
8417   23                     INX   h   
8418   70                     MOV   m,b   ; +4: 値 byte2
8419   23                     INX   h   
841A   70                     MOV   m,b   ; +5: 値 byte3 (MSB)
841B   23                     INX   h   
841C   36 00                  MVI   m,0   ; +6: 予備
841E   23                     INX   h   
841F   36 00                  MVI   m,0   ; +7: 予備
8421   C9                     RET      
8422                             ; ---------------------------------------------------------------
8422                             ; set_slot_special — 値を持たない型をスロットに書く
8422                             ; 
8422                             ;   入力: HL = スロット先頭アドレス
8422                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
8422                             ;   出力: なし
8422                             ;   破壊: A, HL
8422                             ; ---------------------------------------------------------------
8422                SET_SLOT_SPECIAL:      
8422   77                     MOV   m,a   ; +0: 型タグ下位
8423   23                     INX   h   
8424   36 00                  MVI   m,0   ; +1: 型タグ上位
8426   23                     INX   h   
8427                             ; +2 ～ +7 を 0 クリア
8427   AF                     XRA   a   ; A = 0
8428   77                     MOV   m,a   ; +2
8429   23                     INX   h   
842A   77                     MOV   m,a   ; +3
842B   23                     INX   h   
842C   77                     MOV   m,a   ; +4
842D   23                     INX   h   
842E   77                     MOV   m,a   ; +5
842F   23                     INX   h   
8430   77                     MOV   m,a   ; +6
8431   23                     INX   h   
8432   77                     MOV   m,a   ; +7
8433   C9                     RET      
8434                             ; ---------------------------------------------------------------
8434                             ; copy_slot — スロットを丸ごと複写 (8 バイト)
8434                             ; 
8434                             ;   入力: HL = コピー元先頭
8434                             ;         DE = コピー先先頭
8434                             ;   出力: なし
8434                             ;   破壊: A, C, HL, DE
8434                             ; ---------------------------------------------------------------
8434                COPY_SLOT:      
8434   0E 08                  MVI   c,SLOT_BYTES   
8436                COPY_SLOT_LOOP:      
8436   7E                     MOV   a,m   
8437   12                     STAX   d   
8438   23                     INX   h   
8439   13                     INX   d   
843A   0D                     DCR   c   
843B   C2 36 84               JNZ   copy_slot_loop   
843E   C9                     RET      
843F                             ; ---------------------------------------------------------------
843F                             ; get_slot_type — スロットの型タグを読む
843F                             ; 
843F                             ;   入力: HL = スロット先頭アドレス
843F                             ;   出力: A = 型タグ (下位バイトのみ。上位は常に 0)
843F                             ;   破壊: なし (HL 保存)
843F                             ; ---------------------------------------------------------------
843F                GET_SLOT_TYPE:      
843F   7E                     MOV   a,m   
8440   C9                     RET      
8441                             ; ---------------------------------------------------------------
8441                             ; slot_to_value — スロット先頭から値の先頭へ進める
8441                             ; 
8441                             ;   入力: HL = スロット先頭アドレス
8441                             ;   出力: HL = 値の先頭 (スロット +2)
8441                             ;   破壊: なし
8441                             ; ---------------------------------------------------------------
8441                SLOT_TO_VALUE:      
8441   23                     INX   h   
8442   23                     INX   h   
8443   C9                     RET      
8444                             ; ---------------------------------------------------------------
8444                             ; add_value32 — 32 ビット加算
8444                             ; 
8444                             ;   入力: HL = 値 1 の先頭 (被加算数, 結果をここに上書き)
8444                             ;         DE = 値 2 の先頭 (加算数)
8444                             ;   出力: 結果を HL の元の位置に上書き
8444                             ;   破壊: A, HL, DE
8444                             ; 
8444                             ; INX/XCHG はフラグを変えないので、桁上げが正しく伝搬する。
8444                             ; ---------------------------------------------------------------
8444                ADD_VALUE32:      
8444   1A                     LDAX   d   ; A = val2[byte0]
8445   86                     ADD   m   ; A += val1[byte0]
8446   77                     MOV   m,a   ; val1[byte0] = result
8447   23                     INX   h   
8448   13                     INX   d   
8449   1A                     LDAX   d   ; A = val2[byte1]
844A   8E                     ADC   m   ; A += val1[byte1] + CY
844B   77                     MOV   m,a   
844C   23                     INX   h   
844D   13                     INX   d   
844E   1A                     LDAX   d   ; A = val2[byte2]
844F   8E                     ADC   m   
8450   77                     MOV   m,a   
8451   23                     INX   h   
8452   13                     INX   d   
8453   1A                     LDAX   d   ; A = val2[byte3]
8454   8E                     ADC   m   
8455   77                     MOV   m,a   
8456   C9                     RET      
8457                             ; ---------------------------------------------------------------
8457                             ; sub_value32 — 32 ビット減算 (val1 -= val2)
8457                             ; 
8457                             ;   入力: HL = 値 1 の先頭 (被減数, 結果をここに上書き)
8457                             ;         DE = 値 2 の先頭 (減数)
8457                             ;   出力: 結果を HL の元の位置に上書き
8457                             ;   破壊: A, HL, DE
8457                             ; 
8457                             ; SUB M は A = A - [HL] なので、被減数を A に取ってから
8457                             ; XCHG で HL と DE を入れ替えて減数を引く。
8457                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
8457                             ; ---------------------------------------------------------------
8457                SUB_VALUE32:      
8457   7E                     MOV   a,m   ; A = val1[byte0]
8458   EB                     XCHG      ; HL=val2, DE=val1
8459   96                     SUB   m   ; A -= val2[byte0]
845A   EB                     XCHG      ; HL=val1, DE=val2
845B   77                     MOV   m,a   ; val1[byte0] = result
845C   23                     INX   h   
845D   13                     INX   d   
845E   7E                     MOV   a,m   ; A = val1[byte1]
845F   EB                     XCHG      
8460   9E                     SBB   m   ; A -= val2[byte1] - CY
8461   EB                     XCHG      
8462   77                     MOV   m,a   
8463   23                     INX   h   
8464   13                     INX   d   
8465   7E                     MOV   a,m   ; A = val1[byte2]
8466   EB                     XCHG      
8467   9E                     SBB   m   
8468   EB                     XCHG      
8469   77                     MOV   m,a   
846A   23                     INX   h   
846B   13                     INX   d   
846C   7E                     MOV   a,m   ; A = val1[byte3]
846D   EB                     XCHG      
846E   9E                     SBB   m   
846F   EB                     XCHG      
8470   77                     MOV   m,a   
8471   C9                     RET      
8472                             ; ---------------------------------------------------------------
8472                             ; cmp_value32 — 32 ビット符号付き比較
8472                             ; 
8472                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
8472                             ;         DE = 値 2 の先頭 (byte0 の位置)
8472                             ;   出力: A = 比較結果
8472                             ;           00h → val1 == val2
8472                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
8472                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
8472                             ;   破壊: A, B, C, HL, DE
8472                             ; 
8472                             ; 手順:
8472                             ;   1. MSB (byte3) の符号ビットを比べる
8472                             ;   2. 符号が違えば、負の方が小さい
8472                             ;   3. 符号が同じなら MSB → LSB の順に符号なし比較
8472                             ; ---------------------------------------------------------------
8472                CMP_VALUE32:      
8472                             ; byte3 (MSB) の位置を求める
8472   23                     INX   h   
8473   23                     INX   h   
8474   23                     INX   h   ; HL = val1+3 (byte3)
8475   13                     INX   d   
8476   13                     INX   d   
8477   13                     INX   d   ; DE = val2+3 (byte3)
8478                             ; 符号ビットを比べる
8478   7E                     MOV   a,m   ; A = val1[byte3]
8479   47                     MOV   b,a   ; B = val1[byte3] (退避)
847A   1A                     LDAX   d   ; A = val2[byte3]
847B   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
847C   F2 88 84               JP   cmp32_same_sign   
847F                             ; 符号が違う: val1 が負なら val1 < val2
847F   78                     MOV   a,b   ; A = val1[byte3]
8480   E6 80                  ANI   80h   ; bit7 を取り出す
8482   C2 B0 84               JNZ   cmp32_ret_neg   ; val1 が負 → val1 < val2
8485   C3 B3 84               JMP   cmp32_ret_pos   ; val1 が正 → val1 > val2
8488                CMP32_SAME_SIGN:      
8488                             ; 符号が同じ: MSB → LSB の順に符号なし比較
8488                             ; CMP M は A - [HL] なので、A=val2, M=val1
8488                             ;   CY=1 → val2 < val1 → val1 > val2 → 正を返す
8488                             ;   CY=0, Z=0 → val2 > val1 → val1 < val2 → 負を返す
8488   1A                     LDAX   d   
8489   BE                     CMP   m   ; val2[byte3] - val1[byte3]
848A   DA B3 84               JC   cmp32_ret_pos   
848D   C2 B0 84               JNZ   cmp32_ret_neg   
8490   2B                     DCX   h   
8491   1B                     DCX   d   
8492   1A                     LDAX   d   
8493   BE                     CMP   m   ; val2[byte2] - val1[byte2]
8494   DA B3 84               JC   cmp32_ret_pos   
8497   C2 B0 84               JNZ   cmp32_ret_neg   
849A   2B                     DCX   h   
849B   1B                     DCX   d   
849C   1A                     LDAX   d   
849D   BE                     CMP   m   ; val2[byte1] - val1[byte1]
849E   DA B3 84               JC   cmp32_ret_pos   
84A1   C2 B0 84               JNZ   cmp32_ret_neg   
84A4   2B                     DCX   h   
84A5   1B                     DCX   d   
84A6   1A                     LDAX   d   
84A7   BE                     CMP   m   ; val2[byte0] - val1[byte0]
84A8   DA B3 84               JC   cmp32_ret_pos   
84AB   C2 B0 84               JNZ   cmp32_ret_neg   
84AE                             ; すべて等しい
84AE   AF                     XRA   a   ; A = 00h
84AF   C9                     RET      
84B0                CMP32_RET_NEG:      
84B0   3E FF                  MVI   a,0FFh   ; val1 < val2
84B2   C9                     RET      
84B3                CMP32_RET_POS:      
84B3   3E 01                  MVI   a,01h   ; val1 > val2
84B5   C9                     RET      
84B6                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
84B6                             ; 
84B6                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
84B6                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
84B6                             ; ---------------------------------------------------------------
84B6                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
84B6                             ; 
84B6                             ;   入力: なし
84B6                             ;   出力: A = 読んだバイト
84B6                             ;   破壊: HL, DE
84B6                             ; 
84B6                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
84B6                             ; BYTECODE_BASE + PC で求めます。
84B6                             ; ---------------------------------------------------------------
84B6                FETCH_BYTE:      
84B6   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
84B9   11 00 90               LXI   d,BYTECODE_BASE   
84BC   19                     DAD   d   ; HL = 絶対アドレス
84BD   7E                     MOV   a,m   ; A = bytecode[PC]
84BE                             ; PC をインクリメント
84BE   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
84C1   23                     INX   h   
84C2   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
84C5   C9                     RET      
84C6                             ; ---------------------------------------------------------------
84C6                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
84C6                             ; 
84C6                             ;   入力: なし
84C6                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
84C6                             ;   破壊: A, B, DE
84C6                             ; 
84C6                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
84C6                             ; 1 バイト目が上位、2 バイト目が下位。
84C6                             ; ---------------------------------------------------------------
84C6                FETCH_U16BE:      
84C6   CD B6 84               CALL   fetch_byte   ; A = 上位バイト
84C9   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
84CA   CD B6 84               CALL   fetch_byte   ; A = 下位バイト
84CD   6F                     MOV   l,a   
84CE   60                     MOV   h,b   
84CF   C9                     RET      
84D0                             ; ---------------------------------------------------------------
84D0                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
84D0                             ; 
84D0                             ;   入力: なし
84D0                             ;   出力: HL = 読んだ符号付き 16 ビット値
84D0                             ;   破壊: A, DE
84D0                             ; 
84D0                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
84D0                             ; ---------------------------------------------------------------
84D0                FETCH_S16BE:      
84D0   C3 C6 84               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
84D3                             ; vm_load.a80 — ロード命令
84D3                             ; 
84D3                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
84D3                             ; ---------------------------------------------------------------
84D3                             ; OP_NOP (Z): 何もしない
84D3                             ; ---------------------------------------------------------------
84D3                DO_OP_NOP:      
84D3   C3 A5 87               JMP   vm_loop   
84D6                             ; ---------------------------------------------------------------
84D6                             ; OP_MOVE (BB): R[a] = R[b]
84D6                             ; ---------------------------------------------------------------
84D6                DO_OP_MOVE:      
84D6   CD B6 84               CALL   fetch_byte   ; A = a (コピー先)
84D9   F5                     PUSH   psw   
84DA   CD B6 84               CALL   fetch_byte   ; A = b (コピー元)
84DD   CD 03 84               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
84E0   EB                     XCHG      ; DE = R[b]
84E1   F1                     POP   psw   ; A = a
84E2   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84E5   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
84E6   CD 34 84               CALL   copy_slot   
84E9   C3 A5 87               JMP   vm_loop   
84EC                             ; ---------------------------------------------------------------
84EC                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
84EC                             ; ---------------------------------------------------------------
84EC                DO_OP_LOADI:      
84EC   CD B6 84               CALL   fetch_byte   ; A = a
84EF   F5                     PUSH   psw   
84F0   CD B6 84               CALL   fetch_byte   ; A = b (値)
84F3   4F                     MOV   c,a   ; C = 値 (退避)
84F4   F1                     POP   psw   ; A = a
84F5   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84F8   79                     MOV   a,c   ; A = 値
84F9   06 00                  MVI   b,0   ; B = 符号拡張 (正なので 0)
84FB   CD 0E 84               CALL   set_slot_int_small   
84FE   C3 A5 87               JMP   vm_loop   
8501                             ; ---------------------------------------------------------------
8501                             ; OP_LOADINEG (BB): R[a] = -b
8501                             ; ---------------------------------------------------------------
8501                DO_OP_LOADINEG:      
8501   CD B6 84               CALL   fetch_byte   ; A = a
8504   F5                     PUSH   psw   
8505   CD B6 84               CALL   fetch_byte   ; A = b
8508                             ; -b を計算 (0 - b)
8508   4F                     MOV   c,a   ; C = b (退避)
8509   AF                     XRA   a   ; A = 0
850A   91                     SUB   c   ; A = -b
850B   4F                     MOV   c,a   ; C = -b (値)
850C   F1                     POP   psw   ; A = a
850D   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8510   79                     MOV   a,c   ; A = -b
8511   06 FF                  MVI   b,0FFh   ; B = 符号拡張 (負なので FF)
8513   CD 0E 84               CALL   set_slot_int_small   
8516   C3 A5 87               JMP   vm_loop   
8519                             ; ---------------------------------------------------------------
8519                             ; OP_LOADI__1 (B): R[a] = -1
8519                             ; ---------------------------------------------------------------
8519                DO_OP_LOADI__1:      
8519   CD B6 84               CALL   fetch_byte   ; A = a
851C   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
851F   3E FF                  MVI   a,0FFh   ; -1 の byte0
8521   06 FF                  MVI   b,0FFh   ; 符号拡張
8523   CD 0E 84               CALL   set_slot_int_small   
8526   C3 A5 87               JMP   vm_loop   
8529                             ; ---------------------------------------------------------------
8529                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
8529                             ; 
8529                             ; 即値はオペコードから求める: 値 = opcode - OP_LOADI_0
8529                             ; ---------------------------------------------------------------
8529                DO_OP_LOADI_0:      
8529   0E 00                  MVI   c,0   
852B   C3 4E 85               JMP   loadi_small   
852E                DO_OP_LOADI_1:      
852E   0E 01                  MVI   c,1   
8530   C3 4E 85               JMP   loadi_small   
8533                DO_OP_LOADI_2:      
8533   0E 02                  MVI   c,2   
8535   C3 4E 85               JMP   loadi_small   
8538                DO_OP_LOADI_3:      
8538   0E 03                  MVI   c,3   
853A   C3 4E 85               JMP   loadi_small   
853D                DO_OP_LOADI_4:      
853D   0E 04                  MVI   c,4   
853F   C3 4E 85               JMP   loadi_small   
8542                DO_OP_LOADI_5:      
8542   0E 05                  MVI   c,5   
8544   C3 4E 85               JMP   loadi_small   
8547                DO_OP_LOADI_6:      
8547   0E 06                  MVI   c,6   
8549   C3 4E 85               JMP   loadi_small   
854C                DO_OP_LOADI_7:      
854C   0E 07                  MVI   c,7   
854E                LOADI_SMALL:      
854E                             ; C = 即値 (0-7)
854E   CD B6 84               CALL   fetch_byte   ; A = a
8551   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8554   79                     MOV   a,c   ; A = 値
8555   06 00                  MVI   b,0   ; 符号拡張 (正)
8557   CD 0E 84               CALL   set_slot_int_small   
855A   C3 A5 87               JMP   vm_loop   
855D                             ; ---------------------------------------------------------------
855D                             ; OP_LOADI16 (BS): R[a] = signed16(b)
855D                             ; 
855D                             ; b は符号付き 16 ビット (ビッグエンディアン)。
855D                             ; 32 ビットに符号拡張してスロットに書く。
855D                             ; ---------------------------------------------------------------
855D                DO_OP_LOADI16:      
855D   CD B6 84               CALL   fetch_byte   ; A = a
8560   F5                     PUSH   psw   
8561   CD D0 84               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
8564   4D                     MOV   c,l   ; C = byte0 (下位)
8565   54                     MOV   d,h   ; D = byte1 (上位)
8566   F1                     POP   psw   ; A = a
8567   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
856A                             ; 型タグ
856A   36 04                  MVI   m,TT_INTEGER   
856C   23                     INX   h   
856D   36 00                  MVI   m,0   
856F   23                     INX   h   
8570                             ; 値 byte0
8570   71                     MOV   m,c   
8571   23                     INX   h   
8572                             ; 値 byte1
8572   72                     MOV   m,d   
8573   23                     INX   h   
8574                             ; 符号拡張: byte1 の bit7 を byte2, byte3 に伝搬
8574   7A                     MOV   a,d   
8575   17                     RAL      ; bit7 → CY
8576   9F                     SBB   a   ; A = CY ? FFh : 00h
8577   77                     MOV   m,a   ; byte2
8578   23                     INX   h   
8579   77                     MOV   m,a   ; byte3
857A   23                     INX   h   
857B                             ; 予備
857B   36 00                  MVI   m,0   
857D   23                     INX   h   
857E   36 00                  MVI   m,0   
8580   C3 A5 87               JMP   vm_loop   
8583                             ; ---------------------------------------------------------------
8583                             ; OP_LOADNIL (B): R[a] = nil
8583                             ; ---------------------------------------------------------------
8583                DO_OP_LOADNIL:      
8583   CD B6 84               CALL   fetch_byte   ; A = a
8586   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8589   3E 01                  MVI   a,TT_NIL   
858B   CD 22 84               CALL   set_slot_special   
858E   C3 A5 87               JMP   vm_loop   
8591                             ; ---------------------------------------------------------------
8591                             ; OP_LOADT (B): R[a] = true
8591                             ; ---------------------------------------------------------------
8591                DO_OP_LOADT:      
8591   CD B6 84               CALL   fetch_byte   ; A = a
8594   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8597   3E 03                  MVI   a,TT_TRUE   
8599   CD 22 84               CALL   set_slot_special   
859C   C3 A5 87               JMP   vm_loop   
859F                             ; ---------------------------------------------------------------
859F                             ; OP_LOADF (B): R[a] = false
859F                             ; ---------------------------------------------------------------
859F                DO_OP_LOADF:      
859F   CD B6 84               CALL   fetch_byte   ; A = a
85A2   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85A5   3E 02                  MVI   a,TT_FALSE   
85A7   CD 22 84               CALL   set_slot_special   
85AA   C3 A5 87               JMP   vm_loop   
85AD                             ; vm_arith.a80 — 算術命令 (32 ビット整数)
85AD                             ; 
85AD                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI
85AD                             ; ---------------------------------------------------------------
85AD                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
85AD                             ; 
85AD                             ; Phase 1 は整数のみ。型タグの検査は省略し、TT_INTEGER として扱う。
85AD                             ; ---------------------------------------------------------------
85AD                DO_OP_ADD:      
85AD   CD B6 84               CALL   fetch_byte   ; A = a
85B0   F5                     PUSH   psw   ; a を退避
85B1                             ; R[a+1] のスロットアドレスを求める
85B1   CD 0A 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85B4   CD 41 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
85B7   EB                     XCHG      ; DE = R[a+1] の値先頭
85B8   F1                     POP   psw   ; A = a
85B9                             ; R[a] のスロットアドレスを求める
85B9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85BC   CD 41 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85BF                             ; 32 ビット加算: val[a] += val[a+1]
85BF   CD 44 84               CALL   add_value32   
85C2   C3 A5 87               JMP   vm_loop   
85C5                             ; ---------------------------------------------------------------
85C5                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
85C5                             ; ---------------------------------------------------------------
85C5                DO_OP_SUB:      
85C5   CD B6 84               CALL   fetch_byte   ; A = a
85C8   F5                     PUSH   psw   
85C9   CD 0A 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85CC   CD 41 84               CALL   slot_to_value   
85CF   EB                     XCHG      ; DE = R[a+1] の値先頭
85D0   F1                     POP   psw   ; A = a
85D1   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85D4   CD 41 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85D7   CD 57 84               CALL   sub_value32   
85DA   C3 A5 87               JMP   vm_loop   
85DD                             ; ---------------------------------------------------------------
85DD                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
85DD                             ; 
85DD                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
85DD                             ; ---------------------------------------------------------------
85DD                DO_OP_ADDI:      
85DD   CD B6 84               CALL   fetch_byte   ; A = a
85E0   F5                     PUSH   psw   
85E1   CD B6 84               CALL   fetch_byte   ; A = b (即値)
85E4   4F                     MOV   c,a   ; C = b
85E5   F1                     POP   psw   ; A = a
85E6   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85E9   CD 41 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85EC   7E                     MOV   a,m   ; byte0
85ED   81                     ADD   c   ; byte0 + b (CY = 桁上げ)
85EE   77                     MOV   m,a   
85EF   23                     INX   h   
85F0   7E                     MOV   a,m   ; byte1 (MOV はフラグを変えない)
85F1   CE 00                  ACI   0   ; byte1 + CY
85F3   77                     MOV   m,a   
85F4   23                     INX   h   
85F5   7E                     MOV   a,m   ; byte2
85F6   CE 00                  ACI   0   
85F8   77                     MOV   m,a   
85F9   23                     INX   h   
85FA   7E                     MOV   a,m   ; byte3
85FB   CE 00                  ACI   0   
85FD   77                     MOV   m,a   
85FE   C3 A5 87               JMP   vm_loop   
8601                             ; ---------------------------------------------------------------
8601                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
8601                             ; ---------------------------------------------------------------
8601                DO_OP_SUBI:      
8601   CD B6 84               CALL   fetch_byte   ; A = a
8604   F5                     PUSH   psw   
8605   CD B6 84               CALL   fetch_byte   ; A = b (即値)
8608   4F                     MOV   c,a   ; C = b
8609   F1                     POP   psw   ; A = a
860A   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
860D   CD 41 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
8610   7E                     MOV   a,m   ; byte0
8611   91                     SUB   c   ; byte0 - b (CY = 借り)
8612   77                     MOV   m,a   
8613   23                     INX   h   
8614   7E                     MOV   a,m   ; byte1
8615   DE 00                  SBI   0   ; byte1 - CY
8617   77                     MOV   m,a   
8618   23                     INX   h   
8619   7E                     MOV   a,m   ; byte2
861A   DE 00                  SBI   0   
861C   77                     MOV   m,a   
861D   23                     INX   h   
861E   7E                     MOV   a,m   ; byte3
861F   DE 00                  SBI   0   
8621   77                     MOV   m,a   
8622   C3 A5 87               JMP   vm_loop   
8625                             ; vm_compare.a80 — 比較命令
8625                             ; 
8625                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
8625                             ; 
8625                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
8625                             ; Phase 1 は整数のみ。
8625                             ; 
8625                             ; cmp_value32 は結果を A で返す:
8625                             ;   A = 00h → 等しい
8625                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
8625                             ;   A = 01h → val1 > val2
8625                             ; 
8625                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
8625                             ; スタックにアドレスを残す方式は CALL の戻りアドレスと衝突するので避ける。
8625                             ; ---------------------------------------------------------------
8625                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
8625                             ; 
8625                             ;   出力: A = 比較結果 (00h/FFh/01h)
8625                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
8625                             ;   破壊: A, B, C, HL, DE
8625                             ; ---------------------------------------------------------------
8625                CMP_REG_PAIR:      
8625   CD B6 84               CALL   fetch_byte   
8628   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
862B                             ; R[a+1] の値先頭
862B   CD 0A 84               CALL   get_reg_addr_next   
862E   CD 41 84               CALL   slot_to_value   
8631   EB                     XCHG      ; DE = R[a+1] 値先頭
8632                             ; R[a] の値先頭
8632   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8635   CD 03 84               CALL   get_reg_addr   
8638   CD 41 84               CALL   slot_to_value   ; HL = R[a] 値先頭
863B   CD 72 84               CALL   cmp_value32   ; A = 結果
863E   C9                     RET      
863F                             ; ---------------------------------------------------------------
863F                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
863F                             ; 
863F                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
863F                             ; ---------------------------------------------------------------
863F                CMP_SET_TRUE:      
863F   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8642   CD 03 84               CALL   get_reg_addr   
8645   3E 03                  MVI   a,TT_TRUE   
8647   CD 22 84               CALL   set_slot_special   
864A   C3 A5 87               JMP   vm_loop   
864D                CMP_SET_FALSE:      
864D   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8650   CD 03 84               CALL   get_reg_addr   
8653   3E 02                  MVI   a,TT_FALSE   
8655   CD 22 84               CALL   set_slot_special   
8658   C3 A5 87               JMP   vm_loop   
865B                             ; ---------------------------------------------------------------
865B                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
865B                             ; 
865B                             ; 型タグと値の両方が一致したときだけ true。
865B                             ; cmp_value32 は値しか見ないため、型タグは別途比べる。
865B                             ; ---------------------------------------------------------------
865B                DO_OP_EQ:      
865B   CD B6 84               CALL   fetch_byte   
865E   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
8661                             ; R[a] と R[a+1] のスロットアドレスを求める
8661   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8664   E5                     PUSH   h   ; R[a] を退避
8665   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8668   CD 0A 84               CALL   get_reg_addr_next   ; HL = R[a+1]
866B   D1                     POP   d   ; DE = R[a]
866C                             ; HL = R[a+1], DE = R[a]
866C                             ; 型タグを比べる
866C   46                     MOV   b,m   ; B = R[a+1].type
866D   1A                     LDAX   d   ; A = R[a].type
866E   B8                     CMP   b   
866F   C2 4D 86               JNZ   cmp_set_false   ; 型が違えば false
8672                             ; 型が同じ → 値を 4 バイト比べる
8672   23                     INX   h   
8673   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
8674   13                     INX   d   
8675   13                     INX   d   ; DE = R[a] + 2 (値先頭)
8676   0E 04                  MVI   c,4   
8678                EQ_CMP_LOOP:      
8678   1A                     LDAX   d   ; A = R[a] のバイト
8679   BE                     CMP   m   ; R[a] - R[a+1]
867A   C2 4D 86               JNZ   cmp_set_false   
867D   23                     INX   h   
867E   13                     INX   d   
867F   0D                     DCR   c   
8680   C2 78 86               JNZ   eq_cmp_loop   
8683   C3 3F 86               JMP   cmp_set_true   ; すべて一致
8686                             ; ---------------------------------------------------------------
8686                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
8686                             ; ---------------------------------------------------------------
8686                DO_OP_LT:      
8686   CD 25 86               CALL   cmp_reg_pair   ; A = 結果
8689   B7                     ORA   a   
868A   FA 3F 86               JM   cmp_set_true   ; A = FFh → val1 < val2
868D   C3 4D 86               JMP   cmp_set_false   
8690                             ; ---------------------------------------------------------------
8690                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
8690                             ; ---------------------------------------------------------------
8690                DO_OP_LE:      
8690   CD 25 86               CALL   cmp_reg_pair   
8693   B7                     ORA   a   
8694   FA 3F 86               JM   cmp_set_true   ; val1 < val2
8697   CA 3F 86               JZ   cmp_set_true   ; val1 == val2
869A   C3 4D 86               JMP   cmp_set_false   
869D                             ; ---------------------------------------------------------------
869D                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
869D                             ; ---------------------------------------------------------------
869D                DO_OP_GT:      
869D   CD 25 86               CALL   cmp_reg_pair   
86A0   B7                     ORA   a   
86A1   CA 4D 86               JZ   cmp_set_false   ; val1 == val2
86A4   F2 3F 86               JP   cmp_set_true   ; A = 01h → val1 > val2
86A7   C3 4D 86               JMP   cmp_set_false   ; A = FFh → val1 < val2
86AA                             ; ---------------------------------------------------------------
86AA                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
86AA                             ; ---------------------------------------------------------------
86AA                DO_OP_GE:      
86AA   CD 25 86               CALL   cmp_reg_pair   
86AD   B7                     ORA   a   
86AE   FA 4D 86               JM   cmp_set_false   ; val1 < val2
86B1   C3 3F 86               JMP   cmp_set_true   ; val1 >= val2
86B4                             ; vm_jump.a80 — ジャンプ命令
86B4                             ; 
86B4                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
86B4                             ; 
86B4                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
86B4                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
86B4                             ; ---------------------------------------------------------------
86B4                             ; apply_jump — PC に符号付きオフセットを加える
86B4                             ; 
86B4                             ;   入力: HL = 符号付き 16 ビットオフセット
86B4                             ;   出力: なし (PC が更新される)
86B4                             ;   破壊: A, HL, DE
86B4                             ; ---------------------------------------------------------------
86B4                APPLY_JUMP:      
86B4   EB                     XCHG      ; DE = オフセット
86B5   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
86B8   19                     DAD   d   ; HL = PC + オフセット
86B9   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
86BC   C9                     RET      
86BD                             ; ---------------------------------------------------------------
86BD                             ; OP_JMP (S): PC += signed16(a)
86BD                             ; ---------------------------------------------------------------
86BD                DO_OP_JMP:      
86BD   CD D0 84               CALL   fetch_s16be   ; HL = オフセット
86C0   CD B4 86               CALL   apply_jump   
86C3   C3 A5 87               JMP   vm_loop   
86C6                             ; ---------------------------------------------------------------
86C6                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
86C6                             ; 
86C6                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
86C6                             ; ---------------------------------------------------------------
86C6                DO_OP_JMPIF:      
86C6   CD B6 84               CALL   fetch_byte   ; A = a (レジスタ番号)
86C9   F5                     PUSH   psw   
86CA   CD D0 84               CALL   fetch_s16be   ; HL = オフセット
86CD   E5                     PUSH   h   ; オフセットを退避
86CE   D1                     POP   d   ; DE = オフセット
86CF   F1                     POP   psw   ; A = a
86D0   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
86D3   CD 3F 84               CALL   get_slot_type   ; A = 型タグ
86D6   FE 03                  CPI   TT_FALSY_MAX + 1   
86D8   DA E2 86               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
86DB                             ; 真 → ジャンプする
86DB   EB                     XCHG      ; HL = オフセット (DE にあった)
86DC   CD B4 86               CALL   apply_jump   
86DF   C3 A5 87               JMP   vm_loop   
86E2                JMPIF_SKIP:      
86E2   C3 A5 87               JMP   vm_loop   
86E5                             ; ---------------------------------------------------------------
86E5                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
86E5                             ; ---------------------------------------------------------------
86E5                DO_OP_JMPNOT:      
86E5   CD B6 84               CALL   fetch_byte   ; A = a
86E8   F5                     PUSH   psw   
86E9   CD D0 84               CALL   fetch_s16be   ; HL = オフセット
86EC   E5                     PUSH   h   
86ED   D1                     POP   d   ; DE = オフセット
86EE   F1                     POP   psw   ; A = a
86EF   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
86F2   CD 3F 84               CALL   get_slot_type   ; A = 型タグ
86F5   FE 03                  CPI   TT_FALSY_MAX + 1   
86F7   D2 01 87               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
86FA                             ; 偽 → ジャンプする
86FA   EB                     XCHG      ; HL = オフセット
86FB   CD B4 86               CALL   apply_jump   
86FE   C3 A5 87               JMP   vm_loop   
8701                JMPNOT_SKIP:      
8701   C3 A5 87               JMP   vm_loop   
8704                             ; vm_display.a80 — 7 セグメント表示
8704                             ; 
8704                             ; 32 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
8704                             ; セグメントパターンは seg_table にまとめる。
8704                             ; ---------------------------------------------------------------
8704                             ; display_hex32 — 32 ビット値を 7 セグに表示
8704                             ; 
8704                             ;   入力: HL = 値の先頭 (byte0, リトルエンディアン)
8704                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
8704                             ;   破壊: A, B, C, HL, DE
8704                             ; 
8704                             ; MSB (byte3) から表示する。byte3 の上位ニブルが桁 0、
8704                             ; byte0 の下位ニブルが桁 7。
8704                             ; ---------------------------------------------------------------
8704                DISPLAY_HEX32:      
8704                             ; byte3 (MSB) へ移動
8704   23                     INX   h   
8705   23                     INX   h   
8706   23                     INX   h   ; HL = byte3
8707   11 00 FE               LXI   d,DISPLAY_BASE   
870A   0E 04                  MVI   c,4   ; 4 バイト (= 8 ニブル)
870C                DISPLAY_BYTE_LOOP:      
870C                             ; 上位ニブル
870C   7E                     MOV   a,m   
870D   0F                     RRC      
870E   0F                     RRC      
870F   0F                     RRC      
8710   0F                     RRC      
8711   E6 0F                  ANI   0Fh   
8713   CD 26 87               CALL   nibble_to_seg   
8716   12                     STAX   d   
8717   13                     INX   d   
8718                             ; 下位ニブル
8718   7E                     MOV   a,m   
8719   E6 0F                  ANI   0Fh   
871B   CD 26 87               CALL   nibble_to_seg   
871E   12                     STAX   d   
871F   13                     INX   d   
8720                             ; 次のバイト (MSB → LSB)
8720   2B                     DCX   h   
8721   0D                     DCR   c   
8722   C2 0C 87               JNZ   display_byte_loop   
8725   C9                     RET      
8726                             ; ---------------------------------------------------------------
8726                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
8726                             ; 
8726                             ;   入力: A = 0-F
8726                             ;   出力: A = セグメントパターン
8726                             ;   破壊: なし (HL, BC は内部で退避・復元)
8726                             ; ---------------------------------------------------------------
8726                NIBBLE_TO_SEG:      
8726   E5                     PUSH   h   
8727   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
8728   6F                     MOV   l,a   
8729   26 00                  MVI   h,0   
872B   01 33 87               LXI   b,seg_table   
872E   09                     DAD   b   ; HL = seg_table + nibble
872F   7E                     MOV   a,m   
8730   C1                     POP   b   ; BC を復元
8731   E1                     POP   h   
8732   C9                     RET      
8733                             ; ---------------------------------------------------------------
8733                             ; 7 セグメントパターンテーブル
8733                             ; 
8733                             ;   bit 0 = a (上)
8733                             ;   bit 1 = b (右上)
8733                             ;   bit 2 = c (右下)
8733                             ;   bit 3 = d (下)
8733                             ;   bit 4 = e (左下)
8733                             ;   bit 5 = f (左上)
8733                             ;   bit 6 = g (中)
8733                             ; 
8733                             ;       aaa
8733                             ;      f   b
8733                             ;       ggg
8733                             ;      e   c
8733                             ;       ddd
8733                             ; ---------------------------------------------------------------
8733                SEG_TABLE:      
8733   3F                     DB   3Fh   ; 0: abcdef
8734   06                     DB   06h   ; 1: bc
8735   5B                     DB   5Bh   ; 2: abdeg
8736   4F                     DB   4Fh   ; 3: abcdg
8737   66                     DB   66h   ; 4: bcfg
8738   6D                     DB   6Dh   ; 5: acdfg
8739   7D                     DB   7Dh   ; 6: acdefg
873A   07                     DB   07h   ; 7: abc
873B   7F                     DB   7Fh   ; 8: abcdefg
873C   6F                     DB   6Fh   ; 9: abcdfg
873D   77                     DB   77h   ; A: abcefg
873E   7C                     DB   7Ch   ; b: cdefg
873F   39                     DB   39h   ; C: adef
8740   5E                     DB   5Eh   ; d: bcdeg
8741   79                     DB   79h   ; E: adefg
8742   71                     DB   71h   ; F: aefg
8743                             ; ===============================================================
8743                             ; OP_RETURN (B): トップレベルでは VM 停止
8743                             ; 
8743                             ; Phase 1 ではメソッド呼び出しが無いため、常にトップレベル。
8743                             ; R[a] の値を 7 セグに表示して停止する。
8743                             ; ===============================================================
8743                DO_OP_RETURN:      
8743   CD B6 84               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
8746   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8749   CD 41 84               CALL   slot_to_value   ; HL = R[a] の値先頭
874C   CD 04 87               CALL   display_hex32   
874F   3E 02                  MVI   a,VM_FINISHED   
8751   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8754   C3 78 87               JMP   vm_halt   
8757                             ; ===============================================================
8757                             ; OP_STOP (Z): VM 停止
8757                             ; ===============================================================
8757                DO_OP_STOP:      
8757   3E 02                  MVI   a,VM_FINISHED   
8759   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
875C                             ; R[1] の値を 7 セグに表示
875C   3E 01                  MVI   a,1   
875E   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8761   CD 41 84               CALL   slot_to_value   ; HL = R[1] の値先頭
8764   CD 04 87               CALL   display_hex32   
8767   C3 78 87               JMP   vm_halt   
876A                             ; ===============================================================
876A                             ; エラー停止
876A                             ; 
876A                             ; 未対応のオペコードを踏んだとき。
876A                             ; 現在のオペコードをエラーコードとして保存する。
876A                             ; ===============================================================
876A                VM_ERROR:      
876A   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
876D   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
8770   3E 03                  MVI   a,VM_ERROR   
8772   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8775   C3 78 87               JMP   vm_halt   
8778                             ; ===============================================================
8778                             ; 停止
8778                             ; ===============================================================
8778                VM_HALT:      
8778   76                     HLT      
8779                             ; ===============================================================
8779                             ; 初期化
8779                             ; ===============================================================
8779                VM_START:      
8779                             ; スタックポインタを設定
8779   31 00 FE               LXI   sp,STACK_TOP + 1   
877C                             ; VM 状態領域をゼロクリア (256 バイト)
877C   21 00 80               LXI   h,VM_STATE_BASE   
877F   0E 00                  MVI   c,0   ; 256 回 (0 は 256 として扱う)
8781                VM_CLEAR_STATE:      
8781   36 00                  MVI   m,0   
8783   23                     INX   h   
8784   0D                     DCR   c   
8785   C2 81 87               JNZ   vm_clear_state   
8788                             ; レジスタファイルをゼロクリア (256 バイト)
8788   21 00 81               LXI   h,REG_FILE_BASE   
878B   0E 00                  MVI   c,0   
878D                VM_CLEAR_REGS:      
878D   36 00                  MVI   m,0   
878F   23                     INX   h   
8790   0D                     DCR   c   
8791   C2 8D 87               JNZ   vm_clear_regs   
8794                             ; IREP 0 のバイトコード長を VM 状態に設定
8794                             ; IREP テーブルの先頭エントリから読む
8794   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
8797   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
879A   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
879D   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
87A0                             ; PC = 0 (ゼロクリア済み)
87A0                             ; 実行状態を RUNNING に設定
87A0   3E 01                  MVI   a,VM_RUNNING   
87A2   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
87A5                             ; メインループへ
87A5                             ; fall through
87A5                             ; ===============================================================
87A5                             ; メインループ (fetch-decode-execute)
87A5                             ; ===============================================================
87A5                VM_LOOP:      
87A5                             ; --- 実行状態の確認 ---
87A5   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
87A8   FE 01                  CPI   VM_RUNNING   
87AA   C2 78 87               JNZ   vm_halt   
87AD                             ; --- PC がバイトコード長を超えていないか ---
87AD   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
87B0   EB                     XCHG      ; DE = PC
87B1   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
87B4                             ; HL = bytecode_len, DE = PC
87B4                             ; PC >= bytecode_len ならエラー
87B4   7B                     MOV   a,e   
87B5   95                     SUB   l   
87B6   7A                     MOV   a,d   
87B7   9C                     SBB   h   ; DE - HL (PC - len)
87B8   D2 03 00               JNC   vm_error   ; PC >= len → エラー
87BB                             ; --- オペコードフェッチ ---
87BB   CD B6 84               CALL   fetch_byte   ; A = opcode
87BE   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
87C1                             ; --- ステップカウント ---
87C1   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
87C4   23                     INX   h   
87C5   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
87C8                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
87C8   7C                     MOV   a,h   
87C9   B5                     ORA   l   
87CA   C2 D4 87               JNZ   vm_dispatch   
87CD   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
87D0   23                     INX   h   
87D1   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
87D4                             ; --- ディスパッチ ---
87D4                VM_DISPATCH:      
87D4   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
87D7                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
87D7   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
87D8   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
87DB   5F                     MOV   e,a   
87DC   16 00                  MVI   d,0   ; DE = opcode * 2
87DE   21 F6 87               LXI   h,dispatch_table   
87E1   19                     DAD   d   ; HL = &dispatch_table[opcode]
87E2                             ; テーブル上限チェック
87E2   11 CA 88               LXI   d,dispatch_table_end   
87E5   7B                     MOV   a,e   
87E6   95                     SUB   l   
87E7   7A                     MOV   a,d   
87E8   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
87E9   DA 03 00               JC   vm_error   ; テーブル範囲外
87EC                             ; アドレスを読んでジャンプ
87EC   5E                     MOV   e,m   ; E = 下位バイト
87ED   23                     INX   h   
87EE   56                     MOV   d,m   ; D = 上位バイト
87EF   EB                     XCHG      ; HL = ハンドラアドレス
87F0                             ; 0000h ならエラー (未実装マーカー)
87F0   7C                     MOV   a,h   
87F1   B5                     ORA   l   
87F2   CA 03 00               JZ   vm_error   
87F5   E9                     PCHL      ; ハンドラへジャンプ
87F6                             ; ===============================================================
87F6                             ; ディスパッチテーブル
87F6                             ; 
87F6                             ; オペコード番号順に 2 バイトのアドレスを並べる。
87F6                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
