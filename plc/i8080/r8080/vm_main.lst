0000                             ; vm_main.a80 — faRuby i8080 VM
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (拡張 RAM 搭載: 0x0000-0xFFFF) を想定。
0000                             ; 
0000                             ; 0x8400: 起動スタブ (SP 設定 + バンク切り替え + JMP vm_start)
0000                             ; 0x1000: VM 本体コード (拡張 RAM 領域)
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行する。
0000                             ; hex ロードは拡張 RAM モード (ポート 9C bit3=1) のまま行われるため、
0000                             ; 0x1000-0x7FFF のデータは直接拡張 RAM に書き込まれる。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; 
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; 
0000                             ; --- メモリマップ ---
0000                             ; 
0000                VM_CODE_ORG:   EQU   1000h   
0000                VM_ENTRY_POINT:   EQU   8400h   ; 起動スタブ (通常 RAM)
0000                BYTECODE_BASE:   EQU   5000h   
0000                BYTECODE_SIZE:   EQU   2000h   
0000                POOL_BASE:   EQU   7000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                INIT_METHOD_ID_STORE:   EQU   82FEh   ; initialize の method_id 格納アドレス
0000                             ; 
0000                             ; --- バリュースロット ---
0000                             ; 
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; 
0000                             ; --- VM 状態領域のオフセット ---
0000                             ; 
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                OFF_OBJ_SP:   EQU   1Bh   ; 1B  次の空きオブジェクトスロット
0000                OFF_INIT_METHOD_ID:   EQU   1Ch   ; 1B  initialize のメソッド ID
0000                OFF_POOL_BASE:   EQU   1Dh   ; 2B  現在の IREP の定数プール先頭
0000                OFF_COL_SP:   EQU   1Fh   ; 1B  次の空きコレクションスロット
0000                             ; 
0000                             ; --- IREP テーブルエントリ ---
0000                             ; 
0000                IREP_ENTRY_BYTES:   EQU   0Ah   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_SUBTREE_SIZE:   EQU   07h   ; 1B  DFS 前順サブツリーサイズ
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; 
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                             ; 
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_STRING:   EQU   07h   
0000                TT_ARRAY:   EQU   08h   
0000                TT_HASH:   EQU   09h   
0000                TT_OBJECT:   EQU   0Ah   
0000                TT_PROC:   EQU   0Ch   
0000                TT_CLASS:   EQU   0Dh   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; 
0000                             ; --- VM 実行状態 ---
0000                             ; 
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; 
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                             ; 
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   9000h   
0000                MAX_GLOBALS:   EQU   40h   ; グローバル変数の数
0000                             ; 
0000                             ; シンボル種別コード (上位バイト)
0000                SYM_KIND_USER_METHOD:   EQU   01h   ; ユーザー定義メソッド
0000                SYM_KIND_CLASS:   EQU   02h   ; クラス名
0000                SYM_KIND_IVAR:   EQU   03h   ; インスタンス変数
0000                             ; 
0000                             ; --- フレームスタック ---
0000                             ; 
0000                FRAME_STACK_BASE:   EQU   9100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   10h   
0000                             ; 
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; 
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_EACH:   EQU   02h   ; each (配列要素反復)
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                FRAME_KIND_NEW:   EQU   05h   ; Class#new → initialize
0000                             ; 
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; 
0000                             ; --- メソッド表 ---
0000                             ; 
0000                METHOD_TABLE_BASE:   EQU   91C0h   
0000                MAX_CLASSES:   EQU   08h   
0000                MAX_METHODS_PER_CLASS:   EQU   20h   
0000                METHOD_TABLE_SIZE:   EQU   0100h   
0000                CLASS_MAIN:   EQU   00h   
0000                METHOD_NEW:   EQU   1Ch   ; Class#new
0000                METHOD_DISPLAY:   EQU   1Dh   ; display(value)
0000                METHOD_GETKEY:   EQU   1Eh   ; getkey
0000                METHOD_PUTS:   EQU   1Fh   ; puts(value): ASCII 2 文字表示
0000                METHOD_SETSEG:   EQU   20h   ; setseg(pos, pattern)
0000                METHOD_RAND:   EQU   21h   ; rand(n)
0000                METHOD_SLICE:   EQU   22h   ; [](offset, length) 文字列スライス
0000                METHOD_LENGTH:   EQU   12h   ; length / size
0000                METHOD_CONCAT:   EQU   14h   ; << (文字列追記/配列追加)
0000                METHOD_EACH:   EQU   15h   ; each (配列要素反復)
0000                METHOD_PUSH:   EQU   16h   ; push (配列追加)
0000                KEYIN1_ADDR:   EQU   0616h   ; ND80Z モニタキー入力 (ブロッキング)
0000                KEY_ADDR:   EQU   0647h   ; ND80Z キー 1 回スキャン (ノンブロッキング)
0000                             ; 
0000                             ; バンク切り替え (ND8080 拡張 RAM)
0000                PORT_9C:   EQU   9Ch   ; I/O ポート 9C
0000                PORT_9C_BANK_BIT:   EQU   08h   ; bit3: ROM/RAM 切替
0000                CLONE_BUF:   EQU   0EF00h   ; ROM クローン用バッファ
0000                             ; 
0000                             ; --- オブジェクトプール ---
0000                             ; 
0000                OBJECT_POOL_BASE:   EQU   92C0h   
0000                MAX_OBJECTS:   EQU   20h   
0000                OBJECT_SLOT_SIZE:   EQU   20h   ; 32B/スロット
0000                OBJECT_HEADER_SIZE:   EQU   04h   
0000                MAX_IVARS:   EQU   07h   
0000                             ; 
0000                             ; --- コレクションプール (文字列・配列) ---
0000                             ; 
0000                COLLECTION_POOL_BASE:   EQU   96C0h   
0000                MAX_COL_SLOTS:   EQU   40h   
0000                COL_SLOT_SIZE:   EQU   24h   ; 36B/スロット
0000                COL_HEADER_SIZE:   EQU   02h   ; +0: type, +1: count
0000                COL_DATA_SIZE:   EQU   22h   ; データ領域 (34B)
0000                COL_MAX_STRING_LEN:   EQU   22h   
0000                COL_MAX_ARRAY_ELEMS:   EQU   08h   
0000                COL_TYPE_FREE:   EQU   00h   
0000                COL_TYPE_STRING:   EQU   01h   
0000                COL_TYPE_ARRAY:   EQU   02h   
0000                COL_TYPE_HASH:   EQU   03h   
0000                HASH_PAIR_BYTES:   EQU   08h   ; 8B/ペア (key+value)
0000                COL_MAX_HASH_PAIRS:   EQU   04h   ; 最大4ペア
0000                             ; 
0000                             ; --- Phase 1 オペコード ---
0000                             ; 
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; 
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                             ; 
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
0000                             ; 
0000                             ; 
0000                             ; ===============================================================
0000                             ; 起動スタブ (通常 RAM 0x8400)
0000                             ; 
0000                             ; 1. SP 設定
0000                             ; 2. 拡張 RAM バンク切り替え (OUT PORT_9C, F8h)
0000                             ; 3. vm_start へジャンプ
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行済み。
0000                             ; hex ロードは拡張 RAM モードのまま行われるため、
0000                             ; VM コード・バイトコード・プールは直接拡張 RAM に書き込まれる。
0000                             ; ===============================================================
8400                          .ORG   08400h   
8400                             ; 
8400                STARTUP_STUB:      
8400   31 00 FE               LXI   sp,STACK_TOP + 1   
8403   3E F8                  MVI   a,0F8h   
8405   D3 9C                  OUT   PORT_9C   
8407   C3 B9 1C               JMP   vm_start   
840A                             ; 
840A                             ; ===============================================================
840A                             ; VM 本体コード (拡張 RAM 0x1000-)
840A                             ; ===============================================================
1000                          .ORG   01000h   
1000                             ; 
1000                             ; ===============================================================
1000                             ; サブルーチン群 (.include で取り込む)
1000                             ; ===============================================================
1000                             ; vm_util.a80 — ユーティリティサブルーチン
1000                             ; 
1000                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
1000                             ; 他のすべてのモジュールがここに依存します。
1000                             ; 
1000                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
1000                             ;   +0: 型タグ (1B)
1000                             ;   +1: 予約   (1B, 常に 0)
1000                             ;   +2: val_lo (1B)
1000                             ;   +3: val_hi (1B)
1000                             ; 
1000                             ; ---------------------------------------------------------------
1000                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
1000                             ; 
1000                             ;   入力: A = レジスタ番号 (0-63)
1000                             ;   出力: HL = スロット先頭アドレス
1000                             ;   破壊: A
1000                             ; 
1000                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
1000                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
1000                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
1000                             ; ---------------------------------------------------------------
1000                GET_REG_ADDR:      
1000   87                     ADD   a   ; ×2
1001   87                     ADD   a   ; ×4 (オフセット、A に残る)
1002   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
1005   85                     ADD   l   ; A = base_lo + offset
1006   6F                     MOV   l,a   
1007   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
1009   8C                     ADC   h   ; A = base_hi + CY
100A   67                     MOV   h,a   
100B   C9                     RET      
100C                             ; 
100C                             ; ---------------------------------------------------------------
100C                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
100C                             ; 
100C                             ;   入力: A = レジスタ番号 a
100C                             ;   出力: HL = R[a+1] のスロット先頭アドレス
100C                             ;   破壊: A
100C                             ; ---------------------------------------------------------------
100C                GET_REG_ADDR_NEXT:      
100C   3C                     INR   a   
100D   C3 00 10               JMP   get_reg_addr   
1010                             ; 
1010                             ; ---------------------------------------------------------------
1010                             ; set_slot_int16 — スロットに 16 ビット整数を書く
1010                             ; 
1010                             ;   入力: HL = スロット先頭アドレス
1010                             ;          B  = val_hi (上位バイト)
1010                             ;          C  = val_lo (下位バイト)
1010                             ;   出力: なし
1010                             ;   破壊: HL
1010                             ; ---------------------------------------------------------------
1010                SET_SLOT_INT16:      
1010   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1012   23                     INX   h   
1013   36 00                  MVI   m,0   ; +1: 予約
1015   23                     INX   h   
1016   71                     MOV   m,c   ; +2: val_lo
1017   23                     INX   h   
1018   70                     MOV   m,b   ; +3: val_hi
1019   C9                     RET      
101A                             ; 
101A                             ; ---------------------------------------------------------------
101A                             ; set_slot_special — 値を持たない型をスロットに書く
101A                             ; 
101A                             ;   入力: HL = スロット先頭アドレス
101A                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
101A                             ;   出力: なし
101A                             ;   破壊: A, HL
101A                             ; ---------------------------------------------------------------
101A                SET_SLOT_SPECIAL:      
101A   77                     MOV   m,a   ; +0: 型タグ
101B   23                     INX   h   
101C   36 00                  MVI   m,0   ; +1: 予約
101E   23                     INX   h   
101F   36 00                  MVI   m,0   ; +2: val_lo = 0
1021   23                     INX   h   
1022   36 00                  MVI   m,0   ; +3: val_hi = 0
1024   C9                     RET      
1025                             ; 
1025                             ; ---------------------------------------------------------------
1025                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
1025                             ; 
1025                             ;   入力: HL = コピー元先頭
1025                             ;         DE = コピー先先頭
1025                             ;   出力: なし
1025                             ;   破壊: A, C, HL, DE
1025                             ; ---------------------------------------------------------------
1025                COPY_SLOT:      
1025   0E 04                  MVI   c,SLOT_BYTES   
1027                COPY_SLOT_LOOP:      
1027   7E                     MOV   a,m   
1028   12                     STAX   d   
1029   23                     INX   h   
102A   13                     INX   d   
102B   0D                     DCR   c   
102C   C2 27 10               JNZ   copy_slot_loop   
102F   C9                     RET      
1030                             ; 
1030                             ; ---------------------------------------------------------------
1030                             ; get_slot_type — スロットの型タグを読む
1030                             ; 
1030                             ;   入力: HL = スロット先頭アドレス
1030                             ;   出力: A = 型タグ
1030                             ;   破壊: なし (HL 保存)
1030                             ; ---------------------------------------------------------------
1030                GET_SLOT_TYPE:      
1030   7E                     MOV   a,m   
1031   C9                     RET      
1032                             ; 
1032                             ; ---------------------------------------------------------------
1032                             ; slot_to_value — スロット先頭から値の先頭へ進める
1032                             ; 
1032                             ;   入力: HL = スロット先頭アドレス
1032                             ;   出力: HL = 値の先頭 (スロット +2)
1032                             ;   破壊: なし
1032                             ; ---------------------------------------------------------------
1032                SLOT_TO_VALUE:      
1032   23                     INX   h   
1033   23                     INX   h   
1034   C9                     RET      
1035                             ; 
1035                             ; ---------------------------------------------------------------
1035                             ; add_value16 — 16 ビット加算 (val1 += val2)
1035                             ; 
1035                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
1035                             ;         DE = 値 2 の先頭
1035                             ;   出力: 結果を HL の元の位置に上書き
1035                             ;   破壊: A, HL, DE
1035                             ; 
1035                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
1035                             ; ---------------------------------------------------------------
1035                ADD_VALUE16:      
1035   1A                     LDAX   d   ; A = val2[lo]
1036   86                     ADD   m   ; A += val1[lo]
1037   77                     MOV   m,a   ; val1[lo] = result
1038   23                     INX   h   
1039   13                     INX   d   
103A   1A                     LDAX   d   ; A = val2[hi]
103B   8E                     ADC   m   ; A += val1[hi] + CY
103C   77                     MOV   m,a   
103D   C9                     RET      
103E                             ; 
103E                             ; ---------------------------------------------------------------
103E                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
103E                             ; 
103E                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
103E                             ;         DE = 値 2 の先頭
103E                             ;   出力: 結果を HL の元の位置に上書き
103E                             ;   破壊: A, HL, DE
103E                             ; 
103E                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
103E                             ; ---------------------------------------------------------------
103E                SUB_VALUE16:      
103E   7E                     MOV   a,m   ; A = val1[lo]
103F   EB                     XCHG      ; HL=val2, DE=val1
1040   96                     SUB   m   ; A -= val2[lo]
1041   EB                     XCHG      ; HL=val1, DE=val2
1042   77                     MOV   m,a   ; val1[lo] = result
1043   23                     INX   h   
1044   13                     INX   d   
1045   7E                     MOV   a,m   ; A = val1[hi]
1046   EB                     XCHG      
1047   9E                     SBB   m   ; A -= val2[hi] - CY
1048   EB                     XCHG      
1049   77                     MOV   m,a   
104A   C9                     RET      
104B                             ; 
104B                             ; ---------------------------------------------------------------
104B                             ; cmp_value16 — 16 ビット符号付き比較
104B                             ; 
104B                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
104B                             ;         DE = 値 2 の先頭 (byte0 の位置)
104B                             ;   出力: A = 比較結果
104B                             ;           00h → val1 == val2
104B                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
104B                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
104B                             ;   破壊: A, B, HL, DE
104B                             ; 
104B                             ; 手順:
104B                             ;   1. 上位バイト (byte1) の符号ビットを比べる
104B                             ;   2. 符号が違えば、負の方が小さい
104B                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
104B                             ; ---------------------------------------------------------------
104B                CMP_VALUE16:      
104B                             ; byte1 (上位) の位置を求める
104B   23                     INX   h   ; HL = val1+1 (hi)
104C   13                     INX   d   ; DE = val2+1 (hi)
104D                             ; 符号ビットを比べる
104D   7E                     MOV   a,m   ; A = val1[hi]
104E   47                     MOV   b,a   ; B = val1[hi] (退避)
104F   1A                     LDAX   d   ; A = val2[hi]
1050   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
1051   F2 5D 10               JP   cmp16_same_sign   
1054                             ; 符号が違う: val1 が負なら val1 < val2
1054   78                     MOV   a,b   ; A = val1[hi]
1055   E6 80                  ANI   80h   ; bit7 を取り出す
1057   C2 71 10               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
105A   C3 74 10               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
105D                CMP16_SAME_SIGN:      
105D                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
105D   1A                     LDAX   d   
105E   BE                     CMP   m   ; val2[hi] - val1[hi]
105F   DA 74 10               JC   cmp16_ret_pos   
1062   C2 71 10               JNZ   cmp16_ret_neg   
1065   2B                     DCX   h   
1066   1B                     DCX   d   
1067   1A                     LDAX   d   
1068   BE                     CMP   m   ; val2[lo] - val1[lo]
1069   DA 74 10               JC   cmp16_ret_pos   
106C   C2 71 10               JNZ   cmp16_ret_neg   
106F                             ; すべて等しい
106F   AF                     XRA   a   ; A = 00h
1070   C9                     RET      
1071                CMP16_RET_NEG:      
1071   3E FF                  MVI   a,0FFh   ; val1 < val2
1073   C9                     RET      
1074                CMP16_RET_POS:      
1074   3E 01                  MVI   a,01h   ; val1 > val2
1076   C9                     RET      
1077                             ; 
1077                             ; ---------------------------------------------------------------
1077                             ; calc_child_irep — 子 irep 番号を算出
1077                             ; 
1077                             ;   入力: A = 子インデックス (オペランド b)
1077                             ;   出力: A = irep 番号
1077                             ;   破壊: B, C, DE, HL
1077                             ; 
1077                             ; pos = cur_irep + 1 から開始し、b 個のサブツリーを
1077                             ; subtree_size で飛ばして目的の子 irep 番号を求める。
1077                             ; OP_BLOCK, OP_METHOD, OP_EXEC の共通サブルーチン。
1077                             ; レジスタのみ使用 (メモリ変数なし): B=残りカウント, C=pos。
1077                             ; ---------------------------------------------------------------
1077                CALC_CHILD_IREP:      
1077   47                     MOV   b,a   ; B = スキップ回数
1078   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
107B   3C                     INR   a   ; A = cur_irep + 1
107C   4F                     MOV   c,a   ; C = pos
107D   78                     MOV   a,b   
107E   B7                     ORA   a   
107F   CA 99 10               JZ   cci_done   ; b == 0 → C をそのまま返す
1082                             ; 
1082                CCI_LOOP:      
1082                             ; HL = IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE + pos * 10
1082   79                     MOV   a,c   ; A = pos
1083   57                     MOV   d,a   ; D = pos (退避)
1084   87                     ADD   a   ; ×2
1085   5F                     MOV   e,a   ; E = ×2
1086   7A                     MOV   a,d   
1087   87                     ADD   a   ; ×2
1088   87                     ADD   a   ; ×4
1089   87                     ADD   a   ; ×8
108A   83                     ADD   e   ; ×10
108B   5F                     MOV   e,a   
108C   16 00                  MVI   d,0   
108E   21 07 82               LXI   h,IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE   
1091   19                     DAD   d   ; HL = &subtree_size[pos]
1092                             ; 
1092                             ; pos += subtree_size
1092   79                     MOV   a,c   
1093   86                     ADD   m   ; A = pos + subtree_size
1094   4F                     MOV   c,a   ; C = 新しい pos
1095                             ; 
1095   05                     DCR   b   
1096   C2 82 10               JNZ   cci_loop   
1099                             ; 
1099                CCI_DONE:      
1099   79                     MOV   a,c   ; A = 最終的な pos
109A   C9                     RET      
109B                             ; 
109B                             ; ---------------------------------------------------------------
109B                             ; class_of_reg — レジスタスロットからクラス番号を求める
109B                             ; 
109B                             ;   入力: HL = スロットアドレス
109B                             ;   出力: A = class_number
109B                             ;   破壊: B, DE, HL
109B                             ; 
109B                             ; - TT_CLASS  → val_lo (クラス自身の番号)
109B                             ; - TT_OBJECT, val_lo=0 → 0 (main)
109B                             ; - TT_OBJECT, val_lo>0 → OBJECT_POOL_BASE + (val-1)*32 のヘッダから読む
109B                             ; - その他 → 0 (main)
109B                             ; ---------------------------------------------------------------
109B                CLASS_OF_REG:      
109B   7E                     MOV   a,m   ; A = 型タグ
109C   FE 0D                  CPI   TT_CLASS   
109E   CA A8 10               JZ   cor_class   
10A1   FE 0A                  CPI   TT_OBJECT   
10A3   CA AC 10               JZ   cor_object   
10A6                             ; その他 → main (class 0)
10A6   AF                     XRA   a   
10A7   C9                     RET      
10A8                COR_CLASS:      
10A8                             ; val_lo = class_number
10A8   23                     INX   h   
10A9   23                     INX   h   
10AA   7E                     MOV   a,m   ; A = val_lo = class_number
10AB   C9                     RET      
10AC                COR_OBJECT:      
10AC                             ; val_lo = slot+1 (0=main)
10AC   23                     INX   h   
10AD   23                     INX   h   
10AE   7E                     MOV   a,m   ; A = val_lo
10AF   B7                     ORA   a   
10B0   C8                     RZ      ; val_lo==0 → main (A=0)
10B1                             ; slot = val_lo - 1, ヘッダアドレス = OBJECT_POOL_BASE + slot * 32
10B1   3D                     DCR   a   ; A = slot
10B2                             ; × 32 = 5 回の add a
10B2   87                     ADD   a   ; ×2
10B3   87                     ADD   a   ; ×4
10B4   87                     ADD   a   ; ×8
10B5   87                     ADD   a   ; ×16
10B6   87                     ADD   a   ; ×32
10B7   5F                     MOV   e,a   
10B8   16 00                  MVI   d,0   
10BA   21 C0 92               LXI   h,OBJECT_POOL_BASE   
10BD   19                     DAD   d   ; HL = スロット先頭
10BE   7E                     MOV   a,m   ; A = class_number (ヘッダ +0)
10BF   C9                     RET      
10C0                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
10C0                             ; 
10C0                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
10C0                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
10C0                             ; 
10C0                             ; ---------------------------------------------------------------
10C0                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
10C0                             ; 
10C0                             ;   入力: なし
10C0                             ;   出力: A = 読んだバイト
10C0                             ;   破壊: HL, DE
10C0                             ; 
10C0                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
10C0                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
10C0                             ; 子 irep の先頭に変わります。
10C0                             ; ---------------------------------------------------------------
10C0                FETCH_BYTE:      
10C0   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
10C3   EB                     XCHG      ; DE = PC
10C4   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
10C7   19                     DAD   d   ; HL = 絶対アドレス
10C8   7E                     MOV   a,m   ; A = bytecode[PC]
10C9                             ; PC をインクリメント
10C9   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
10CC   23                     INX   h   
10CD   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
10D0   C9                     RET      
10D1                             ; 
10D1                             ; ---------------------------------------------------------------
10D1                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
10D1                             ; 
10D1                             ;   入力: なし
10D1                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
10D1                             ;   破壊: A, B, DE
10D1                             ; 
10D1                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
10D1                             ; 1 バイト目が上位、2 バイト目が下位。
10D1                             ; ---------------------------------------------------------------
10D1                FETCH_U16BE:      
10D1   CD C0 10               CALL   fetch_byte   ; A = 上位バイト
10D4   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
10D5   CD C0 10               CALL   fetch_byte   ; A = 下位バイト
10D8   6F                     MOV   l,a   
10D9   60                     MOV   h,b   
10DA   C9                     RET      
10DB                             ; 
10DB                             ; ---------------------------------------------------------------
10DB                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
10DB                             ; 
10DB                             ;   入力: なし
10DB                             ;   出力: HL = 読んだ符号付き 16 ビット値
10DB                             ;   破壊: A, DE
10DB                             ; 
10DB                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
10DB                             ; ---------------------------------------------------------------
10DB                FETCH_S16BE:      
10DB   C3 D1 10               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
10DE                             ; vm_load.a80 — ロード命令
10DE                             ; 
10DE                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
10DE                             ; 
10DE                             ; Phase 2: 16 ビットスロット (4 バイト)
10DE                             ;   set_slot_int16: B=val_hi, C=val_lo
10DE                             ; 
10DE                             ; ---------------------------------------------------------------
10DE                             ; OP_NOP (Z): 何もしない
10DE                             ; ---------------------------------------------------------------
10DE                DO_OP_NOP:      
10DE   C3 86 1B               JMP   vm_loop   
10E1                             ; 
10E1                             ; ---------------------------------------------------------------
10E1                             ; OP_MOVE (BB): R[a] = R[b]
10E1                             ; ---------------------------------------------------------------
10E1                DO_OP_MOVE:      
10E1   CD C0 10               CALL   fetch_byte   ; A = a (コピー先)
10E4   F5                     PUSH   psw   
10E5   CD C0 10               CALL   fetch_byte   ; A = b (コピー元)
10E8   CD 00 10               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
10EB   EB                     XCHG      ; DE = R[b]
10EC   F1                     POP   psw   ; A = a
10ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
10F0   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
10F1   CD 25 10               CALL   copy_slot   
10F4   C3 86 1B               JMP   vm_loop   
10F7                             ; 
10F7                             ; ---------------------------------------------------------------
10F7                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
10F7                             ; ---------------------------------------------------------------
10F7                DO_OP_LOADI:      
10F7   CD C0 10               CALL   fetch_byte   ; A = a
10FA   F5                     PUSH   psw   
10FB   CD C0 10               CALL   fetch_byte   ; A = b (値)
10FE   4F                     MOV   c,a   ; C = val_lo
10FF   F1                     POP   psw   ; A = a
1100   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1103   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
1104   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
1106   CD 10 10               CALL   set_slot_int16   
1109   C3 86 1B               JMP   vm_loop   
110C                             ; 
110C                             ; ---------------------------------------------------------------
110C                             ; OP_LOADINEG (BB): R[a] = -b
110C                             ; ---------------------------------------------------------------
110C                DO_OP_LOADINEG:      
110C   CD C0 10               CALL   fetch_byte   ; A = a
110F   F5                     PUSH   psw   
1110   CD C0 10               CALL   fetch_byte   ; A = b
1113                             ; -b を計算 (0 - b)
1113   4F                     MOV   c,a   ; C = b (退避)
1114   AF                     XRA   a   ; A = 0
1115   91                     SUB   c   ; A = -b
1116   4F                     MOV   c,a   ; C = val_lo (-b)
1117   F1                     POP   psw   ; A = a
1118   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
111B   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
111D   CD 10 10               CALL   set_slot_int16   
1120   C3 86 1B               JMP   vm_loop   
1123                             ; 
1123                             ; ---------------------------------------------------------------
1123                             ; OP_LOADI__1 (B): R[a] = -1
1123                             ; ---------------------------------------------------------------
1123                DO_OP_LOADI__1:      
1123   CD C0 10               CALL   fetch_byte   ; A = a
1126   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1129   0E FF                  MVI   c,0FFh   ; val_lo = FFh
112B   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
112D   CD 10 10               CALL   set_slot_int16   
1130   C3 86 1B               JMP   vm_loop   
1133                             ; 
1133                             ; ---------------------------------------------------------------
1133                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
1133                             ; ---------------------------------------------------------------
1133                DO_OP_LOADI_0:      
1133   0E 00                  MVI   c,0   
1135   C3 58 11               JMP   loadi_small   
1138                DO_OP_LOADI_1:      
1138   0E 01                  MVI   c,1   
113A   C3 58 11               JMP   loadi_small   
113D                DO_OP_LOADI_2:      
113D   0E 02                  MVI   c,2   
113F   C3 58 11               JMP   loadi_small   
1142                DO_OP_LOADI_3:      
1142   0E 03                  MVI   c,3   
1144   C3 58 11               JMP   loadi_small   
1147                DO_OP_LOADI_4:      
1147   0E 04                  MVI   c,4   
1149   C3 58 11               JMP   loadi_small   
114C                DO_OP_LOADI_5:      
114C   0E 05                  MVI   c,5   
114E   C3 58 11               JMP   loadi_small   
1151                DO_OP_LOADI_6:      
1151   0E 06                  MVI   c,6   
1153   C3 58 11               JMP   loadi_small   
1156                DO_OP_LOADI_7:      
1156   0E 07                  MVI   c,7   
1158                LOADI_SMALL:      
1158                             ; C = 即値 (0-7)
1158   CD C0 10               CALL   fetch_byte   ; A = a
115B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
115E   06 00                  MVI   b,0   ; val_hi = 0 (正)
1160   CD 10 10               CALL   set_slot_int16   
1163   C3 86 1B               JMP   vm_loop   
1166                             ; 
1166                             ; ---------------------------------------------------------------
1166                             ; OP_LOADI16 (BS): R[a] = signed16(b)
1166                             ; 
1166                             ; b は符号付き 16 ビット (ビッグエンディアン)。
1166                             ; 16 ビットスロットではそのままネイティブサイズ。
1166                             ; 符号拡張は不要。
1166                             ; ---------------------------------------------------------------
1166                DO_OP_LOADI16:      
1166   CD C0 10               CALL   fetch_byte   ; A = a
1169   F5                     PUSH   psw   
116A   CD DB 10               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
116D   4D                     MOV   c,l   ; C = val_lo
116E   44                     MOV   b,h   ; B = val_hi
116F   F1                     POP   psw   ; A = a
1170   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1173                             ; 型タグと値を書く
1173   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1175   23                     INX   h   
1176   36 00                  MVI   m,0   ; +1: 予約
1178   23                     INX   h   
1179   71                     MOV   m,c   ; +2: val_lo
117A   23                     INX   h   
117B   70                     MOV   m,b   ; +3: val_hi
117C   C3 86 1B               JMP   vm_loop   
117F                             ; 
117F                             ; ---------------------------------------------------------------
117F                             ; OP_LOADNIL (B): R[a] = nil
117F                             ; ---------------------------------------------------------------
117F                DO_OP_LOADNIL:      
117F   CD C0 10               CALL   fetch_byte   ; A = a
1182   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1185   3E 01                  MVI   a,TT_NIL   
1187   CD 1A 10               CALL   set_slot_special   
118A   C3 86 1B               JMP   vm_loop   
118D                             ; 
118D                             ; ---------------------------------------------------------------
118D                             ; OP_LOADT (B): R[a] = true
118D                             ; ---------------------------------------------------------------
118D                DO_OP_LOADT:      
118D   CD C0 10               CALL   fetch_byte   ; A = a
1190   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1193   3E 03                  MVI   a,TT_TRUE   
1195   CD 1A 10               CALL   set_slot_special   
1198   C3 86 1B               JMP   vm_loop   
119B                             ; 
119B                             ; ---------------------------------------------------------------
119B                             ; OP_LOADF (B): R[a] = false
119B                             ; ---------------------------------------------------------------
119B                DO_OP_LOADF:      
119B   CD C0 10               CALL   fetch_byte   ; A = a
119E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11A1   3E 02                  MVI   a,TT_FALSE   
11A3   CD 1A 10               CALL   set_slot_special   
11A6   C3 86 1B               JMP   vm_loop   
11A9                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
11A9                             ; 
11A9                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
11A9                             ; 
11A9                             ; ---------------------------------------------------------------
11A9                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
11A9                             ; 
11A9                             ; R[a] の型で分岐:
11A9                             ;   TT_INTEGER: 16 ビット加算
11A9                             ;   TT_STRING:  文字列連結 (STRCAT と同じ)
11A9                             ; ---------------------------------------------------------------
11A9                DO_OP_ADD:      
11A9   CD C0 10               CALL   fetch_byte   ; A = a
11AC   F5                     PUSH   psw   
11AD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11B0   7E                     MOV   a,m   ; A = 型タグ
11B1   FE 07                  CPI   TT_STRING   
11B3   CA CC 11               JZ   add_string   
11B6                             ; --- 整数パス ---
11B6   F1                     POP   psw   ; A = a
11B7   F5                     PUSH   psw   
11B8                             ; R[a+1] のスロットアドレスを求める
11B8   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11BB   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
11BE   EB                     XCHG      ; DE = R[a+1] の値先頭
11BF   F1                     POP   psw   ; A = a
11C0                             ; R[a] のスロットアドレスを求める
11C0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11C3   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11C6                             ; 16 ビット加算: val[a] += val[a+1]
11C6   CD 35 10               CALL   add_value16   
11C9   C3 86 1B               JMP   vm_loop   
11CC                             ; --- 文字列パス ---
11CC                ADD_STRING:      
11CC   F1                     POP   psw   ; A = a
11CD   32 9C 22               STA   scat_reg_a   
11D0   C3 2C 22               JMP   strcat_body   ; do_op_strcat の本体を再利用
11D3                             ; 
11D3                             ; ---------------------------------------------------------------
11D3                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
11D3                             ; ---------------------------------------------------------------
11D3                DO_OP_SUB:      
11D3   CD C0 10               CALL   fetch_byte   ; A = a
11D6   F5                     PUSH   psw   
11D7   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11DA   CD 32 10               CALL   slot_to_value   
11DD   EB                     XCHG      ; DE = R[a+1] の値先頭
11DE   F1                     POP   psw   ; A = a
11DF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11E2   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11E5   CD 3E 10               CALL   sub_value16   
11E8   C3 86 1B               JMP   vm_loop   
11EB                             ; 
11EB                             ; ---------------------------------------------------------------
11EB                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
11EB                             ; 
11EB                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
11EB                             ; ---------------------------------------------------------------
11EB                DO_OP_ADDI:      
11EB   CD C0 10               CALL   fetch_byte   ; A = a
11EE   F5                     PUSH   psw   
11EF   CD C0 10               CALL   fetch_byte   ; A = b (即値)
11F2   4F                     MOV   c,a   ; C = b
11F3   F1                     POP   psw   ; A = a
11F4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11F7   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
11FA   7E                     MOV   a,m   ; val_lo
11FB   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
11FC   77                     MOV   m,a   
11FD   23                     INX   h   
11FE   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
11FF   CE 00                  ACI   0   ; val_hi + CY
1201   77                     MOV   m,a   
1202   C3 86 1B               JMP   vm_loop   
1205                             ; 
1205                             ; ---------------------------------------------------------------
1205                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
1205                             ; ---------------------------------------------------------------
1205                DO_OP_SUBI:      
1205   CD C0 10               CALL   fetch_byte   ; A = a
1208   F5                     PUSH   psw   
1209   CD C0 10               CALL   fetch_byte   ; A = b (即値)
120C   4F                     MOV   c,a   ; C = b
120D   F1                     POP   psw   ; A = a
120E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1211   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
1214   7E                     MOV   a,m   ; val_lo
1215   91                     SUB   c   ; val_lo - b (CY = 借り)
1216   77                     MOV   m,a   
1217   23                     INX   h   
1218   7E                     MOV   a,m   ; val_hi
1219   DE 00                  SBI   0   ; val_hi - CY
121B   77                     MOV   m,a   
121C   C3 86 1B               JMP   vm_loop   
121F                             ; 
121F                             ; ---------------------------------------------------------------
121F                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
121F                             ; 
121F                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
121F                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
121F                             ; ---------------------------------------------------------------
121F                DO_OP_MUL:      
121F   CD C0 10               CALL   fetch_byte   ; A = a
1222   F5                     PUSH   psw   
1223   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1226   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
1229   5E                     MOV   e,m   ; E = val2_lo
122A   23                     INX   h   
122B   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
122C   F1                     POP   psw   ; A = a
122D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1230   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1233   E5                     PUSH   h   ; 書き戻し先を退避
1234   4E                     MOV   c,m   
1235   23                     INX   h   
1236   46                     MOV   b,m   ; BC = 被乗数
1237   CD 6E 12               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
123A   D1                     POP   d   ; DE = 書き戻し先
123B   7D                     MOV   a,l   
123C   12                     STAX   d   
123D   13                     INX   d   
123E   7C                     MOV   a,h   
123F   12                     STAX   d   
1240   C3 86 1B               JMP   vm_loop   
1243                             ; 
1243                             ; ---------------------------------------------------------------
1243                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
1243                             ; 
1243                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
1243                             ; 除数 0 はエラー停止。
1243                             ; ---------------------------------------------------------------
1243                DO_OP_DIV:      
1243   CD C0 10               CALL   fetch_byte   ; A = a
1246   F5                     PUSH   psw   
1247   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
124A   CD 32 10               CALL   slot_to_value   
124D   5E                     MOV   e,m   
124E   23                     INX   h   
124F   56                     MOV   d,m   ; DE = 除数
1250                             ; ゼロ除算チェック
1250   7A                     MOV   a,d   
1251   B3                     ORA   e   
1252   C2 59 12               JNZ   do_div_nonzero   
1255   F1                     POP   psw   
1256   C3 03 00               JMP   vm_error   
1259                DO_DIV_NONZERO:      
1259   F1                     POP   psw   ; A = a
125A   CD 00 10               CALL   get_reg_addr   
125D   CD 32 10               CALL   slot_to_value   
1260   E5                     PUSH   h   ; 書き戻し先を退避
1261   4E                     MOV   c,m   
1262   23                     INX   h   
1263   46                     MOV   b,m   ; BC = 被除数
1264   CD 80 12               CALL   sdiv16   ; BC = 商
1267   E1                     POP   h   ; HL = 書き戻し先
1268   71                     MOV   m,c   
1269   23                     INX   h   
126A   70                     MOV   m,b   
126B   C3 86 1B               JMP   vm_loop   
126E                             ; 
126E                             ; ---------------------------------------------------------------
126E                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
126E                             ; 
126E                             ;   入力: BC = 被乗数, DE = 乗数
126E                             ;   出力: HL = 積の下位 16 ビット
126E                             ;   破壊: A, DE
126E                             ; ---------------------------------------------------------------
126E                UMUL16:      
126E   21 00 00               LXI   h,0   ; 積 = 0
1271   3E 10                  MVI   a,16   ; ビットカウンタ
1273                UMUL16_LOOP:      
1273   29                     DAD   h   ; 積 <<= 1
1274   EB                     XCHG      ; HL ↔ DE
1275   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
1276   EB                     XCHG      ; HL ↔ DE
1277   D2 7B 12               JNC   umul16_noadd   
127A   09                     DAD   b   ; 積 += 被乗数
127B                UMUL16_NOADD:      
127B   3D                     DCR   a   
127C   C2 73 12               JNZ   umul16_loop   
127F   C9                     RET      
1280                             ; 
1280                             ; ---------------------------------------------------------------
1280                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
1280                             ; 
1280                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1280                             ;   出力: BC = 商
1280                             ;   破壊: A, DE, HL
1280                             ; 
1280                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
1280                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
1280                             ; ---------------------------------------------------------------
1280                SDIV16:      
1280   78                     MOV   a,b   
1281   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
1282   F5                     PUSH   psw   ; 符号情報を退避
1283                             ; 被除数を正にする
1283   78                     MOV   a,b   
1284   E6 80                  ANI   80h   
1286   CA 8C 12               JZ   sdiv16_chk_div   
1289   CD DC 12               CALL   neg_bc   
128C                SDIV16_CHK_DIV:      
128C                             ; 除数を正にする
128C   7A                     MOV   a,d   
128D   E6 80                  ANI   80h   
128F   CA 95 12               JZ   sdiv16_do   
1292   CD E4 12               CALL   neg_de   
1295                SDIV16_DO:      
1295   CD A5 12               CALL   udiv16   ; BC = |商|, HL = |剰余|
1298   F1                     POP   psw   
1299   E6 80                  ANI   80h   
129B   C8                     RZ      ; 同符号 → 正の商をそのまま返す
129C                             ; 異符号: 剰余があれば floor 調整
129C   7C                     MOV   a,h   
129D   B5                     ORA   l   
129E   CA A2 12               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
12A1   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
12A2                SDIV16_NEG:      
12A2   C3 DC 12               JMP   neg_bc   
12A5                             ; 
12A5                             ; ---------------------------------------------------------------
12A5                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
12A5                             ; 
12A5                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
12A5                             ;   出力: BC = 商, HL = 剰余
12A5                             ;   破壊: A
12A5                             ; 
12A5                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
12A5                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
12A5                             ; ---------------------------------------------------------------
12A5                UDIV16:      
12A5   21 00 00               LXI   h,0   ; 剰余 = 0
12A8   3E 10                  MVI   a,16   
12AA   32 DB 12               STA   udiv_cnt   
12AD                UDIV16_LOOP:      
12AD                             ; BC を 1 ビット左シフト (MSB → CY)
12AD   79                     MOV   a,c   
12AE   87                     ADD   a   ; C <<= 1, bit7 → CY
12AF   4F                     MOV   c,a   
12B0   78                     MOV   a,b   
12B1   8F                     ADC   a   ; B <<= 1 + CY from C
12B2   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
12B3                             ; CY を剰余 (HL) にシフトイン
12B3   7D                     MOV   a,l   
12B4   17                     RAL      
12B5   6F                     MOV   l,a   
12B6   7C                     MOV   a,h   
12B7   17                     RAL      
12B8   67                     MOV   h,a   
12B9                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
12B9   DA C9 12               JC   udiv16_sub   
12BC                             ; 剰余 (HL) と 除数 (DE) を比較
12BC   7C                     MOV   a,h   
12BD   BA                     CMP   d   
12BE   DA D0 12               JC   udiv16_nosub   ; H < D → HL < DE
12C1   C2 C9 12               JNZ   udiv16_sub   ; H > D → HL > DE
12C4   7D                     MOV   a,l   
12C5   BB                     CMP   e   
12C6   DA D0 12               JC   udiv16_nosub   ; L < E → HL < DE
12C9                UDIV16_SUB:      
12C9                             ; 剰余 ≧ 除数: 減算して商ビット = 1
12C9   7D                     MOV   a,l   
12CA   93                     SUB   e   
12CB   6F                     MOV   l,a   
12CC   7C                     MOV   a,h   
12CD   9A                     SBB   d   
12CE   67                     MOV   h,a   
12CF   0C                     INR   c   ; 商の bit0 を立てる
12D0                UDIV16_NOSUB:      
12D0   3A DB 12               LDA   udiv_cnt   ; LDA は CY に影響しない
12D3   3D                     DCR   a   ; DCR は CY に影響しない
12D4   32 DB 12               STA   udiv_cnt   
12D7   C2 AD 12               JNZ   udiv16_loop   
12DA   C9                     RET      
12DB                             ; 
12DB                UDIV_CNT:      
12DB   00                     DB   0   
12DC                             ; 
12DC                             ; ---------------------------------------------------------------
12DC                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
12DC                             ; ---------------------------------------------------------------
12DC                NEG_BC:      
12DC   79                     MOV   a,c   
12DD   2F                     CMA      
12DE   4F                     MOV   c,a   
12DF   78                     MOV   a,b   
12E0   2F                     CMA      
12E1   47                     MOV   b,a   
12E2   03                     INX   b   
12E3   C9                     RET      
12E4                             ; 
12E4                NEG_DE:      
12E4   7B                     MOV   a,e   
12E5   2F                     CMA      
12E6   5F                     MOV   e,a   
12E7   7A                     MOV   a,d   
12E8   2F                     CMA      
12E9   57                     MOV   d,a   
12EA   13                     INX   d   
12EB   C9                     RET      
12EC                             ; vm_compare.a80 — 比較命令
12EC                             ; 
12EC                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
12EC                             ; 
12EC                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
12EC                             ; Phase 2 は整数のみ。
12EC                             ; 
12EC                             ; cmp_value16 は結果を A で返す:
12EC                             ;   A = 00h → 等しい
12EC                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
12EC                             ;   A = 01h → val1 > val2
12EC                             ; 
12EC                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
12EC                             ; 
12EC                             ; ---------------------------------------------------------------
12EC                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
12EC                             ; 
12EC                             ;   出力: A = 比較結果 (00h/FFh/01h)
12EC                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
12EC                             ;   破壊: A, B, HL, DE
12EC                             ; ---------------------------------------------------------------
12EC                CMP_REG_PAIR:      
12EC   CD C0 10               CALL   fetch_byte   
12EF   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
12F2                             ; R[a+1] の値先頭
12F2   CD 0C 10               CALL   get_reg_addr_next   
12F5   CD 32 10               CALL   slot_to_value   
12F8   EB                     XCHG      ; DE = R[a+1] 値先頭
12F9                             ; R[a] の値先頭
12F9   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
12FC   CD 00 10               CALL   get_reg_addr   
12FF   CD 32 10               CALL   slot_to_value   ; HL = R[a] 値先頭
1302   CD 4B 10               CALL   cmp_value16   ; A = 結果
1305   C9                     RET      
1306                             ; 
1306                             ; ---------------------------------------------------------------
1306                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
1306                             ; 
1306                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
1306                             ; ---------------------------------------------------------------
1306                CMP_SET_TRUE:      
1306   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1309   CD 00 10               CALL   get_reg_addr   
130C   3E 03                  MVI   a,TT_TRUE   
130E   CD 1A 10               CALL   set_slot_special   
1311   C3 86 1B               JMP   vm_loop   
1314                CMP_SET_FALSE:      
1314   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1317   CD 00 10               CALL   get_reg_addr   
131A   3E 02                  MVI   a,TT_FALSE   
131C   CD 1A 10               CALL   set_slot_special   
131F   C3 86 1B               JMP   vm_loop   
1322                             ; 
1322                             ; ---------------------------------------------------------------
1322                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
1322                             ; 
1322                             ; 型タグと値の両方が一致したときだけ true。
1322                             ; ---------------------------------------------------------------
1322                DO_OP_EQ:      
1322   CD C0 10               CALL   fetch_byte   
1325   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
1328                             ; R[a] と R[a+1] のスロットアドレスを求める
1328   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
132B   E5                     PUSH   h   ; R[a] を退避
132C   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
132F   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1332   D1                     POP   d   ; DE = R[a]
1333                             ; HL = R[a+1], DE = R[a]
1333                             ; 型タグを比べる
1333   46                     MOV   b,m   ; B = R[a+1].type
1334   1A                     LDAX   d   ; A = R[a].type
1335   B8                     CMP   b   
1336   C2 14 13               JNZ   cmp_set_false   ; 型が違えば false
1339                             ; 型が同じ → 値を 2 バイト比べる
1339   23                     INX   h   
133A   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
133B   13                     INX   d   
133C   13                     INX   d   ; DE = R[a] + 2 (値先頭)
133D   1A                     LDAX   d   ; A = R[a].val_lo
133E   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
133F   C2 14 13               JNZ   cmp_set_false   
1342   23                     INX   h   
1343   13                     INX   d   
1344   1A                     LDAX   d   ; A = R[a].val_hi
1345   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
1346   C2 14 13               JNZ   cmp_set_false   
1349   C3 06 13               JMP   cmp_set_true   ; すべて一致
134C                             ; 
134C                             ; ---------------------------------------------------------------
134C                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
134C                             ; ---------------------------------------------------------------
134C                DO_OP_LT:      
134C   CD EC 12               CALL   cmp_reg_pair   ; A = 結果
134F   B7                     ORA   a   
1350   FA 06 13               JM   cmp_set_true   ; A = FFh → val1 < val2
1353   C3 14 13               JMP   cmp_set_false   
1356                             ; 
1356                             ; ---------------------------------------------------------------
1356                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
1356                             ; ---------------------------------------------------------------
1356                DO_OP_LE:      
1356   CD EC 12               CALL   cmp_reg_pair   
1359   B7                     ORA   a   
135A   FA 06 13               JM   cmp_set_true   ; val1 < val2
135D   CA 06 13               JZ   cmp_set_true   ; val1 == val2
1360   C3 14 13               JMP   cmp_set_false   
1363                             ; 
1363                             ; ---------------------------------------------------------------
1363                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
1363                             ; ---------------------------------------------------------------
1363                DO_OP_GT:      
1363   CD EC 12               CALL   cmp_reg_pair   
1366   B7                     ORA   a   
1367   CA 14 13               JZ   cmp_set_false   ; val1 == val2
136A   F2 06 13               JP   cmp_set_true   ; A = 01h → val1 > val2
136D   C3 14 13               JMP   cmp_set_false   ; A = FFh → val1 < val2
1370                             ; 
1370                             ; ---------------------------------------------------------------
1370                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
1370                             ; ---------------------------------------------------------------
1370                DO_OP_GE:      
1370   CD EC 12               CALL   cmp_reg_pair   
1373   B7                     ORA   a   
1374   FA 14 13               JM   cmp_set_false   ; val1 < val2
1377   C3 06 13               JMP   cmp_set_true   ; val1 >= val2
137A                             ; vm_jump.a80 — ジャンプ命令
137A                             ; 
137A                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
137A                             ; 
137A                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
137A                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
137A                             ; 
137A                             ; ---------------------------------------------------------------
137A                             ; apply_jump — PC に符号付きオフセットを加える
137A                             ; 
137A                             ;   入力: HL = 符号付き 16 ビットオフセット
137A                             ;   出力: なし (PC が更新される)
137A                             ;   破壊: A, HL, DE
137A                             ; ---------------------------------------------------------------
137A                APPLY_JUMP:      
137A   EB                     XCHG      ; DE = オフセット
137B   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
137E   19                     DAD   d   ; HL = PC + オフセット
137F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1382   C9                     RET      
1383                             ; 
1383                             ; ---------------------------------------------------------------
1383                             ; OP_JMP (S): PC += signed16(a)
1383                             ; ---------------------------------------------------------------
1383                DO_OP_JMP:      
1383   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1386   CD 7A 13               CALL   apply_jump   
1389   C3 86 1B               JMP   vm_loop   
138C                             ; 
138C                             ; ---------------------------------------------------------------
138C                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
138C                             ; 
138C                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
138C                             ; ---------------------------------------------------------------
138C                DO_OP_JMPIF:      
138C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
138F   F5                     PUSH   psw   
1390   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1393   E5                     PUSH   h   ; オフセットを退避
1394   D1                     POP   d   ; DE = オフセット
1395   F1                     POP   psw   ; A = a
1396   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
1399   CD 30 10               CALL   get_slot_type   ; A = 型タグ
139C   FE 03                  CPI   TT_FALSY_MAX + 1   
139E   DA A8 13               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
13A1                             ; 真 → ジャンプする
13A1   EB                     XCHG      ; HL = オフセット (DE にあった)
13A2   CD 7A 13               CALL   apply_jump   
13A5   C3 86 1B               JMP   vm_loop   
13A8                JMPIF_SKIP:      
13A8   C3 86 1B               JMP   vm_loop   
13AB                             ; 
13AB                             ; ---------------------------------------------------------------
13AB                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
13AB                             ; ---------------------------------------------------------------
13AB                DO_OP_JMPNOT:      
13AB   CD C0 10               CALL   fetch_byte   ; A = a
13AE   F5                     PUSH   psw   
13AF   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
13B2   E5                     PUSH   h   
13B3   D1                     POP   d   ; DE = オフセット
13B4   F1                     POP   psw   ; A = a
13B5   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
13B8   CD 30 10               CALL   get_slot_type   ; A = 型タグ
13BB   FE 03                  CPI   TT_FALSY_MAX + 1   
13BD   D2 C7 13               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
13C0                             ; 偽 → ジャンプする
13C0   EB                     XCHG      ; HL = オフセット
13C1   CD 7A 13               CALL   apply_jump   
13C4   C3 86 1B               JMP   vm_loop   
13C7                JMPNOT_SKIP:      
13C7   C3 86 1B               JMP   vm_loop   
13CA                             ; vm_globals.a80 — グローバル変数・インスタンス変数アクセス
13CA                             ; 
13CA                             ; OP_GETGV, OP_SETGV, OP_GETIV, OP_SETIV
13CA                             ; 
13CA                             ; シンボルテーブル (SYM_TABLE_BASE) の 2 バイトエントリ (D,E) で振り分ける:
13CA                             ;   D >= 0x80      : グローバル変数アドレス (DE = アドレス)
13CA                             ;   D == 0x03      : インスタンス変数 (E = ivar_index)
13CA                             ;   D == 0, E == 0 : 未対応シンボル → エラー
13CA                             ; 
13CA                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
13CA                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
13CA                             ; 
13CA                             ; ---------------------------------------------------------------
13CA                             ; OP_GETGV / OP_GETIV (BB): R[a] = global[symbols[b]]
13CA                             ; ---------------------------------------------------------------
13CA                DO_OP_GETGV:      
13CA   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
13CD   F5                     PUSH   psw   
13CE   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
13D1                             ; シンボルテーブルからエントリを取得
13D1   87                     ADD   a   ; A = b * 2
13D2   5F                     MOV   e,a   
13D3   16 00                  MVI   d,0   
13D5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
13D8   19                     DAD   d   ; HL = &sym_table[b]
13D9   5E                     MOV   e,m   
13DA   23                     INX   h   
13DB   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
13DC                             ; 
13DC                             ; D == SYM_KIND_IVAR → インスタンス変数
13DC   7A                     MOV   a,d   
13DD   FE 03                  CPI   SYM_KIND_IVAR   
13DF   CA F8 13               JZ   getiv_handler   
13E2                             ; 
13E2                             ; アドレスが 0 なら未対応シンボル
13E2   7A                     MOV   a,d   
13E3   B3                     ORA   e   
13E4   C2 EB 13               JNZ   getgv_ok   
13E7   F1                     POP   psw   
13E8   C3 03 00               JMP   vm_error   
13EB                GETGV_OK:      
13EB   F1                     POP   psw   ; A = a
13EC   D5                     PUSH   d   ; グローバルアドレスを退避
13ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
13F0   EB                     XCHG      ; DE = R[a]
13F1   E1                     POP   h   ; HL = グローバルスロット (コピー元)
13F2   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
13F5   C3 86 1B               JMP   vm_loop   
13F8                             ; 
13F8                             ; --- IVAR GET ---
13F8                             ; E = ivar_index, スタックに a が積まれている
13F8                GETIV_HANDLER:      
13F8   7B                     MOV   a,e   
13F9   32 6C 14               STA   gv_ivar_idx   
13FC   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
13FF   F1                     POP   psw   ; A = a
1400   E5                     PUSH   h   ; IVAR アドレスを退避
1401   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1404   EB                     XCHG      ; DE = R[a]
1405   E1                     POP   h   ; HL = IVAR スロット (コピー元)
1406   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1409   C3 86 1B               JMP   vm_loop   
140C                             ; 
140C                             ; ---------------------------------------------------------------
140C                             ; OP_SETGV / OP_SETIV (BB): global[symbols[b]] = R[a]
140C                             ; ---------------------------------------------------------------
140C                DO_OP_SETGV:      
140C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
140F   F5                     PUSH   psw   
1410   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1413   87                     ADD   a   
1414   5F                     MOV   e,a   
1415   16 00                  MVI   d,0   
1417   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
141A   19                     DAD   d   ; HL = &sym_table[b]
141B   5E                     MOV   e,m   
141C   23                     INX   h   
141D   56                     MOV   d,m   ; DE = エントリ値
141E                             ; 
141E                             ; D == SYM_KIND_IVAR → インスタンス変数
141E   7A                     MOV   a,d   
141F   FE 03                  CPI   SYM_KIND_IVAR   
1421   CA 37 14               JZ   setiv_handler   
1424                             ; 
1424   7A                     MOV   a,d   
1425   B3                     ORA   e   
1426   C2 2D 14               JNZ   setgv_ok   
1429   F1                     POP   psw   
142A   C3 03 00               JMP   vm_error   
142D                SETGV_OK:      
142D   F1                     POP   psw   ; A = a
142E   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1431                             ; copy_slot: [HL] → [DE]
1431   CD 25 10               CALL   copy_slot   
1434   C3 86 1B               JMP   vm_loop   
1437                             ; 
1437                             ; --- IVAR SET ---
1437                             ; E = ivar_index, スタックに a が積まれている
1437                SETIV_HANDLER:      
1437   7B                     MOV   a,e   
1438   32 6C 14               STA   gv_ivar_idx   
143B   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
143E   EB                     XCHG      ; DE = IVAR スロット (コピー先)
143F   F1                     POP   psw   ; A = a
1440   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1443   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1446   C3 86 1B               JMP   vm_loop   
1449                             ; 
1449                             ; ---------------------------------------------------------------
1449                             ; calc_ivar_addr — R[0] (self) から IVAR スロットアドレスを算出
1449                             ; 
1449                             ;   入力: gv_ivar_idx = ivar_index
1449                             ;   出力: HL = OBJECT_POOL_BASE + (val_lo-1)*32 + 4 + ivar_index*4
1449                             ;   破壊: A, B, DE
1449                             ; 
1449                             ; R[0].val_lo = slot+1 (TT_OBJECT)
1449                             ; ---------------------------------------------------------------
1449                CALC_IVAR_ADDR:      
1449                             ; R[0] の val_lo を読む
1449   3E 00                  MVI   a,0   
144B   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
144E   23                     INX   h   
144F   23                     INX   h   
1450   7E                     MOV   a,m   ; A = val_lo (slot+1)
1451   3D                     DCR   a   ; A = slot
1452                             ; slot * 32
1452   87                     ADD   a   ; ×2
1453   87                     ADD   a   ; ×4
1454   87                     ADD   a   ; ×8
1455   87                     ADD   a   ; ×16
1456   87                     ADD   a   ; ×32
1457   5F                     MOV   e,a   
1458   16 00                  MVI   d,0   
145A   21 C0 92               LXI   h,OBJECT_POOL_BASE   
145D   19                     DAD   d   ; HL = スロット先頭
145E                             ; + OBJECT_HEADER_SIZE (4)
145E   11 04 00               LXI   d,OBJECT_HEADER_SIZE   
1461   19                     DAD   d   
1462                             ; + ivar_index * 4
1462   3A 6C 14               LDA   gv_ivar_idx   
1465   87                     ADD   a   ; ×2
1466   87                     ADD   a   ; ×4
1467   5F                     MOV   e,a   
1468   16 00                  MVI   d,0   
146A   19                     DAD   d   ; HL = IVAR スロットアドレス
146B   C9                     RET      
146C                             ; 
146C   00           GV_IVAR_IDX:   DB   0   
146D                             ; vm_send.a80 — メソッド呼び出し
146D                             ; 
146D                             ; OP_SEND, OP_SSEND
146D                             ; 
146D                             ; シンボルテーブルの 2 バイトエントリで振り分ける:
146D                             ;   D=0x00, E=1-31 : 組み込みメソッド
146D                             ;   D=0x01, E=id   : ユーザー定義メソッド
146D                             ;   D>=0x80         : グローバルアドレス (メソッドではない → エラー)
146D                             ; 
146D                             ; ---------------------------------------------------------------
146D                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
146D                             ; 
146D                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
146D                             ; ---------------------------------------------------------------
146D                DO_OP_SSEND:      
146D   CD C0 10               CALL   fetch_byte   ; A = a
1470   F5                     PUSH   psw   
1471   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1474   EB                     XCHG      ; DE = R[a]
1475   AF                     XRA   a   ; A = 0
1476   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (self)
1479   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
147C   F1                     POP   psw   ; A = a
147D   32 55 16               STA   send_reg_a   
1480   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1483   F5                     PUSH   psw   
1484   CD C0 10               CALL   fetch_byte   ; A = c (argc)
1487   32 56 16               STA   send_argc   
148A   F1                     POP   psw   ; A = b
148B   C3 9F 14               JMP   send_dispatch   
148E                             ; 
148E                             ; ---------------------------------------------------------------
148E                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
148E                             ; ---------------------------------------------------------------
148E                DO_OP_SEND:      
148E   CD C0 10               CALL   fetch_byte   ; A = a
1491   32 55 16               STA   send_reg_a   
1494   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1497   F5                     PUSH   psw   
1498   CD C0 10               CALL   fetch_byte   ; A = c (argc)
149B   32 56 16               STA   send_argc   
149E   F1                     POP   psw   ; A = b
149F                             ; 
149F                SEND_DISPATCH:      
149F                             ; シンボルテーブルからメソッド ID を取得
149F   87                     ADD   a   ; b * 2
14A0   5F                     MOV   e,a   
14A1   16 00                  MVI   d,0   
14A3   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
14A6   19                     DAD   d   
14A7   5E                     MOV   e,m   
14A8   23                     INX   h   
14A9   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=id)
14AA                             ; 
14AA                             ; D で振り分け
14AA   7A                     MOV   a,d   
14AB   B7                     ORA   a   
14AC   CA B7 14               JZ   send_builtin   ; D=0x00 → 組み込みメソッド
14AF   FE 01                  CPI   SYM_KIND_USER_METHOD   
14B1   CA E2 14               JZ   send_user_method   ; D=0x01 → ユーザー定義メソッド
14B4                             ; D >= 0x80 or other → エラー
14B4   C3 03 00               JMP   vm_error   
14B7                             ; 
14B7                SEND_BUILTIN:      
14B7                             ; E = メソッド ID (0 = 未対応)
14B7   7B                     MOV   a,e   
14B8   B7                     ORA   a   
14B9   CA 03 00               JZ   vm_error   
14BC                             ; 組み込みメソッドディスパッチ
14BC   FE 01                  CPI   1   
14BE   CA B0 15               JZ   send_ne   ; != (不等号)
14C1   FE 02                  CPI   2   
14C3   CA E5 15               JZ   send_not   ; !  (論理否定)
14C6   FE 03                  CPI   3   
14C8   CA 0D 16               JZ   send_mod   ; %  (剰余)
14CB   FE 04                  CPI   4   
14CD   CA 38 16               JZ   send_abs   ; abs (絶対値)
14D0   FE 1C                  CPI   METHOD_NEW   
14D2   CA 25 15               JZ   send_new   ; Class#new
14D5   FE 1D                  CPI   METHOD_DISPLAY   
14D7   CA 93 1D               JZ   send_display   ; display(value)
14DA   FE 1E                  CPI   METHOD_GETKEY   
14DC   CA AE 1D               JZ   send_getkey   ; getkey
14DF   C3 E9 1D               JMP   send_builtin_ext   ; 拡張ビルトイン (0xA800+ 領域)
14E2                             ; 
14E2                             ; ---------------------------------------------------------------
14E2                             ; send_user_method — ユーザー定義メソッド呼び出し
14E2                             ; 
14E2                             ; E = method_id。メソッド表から irep 番号を引き、
14E2                             ; push_frame + switch_irep で呼び出す。
14E2                             ; ---------------------------------------------------------------
14E2                SEND_USER_METHOD:      
14E2                             ; method_id を退避
14E2   7B                     MOV   a,e   
14E3   32 23 15               STA   sum_method_id   
14E6                             ; 
14E6                             ; R[a] から class_number を取得
14E6   3A 55 16               LDA   send_reg_a   
14E9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
14EC   CD 9B 10               CALL   class_of_reg   ; A = class_number
14EF                             ; 
14EF                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
14EF   87                     ADD   a   ; ×2
14F0   87                     ADD   a   ; ×4
14F1   87                     ADD   a   ; ×8
14F2   87                     ADD   a   ; ×16
14F3   87                     ADD   a   ; ×32
14F4   5F                     MOV   e,a   
14F5   16 00                  MVI   d,0   
14F7   21 C0 91               LXI   h,METHOD_TABLE_BASE   
14FA   19                     DAD   d   
14FB   3A 23 15               LDA   sum_method_id   
14FE   5F                     MOV   e,a   
14FF   16 00                  MVI   d,0   
1501   19                     DAD   d   ; HL = メソッド表エントリ
1502   7E                     MOV   a,m   ; A = irep 番号
1503   B7                     ORA   a   
1504   CA 03 00               JZ   vm_error   ; 0 = 未定義
1507   32 24 15               STA   sum_irep   
150A                             ; 
150A                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
150A   3A 55 16               LDA   send_reg_a   
150D   06 00                  MVI   b,FRAME_KIND_CALL   
150F   0E FF                  MVI   c,FRAME_NONE   
1511   CD A4 16               CALL   push_frame   
1514                             ; 
1514                             ; 子 irep に切り替え
1514   3A 24 15               LDA   sum_irep   
1517   CD 29 17               CALL   switch_irep   
151A                             ; 
151A                             ; PC = 0
151A   21 00 00               LXI   h,0   
151D   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1520   C3 86 1B               JMP   vm_loop   
1523                             ; 
1523   00           SUM_METHOD_ID:   DB   0   
1524   00           SUM_IREP:   DB   0   
1525                             ; 
1525                             ; ---------------------------------------------------------------
1525                             ; send_new — Class#new (オブジェクト生成)
1525                             ; 
1525                             ; 1. オブジェクトプールにスロットを確保
1525                             ; 2. R[a] を TT_OBJECT に設定 (val_lo = slot+1)
1525                             ; 3. initialize メソッドがあれば呼び出す
1525                             ; ---------------------------------------------------------------
1525                SEND_NEW:      
1525                             ; OBJ_SP < MAX_OBJECTS を確認
1525   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1528   FE 20                  CPI   MAX_OBJECTS   
152A   D2 03 00               JNC   vm_error   ; オブジェクトプール満杯
152D                             ; 
152D                             ; R[a] (TT_CLASS) から class_number を取得
152D   32 AC 15               STA   sn_slot   ; OBJ_SP = slot 番号
1530   3A 55 16               LDA   send_reg_a   
1533   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1536   CD 32 10               CALL   slot_to_value   
1539   7E                     MOV   a,m   ; A = class_number
153A   32 AD 15               STA   sn_class_num   
153D                             ; 
153D                             ; オブジェクトプールにヘッダを書く
153D                             ; OBJECT_POOL_BASE + slot * 32
153D   3A AC 15               LDA   sn_slot   
1540   87                     ADD   a   ; ×2
1541   87                     ADD   a   ; ×4
1542   87                     ADD   a   ; ×8
1543   87                     ADD   a   ; ×16
1544   87                     ADD   a   ; ×32
1545   5F                     MOV   e,a   
1546   16 00                  MVI   d,0   
1548   21 C0 92               LXI   h,OBJECT_POOL_BASE   
154B   19                     DAD   d   ; HL = スロット先頭
154C   3A AD 15               LDA   sn_class_num   
154F   77                     MOV   m,a   ; +0: class_number
1550                             ; 
1550                             ; R[a] = TT_OBJECT, val_lo = slot+1
1550   3A 55 16               LDA   send_reg_a   
1553   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1556   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1558   23                     INX   h   
1559   36 00                  MVI   m,0   ; +1: 予約
155B   23                     INX   h   
155C   3A AC 15               LDA   sn_slot   
155F   3C                     INR   a   ; slot + 1
1560   77                     MOV   m,a   ; +2: val_lo
1561   23                     INX   h   
1562   36 00                  MVI   m,0   ; +3: val_hi = 0
1564                             ; 
1564                             ; OBJ_SP++
1564   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1567   3C                     INR   a   
1568   32 1B 80               STA   VM_STATE_BASE + OFF_OBJ_SP   
156B                             ; 
156B                             ; initialize メソッドがあれば呼び出す
156B   3A 1C 80               LDA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
156E   B7                     ORA   a   
156F   CA 86 1B               JZ   vm_loop   ; INIT_METHOD_ID=0 → initialize なし
1572                             ; 
1572                             ; method_table[class * 32 + init_id] を引く
1572   32 AE 15               STA   sn_init_id   
1575   3A AD 15               LDA   sn_class_num   
1578   87                     ADD   a   
1579   87                     ADD   a   
157A   87                     ADD   a   
157B   87                     ADD   a   
157C   87                     ADD   a   ; class * 32
157D   5F                     MOV   e,a   
157E   16 00                  MVI   d,0   
1580   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1583   19                     DAD   d   
1584   3A AE 15               LDA   sn_init_id   
1587   5F                     MOV   e,a   
1588   16 00                  MVI   d,0   
158A   19                     DAD   d   ; HL = メソッド表エントリ
158B   7E                     MOV   a,m   ; A = irep 番号
158C   B7                     ORA   a   
158D   CA 86 1B               JZ   vm_loop   ; 未定義 → 呼ばない
1590   32 AF 15               STA   sn_init_irep   
1593                             ; 
1593                             ; push_frame(a, FRAME_KIND_NEW, FRAME_NONE)
1593   3A 55 16               LDA   send_reg_a   
1596   06 05                  MVI   b,FRAME_KIND_NEW   
1598   0E FF                  MVI   c,FRAME_NONE   
159A   CD A4 16               CALL   push_frame   
159D                             ; 
159D                             ; 子 irep に切り替え
159D   3A AF 15               LDA   sn_init_irep   
15A0   CD 29 17               CALL   switch_irep   
15A3                             ; 
15A3                             ; PC = 0
15A3   21 00 00               LXI   h,0   
15A6   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
15A9   C3 86 1B               JMP   vm_loop   
15AC                             ; 
15AC   00           SN_SLOT:   DB   0   
15AD   00           SN_CLASS_NUM:   DB   0   
15AE   00           SN_INIT_ID:   DB   0   
15AF   00           SN_INIT_IREP:   DB   0   
15B0                             ; 
15B0                             ; ---------------------------------------------------------------
15B0                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
15B0                             ; 
15B0                             ; スロット全体 (4 バイト) をバイト比較する。
15B0                             ; 型タグも含めて比較するので異なる型は常に true。
15B0                             ; ---------------------------------------------------------------
15B0                SEND_NE:      
15B0   3A 55 16               LDA   send_reg_a   
15B3   F5                     PUSH   psw   
15B4   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
15B7   EB                     XCHG      ; DE = R[a+1]
15B8   F1                     POP   psw   
15B9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15BC   0E 04                  MVI   c,SLOT_BYTES   
15BE                SEND_NE_CMP:      
15BE   1A                     LDAX   d   
15BF   BE                     CMP   m   
15C0   C2 D7 15               JNZ   send_ne_diff   
15C3   23                     INX   h   
15C4   13                     INX   d   
15C5   0D                     DCR   c   
15C6   C2 BE 15               JNZ   send_ne_cmp   
15C9                             ; 全バイト一致 → 等しい → false
15C9   3A 55 16               LDA   send_reg_a   
15CC   CD 00 10               CALL   get_reg_addr   
15CF   3E 02                  MVI   a,TT_FALSE   
15D1   CD 1A 10               CALL   set_slot_special   
15D4   C3 86 1B               JMP   vm_loop   
15D7                SEND_NE_DIFF:      
15D7   3A 55 16               LDA   send_reg_a   
15DA   CD 00 10               CALL   get_reg_addr   
15DD   3E 03                  MVI   a,TT_TRUE   
15DF   CD 1A 10               CALL   set_slot_special   
15E2   C3 86 1B               JMP   vm_loop   
15E5                             ; 
15E5                             ; ---------------------------------------------------------------
15E5                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
15E5                             ; 
15E5                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
15E5                             ; ---------------------------------------------------------------
15E5                SEND_NOT:      
15E5   3A 55 16               LDA   send_reg_a   
15E8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15EB   7E                     MOV   a,m   ; A = 型タグ
15EC   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
15EE   DA FF 15               JC   send_not_falsy   
15F1                             ; 真だった → false
15F1   3A 55 16               LDA   send_reg_a   
15F4   CD 00 10               CALL   get_reg_addr   
15F7   3E 02                  MVI   a,TT_FALSE   
15F9   CD 1A 10               CALL   set_slot_special   
15FC   C3 86 1B               JMP   vm_loop   
15FF                SEND_NOT_FALSY:      
15FF                             ; 偽だった → true
15FF   3A 55 16               LDA   send_reg_a   
1602   CD 00 10               CALL   get_reg_addr   
1605   3E 03                  MVI   a,TT_TRUE   
1607   CD 1A 10               CALL   set_slot_special   
160A   C3 86 1B               JMP   vm_loop   
160D                             ; 
160D                             ; ---------------------------------------------------------------
160D                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
160D                             ; ---------------------------------------------------------------
160D                SEND_MOD:      
160D   3A 55 16               LDA   send_reg_a   
1610   F5                     PUSH   psw   
1611   CD 0C 10               CALL   get_reg_addr_next   
1614   CD 32 10               CALL   slot_to_value   
1617   5E                     MOV   e,m   
1618   23                     INX   h   
1619   56                     MOV   d,m   ; DE = 除数
161A   7A                     MOV   a,d   
161B   B3                     ORA   e   
161C   C2 23 16               JNZ   send_mod_ok   
161F   F1                     POP   psw   
1620   C3 03 00               JMP   vm_error   ; ゼロ除算
1623                SEND_MOD_OK:      
1623   F1                     POP   psw   
1624   CD 00 10               CALL   get_reg_addr   
1627   CD 32 10               CALL   slot_to_value   
162A   E5                     PUSH   h   ; 書き戻し先
162B   4E                     MOV   c,m   
162C   23                     INX   h   
162D   46                     MOV   b,m   ; BC = 被除数
162E   CD 57 16               CALL   smod16   ; BC = 剰余 (除数と同符号)
1631   E1                     POP   h   
1632   71                     MOV   m,c   
1633   23                     INX   h   
1634   70                     MOV   m,b   
1635   C3 86 1B               JMP   vm_loop   
1638                             ; 
1638                             ; ---------------------------------------------------------------
1638                             ; abs (絶対値): R[a] = |R[a]|
1638                             ; ---------------------------------------------------------------
1638                SEND_ABS:      
1638   3A 55 16               LDA   send_reg_a   
163B   CD 00 10               CALL   get_reg_addr   
163E   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭
1641   23                     INX   h   ; HL → val_hi
1642   7E                     MOV   a,m   
1643   E6 80                  ANI   80h   
1645   CA 86 1B               JZ   vm_loop   ; 正ならそのまま
1648   2B                     DCX   h   ; HL → val_lo
1649   4E                     MOV   c,m   
164A   23                     INX   h   
164B   46                     MOV   b,m   ; BC = 値
164C   CD DC 12               CALL   neg_bc   
164F   70                     MOV   m,b   ; val_hi
1650   2B                     DCX   h   
1651   71                     MOV   m,c   ; val_lo
1652   C3 86 1B               JMP   vm_loop   
1655                             ; 
1655                             ; --- 一時変数 ---
1655                SEND_REG_A:      
1655   00                     DB   0   
1656                SEND_ARGC:      
1656   00                     DB   0   
1657                             ; 
1657                             ; ---------------------------------------------------------------
1657                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
1657                             ; 
1657                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1657                             ;   出力: BC = 剰余 (除数と同符号)
1657                             ;   破壊: A, DE, HL
1657                             ; 
1657                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
1657                             ; ---------------------------------------------------------------
1657                SMOD16:      
1657                             ; 除数の符号を保存
1657   7A                     MOV   a,d   
1658   F5                     PUSH   psw   
1659                             ; 符号の差を保存 (bit7: 異符号なら 1)
1659   78                     MOV   a,b   
165A   AA                     XRA   d   
165B   F5                     PUSH   psw   
165C                             ; 被除数を正にする
165C   78                     MOV   a,b   
165D   E6 80                  ANI   80h   
165F   CA 65 16               JZ   smod_chk_div   
1662   CD DC 12               CALL   neg_bc   
1665                SMOD_CHK_DIV:      
1665   7A                     MOV   a,d   
1666   E6 80                  ANI   80h   
1668   CA 6E 16               JZ   smod_do   
166B   CD E4 12               CALL   neg_de   
166E                SMOD_DO:      
166E   D5                     PUSH   d   ; |除数| を退避
166F   CD A5 12               CALL   udiv16   ; BC = 商, HL = 剰余
1672   44                     MOV   b,h   
1673   4D                     MOV   c,l   ; BC = |剰余|
1674   78                     MOV   a,b   
1675   B1                     ORA   c   
1676   D1                     POP   d   ; DE = |除数|
1677   F1                     POP   psw   ; 符号差 (bit7)
1678   CA 8D 16               JZ   smod_zero   ; 剰余 = 0
167B   E6 80                  ANI   80h   
167D   CA 86 16               JZ   smod_sign   ; 同符号 → 大きさはそのまま
1680                             ; 異符号: 大きさ = |除数| - |剰余|
1680   7B                     MOV   a,e   
1681   91                     SUB   c   
1682   4F                     MOV   c,a   
1683   7A                     MOV   a,d   
1684   98                     SBB   b   
1685   47                     MOV   b,a   
1686                SMOD_SIGN:      
1686   F1                     POP   psw   ; 除数の符号 (bit7)
1687   E6 80                  ANI   80h   
1689   C8                     RZ      ; 除数が正 → 正の剰余
168A   C3 DC 12               JMP   neg_bc   ; 除数が負 → 負にする
168D                SMOD_ZERO:      
168D   F1                     POP   psw   ; 除数の符号を捨てる
168E   C9                     RET      
168F                             ; vm_frame.a80 — フレームスタック管理
168F                             ; 
168F                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
168F                             ; 
168F                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
168F                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
168F                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
168F                             ;   get_frame_addr : フレーム番号 → メモリアドレス
168F                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
168F                             ; 
168F                             ; ---------------------------------------------------------------
168F                             ; get_frame_addr — フレーム番号 → アドレス
168F                             ; 
168F                             ;   入力: A = フレーム番号 (0-7)
168F                             ;   出力: HL = FRAME_STACK_BASE + A * 12
168F                             ;   破壊: A, B, DE
168F                             ; ---------------------------------------------------------------
168F                GET_FRAME_ADDR:      
168F   4F                     MOV   c,a   ; C = 元の値 (退避)
1690   87                     ADD   a   ; ×2
1691   47                     MOV   b,a   ; B = ×2
1692   87                     ADD   a   ; ×4
1693   80                     ADD   b   ; ×4 + ×2 = ×6
1694   87                     ADD   a   ; ×12
1695   5F                     MOV   e,a   
1696   16 00                  MVI   d,0   ; DE = frame * 12
1698   21 00 91               LXI   h,FRAME_STACK_BASE   
169B   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
169C   C9                     RET      
169D                             ; 
169D                             ; ---------------------------------------------------------------
169D                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
169D                             ; 
169D                             ;   入力: なし
169D                             ;   出力: HL = 現在のフレームのアドレス
169D                             ;   破壊: A, B, C, DE
169D                             ; ---------------------------------------------------------------
169D                CUR_FRAME_ADDR:      
169D   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16A0   3D                     DCR   a   
16A1   C3 8F 16               JMP   get_frame_addr   
16A4                             ; 
16A4                             ; ---------------------------------------------------------------
16A4                             ; push_frame — 現在の状態をフレームに保存
16A4                             ; 
16A4                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
16A4                             ;          B = フレーム種別 (FRAME_KIND_*)
16A4                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
16A4                             ;   出力: なし
16A4                             ;   破壊: A, B, C, HL, DE
16A4                             ; 
16A4                             ; frame_sp のスロットに保存して frame_sp++。
16A4                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
16A4                             ; ---------------------------------------------------------------
16A4                PUSH_FRAME:      
16A4                             ; パラメータを退避
16A4   32 FC 16               STA   pf_shift_reg   
16A7   78                     MOV   a,b   
16A8   32 FD 16               STA   pf_kind   
16AB   79                     MOV   a,c   
16AC   32 FE 16               STA   pf_outer   
16AF                             ; 
16AF                             ; HL = frame[frame_sp]
16AF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16B2   CD 8F 16               CALL   get_frame_addr   
16B5                             ; 
16B5                             ; +0,+1: return_pc
16B5   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
16B8   77                     MOV   m,a   
16B9   23                     INX   h   
16BA   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
16BD   77                     MOV   m,a   
16BE   23                     INX   h   
16BF                             ; 
16BF                             ; +2: return_irep
16BF   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
16C2   77                     MOV   m,a   
16C3   23                     INX   h   
16C4                             ; 
16C4                             ; +3,+4: return_reg_base
16C4   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
16C7   77                     MOV   m,a   
16C8   23                     INX   h   
16C9   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
16CC   77                     MOV   m,a   
16CD   23                     INX   h   
16CE                             ; 
16CE                             ; +5: kind
16CE   3A FD 16               LDA   pf_kind   
16D1   77                     MOV   m,a   
16D2   23                     INX   h   
16D3                             ; 
16D3                             ; +6,+7: index = 0
16D3   36 00                  MVI   m,0   
16D5   23                     INX   h   
16D6   36 00                  MVI   m,0   
16D8   23                     INX   h   
16D9                             ; 
16D9                             ; +8,+9: limit = 0
16D9   36 00                  MVI   m,0   
16DB   23                     INX   h   
16DC   36 00                  MVI   m,0   
16DE   23                     INX   h   
16DF                             ; 
16DF                             ; +10: outer
16DF   3A FE 16               LDA   pf_outer   
16E2   77                     MOV   m,a   
16E3                             ; 
16E3                             ; reg_base += shift_reg * 4
16E3   3A FC 16               LDA   pf_shift_reg   
16E6   87                     ADD   a   ; ×2
16E7   87                     ADD   a   ; ×4
16E8   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
16EB   85                     ADD   l   
16EC   6F                     MOV   l,a   
16ED   3E 00                  MVI   a,0   
16EF   8C                     ADC   h   
16F0   67                     MOV   h,a   
16F1   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
16F4                             ; 
16F4                             ; frame_sp++
16F4   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16F7   3C                     INR   a   
16F8   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
16FB   C9                     RET      
16FC                             ; 
16FC                             ; push_frame の一時変数
16FC   00           PF_SHIFT_REG:   DB   0   
16FD   00           PF_KIND:   DB   0   
16FE   00           PF_OUTER:   DB   0   
16FF                             ; 
16FF                             ; ---------------------------------------------------------------
16FF                             ; pop_frame — frame_sp-- して保存した状態を復帰
16FF                             ; 
16FF                             ;   入力: なし
16FF                             ;   出力: なし
16FF                             ;   破壊: A, B, C, HL, DE
16FF                             ; 
16FF                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
16FF                             ; ---------------------------------------------------------------
16FF                POP_FRAME:      
16FF                             ; frame_sp--
16FF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1702   3D                     DCR   a   
1703   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
1706                             ; 
1706                             ; HL = frame[frame_sp] (decremented value)
1706   CD 8F 16               CALL   get_frame_addr   
1709                             ; 
1709                             ; +0,+1: restore return_pc
1709   7E                     MOV   a,m   
170A   32 00 80               STA   VM_STATE_BASE + OFF_PC   
170D   23                     INX   h   
170E   7E                     MOV   a,m   
170F   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
1712   23                     INX   h   
1713                             ; 
1713                             ; +2: return_irep → switch_irep 用に退避
1713   7E                     MOV   a,m   
1714   32 28 17               STA   popf_ret_irep   
1717   23                     INX   h   
1718                             ; 
1718                             ; +3,+4: restore return_reg_base
1718   7E                     MOV   a,m   
1719   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
171C   23                     INX   h   
171D   7E                     MOV   a,m   
171E   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
1721                             ; 
1721                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
1721   3A 28 17               LDA   popf_ret_irep   
1724   CD 29 17               CALL   switch_irep   
1727   C9                     RET      
1728                             ; 
1728   00           POPF_RET_IREP:   DB   0   
1729                             ; 
1729                             ; ---------------------------------------------------------------
1729                             ; switch_irep — IREP テーブルから実行情報をロード
1729                             ; 
1729                             ;   入力: A = IREP 番号
1729                             ;   出力: なし
1729                             ;   破壊: A, B, C, HL, DE
1729                             ; 
1729                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
1729                             ; ---------------------------------------------------------------
1729                SWITCH_IREP:      
1729   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
172C                             ; 
172C                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
172C                             ; A * 10 = A * 8 + A * 2
172C   4F                     MOV   c,a   ; C = A (退避)
172D   87                     ADD   a   ; ×2
172E   47                     MOV   b,a   ; B = A*2
172F   79                     MOV   a,c   
1730   87                     ADD   a   ; ×2
1731   87                     ADD   a   ; ×4
1732   87                     ADD   a   ; ×8
1733   80                     ADD   b   ; A*8 + A*2 = A*10
1734   5F                     MOV   e,a   
1735   16 00                  MVI   d,0   
1737   21 00 82               LXI   h,IREP_TABLE_BASE   
173A   19                     DAD   d   ; HL = エントリアドレス
173B                             ; 
173B                             ; +0,+1: bytecode base → BC_BASE
173B   7E                     MOV   a,m   
173C   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
173F   23                     INX   h   
1740   7E                     MOV   a,m   
1741   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1744   23                     INX   h   
1745                             ; 
1745                             ; +2,+3: bytecode len → BC_LEN
1745   7E                     MOV   a,m   
1746   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1749   23                     INX   h   
174A   7E                     MOV   a,m   
174B   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
174E   23                     INX   h   
174F                             ; 
174F                             ; +4,+5: pool base → POOL_BASE
174F   7E                     MOV   a,m   
1750   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1753   23                     INX   h   
1754   7E                     MOV   a,m   
1755   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1758   23                     INX   h   
1759                             ; 
1759                             ; +6: nregs
1759   7E                     MOV   a,m   
175A   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
175D                             ; 
175D                             ; +7: subtree_size (スキップ)
175D   23                     INX   h   
175E                             ; 
175E                             ; +8,+9: sym_table_base → SYM_BASE
175E   23                     INX   h   
175F   7E                     MOV   a,m   
1760   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1763   23                     INX   h   
1764   7E                     MOV   a,m   
1765   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1768                             ; 
1768   C9                     RET      
1769                             ; vm_block.a80 — ブロック関連オペコード
1769                             ; 
1769                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
1769                             ; 
1769                             ; ---------------------------------------------------------------
1769                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
1769                             ; ---------------------------------------------------------------
1769                DO_OP_LOADSELF:      
1769   CD C0 10               CALL   fetch_byte   ; A = a
176C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
176F   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1771   23                     INX   h   
1772   36 00                  MVI   m,0   ; +1: 予約
1774   23                     INX   h   
1775   36 00                  MVI   m,0   ; +2: val_lo = 0
1777   23                     INX   h   
1778   36 00                  MVI   m,0   ; +3: val_hi = 0
177A   C3 86 1B               JMP   vm_loop   
177D                             ; 
177D                             ; ---------------------------------------------------------------
177D                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
177D                             ; 
177D                             ; ブロックを TT_PROC としてレジスタに格納する。
177D                             ;   値の下位バイト = 子 irep 番号
177D                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
177D                             ; ---------------------------------------------------------------
177D                DO_OP_BLOCK:      
177D   CD C0 10               CALL   fetch_byte   ; A = a
1780   32 A9 17               STA   blk_reg_a   
1783   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1786                             ; 
1786                             ; 子 irep 番号を算出 (共通サブルーチン)
1786   CD 77 10               CALL   calc_child_irep   ; A = child irep 番号
1789                             ; 
1789                             ; R[a] に TT_PROC を書く
1789   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
178A   3A A9 17               LDA   blk_reg_a   
178D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1790   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
1792   23                     INX   h   
1793   36 00                  MVI   m,0   ; +1: 予約
1795   23                     INX   h   
1796   71                     MOV   m,c   ; +2: val_lo = irep 番号
1797   23                     INX   h   
1798                             ; val_hi = 外側フレーム番号
1798                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
1798                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
1798   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
179B   B7                     ORA   a   
179C   C2 A4 17               JNZ   block_in_frame   
179F   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
17A1   C3 A5 17               JMP   block_set_outer   
17A4                BLOCK_IN_FRAME:      
17A4   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
17A5                BLOCK_SET_OUTER:      
17A5   77                     MOV   m,a   ; +3: val_hi = outer frame
17A6   C3 86 1B               JMP   vm_loop   
17A9                             ; 
17A9   00           BLK_REG_A:   DB   0   
17AA                             ; 
17AA                             ; ---------------------------------------------------------------
17AA                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
17AA                             ; 
17AA                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
17AA                             ; ---------------------------------------------------------------
17AA                DO_OP_ENTER:      
17AA   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 1)
17AD   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 2)
17B0   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 3)
17B3   C3 86 1B               JMP   vm_loop   
17B6                             ; 
17B6                             ; ---------------------------------------------------------------
17B6                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
17B6                             ; 
17B6                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
17B6                             ; ブロック付きメソッド呼び出しを行う。
17B6                             ; ---------------------------------------------------------------
17B6                DO_OP_SSENDB:      
17B6                             ; オペランドをプリフェッチ
17B6   CD C0 10               CALL   fetch_byte   ; A = a
17B9   32 AB 18               STA   sendb_reg_a   
17BC   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17BF   32 AC 18               STA   sendb_sym_b   
17C2   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17C5   32 AD 18               STA   sendb_argc   
17C8                             ; 
17C8                             ; R[0] → R[a] コピー (self を設定)
17C8   3E 00                  MVI   a,0   
17CA   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
17CD   E5                     PUSH   h   ; R[0] アドレス退避
17CE   3A AB 18               LDA   sendb_reg_a   
17D1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
17D4   EB                     XCHG      ; DE = R[a]
17D5   E1                     POP   h   ; HL = R[0]
17D6   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
17D9                             ; 
17D9   C3 EE 17               JMP   sendb_dispatch   
17DC                             ; 
17DC                             ; ---------------------------------------------------------------
17DC                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
17DC                             ; 
17DC                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
17DC                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
17DC                             ; ---------------------------------------------------------------
17DC                DO_OP_SENDB:      
17DC   CD C0 10               CALL   fetch_byte   ; A = a
17DF   32 AB 18               STA   sendb_reg_a   
17E2   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17E5   32 AC 18               STA   sendb_sym_b   
17E8   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17EB   32 AD 18               STA   sendb_argc   
17EE                             ; 
17EE                SENDB_DISPATCH:      
17EE                             ; シンボルテーブルからメソッド ID を取得
17EE   3A AC 18               LDA   sendb_sym_b   
17F1   87                     ADD   a   ; ×2
17F2   5F                     MOV   e,a   
17F3   16 00                  MVI   d,0   
17F5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
17F8   19                     DAD   d   ; HL = sym_table[b]
17F9   7E                     MOV   a,m   ; メソッド ID (下位)
17FA   32 AE 18               STA   sendb_method_id   
17FD                             ; 
17FD                             ; メソッド ID で振り分け
17FD   3A AE 18               LDA   sendb_method_id   
1800   FE 0B                  CPI   11   ; METHOD_TIMES
1802   CA 12 18               JZ   sendb_times   
1805   FE 15                  CPI   METHOD_EACH   
1807   CA A5 27               JZ   sendb_each   
180A   FE 1B                  CPI   27   ; METHOD_LOOP
180C   CA 75 18               JZ   sendb_loop   
180F                             ; 未対応のブロックメソッド
180F   C3 03 00               JMP   vm_error   
1812                             ; 
1812                             ; --- times ---
1812                SENDB_TIMES:      
1812                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
1812   3A AB 18               LDA   sendb_reg_a   
1815   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1818   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
181B   4E                     MOV   c,m   ; C = val_lo
181C   23                     INX   h   
181D   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
181E                             ; 
181E                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
181E   78                     MOV   a,b   
181F   B1                     ORA   c   
1820   CA 86 1B               JZ   vm_loop   ; receiver == 0 → スキップ
1823                             ; 
1823                             ; limit = BC - 1
1823   0B                     DCX   b   ; BC = limit
1824                             ; 
1824                             ; push_frame: A=レジスタ番号, B=kind, C=outer
1824                             ; ブロックの位置: R[a + argc + 1]
1824   3A AB 18               LDA   sendb_reg_a   
1827   C5                     PUSH   b   ; limit を退避
1828                             ; ブロック (TT_PROC) の情報を読む
1828   3A AD 18               LDA   sendb_argc   
182B   3C                     INR   a   ; argc + 1
182C   47                     MOV   b,a   
182D   3A AB 18               LDA   sendb_reg_a   
1830   80                     ADD   b   ; A = a + argc + 1
1831   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1834   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1837   7E                     MOV   a,m   ; A = irep 番号
1838   32 AF 18               STA   sendb_block_irep   
183B   23                     INX   h   
183C   7E                     MOV   a,m   ; A = outer frame (val_hi)
183D   32 B0 18               STA   sendb_block_outer   
1840                             ; 
1840                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
1840   3A AB 18               LDA   sendb_reg_a   
1843   06 01                  MVI   b,FRAME_KIND_ITERATE   
1845   3A B0 18               LDA   sendb_block_outer   
1848   4F                     MOV   c,a   
1849   3A AB 18               LDA   sendb_reg_a   
184C   CD A4 16               CALL   push_frame   
184F                             ; 
184F                             ; フレームに limit を設定
184F                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
184F   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
1852   11 08 00               LXI   d,FRAME_OFF_LIMIT   
1855   19                     DAD   d   ; HL = &limit
1856   C1                     POP   b   ; BC = limit (ここで復帰)
1857   71                     MOV   m,c   ; limit_lo
1858   23                     INX   h   
1859   70                     MOV   m,b   ; limit_hi
185A                             ; 
185A                             ; ブロック引数 R[1] = 0 (初期カウンタ)
185A                             ; R[1] は新しい reg_base から見た R[1]
185A   3E 01                  MVI   a,1   
185C   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
185F   06 00                  MVI   b,0   
1861   0E 00                  MVI   c,0   
1863   CD 10 10               CALL   set_slot_int16   ; R[1] = 0
1866                             ; 
1866                             ; 子 irep に切り替え
1866   3A AF 18               LDA   sendb_block_irep   
1869   CD 29 17               CALL   switch_irep   
186C                             ; 
186C                             ; PC = 0
186C   21 00 00               LXI   h,0   
186F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1872   C3 86 1B               JMP   vm_loop   
1875                             ; 
1875                             ; --- loop ---
1875                SENDB_LOOP:      
1875                             ; ブロックの位置: R[a + argc + 1]
1875   3A AD 18               LDA   sendb_argc   
1878   3C                     INR   a   
1879   47                     MOV   b,a   
187A   3A AB 18               LDA   sendb_reg_a   
187D   80                     ADD   b   ; A = a + argc + 1
187E   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1881   CD 32 10               CALL   slot_to_value   
1884   7E                     MOV   a,m   ; irep 番号
1885   32 AF 18               STA   sendb_block_irep   
1888   23                     INX   h   
1889   7E                     MOV   a,m   ; outer
188A   32 B0 18               STA   sendb_block_outer   
188D                             ; 
188D                             ; push_frame(a, FRAME_KIND_LOOP, outer)
188D   3A AB 18               LDA   sendb_reg_a   
1890   06 04                  MVI   b,FRAME_KIND_LOOP   
1892   3A B0 18               LDA   sendb_block_outer   
1895   4F                     MOV   c,a   
1896   3A AB 18               LDA   sendb_reg_a   
1899   CD A4 16               CALL   push_frame   
189C                             ; 
189C                             ; 子 irep に切り替え
189C   3A AF 18               LDA   sendb_block_irep   
189F   CD 29 17               CALL   switch_irep   
18A2                             ; 
18A2                             ; PC = 0
18A2   21 00 00               LXI   h,0   
18A5   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
18A8   C3 86 1B               JMP   vm_loop   
18AB                             ; 
18AB                             ; OP_SENDB の一時変数
18AB   00           SENDB_REG_A:   DB   0   
18AC   00           SENDB_SYM_B:   DB   0   
18AD   00           SENDB_ARGC:   DB   0   
18AE   00           SENDB_METHOD_ID:   DB   0   
18AF   00           SENDB_BLOCK_IREP:   DB   0   
18B0   00           SENDB_BLOCK_OUTER:   DB   0   
18B1                             ; 
18B1                             ; ---------------------------------------------------------------
18B1                             ; OP_BREAK (B): ブロックから脱出
18B1                             ; 
18B1                             ; R[a] の値を R[0] にコピーして pop_frame。
18B1                             ; ---------------------------------------------------------------
18B1                DO_OP_BREAK:      
18B1   CD C0 10               CALL   fetch_byte   ; A = a
18B4                             ; R[a] → R[0] コピー
18B4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
18B7   E5                     PUSH   h   ; R[a] アドレス退避
18B8   3E 00                  MVI   a,0   
18BA   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
18BD   EB                     XCHG      ; DE = R[0]
18BE   E1                     POP   h   ; HL = R[a]
18BF   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
18C2                             ; 
18C2   CD FF 16               CALL   pop_frame   
18C5   C3 86 1B               JMP   vm_loop   
18C8                             ; vm_upvar.a80 — 外側スコープの変数アクセス
18C8                             ; 
18C8                             ; OP_GETUPVAR, OP_SETUPVAR
18C8                             ; 
18C8                             ; ブロック内から外側のローカル変数にアクセスする。
18C8                             ; outer フレーム chain を level 段辿って reg_base を求める。
18C8                             ; 
18C8                             ; ---------------------------------------------------------------
18C8                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
18C8                             ; 
18C8                             ;   入力: A = level (何段外側か)
18C8                             ;   出力: HL = 外側スコープの reg_base アドレス
18C8                             ;   破壊: A, B, C, DE
18C8                             ; 
18C8                             ; outer chain を level 段辿る。FRAME_NONE に達したら
18C8                             ; REG_FILE_BASE (トップレベル) を返す。
18C8                             ; ---------------------------------------------------------------
18C8                UPVAR_BASE:      
18C8   47                     MOV   b,a   ; B = level (残り段数)
18C9                             ; まず現在のフレームの outer を読む
18C9   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
18CC   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
18CD   32 FF 18               STA   upvar_frame   
18D0                             ; 
18D0                             ; level == 0 なら outer chain を辿らずに
18D0                             ; 現在のフレームの return_reg_base をそのまま返す
18D0   78                     MOV   a,b   
18D1   B7                     ORA   a   
18D2   CA EC 18               JZ   upvar_found   
18D5                             ; 
18D5                UPVAR_LOOP:      
18D5                             ; outer フレーム番号を読む
18D5   3A FF 18               LDA   upvar_frame   
18D8   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
18DB   11 0A 00               LXI   d,FRAME_OFF_OUTER   
18DE   19                     DAD   d   
18DF   7E                     MOV   a,m   ; A = outer frame 番号
18E0                             ; 
18E0   FE FF                  CPI   FRAME_NONE   
18E2   CA FB 18               JZ   upvar_toplevel   ; トップレベルに達した
18E5                             ; 
18E5   32 FF 18               STA   upvar_frame   ; 次のフレーム
18E8                             ; 
18E8   05                     DCR   b   
18E9   C2 D5 18               JNZ   upvar_loop   ; まだ辿る段がある
18EC                             ; 
18EC                             ; level 回辿り終わった — upvar_frame の reg_base を返す
18EC                UPVAR_FOUND:      
18EC   3A FF 18               LDA   upvar_frame   
18EF   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
18F2   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
18F5   19                     DAD   d   
18F6   5E                     MOV   e,m   
18F7   23                     INX   h   
18F8   56                     MOV   d,m   ; DE = return_reg_base
18F9   EB                     XCHG      ; HL = return_reg_base
18FA   C9                     RET      
18FB                             ; 
18FB                UPVAR_TOPLEVEL:      
18FB   21 00 81               LXI   h,REG_FILE_BASE   
18FE   C9                     RET      
18FF                             ; 
18FF   00           UPVAR_FRAME:   DB   0   
1900                             ; 
1900                             ; ---------------------------------------------------------------
1900                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
1900                             ; 
1900                             ;   a = コピー先レジスタ
1900                             ;   b = 外側スコープのレジスタ番号
1900                             ;   c = level (何段外側か)
1900                             ; ---------------------------------------------------------------
1900                DO_OP_GETUPVAR:      
1900   CD C0 10               CALL   fetch_byte   ; A = a
1903   32 56 19               STA   upvar_reg_a   
1906   CD C0 10               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
1909   32 57 19               STA   upvar_reg_b   
190C   CD C0 10               CALL   fetch_byte   ; A = c (level)
190F                             ; 
190F                             ; 外側の reg_base を求める
190F   CD C8 18               CALL   upvar_base   ; HL = 外側の reg_base
1912                             ; 
1912                             ; 外側の R[b] のアドレス = base + b * 4
1912   3A 57 19               LDA   upvar_reg_b   
1915   87                     ADD   a   ; ×2
1916   87                     ADD   a   ; ×4
1917   85                     ADD   l   
1918   6F                     MOV   l,a   
1919   3E 00                  MVI   a,0   
191B   8C                     ADC   h   
191C   67                     MOV   h,a   ; HL = 外側の R[b]
191D                             ; 
191D                             ; R[a] にコピー
191D   E5                     PUSH   h   ; コピー元退避
191E   3A 56 19               LDA   upvar_reg_a   
1921   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1924   EB                     XCHG      ; DE = R[a] (コピー先)
1925   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
1926   CD 25 10               CALL   copy_slot   
1929   C3 86 1B               JMP   vm_loop   
192C                             ; 
192C                             ; ---------------------------------------------------------------
192C                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
192C                             ; 
192C                             ;   a = コピー元レジスタ
192C                             ;   b = 外側スコープのレジスタ番号
192C                             ;   c = level (何段外側か)
192C                             ; ---------------------------------------------------------------
192C                DO_OP_SETUPVAR:      
192C   CD C0 10               CALL   fetch_byte   ; A = a
192F   32 56 19               STA   upvar_reg_a   
1932   CD C0 10               CALL   fetch_byte   ; A = b
1935   32 57 19               STA   upvar_reg_b   
1938   CD C0 10               CALL   fetch_byte   ; A = c (level)
193B                             ; 
193B                             ; 外側の reg_base を求める
193B   CD C8 18               CALL   upvar_base   ; HL = 外側の reg_base
193E                             ; 
193E                             ; 外側の R[b] のアドレス = base + b * 4
193E   3A 57 19               LDA   upvar_reg_b   
1941   87                     ADD   a   
1942   87                     ADD   a   
1943   85                     ADD   l   
1944   6F                     MOV   l,a   
1945   3E 00                  MVI   a,0   
1947   8C                     ADC   h   
1948   67                     MOV   h,a   ; HL = 外側の R[b]
1949   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
194A                             ; 
194A                             ; R[a] からコピー
194A   3A 56 19               LDA   upvar_reg_a   
194D   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1950   CD 25 10               CALL   copy_slot   
1953   C3 86 1B               JMP   vm_loop   
1956                             ; 
1956   00           UPVAR_REG_A:   DB   0   
1957   00           UPVAR_REG_B:   DB   0   
1958                             ; vm_class.a80 — クラス・メソッド定義オペコード
1958                             ; 
1958                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
1958                             ; 
1958                             ; ---------------------------------------------------------------
1958                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
1958                             ; 
1958                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
1958                             ; クラス本体内ではそのクラス (TT_CLASS)。
1958                             ; ---------------------------------------------------------------
1958                DO_OP_TCLASS:      
1958   CD C0 10               CALL   fetch_byte   ; A = a
195B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
195E   EB                     XCHG      ; DE = R[a] (コピー先)
195F   3E 00                  MVI   a,0   
1961   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (コピー元)
1964   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
1967   C3 86 1B               JMP   vm_loop   
196A                             ; 
196A                             ; ---------------------------------------------------------------
196A                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
196A                             ; 
196A                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
196A                             ; ではないため、外側フレームへの参照を持たない)。
196A                             ; ---------------------------------------------------------------
196A                DO_OP_METHOD:      
196A   CD C0 10               CALL   fetch_byte   ; A = a
196D   32 8A 19               STA   meth_reg_a   
1970   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1973   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1976   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1977                             ; 
1977   3A 8A 19               LDA   meth_reg_a   
197A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
197D   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
197F   23                     INX   h   
1980   36 00                  MVI   m,0   ; +1: 予約
1982   23                     INX   h   
1983   71                     MOV   m,c   ; +2: val_lo = irep 番号
1984   23                     INX   h   
1985   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
1987   C3 86 1B               JMP   vm_loop   
198A                             ; 
198A   00           METH_REG_A:   DB   0   
198B                             ; 
198B                             ; ---------------------------------------------------------------
198B                             ; OP_DEF (BB): メソッド表に登録
198B                             ; 
198B                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
198B                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
198B                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
198B                             ; 
198B                             ; method_table[class_number * 32 + method_id] = irep 番号
198B                             ; ---------------------------------------------------------------
198B                DO_OP_DEF:      
198B   CD C0 10               CALL   fetch_byte   ; A = a
198E   32 EF 19               STA   def_reg_a   
1991   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1994                             ; 
1994                             ; シンボルテーブルから method_id を取得
1994   87                     ADD   a   ; ×2
1995   5F                     MOV   e,a   
1996   16 00                  MVI   d,0   
1998   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
199B   19                     DAD   d   ; HL = &sym_table[b]
199C   5E                     MOV   e,m   ; E = method_id (下位)
199D   23                     INX   h   
199E   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
199F                             ; 種別チェックは省略 (バイトコードツールが保証)
199F                             ; 
199F                             ; method_id を退避
199F   7B                     MOV   a,e   
19A0   32 F0 19               STA   def_method_id   
19A3                             ; 
19A3                             ; R[a] から class_number を取得
19A3   3A EF 19               LDA   def_reg_a   
19A6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19A9   CD 9B 10               CALL   class_of_reg   ; A = class_number
19AC                             ; 
19AC                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
19AC                             ; A * 32
19AC   87                     ADD   a   ; ×2
19AD   87                     ADD   a   ; ×4
19AE   87                     ADD   a   ; ×8
19AF   87                     ADD   a   ; ×16
19B0   87                     ADD   a   ; ×32
19B1   5F                     MOV   e,a   
19B2   16 00                  MVI   d,0   
19B4   21 C0 91               LXI   h,METHOD_TABLE_BASE   
19B7   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
19B8   3A F0 19               LDA   def_method_id   
19BB   5F                     MOV   e,a   
19BC   16 00                  MVI   d,0   
19BE   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
19BF                             ; 
19BF                             ; R[a+1].val_lo = irep 番号
19BF   3A EF 19               LDA   def_reg_a   
19C2   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
19C5   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
19C8   7E                     MOV   a,m   ; A = val_lo = irep 番号
19C9                             ; 
19C9                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
19C9   32 F1 19               STA   def_irep_num   
19CC   3A EF 19               LDA   def_reg_a   
19CF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19D2   CD 9B 10               CALL   class_of_reg   ; A = class_number
19D5   87                     ADD   a   
19D6   87                     ADD   a   
19D7   87                     ADD   a   
19D8   87                     ADD   a   
19D9   87                     ADD   a   ; A = class * 32
19DA   5F                     MOV   e,a   
19DB   16 00                  MVI   d,0   
19DD   21 C0 91               LXI   h,METHOD_TABLE_BASE   
19E0   19                     DAD   d   
19E1   3A F0 19               LDA   def_method_id   
19E4   5F                     MOV   e,a   
19E5   16 00                  MVI   d,0   
19E7   19                     DAD   d   ; HL = メソッド表エントリ
19E8   3A F1 19               LDA   def_irep_num   
19EB   77                     MOV   m,a   ; method_table[...] = irep 番号
19EC   C3 86 1B               JMP   vm_loop   
19EF                             ; 
19EF   00           DEF_REG_A:   DB   0   
19F0   00           DEF_METHOD_ID:   DB   0   
19F1   00           DEF_IREP_NUM:   DB   0   
19F2                             ; 
19F2                             ; ---------------------------------------------------------------
19F2                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
19F2                             ; 
19F2                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
19F2                             ; ---------------------------------------------------------------
19F2                DO_OP_CLASS:      
19F2                DO_OP_GETCONST:      
19F2   CD C0 10               CALL   fetch_byte   ; A = a
19F5   32 1D 1A               STA   cls_reg_a   
19F8   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
19FB                             ; 
19FB                             ; シンボルテーブルから class_number を取得
19FB   87                     ADD   a   ; ×2
19FC   5F                     MOV   e,a   
19FD   16 00                  MVI   d,0   
19FF   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1A02   19                     DAD   d   ; HL = &sym_table[b]
1A03   7E                     MOV   a,m   ; A = class_number (下位)
1A04   32 1E 1A               STA   cls_class_num   
1A07                             ; 
1A07                             ; R[a] に TT_CLASS を書く
1A07   3A 1D 1A               LDA   cls_reg_a   
1A0A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A0D   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
1A0F   23                     INX   h   
1A10   36 00                  MVI   m,0   ; +1: 予約
1A12   23                     INX   h   
1A13   3A 1E 1A               LDA   cls_class_num   
1A16   77                     MOV   m,a   ; +2: val_lo = class_number
1A17   23                     INX   h   
1A18   36 00                  MVI   m,0   ; +3: val_hi = 0
1A1A   C3 86 1B               JMP   vm_loop   
1A1D                             ; 
1A1D   00           CLS_REG_A:   DB   0   
1A1E   00           CLS_CLASS_NUM:   DB   0   
1A1F                             ; 
1A1F                             ; ---------------------------------------------------------------
1A1F                             ; OP_EXEC (BB): クラス本体を実行
1A1F                             ; 
1A1F                             ; push_frame して子 irep に切り替える。
1A1F                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
1A1F                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
1A1F                             ; ---------------------------------------------------------------
1A1F                DO_OP_EXEC:      
1A1F   CD C0 10               CALL   fetch_byte   ; A = a
1A22   32 47 1A               STA   exec_reg_a   
1A25   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1A28   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1A2B   32 48 1A               STA   exec_irep   
1A2E                             ; 
1A2E                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
1A2E   3A 47 1A               LDA   exec_reg_a   
1A31   06 00                  MVI   b,FRAME_KIND_CALL   
1A33   0E FF                  MVI   c,FRAME_NONE   
1A35   CD A4 16               CALL   push_frame   
1A38                             ; 
1A38                             ; 子 irep に切り替え
1A38   3A 48 1A               LDA   exec_irep   
1A3B   CD 29 17               CALL   switch_irep   
1A3E                             ; 
1A3E                             ; PC = 0
1A3E   21 00 00               LXI   h,0   
1A41   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1A44   C3 86 1B               JMP   vm_loop   
1A47                             ; 
1A47   00           EXEC_REG_A:   DB   0   
1A48   00           EXEC_IREP:   DB   0   
1A49                             ; vm_display.a80 — 7 セグメント表示
1A49                             ; 
1A49                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
1A49                             ; 上位 4 桁はブランク（消灯）にする。
1A49                             ; セグメントパターンは seg_table にまとめる。
1A49                             ; 
1A49                             ; ---------------------------------------------------------------
1A49                             ; display_hex16 — 16 ビット値を 7 セグに表示
1A49                             ; 
1A49                             ;   入力: HL = 値の先頭 (val_lo の位置)
1A49                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
1A49                             ;   破壊: A, B, C, HL, DE
1A49                             ; 
1A49                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
1A49                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
1A49                             ; ---------------------------------------------------------------
1A49                DISPLAY_HEX16:      
1A49   E5                     PUSH   h   ; 値のアドレスを退避
1A4A                             ; 上位 4 桁をブランク (消灯) にする
1A4A   11 F8 FF               LXI   d,DISPLAY_BASE   
1A4D   AF                     XRA   a   ; A = 0 (全セグメント消灯)
1A4E   12                     STAX   d   
1A4F   13                     INX   d   
1A50   12                     STAX   d   
1A51   13                     INX   d   
1A52   12                     STAX   d   
1A53   13                     INX   d   
1A54   12                     STAX   d   
1A55   13                     INX   d   ; DE = DISPLAY_BASE + 4
1A56                             ; 値の byte1 (val_hi) から表示
1A56   E1                     POP   h   ; HL = val_lo
1A57   23                     INX   h   ; HL = val_hi
1A58   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
1A5A                DISPLAY_BYTE_LOOP:      
1A5A                             ; 上位ニブル
1A5A   7E                     MOV   a,m   
1A5B   0F                     RRC      
1A5C   0F                     RRC      
1A5D   0F                     RRC      
1A5E   0F                     RRC      
1A5F   E6 0F                  ANI   0Fh   
1A61   CD 74 1A               CALL   nibble_to_seg   
1A64   12                     STAX   d   
1A65   13                     INX   d   
1A66                             ; 下位ニブル
1A66   7E                     MOV   a,m   
1A67   E6 0F                  ANI   0Fh   
1A69   CD 74 1A               CALL   nibble_to_seg   
1A6C   12                     STAX   d   
1A6D   13                     INX   d   
1A6E                             ; 次のバイト (val_hi → val_lo)
1A6E   2B                     DCX   h   
1A6F   0D                     DCR   c   
1A70   C2 5A 1A               JNZ   display_byte_loop   
1A73   C9                     RET      
1A74                             ; 
1A74                             ; ---------------------------------------------------------------
1A74                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
1A74                             ; 
1A74                             ;   入力: A = 0-F
1A74                             ;   出力: A = セグメントパターン
1A74                             ;   破壊: なし (HL, BC は内部で退避・復元)
1A74                             ; ---------------------------------------------------------------
1A74                NIBBLE_TO_SEG:      
1A74   E5                     PUSH   h   
1A75   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
1A76   6F                     MOV   l,a   
1A77   26 00                  MVI   h,0   
1A79   01 81 1A               LXI   b,seg_table   
1A7C   09                     DAD   b   ; HL = seg_table + nibble
1A7D   7E                     MOV   a,m   
1A7E   C1                     POP   b   ; BC を復元
1A7F   E1                     POP   h   
1A80   C9                     RET      
1A81                             ; 
1A81                             ; ---------------------------------------------------------------
1A81                             ; 7 セグメントパターンテーブル
1A81                             ; 
1A81                             ;   bit 0 = a (上)
1A81                             ;   bit 1 = b (右上)
1A81                             ;   bit 2 = c (右下)
1A81                             ;   bit 3 = d (下)
1A81                             ;   bit 4 = e (左下)
1A81                             ;   bit 5 = f (左上)
1A81                             ;   bit 6 = g (中)
1A81                             ; 
1A81                             ;       aaa
1A81                             ;      f   b
1A81                             ;       ggg
1A81                             ;      e   c
1A81                             ;       ddd
1A81                             ; ---------------------------------------------------------------
1A81                SEG_TABLE:      
1A81   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
1A82   06                     DB   06h   ; 1
1A83   5B                     DB   5Bh   ; 2
1A84   4F                     DB   4Fh   ; 3
1A85   66                     DB   66h   ; 4
1A86   6D                     DB   6Dh   ; 5
1A87   7D                     DB   7Dh   ; 6
1A88   27                     DB   27h   ; 7  (ND8080 ROM パターン)
1A89   7F                     DB   7Fh   ; 8
1A8A   6F                     DB   6Fh   ; 9
1A8B   77                     DB   77h   ; A
1A8C   7C                     DB   7Ch   ; b
1A8D   39                     DB   39h   ; C
1A8E   5E                     DB   5Eh   ; d
1A8F   79                     DB   79h   ; E
1A90   71                     DB   71h   ; F
1A91                             ; 
1A91                             ; ===============================================================
1A91                             ; OP_RETURN (B): フレーム種別に応じて復帰
1A91                             ; 
1A91                             ; frame_sp == 0 → トップレベル: 表示して停止
1A91                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
1A91                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
1A91                             ; FRAME_KIND_ITERATE/LOOP → ブロック内: advance_iteration
1A91                             ; ===============================================================
1A91                DO_OP_RETURN:      
1A91   CD C0 10               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
1A94   32 E4 1A               STA   return_reg_a   
1A97                             ; 
1A97                             ; フレームスタックが空ならトップレベル
1A97   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1A9A   B7                     ORA   a   
1A9B   CA D0 1A               JZ   do_op_return_top   
1A9E                             ; 
1A9E                             ; フレーム種別を確認
1A9E   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1AA1   11 05 00               LXI   d,FRAME_OFF_KIND   
1AA4   19                     DAD   d   
1AA5   7E                     MOV   a,m   ; A = kind
1AA6   FE 00                  CPI   FRAME_KIND_CALL   
1AA8   CA B3 1A               JZ   return_call   
1AAB   FE 05                  CPI   FRAME_KIND_NEW   
1AAD   CA CA 1A               JZ   return_new   
1AB0                             ; ITERATE / LOOP → advance_iteration
1AB0   C3 E5 1A               JMP   advance_iteration   
1AB3                             ; 
1AB3                RETURN_CALL:      
1AB3                             ; R[a] の値を R[0] にコピー
1AB3   3A E4 1A               LDA   return_reg_a   
1AB6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AB9   E5                     PUSH   h   
1ABA   3E 00                  MVI   a,0   
1ABC   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1ABF   EB                     XCHG      ; DE = R[0] (コピー先)
1AC0   E1                     POP   h   ; HL = R[a] (コピー元)
1AC1   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
1AC4   CD FF 16               CALL   pop_frame   
1AC7   C3 86 1B               JMP   vm_loop   
1ACA                             ; 
1ACA                RETURN_NEW:      
1ACA                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
1ACA   CD FF 16               CALL   pop_frame   
1ACD   C3 86 1B               JMP   vm_loop   
1AD0                             ; 
1AD0                DO_OP_RETURN_TOP:      
1AD0   3A E4 1A               LDA   return_reg_a   
1AD3   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AD6   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1AD9   CD 49 1A               CALL   display_hex16   
1ADC   3E 02                  MVI   a,VM_FINISHED   
1ADE   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1AE1   C3 74 1B               JMP   vm_halt   
1AE4                             ; 
1AE4   00           RETURN_REG_A:   DB   0   
1AE5                             ; 
1AE5                             ; ===============================================================
1AE5                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
1AE5                             ; 
1AE5                             ; ITERATE (times): index++ して limit と比較。超えたら pop_frame。
1AE5                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
1AE5                             ; ===============================================================
1AE5                ADVANCE_ITERATION:      
1AE5                             ; フレーム種別を確認
1AE5   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1AE8   11 05 00               LXI   d,FRAME_OFF_KIND   
1AEB   19                     DAD   d   
1AEC   7E                     MOV   a,m   ; A = kind
1AED   FE 04                  CPI   FRAME_KIND_LOOP   
1AEF   CA 43 1B               JZ   adv_reenter   ; loop → 常に再実行
1AF2   32 52 1B               STA   adv_kind   ; kind を退避 (ITERATE or EACH)
1AF5                             ; 
1AF5                             ; --- ITERATE / EACH 共通: index インクリメント + limit チェック ---
1AF5   CD 9D 16               CALL   cur_frame_addr   
1AF8   11 06 00               LXI   d,FRAME_OFF_INDEX   
1AFB   19                     DAD   d   
1AFC   4E                     MOV   c,m   ; C = index_lo
1AFD   23                     INX   h   
1AFE   46                     MOV   b,m   ; B = index_hi
1AFF   03                     INX   b   ; BC = index + 1
1B00                             ; 書き戻す
1B00   70                     MOV   m,b   ; index_hi
1B01   2B                     DCX   h   
1B02   71                     MOV   m,c   ; index_lo
1B03                             ; 
1B03                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
1B03   23                     INX   h   ; → &index_hi
1B04   23                     INX   h   ; → &limit_lo
1B05   5E                     MOV   e,m   ; E = limit_lo
1B06   23                     INX   h   ; → &limit_hi
1B07   56                     MOV   d,m   ; D = limit_hi
1B08                             ; 
1B08                             ; BC = new index, DE = limit
1B08                             ; index > limit なら反復終了 (DE - BC でボロー発生)
1B08   7B                     MOV   a,e   
1B09   91                     SUB   c   
1B0A   7A                     MOV   a,d   
1B0B   98                     SBB   b   
1B0C   DA 4C 1B               JC   adv_done   ; index > limit → 反復終了
1B0F                             ; 
1B0F                             ; kind で R[1] の設定を分岐
1B0F   3A 52 1B               LDA   adv_kind   
1B12   FE 02                  CPI   FRAME_KIND_EACH   
1B14   CA 22 1B               JZ   adv_each_load   
1B17                             ; 
1B17                             ; --- ITERATE (times): R[1] = index ---
1B17   3E 01                  MVI   a,1   
1B19   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
1B1C   CD 10 10               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
1B1F   C3 43 1B               JMP   adv_reenter   
1B22                             ; 
1B22                             ; --- EACH: R[1] = array[index] ---
1B22                ADV_EACH_LOAD:      
1B22                             ; BC = index を退避 (cur_frame_addr が BC を破壊するため)
1B22   C5                     PUSH   b   
1B23                             ; フレーム +11 からコレクションスロット番号を読む
1B23   CD 9D 16               CALL   cur_frame_addr   
1B26   11 0B 00               LXI   d,11   
1B29   19                     DAD   d   
1B2A   7E                     MOV   a,m   ; A = col_slot
1B2B   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス
1B2E   23                     INX   h   ; skip type
1B2F   23                     INX   h   ; skip count → data
1B30   C1                     POP   b   ; BC = index (復帰)
1B31                             ; data + index * 4 (C = index_lo, 配列は最大 8 要素)
1B31   79                     MOV   a,c   
1B32   87                     ADD   a   ; ×2
1B33   87                     ADD   a   ; ×4
1B34   5F                     MOV   e,a   
1B35   16 00                  MVI   d,0   
1B37   19                     DAD   d   ; HL = &data[index*4] (source)
1B38   E5                     PUSH   h   
1B39   3E 01                  MVI   a,1   
1B3B   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (dest)
1B3E   EB                     XCHG      ; DE = R[1]
1B3F   E1                     POP   h   ; HL = source
1B40   CD 25 10               CALL   copy_slot   ; R[1] = array[index]
1B43                             ; 
1B43                ADV_REENTER:      
1B43                             ; PC = 0 で再実行
1B43   21 00 00               LXI   h,0   
1B46   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1B49   C3 86 1B               JMP   vm_loop   
1B4C                             ; 
1B4C                ADV_DONE:      
1B4C                             ; 反復完了 → フレームを破棄して親に戻る
1B4C   CD FF 16               CALL   pop_frame   
1B4F   C3 86 1B               JMP   vm_loop   
1B52                             ; 
1B52   00           ADV_KIND:   DB   0   
1B53                             ; 
1B53                             ; ===============================================================
1B53                             ; OP_STOP (Z): VM 停止
1B53                             ; ===============================================================
1B53                DO_OP_STOP:      
1B53   3E 02                  MVI   a,VM_FINISHED   
1B55   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1B58                             ; R[1] の値を 7 セグに表示
1B58   3E 01                  MVI   a,1   
1B5A   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1B5D   CD 32 10               CALL   slot_to_value   ; HL = R[1] の値先頭
1B60   CD 49 1A               CALL   display_hex16   
1B63   C3 74 1B               JMP   vm_halt   
1B66                             ; 
1B66                             ; ===============================================================
1B66                             ; エラー停止
1B66                             ; 
1B66                             ; 未対応のオペコードを踏んだとき。
1B66                             ; 現在のオペコードをエラーコードとして保存する。
1B66                             ; ===============================================================
1B66                VM_ERROR:      
1B66   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1B69   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
1B6C   3E 03                  MVI   a,VM_ERROR   
1B6E   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1B71   C3 74 1B               JMP   vm_halt   
1B74                             ; 
1B74                             ; ===============================================================
1B74                             ; 停止 — ND80Z モニタのリモートモードへ復帰
1B74                             ; 
1B74                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
1B74                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
1B74                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
1B74                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
1B74                             ; これにより自動的にリモートモードへ復帰する。
1B74                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
1B74                             ; ===============================================================
1B74                VM_HALT:      
1B74                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
1B74                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
1B74                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
1B74   06 04                  MVI   b,4   
1B76                VM_HALT_OUTER:      
1B76   11 00 00               LXI   d,0   
1B79                VM_HALT_INNER:      
1B79   1B                     DCX   d   
1B7A   7A                     MOV   a,d   
1B7B   B3                     ORA   e   
1B7C   C2 79 1B               JNZ   vm_halt_inner   
1B7F   05                     DCR   b   
1B80   C2 76 1B               JNZ   vm_halt_outer   
1B83   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
1B86                             ; 
1B86                             ; ===============================================================
1B86                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
1B86                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
1B86                             ; ===============================================================
1B86                             ; 
1B86                             ; ===============================================================
1B86                             ; メインループ (fetch-decode-execute)
1B86                             ; ===============================================================
1B86                VM_LOOP:      
1B86                             ; --- 実行状態の確認 ---
1B86   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
1B89   FE 01                  CPI   VM_RUNNING   
1B8B   C2 74 1B               JNZ   vm_halt   
1B8E                             ; 
1B8E                             ; --- PC がバイトコード長を超えていないか ---
1B8E   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
1B91   EB                     XCHG      ; DE = PC
1B92   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
1B95                             ; HL = bytecode_len, DE = PC
1B95                             ; PC >= bytecode_len ならエラー
1B95   7B                     MOV   a,e   
1B96   95                     SUB   l   
1B97   7A                     MOV   a,d   
1B98   9C                     SBB   h   ; DE - HL (PC - len)
1B99   D2 03 00               JNC   vm_error   ; PC >= len → エラー
1B9C                             ; 
1B9C                             ; --- オペコードフェッチ ---
1B9C   CD C0 10               CALL   fetch_byte   ; A = opcode
1B9F   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1BA2                             ; 
1BA2                             ; --- ステップカウント ---
1BA2   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1BA5   23                     INX   h   
1BA6   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1BA9                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
1BA9   7C                     MOV   a,h   
1BAA   B5                     ORA   l   
1BAB   C2 B5 1B               JNZ   vm_dispatch   
1BAE   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1BB1   23                     INX   h   
1BB2   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1BB5                             ; 
1BB5                             ; --- ディスパッチ ---
1BB5                VM_DISPATCH:      
1BB5   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1BB8                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
1BB8   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
1BB9   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
1BBC   5F                     MOV   e,a   
1BBD   16 00                  MVI   d,0   ; DE = opcode * 2
1BBF   21 D7 1B               LXI   h,dispatch_table   
1BC2   19                     DAD   d   ; HL = &dispatch_table[opcode]
1BC3                             ; テーブル上限チェック
1BC3   11 AB 1C               LXI   d,dispatch_table_end   
1BC6   7B                     MOV   a,e   
1BC7   95                     SUB   l   
1BC8   7A                     MOV   a,d   
1BC9   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
1BCA   DA 03 00               JC   vm_error   ; テーブル範囲外
1BCD                             ; アドレスを読んでジャンプ
1BCD   5E                     MOV   e,m   ; E = 下位バイト
1BCE   23                     INX   h   
1BCF   56                     MOV   d,m   ; D = 上位バイト
1BD0   EB                     XCHG      ; HL = ハンドラアドレス
1BD1                             ; 0000h ならエラー (未実装マーカー)
1BD1   7C                     MOV   a,h   
1BD2   B5                     ORA   l   
1BD3   CA 03 00               JZ   vm_error   
1BD6   E9                     PCHL      ; ハンドラへジャンプ
1BD7                             ; 
1BD7                             ; ===============================================================
1BD7                             ; ディスパッチテーブル
1BD7                             ; 
1BD7                             ; オペコード番号順に 2 バイトのアドレスを並べる。
1BD7                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
1BD7                             ; ===============================================================
1BD7                DISPATCH_TABLE:      
1BD7   DE 10                  DW   do_op_nop   ; 00 OP_NOP
1BD9   E1 10                  DW   do_op_move   ; 01 OP_MOVE
1BDB   00 00                  DW   0000h   ; 02 OP_LOADL
1BDD   F7 10                  DW   do_op_loadi   ; 03 OP_LOADI
1BDF   0C 11                  DW   do_op_loadineg   ; 04 OP_LOADINEG
1BE1   23 11                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
1BE3   33 11                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
1BE5   38 11                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
1BE7   3D 11                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
1BE9   42 11                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
1BEB   47 11                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
1BED   4C 11                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
1BEF   51 11                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
1BF1   56 11                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
1BF3   66 11                  DW   do_op_loadi16   ; 0E OP_LOADI16
1BF5   00 00                  DW   0000h   ; 0F OP_LOADI32
1BF7   00 00                  DW   0000h   ; 10 OP_LOADSYM
1BF9   7F 11                  DW   do_op_loadnil   ; 11 OP_LOADNIL
1BFB   69 17                  DW   do_op_loadself   ; 12 OP_LOADSELF
1BFD   8D 11                  DW   do_op_loadt   ; 13 OP_LOADT
1BFF   9B 11                  DW   do_op_loadf   ; 14 OP_LOADF
1C01   CA 13                  DW   do_op_getgv   ; 15 OP_GETGV
1C03   0C 14                  DW   do_op_setgv   ; 16 OP_SETGV
1C05   00 00                  DW   0000h   ; 17 OP_GETSV
1C07   00 00                  DW   0000h   ; 18 OP_SETSV
1C09   CA 13                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
1C0B   0C 14                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
1C0D   00 00                  DW   0000h   ; 1B OP_GETCV
1C0F   00 00                  DW   0000h   ; 1C OP_SETCV
1C11   F2 19                  DW   do_op_getconst   ; 1D OP_GETCONST
1C13   00 00                  DW   0000h   ; 1E OP_SETCONST
1C15   00 00                  DW   0000h   ; 1F OP_GETMCNST
1C17   00 00                  DW   0000h   ; 20 OP_SETMCNST
1C19   00 19                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
1C1B   2C 19                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
1C1D   D5 1F                  DW   do_op_getidx   ; 23 OP_GETIDX
1C1F   7C 20                  DW   do_op_setidx   ; 24 OP_SETIDX
1C21   83 13                  DW   do_op_jmp   ; 25 OP_JMP
1C23   8C 13                  DW   do_op_jmpif   ; 26 OP_JMPIF
1C25   AB 13                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
1C27   00 00                  DW   0000h   ; 28 OP_JMPNIL
1C29   83 13                  DW   do_op_jmp   ; 29 OP_JMPUW (= OP_JMP)
1C2B   00 00                  DW   0000h   ; 2A OP_EXCEPT
1C2D   00 00                  DW   0000h   ; 2B OP_RESCUE
1C2F   00 00                  DW   0000h   ; 2C OP_RAISEIF
1C31   6D 14                  DW   do_op_ssend   ; 2D OP_SSEND
1C33   B6 17                  DW   do_op_ssendb   ; 2E OP_SSENDB
1C35   8E 14                  DW   do_op_send   ; 2F OP_SEND
1C37   DC 17                  DW   do_op_sendb   ; 30 OP_SENDB
1C39   00 00                  DW   0000h   ; 31 OP_CALL
1C3B   00 00                  DW   0000h   ; 32 OP_SUPER
1C3D   00 00                  DW   0000h   ; 33 OP_ARGARY
1C3F   AA 17                  DW   do_op_enter   ; 34 OP_ENTER
1C41   00 00                  DW   0000h   ; 35 OP_KEY_P
1C43   00 00                  DW   0000h   ; 36 OP_KEYEND
1C45   00 00                  DW   0000h   ; 37 OP_KARG
1C47   91 1A                  DW   do_op_return   ; 38 OP_RETURN
1C49   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
1C4B   B1 18                  DW   do_op_break   ; 3A OP_BREAK
1C4D   00 00                  DW   0000h   ; 3B OP_BLKPUSH
1C4F   A9 11                  DW   do_op_add   ; 3C OP_ADD
1C51   EB 11                  DW   do_op_addi   ; 3D OP_ADDI
1C53   D3 11                  DW   do_op_sub   ; 3E OP_SUB
1C55   05 12                  DW   do_op_subi   ; 3F OP_SUBI
1C57   1F 12                  DW   do_op_mul   ; 40 OP_MUL
1C59   43 12                  DW   do_op_div   ; 41 OP_DIV
1C5B   22 13                  DW   do_op_eq   ; 42 OP_EQ
1C5D   4C 13                  DW   do_op_lt   ; 43 OP_LT
1C5F   56 13                  DW   do_op_le   ; 44 OP_LE
1C61   63 13                  DW   do_op_gt   ; 45 OP_GT
1C63   70 13                  DW   do_op_ge   ; 46 OP_GE
1C65   32 21                  DW   do_op_array   ; 47 OP_ARRAY
1C67   AC 23                  DW   do_op_array2   ; 48 OP_ARRAY2
1C69   00 00                  DW   0000h   ; 49 OP_ARYCAT
1C6B   AE 21                  DW   do_op_arypush   ; 4A OP_ARYPUSH
1C6D   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
1C6F   00 00                  DW   0000h   ; 4C OP_AREF
1C71   00 00                  DW   0000h   ; 4D OP_ASET
1C73   00 00                  DW   0000h   ; 4E OP_APOST
1C75   00 00                  DW   0000h   ; 4F OP_INTERN
1C77   00 00                  DW   0000h   ; 50 OP_SYMBOL
1C79   33 1D                  DW   do_op_string   ; 51 OP_STRING
1C7B   26 22                  DW   do_op_strcat   ; 52 OP_STRCAT
1C7D   BE 23                  DW   do_op_hash   ; 53 OP_HASH
1C7F   00 00                  DW   0000h   ; 54 OP_HASHADD
1C81   00 00                  DW   0000h   ; 55 OP_HASHCAT
1C83   00 00                  DW   0000h   ; 56 OP_LAMBDA
1C85   7D 17                  DW   do_op_block   ; 57 OP_BLOCK
1C87   6A 19                  DW   do_op_method   ; 58 OP_METHOD
1C89   00 00                  DW   0000h   ; 59 OP_RANGE_INC
1C8B   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
1C8D   00 00                  DW   0000h   ; 5B OP_OCLASS
1C8F   F2 19                  DW   do_op_class   ; 5C OP_CLASS
1C91   00 00                  DW   0000h   ; 5D OP_MODULE
1C93   1F 1A                  DW   do_op_exec   ; 5E OP_EXEC
1C95   8B 19                  DW   do_op_def   ; 5F OP_DEF
1C97   00 00                  DW   0000h   ; 60 OP_ALIAS
1C99   00 00                  DW   0000h   ; 61 OP_UNDEF
1C9B   00 00                  DW   0000h   ; 62 OP_SCLASS
1C9D   58 19                  DW   do_op_tclass   ; 63 OP_TCLASS
1C9F   00 00                  DW   0000h   ; 64 OP_DEBUG
1CA1   00 00                  DW   0000h   ; 65 OP_ERR
1CA3   00 00                  DW   0000h   ; 66 OP_EXT1
1CA5   00 00                  DW   0000h   ; 67 OP_EXT2
1CA7   00 00                  DW   0000h   ; 68 OP_EXT3
1CA9   53 1B                  DW   do_op_stop   ; 69 OP_STOP
1CAB                DISPATCH_TABLE_END:      
1CAB                             ; 
1CAB                             ; ===============================================================
1CAB                             ; clear_pages — B ページ (256 バイト × B) をゼロクリア
1CAB                             ; 
1CAB                             ; 入力: HL = 先頭アドレス, B = ページ数
1CAB                             ; 破壊: A, B, C, HL
1CAB                             ; ===============================================================
1CAB                CLEAR_PAGES:      
1CAB   0E 00                  MVI   c,0   ; 256 回
1CAD                CLEAR_PAGES_BYTE:      
1CAD   36 00                  MVI   m,0   
1CAF   23                     INX   h   
1CB0   0D                     DCR   c   
1CB1   C2 AD 1C               JNZ   clear_pages_byte   
1CB4   05                     DCR   b   
1CB5   C2 AB 1C               JNZ   clear_pages   
1CB8   C9                     RET      
1CB9                             ; 
1CB9                             ; ===============================================================
1CB9                             ; 初期化 (起動時 1 回だけ)
1CB9                             ; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
1CB9                             ; ===============================================================
1CB9                VM_START:      
1CB9                             ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
1CB9   21 00 80               LXI   h,VM_STATE_BASE   
1CBC   06 01                  MVI   b,1   
1CBE   CD AB 1C               CALL   clear_pages   
1CC1                             ; 
1CC1                             ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
1CC1   21 00 81               LXI   h,REG_FILE_BASE   
1CC4   06 01                  MVI   b,1   
1CC6   CD AB 1C               CALL   clear_pages   
1CC9                             ; 
1CC9                             ; メソッド表をゼロクリア (256 バイト = 1 ページ)
1CC9   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1CCC   06 01                  MVI   b,1   
1CCE   CD AB 1C               CALL   clear_pages   
1CD1                             ; 
1CD1                             ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
1CD1   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1CD4   06 04                  MVI   b,4   
1CD6   CD AB 1C               CALL   clear_pages   
1CD9                             ; 
1CD9                             ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
1CD9   21 C0 96               LXI   h,COLLECTION_POOL_BASE   
1CDC   06 09                  MVI   b,9   
1CDE   CD AB 1C               CALL   clear_pages   
1CE1                             ; 
1CE1                             ; IREP 0 のバイトコード長を VM 状態に設定
1CE1                             ; IREP テーブルの先頭エントリから読む
1CE1   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
1CE4   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1CE7   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
1CEA   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1CED                             ; 
1CED                             ; レジスタベースを初期化 (REG_FILE_BASE)
1CED   21 00 81               LXI   h,REG_FILE_BASE   
1CF0   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
1CF3                             ; 
1CF3                             ; バイトコードベースを IREP 0 から読んで設定
1CF3   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
1CF6   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1CF9   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
1CFC   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1CFF                             ; 
1CFF                             ; シンボルテーブルベースを IREP 0 から読んで設定
1CFF   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
1D02   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1D05   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
1D08   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1D0B                             ; 
1D0B                             ; 定数プールベースを IREP 0 から読んで設定
1D0B   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
1D0E   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1D11   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
1D14   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1D17                             ; 
1D17                             ; フレーム SP = 0 (ゼロクリア済み)
1D17                             ; PC = 0 (ゼロクリア済み)
1D17                             ; 
1D17                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
1D17                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
1D17   3A FE 82               LDA   INIT_METHOD_ID_STORE   
1D1A   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
1D1D                             ; 
1D1D                             ; R[0] = self (TT_OBJECT, 値 = 0)
1D1D   21 00 81               LXI   h,REG_FILE_BASE   
1D20   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1D22   23                     INX   h   
1D23   36 00                  MVI   m,0   ; +1: 予約
1D25   23                     INX   h   
1D26   36 00                  MVI   m,0   ; +2: val_lo
1D28   23                     INX   h   
1D29   36 00                  MVI   m,0   ; +3: val_hi
1D2B                             ; 
1D2B                             ; 実行状態を RUNNING に設定
1D2B   3E 01                  MVI   a,VM_RUNNING   
1D2D   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D30                             ; 
1D30                             ; メインループへ
1D30   C3 86 1B               JMP   vm_loop   
1D33                             ; 
1D33                             ; ===============================================================
1D33                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
1D33                             ; 
1D33                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
1D33                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
1D33                             ; ===============================================================
1D33                DO_OP_STRING:      
1D33   CD C0 10               CALL   fetch_byte   ; A = a
1D36   32 90 1D               STA   ops_reg_a   
1D39   CD C0 10               CALL   fetch_byte   ; A = b (プールインデックス)
1D3C                             ; pool_base + b * 4 を計算
1D3C   87                     ADD   a   ; b * 2
1D3D   87                     ADD   a   ; b * 4
1D3E   5F                     MOV   e,a   
1D3F   16 00                  MVI   d,0   
1D41   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
1D44   19                     DAD   d   ; HL = &Pool[b]
1D45                             ; Pool[b] の val (文字列データアドレス) を取得
1D45   23                     INX   h   ; +1: 予約
1D46   23                     INX   h   ; +2: val_lo
1D47   5E                     MOV   e,m   
1D48   23                     INX   h   ; +3: val_hi
1D49   56                     MOV   d,m   ; DE = 文字列データアドレス
1D4A                             ; DE → 長さバイト + ASCII データ
1D4A   1A                     LDAX   d   ; A = 文字列長
1D4B   32 91 1D               STA   ops_str_len   
1D4E   13                     INX   d   ; DE → 最初のバイト
1D4F   D5                     PUSH   d   ; 文字列データソース退避
1D50                             ; 
1D50                             ; コレクションスロットを確保
1D50   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
1D53   32 92 1D               STA   ops_slot_num   
1D56                             ; 
1D56                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
1D56   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
1D58   23                     INX   h   
1D59   3A 91 1D               LDA   ops_str_len   
1D5C   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
1D5E   DA 63 1D               JC   ops_len_ok   
1D61   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
1D63                OPS_LEN_OK:      
1D63   77                     MOV   m,a   ; +1: count
1D64   32 91 1D               STA   ops_str_len   ; 切り詰め後の長さ
1D67   23                     INX   h   ; HL → データ領域先頭
1D68                             ; 
1D68                             ; 文字列データをコピー
1D68   D1                     POP   d   ; DE = ソースデータ
1D69   3A 91 1D               LDA   ops_str_len   
1D6C   B7                     ORA   a   
1D6D   CA 79 1D               JZ   ops_set_reg   ; 空文字列
1D70   4F                     MOV   c,a   
1D71                OPS_STR_COPY:      
1D71   1A                     LDAX   d   
1D72   77                     MOV   m,a   
1D73   23                     INX   h   
1D74   13                     INX   d   
1D75   0D                     DCR   c   
1D76   C2 71 1D               JNZ   ops_str_copy   
1D79                             ; 
1D79                OPS_SET_REG:      
1D79                             ; R[a] = TT_STRING, val_lo = slot+1
1D79   3A 90 1D               LDA   ops_reg_a   
1D7C   CD 00 10               CALL   get_reg_addr   ; HL = &R[a]
1D7F   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
1D81   23                     INX   h   
1D82   36 00                  MVI   m,0   ; +1: 予約
1D84   23                     INX   h   
1D85   3A 92 1D               LDA   ops_slot_num   
1D88   3C                     INR   a   ; slot + 1
1D89   77                     MOV   m,a   ; +2: val_lo
1D8A   23                     INX   h   
1D8B   36 00                  MVI   m,0   ; +3: val_hi
1D8D   C3 86 1B               JMP   vm_loop   
1D90                             ; 
1D90   00           OPS_REG_A:   DB   0   
1D91   00           OPS_STR_LEN:   DB   0   
1D92   00           OPS_SLOT_NUM:   DB   0   
1D93                             ; 
1D93                             ; ===============================================================
1D93                             ; send_display — display(value): 7 セグに hex 表示
1D93                             ; 
1D93                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
1D93                             ; R[a] に nil を返す。
1D93                             ; ===============================================================
1D93                SEND_DISPLAY:      
1D93   3A 55 16               LDA   send_reg_a   
1D96   3C                     INR   a   
1D97   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1D9A   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1D9D   CD 49 1A               CALL   display_hex16   ; 7 セグに書く
1DA0                             ; return nil
1DA0   3A 55 16               LDA   send_reg_a   
1DA3   CD 00 10               CALL   get_reg_addr   
1DA6   3E 01                  MVI   a,TT_NIL   
1DA8   CD 1A 10               CALL   set_slot_special   
1DAB   C3 86 1B               JMP   vm_loop   
1DAE                             ; 
1DAE                             ; ===============================================================
1DAE                             ; send_getkey — getkey / getkey(timeout)
1DAE                             ; 
1DAE                             ; getkey (引数なし): KEYIN1 でブロッキング入力
1DAE                             ;   ROM なし → -1
1DAE                             ;   キー押下 → キーコード (0x00-0x17)
1DAE                             ; 
1DAE                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
1DAE                             ;   最大 n 回スキャン、キー押下 → キーコード
1DAE                             ;   タイムアウト / ROM なし → nil
1DAE                             ; 
1DAE                             ; キーコード割り当て (KEYIN1/KEY 共通):
1DAE                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
1DAE                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
1DAE                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
1DAE                             ;                                           0x17: LOAD
1DAE                             ; ===============================================================
1DAE                SEND_GETKEY:      
1DAE                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
1DAE   3A 56 16               LDA   send_argc   
1DB1   B7                     ORA   a   
1DB2   C2 2D 25               JNZ   send_getkey_timeout   
1DB5                             ; 
1DB5                             ; --- ブロッキング版 (引数なし) ---
1DB5   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
1DB8   B7                     ORA   a   
1DB9   CA D9 1D               JZ   getkey_no_key   ; ROM なし → -1
1DBC                             ; 
1DBC                             ; キー入力をポーリングしながら LFSR を回す。
1DBC                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
1DBC                             ; 乱数の種が毎回異なる。
1DBC                GETKEY_POLL:      
1DBC   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
1DBF   FE FF                  CPI   0FFh   
1DC1   C2 CA 1D               JNZ   getkey_got_key   
1DC4   CD 49 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
1DC7   C3 BC 1D               JMP   getkey_poll   
1DCA                             ; 
1DCA                GETKEY_GOT_KEY:      
1DCA                             ; キーコードを R[a] に返す
1DCA   4F                     MOV   c,a   
1DCB   06 00                  MVI   b,0   
1DCD   3A 55 16               LDA   send_reg_a   
1DD0   CD 00 10               CALL   get_reg_addr   
1DD3   CD 10 10               CALL   set_slot_int16   
1DD6   C3 86 1B               JMP   vm_loop   
1DD9                             ; 
1DD9                GETKEY_NO_KEY:      
1DD9   3A 55 16               LDA   send_reg_a   
1DDC   CD 00 10               CALL   get_reg_addr   
1DDF   06 FF                  MVI   b,0FFh   
1DE1   0E FF                  MVI   c,0FFh   ; -1
1DE3   CD 10 10               CALL   set_slot_int16   
1DE6   C3 86 1B               JMP   vm_loop   
1DE9                             ; 
1DE9                             ; ===============================================================
1DE9                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
1DE9                             ; 
1DE9                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
1DE9                             ; E レジスタにメソッド ID が入っている。
1DE9                             ; ===============================================================
1DE9                SEND_BUILTIN_EXT:      
1DE9   7B                     MOV   a,e   
1DEA   FE 1F                  CPI   METHOD_PUTS   
1DEC   CA 10 1E               JZ   send_puts   
1DEF   FE 20                  CPI   METHOD_SETSEG   
1DF1   CA B4 1E               JZ   send_setseg   
1DF4   FE 21                  CPI   METHOD_RAND   
1DF6   CA 6E 1F               JZ   send_rand   
1DF9   FE 12                  CPI   METHOD_LENGTH   
1DFB   CA A2 22               JZ   send_length   
1DFE   FE 14                  CPI   METHOD_CONCAT   
1E00   CA BB 22               JZ   send_concat   
1E03   FE 16                  CPI   METHOD_PUSH   
1E05   CA 79 23               JZ   concat_array   ; push は concat_array と同じ
1E08   FE 22                  CPI   METHOD_SLICE   
1E0A   CA 76 25               JZ   send_slice   
1E0D   C3 03 00               JMP   vm_error   ; 未対応メソッド
1E10                             ; 
1E10                             ; ===============================================================
1E10                             ; send_puts — puts(value): 文字列を 7 セグに表示
1E10                             ; 
1E10                             ; R[a+1] が TT_STRING の場合:
1E10                             ;   文字列データのアドレスから長さとバイト列を読み、
1E10                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
1E10                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
1E10                             ; 
1E10                             ; R[a+1] が TT_INTEGER の場合:
1E10                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
1E10                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
1E10                             ; 
1E10                             ; 使い方:
1E10                             ;   puts "HELLO"          # 文字列を表示
1E10                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
1E10                             ; ===============================================================
1E10                SEND_PUTS:      
1E10   3A 55 16               LDA   send_reg_a   
1E13   3C                     INR   a   
1E14   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1E17   7E                     MOV   a,m   ; A = 型タグ
1E18   FE 07                  CPI   TT_STRING   
1E1A   CA 54 1E               JZ   puts_string   
1E1D                             ; TT_INTEGER: 従来のパック ASCII 処理
1E1D   FE 04                  CPI   TT_INTEGER   
1E1F   C2 03 00               JNZ   vm_error   
1E22                             ; 
1E22                             ; --- 整数パス (2 文字スクロール表示) ---
1E22   3A 55 16               LDA   send_reg_a   
1E25   3C                     INR   a   
1E26   CD 00 10               CALL   get_reg_addr   
1E29   CD 32 10               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
1E2C   4E                     MOV   c,m   ; C = val_lo (右の文字)
1E2D   23                     INX   h   
1E2E   46                     MOV   b,m   ; B = val_hi (左の文字)
1E2F   C5                     PUSH   b   
1E30                             ; 
1E30                             ; 表示バッファを左に 2 桁スクロール
1E30   21 FA FF               LXI   h,DISPLAY_BASE + 2   
1E33   11 F8 FF               LXI   d,DISPLAY_BASE   
1E36   06 06                  MVI   b,6   
1E38                PUTS_SCROLL:      
1E38   7E                     MOV   a,m   
1E39   12                     STAX   d   
1E3A   23                     INX   h   
1E3B   13                     INX   d   
1E3C   05                     DCR   b   
1E3D   C2 38 1E               JNZ   puts_scroll   
1E40                             ; 
1E40   C1                     POP   b   
1E41   C5                     PUSH   b   
1E42   78                     MOV   a,b   
1E43   CD ED 1E               CALL   ascii_to_seg   
1E46   32 FE FF               STA   DISPLAY_BASE + 6   
1E49                             ; 
1E49   C1                     POP   b   
1E4A   79                     MOV   a,c   
1E4B   CD ED 1E               CALL   ascii_to_seg   
1E4E   32 FF FF               STA   DISPLAY_BASE + 7   
1E51   C3 A1 1E               JMP   puts_ret_nil   
1E54                             ; 
1E54                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
1E54                PUTS_STRING:      
1E54   3A 55 16               LDA   send_reg_a   
1E57   3C                     INR   a   
1E58   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1E5B   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロットアドレス
1E5E                             ; 
1E5E                             ; +1: count (文字列長)
1E5E   23                     INX   h   
1E5F   7E                     MOV   a,m   ; A = 文字列長
1E60   B7                     ORA   a   
1E61   CA A1 1E               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
1E64   FE 09                  CPI   9   
1E66   DA 6B 1E               JC   sp_len_ok   
1E69   3E 08                  MVI   a,8   ; 最大 8 文字
1E6B                SP_LEN_OK:      
1E6B   32 AF 1E               STA   sp_count   
1E6E   23                     INX   h   ; HL → データ領域先頭
1E6F   22 B0 1E               SHLD   sp_src   ; 文字列ソースポインタ退避
1E72                             ; 
1E72                             ; 表示バッファ全体をクリア
1E72   21 F8 FF               LXI   h,DISPLAY_BASE   
1E75   0E 08                  MVI   c,DISPLAY_SIZE   
1E77                PUTS_STR_CLEAR:      
1E77   36 00                  MVI   m,0   
1E79   23                     INX   h   
1E7A   0D                     DCR   c   
1E7B   C2 77 1E               JNZ   puts_str_clear   
1E7E                             ; 
1E7E                             ; 文字列の各バイトを変換して表示
1E7E   21 F8 FF               LXI   h,DISPLAY_BASE   
1E81   22 B2 1E               SHLD   sp_dst   ; 表示書き込みポインタ
1E84                PUTS_STR_LOOP:      
1E84   2A B0 1E               LHLD   sp_src   
1E87   7E                     MOV   a,m   ; A = ASCII コード
1E88   23                     INX   h   
1E89   22 B0 1E               SHLD   sp_src   
1E8C   CD ED 1E               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
1E8F   2A B2 1E               LHLD   sp_dst   
1E92   77                     MOV   m,a   
1E93   23                     INX   h   
1E94   22 B2 1E               SHLD   sp_dst   
1E97   3A AF 1E               LDA   sp_count   
1E9A   3D                     DCR   a   
1E9B   32 AF 1E               STA   sp_count   
1E9E   C2 84 1E               JNZ   puts_str_loop   
1EA1                             ; 
1EA1                PUTS_RET_NIL:      
1EA1   3A 55 16               LDA   send_reg_a   
1EA4   CD 00 10               CALL   get_reg_addr   
1EA7   3E 01                  MVI   a,TT_NIL   
1EA9   CD 1A 10               CALL   set_slot_special   
1EAC   C3 86 1B               JMP   vm_loop   
1EAF                             ; 
1EAF   00           SP_COUNT:   DB   0   
1EB0   00 00        SP_SRC:   DW   0   
1EB2   00 00        SP_DST:   DW   0   
1EB4                             ; 
1EB4                             ; ===============================================================
1EB4                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
1EB4                             ; 
1EB4                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
1EB4                             ; ===============================================================
1EB4                SEND_SETSEG:      
1EB4                             ; 桁位置を取得
1EB4   3A 55 16               LDA   send_reg_a   
1EB7   3C                     INR   a   
1EB8   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1EBB   CD 32 10               CALL   slot_to_value   
1EBE   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
1EBF   FE 08                  CPI   DISPLAY_SIZE   
1EC1   D2 03 00               JNC   vm_error   ; 桁位置 >= 8 → エラー
1EC4   32 EC 1E               STA   ss_pos   
1EC7                             ; 
1EC7                             ; パターンを取得
1EC7   3A 55 16               LDA   send_reg_a   
1ECA   3C                     INR   a   
1ECB   3C                     INR   a   
1ECC   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
1ECF   CD 32 10               CALL   slot_to_value   
1ED2   46                     MOV   b,m   ; B = パターン (val_lo)
1ED3                             ; 
1ED3                             ; DISPLAY_BASE + pos にパターンを書く
1ED3   3A EC 1E               LDA   ss_pos   
1ED6   6F                     MOV   l,a   
1ED7   26 00                  MVI   h,0   
1ED9   11 F8 FF               LXI   d,DISPLAY_BASE   
1EDC   19                     DAD   d   ; HL = DISPLAY_BASE + pos
1EDD   70                     MOV   m,b   
1EDE                             ; 
1EDE                             ; R[a] に nil を返す
1EDE   3A 55 16               LDA   send_reg_a   
1EE1   CD 00 10               CALL   get_reg_addr   
1EE4   3E 01                  MVI   a,TT_NIL   
1EE6   CD 1A 10               CALL   set_slot_special   
1EE9   C3 86 1B               JMP   vm_loop   
1EEC                             ; 
1EEC   00           SS_POS:   DB   0   
1EED                             ; 
1EED                             ; ===============================================================
1EED                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
1EED                             ; 
1EED                             ;   入力: A = ASCII コード
1EED                             ;   出力: A = セグメントパターン
1EED                             ;   破壊: HL, BC
1EED                             ; 
1EED                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
1EED                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
1EED                             ; 範囲外はブランク (0x00) を返す。
1EED                             ; ===============================================================
1EED                ASCII_TO_SEG:      
1EED   FE 60                  CPI   60h   
1EEF   DA F4 1E               JC   ats_no_fold   
1EF2   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
1EF4                ATS_NO_FOLD:      
1EF4   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
1EF6   DA 07 1F               JC   ats_blank   ; 元が < 0x20 → ブランク
1EF9   FE 40                  CPI   40h   
1EFB   D2 07 1F               JNC   ats_blank   ; >= 64 → ブランク
1EFE                             ; テーブル参照
1EFE   6F                     MOV   l,a   
1EFF   26 00                  MVI   h,0   
1F01   01 09 1F               LXI   b,ascii_seg_table   
1F04   09                     DAD   b   ; HL = ascii_seg_table + index
1F05   7E                     MOV   a,m   
1F06   C9                     RET      
1F07                ATS_BLANK:      
1F07   AF                     XRA   a   ; A = 0 (ブランク)
1F08   C9                     RET      
1F09                             ; 
1F09                             ; ===============================================================
1F09                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
1F09                             ; 
1F09                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
1F09                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
1F09                             ; 
1F09                             ; セグメント配置:
1F09                             ;     aaa        bit 0 = a (上)
1F09                             ;    f   b       bit 1 = b (右上)
1F09                             ;     ggg        bit 2 = c (右下)
1F09                             ;    e   c       bit 3 = d (下)
1F09                             ;     ddd        bit 4 = e (左下)
1F09                             ;                bit 5 = f (左上)
1F09                             ;                bit 6 = g (中)
1F09                             ; 
1F09                             ; 表現できない文字は 0x00 (消灯)。
1F09                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
1F09                             ; ===============================================================
1F09                ASCII_SEG_TABLE:      
1F09                             ; 0x20-0x2F: 記号
1F09   00                     DB   00h   ; 0x20 " " (スペース)
1F0A   06                     DB   06h   ; 0x21 "!" (bc)
1F0B   22                     DB   22h   ; 0x22 """ (bf)
1F0C   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
1F0D   6D                     DB   6Dh   ; 0x24 "$" (= S)
1F0E   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
1F0F   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
1F10   02                     DB   02h   ; 0x27 "'" (b)
1F11   39                     DB   39h   ; 0x28 "(" (= C)
1F12   0F                     DB   0Fh   ; 0x29 ")" (abcd)
1F13   49                     DB   49h   ; 0x2A "*" (adg = 三)
1F14   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
1F15   04                     DB   04h   ; 0x2C "," (c)
1F16   40                     DB   40h   ; 0x2D "-" (g)
1F17   08                     DB   08h   ; 0x2E "." (d)
1F18   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
1F19                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
1F19   5C                     DB   5Ch   ; 0x30 "0"
1F1A   06                     DB   06h   ; 0x31 "1"
1F1B   5B                     DB   5Bh   ; 0x32 "2"
1F1C   4F                     DB   4Fh   ; 0x33 "3"
1F1D   66                     DB   66h   ; 0x34 "4"
1F1E   6D                     DB   6Dh   ; 0x35 "5"
1F1F   7D                     DB   7Dh   ; 0x36 "6"
1F20   27                     DB   27h   ; 0x37 "7"
1F21   7F                     DB   7Fh   ; 0x38 "8"
1F22   6F                     DB   6Fh   ; 0x39 "9"
1F23                             ; 0x3A-0x40: 記号
1F23   09                     DB   09h   ; 0x3A ":" (ad)
1F24   00                     DB   00h   ; 0x3B ";"
1F25   00                     DB   00h   ; 0x3C "<"
1F26   48                     DB   48h   ; 0x3D "=" (dg)
1F27   00                     DB   00h   ; 0x3E ">"
1F28   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
1F29   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
1F2A                             ; 0x41-0x5A: 英字
1F2A   77                     DB   77h   ; 0x41 "A" (abcefg)
1F2B   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
1F2C   39                     DB   39h   ; 0x43 "C" (adef)
1F2D   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
1F2E   79                     DB   79h   ; 0x45 "E" (adefg)
1F2F   71                     DB   71h   ; 0x46 "F" (aefg)
1F30   3D                     DB   3Dh   ; 0x47 "G" (acdef)
1F31   76                     DB   76h   ; 0x48 "H" (bcefg)
1F32   06                     DB   06h   ; 0x49 "I" (bc)
1F33   1E                     DB   1Eh   ; 0x4A "J" (bcde)
1F34   74                     DB   74h   ; 0x4B "K" (cefg = h)
1F35   38                     DB   38h   ; 0x4C "L" (def)
1F36   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
1F37   54                     DB   54h   ; 0x4E "N" (ceg = n)
1F38   5C                     DB   5Ch   ; 0x4F "O" (= 0)
1F39   73                     DB   73h   ; 0x50 "P" (abefg)
1F3A   67                     DB   67h   ; 0x51 "Q" (abcfg)
1F3B   50                     DB   50h   ; 0x52 "R" (eg = r)
1F3C   6D                     DB   6Dh   ; 0x53 "S" (= 5)
1F3D   78                     DB   78h   ; 0x54 "T" (defg = t)
1F3E   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
1F3F   3E                     DB   3Eh   ; 0x56 "V" (= U)
1F40   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
1F41   76                     DB   76h   ; 0x58 "X" (bcefg = H)
1F42   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
1F43   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
1F44                             ; 0x5B-0x5F: 記号
1F44   39                     DB   39h   ; 0x5B "[" (= C)
1F45   00                     DB   00h   ; 0x5C "\"
1F46   0F                     DB   0Fh   ; 0x5D "]" (= ))
1F47   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
1F48   08                     DB   08h   ; 0x5F "_" (d)
1F49                             ; 
1F49                             ; ===============================================================
1F49                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
1F49                             ; 
1F49                             ;   入力: なし
1F49                             ;   出力: HL = 新しい乱数値
1F49                             ;   破壊: A, HL
1F49                             ; 
1F49                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
1F49                             ; 周期: 65535
1F49                             ; ===============================================================
1F49                LFSR_NEXT:      
1F49   2A 6C 1F               LHLD   lfsr_state   
1F4C   7D                     MOV   a,l   
1F4D   E6 01                  ANI   1   ; LSB チェック
1F4F   CA 61 1F               JZ   lfsr_no_tap   
1F52                             ; LSB=1: 右シフト + XOR タップ
1F52   7C                     MOV   a,h   
1F53   B7                     ORA   a   ; CY=0 クリア
1F54   1F                     RAR      
1F55   67                     MOV   h,a   
1F56   7D                     MOV   a,l   
1F57   1F                     RAR      
1F58   6F                     MOV   l,a   
1F59   7C                     MOV   a,h   
1F5A   EE B4                  XRI   0B4h   
1F5C   67                     MOV   h,a   
1F5D   22 6C 1F               SHLD   lfsr_state   
1F60   C9                     RET      
1F61                LFSR_NO_TAP:      
1F61                             ; LSB=0: 右シフトのみ
1F61   7C                     MOV   a,h   
1F62   B7                     ORA   a   
1F63   1F                     RAR      
1F64   67                     MOV   h,a   
1F65   7D                     MOV   a,l   
1F66   1F                     RAR      
1F67   6F                     MOV   l,a   
1F68   22 6C 1F               SHLD   lfsr_state   
1F6B   C9                     RET      
1F6C                             ; 
1F6C   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
1F6E                             ; 
1F6E                             ; ===============================================================
1F6E                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
1F6E                             ; 
1F6E                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
1F6E                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
1F6E                             ; ===============================================================
1F6E                SEND_RAND:      
1F6E                             ; R[a+1] から n を取得
1F6E   3A 55 16               LDA   send_reg_a   
1F71   3C                     INR   a   
1F72   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1F75   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1F78   5E                     MOV   e,m   
1F79   23                     INX   h   
1F7A   56                     MOV   d,m   ; DE = n
1F7B                             ; 
1F7B                             ; n == 0 チェック
1F7B   7A                     MOV   a,d   
1F7C   B3                     ORA   e   
1F7D   CA 98 1F               JZ   rand_zero   
1F80                             ; 
1F80   D5                     PUSH   d   ; n を退避
1F81   CD 49 1F               CALL   lfsr_next   ; HL = 乱数
1F84   44                     MOV   b,h   
1F85   4D                     MOV   c,l   ; BC = 乱数 (被除数)
1F86   D1                     POP   d   ; DE = n (除数)
1F87   CD A5 12               CALL   udiv16   ; BC=商, HL=剰余
1F8A                             ; 
1F8A                             ; HL (剰余) → BC → R[a]
1F8A   44                     MOV   b,h   
1F8B   4D                     MOV   c,l   
1F8C   3A 55 16               LDA   send_reg_a   
1F8F   CD 00 10               CALL   get_reg_addr   
1F92   CD 10 10               CALL   set_slot_int16   
1F95   C3 86 1B               JMP   vm_loop   
1F98                             ; 
1F98                RAND_ZERO:      
1F98   06 00                  MVI   b,0   
1F9A   0E 00                  MVI   c,0   
1F9C   3A 55 16               LDA   send_reg_a   
1F9F   CD 00 10               CALL   get_reg_addr   
1FA2   CD 10 10               CALL   set_slot_int16   
1FA5   C3 86 1B               JMP   vm_loop   
1FA8                             ; 
1FA8                             ; ===============================================================
1FA8                             ; コレクションプール基盤ルーチン
1FA8                             ; ===============================================================
1FA8                             ; 
1FA8                             ; ---------------------------------------------------------------
1FA8                             ; col_slot_addr — スロット番号からアドレスを計算
1FA8                             ; 
1FA8                             ;   入力: A = スロット番号 (0-based)
1FA8                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
1FA8                             ;   破壊: A, DE
1FA8                             ; ---------------------------------------------------------------
1FA8                COL_SLOT_ADDR:      
1FA8                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
1FA8                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
1FA8   6F                     MOV   l,a   
1FA9   26 00                  MVI   h,0   ; HL = slot_number
1FAB   29                     DAD   h   ; HL = slot_number × 2
1FAC   29                     DAD   h   ; HL = slot_number × 4
1FAD   54                     MOV   d,h   
1FAE   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
1FAF   29                     DAD   h   ; HL = slot_number × 8
1FB0   29                     DAD   h   ; HL = slot_number × 16
1FB1   29                     DAD   h   ; HL = slot_number × 32
1FB2   19                     DAD   d   ; HL = slot_number × 36
1FB3   11 C0 96               LXI   d,COLLECTION_POOL_BASE   
1FB6   19                     DAD   d   
1FB7   C9                     RET      
1FB8                             ; 
1FB8                             ; ---------------------------------------------------------------
1FB8                             ; col_alloc — コレクションスロットを確保
1FB8                             ; 
1FB8                             ;   入力: なし
1FB8                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
1FB8                             ;   破壊: DE
1FB8                             ;   エラー: プール満杯かつ GC で回収不可 → vm_error
1FB8                             ; ---------------------------------------------------------------
1FB8                COL_ALLOC:      
1FB8   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
1FBB   FE 40                  CPI   MAX_COL_SLOTS   
1FBD   D2 23 26               JNC   col_gc_alloc   ; プール満杯 → GC 試行
1FC0   F5                     PUSH   psw   ; スロット番号を退避
1FC1   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス
1FC4                             ; COL_SP++
1FC4   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
1FC7   3C                     INR   a   
1FC8   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
1FCB   F1                     POP   psw   ; A = スロット番号
1FCC   C9                     RET      
1FCD                             ; 
1FCD                             ; ---------------------------------------------------------------
1FCD                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
1FCD                             ; 
1FCD                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
1FCD                             ;   出力: HL = コレクションスロットアドレス
1FCD                             ;   破壊: A, DE
1FCD                             ; ---------------------------------------------------------------
1FCD                COL_FROM_REG:      
1FCD   CD 32 10               CALL   slot_to_value   ; HL = val アドレス
1FD0   7E                     MOV   a,m   ; A = val_lo = slot+1
1FD1   3D                     DCR   a   ; A = slot_number (0-based)
1FD2   C3 A8 1F               JMP   col_slot_addr   
1FD5                             ; 
1FD5                             ; ===============================================================
1FD5                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
1FD5                             ; 
1FD5                             ; R[a] の型で分岐:
1FD5                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
1FD5                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
1FD5                             ; ===============================================================
1FD5                DO_OP_GETIDX:      
1FD5   CD C0 10               CALL   fetch_byte   ; A = a
1FD8   32 78 20               STA   gidx_reg_a   
1FDB   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1FDE   7E                     MOV   a,m   ; A = 型タグ
1FDF   FE 07                  CPI   TT_STRING   
1FE1   CA F1 1F               JZ   gidx_string   
1FE4   FE 08                  CPI   TT_ARRAY   
1FE6   CA 3D 20               JZ   gidx_array   
1FE9   FE 09                  CPI   TT_HASH   
1FEB   CA 2A 24               JZ   gidx_hash   
1FEE   C3 03 00               JMP   vm_error   
1FF1                             ; 
1FF1                GIDX_STRING:      
1FF1                             ; R[a] のコレクションスロットを取得
1FF1   3A 78 20               LDA   gidx_reg_a   
1FF4   CD 00 10               CALL   get_reg_addr   
1FF7   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
1FFA   23                     INX   h   ; +1: count
1FFB   46                     MOV   b,m   ; B = 文字列長
1FFC   23                     INX   h   ; HL → データ領域先頭
1FFD   22 79 20               SHLD   gidx_data_addr   
2000                             ; 
2000                             ; R[a+1] からインデックスを取得
2000   3A 78 20               LDA   gidx_reg_a   
2003   3C                     INR   a   
2004   CD 00 10               CALL   get_reg_addr   
2007   CD 32 10               CALL   slot_to_value   
200A   7E                     MOV   a,m   ; A = index (val_lo)
200B                             ; 範囲チェック: index < 文字列長
200B   B8                     CMP   b   
200C   D2 03 00               JNC   vm_error   ; index >= 長さ → エラー
200F                             ; データ先頭 + index で 1 文字を取得
200F   5F                     MOV   e,a   
2010   16 00                  MVI   d,0   
2012   2A 79 20               LHLD   gidx_data_addr   
2015   19                     DAD   d   ; HL = &data[index]
2016   4E                     MOV   c,m   ; C = 文字コード
2017                             ; 
2017                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
2017   C5                     PUSH   b   ; C = 文字コード退避
2018   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
201B   32 7B 20               STA   gidx_new_slot   
201E   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2020   23                     INX   h   
2021   36 01                  MVI   m,1   ; +1: count = 1
2023   23                     INX   h   
2024   C1                     POP   b   
2025   71                     MOV   m,c   ; +2: data[0] = 文字コード
2026                             ; 
2026                             ; R[a] = TT_STRING, val_lo = new_slot+1
2026   3A 78 20               LDA   gidx_reg_a   
2029   CD 00 10               CALL   get_reg_addr   
202C   36 07                  MVI   m,TT_STRING   
202E   23                     INX   h   
202F   36 00                  MVI   m,0   
2031   23                     INX   h   
2032   3A 7B 20               LDA   gidx_new_slot   
2035   3C                     INR   a   
2036   77                     MOV   m,a   
2037   23                     INX   h   
2038   36 00                  MVI   m,0   
203A   C3 86 1B               JMP   vm_loop   
203D                             ; 
203D                GIDX_ARRAY:      
203D                             ; R[a] のコレクションスロットを取得
203D   3A 78 20               LDA   gidx_reg_a   
2040   CD 00 10               CALL   get_reg_addr   
2043   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
2046   23                     INX   h   ; +1: count
2047   46                     MOV   b,m   ; B = 要素数
2048   23                     INX   h   ; HL → データ領域先頭
2049   22 79 20               SHLD   gidx_data_addr   
204C                             ; 
204C                             ; R[a+1] からインデックスを取得
204C   3A 78 20               LDA   gidx_reg_a   
204F   3C                     INR   a   
2050   CD 00 10               CALL   get_reg_addr   
2053   CD 32 10               CALL   slot_to_value   
2056   7E                     MOV   a,m   ; A = index (val_lo)
2057                             ; 範囲チェック: index < 要素数
2057   B8                     CMP   b   
2058   D2 03 00               JNC   vm_error   
205B                             ; data + index * 4 で要素スロットの先頭を求める
205B   87                     ADD   a   ; ×2
205C   87                     ADD   a   ; ×4
205D   5F                     MOV   e,a   
205E   16 00                  MVI   d,0   
2060   2A 79 20               LHLD   gidx_data_addr   
2063   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
2064   EB                     XCHG      ; DE = &data[index * 4]
2065                             ; 
2065                             ; R[a] にコピー (4 バイト)
2065   3A 78 20               LDA   gidx_reg_a   
2068   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
206B   0E 04                  MVI   c,SLOT_BYTES   
206D                GIDX_ARY_COPY:      
206D   1A                     LDAX   d   
206E   77                     MOV   m,a   
206F   23                     INX   h   
2070   13                     INX   d   
2071   0D                     DCR   c   
2072   C2 6D 20               JNZ   gidx_ary_copy   
2075   C3 86 1B               JMP   vm_loop   
2078                             ; 
2078   00           GIDX_REG_A:   DB   0   
2079   00 00        GIDX_DATA_ADDR:   DW   0   
207B   00           GIDX_NEW_SLOT:   DB   0   
207C                             ; 
207C                             ; ===============================================================
207C                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
207C                             ; 
207C                             ; R[a] の型で分岐:
207C                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
207C                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
207C                             ; ===============================================================
207C                DO_OP_SETIDX:      
207C   CD C0 10               CALL   fetch_byte   ; A = a
207F   32 2F 21               STA   sidx_reg_a   
2082   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2085   7E                     MOV   a,m   ; A = 型タグ
2086   FE 07                  CPI   TT_STRING   
2088   CA 98 20               JZ   sidx_string   
208B   FE 08                  CPI   TT_ARRAY   
208D   CA F2 20               JZ   sidx_array   
2090   FE 09                  CPI   TT_HASH   
2092   CA 92 24               JZ   sidx_hash   
2095   C3 03 00               JMP   vm_error   
2098                             ; 
2098                SIDX_STRING:      
2098                             ; R[a] のコレクションスロットを取得
2098   3A 2F 21               LDA   sidx_reg_a   
209B   CD 00 10               CALL   get_reg_addr   
209E   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
20A1   23                     INX   h   ; +1: count
20A2   46                     MOV   b,m   ; B = 文字列長
20A3   23                     INX   h   ; HL → データ領域先頭
20A4   22 30 21               SHLD   sidx_data_addr   
20A7                             ; 
20A7                             ; R[a+1] からインデックスを取得
20A7   3A 2F 21               LDA   sidx_reg_a   
20AA   3C                     INR   a   
20AB   CD 00 10               CALL   get_reg_addr   
20AE   CD 32 10               CALL   slot_to_value   
20B1   7E                     MOV   a,m   ; A = index
20B2   B8                     CMP   b   
20B3   D2 03 00               JNC   vm_error   ; index >= 長さ
20B6                             ; 
20B6                             ; data[index] に R[a+2] の文字を書き込む
20B6   5F                     MOV   e,a   
20B7   16 00                  MVI   d,0   
20B9   2A 30 21               LHLD   sidx_data_addr   
20BC   19                     DAD   d   ; HL = &data[index]
20BD                             ; 
20BD                             ; R[a+2] から文字コードを取得
20BD   3A 2F 21               LDA   sidx_reg_a   
20C0   3C                     INR   a   
20C1   3C                     INR   a   
20C2   CD 00 10               CALL   get_reg_addr   
20C5                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
20C5   7E                     MOV   a,m   ; 型タグ
20C6   FE 07                  CPI   TT_STRING   
20C8   CA D2 20               JZ   sidx_str_char   
20CB                             ; TT_INTEGER: val_lo を文字コードとして使う
20CB   CD 32 10               CALL   slot_to_value   
20CE   7E                     MOV   a,m   
20CF   C3 D8 20               JMP   sidx_write_char   
20D2                SIDX_STR_CHAR:      
20D2                             ; TT_STRING: コレクションスロットの先頭文字
20D2   CD CD 1F               CALL   col_from_reg   
20D5   23                     INX   h   ; +1: count
20D6   23                     INX   h   ; +2: data[0]
20D7   7E                     MOV   a,m   
20D8                SIDX_WRITE_CHAR:      
20D8   2A 30 21               LHLD   sidx_data_addr   
20DB   5F                     MOV   e,a   ; E = 文字コード
20DC   3A 2F 21               LDA   sidx_reg_a   
20DF   3C                     INR   a   
20E0   CD 00 10               CALL   get_reg_addr   
20E3   CD 32 10               CALL   slot_to_value   
20E6   7E                     MOV   a,m   ; A = index
20E7   4F                     MOV   c,a   
20E8   06 00                  MVI   b,0   
20EA   2A 30 21               LHLD   sidx_data_addr   
20ED   09                     DAD   b   ; HL = &data[index]
20EE   73                     MOV   m,e   ; 書き込み
20EF   C3 86 1B               JMP   vm_loop   
20F2                             ; 
20F2                SIDX_ARRAY:      
20F2                             ; R[a] のコレクションスロットを取得
20F2   3A 2F 21               LDA   sidx_reg_a   
20F5   CD 00 10               CALL   get_reg_addr   
20F8   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
20FB   23                     INX   h   ; +1: count
20FC   46                     MOV   b,m   ; B = 要素数
20FD   23                     INX   h   ; HL → データ領域先頭
20FE   22 30 21               SHLD   sidx_data_addr   
2101                             ; 
2101                             ; R[a+1] からインデックスを取得
2101   3A 2F 21               LDA   sidx_reg_a   
2104   3C                     INR   a   
2105   CD 00 10               CALL   get_reg_addr   
2108   CD 32 10               CALL   slot_to_value   
210B   7E                     MOV   a,m   ; A = index
210C   B8                     CMP   b   
210D   D2 03 00               JNC   vm_error   
2110                             ; 
2110                             ; data[index * 4] に R[a+2] をコピー
2110   87                     ADD   a   ; ×2
2111   87                     ADD   a   ; ×4
2112   5F                     MOV   e,a   
2113   16 00                  MVI   d,0   
2115   2A 30 21               LHLD   sidx_data_addr   
2118   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
2119   EB                     XCHG      ; DE = コピー先
211A                             ; 
211A                             ; R[a+2] を取得 (コピー元)
211A   3A 2F 21               LDA   sidx_reg_a   
211D   3C                     INR   a   
211E   3C                     INR   a   
211F   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
2122   0E 04                  MVI   c,SLOT_BYTES   
2124                SIDX_ARY_COPY:      
2124   7E                     MOV   a,m   
2125   12                     STAX   d   
2126   23                     INX   h   
2127   13                     INX   d   
2128   0D                     DCR   c   
2129   C2 24 21               JNZ   sidx_ary_copy   
212C   C3 86 1B               JMP   vm_loop   
212F                             ; 
212F   00           SIDX_REG_A:   DB   0   
2130   00 00        SIDX_DATA_ADDR:   DW   0   
2132                             ; 
2132                             ; ===============================================================
2132                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
2132                             ; 
2132                             ; b 個のレジスタからコレクションプールに配列を構築する。
2132                             ; ===============================================================
2132                DO_OP_ARRAY:      
2132   CD C0 10               CALL   fetch_byte   ; A = a
2135   32 A9 21               STA   oary_reg_a   
2138   32 AA 21               STA   oary_src_reg   ; BB 形式: ソース = a
213B   CD C0 10               CALL   fetch_byte   ; A = b (要素数)
213E                OA2_JOIN:      ; OP_ARRAY2 からの合流点
213E   32 AB 21               STA   oary_count   
2141   B7                     ORA   a   
2142   CA 9B 21               JZ   oary_empty   ; 空配列
2145                             ; 
2145                             ; 要素数チェック
2145   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2147   D2 03 00               JNC   vm_error   ; 要素数 > 7
214A                             ; 
214A                             ; コレクションスロットを確保
214A   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
214D   32 AC 21               STA   oary_slot_num   
2150   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
2152   23                     INX   h   
2153   3A AB 21               LDA   oary_count   
2156   77                     MOV   m,a   ; +1: count
2157   23                     INX   h   ; HL → データ領域先頭
2158   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
2159                             ; 
2159                             ; ソースレジスタから b 個のスロットをコピー
2159   3A AA 21               LDA   oary_src_reg   
215C   47                     MOV   b,a   ; B = 現在のレジスタ番号
215D   3A AB 21               LDA   oary_count   
2160   4F                     MOV   c,a   ; C = 残り要素数
2161                OARY_COPY_LOOP:      
2161   3E 04                  MVI   a,SLOT_BYTES   
2163   32 AD 21               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
2166   C5                     PUSH   b   
2167   D5                     PUSH   d   
2168   78                     MOV   a,b   
2169   CD 00 10               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
216C   D1                     POP   d   
216D                OARY_COPY_ELEM:      
216D   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
216E   23                     INX   h   
216F   78                     MOV   a,b   
2170   12                     STAX   d   
2171   13                     INX   d   
2172   E5                     PUSH   h   
2173   21 AD 21               LXI   h,oary_elem_cnt   
2176   35                     DCR   m   
2177   E1                     POP   h   
2178   C2 6D 21               JNZ   oary_copy_elem   
217B   C1                     POP   b   
217C   04                     INR   b   ; 次のレジスタ
217D   0D                     DCR   c   
217E   CA 84 21               JZ   oary_done   
2181   C3 61 21               JMP   oary_copy_loop   
2184                             ; 
2184                OARY_DONE:      
2184                             ; R[a] = TT_ARRAY, val_lo = slot+1
2184   3A A9 21               LDA   oary_reg_a   
2187   CD 00 10               CALL   get_reg_addr   
218A   36 08                  MVI   m,TT_ARRAY   
218C   23                     INX   h   
218D   36 00                  MVI   m,0   
218F   23                     INX   h   
2190   3A AC 21               LDA   oary_slot_num   
2193   3C                     INR   a   
2194   77                     MOV   m,a   
2195   23                     INX   h   
2196   36 00                  MVI   m,0   
2198   C3 86 1B               JMP   vm_loop   
219B                             ; 
219B                OARY_EMPTY:      
219B                             ; 空配列: スロット確保して count=0
219B   CD B8 1F               CALL   col_alloc   
219E   32 AC 21               STA   oary_slot_num   
21A1   36 02                  MVI   m,COL_TYPE_ARRAY   
21A3   23                     INX   h   
21A4   36 00                  MVI   m,0   ; count = 0
21A6   C3 84 21               JMP   oary_done   
21A9                             ; 
21A9   00           OARY_REG_A:   DB   0   
21AA   00           OARY_SRC_REG:   DB   0   
21AB   00           OARY_COUNT:   DB   0   
21AC   00           OARY_SLOT_NUM:   DB   0   
21AD   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
21AE                             ; 
21AE                             ; ===============================================================
21AE                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
21AE                             ; 
21AE                             ; R[a] の配列の末尾に要素を追加する。
21AE                             ; ===============================================================
21AE                DO_OP_ARYPUSH:      
21AE   CD C0 10               CALL   fetch_byte   ; A = a
21B1   32 22 22               STA   apush_reg_a   
21B4   CD C0 10               CALL   fetch_byte   ; A = b (追加する要素数)
21B7   32 23 22               STA   apush_add_count   
21BA                             ; 
21BA                             ; R[a] のコレクションスロットを取得
21BA   3A 22 22               LDA   apush_reg_a   
21BD   CD 00 10               CALL   get_reg_addr   
21C0   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
21C3   23                     INX   h   ; +1: count
21C4   7E                     MOV   a,m   ; A = 現在の要素数
21C5   32 24 22               STA   apush_cur_count   
21C8                             ; 容量チェック: count + add_count <= MAX
21C8   3A 23 22               LDA   apush_add_count   
21CB   47                     MOV   b,a   
21CC   3A 24 22               LDA   apush_cur_count   
21CF   80                     ADD   b   
21D0   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
21D2   D2 03 00               JNC   vm_error   ; オーバーフロー
21D5                             ; 
21D5                             ; 書き込み先: data + count * 4
21D5   3A 24 22               LDA   apush_cur_count   
21D8   87                     ADD   a   ; ×2
21D9   87                     ADD   a   ; ×4
21DA   5F                     MOV   e,a   
21DB   16 00                  MVI   d,0   
21DD   23                     INX   h   ; HL → データ領域先頭
21DE   19                     DAD   d   ; HL = 書き込み位置
21DF   EB                     XCHG      ; DE = 書き込み位置
21E0                             ; 
21E0                             ; R[a+1] から b 個のスロットをコピー
21E0   3A 22 22               LDA   apush_reg_a   
21E3   3C                     INR   a   
21E4   47                     MOV   b,a   ; B = 現在のレジスタ番号
21E5   3A 23 22               LDA   apush_add_count   
21E8   4F                     MOV   c,a   ; C = 残り要素数
21E9                APUSH_LOOP:      
21E9   3E 04                  MVI   a,SLOT_BYTES   
21EB   32 25 22               STA   apush_byte_cnt   ; 毎回初期化
21EE   C5                     PUSH   b   
21EF   D5                     PUSH   d   
21F0   78                     MOV   a,b   
21F1   CD 00 10               CALL   get_reg_addr   ; HL = R[reg]
21F4   D1                     POP   d   
21F5                APUSH_COPY:      
21F5   46                     MOV   b,m   
21F6   78                     MOV   a,b   
21F7   12                     STAX   d   
21F8   23                     INX   h   
21F9   13                     INX   d   
21FA   E5                     PUSH   h   
21FB   21 25 22               LXI   h,apush_byte_cnt   
21FE   35                     DCR   m   
21FF   E1                     POP   h   
2200   C2 F5 21               JNZ   apush_copy   
2203   C1                     POP   b   
2204   04                     INR   b   
2205   0D                     DCR   c   
2206   CA 0C 22               JZ   apush_done   
2209   C3 E9 21               JMP   apush_loop   
220C                             ; 
220C                APUSH_DONE:      
220C                             ; count を更新
220C   3A 22 22               LDA   apush_reg_a   
220F   CD 00 10               CALL   get_reg_addr   
2212   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
2215   23                     INX   h   ; +1: count
2216   3A 24 22               LDA   apush_cur_count   
2219   47                     MOV   b,a   
221A   3A 23 22               LDA   apush_add_count   
221D   80                     ADD   b   
221E   77                     MOV   m,a   ; count = old + added
221F   C3 86 1B               JMP   vm_loop   
2222                             ; 
2222   00           APUSH_REG_A:   DB   0   
2223   00           APUSH_ADD_COUNT:   DB   0   
2224   00           APUSH_CUR_COUNT:   DB   0   
2225   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
2226                             ; 
2226                             ; ===============================================================
2226                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
2226                             ; 
2226                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
2226                             ; ===============================================================
2226                DO_OP_STRCAT:      
2226   CD C0 10               CALL   fetch_byte   ; A = a
2229   32 9C 22               STA   scat_reg_a   
222C                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
222C                             ; 
222C                             ; R[a+1] のコレクションスロット (ソース)
222C   3C                     INR   a   
222D   CD 00 10               CALL   get_reg_addr   
2230   CD CD 1F               CALL   col_from_reg   ; HL = ソーススロット
2233   23                     INX   h   ; +1: count
2234   7E                     MOV   a,m   ; A = ソース文字列長
2235   32 9D 22               STA   scat_src_len   
2238   23                     INX   h   ; HL → データ先頭
2239   22 A0 22               SHLD   scat_src_data   
223C                             ; 
223C                             ; R[a] のコレクションスロット (デスト)
223C   3A 9C 22               LDA   scat_reg_a   
223F   CD 00 10               CALL   get_reg_addr   
2242   CD CD 1F               CALL   col_from_reg   ; HL = デストスロット
2245   23                     INX   h   ; +1: count
2246   7E                     MOV   a,m   ; A = デスト文字列長
2247   32 9E 22               STA   scat_dst_len   
224A                             ; 
224A                             ; 合計長チェック
224A   3A 9D 22               LDA   scat_src_len   
224D   47                     MOV   b,a   
224E   3A 9E 22               LDA   scat_dst_len   
2251   80                     ADD   b   
2252   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2254   DA 6C 22               JC   scat_len_ok   
2257                             ; 切り詰め: 追記できる分だけ
2257   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2259   47                     MOV   b,a   
225A   3A 9E 22               LDA   scat_dst_len   
225D   90                     SUB   b   ; この結果は負 (使わない)
225E   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2260   47                     MOV   b,a   
2261   3A 9E 22               LDA   scat_dst_len   
2264   4F                     MOV   c,a   
2265   78                     MOV   a,b   
2266   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
2267   32 9D 22               STA   scat_src_len   
226A                             ; 合計を MAX に
226A   3E 22                  MVI   a,COL_MAX_STRING_LEN   
226C                SCAT_LEN_OK:      
226C   32 9F 22               STA   scat_total_len   
226F                             ; 
226F                             ; デスト count を更新
226F   3A 9C 22               LDA   scat_reg_a   
2272   CD 00 10               CALL   get_reg_addr   
2275   CD CD 1F               CALL   col_from_reg   
2278   23                     INX   h   
2279   3A 9F 22               LDA   scat_total_len   
227C   77                     MOV   m,a   ; count = 合計長
227D   23                     INX   h   ; HL → データ先頭
227E                             ; 
227E                             ; デストデータ末尾 = data + dst_len
227E   3A 9E 22               LDA   scat_dst_len   
2281   5F                     MOV   e,a   
2282   16 00                  MVI   d,0   
2284   19                     DAD   d   ; HL = 書き込み位置
2285                             ; 
2285                             ; ソースデータをコピー
2285   EB                     XCHG      ; DE = 書き込み位置
2286   2A A0 22               LHLD   scat_src_data   ; HL = ソースデータ
2289   3A 9D 22               LDA   scat_src_len   
228C   B7                     ORA   a   
228D   CA 99 22               JZ   scat_done   
2290   4F                     MOV   c,a   
2291                SCAT_COPY:      
2291   7E                     MOV   a,m   
2292   12                     STAX   d   
2293   23                     INX   h   
2294   13                     INX   d   
2295   0D                     DCR   c   
2296   C2 91 22               JNZ   scat_copy   
2299                             ; 
2299                SCAT_DONE:      
2299   C3 86 1B               JMP   vm_loop   
229C                             ; 
229C   00           SCAT_REG_A:   DB   0   
229D   00           SCAT_SRC_LEN:   DB   0   
229E   00           SCAT_DST_LEN:   DB   0   
229F   00           SCAT_TOTAL_LEN:   DB   0   
22A0   00 00        SCAT_SRC_DATA:   DW   0   
22A2                             ; 
22A2                             ; ===============================================================
22A2                             ; send_length — length / size: 文字列長・配列長を返す
22A2                             ; 
22A2                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
22A2                             ; ===============================================================
22A2                SEND_LENGTH:      
22A2   3A 55 16               LDA   send_reg_a   
22A5   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
22A8   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
22AB   23                     INX   h   ; +1: count
22AC   4E                     MOV   c,m   ; C = count
22AD   06 00                  MVI   b,0   ; BC = count (16-bit)
22AF   3A 55 16               LDA   send_reg_a   
22B2   CD 00 10               CALL   get_reg_addr   
22B5   CD 10 10               CALL   set_slot_int16   ; R[a] = count
22B8   C3 86 1B               JMP   vm_loop   
22BB                             ; 
22BB                             ; ===============================================================
22BB                             ; send_concat — << (文字列追記 / 配列追加)
22BB                             ; 
22BB                             ; R[a] の型で分岐:
22BB                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
22BB                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
22BB                             ; ===============================================================
22BB                SEND_CONCAT:      
22BB   3A 55 16               LDA   send_reg_a   
22BE   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
22C1   7E                     MOV   a,m   ; A = 型タグ
22C2   FE 07                  CPI   TT_STRING   
22C4   CA CF 22               JZ   concat_string   
22C7   FE 08                  CPI   TT_ARRAY   
22C9   CA 79 23               JZ   concat_array   
22CC   C3 03 00               JMP   vm_error   
22CF                             ; 
22CF                CONCAT_STRING:      
22CF                             ; R[a+1] の型を確認
22CF   3A 55 16               LDA   send_reg_a   
22D2   3C                     INR   a   
22D3   CD 00 10               CALL   get_reg_addr   
22D6   7E                     MOV   a,m   ; A = R[a+1] の型タグ
22D7   FE 07                  CPI   TT_STRING   
22D9   CA E4 22               JZ   concat_str_str   
22DC   FE 04                  CPI   TT_INTEGER   
22DE   CA 54 23               JZ   concat_str_int   
22E1   C3 03 00               JMP   vm_error   
22E4                             ; 
22E4                CONCAT_STR_STR:      
22E4                             ; R[a+1] のコレクションスロット (ソース)
22E4   3A 55 16               LDA   send_reg_a   
22E7   3C                     INR   a   
22E8   CD 00 10               CALL   get_reg_addr   
22EB   CD CD 1F               CALL   col_from_reg   ; HL = ソーススロット
22EE   23                     INX   h   ; +1: count
22EF   7E                     MOV   a,m   ; A = ソース文字列長
22F0   32 20 80               STA   cc_src_len   
22F3   23                     INX   h   ; HL → データ先頭
22F4   22 23 80               SHLD   cc_src_data   
22F7                             ; 
22F7                             ; R[a] のコレクションスロット (デスト)
22F7   3A 55 16               LDA   send_reg_a   
22FA   CD 00 10               CALL   get_reg_addr   
22FD   CD CD 1F               CALL   col_from_reg   ; HL = デストスロット
2300   23                     INX   h   ; +1: count
2301   7E                     MOV   a,m   
2302   32 21 80               STA   cc_dst_len   
2305                             ; 
2305                             ; コピー可能バイト数を計算
2305   3A 20 80               LDA   cc_src_len   
2308   47                     MOV   b,a   
2309   3A 21 80               LDA   cc_dst_len   
230C   80                     ADD   b   
230D   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
230F   DA 24 23               JC   cc_str_len_ok   
2312                             ; 切り詰め
2312   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2314   47                     MOV   b,a   
2315   3A 21 80               LDA   cc_dst_len   
2318   4F                     MOV   c,a   
2319   78                     MOV   a,b   
231A   91                     SUB   c   
231B   32 20 80               STA   cc_src_len   
231E   3A 21 80               LDA   cc_dst_len   
2321   87                     ADD   a   ; ここでは使わない — 合計は MAX
2322   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2324                CC_STR_LEN_OK:      
2324   32 22 80               STA   cc_total_len   
2327                             ; 
2327                             ; count を更新
2327   3A 55 16               LDA   send_reg_a   
232A   CD 00 10               CALL   get_reg_addr   
232D   CD CD 1F               CALL   col_from_reg   
2330   23                     INX   h   
2331   3A 22 80               LDA   cc_total_len   
2334   77                     MOV   m,a   
2335   23                     INX   h   ; HL → データ先頭
2336                             ; 
2336                             ; 書き込み位置 = data + dst_len
2336   3A 21 80               LDA   cc_dst_len   
2339   5F                     MOV   e,a   
233A   16 00                  MVI   d,0   
233C   19                     DAD   d   
233D                             ; 
233D                             ; コピー
233D   EB                     XCHG      
233E   2A 23 80               LHLD   cc_src_data   
2341   3A 20 80               LDA   cc_src_len   
2344   B7                     ORA   a   
2345   CA 51 23               JZ   cc_str_done   
2348   4F                     MOV   c,a   
2349                CC_STR_COPY:      
2349   7E                     MOV   a,m   
234A   12                     STAX   d   
234B   23                     INX   h   
234C   13                     INX   d   
234D   0D                     DCR   c   
234E   C2 49 23               JNZ   cc_str_copy   
2351                CC_STR_DONE:      
2351                             ; R[a] をそのまま返す (破壊的操作)
2351   C3 86 1B               JMP   vm_loop   
2354                             ; 
2354                CONCAT_STR_INT:      
2354                             ; R[a+1] の val_lo を 1 バイトとして追記
2354   3A 55 16               LDA   send_reg_a   
2357   3C                     INR   a   
2358   CD 00 10               CALL   get_reg_addr   
235B   CD 32 10               CALL   slot_to_value   
235E   4E                     MOV   c,m   ; C = 文字コード (val_lo)
235F                             ; 
235F                             ; R[a] のコレクションスロット
235F   3A 55 16               LDA   send_reg_a   
2362   CD 00 10               CALL   get_reg_addr   
2365   CD CD 1F               CALL   col_from_reg   ; HL = デストスロット
2368   23                     INX   h   ; +1: count
2369   7E                     MOV   a,m   
236A   FE 22                  CPI   COL_MAX_STRING_LEN   
236C   D2 86 1B               JNC   vm_loop   ; 満杯なら何もしない
236F   34                     INR   m   ; count++
2370   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
2371   23                     INX   h   ; HL → データ先頭
2372   16 00                  MVI   d,0   
2374   19                     DAD   d   ; HL = &data[old_count]
2375   71                     MOV   m,c   ; 書き込み
2376   C3 86 1B               JMP   vm_loop   
2379                             ; 
2379                CONCAT_ARRAY:      
2379                             ; R[a] のコレクションスロット
2379   3A 55 16               LDA   send_reg_a   
237C   CD 00 10               CALL   get_reg_addr   
237F   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
2382   23                     INX   h   ; +1: count
2383   7E                     MOV   a,m   
2384   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
2386   D2 03 00               JNC   vm_error   ; 満杯
2389   32 25 80               STA   cc_ary_count   
238C   34                     INR   m   ; count++
238D                             ; 
238D                             ; 書き込み位置: data + count * 4
238D   23                     INX   h   ; HL → データ先頭
238E   3A 25 80               LDA   cc_ary_count   
2391   87                     ADD   a   ; ×2
2392   87                     ADD   a   ; ×4
2393   5F                     MOV   e,a   
2394   16 00                  MVI   d,0   
2396   19                     DAD   d   ; HL = 書き込み位置
2397   EB                     XCHG      ; DE = 書き込み位置
2398                             ; 
2398                             ; R[a+1] をコピー
2398   3A 55 16               LDA   send_reg_a   
239B   3C                     INR   a   
239C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
239F   0E 04                  MVI   c,SLOT_BYTES   
23A1                CC_ARY_COPY:      
23A1   7E                     MOV   a,m   
23A2   12                     STAX   d   
23A3   23                     INX   h   
23A4   13                     INX   d   
23A5   0D                     DCR   c   
23A6   C2 A1 23               JNZ   cc_ary_copy   
23A9   C3 86 1B               JMP   vm_loop   
23AC                             ; 
23AC                             ; --- concat 一時変数 ---
23AC                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
23AC                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
23AC                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
23AC                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
23AC                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
23AC                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
23AC                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
23AC                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
23AC                             ; 
23AC                             ; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
23AC                             ; 
23AC                             ; Hash スロット形式 (コレクションプール 36B スロット内):
23AC                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
23AC                             ;   +1: count (1B)  ペア数 (最大 4)
23AC                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
23AC                             ; 
23AC                             ; キー検索は線形 4 バイト比較。
23AC                             ; 
23AC                             ; ===============================================================
23AC                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
23AC                             ; 
23AC                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
23AC                             ; ===============================================================
23AC                DO_OP_ARRAY2:      
23AC   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
23AF   32 A9 21               STA   oary_reg_a   
23B2   CD C0 10               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
23B5   32 AA 21               STA   oary_src_reg   
23B8   CD C0 10               CALL   fetch_byte   ; A = c (要素数)
23BB   C3 3E 21               JMP   oa2_join   
23BE                             ; 
23BE                             ; ===============================================================
23BE                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
23BE                             ; 
23BE                             ;   a = 書き込み先レジスタ
23BE                             ;   b = ペア数 (0 = 空 Hash)
23BE                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
23BE                             ; ===============================================================
23BE                DO_OP_HASH:      
23BE   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
23C1   32 26 24               STA   hash_reg_a   
23C4   CD C0 10               CALL   fetch_byte   ; A = b (ペア数)
23C7   32 27 24               STA   hash_count   
23CA                             ; 
23CA                             ; コレクションスロット確保
23CA   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
23CD   32 28 24               STA   hash_slot_num   
23D0                             ; 
23D0                             ; ヘッダ書き込み
23D0   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
23D2   23                     INX   h   
23D3   3A 27 24               LDA   hash_count   
23D6   77                     MOV   m,a   ; +1: count
23D7   23                     INX   h   ; HL → データ領域先頭
23D8                             ; 
23D8                             ; ペアがなければ結果書き込みへ
23D8   3A 27 24               LDA   hash_count   
23DB   B7                     ORA   a   
23DC   CA 0F 24               JZ   hash_write_result   
23DF                             ; 
23DF                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
23DF   3A 26 24               LDA   hash_reg_a   
23E2   32 29 24               STA   hash_src_reg   
23E5                             ; 
23E5                HASH_COPY_PAIR:      
23E5                             ; HL = コレクションプール内の書き込み位置
23E5                             ; key (4B) をコピー: R[src] → [HL]
23E5   E5                     PUSH   h   ; 書き込み先を退避
23E6   3A 29 24               LDA   hash_src_reg   
23E9   CD 00 10               CALL   get_reg_addr   ; HL = R[src]
23EC   D1                     POP   d   ; DE = 書き込み先
23ED   CD 25 10               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
23F0                             ; DE = value 書き込み位置
23F0                             ; 
23F0                             ; value (4B) をコピー: R[src+1] → [DE]
23F0   D5                     PUSH   d   ; value 書き込み先を退避
23F1   3A 29 24               LDA   hash_src_reg   
23F4   3C                     INR   a   
23F5   CD 00 10               CALL   get_reg_addr   ; HL = R[src+1]
23F8   D1                     POP   d   ; DE = value 書き込み先
23F9   CD 25 10               CALL   copy_slot   ; 4B コピー
23FC                             ; DE = 次ペアの先頭
23FC                             ; 
23FC                             ; ソースレジスタを +2
23FC   3A 29 24               LDA   hash_src_reg   
23FF   C6 02                  ADI   2   
2401   32 29 24               STA   hash_src_reg   
2404                             ; 
2404                             ; HL = 次の書き込み位置 (DE から)
2404   EB                     XCHG      
2405                             ; 
2405                             ; ペアカウンタ
2405   3A 27 24               LDA   hash_count   
2408   3D                     DCR   a   
2409   32 27 24               STA   hash_count   
240C   C2 E5 23               JNZ   hash_copy_pair   
240F                             ; 
240F                HASH_WRITE_RESULT:      
240F                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
240F   3A 26 24               LDA   hash_reg_a   
2412   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2415   36 09                  MVI   m,TT_HASH   ; +0: type
2417   23                     INX   h   
2418   36 00                  MVI   m,0   ; +1: reserved
241A   23                     INX   h   
241B   3A 28 24               LDA   hash_slot_num   
241E   3C                     INR   a   ; slot + 1
241F   77                     MOV   m,a   ; +2: val_lo
2420   23                     INX   h   
2421   36 00                  MVI   m,0   ; +3: val_hi
2423   C3 86 1B               JMP   vm_loop   
2426                             ; 
2426                             ; --- do_op_hash データ ---
2426   00           HASH_REG_A:   DB   0   
2427   00           HASH_COUNT:   DB   0   
2428   00           HASH_SLOT_NUM:   DB   0   
2429   00           HASH_SRC_REG:   DB   0   
242A                             ; 
242A                             ; ===============================================================
242A                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
242A                             ; 
242A                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
242A                             ;   キーが見つからなければ R[a] = nil
242A                             ; ===============================================================
242A                GIDX_HASH:      
242A                             ; コレクションスロットを取得
242A   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
242D   23                     INX   h   ; +1: count
242E   7E                     MOV   a,m   ; A = ペア数
242F   23                     INX   h   ; HL → データ領域
2430   B7                     ORA   a   
2431   CA 7D 24               JZ   ghash_not_found   ; 空 Hash
2434                             ; 
2434   32 91 24               STA   ghash_loop_cnt   
2437   22 8B 24               SHLD   ghash_data_ptr   
243A                             ; 
243A                             ; 検索キー R[a+1] のアドレスを取得
243A   3A 78 20               LDA   gidx_reg_a   
243D   3C                     INR   a   
243E   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2441   22 8D 24               SHLD   ghash_key_ptr   
2444                             ; 
2444                             ; 検索ループ
2444   2A 8B 24               LHLD   ghash_data_ptr   
2447                GHASH_SEARCH:      
2447   22 8F 24               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
244A                             ; 
244A                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
244A   E5                     PUSH   h   
244B   2A 8D 24               LHLD   ghash_key_ptr   
244E   EB                     XCHG      ; DE = 検索キー
244F   E1                     POP   h   ; HL = hash ペアのキー
2450                             ; 
2450   0E 04                  MVI   c,SLOT_BYTES   
2452                GHASH_CMP:      
2452   1A                     LDAX   d   
2453   BE                     CMP   m   
2454   C2 6C 24               JNZ   ghash_next   
2457   23                     INX   h   
2458   13                     INX   d   
2459   0D                     DCR   c   
245A   C2 52 24               JNZ   ghash_cmp   
245D                             ; 
245D                             ; 一致! HL = value 位置 (キー直後)
245D                             ; value (4B) を R[a] にコピー
245D   E5                     PUSH   h   ; value ソース
245E   3A 78 20               LDA   gidx_reg_a   
2461   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2464   EB                     XCHG      ; DE = R[a] (コピー先)
2465   E1                     POP   h   ; HL = value (コピー元)
2466   CD 25 10               CALL   copy_slot   
2469   C3 86 1B               JMP   vm_loop   
246C                             ; 
246C                GHASH_NEXT:      
246C                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
246C   2A 8F 24               LHLD   ghash_cur_ptr   
246F   11 08 00               LXI   d,HASH_PAIR_BYTES   
2472   19                     DAD   d   
2473   3A 91 24               LDA   ghash_loop_cnt   
2476   3D                     DCR   a   
2477   32 91 24               STA   ghash_loop_cnt   
247A   C2 47 24               JNZ   ghash_search   
247D                             ; 
247D                GHASH_NOT_FOUND:      
247D                             ; R[a] = nil
247D   3A 78 20               LDA   gidx_reg_a   
2480   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2483   3E 01                  MVI   a,TT_NIL   
2485   CD 1A 10               CALL   set_slot_special   
2488   C3 86 1B               JMP   vm_loop   
248B                             ; 
248B                             ; --- gidx_hash データ ---
248B   00 00        GHASH_DATA_PTR:   DW   0   
248D   00 00        GHASH_KEY_PTR:   DW   0   
248F   00 00        GHASH_CUR_PTR:   DW   0   
2491   00           GHASH_LOOP_CNT:   DB   0   
2492                             ; 
2492                             ; ===============================================================
2492                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
2492                             ; 
2492                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
2492                             ;   既存キー → 値を上書き
2492                             ;   新規キー → count < MAX なら末尾に追加
2492                             ; ===============================================================
2492                SIDX_HASH:      
2492                             ; コレクションスロットを取得
2492   CD CD 1F               CALL   col_from_reg   ; HL = コレクションスロット
2495   22 21 25               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
2498   23                     INX   h   ; +1: count
2499   7E                     MOV   a,m   
249A   32 2B 25               STA   shash_pair_cnt   ; 元のペア数
249D   23                     INX   h   ; HL → データ領域
249E   22 23 25               SHLD   shash_data_ptr   
24A1                             ; 
24A1                             ; R[a+1] キーのアドレス
24A1   3A 2F 21               LDA   sidx_reg_a   
24A4   3C                     INR   a   
24A5   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
24A8   22 25 25               SHLD   shash_key_ptr   
24AB                             ; 
24AB                             ; R[a+2] 値のアドレス
24AB   3A 2F 21               LDA   sidx_reg_a   
24AE   C6 02                  ADI   2   
24B0   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
24B3   22 27 25               SHLD   shash_val_ptr   
24B6                             ; 
24B6                             ; 既存キーを検索
24B6   3A 2B 25               LDA   shash_pair_cnt   
24B9   B7                     ORA   a   
24BA   CA F4 24               JZ   shash_append   ; 空 Hash → 追加
24BD                             ; 
24BD   32 2C 25               STA   shash_loop_cnt   
24C0   2A 23 25               LHLD   shash_data_ptr   
24C3                             ; 
24C3                SHASH_SEARCH:      
24C3   22 29 25               SHLD   shash_cur_ptr   
24C6                             ; 
24C6   E5                     PUSH   h   
24C7   2A 25 25               LHLD   shash_key_ptr   
24CA   EB                     XCHG      ; DE = 検索キー
24CB   E1                     POP   h   ; HL = hash ペアのキー
24CC                             ; 
24CC   0E 04                  MVI   c,SLOT_BYTES   
24CE                SHASH_CMP:      
24CE   1A                     LDAX   d   
24CF   BE                     CMP   m   
24D0   C2 E3 24               JNZ   shash_snext   
24D3   23                     INX   h   
24D4   13                     INX   d   
24D5   0D                     DCR   c   
24D6   C2 CE 24               JNZ   shash_cmp   
24D9                             ; 
24D9                             ; 一致! HL = value 位置
24D9                             ; R[a+2] を value にコピー
24D9   EB                     XCHG      ; DE = hash value 位置
24DA   2A 27 25               LHLD   shash_val_ptr   ; HL = R[a+2]
24DD   CD 25 10               CALL   copy_slot   
24E0   C3 86 1B               JMP   vm_loop   
24E3                             ; 
24E3                SHASH_SNEXT:      
24E3   2A 29 25               LHLD   shash_cur_ptr   
24E6   11 08 00               LXI   d,HASH_PAIR_BYTES   
24E9   19                     DAD   d   
24EA   3A 2C 25               LDA   shash_loop_cnt   
24ED   3D                     DCR   a   
24EE   32 2C 25               STA   shash_loop_cnt   
24F1   C2 C3 24               JNZ   shash_search   
24F4                             ; 
24F4                             ; 見つからなかった → 末尾に追加
24F4                             ; 
24F4                SHASH_APPEND:      
24F4                             ; 容量チェック
24F4   3A 2B 25               LDA   shash_pair_cnt   
24F7   FE 04                  CPI   COL_MAX_HASH_PAIRS   
24F9   D2 03 00               JNC   vm_error   ; Hash 満杯
24FC                             ; 
24FC                             ; count++ を書き込み
24FC   3C                     INR   a   
24FD   F5                     PUSH   psw   
24FE   2A 21 25               LHLD   shash_col_ptr   
2501   23                     INX   h   ; +1: count フィールド
2502   77                     MOV   m,a   
2503   F1                     POP   psw   
2504                             ; 
2504                             ; 追加位置 = data + old_count * 8
2504   3A 2B 25               LDA   shash_pair_cnt   ; old count
2507   87                     ADD   a   ; ×2
2508   87                     ADD   a   ; ×4
2509   87                     ADD   a   ; ×8
250A   5F                     MOV   e,a   
250B   16 00                  MVI   d,0   
250D   2A 23 25               LHLD   shash_data_ptr   
2510   19                     DAD   d   ; HL = 追加位置
2511                             ; 
2511                             ; key をコピー (R[a+1] → [HL])
2511   EB                     XCHG      ; DE = 追加位置
2512   2A 25 25               LHLD   shash_key_ptr   ; HL = R[a+1]
2515   CD 25 10               CALL   copy_slot   ; key 4B、DE は value 位置に進む
2518                             ; 
2518                             ; value をコピー (R[a+2] → [DE])
2518   2A 27 25               LHLD   shash_val_ptr   ; HL = R[a+2]
251B                             ; DE は既に value 位置
251B   CD 25 10               CALL   copy_slot   
251E   C3 86 1B               JMP   vm_loop   
2521                             ; 
2521                             ; --- sidx_hash データ ---
2521   00 00        SHASH_COL_PTR:   DW   0   
2523   00 00        SHASH_DATA_PTR:   DW   0   
2525   00 00        SHASH_KEY_PTR:   DW   0   
2527   00 00        SHASH_VAL_PTR:   DW   0   
2529   00 00        SHASH_CUR_PTR:   DW   0   
252B   00           SHASH_PAIR_CNT:   DB   0   
252C   00           SHASH_LOOP_CNT:   DB   0   
252D                             ; 
252D                             ; ===============================================================
252D                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
252D                             ; 
252D                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
252D                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
252D                             ; ROM がなければ即 nil。
252D                             ; 
252D                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
252D                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
252D                             ; ===============================================================
252D                SEND_GETKEY_TIMEOUT:      
252D                             ; R[a+1] からタイムアウト回数を読む
252D   3A 55 16               LDA   send_reg_a   
2530   C6 01                  ADI   1   
2532   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2535   23                     INX   h   
2536   23                     INX   h   ; +2: val_lo
2537   4E                     MOV   c,m   
2538   23                     INX   h   ; +3: val_hi
2539   46                     MOV   b,m   ; BC = タイムアウト回数
253A                             ; 
253A                             ; ROM チェック
253A   3A 47 06               LDA   KEY_ADDR   
253D   B7                     ORA   a   
253E   CA 68 25               JZ   getkey_timeout_nil   ; ROM なし → nil
2541                             ; 
2541                GETKEY_POLL_LOOP:      
2541   78                     MOV   a,b   
2542   B1                     ORA   c   
2543   CA 68 25               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
2546                             ; 
2546   C5                     PUSH   b   ; カウンタ退避
2547   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
254A   C1                     POP   b   ; カウンタ復帰
254B   FE FF                  CPI   0FFh   
254D   C2 59 25               JNZ   getkey_timeout_got   ; キー押下!
2550                             ; 
2550   C5                     PUSH   b   ; カウンタ退避
2551   CD 49 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
2554   C1                     POP   b   
2555   0B                     DCX   b   ; カウンタ--
2556   C3 41 25               JMP   getkey_poll_loop   
2559                             ; 
2559                GETKEY_TIMEOUT_GOT:      
2559                             ; A = キーコード (0x00-0x17)
2559   4F                     MOV   c,a   
255A   06 00                  MVI   b,0   
255C   3A 55 16               LDA   send_reg_a   
255F   CD 00 10               CALL   get_reg_addr   
2562   CD 10 10               CALL   set_slot_int16   
2565   C3 86 1B               JMP   vm_loop   
2568                             ; 
2568                GETKEY_TIMEOUT_NIL:      
2568   3A 55 16               LDA   send_reg_a   
256B   CD 00 10               CALL   get_reg_addr   
256E   3E 01                  MVI   a,TT_NIL   
2570   CD 1A 10               CALL   set_slot_special   
2573   C3 86 1B               JMP   vm_loop   
2576                             ; 
2576                             ; ===============================================================
2576                             ; send_slice — [](offset, length): 文字列スライス
2576                             ; 
2576                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
2576                             ; 
2576                             ;   入力: send_reg_a = a, send_argc = 2
2576                             ;         R[a] = TT_STRING (対象文字列)
2576                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
2576                             ;         R[a+2] = length (TT_INTEGER)
2576                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
2576                             ;         offset >= 文字列長 → 空文字列
2576                             ;         length は利用可能バイト数にクランプ
2576                             ; ===============================================================
2576                SEND_SLICE:      
2576                             ; R[a] が TT_STRING か確認
2576   3A 55 16               LDA   send_reg_a   
2579   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
257C   7E                     MOV   a,m   ; A = 型タグ
257D   FE 07                  CPI   TT_STRING   
257F   C2 03 00               JNZ   vm_error   
2582                             ; 
2582                             ; ソース文字列のコレクションスロットを取得
2582   3A 55 16               LDA   send_reg_a   
2585   CD 00 10               CALL   get_reg_addr   
2588   CD CD 1F               CALL   col_from_reg   ; HL = collection slot
258B   23                     INX   h   ; +1: count
258C   7E                     MOV   a,m   
258D   32 1D 26               STA   slice_src_count   
2590   23                     INX   h   ; HL → data
2591   22 1E 26               SHLD   slice_src_data   
2594                             ; 
2594                             ; R[a+1] から offset を取得
2594   3A 55 16               LDA   send_reg_a   
2597   C6 01                  ADI   1   
2599   CD 00 10               CALL   get_reg_addr   
259C   CD 32 10               CALL   slot_to_value   
259F   7E                     MOV   a,m   ; A = offset (val_lo)
25A0   32 20 26               STA   slice_offset   
25A3                             ; 
25A3                             ; R[a+2] から length を取得
25A3   3A 55 16               LDA   send_reg_a   
25A6   C6 02                  ADI   2   
25A8   CD 00 10               CALL   get_reg_addr   
25AB   CD 32 10               CALL   slot_to_value   
25AE   7E                     MOV   a,m   ; A = length (val_lo)
25AF   32 21 26               STA   slice_length   
25B2                             ; 
25B2                             ; offset >= src_count → 空文字列
25B2   3A 20 26               LDA   slice_offset   
25B5   47                     MOV   b,a   ; B = offset
25B6   3A 1D 26               LDA   slice_src_count   ; A = src_count
25B9   B8                     CMP   b   
25BA   DA 0F 26               JC   slice_empty   ; src_count < offset
25BD   CA 0F 26               JZ   slice_empty   ; src_count == offset
25C0                             ; 
25C0                             ; available = src_count - offset
25C0   90                     SUB   b   ; A = available
25C1   47                     MOV   b,a   ; B = available
25C2   3A 21 26               LDA   slice_length   
25C5   B8                     CMP   b   
25C6   DA CA 25               JC   slice_len_ok   ; length < available → そのまま
25C9   78                     MOV   a,b   ; clamp: length = available
25CA                SLICE_LEN_OK:      
25CA   32 21 26               STA   slice_length   ; 実際のコピー長
25CD                             ; 
25CD                             ; 新しいコレクションスロットを確保
25CD   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
25D0   32 22 26               STA   slice_new_slot   
25D3   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
25D5   23                     INX   h   
25D6   3A 21 26               LDA   slice_length   
25D9   77                     MOV   m,a   ; +1: count = コピー長
25DA   23                     INX   h   ; HL → new data area
25DB                             ; 
25DB                             ; ソースデータ先頭 + offset
25DB   E5                     PUSH   h   ; dest を退避
25DC   2A 1E 26               LHLD   slice_src_data   
25DF   3A 20 26               LDA   slice_offset   
25E2   5F                     MOV   e,a   
25E3   16 00                  MVI   d,0   
25E5   19                     DAD   d   ; HL = src_data + offset
25E6   EB                     XCHG      ; DE = src + offset
25E7   E1                     POP   h   ; HL = dest
25E8                             ; 
25E8                             ; バイトコピー
25E8   3A 21 26               LDA   slice_length   
25EB   B7                     ORA   a   
25EC   CA F8 25               JZ   slice_done   
25EF   4F                     MOV   c,a   
25F0                SLICE_COPY:      
25F0   1A                     LDAX   d   
25F1   77                     MOV   m,a   
25F2   23                     INX   h   
25F3   13                     INX   d   
25F4   0D                     DCR   c   
25F5   C2 F0 25               JNZ   slice_copy   
25F8                             ; 
25F8                SLICE_DONE:      
25F8                             ; R[a] = TT_STRING, val_lo = new_slot + 1
25F8   3A 55 16               LDA   send_reg_a   
25FB   CD 00 10               CALL   get_reg_addr   
25FE   36 07                  MVI   m,TT_STRING   ; +0: type
2600   23                     INX   h   
2601   36 00                  MVI   m,0   ; +1: reserved
2603   23                     INX   h   
2604   3A 22 26               LDA   slice_new_slot   
2607   3C                     INR   a   ; slot + 1
2608   77                     MOV   m,a   ; +2: val_lo
2609   23                     INX   h   
260A   36 00                  MVI   m,0   ; +3: val_hi
260C   C3 86 1B               JMP   vm_loop   
260F                             ; 
260F                SLICE_EMPTY:      
260F                             ; 空文字列を返す
260F   CD B8 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2612   32 22 26               STA   slice_new_slot   
2615   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2617   23                     INX   h   
2618   36 00                  MVI   m,0   ; +1: count = 0
261A   C3 F8 25               JMP   slice_done   
261D                             ; 
261D                             ; --- send_slice データ ---
261D   00           SLICE_SRC_COUNT:   DB   0   
261E   00 00        SLICE_SRC_DATA:   DW   0   
2620   00           SLICE_OFFSET:   DB   0   
2621   00           SLICE_LENGTH:   DB   0   
2622   00           SLICE_NEW_SLOT:   DB   0   
2623                             ; 
2623                             ; ===============================================================
2623                             ; col_gc_alloc — 到達性を辿る回収つきのスロット確保
2623                             ; 
2623                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
2623                             ; 
2623                             ; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
2623                             ; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
2623                             ; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
2623                             ; 
2623                             ; ルート:
2623                             ;   レジスタファイル    MAX_REGS 個の値スロット
2623                             ;   グローバル変数      MAX_GLOBALS 個の値スロット
2623                             ;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
2623                             ; 
2623                             ; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
2623                             ; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
2623                             ; 起動時にゼロクリアされていて型 0 なので素通りする。
2623                             ; 
2623                             ; 伝播:
2623                             ;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
2623                             ;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
2623                             ; 
2623                             ;   出力: A = スロット番号, HL = スロットアドレス
2623                             ;   エラー: 全スロット生きている → vm_error
2623                             ; ===============================================================
2623                COL_GC_ALLOC:      
2623                             ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
2623   AF                     XRA   a   
2624   21 8C 27               LXI   h,gc_bitmap   
2627   0E 10                  MVI   c,16   
2629                GC_CLEAR_BM:      
2629   77                     MOV   m,a   
262A   23                     INX   h   
262B   0D                     DCR   c   
262C   C2 29 26               JNZ   gc_clear_bm   
262F                             ; 
262F                             ; --- ルート: レジスタファイル ---
262F                             ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
262F   21 00 81               LXI   h,REG_FILE_BASE   
2632   06 40                  MVI   b,MAX_REGS   
2634                GC_ROOT_REG:      
2634   CD 11 27               CALL   gc_mark_value   
2637   23                     INX   h   
2638   23                     INX   h   
2639   23                     INX   h   
263A   23                     INX   h   
263B   05                     DCR   b   
263C   C2 34 26               JNZ   gc_root_reg   
263F                             ; 
263F                             ; --- ルート: グローバル変数 ---
263F   21 00 90               LXI   h,GLOBALS_BASE   
2642   06 40                  MVI   b,MAX_GLOBALS   
2644                GC_ROOT_GLOBAL:      
2644   CD 11 27               CALL   gc_mark_value   
2647   23                     INX   h   
2648   23                     INX   h   
2649   23                     INX   h   
264A   23                     INX   h   
264B   05                     DCR   b   
264C   C2 44 26               JNZ   gc_root_global   
264F                             ; 
264F                             ; --- ルート: オブジェクトのインスタンス変数 ---
264F   21 C4 92               LXI   h,OBJECT_POOL_BASE + OBJECT_HEADER_SIZE   
2652   06 20                  MVI   b,MAX_OBJECTS   
2654                GC_ROOT_OBJ:      
2654   C5                     PUSH   b   
2655   E5                     PUSH   h   
2656   06 07                  MVI   b,MAX_IVARS   
2658                GC_ROOT_IVAR:      
2658   CD 11 27               CALL   gc_mark_value   
265B   23                     INX   h   
265C   23                     INX   h   
265D   23                     INX   h   
265E   23                     INX   h   
265F   05                     DCR   b   
2660   C2 58 26               JNZ   gc_root_ivar   
2663   E1                     POP   h   
2664   11 20 00               LXI   d,OBJECT_SLOT_SIZE   
2667   19                     DAD   d   ; 次のオブジェクトの ivar 先頭
2668   C1                     POP   b   
2669   05                     DCR   b   
266A   C2 54 26               JNZ   gc_root_obj   
266D                             ; 
266D                             ; --- 到達性を伝播する ---
266D   CD 8A 26               CALL   gc_propagate   
2670                             ; 
2670                             ; --- 印の付かなかったスロットを探す ---
2670                             ; B をカウンタに使う (gc_check_bit は B を壊さない)
2670   06 00                  MVI   b,0   
2672                GC_FIND_FREE:      
2672   78                     MOV   a,b   ; A = 検査対象スロット番号
2673   CD 67 27               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
2676   CA 83 26               JZ   gc_found_free   
2679   04                     INR   b   
267A   78                     MOV   a,b   
267B   FE 40                  CPI   MAX_COL_SLOTS   
267D   DA 72 26               JC   gc_find_free   
2680   C3 03 00               JMP   vm_error   ; 全スロット使用中
2683                             ; 
2683                GC_FOUND_FREE:      
2683   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
2684   F5                     PUSH   psw   ; スロット番号を退避
2685   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス
2688   F1                     POP   psw   ; A = スロット番号を復帰
2689   C9                     RET      
268A                             ; 
268A                             ; ---------------------------------------------------------------
268A                             ; gc_propagate — 印が増えなくなるまで中身を辿る
268A                             ; 
268A                             ; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
268A                             ; 1 周で 1 つも走査しなければ終わり。
268A                             ; ---------------------------------------------------------------
268A                GC_PROPAGATE:      
268A   AF                     XRA   a   
268B   32 9C 27               STA   gc_changed   
268E   06 00                  MVI   b,0   ; B = スロット番号
2690                GC_PROP_SLOT:      
2690   78                     MOV   a,b   
2691   CD 67 27               CALL   gc_check_bit   ; 印が無ければ飛ばす
2694   CA AD 26               JZ   gc_prop_next   
2697   78                     MOV   a,b   
2698   CD 80 27               CALL   gc_check_scanned   ; 走査済みなら飛ばす
269B   C2 AD 26               JNZ   gc_prop_next   
269E   78                     MOV   a,b   
269F   CD 73 27               CALL   gc_set_scanned   
26A2   3E 01                  MVI   a,1   
26A4   32 9C 27               STA   gc_changed   
26A7   78                     MOV   a,b   
26A8   C5                     PUSH   b   
26A9   CD BC 26               CALL   gc_scan_slot   
26AC   C1                     POP   b   
26AD                GC_PROP_NEXT:      
26AD   04                     INR   b   
26AE   78                     MOV   a,b   
26AF   FE 40                  CPI   MAX_COL_SLOTS   
26B1   DA 90 26               JC   gc_prop_slot   
26B4   3A 9C 27               LDA   gc_changed   
26B7   B7                     ORA   a   
26B8   C2 8A 26               JNZ   gc_propagate   ; 印が増えたのでもう 1 周
26BB   C9                     RET      
26BC                             ; 
26BC                             ; ---------------------------------------------------------------
26BC                             ; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
26BC                             ; 
26BC                             ; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
26BC                             ; 読むと、前に入っていた文字列のバイトが型タグに見える。
26BC                             ; 
26BC                             ; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
26BC                             ; でも隣のスロットまで歩かないようにする。
26BC                             ; ---------------------------------------------------------------
26BC                GC_SCAN_SLOT:      
26BC   C5                     PUSH   b   
26BD   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス (A は残る)
26C0   7E                     MOV   a,m   ; +0: 型
26C1   23                     INX   h   
26C2   46                     MOV   b,m   ; +1: 要素数 / 組の数
26C3   23                     INX   h   ; HL = データ先頭
26C4   FE 02                  CPI   COL_TYPE_ARRAY   
26C6   CA D1 26               JZ   gc_scan_array   
26C9   FE 03                  CPI   COL_TYPE_HASH   
26CB   CA EE 26               JZ   gc_scan_hash   
26CE   C3 0F 27               JMP   gc_scan_done   ; 文字列と空きは辿らない
26D1                GC_SCAN_ARRAY:      
26D1   78                     MOV   a,b   
26D2   B7                     ORA   a   
26D3   CA 0F 27               JZ   gc_scan_done   ; 要素数 0
26D6                             ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
26D6                             ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
26D6   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
26D8   DA E0 26               JC   gc_scan_aloop   ; 容量未満
26DB   CA E0 26               JZ   gc_scan_aloop   ; ちょうど容量
26DE   06 08                  MVI   b,COL_MAX_ARRAY_ELEMS   
26E0                GC_SCAN_ALOOP:      
26E0   CD 11 27               CALL   gc_mark_value   
26E3   23                     INX   h   
26E4   23                     INX   h   
26E5   23                     INX   h   
26E6   23                     INX   h   
26E7   05                     DCR   b   
26E8   C2 E0 26               JNZ   gc_scan_aloop   
26EB   C3 0F 27               JMP   gc_scan_done   
26EE                GC_SCAN_HASH:      
26EE   78                     MOV   a,b   
26EF   B7                     ORA   a   
26F0   CA 0F 27               JZ   gc_scan_done   ; 組の数 0
26F3   FE 04                  CPI   COL_MAX_HASH_PAIRS   
26F5   DA FD 26               JC   gc_scan_hloop   
26F8   CA FD 26               JZ   gc_scan_hloop   
26FB   06 04                  MVI   b,COL_MAX_HASH_PAIRS   
26FD                GC_SCAN_HLOOP:      
26FD   CD 11 27               CALL   gc_mark_value   ; 鍵
2700   23                     INX   h   
2701   23                     INX   h   
2702   23                     INX   h   
2703   23                     INX   h   
2704   CD 11 27               CALL   gc_mark_value   ; 値
2707   23                     INX   h   
2708   23                     INX   h   
2709   23                     INX   h   
270A   23                     INX   h   
270B   05                     DCR   b   
270C   C2 FD 26               JNZ   gc_scan_hloop   
270F                GC_SCAN_DONE:      
270F   C1                     POP   b   
2710   C9                     RET      
2711                             ; 
2711                             ; ---------------------------------------------------------------
2711                             ; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
2711                             ; 
2711                             ; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
2711                             ; なのでここでは何もしない (中身はルート走査で辿る)。
2711                             ; 
2711                             ; **値は スロット + 1。** 0 は「無し」。
2711                             ; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
2711                             ; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
2711                             ; 
2711                             ;   HL / DE / BC は保たれる
2711                             ; ---------------------------------------------------------------
2711                GC_MARK_VALUE:      
2711   E5                     PUSH   h   
2712   D5                     PUSH   d   
2713   C5                     PUSH   b   
2714   7E                     MOV   a,m   ; A = 型タグ
2715   FE 07                  CPI   TT_STRING   
2717   CA 27 27               JZ   gc_mv_ref   
271A   FE 08                  CPI   TT_ARRAY   
271C   CA 27 27               JZ   gc_mv_ref   
271F   FE 09                  CPI   TT_HASH   
2721   CA 27 27               JZ   gc_mv_ref   
2724   C3 3E 27               JMP   gc_mv_done   
2727                GC_MV_REF:      
2727   23                     INX   h   
2728   23                     INX   h   
2729   23                     INX   h   
272A   7E                     MOV   a,m   ; +3: val_hi
272B   B7                     ORA   a   
272C   C2 3E 27               JNZ   gc_mv_done   ; 上位が 0 でなければスロット番号ではない
272F   2B                     DCX   h   
2730   7E                     MOV   a,m   ; +2: val_lo = スロット + 1
2731   B7                     ORA   a   
2732   CA 3E 27               JZ   gc_mv_done   ; 0 = 無し
2735   3D                     DCR   a   ; A = スロット番号
2736   FE 40                  CPI   MAX_COL_SLOTS   
2738   D2 3E 27               JNC   gc_mv_done   ; 範囲外
273B   CD 5A 27               CALL   gc_set_bit   
273E                GC_MV_DONE:      
273E   C1                     POP   b   
273F   D1                     POP   d   
2740   E1                     POP   h   
2741   C9                     RET      
2742                             ; 
2742                             ; ---------------------------------------------------------------
2742                             ; ビットの出し入れ
2742                             ; 
2742                             ; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
2742                             ; 直して食い違うのを避けるため。
2742                             ; 
2742                             ; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
2742                             ;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
2742                             ; ---------------------------------------------------------------
2742                GC_BIT_PTR:      
2742   4F                     MOV   c,a   ; C = スロット番号
2743   0F                     RRC      
2744   0F                     RRC      
2745   0F                     RRC      
2746   E6 07                  ANI   07h   ; A = バイト位置 (slot >> 3)
2748   6F                     MOV   l,a   
2749   26 00                  MVI   h,0   
274B   19                     DAD   d   ; HL = 先頭 + バイト位置
274C   E5                     PUSH   h   
274D   79                     MOV   a,c   
274E   E6 07                  ANI   07h   ; ビット位置 (slot & 7)
2750   6F                     MOV   l,a   
2751   26 00                  MVI   h,0   
2753   11 9D 27               LXI   d,gc_bit_table   
2756   19                     DAD   d   
2757   7E                     MOV   a,m   ; A = ビットマスク
2758   E1                     POP   h   ; HL = ビットマップのバイト
2759   C9                     RET      
275A                             ; 
275A                             ; --- gc_set_bit: A = slot (0-63) の印を立てる ---
275A                GC_SET_BIT:      
275A   E5                     PUSH   h   
275B   D5                     PUSH   d   
275C   11 8C 27               LXI   d,gc_bitmap   
275F   CD 42 27               CALL   gc_bit_ptr   
2762   B6                     ORA   m   
2763   77                     MOV   m,a   
2764   D1                     POP   d   
2765   E1                     POP   h   
2766   C9                     RET      
2767                             ; 
2767                             ; --- gc_check_bit: A = slot の印を検査 ---
2767                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
2767                GC_CHECK_BIT:      
2767   E5                     PUSH   h   
2768   D5                     PUSH   d   
2769   11 8C 27               LXI   d,gc_bitmap   
276C   CD 42 27               CALL   gc_bit_ptr   
276F   A6                     ANA   m   ; Z=1 ならビットクリア
2770   D1                     POP   d   ; POP はフラグを変えない
2771   E1                     POP   h   
2772   C9                     RET      
2773                             ; 
2773                             ; --- gc_set_scanned: A = slot を走査済みにする ---
2773                GC_SET_SCANNED:      
2773   E5                     PUSH   h   
2774   D5                     PUSH   d   
2775   11 94 27               LXI   d,gc_scanned   
2778   CD 42 27               CALL   gc_bit_ptr   
277B   B6                     ORA   m   
277C   77                     MOV   m,a   
277D   D1                     POP   d   
277E   E1                     POP   h   
277F   C9                     RET      
2780                             ; 
2780                             ; --- gc_check_scanned: A = slot が走査済みか ---
2780                             ; 戻り: Z=1 → まだ、Z=0 → 済み
2780                GC_CHECK_SCANNED:      
2780   E5                     PUSH   h   
2781   D5                     PUSH   d   
2782   11 94 27               LXI   d,gc_scanned   
2785   CD 42 27               CALL   gc_bit_ptr   
2788   A6                     ANA   m   
2789   D1                     POP   d   
278A   E1                     POP   h   
278B   C9                     RET      
278C                             ; 
278C                             ; --- GC データ ---
278C                             ; 
278C                             ; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
278C                             ; 回している
278C   00 00 00 00 00 00 00 00 GC_BITMAP:   DB   0,0,0,0,0,0,0,0   
2794   00 00 00 00 00 00 00 00 GC_SCANNED:   DB   0,0,0,0,0,0,0,0   
279C   00           GC_CHANGED:   DB   0   
279D   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
27A5                             ; 
27A5                             ; ===============================================================
27A5                             ; sendb_each — Array#each: 配列要素を反復
27A5                             ; 
27A5                             ;   R[a] = TT_ARRAY (レシーバ)
27A5                             ;   R[a+argc+1] = TT_PROC (ブロック)
27A5                             ;   各反復で R[1] = array[index]
27A5                             ; 
27A5                             ; FRAME_KIND_EACH フレームを使い、フレーム +11 (reserved) に
27A5                             ; コレクションスロット番号を格納する。
27A5                             ; ===============================================================
27A5                SENDB_EACH:      
27A5                             ; R[a] が TT_ARRAY か確認
27A5   3A AB 18               LDA   sendb_reg_a   
27A8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
27AB   7E                     MOV   a,m   
27AC   FE 08                  CPI   TT_ARRAY   
27AE   C2 03 00               JNZ   vm_error   
27B1                             ; 
27B1                             ; コレクションスロット番号を取得
27B1   3A AB 18               LDA   sendb_reg_a   
27B4   CD 00 10               CALL   get_reg_addr   
27B7   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
27BA   7E                     MOV   a,m   ; val_lo = slot + 1
27BB   3D                     DCR   a   ; slot number (0-based)
27BC   32 31 28               STA   each_col_slot   
27BF                             ; 
27BF                             ; 要素数を読む
27BF   3A 31 28               LDA   each_col_slot   
27C2   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス
27C5   23                     INX   h   ; +1: count
27C6   7E                     MOV   a,m   
27C7   32 32 28               STA   each_count   
27CA   B7                     ORA   a   
27CB   CA 86 1B               JZ   vm_loop   ; 空配列 → ブロック実行しない
27CE                             ; 
27CE                             ; ブロック (TT_PROC) の情報を読む
27CE   3A AD 18               LDA   sendb_argc   
27D1   3C                     INR   a   ; argc + 1
27D2   47                     MOV   b,a   
27D3   3A AB 18               LDA   sendb_reg_a   
27D6   80                     ADD   b   ; A = a + argc + 1
27D7   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1]
27DA   CD 32 10               CALL   slot_to_value   
27DD   7E                     MOV   a,m   ; irep 番号
27DE   32 AF 18               STA   sendb_block_irep   
27E1   23                     INX   h   
27E2   7E                     MOV   a,m   ; outer
27E3   32 B0 18               STA   sendb_block_outer   
27E6                             ; 
27E6                             ; push_frame(a, FRAME_KIND_EACH, outer)
27E6   3A AB 18               LDA   sendb_reg_a   
27E9   06 02                  MVI   b,FRAME_KIND_EACH   
27EB   3A B0 18               LDA   sendb_block_outer   
27EE   4F                     MOV   c,a   
27EF   3A AB 18               LDA   sendb_reg_a   
27F2   CD A4 16               CALL   push_frame   
27F5                             ; 
27F5                             ; フレームに limit = count - 1 を設定
27F5   CD 9D 16               CALL   cur_frame_addr   
27F8   11 08 00               LXI   d,FRAME_OFF_LIMIT   
27FB   19                     DAD   d   
27FC   3A 32 28               LDA   each_count   
27FF   3D                     DCR   a   ; limit = count - 1
2800   77                     MOV   m,a   ; limit_lo
2801   23                     INX   h   
2802   36 00                  MVI   m,0   ; limit_hi
2804                             ; 
2804                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
2804   CD 9D 16               CALL   cur_frame_addr   
2807   11 0B 00               LXI   d,11   
280A   19                     DAD   d   
280B   3A 31 28               LDA   each_col_slot   
280E   77                     MOV   m,a   
280F                             ; 
280F                             ; R[1] = array[0] (最初の要素)
280F   3A 31 28               LDA   each_col_slot   
2812   CD A8 1F               CALL   col_slot_addr   ; HL = スロットアドレス
2815   23                     INX   h   ; skip type
2816   23                     INX   h   ; skip count → data[0]
2817                             ; data[0] を R[1] にコピー (4 バイト)
2817   E5                     PUSH   h   ; source 退避
2818   3E 01                  MVI   a,1   
281A   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
281D   EB                     XCHG      ; DE = R[1] (dest)
281E   E1                     POP   h   ; HL = data[0] (source)
281F   CD 25 10               CALL   copy_slot   
2822                             ; 
2822                             ; 子 irep に切り替え
2822   3A AF 18               LDA   sendb_block_irep   
2825   CD 29 17               CALL   switch_irep   
2828                             ; 
2828                             ; PC = 0
2828   21 00 00               LXI   h,0   
282B   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
282E   C3 86 1B               JMP   vm_loop   
2831                             ; 
2831                             ; --- sendb_each データ ---
2831   00           EACH_COL_SLOT:   DB   0   
2832   00           EACH_COUNT:   DB   0   
2833                             ; 
2833                          END      


