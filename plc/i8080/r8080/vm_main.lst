AE93   3A E3 AE               LDA   scat_dst_len   
AE96   80                     ADD   b   
AE97   FE 1F                  CPI   COL_MAX_STRING_LEN + 1   
AE99   DA B1 AE               JC   scat_len_ok   
AE9C                             ; 切り詰め: 追記できる分だけ
AE9C   3E 1E                  MVI   a,COL_MAX_STRING_LEN   
