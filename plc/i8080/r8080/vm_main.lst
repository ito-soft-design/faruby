1670   23                     INX   h   
1671   36 00                  MVI   m,0   
1673   C3 74 1D               JMP   vm_loop   
1676                             ; 
1676                             ; Hash.new。**引数は取れない** — 既定値 (Hash.new(0)) を覚える場所が無い
1676                SEND_NEW_HASH:      
1676   3A 4E 17               LDA   send_argc   
1679   B7                     ORA   a   
167A   C2 03 00               JNZ   vm_error   
167D   CD A6 21               CALL   col_alloc   
1680   32 A0 16               STA   snb_slot   
1683   36 03                  MVI   m,COL_TYPE_HASH   
1685   23                     INX   h   
