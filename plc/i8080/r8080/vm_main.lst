ACFB                             ; data[index] に R[a+2] の文字を書き込む
ACFB   5F                     MOV   e,a   
ACFC   16 00                  MVI   d,0   
ACFE   2A 75 AD               LHLD   sidx_data_addr   
AD01   19                     DAD   d   ; HL = &data[index]
AD02                             ; R[a+2] から文字コードを取得
AD02   3A 74 AD               LDA   sidx_reg_a   
AD05   3C                     INR   a   
AD06   3C                     INR   a   
AD07   CD 03 84               CALL   get_reg_addr   
