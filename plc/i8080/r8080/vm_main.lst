169F                             ; 
169F   00           SNB_COUNT:   DB   0   
16A0   00           SNB_SLOT:   DB   0   
16A1   00           SNB_LEFT:   DB   0   
16A2   00 00        SNB_DATA:   DW   0   
16A4                             ; 
16A4   00           SN_SLOT:   DB   0   
16A5   00           SN_CLASS_NUM:   DB   0   
16A6   00           SN_INIT_ID:   DB   0   
16A7   00           SN_INIT_IREP:   DB   0   
16A8                             ; 
16A8                             ; ---------------------------------------------------------------
16A8                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
16A8                             ; 
16A8                             ; スロット全体 (4 バイト) をバイト比較する。
16A8                             ; 型タグも含めて比較するので異なる型は常に true。
16A8                             ; ---------------------------------------------------------------
16A8                SEND_NE:      
16A8   3A 4D 17               LDA   send_reg_a   
16AB   F5                     PUSH   psw   
16AC   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
16AF   EB                     XCHG      ; DE = R[a+1]
16B0   F1                     POP   psw   
16B1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
16B4   0E 04                  MVI   c,SLOT_BYTES   
16B6                SEND_NE_CMP:      
16B6   1A                     LDAX   d   
16B7   BE                     CMP   m   
16B8   C2 CF 16               JNZ   send_ne_diff   
16BB   23                     INX   h   
16BC   13                     INX   d   
16BD   0D                     DCR   c   
16BE   C2 B6 16               JNZ   send_ne_cmp   
16C1                             ; 全バイト一致 → 等しい → false
16C1   3A 4D 17               LDA   send_reg_a   
16C4   CD 00 10               CALL   get_reg_addr   
16C7   3E 02                  MVI   a,TT_FALSE   
16C9   CD 1A 10               CALL   set_slot_special   
16CC   C3 74 1D               JMP   vm_loop   
16CF                SEND_NE_DIFF:      
16CF   3A 4D 17               LDA   send_reg_a   
16D2   CD 00 10               CALL   get_reg_addr   
16D5   3E 03                  MVI   a,TT_TRUE   
16D7   CD 1A 10               CALL   set_slot_special   
16DA   C3 74 1D               JMP   vm_loop   
16DD                             ; 
16DD                             ; ---------------------------------------------------------------
16DD                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
16DD                             ; 
16DD                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
16DD                             ; ---------------------------------------------------------------
16DD                SEND_NOT:      
16DD   3A 4D 17               LDA   send_reg_a   
16E0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
16E3   7E                     MOV   a,m   ; A = 型タグ
16E4   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
16E6   DA F7 16               JC   send_not_falsy   
16E9                             ; 真だった → false
16E9   3A 4D 17               LDA   send_reg_a   
16EC   CD 00 10               CALL   get_reg_addr   
16EF   3E 02                  MVI   a,TT_FALSE   
16F1   CD 1A 10               CALL   set_slot_special   
16F4   C3 74 1D               JMP   vm_loop   
16F7                SEND_NOT_FALSY:      
16F7                             ; 偽だった → true
16F7   3A 4D 17               LDA   send_reg_a   
16FA   CD 00 10               CALL   get_reg_addr   
16FD   3E 03                  MVI   a,TT_TRUE   
16FF   CD 1A 10               CALL   set_slot_special   
1702   C3 74 1D               JMP   vm_loop   
1705                             ; 
1705                             ; ---------------------------------------------------------------
1705                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
1705                             ; ---------------------------------------------------------------
1705                SEND_MOD:      
1705   3A 4D 17               LDA   send_reg_a   
1708   F5                     PUSH   psw   
1709   CD 0C 10               CALL   get_reg_addr_next   
170C   CD 32 10               CALL   slot_to_value   
170F   5E                     MOV   e,m   
1710   23                     INX   h   
1711   56                     MOV   d,m   ; DE = 除数
1712   7A                     MOV   a,d   
1713   B3                     ORA   e   
1714   C2 1B 17               JNZ   send_mod_ok   
1717   F1                     POP   psw   
1718   C3 03 00               JMP   vm_error   ; ゼロ除算
171B                SEND_MOD_OK:      
171B   F1                     POP   psw   
171C   CD 00 10               CALL   get_reg_addr   
171F   CD 32 10               CALL   slot_to_value   
1722   E5                     PUSH   h   ; 書き戻し先
1723   4E                     MOV   c,m   
1724   23                     INX   h   
1725   46                     MOV   b,m   ; BC = 被除数
1726   CD 4F 17               CALL   smod16   ; BC = 剰余 (除数と同符号)
1729   E1                     POP   h   
172A   71                     MOV   m,c   
172B   23                     INX   h   
172C   70                     MOV   m,b   
172D   C3 74 1D               JMP   vm_loop   
1730                             ; 
1730                             ; ---------------------------------------------------------------
1730                             ; abs (絶対値): R[a] = |R[a]|
1730                             ; ---------------------------------------------------------------
1730                SEND_ABS:      
1730   3A 4D 17               LDA   send_reg_a   
1733   CD 00 10               CALL   get_reg_addr   
1736   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭
1739   23                     INX   h   ; HL → val_hi
173A   7E                     MOV   a,m   
173B   E6 80                  ANI   80h   
173D   CA 74 1D               JZ   vm_loop   ; 正ならそのまま
1740   2B                     DCX   h   ; HL → val_lo
1741   4E                     MOV   c,m   
1742   23                     INX   h   
1743   46                     MOV   b,m   ; BC = 値
1744   CD DC 12               CALL   neg_bc   
1747   70                     MOV   m,b   ; val_hi
1748   2B                     DCX   h   
1749   71                     MOV   m,c   ; val_lo
174A   C3 74 1D               JMP   vm_loop   
174D                             ; 
174D                             ; --- 一時変数 ---
174D                SEND_REG_A:      
174D   00                     DB   0   
174E                SEND_ARGC:      
174E   00                     DB   0   
174F                             ; 
174F                             ; ---------------------------------------------------------------
174F                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
174F                             ; 
174F                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
174F                             ;   出力: BC = 剰余 (除数と同符号)
174F                             ;   破壊: A, DE, HL
174F                             ; 
174F                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
174F                             ; ---------------------------------------------------------------
174F                SMOD16:      
174F                             ; 除数の符号を保存
174F   7A                     MOV   a,d   
1750   F5                     PUSH   psw   
1751                             ; 符号の差を保存 (bit7: 異符号なら 1)
1751   78                     MOV   a,b   
1752   AA                     XRA   d   
1753   F5                     PUSH   psw   
1754                             ; 被除数を正にする
1754   78                     MOV   a,b   
1755   E6 80                  ANI   80h   
1757   CA 5D 17               JZ   smod_chk_div   
175A   CD DC 12               CALL   neg_bc   
175D                SMOD_CHK_DIV:      
175D   7A                     MOV   a,d   
175E   E6 80                  ANI   80h   
1760   CA 66 17               JZ   smod_do   
1763   CD E4 12               CALL   neg_de   
1766                SMOD_DO:      
1766   D5                     PUSH   d   ; |除数| を退避
1767   CD A5 12               CALL   udiv16   ; BC = 商, HL = 剰余
176A   44                     MOV   b,h   
176B   4D                     MOV   c,l   ; BC = |剰余|
176C   78                     MOV   a,b   
176D   B1                     ORA   c   
176E   D1                     POP   d   ; DE = |除数|
176F   F1                     POP   psw   ; 符号差 (bit7)
1770   CA 85 17               JZ   smod_zero   ; 剰余 = 0
1773   E6 80                  ANI   80h   
1775   CA 7E 17               JZ   smod_sign   ; 同符号 → 大きさはそのまま
1778                             ; 異符号: 大きさ = |除数| - |剰余|
1778   7B                     MOV   a,e   
1779   91                     SUB   c   
177A   4F                     MOV   c,a   
177B   7A                     MOV   a,d   
177C   98                     SBB   b   
177D   47                     MOV   b,a   
177E                SMOD_SIGN:      
177E   F1                     POP   psw   ; 除数の符号 (bit7)
177F   E6 80                  ANI   80h   
1781   C8                     RZ      ; 除数が正 → 正の剰余
1782   C3 DC 12               JMP   neg_bc   ; 除数が負 → 負にする
1785                SMOD_ZERO:      
1785   F1                     POP   psw   ; 除数の符号を捨てる
1786   C9                     RET      
1787                             ; vm_frame.a80 — フレームスタック管理
1787                             ; 
1787                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
1787                             ; 
1787                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
1787                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
1787                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
1787                             ;   get_frame_addr : フレーム番号 → メモリアドレス
1787                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
1787                             ; 
1787                             ; ---------------------------------------------------------------
1787                             ; get_frame_addr — フレーム番号 → アドレス
1787                             ; 
1787                             ;   入力: A = フレーム番号 (0-7)
1787                             ;   出力: HL = FRAME_STACK_BASE + A * 12
1787                             ;   破壊: A, B, DE
1787                             ; ---------------------------------------------------------------
1787                GET_FRAME_ADDR:      
1787   4F                     MOV   c,a   ; C = 元の値 (退避)
1788   87                     ADD   a   ; ×2
1789   47                     MOV   b,a   ; B = ×2
178A   87                     ADD   a   ; ×4
178B   80                     ADD   b   ; ×4 + ×2 = ×6
178C   87                     ADD   a   ; ×12
178D   5F                     MOV   e,a   
178E   16 00                  MVI   d,0   ; DE = frame * 12
1790   21 00 91               LXI   h,FRAME_STACK_BASE   
1793   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
1794   C9                     RET      
1795                             ; 
1795                             ; ---------------------------------------------------------------
1795                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
1795                             ; 
1795                             ;   入力: なし
1795                             ;   出力: HL = 現在のフレームのアドレス
1795                             ;   破壊: A, B, C, DE
1795                             ; ---------------------------------------------------------------
1795                CUR_FRAME_ADDR:      
1795   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1798   3D                     DCR   a   
1799   C3 87 17               JMP   get_frame_addr   
179C                             ; 
179C                             ; ---------------------------------------------------------------
179C                             ; push_frame — 現在の状態をフレームに保存
179C                             ; 
179C                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
179C                             ;          B = フレーム種別 (FRAME_KIND_*)
179C                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
179C                             ;   出力: なし
179C                             ;   破壊: A, B, C, HL, DE
179C                             ; 
179C                             ; frame_sp のスロットに保存して frame_sp++。
179C                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
179C                             ; ---------------------------------------------------------------
179C                PUSH_FRAME:      
179C                             ; パラメータを退避
179C   32 F4 17               STA   pf_shift_reg   
179F   78                     MOV   a,b   
17A0   32 F5 17               STA   pf_kind   
17A3   79                     MOV   a,c   
17A4   32 F6 17               STA   pf_outer   
17A7                             ; 
17A7                             ; HL = frame[frame_sp]
17A7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17AA   CD 87 17               CALL   get_frame_addr   
17AD                             ; 
17AD                             ; +0,+1: return_pc
17AD   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
17B0   77                     MOV   m,a   
17B1   23                     INX   h   
17B2   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
17B5   77                     MOV   m,a   
17B6   23                     INX   h   
17B7                             ; 
17B7                             ; +2: return_irep
17B7   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
17BA   77                     MOV   m,a   
17BB   23                     INX   h   
17BC                             ; 
17BC                             ; +3,+4: return_reg_base
17BC   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
17BF   77                     MOV   m,a   
17C0   23                     INX   h   
17C1   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
17C4   77                     MOV   m,a   
17C5   23                     INX   h   
17C6                             ; 
17C6                             ; +5: kind
17C6   3A F5 17               LDA   pf_kind   
17C9   77                     MOV   m,a   
17CA   23                     INX   h   
17CB                             ; 
17CB                             ; +6,+7: index = 0
17CB   36 00                  MVI   m,0   
17CD   23                     INX   h   
17CE   36 00                  MVI   m,0   
17D0   23                     INX   h   
17D1                             ; 
17D1                             ; +8,+9: limit = 0
17D1   36 00                  MVI   m,0   
17D3   23                     INX   h   
17D4   36 00                  MVI   m,0   
17D6   23                     INX   h   
17D7                             ; 
17D7                             ; +10: outer
17D7   3A F6 17               LDA   pf_outer   
17DA   77                     MOV   m,a   
17DB                             ; 
17DB                             ; reg_base += shift_reg * 4
17DB   3A F4 17               LDA   pf_shift_reg   
17DE   87                     ADD   a   ; ×2
17DF   87                     ADD   a   ; ×4
17E0   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
17E3   85                     ADD   l   
17E4   6F                     MOV   l,a   
17E5   3E 00                  MVI   a,0   
17E7   8C                     ADC   h   
17E8   67                     MOV   h,a   
17E9   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
17EC                             ; 
17EC                             ; frame_sp++
17EC   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17EF   3C                     INR   a   
17F0   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
17F3   C9                     RET      
17F4                             ; 
17F4                             ; push_frame の一時変数
17F4   00           PF_SHIFT_REG:   DB   0   
17F5   00           PF_KIND:   DB   0   
17F6   00           PF_OUTER:   DB   0   
17F7                             ; 
17F7                             ; ---------------------------------------------------------------
17F7                             ; pop_frame — frame_sp-- して保存した状態を復帰
17F7                             ; 
17F7                             ;   入力: なし
17F7                             ;   出力: なし
17F7                             ;   破壊: A, B, C, HL, DE
17F7                             ; 
17F7                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
17F7                             ; ---------------------------------------------------------------
17F7                POP_FRAME:      
17F7                             ; frame_sp--
17F7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
17FA   3D                     DCR   a   
17FB   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
17FE                             ; 
17FE                             ; HL = frame[frame_sp] (decremented value)
17FE   CD 87 17               CALL   get_frame_addr   
1801                             ; 
1801                             ; +0,+1: restore return_pc
1801   7E                     MOV   a,m   
1802   32 00 80               STA   VM_STATE_BASE + OFF_PC   
1805   23                     INX   h   
1806   7E                     MOV   a,m   
1807   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
180A   23                     INX   h   
180B                             ; 
180B                             ; +2: return_irep → switch_irep 用に退避
180B   7E                     MOV   a,m   
180C   32 20 18               STA   popf_ret_irep   
180F   23                     INX   h   
1810                             ; 
1810                             ; +3,+4: restore return_reg_base
1810   7E                     MOV   a,m   
1811   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
1814   23                     INX   h   
1815   7E                     MOV   a,m   
1816   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
1819                             ; 
1819                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
1819   3A 20 18               LDA   popf_ret_irep   
181C   CD 21 18               CALL   switch_irep   
181F   C9                     RET      
1820                             ; 
1820   00           POPF_RET_IREP:   DB   0   
1821                             ; 
1821                             ; ---------------------------------------------------------------
1821                             ; switch_irep — IREP テーブルから実行情報をロード
1821                             ; 
1821                             ;   入力: A = IREP 番号
1821                             ;   出力: なし
1821                             ;   破壊: A, B, C, HL, DE
1821                             ; 
1821                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
1821                             ; ---------------------------------------------------------------
1821                SWITCH_IREP:      
1821   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
1824                             ; 
1824                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
1824                             ; A * 10 = A * 8 + A * 2
1824   4F                     MOV   c,a   ; C = A (退避)
1825   87                     ADD   a   ; ×2
1826   47                     MOV   b,a   ; B = A*2
1827   79                     MOV   a,c   
1828   87                     ADD   a   ; ×2
1829   87                     ADD   a   ; ×4
182A   87                     ADD   a   ; ×8
182B   80                     ADD   b   ; A*8 + A*2 = A*10
182C   5F                     MOV   e,a   
182D   16 00                  MVI   d,0   
182F   21 00 82               LXI   h,IREP_TABLE_BASE   
1832   19                     DAD   d   ; HL = エントリアドレス
1833                             ; 
1833                             ; +0,+1: bytecode base → BC_BASE
1833   7E                     MOV   a,m   
1834   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1837   23                     INX   h   
1838   7E                     MOV   a,m   
1839   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
183C   23                     INX   h   
183D                             ; 
183D                             ; +2,+3: bytecode len → BC_LEN
183D   7E                     MOV   a,m   
183E   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1841   23                     INX   h   
1842   7E                     MOV   a,m   
1843   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1846   23                     INX   h   
1847                             ; 
1847                             ; +4,+5: pool base → POOL_BASE
1847   7E                     MOV   a,m   
1848   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
184B   23                     INX   h   
184C   7E                     MOV   a,m   
184D   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1850   23                     INX   h   
1851                             ; 
1851                             ; +6: nregs
1851   7E                     MOV   a,m   
1852   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
1855                             ; 
1855                             ; +7: subtree_size (スキップ)
1855   23                     INX   h   
1856                             ; 
1856                             ; +8,+9: sym_table_base → SYM_BASE
1856   23                     INX   h   
1857   7E                     MOV   a,m   
1858   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
185B   23                     INX   h   
185C   7E                     MOV   a,m   
185D   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1860                             ; 
1860   C9                     RET      
1861                             ; vm_block.a80 — ブロック関連オペコード
1861                             ; 
1861                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
1861                             ; 
1861                             ; ---------------------------------------------------------------
1861                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
1861                             ; ---------------------------------------------------------------
1861                DO_OP_LOADSELF:      
1861   CD C0 10               CALL   fetch_byte   ; A = a
1864   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1867   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1869   23                     INX   h   
186A   36 00                  MVI   m,0   ; +1: 予約
186C   23                     INX   h   
186D   36 00                  MVI   m,0   ; +2: val_lo = 0
186F   23                     INX   h   
1870   36 00                  MVI   m,0   ; +3: val_hi = 0
1872   C3 74 1D               JMP   vm_loop   
1875                             ; 
1875                             ; ---------------------------------------------------------------
1875                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
1875                             ; 
1875                             ; ブロックを TT_PROC としてレジスタに格納する。
1875                             ;   値の下位バイト = 子 irep 番号
1875                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
1875                             ; ---------------------------------------------------------------
1875                DO_OP_BLOCK:      
1875   CD C0 10               CALL   fetch_byte   ; A = a
1878   32 A1 18               STA   blk_reg_a   
187B   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
187E                             ; 
187E                             ; 子 irep 番号を算出 (共通サブルーチン)
187E   CD 77 10               CALL   calc_child_irep   ; A = child irep 番号
1881                             ; 
1881                             ; R[a] に TT_PROC を書く
1881   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1882   3A A1 18               LDA   blk_reg_a   
1885   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1888   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
188A   23                     INX   h   
188B   36 00                  MVI   m,0   ; +1: 予約
188D   23                     INX   h   
188E   71                     MOV   m,c   ; +2: val_lo = irep 番号
188F   23                     INX   h   
1890                             ; val_hi = 外側フレーム番号
1890                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
1890                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
1890   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1893   B7                     ORA   a   
1894   C2 9C 18               JNZ   block_in_frame   
1897   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
1899   C3 9D 18               JMP   block_set_outer   
189C                BLOCK_IN_FRAME:      
189C   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
189D                BLOCK_SET_OUTER:      
189D   77                     MOV   m,a   ; +3: val_hi = outer frame
189E   C3 74 1D               JMP   vm_loop   
18A1                             ; 
18A1   00           BLK_REG_A:   DB   0   
18A2                             ; 
18A2                             ; ---------------------------------------------------------------
18A2                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
18A2                             ; 
18A2                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
18A2                             ; ---------------------------------------------------------------
18A2                DO_OP_ENTER:      
18A2   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 1)
18A5   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 2)
18A8   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 3)
18AB   C3 74 1D               JMP   vm_loop   
18AE                             ; 
18AE                             ; ---------------------------------------------------------------
18AE                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
18AE                             ; 
18AE                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
18AE                             ; ブロック付きメソッド呼び出しを行う。
18AE                             ; ---------------------------------------------------------------
18AE                DO_OP_SSENDB:      
18AE                             ; オペランドをプリフェッチ
18AE   CD C0 10               CALL   fetch_byte   ; A = a
18B1   32 C9 19               STA   sendb_reg_a   
18B4   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
18B7   32 CA 19               STA   sendb_sym_b   
18BA   CD C0 10               CALL   fetch_byte   ; A = c (argc)
18BD   32 CB 19               STA   sendb_argc   
18C0                             ; 
18C0                             ; R[0] → R[a] コピー (self を設定)
18C0   3E 00                  MVI   a,0   
18C2   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
18C5   E5                     PUSH   h   ; R[0] アドレス退避
18C6   3A C9 19               LDA   sendb_reg_a   
18C9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
18CC   EB                     XCHG      ; DE = R[a]
18CD   E1                     POP   h   ; HL = R[0]
18CE   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
18D1                             ; 
18D1   C3 E6 18               JMP   sendb_dispatch   
18D4                             ; 
18D4                             ; ---------------------------------------------------------------
18D4                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
18D4                             ; 
18D4                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
18D4                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
18D4                             ; ---------------------------------------------------------------
18D4                DO_OP_SENDB:      
18D4   CD C0 10               CALL   fetch_byte   ; A = a
18D7   32 C9 19               STA   sendb_reg_a   
18DA   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
18DD   32 CA 19               STA   sendb_sym_b   
18E0   CD C0 10               CALL   fetch_byte   ; A = c (argc)
18E3   32 CB 19               STA   sendb_argc   
18E6                             ; 
18E6                SENDB_DISPATCH:      
18E6                             ; シンボルテーブルからメソッド ID を取得
18E6   3A CA 19               LDA   sendb_sym_b   
18E9   87                     ADD   a   ; ×2
18EA   5F                     MOV   e,a   
18EB   16 00                  MVI   d,0   
18ED   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
18F0   19                     DAD   d   ; HL = sym_table[b]
18F1   7E                     MOV   a,m   ; メソッド ID (下位)
18F2   32 CC 19               STA   sendb_method_id   
18F5                             ; 
18F5                             ; メソッド ID で振り分け
18F5   3A CC 19               LDA   sendb_method_id   
18F8   FE 0B                  CPI   11   ; METHOD_TIMES
18FA   CA 30 19               JZ   sendb_times   
18FD   FE 15                  CPI   METHOD_EACH   
18FF   CA 93 29               JZ   sendb_each   
1902   FE 1B                  CPI   27   ; METHOD_LOOP
1904   CA 93 19               JZ   sendb_loop   
1907                             ; any? / all? / none? は each と同じ反復。フレームの種別だけが違う
1907   FE 23                  CPI   METHOD_ANY_P   
1909   CA 1E 19               JZ   sendb_any   
190C   FE 24                  CPI   METHOD_ALL_P   
190E   CA 23 19               JZ   sendb_all   
1911   FE 25                  CPI   METHOD_NONE_P   
1913   CA 28 19               JZ   sendb_none   
1916   FE 1C                  CPI   METHOD_NEW   
1918   CA 59 2A               JZ   sendb_array_new   
191B                             ; 未対応のブロックメソッド
191B   C3 03 00               JMP   vm_error   
191E                             ; 
191E                             ; --- any? / all? / none? ---
191E                             ; 
191E                             ; **渡す値は each と同じ**なので sendb_each に合流します。種別が持つのは
191E                             ; 「ブロックの値をどう使うか」だけで、配列かハッシュかはスロットの
191E                             ; 見出しの種別 (COL_TYPE_*) で決まります。
191E                SENDB_ANY:      
191E   3E 06                  MVI   a,FRAME_KIND_ANY   
1920   C3 2A 19               JMP   sendb_pred   
1923                SENDB_ALL:      
1923   3E 07                  MVI   a,FRAME_KIND_ALL   
1925   C3 2A 19               JMP   sendb_pred   
1928                SENDB_NONE:      
1928   3E 08                  MVI   a,FRAME_KIND_NONE   
192A                SENDB_PRED:      
192A   32 96 2B               STA   each_arg_kind   
192D   C3 AE 29               JMP   sendb_each_join   
1930                             ; 
1930                             ; --- times ---
1930                SENDB_TIMES:      
1930                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
1930   3A C9 19               LDA   sendb_reg_a   
1933   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1936   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1939   4E                     MOV   c,m   ; C = val_lo
193A   23                     INX   h   
193B   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
193C                             ; 
193C                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
193C   78                     MOV   a,b   
193D   B1                     ORA   c   
193E   CA 74 1D               JZ   vm_loop   ; receiver == 0 → スキップ
1941                             ; 
1941                             ; limit = BC - 1
1941   0B                     DCX   b   ; BC = limit
1942                             ; 
1942                             ; push_frame: A=レジスタ番号, B=kind, C=outer
1942                             ; ブロックの位置: R[a + argc + 1]
1942   3A C9 19               LDA   sendb_reg_a   
1945   C5                     PUSH   b   ; limit を退避
1946                             ; ブロック (TT_PROC) の情報を読む
1946   3A CB 19               LDA   sendb_argc   
1949   3C                     INR   a   ; argc + 1
194A   47                     MOV   b,a   
194B   3A C9 19               LDA   sendb_reg_a   
194E   80                     ADD   b   ; A = a + argc + 1
194F   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1952   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1955   7E                     MOV   a,m   ; A = irep 番号
1956   32 CD 19               STA   sendb_block_irep   
1959   23                     INX   h   
195A   7E                     MOV   a,m   ; A = outer frame (val_hi)
195B   32 CE 19               STA   sendb_block_outer   
195E                             ; 
195E                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
195E   3A C9 19               LDA   sendb_reg_a   
1961   06 01                  MVI   b,FRAME_KIND_ITERATE   
1963   3A CE 19               LDA   sendb_block_outer   
1966   4F                     MOV   c,a   
1967   3A C9 19               LDA   sendb_reg_a   
196A   CD 9C 17               CALL   push_frame   
196D                             ; 
196D                             ; フレームに limit を設定
196D                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
196D   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
1970   11 08 00               LXI   d,FRAME_OFF_LIMIT   
1973   19                     DAD   d   ; HL = &limit
1974   C1                     POP   b   ; BC = limit (ここで復帰)
1975   71                     MOV   m,c   ; limit_lo
1976   23                     INX   h   
1977   70                     MOV   m,b   ; limit_hi
1978                             ; 
1978                             ; ブロック引数 R[1] = 0 (初期カウンタ)
1978                             ; R[1] は新しい reg_base から見た R[1]
1978   3E 01                  MVI   a,1   
197A   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
197D   06 00                  MVI   b,0   
197F   0E 00                  MVI   c,0   
1981   CD 10 10               CALL   set_slot_int16   ; R[1] = 0
1984                             ; 
1984                             ; 子 irep に切り替え
1984   3A CD 19               LDA   sendb_block_irep   
1987   CD 21 18               CALL   switch_irep   
198A                             ; 
198A                             ; PC = 0
198A   21 00 00               LXI   h,0   
198D   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1990   C3 74 1D               JMP   vm_loop   
1993                             ; 
1993                             ; --- loop ---
1993                SENDB_LOOP:      
1993                             ; ブロックの位置: R[a + argc + 1]
1993   3A CB 19               LDA   sendb_argc   
1996   3C                     INR   a   
1997   47                     MOV   b,a   
1998   3A C9 19               LDA   sendb_reg_a   
199B   80                     ADD   b   ; A = a + argc + 1
199C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
199F   CD 32 10               CALL   slot_to_value   
19A2   7E                     MOV   a,m   ; irep 番号
19A3   32 CD 19               STA   sendb_block_irep   
19A6   23                     INX   h   
19A7   7E                     MOV   a,m   ; outer
19A8   32 CE 19               STA   sendb_block_outer   
19AB                             ; 
19AB                             ; push_frame(a, FRAME_KIND_LOOP, outer)
19AB   3A C9 19               LDA   sendb_reg_a   
19AE   06 04                  MVI   b,FRAME_KIND_LOOP   
19B0   3A CE 19               LDA   sendb_block_outer   
19B3   4F                     MOV   c,a   
19B4   3A C9 19               LDA   sendb_reg_a   
19B7   CD 9C 17               CALL   push_frame   
19BA                             ; 
19BA                             ; 子 irep に切り替え
19BA   3A CD 19               LDA   sendb_block_irep   
19BD   CD 21 18               CALL   switch_irep   
19C0                             ; 
19C0                             ; PC = 0
19C0   21 00 00               LXI   h,0   
19C3   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
19C6   C3 74 1D               JMP   vm_loop   
19C9                             ; 
19C9                             ; OP_SENDB の一時変数
19C9   00           SENDB_REG_A:   DB   0   
19CA   00           SENDB_SYM_B:   DB   0   
19CB   00           SENDB_ARGC:   DB   0   
19CC   00           SENDB_METHOD_ID:   DB   0   
19CD   00           SENDB_BLOCK_IREP:   DB   0   
19CE   00           SENDB_BLOCK_OUTER:   DB   0   
19CF                             ; 
19CF                             ; ---------------------------------------------------------------
19CF                             ; OP_BREAK (B): ブロックから脱出
19CF                             ; 
19CF                             ; R[a] の値を R[0] にコピーして pop_frame。
19CF                             ; ---------------------------------------------------------------
19CF                DO_OP_BREAK:      
19CF   CD C0 10               CALL   fetch_byte   ; A = a
19D2                             ; R[a] → R[0] コピー
19D2   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19D5   E5                     PUSH   h   ; R[a] アドレス退避
19D6   3E 00                  MVI   a,0   
19D8   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
19DB   EB                     XCHG      ; DE = R[0]
19DC   E1                     POP   h   ; HL = R[a]
19DD   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
19E0                             ; 
19E0   CD F7 17               CALL   pop_frame   
19E3   C3 74 1D               JMP   vm_loop   
19E6                             ; vm_upvar.a80 — 外側スコープの変数アクセス
19E6                             ; 
19E6                             ; OP_GETUPVAR, OP_SETUPVAR
19E6                             ; 
19E6                             ; ブロック内から外側のローカル変数にアクセスする。
19E6                             ; outer フレーム chain を level 段辿って reg_base を求める。
19E6                             ; 
19E6                             ; ---------------------------------------------------------------
19E6                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
19E6                             ; 
19E6                             ;   入力: A = level (何段外側か)
19E6                             ;   出力: HL = 外側スコープの reg_base アドレス
19E6                             ;   破壊: A, B, C, DE
19E6                             ; 
19E6                             ; outer chain を level 段辿る。FRAME_NONE に達したら
19E6                             ; REG_FILE_BASE (トップレベル) を返す。
19E6                             ; ---------------------------------------------------------------
19E6                UPVAR_BASE:      
19E6   47                     MOV   b,a   ; B = level (残り段数)
19E7                             ; まず現在のフレームの outer を読む
19E7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
19EA   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
19EB   32 1D 1A               STA   upvar_frame   
19EE                             ; 
19EE                             ; level == 0 なら outer chain を辿らずに
19EE                             ; 現在のフレームの return_reg_base をそのまま返す
19EE   78                     MOV   a,b   
19EF   B7                     ORA   a   
19F0   CA 0A 1A               JZ   upvar_found   
19F3                             ; 
19F3                UPVAR_LOOP:      
19F3                             ; outer フレーム番号を読む
19F3   3A 1D 1A               LDA   upvar_frame   
19F6   CD 87 17               CALL   get_frame_addr   ; HL = フレームアドレス
19F9   11 0A 00               LXI   d,FRAME_OFF_OUTER   
19FC   19                     DAD   d   
19FD   7E                     MOV   a,m   ; A = outer frame 番号
19FE                             ; 
19FE   FE FF                  CPI   FRAME_NONE   
1A00   CA 19 1A               JZ   upvar_toplevel   ; トップレベルに達した
1A03                             ; 
1A03   32 1D 1A               STA   upvar_frame   ; 次のフレーム
1A06                             ; 
1A06   05                     DCR   b   
1A07   C2 F3 19               JNZ   upvar_loop   ; まだ辿る段がある
1A0A                             ; 
1A0A                             ; level 回辿り終わった — upvar_frame の reg_base を返す
1A0A                UPVAR_FOUND:      
1A0A   3A 1D 1A               LDA   upvar_frame   
1A0D   CD 87 17               CALL   get_frame_addr   ; HL = フレームアドレス
1A10   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
1A13   19                     DAD   d   
1A14   5E                     MOV   e,m   
1A15   23                     INX   h   
1A16   56                     MOV   d,m   ; DE = return_reg_base
1A17   EB                     XCHG      ; HL = return_reg_base
1A18   C9                     RET      
1A19                             ; 
1A19                UPVAR_TOPLEVEL:      
1A19   21 00 81               LXI   h,REG_FILE_BASE   
1A1C   C9                     RET      
1A1D                             ; 
1A1D   00           UPVAR_FRAME:   DB   0   
1A1E                             ; 
1A1E                             ; ---------------------------------------------------------------
1A1E                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
1A1E                             ; 
1A1E                             ;   a = コピー先レジスタ
1A1E                             ;   b = 外側スコープのレジスタ番号
1A1E                             ;   c = level (何段外側か)
1A1E                             ; ---------------------------------------------------------------
1A1E                DO_OP_GETUPVAR:      
1A1E   CD C0 10               CALL   fetch_byte   ; A = a
1A21   32 74 1A               STA   upvar_reg_a   
1A24   CD C0 10               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
1A27   32 75 1A               STA   upvar_reg_b   
1A2A   CD C0 10               CALL   fetch_byte   ; A = c (level)
1A2D                             ; 
1A2D                             ; 外側の reg_base を求める
1A2D   CD E6 19               CALL   upvar_base   ; HL = 外側の reg_base
1A30                             ; 
1A30                             ; 外側の R[b] のアドレス = base + b * 4
1A30   3A 75 1A               LDA   upvar_reg_b   
1A33   87                     ADD   a   ; ×2
1A34   87                     ADD   a   ; ×4
1A35   85                     ADD   l   
1A36   6F                     MOV   l,a   
1A37   3E 00                  MVI   a,0   
1A39   8C                     ADC   h   
1A3A   67                     MOV   h,a   ; HL = 外側の R[b]
1A3B                             ; 
1A3B                             ; R[a] にコピー
1A3B   E5                     PUSH   h   ; コピー元退避
1A3C   3A 74 1A               LDA   upvar_reg_a   
1A3F   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A42   EB                     XCHG      ; DE = R[a] (コピー先)
1A43   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
1A44   CD 25 10               CALL   copy_slot   
1A47   C3 74 1D               JMP   vm_loop   
1A4A                             ; 
1A4A                             ; ---------------------------------------------------------------
1A4A                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
1A4A                             ; 
1A4A                             ;   a = コピー元レジスタ
1A4A                             ;   b = 外側スコープのレジスタ番号
1A4A                             ;   c = level (何段外側か)
1A4A                             ; ---------------------------------------------------------------
1A4A                DO_OP_SETUPVAR:      
1A4A   CD C0 10               CALL   fetch_byte   ; A = a
1A4D   32 74 1A               STA   upvar_reg_a   
1A50   CD C0 10               CALL   fetch_byte   ; A = b
1A53   32 75 1A               STA   upvar_reg_b   
1A56   CD C0 10               CALL   fetch_byte   ; A = c (level)
1A59                             ; 
1A59                             ; 外側の reg_base を求める
1A59   CD E6 19               CALL   upvar_base   ; HL = 外側の reg_base
1A5C                             ; 
1A5C                             ; 外側の R[b] のアドレス = base + b * 4
1A5C   3A 75 1A               LDA   upvar_reg_b   
1A5F   87                     ADD   a   
1A60   87                     ADD   a   
1A61   85                     ADD   l   
1A62   6F                     MOV   l,a   
1A63   3E 00                  MVI   a,0   
1A65   8C                     ADC   h   
1A66   67                     MOV   h,a   ; HL = 外側の R[b]
1A67   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
1A68                             ; 
1A68                             ; R[a] からコピー
1A68   3A 74 1A               LDA   upvar_reg_a   
1A6B   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1A6E   CD 25 10               CALL   copy_slot   
1A71   C3 74 1D               JMP   vm_loop   
1A74                             ; 
1A74   00           UPVAR_REG_A:   DB   0   
1A75   00           UPVAR_REG_B:   DB   0   
1A76                             ; vm_class.a80 — クラス・メソッド定義オペコード
1A76                             ; 
1A76                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
1A76                             ; 
1A76                             ; ---------------------------------------------------------------
1A76                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
1A76                             ; 
1A76                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
1A76                             ; クラス本体内ではそのクラス (TT_CLASS)。
1A76                             ; ---------------------------------------------------------------
1A76                DO_OP_TCLASS:      
1A76   CD C0 10               CALL   fetch_byte   ; A = a
1A79   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A7C   EB                     XCHG      ; DE = R[a] (コピー先)
1A7D   3E 00                  MVI   a,0   
1A7F   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (コピー元)
1A82   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
1A85   C3 74 1D               JMP   vm_loop   
1A88                             ; 
1A88                             ; ---------------------------------------------------------------
1A88                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
1A88                             ; 
1A88                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
1A88                             ; ではないため、外側フレームへの参照を持たない)。
1A88                             ; ---------------------------------------------------------------
1A88                DO_OP_METHOD:      
1A88   CD C0 10               CALL   fetch_byte   ; A = a
1A8B   32 A8 1A               STA   meth_reg_a   
1A8E   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1A91   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1A94   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1A95                             ; 
1A95   3A A8 1A               LDA   meth_reg_a   
1A98   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A9B   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
1A9D   23                     INX   h   
1A9E   36 00                  MVI   m,0   ; +1: 予約
1AA0   23                     INX   h   
1AA1   71                     MOV   m,c   ; +2: val_lo = irep 番号
1AA2   23                     INX   h   
1AA3   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
1AA5   C3 74 1D               JMP   vm_loop   
1AA8                             ; 
1AA8   00           METH_REG_A:   DB   0   
1AA9                             ; 
1AA9                             ; ---------------------------------------------------------------
1AA9                             ; OP_DEF (BB): メソッド表に登録
1AA9                             ; 
1AA9                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
1AA9                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
1AA9                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
1AA9                             ; 
1AA9                             ; method_table[class_number * 32 + method_id] = irep 番号
1AA9                             ; ---------------------------------------------------------------
1AA9                DO_OP_DEF:      
1AA9   CD C0 10               CALL   fetch_byte   ; A = a
1AAC   32 0D 1B               STA   def_reg_a   
1AAF   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1AB2                             ; 
1AB2                             ; シンボルテーブルから method_id を取得
1AB2   87                     ADD   a   ; ×2
1AB3   5F                     MOV   e,a   
1AB4   16 00                  MVI   d,0   
1AB6   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1AB9   19                     DAD   d   ; HL = &sym_table[b]
1ABA   5E                     MOV   e,m   ; E = method_id (下位)
1ABB   23                     INX   h   
1ABC   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
1ABD                             ; 種別チェックは省略 (バイトコードツールが保証)
1ABD                             ; 
1ABD                             ; method_id を退避
1ABD   7B                     MOV   a,e   
1ABE   32 0E 1B               STA   def_method_id   
1AC1                             ; 
1AC1                             ; R[a] から class_number を取得
1AC1   3A 0D 1B               LDA   def_reg_a   
1AC4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AC7   CD 9B 10               CALL   class_of_reg   ; A = class_number
1ACA                             ; 
1ACA                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
1ACA                             ; A * 32
1ACA   87                     ADD   a   ; ×2
1ACB   87                     ADD   a   ; ×4
1ACC   87                     ADD   a   ; ×8
1ACD   87                     ADD   a   ; ×16
1ACE   87                     ADD   a   ; ×32
1ACF   5F                     MOV   e,a   
1AD0   16 00                  MVI   d,0   
1AD2   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1AD5   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
1AD6   3A 0E 1B               LDA   def_method_id   
1AD9   5F                     MOV   e,a   
1ADA   16 00                  MVI   d,0   
1ADC   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
1ADD                             ; 
1ADD                             ; R[a+1].val_lo = irep 番号
1ADD   3A 0D 1B               LDA   def_reg_a   
1AE0   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1AE3   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1AE6   7E                     MOV   a,m   ; A = val_lo = irep 番号
1AE7                             ; 
1AE7                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
1AE7   32 0F 1B               STA   def_irep_num   
1AEA   3A 0D 1B               LDA   def_reg_a   
1AED   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AF0   CD 9B 10               CALL   class_of_reg   ; A = class_number
1AF3   87                     ADD   a   
1AF4   87                     ADD   a   
1AF5   87                     ADD   a   
1AF6   87                     ADD   a   
1AF7   87                     ADD   a   ; A = class * 32
1AF8   5F                     MOV   e,a   
1AF9   16 00                  MVI   d,0   
1AFB   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1AFE   19                     DAD   d   
1AFF   3A 0E 1B               LDA   def_method_id   
1B02   5F                     MOV   e,a   
1B03   16 00                  MVI   d,0   
1B05   19                     DAD   d   ; HL = メソッド表エントリ
1B06   3A 0F 1B               LDA   def_irep_num   
1B09   77                     MOV   m,a   ; method_table[...] = irep 番号
1B0A   C3 74 1D               JMP   vm_loop   
1B0D                             ; 
1B0D   00           DEF_REG_A:   DB   0   
1B0E   00           DEF_METHOD_ID:   DB   0   
1B0F   00           DEF_IREP_NUM:   DB   0   
1B10                             ; 
1B10                             ; ---------------------------------------------------------------
1B10                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
1B10                             ; 
1B10                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
1B10                             ; ---------------------------------------------------------------
1B10                DO_OP_CLASS:      
1B10                             ; **クラス名と利用者の定数が同じ命令で来ます。** `Counter.new` の `Counter` も
1B10                             ; `LIMIT` も OP_GETCONST なので、シンボルテーブルの種別で分けます。
1B10                             ; ホスト側は `OP_CLASS` に出てきた名前だけをクラスとして登録するので、
1B10                             ; 残りは定数です (tools/i8080_bytecode_hex.rb)。
1B10                             ; 
1B10                             ; 定数はグローバル変数と同じ 4 バイトのスロットに置いてあるので、
1B10                             ; **写しは do_op_getgv の続き (getgv_ok) に合流させます。** 同じ並びを
1B10                             ; 2 か所に書くと、片方だけ直して食い違います。
1B10                DO_OP_GETCONST:      
1B10   CD C0 10               CALL   fetch_byte   ; A = a
1B13   F5                     PUSH   psw   
1B14   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1B17                             ; 
1B17                             ; シンボルテーブルのエントリを取る
1B17   87                     ADD   a   ; ×2
1B18   5F                     MOV   e,a   
1B19   16 00                  MVI   d,0   
1B1B   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1B1E   19                     DAD   d   ; HL = &sym_table[b]
1B1F   5E                     MOV   e,m   
1B20   23                     INX   h   
1B21   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
1B22                             ; 
1B22   7A                     MOV   a,d   
1B23   FE 02                  CPI   SYM_KIND_CLASS   
1B25   CA 47 1B               JZ   getconst_class   
1B28   FE 04                  CPI   SYM_KIND_BUILTIN_CLASS   
1B2A   CA 36 1B               JZ   getconst_builtin   
1B2D                             ; 
1B2D                             ; 利用者の定数。DE がグローバルスロットのアドレス
1B2D   7A                     MOV   a,d   
1B2E   B3                     ORA   e   
1B2F   C2 EB 13               JNZ   getgv_ok   ; do_op_getgv の続きへ (a はスタックにある)
1B32   F1                     POP   psw   
1B33   C3 03 00               JMP   vm_error   ; クラスでも定数でもない
1B36                             ; 
1B36                             ; 組み込みクラス (Array / Hash)。**番号を置くだけ**
1B36                             ; 
1B36                             ; 利用者のクラスと別のタグにする。`new` で作るものが違い、
1B36                             ; メソッド表の行も持たない
1B36                GETCONST_BUILTIN:      
1B36   F1                     POP   psw   ; A = a
1B37   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1B3A   36 0E                  MVI   m,TT_BUILTIN_CLASS   ; +0: 型タグ
1B3C   23                     INX   h   
1B3D   36 00                  MVI   m,0   ; +1: 予約
1B3F   23                     INX   h   
1B40   73                     MOV   m,e   ; +2: val_lo = BUILTIN_CLASS_*
1B41   23                     INX   h   
1B42   36 00                  MVI   m,0   ; +3: val_hi = 0
1B44   C3 74 1D               JMP   vm_loop   
1B47                             ; 
1B47                GETCONST_CLASS:      
1B47   F1                     POP   psw   ; A = a
1B48   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1B4B   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
1B4D   23                     INX   h   
1B4E   36 00                  MVI   m,0   ; +1: 予約
1B50   23                     INX   h   
1B51   73                     MOV   m,e   ; +2: val_lo = class_number
1B52   23                     INX   h   
1B53   36 00                  MVI   m,0   ; +3: val_hi = 0
1B55   C3 74 1D               JMP   vm_loop   
1B58                             ; 
1B58                             ; ---------------------------------------------------------------
1B58                             ; OP_EXEC (BB): クラス本体を実行
1B58                             ; 
1B58                             ; push_frame して子 irep に切り替える。
1B58                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
1B58                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
1B58                             ; ---------------------------------------------------------------
1B58                DO_OP_EXEC:      
1B58   CD C0 10               CALL   fetch_byte   ; A = a
1B5B   32 80 1B               STA   exec_reg_a   
1B5E   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1B61   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1B64   32 81 1B               STA   exec_irep   
1B67                             ; 
1B67                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
1B67   3A 80 1B               LDA   exec_reg_a   
1B6A   06 00                  MVI   b,FRAME_KIND_CALL   
1B6C   0E FF                  MVI   c,FRAME_NONE   
1B6E   CD 9C 17               CALL   push_frame   
1B71                             ; 
1B71                             ; 子 irep に切り替え
1B71   3A 81 1B               LDA   exec_irep   
1B74   CD 21 18               CALL   switch_irep   
1B77                             ; 
1B77                             ; PC = 0
1B77   21 00 00               LXI   h,0   
1B7A   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1B7D   C3 74 1D               JMP   vm_loop   
1B80                             ; 
1B80   00           EXEC_REG_A:   DB   0   
1B81   00           EXEC_IREP:   DB   0   
1B82                             ; vm_display.a80 — 7 セグメント表示
1B82                             ; 
1B82                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
1B82                             ; 上位 4 桁はブランク（消灯）にする。
1B82                             ; セグメントパターンは seg_table にまとめる。
1B82                             ; 
1B82                             ; ---------------------------------------------------------------
1B82                             ; display_hex16 — 16 ビット値を 7 セグに表示
1B82                             ; 
1B82                             ;   入力: HL = 値の先頭 (val_lo の位置)
1B82                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
1B82                             ;   破壊: A, B, C, HL, DE
1B82                             ; 
1B82                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
1B82                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
1B82                             ; ---------------------------------------------------------------
1B82                DISPLAY_HEX16:      
1B82   E5                     PUSH   h   ; 値のアドレスを退避
1B83                             ; 上位 4 桁をブランク (消灯) にする
1B83   11 F8 FF               LXI   d,DISPLAY_BASE   
1B86   AF                     XRA   a   ; A = 0 (全セグメント消灯)
1B87   12                     STAX   d   
1B88   13                     INX   d   
1B89   12                     STAX   d   
1B8A   13                     INX   d   
1B8B   12                     STAX   d   
1B8C   13                     INX   d   
1B8D   12                     STAX   d   
1B8E   13                     INX   d   ; DE = DISPLAY_BASE + 4
1B8F                             ; 値の byte1 (val_hi) から表示
1B8F   E1                     POP   h   ; HL = val_lo
1B90   23                     INX   h   ; HL = val_hi
1B91   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
1B93                DISPLAY_BYTE_LOOP:      
1B93                             ; 上位ニブル
1B93   7E                     MOV   a,m   
1B94   0F                     RRC      
1B95   0F                     RRC      
1B96   0F                     RRC      
1B97   0F                     RRC      
1B98   E6 0F                  ANI   0Fh   
1B9A   CD AD 1B               CALL   nibble_to_seg   
1B9D   12                     STAX   d   
1B9E   13                     INX   d   
1B9F                             ; 下位ニブル
1B9F   7E                     MOV   a,m   
1BA0   E6 0F                  ANI   0Fh   
1BA2   CD AD 1B               CALL   nibble_to_seg   
1BA5   12                     STAX   d   
1BA6   13                     INX   d   
1BA7                             ; 次のバイト (val_hi → val_lo)
1BA7   2B                     DCX   h   
1BA8   0D                     DCR   c   
1BA9   C2 93 1B               JNZ   display_byte_loop   
1BAC   C9                     RET      
1BAD                             ; 
1BAD                             ; ---------------------------------------------------------------
1BAD                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
1BAD                             ; 
1BAD                             ;   入力: A = 0-F
1BAD                             ;   出力: A = セグメントパターン
1BAD                             ;   破壊: なし (HL, BC は内部で退避・復元)
1BAD                             ; ---------------------------------------------------------------
1BAD                NIBBLE_TO_SEG:      
1BAD   E5                     PUSH   h   
1BAE   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
1BAF   6F                     MOV   l,a   
1BB0   26 00                  MVI   h,0   
1BB2   01 BA 1B               LXI   b,seg_table   
1BB5   09                     DAD   b   ; HL = seg_table + nibble
1BB6   7E                     MOV   a,m   
1BB7   C1                     POP   b   ; BC を復元
1BB8   E1                     POP   h   
1BB9   C9                     RET      
1BBA                             ; 
1BBA                             ; ---------------------------------------------------------------
1BBA                             ; 7 セグメントパターンテーブル
1BBA                             ; 
1BBA                             ;   bit 0 = a (上)
1BBA                             ;   bit 1 = b (右上)
1BBA                             ;   bit 2 = c (右下)
1BBA                             ;   bit 3 = d (下)
1BBA                             ;   bit 4 = e (左下)
1BBA                             ;   bit 5 = f (左上)
1BBA                             ;   bit 6 = g (中)
1BBA                             ; 
1BBA                             ;       aaa
1BBA                             ;      f   b
1BBA                             ;       ggg
1BBA                             ;      e   c
1BBA                             ;       ddd
1BBA                             ; ---------------------------------------------------------------
1BBA                SEG_TABLE:      
1BBA   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
1BBB   06                     DB   06h   ; 1
1BBC   5B                     DB   5Bh   ; 2
1BBD   4F                     DB   4Fh   ; 3
1BBE   66                     DB   66h   ; 4
1BBF   6D                     DB   6Dh   ; 5
1BC0   7D                     DB   7Dh   ; 6
1BC1   27                     DB   27h   ; 7  (ND8080 ROM パターン)
1BC2   7F                     DB   7Fh   ; 8
1BC3   6F                     DB   6Fh   ; 9
1BC4   77                     DB   77h   ; A
1BC5   7C                     DB   7Ch   ; b
1BC6   39                     DB   39h   ; C
1BC7   5E                     DB   5Eh   ; d
1BC8   79                     DB   79h   ; E
1BC9   71                     DB   71h   ; F
1BCA                             ; 
1BCA                             ; ===============================================================
1BCA                             ; OP_RETURN (B): フレーム種別に応じて復帰
1BCA                             ; 
1BCA                             ; frame_sp == 0 → トップレベル: 表示して停止
1BCA                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
1BCA                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
1BCA                             ; それ以外 (反復のフレーム) → ブロック内: advance_iteration
1BCA                             ; ===============================================================
1BCA                DO_OP_RETURN:      
1BCA   CD C0 10               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
1BCD   32 1D 1C               STA   return_reg_a   
1BD0                             ; 
1BD0                             ; フレームスタックが空ならトップレベル
1BD0   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1BD3   B7                     ORA   a   
1BD4   CA 09 1C               JZ   do_op_return_top   
1BD7                             ; 
1BD7                             ; フレーム種別を確認
1BD7   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム
1BDA   11 05 00               LXI   d,FRAME_OFF_KIND   
1BDD   19                     DAD   d   
1BDE   7E                     MOV   a,m   ; A = kind
1BDF   FE 00                  CPI   FRAME_KIND_CALL   
1BE1   CA EC 1B               JZ   return_call   
1BE4   FE 05                  CPI   FRAME_KIND_NEW   
1BE6   CA 03 1C               JZ   return_new   
1BE9                             ; 反復のフレーム (ITERATE / EACH / HASH_EACH / LOOP)
1BE9   C3 1E 1C               JMP   advance_iteration   
1BEC                             ; 
1BEC                RETURN_CALL:      
1BEC                             ; R[a] の値を R[0] にコピー
1BEC   3A 1D 1C               LDA   return_reg_a   
1BEF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1BF2   E5                     PUSH   h   
1BF3   3E 00                  MVI   a,0   
1BF5   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1BF8   EB                     XCHG      ; DE = R[0] (コピー先)
1BF9   E1                     POP   h   ; HL = R[a] (コピー元)
1BFA   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
1BFD   CD F7 17               CALL   pop_frame   
1C00   C3 74 1D               JMP   vm_loop   
1C03                             ; 
1C03                RETURN_NEW:      
1C03                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
1C03   CD F7 17               CALL   pop_frame   
1C06   C3 74 1D               JMP   vm_loop   
1C09                             ; 
1C09                DO_OP_RETURN_TOP:      
1C09   3A 1D 1C               LDA   return_reg_a   
1C0C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1C0F   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1C12   CD 82 1B               CALL   display_hex16   
1C15   3E 02                  MVI   a,VM_FINISHED   
1C17   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1C1A   C3 62 1D               JMP   vm_halt   
1C1D                             ; 
1C1D   00           RETURN_REG_A:   DB   0   
1C1E                             ; 
1C1E                             ; ===============================================================
1C1E                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
1C1E                             ; 
1C1E                             ; ITERATE (times / upto): index++ して limit と比較。超えたら pop_frame。
1C1E                             ; EACH / HASH_EACH: 同じ数え方で、ブロックに渡す値だけが違う。
1C1E                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
1C1E                             ; ===============================================================
1C1E                ADVANCE_ITERATION:      
1C1E                             ; フレーム種別を確認
1C1E   CD 95 17               CALL   cur_frame_addr   ; HL = 現在のフレーム
1C21   11 05 00               LXI   d,FRAME_OFF_KIND   
1C24   19                     DAD   d   
1C25   7E                     MOV   a,m   ; A = kind
1C26   FE 04                  CPI   FRAME_KIND_LOOP   
1C28   CA 82 1C               JZ   adv_reenter   ; loop → 常に再実行
1C2B   32 94 1C               STA   adv_kind   ; kind を退避
1C2E                             ; 
1C2E                             ; **Array.new はブロックの値をその回の要素へ書く**
1C2E   CD 95 1C               CALL   array_fill_element   
1C31                             ; 
1C31                             ; **述語はここでブロックの値を見る。** 打ち切るなら R[0] に答えが入る
1C31   CD C9 1C               CALL   predicate_decision   
1C34   B7                     ORA   a   
1C35   C2 8E 1C               JNZ   adv_stopped   
1C38                             ; 
1C38                             ; --- 反復に共通: index インクリメント + limit チェック ---
1C38   CD 95 17               CALL   cur_frame_addr   
1C3B   11 06 00               LXI   d,FRAME_OFF_INDEX   
1C3E   19                     DAD   d   
1C3F   4E                     MOV   c,m   ; C = index_lo
1C40   23                     INX   h   
1C41   46                     MOV   b,m   ; B = index_hi
1C42   03                     INX   b   ; BC = index + 1
1C43                             ; 書き戻す
1C43   70                     MOV   m,b   ; index_hi
1C44   2B                     DCX   h   
1C45   71                     MOV   m,c   ; index_lo
1C46                             ; 
1C46                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
1C46   23                     INX   h   ; → &index_hi
1C47   23                     INX   h   ; → &limit_lo
1C48   5E                     MOV   e,m   ; E = limit_lo
1C49   23                     INX   h   ; → &limit_hi
1C4A   56                     MOV   d,m   ; D = limit_hi
1C4B                             ; 
1C4B                             ; BC = new index, DE = limit
1C4B                             ; index > limit なら反復終了 (DE - BC でボロー発生)
1C4B   7B                     MOV   a,e   
1C4C   91                     SUB   c   
1C4D   7A                     MOV   a,d   
1C4E   98                     SBB   b   
1C4F   DA 8B 1C               JC   adv_done   ; index > limit → 反復終了
1C52                             ; 
1C52                             ; kind で R[1] の設定を分岐
1C52                             ; 添字を渡すのは ITERATE (times / upto) と ARRAY_FILL。
1C52                             ; **Array.new は R[0] が配列なので、種別で見分けないといけない** —
1C52                             ; コレクションの枝に落ちると要素を渡してしまう
1C52   3A 94 1C               LDA   adv_kind   
1C55   FE 01                  CPI   FRAME_KIND_ITERATE   
1C57   CA 5F 1C               JZ   adv_index_load   
1C5A   FE 09                  CPI   FRAME_KIND_ARRAY_FILL   
1C5C   C2 6A 1C               JNZ   adv_each_load   
1C5F                ADV_INDEX_LOAD:      
1C5F                             ; 
1C5F                             ; --- ITERATE (times): R[1] = index ---
1C5F   3E 01                  MVI   a,1   
1C61   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
1C64   CD 10 10               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
1C67   C3 82 1C               JMP   adv_reenter   
1C6A                             ; 
1C6A                             ; --- EACH / HASH_EACH: ブロックの引数を入れ直す ---
1C6A                             ; 
1C6A                             ; **値の出し方は sendb_each と同じものを呼びます。** 配列なら要素、
1C6A                             ; ハッシュなら鍵と値で、分けているのは each_block_args の中だけです。
1C6A                ADV_EACH_LOAD:      
1C6A                             ; BC = index のうち下位バイトだけ使う (配列 8 要素・ハッシュ 4 ペアまで)
1C6A   79                     MOV   a,c   
1C6B   32 97 2B               STA   each_index   
1C6E   3A 94 1C               LDA   adv_kind   
1C71   32 96 2B               STA   each_arg_kind   
1C74                             ; フレーム +11 からコレクションスロット番号を読む
1C74   CD 95 17               CALL   cur_frame_addr   ; BC を破壊するが、添字は退避済み
1C77   11 0B 00               LXI   d,11   
1C7A   19                     DAD   d   
1C7B   7E                     MOV   a,m   ; A = col_slot
1C7C   32 94 2B               STA   each_col_slot   
1C7F   CD 40 2B               CALL   each_block_args   
1C82                             ; 
1C82                ADV_REENTER:      
1C82                             ; PC = 0 で再実行
1C82   21 00 00               LXI   h,0   
1C85   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1C88   C3 74 1D               JMP   vm_loop   
1C8B                             ; 
1C8B                ADV_DONE:      
1C8B                             ; 反復完了 → フレームを破棄して親に戻る
1C8B                             ; **述語だけは R[0] を答えに書き換える** (止まったときの逆)
1C8B   CD 18 1D               CALL   predicate_exhausted   
1C8E                ADV_STOPPED:      
1C8E                             ; 打ち切り。R[0] には predicate_decision が答えを書いてある
1C8E   CD F7 17               CALL   pop_frame   
1C91   C3 74 1D               JMP   vm_loop   
1C94                             ; 
1C94   00           ADV_KIND:   DB   0   
1C95                             ; 
1C95                             ; ===============================================================
1C95                             ; array_fill_element — ブロックの値をその回の要素へ書く
1C95                             ; 
1C95                             ;   入力: adv_kind / return_reg_a / フレーム (+11 = col_slot, INDEX = 添字)
1C95                             ; 
1C95                             ; **添字は増やす前のもの。** いま終わった回の位置に書く。
1C95                             ; Array.new 以外では何もしない。
1C95                             ; ===============================================================
1C95                ARRAY_FILL_ELEMENT:      
1C95   3A 94 1C               LDA   adv_kind   
1C98   FE 09                  CPI   FRAME_KIND_ARRAY_FILL   
1C9A   C0                     RNZ      
1C9B                             ; 
1C9B                             ; 書き先 = スロットのデータ領域 + 添字 * 4
1C9B   CD 95 17               CALL   cur_frame_addr   
1C9E   11 0B 00               LXI   d,11   
1CA1   19                     DAD   d   
1CA2   7E                     MOV   a,m   ; A = col_slot
1CA3   CD 96 21               CALL   col_slot_addr   
1CA6   23                     INX   h   ; skip type
1CA7   23                     INX   h   ; skip count → データ領域
1CA8   22 C7 1C               SHLD   afe_data   
1CAB   CD 95 17               CALL   cur_frame_addr   
1CAE   11 06 00               LXI   d,FRAME_OFF_INDEX   
1CB1   19                     DAD   d   
1CB2   7E                     MOV   a,m   ; A = 添字 (下位バイト。8 要素までなので足りる)
1CB3   87                     ADD   a   ; ×2
1CB4   87                     ADD   a   ; ×4
1CB5   5F                     MOV   e,a   
1CB6   16 00                  MVI   d,0   
1CB8   2A C7 1C               LHLD   afe_data   
1CBB   19                     DAD   d   ; HL = 書き先
1CBC   EB                     XCHG      ; DE = 書き先
1CBD                             ; 
1CBD                             ; ブロックの戻り値を写す
1CBD   3A 1D 1C               LDA   return_reg_a   
1CC0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1CC3   CD 25 10               CALL   copy_slot   
1CC6   C9                     RET      
1CC7                             ; 
1CC7   00 00        AFE_DATA:   DW   0   
1CC9                             ; 
1CC9                             ; ===============================================================
1CC9                             ; predicate_decision — ブロックの値を見て打ち切るか決める
1CC9                             ; 
1CC9                             ;   入力: adv_kind (フレーム種別) / return_reg_a (ブロックの戻り値)
1CC9                             ;   出力: A = 1 なら打ち切った (R[0] に答えを書いた)、0 なら続ける
1CC9                             ; 
1CC9                             ; **R[0] を潰してよい。** もう要素を取り出さないので、レシーバの場所が
1CC9                             ; そのまま答えの置き場になる (呼んだ側の R[a] と同じ場所)。
1CC9                             ; 
1CC9                             ;   any?  真で止まって true、尽きたら false
1CC9                             ;   all?  偽で止まって false、尽きたら true
1CC9                             ;   none? 真で止まって false、尽きたら true
1CC9                             ; ===============================================================
1CC9                PREDICATE_DECISION:      
1CC9   3A 94 1C               LDA   adv_kind   
1CCC   FE 06                  CPI   FRAME_KIND_ANY   
1CCE   DA 15 1D               JC   pd_continue   ; ANY 未満 → 述語ではない
1CD1                             ; **上限も見る。** ARRAY_FILL は ANY より上だがブロックの値の使い方が
1CD1                             ; 違う。上限を見ないと none? として扱われ、1 回目で打ち切ってしまう
1CD1   FE 09                  CPI   FRAME_KIND_NONE + 1   
1CD3   D2 15 1D               JNC   pd_continue   
1CD6                             ; 
1CD6                             ; ブロックの戻り値の型タグ。TT_FALSE 以下が偽 (nil / false)
1CD6   3A 1D 1C               LDA   return_reg_a   
1CD9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1CDC   7E                     MOV   a,m   ; A = 型タグ
1CDD   FE 03                  CPI   TT_FALSE + 1   
1CDF   DA F2 1C               JC   pd_falsy   
1CE2                             ; 
1CE2                             ; --- 真だった ---
1CE2   3A 94 1C               LDA   adv_kind   
1CE5   FE 07                  CPI   FRAME_KIND_ALL   
1CE7   CA 15 1D               JZ   pd_continue   ; all? は真では止まらない
1CEA   FE 06                  CPI   FRAME_KIND_ANY   
1CEC   CA FD 1C               JZ   pd_stop_true   ; any? → true
1CEF   C3 02 1D               JMP   pd_stop_false   ; none? → false
1CF2                             ; 
1CF2                             ; --- 偽だった ---
1CF2                PD_FALSY:      
1CF2   3A 94 1C               LDA   adv_kind   
1CF5   FE 07                  CPI   FRAME_KIND_ALL   
1CF7   C2 15 1D               JNZ   pd_continue   ; any? / none? は偽では止まらない
1CFA   C3 02 1D               JMP   pd_stop_false   ; all? → false
1CFD                             ; 
1CFD                PD_STOP_TRUE:      
1CFD   3E 03                  MVI   a,TT_TRUE   
1CFF   C3 04 1D               JMP   pd_write   
1D02                PD_STOP_FALSE:      
1D02   3E 02                  MVI   a,TT_FALSE   
1D04                PD_WRITE:      
1D04   32 17 1D               STA   pd_tag   
1D07   3E 00                  MVI   a,0   
1D09   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1D0C   3A 17 1D               LDA   pd_tag   
1D0F   CD 1A 10               CALL   set_slot_special   
1D12   3E 01                  MVI   a,1   ; 打ち切った
1D14   C9                     RET      
1D15                             ; 
1D15                PD_CONTINUE:      
1D15   AF                     XRA   a   
1D16   C9                     RET      
1D17                             ; 
1D17   00           PD_TAG:   DB   0   
1D18                             ; 
1D18                             ; ===============================================================
1D18                             ; predicate_exhausted — 最後まで打ち切られなかったときの答え
1D18                             ; 
1D18                             ; **止まったときの逆**です。any? は false、all? と none? は true。
1D18                             ; 述語でなければ何もしません (R[0] のレシーバがそのまま値になる)。
1D18                             ; ===============================================================
1D18                PREDICATE_EXHAUSTED:      
1D18   3A 94 1C               LDA   adv_kind   
1D1B   FE 06                  CPI   FRAME_KIND_ANY   
1D1D   DA 3F 1D               JC   pe_ret   ; 述語ではない
1D20   FE 09                  CPI   FRAME_KIND_NONE + 1   
1D22   D2 3F 1D               JNC   pe_ret   ; ARRAY_FILL は答えを書かない (R[0] は配列)
1D25   FE 06                  CPI   FRAME_KIND_ANY   
1D27   CA 2F 1D               JZ   pe_false   ; any? → 尽きたら false
1D2A   3E 03                  MVI   a,TT_TRUE   ; all? / none? → 尽きたら true
1D2C   C3 31 1D               JMP   pe_write   
1D2F                PE_FALSE:      
1D2F   3E 02                  MVI   a,TT_FALSE   
1D31                PE_WRITE:      
1D31   32 40 1D               STA   pe_tag   
1D34   3E 00                  MVI   a,0   
1D36   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1D39   3A 40 1D               LDA   pe_tag   
1D3C   CD 1A 10               CALL   set_slot_special   
1D3F                PE_RET:      
1D3F   C9                     RET      
1D40                             ; 
1D40   00           PE_TAG:   DB   0   
1D41                             ; 
1D41                             ; ===============================================================
1D41                             ; OP_STOP (Z): VM 停止
1D41                             ; ===============================================================
1D41                DO_OP_STOP:      
1D41   3E 02                  MVI   a,VM_FINISHED   
1D43   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D46                             ; R[1] の値を 7 セグに表示
1D46   3E 01                  MVI   a,1   
1D48   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1D4B   CD 32 10               CALL   slot_to_value   ; HL = R[1] の値先頭
1D4E   CD 82 1B               CALL   display_hex16   
1D51   C3 62 1D               JMP   vm_halt   
1D54                             ; 
1D54                             ; ===============================================================
1D54                             ; エラー停止
1D54                             ; 
1D54                             ; 未対応のオペコードを踏んだとき。
1D54                             ; 現在のオペコードをエラーコードとして保存する。
1D54                             ; ===============================================================
1D54                VM_ERROR:      
1D54   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1D57   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
1D5A   3E 03                  MVI   a,VM_ERROR   
1D5C   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D5F   C3 62 1D               JMP   vm_halt   
1D62                             ; 
1D62                             ; ===============================================================
1D62                             ; 停止 — ND80Z モニタのリモートモードへ復帰
1D62                             ; 
1D62                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
1D62                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
1D62                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
1D62                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
1D62                             ; これにより自動的にリモートモードへ復帰する。
1D62                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
1D62                             ; ===============================================================
1D62                VM_HALT:      
1D62                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
1D62                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
1D62                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
1D62   06 04                  MVI   b,4   
1D64                VM_HALT_OUTER:      
1D64   11 00 00               LXI   d,0   
1D67                VM_HALT_INNER:      
1D67   1B                     DCX   d   
1D68   7A                     MOV   a,d   
1D69   B3                     ORA   e   
1D6A   C2 67 1D               JNZ   vm_halt_inner   
1D6D   05                     DCR   b   
1D6E   C2 64 1D               JNZ   vm_halt_outer   
1D71   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
1D74                             ; 
1D74                             ; ===============================================================
1D74                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
1D74                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
1D74                             ; ===============================================================
1D74                             ; 
1D74                             ; ===============================================================
1D74                             ; メインループ (fetch-decode-execute)
1D74                             ; ===============================================================
1D74                VM_LOOP:      
1D74                             ; --- 実行状態の確認 ---
1D74   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
1D77   FE 01                  CPI   VM_RUNNING   
1D79   C2 62 1D               JNZ   vm_halt   
1D7C                             ; 
1D7C                             ; --- PC がバイトコード長を超えていないか ---
1D7C   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
1D7F   EB                     XCHG      ; DE = PC
1D80   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
1D83                             ; HL = bytecode_len, DE = PC
1D83                             ; PC >= bytecode_len ならエラー
1D83   7B                     MOV   a,e   
1D84   95                     SUB   l   
1D85   7A                     MOV   a,d   
1D86   9C                     SBB   h   ; DE - HL (PC - len)
1D87   D2 03 00               JNC   vm_error   ; PC >= len → エラー
1D8A                             ; 
1D8A                             ; --- オペコードフェッチ ---
1D8A   CD C0 10               CALL   fetch_byte   ; A = opcode
1D8D   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1D90                             ; 
1D90                             ; --- ステップカウント ---
1D90   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1D93   23                     INX   h   
1D94   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1D97                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
1D97   7C                     MOV   a,h   
1D98   B5                     ORA   l   
1D99   C2 A3 1D               JNZ   vm_dispatch   
1D9C   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1D9F   23                     INX   h   
1DA0   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1DA3                             ; 
1DA3                             ; --- ディスパッチ ---
1DA3                VM_DISPATCH:      
1DA3   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1DA6                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
1DA6   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
1DA7   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
1DAA   5F                     MOV   e,a   
1DAB   16 00                  MVI   d,0   ; DE = opcode * 2
1DAD   21 C5 1D               LXI   h,dispatch_table   
1DB0   19                     DAD   d   ; HL = &dispatch_table[opcode]
1DB1                             ; テーブル上限チェック
1DB1   11 99 1E               LXI   d,dispatch_table_end   
1DB4   7B                     MOV   a,e   
1DB5   95                     SUB   l   
1DB6   7A                     MOV   a,d   
1DB7   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
1DB8   DA 03 00               JC   vm_error   ; テーブル範囲外
1DBB                             ; アドレスを読んでジャンプ
1DBB   5E                     MOV   e,m   ; E = 下位バイト
1DBC   23                     INX   h   
1DBD   56                     MOV   d,m   ; D = 上位バイト
1DBE   EB                     XCHG      ; HL = ハンドラアドレス
1DBF                             ; 0000h ならエラー (未実装マーカー)
1DBF   7C                     MOV   a,h   
1DC0   B5                     ORA   l   
1DC1   CA 03 00               JZ   vm_error   
1DC4   E9                     PCHL      ; ハンドラへジャンプ
1DC5                             ; 
1DC5                             ; ===============================================================
1DC5                             ; ディスパッチテーブル
1DC5                             ; 
1DC5                             ; オペコード番号順に 2 バイトのアドレスを並べる。
1DC5                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
1DC5                             ; ===============================================================
1DC5                DISPATCH_TABLE:      
1DC5   DE 10                  DW   do_op_nop   ; 00 OP_NOP
1DC7   E1 10                  DW   do_op_move   ; 01 OP_MOVE
1DC9   00 00                  DW   0000h   ; 02 OP_LOADL
1DCB   F7 10                  DW   do_op_loadi   ; 03 OP_LOADI
1DCD   0C 11                  DW   do_op_loadineg   ; 04 OP_LOADINEG
1DCF   23 11                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
1DD1   33 11                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
1DD3   38 11                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
1DD5   3D 11                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
1DD7   42 11                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
1DD9   47 11                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
1DDB   4C 11                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
1DDD   51 11                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
1DDF   56 11                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
1DE1   66 11                  DW   do_op_loadi16   ; 0E OP_LOADI16
1DE3   00 00                  DW   0000h   ; 0F OP_LOADI32
1DE5   00 00                  DW   0000h   ; 10 OP_LOADSYM
1DE7   7F 11                  DW   do_op_loadnil   ; 11 OP_LOADNIL
1DE9   61 18                  DW   do_op_loadself   ; 12 OP_LOADSELF
1DEB   8D 11                  DW   do_op_loadt   ; 13 OP_LOADT
1DED   9B 11                  DW   do_op_loadf   ; 14 OP_LOADF
1DEF   CA 13                  DW   do_op_getgv   ; 15 OP_GETGV
1DF1   0C 14                  DW   do_op_setgv   ; 16 OP_SETGV
1DF3   00 00                  DW   0000h   ; 17 OP_GETSV
1DF5   00 00                  DW   0000h   ; 18 OP_SETSV
1DF7   CA 13                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
1DF9   0C 14                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
1DFB   CA 13                  DW   do_op_getgv   ; 1B OP_GETCV (= OP_GETGV)
1DFD   0C 14                  DW   do_op_setgv   ; 1C OP_SETCV (= OP_SETGV)
1DFF   10 1B                  DW   do_op_getconst   ; 1D OP_GETCONST
1E01   0C 14                  DW   do_op_setgv   ; 1E OP_SETCONST (= OP_SETGV)
1E03   00 00                  DW   0000h   ; 1F OP_GETMCNST
1E05   00 00                  DW   0000h   ; 20 OP_SETMCNST
1E07   1E 1A                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
1E09   4A 1A                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
1E0B   C3 21                  DW   do_op_getidx   ; 23 OP_GETIDX
1E0D   6A 22                  DW   do_op_setidx   ; 24 OP_SETIDX
1E0F   83 13                  DW   do_op_jmp   ; 25 OP_JMP
1E11   8C 13                  DW   do_op_jmpif   ; 26 OP_JMPIF
1E13   AB 13                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
1E15   00 00                  DW   0000h   ; 28 OP_JMPNIL
1E17   83 13                  DW   do_op_jmp   ; 29 OP_JMPUW (= OP_JMP)
1E19   00 00                  DW   0000h   ; 2A OP_EXCEPT
1E1B   00 00                  DW   0000h   ; 2B OP_RESCUE
1E1D   00 00                  DW   0000h   ; 2C OP_RAISEIF
1E1F   6D 14                  DW   do_op_ssend   ; 2D OP_SSEND
1E21   AE 18                  DW   do_op_ssendb   ; 2E OP_SSENDB
1E23   8E 14                  DW   do_op_send   ; 2F OP_SEND
1E25   D4 18                  DW   do_op_sendb   ; 30 OP_SENDB
1E27   00 00                  DW   0000h   ; 31 OP_CALL
1E29   00 00                  DW   0000h   ; 32 OP_SUPER
1E2B   00 00                  DW   0000h   ; 33 OP_ARGARY
1E2D   A2 18                  DW   do_op_enter   ; 34 OP_ENTER
1E2F   00 00                  DW   0000h   ; 35 OP_KEY_P
1E31   00 00                  DW   0000h   ; 36 OP_KEYEND
1E33   00 00                  DW   0000h   ; 37 OP_KARG
1E35   CA 1B                  DW   do_op_return   ; 38 OP_RETURN
1E37   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
1E39   CF 19                  DW   do_op_break   ; 3A OP_BREAK
1E3B   00 00                  DW   0000h   ; 3B OP_BLKPUSH
1E3D   A9 11                  DW   do_op_add   ; 3C OP_ADD
1E3F   EB 11                  DW   do_op_addi   ; 3D OP_ADDI
1E41   D3 11                  DW   do_op_sub   ; 3E OP_SUB
1E43   05 12                  DW   do_op_subi   ; 3F OP_SUBI
1E45   1F 12                  DW   do_op_mul   ; 40 OP_MUL
1E47   43 12                  DW   do_op_div   ; 41 OP_DIV
1E49   22 13                  DW   do_op_eq   ; 42 OP_EQ
1E4B   4C 13                  DW   do_op_lt   ; 43 OP_LT
1E4D   56 13                  DW   do_op_le   ; 44 OP_LE
1E4F   63 13                  DW   do_op_gt   ; 45 OP_GT
1E51   70 13                  DW   do_op_ge   ; 46 OP_GE
1E53   20 23                  DW   do_op_array   ; 47 OP_ARRAY
1E55   9A 25                  DW   do_op_array2   ; 48 OP_ARRAY2
1E57   00 00                  DW   0000h   ; 49 OP_ARYCAT
1E59   9C 23                  DW   do_op_arypush   ; 4A OP_ARYPUSH
1E5B   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
1E5D   00 00                  DW   0000h   ; 4C OP_AREF
1E5F   00 00                  DW   0000h   ; 4D OP_ASET
1E61   00 00                  DW   0000h   ; 4E OP_APOST
1E63   00 00                  DW   0000h   ; 4F OP_INTERN
1E65   00 00                  DW   0000h   ; 50 OP_SYMBOL
1E67   21 1F                  DW   do_op_string   ; 51 OP_STRING
1E69   14 24                  DW   do_op_strcat   ; 52 OP_STRCAT
1E6B   AC 25                  DW   do_op_hash   ; 53 OP_HASH
1E6D   00 00                  DW   0000h   ; 54 OP_HASHADD
1E6F   00 00                  DW   0000h   ; 55 OP_HASHCAT
1E71   00 00                  DW   0000h   ; 56 OP_LAMBDA
1E73   75 18                  DW   do_op_block   ; 57 OP_BLOCK
1E75   88 1A                  DW   do_op_method   ; 58 OP_METHOD
1E77   00 00                  DW   0000h   ; 59 OP_RANGE_INC
1E79   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
1E7B   00 00                  DW   0000h   ; 5B OP_OCLASS
1E7D   10 1B                  DW   do_op_class   ; 5C OP_CLASS
1E7F   00 00                  DW   0000h   ; 5D OP_MODULE
1E81   58 1B                  DW   do_op_exec   ; 5E OP_EXEC
1E83   A9 1A                  DW   do_op_def   ; 5F OP_DEF
1E85   00 00                  DW   0000h   ; 60 OP_ALIAS
1E87   00 00                  DW   0000h   ; 61 OP_UNDEF
1E89   00 00                  DW   0000h   ; 62 OP_SCLASS
1E8B   76 1A                  DW   do_op_tclass   ; 63 OP_TCLASS
1E8D   00 00                  DW   0000h   ; 64 OP_DEBUG
1E8F   00 00                  DW   0000h   ; 65 OP_ERR
1E91   00 00                  DW   0000h   ; 66 OP_EXT1
1E93   00 00                  DW   0000h   ; 67 OP_EXT2
1E95   00 00                  DW   0000h   ; 68 OP_EXT3
1E97   41 1D                  DW   do_op_stop   ; 69 OP_STOP
1E99                DISPATCH_TABLE_END:      
1E99                             ; 
1E99                             ; ===============================================================
1E99                             ; clear_pages — B ページ (256 バイト × B) をゼロクリア
1E99                             ; 
1E99                             ; 入力: HL = 先頭アドレス, B = ページ数
1E99                             ; 破壊: A, B, C, HL
1E99                             ; ===============================================================
1E99                CLEAR_PAGES:      
1E99   0E 00                  MVI   c,0   ; 256 回
1E9B                CLEAR_PAGES_BYTE:      
1E9B   36 00                  MVI   m,0   
1E9D   23                     INX   h   
1E9E   0D                     DCR   c   
1E9F   C2 9B 1E               JNZ   clear_pages_byte   
1EA2   05                     DCR   b   
1EA3   C2 99 1E               JNZ   clear_pages   
1EA6   C9                     RET      
1EA7                             ; 
1EA7                             ; ===============================================================
1EA7                             ; 初期化 (起動時 1 回だけ)
1EA7                             ; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
1EA7                             ; ===============================================================
1EA7                VM_START:      
1EA7                             ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
1EA7   21 00 80               LXI   h,VM_STATE_BASE   
1EAA   06 01                  MVI   b,1   
1EAC   CD 99 1E               CALL   clear_pages   
1EAF                             ; 
1EAF                             ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
1EAF   21 00 81               LXI   h,REG_FILE_BASE   
1EB2   06 01                  MVI   b,1   
1EB4   CD 99 1E               CALL   clear_pages   
1EB7                             ; 
1EB7                             ; メソッド表をゼロクリア (256 バイト = 1 ページ)
1EB7   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1EBA   06 01                  MVI   b,1   
1EBC   CD 99 1E               CALL   clear_pages   
1EBF                             ; 
1EBF                             ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
1EBF   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1EC2   06 04                  MVI   b,4   
1EC4   CD 99 1E               CALL   clear_pages   
1EC7                             ; 
1EC7                             ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
1EC7   21 C0 96               LXI   h,COLLECTION_POOL_BASE   
1ECA   06 09                  MVI   b,9   
1ECC   CD 99 1E               CALL   clear_pages   
1ECF                             ; 
1ECF                             ; IREP 0 のバイトコード長を VM 状態に設定
1ECF                             ; IREP テーブルの先頭エントリから読む
1ECF   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
1ED2   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1ED5   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
1ED8   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1EDB                             ; 
1EDB                             ; レジスタベースを初期化 (REG_FILE_BASE)
1EDB   21 00 81               LXI   h,REG_FILE_BASE   
1EDE   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
1EE1                             ; 
1EE1                             ; バイトコードベースを IREP 0 から読んで設定
1EE1   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
1EE4   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1EE7   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
1EEA   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1EED                             ; 
1EED                             ; シンボルテーブルベースを IREP 0 から読んで設定
1EED   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
1EF0   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1EF3   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
1EF6   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1EF9                             ; 
1EF9                             ; 定数プールベースを IREP 0 から読んで設定
1EF9   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
1EFC   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1EFF   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
1F02   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1F05                             ; 
1F05                             ; フレーム SP = 0 (ゼロクリア済み)
1F05                             ; PC = 0 (ゼロクリア済み)
1F05                             ; 
1F05                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
1F05                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
1F05   3A FE 82               LDA   INIT_METHOD_ID_STORE   
1F08   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
1F0B                             ; 
1F0B                             ; R[0] = self (TT_OBJECT, 値 = 0)
1F0B   21 00 81               LXI   h,REG_FILE_BASE   
1F0E   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1F10   23                     INX   h   
1F11   36 00                  MVI   m,0   ; +1: 予約
1F13   23                     INX   h   
1F14   36 00                  MVI   m,0   ; +2: val_lo
1F16   23                     INX   h   
1F17   36 00                  MVI   m,0   ; +3: val_hi
1F19                             ; 
1F19                             ; 実行状態を RUNNING に設定
1F19   3E 01                  MVI   a,VM_RUNNING   
1F1B   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1F1E                             ; 
1F1E                             ; メインループへ
1F1E   C3 74 1D               JMP   vm_loop   
1F21                             ; 
1F21                             ; ===============================================================
1F21                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
1F21                             ; 
1F21                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
1F21                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
1F21                             ; ===============================================================
1F21                DO_OP_STRING:      
1F21   CD C0 10               CALL   fetch_byte   ; A = a
1F24   32 7E 1F               STA   ops_reg_a   
1F27   CD C0 10               CALL   fetch_byte   ; A = b (プールインデックス)
1F2A                             ; pool_base + b * 4 を計算
1F2A   87                     ADD   a   ; b * 2
1F2B   87                     ADD   a   ; b * 4
1F2C   5F                     MOV   e,a   
1F2D   16 00                  MVI   d,0   
1F2F   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
1F32   19                     DAD   d   ; HL = &Pool[b]
1F33                             ; Pool[b] の val (文字列データアドレス) を取得
1F33   23                     INX   h   ; +1: 予約
1F34   23                     INX   h   ; +2: val_lo
1F35   5E                     MOV   e,m   
1F36   23                     INX   h   ; +3: val_hi
1F37   56                     MOV   d,m   ; DE = 文字列データアドレス
1F38                             ; DE → 長さバイト + ASCII データ
1F38   1A                     LDAX   d   ; A = 文字列長
1F39   32 7F 1F               STA   ops_str_len   
1F3C   13                     INX   d   ; DE → 最初のバイト
1F3D   D5                     PUSH   d   ; 文字列データソース退避
1F3E                             ; 
1F3E                             ; コレクションスロットを確保
1F3E   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
1F41   32 80 1F               STA   ops_slot_num   
1F44                             ; 
1F44                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
1F44   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
1F46   23                     INX   h   
1F47   3A 7F 1F               LDA   ops_str_len   
1F4A   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
1F4C   DA 51 1F               JC   ops_len_ok   
1F4F   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
1F51                OPS_LEN_OK:      
1F51   77                     MOV   m,a   ; +1: count
1F52   32 7F 1F               STA   ops_str_len   ; 切り詰め後の長さ
1F55   23                     INX   h   ; HL → データ領域先頭
1F56                             ; 
1F56                             ; 文字列データをコピー
1F56   D1                     POP   d   ; DE = ソースデータ
1F57   3A 7F 1F               LDA   ops_str_len   
1F5A   B7                     ORA   a   
1F5B   CA 67 1F               JZ   ops_set_reg   ; 空文字列
1F5E   4F                     MOV   c,a   
1F5F                OPS_STR_COPY:      
1F5F   1A                     LDAX   d   
1F60   77                     MOV   m,a   
1F61   23                     INX   h   
1F62   13                     INX   d   
1F63   0D                     DCR   c   
1F64   C2 5F 1F               JNZ   ops_str_copy   
1F67                             ; 
1F67                OPS_SET_REG:      
1F67                             ; R[a] = TT_STRING, val_lo = slot+1
1F67   3A 7E 1F               LDA   ops_reg_a   
1F6A   CD 00 10               CALL   get_reg_addr   ; HL = &R[a]
1F6D   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
1F6F   23                     INX   h   
1F70   36 00                  MVI   m,0   ; +1: 予約
1F72   23                     INX   h   
1F73   3A 80 1F               LDA   ops_slot_num   
1F76   3C                     INR   a   ; slot + 1
1F77   77                     MOV   m,a   ; +2: val_lo
1F78   23                     INX   h   
1F79   36 00                  MVI   m,0   ; +3: val_hi
1F7B   C3 74 1D               JMP   vm_loop   
1F7E                             ; 
1F7E   00           OPS_REG_A:   DB   0   
1F7F   00           OPS_STR_LEN:   DB   0   
1F80   00           OPS_SLOT_NUM:   DB   0   
1F81                             ; 
1F81                             ; ===============================================================
1F81                             ; send_display — display(value): 7 セグに hex 表示
1F81                             ; 
1F81                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
1F81                             ; R[a] に nil を返す。
1F81                             ; ===============================================================
1F81                SEND_DISPLAY:      
1F81   3A 4D 17               LDA   send_reg_a   
1F84   3C                     INR   a   
1F85   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1F88   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1F8B   CD 82 1B               CALL   display_hex16   ; 7 セグに書く
1F8E                             ; return nil
1F8E   3A 4D 17               LDA   send_reg_a   
1F91   CD 00 10               CALL   get_reg_addr   
1F94   3E 01                  MVI   a,TT_NIL   
1F96   CD 1A 10               CALL   set_slot_special   
1F99   C3 74 1D               JMP   vm_loop   
1F9C                             ; 
1F9C                             ; ===============================================================
1F9C                             ; send_getkey — getkey / getkey(timeout)
1F9C                             ; 
1F9C                             ; getkey (引数なし): KEYIN1 でブロッキング入力
1F9C                             ;   ROM なし → -1
1F9C                             ;   キー押下 → キーコード (0x00-0x17)
1F9C                             ; 
1F9C                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
1F9C                             ;   最大 n 回スキャン、キー押下 → キーコード
1F9C                             ;   タイムアウト / ROM なし → nil
1F9C                             ; 
1F9C                             ; キーコード割り当て (KEYIN1/KEY 共通):
1F9C                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
1F9C                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
1F9C                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
1F9C                             ;                                           0x17: LOAD
1F9C                             ; ===============================================================
1F9C                SEND_GETKEY:      
1F9C                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
1F9C   3A 4E 17               LDA   send_argc   
1F9F   B7                     ORA   a   
1FA0   C2 1B 27               JNZ   send_getkey_timeout   
1FA3                             ; 
1FA3                             ; --- ブロッキング版 (引数なし) ---
1FA3   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
1FA6   B7                     ORA   a   
1FA7   CA C7 1F               JZ   getkey_no_key   ; ROM なし → -1
1FAA                             ; 
1FAA                             ; キー入力をポーリングしながら LFSR を回す。
1FAA                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
1FAA                             ; 乱数の種が毎回異なる。
1FAA                GETKEY_POLL:      
1FAA   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
1FAD   FE FF                  CPI   0FFh   
1FAF   C2 B8 1F               JNZ   getkey_got_key   
1FB2   CD 37 21               CALL   lfsr_next   ; 待機中に LFSR を進める
1FB5   C3 AA 1F               JMP   getkey_poll   
1FB8                             ; 
1FB8                GETKEY_GOT_KEY:      
1FB8                             ; キーコードを R[a] に返す
1FB8   4F                     MOV   c,a   
1FB9   06 00                  MVI   b,0   
1FBB   3A 4D 17               LDA   send_reg_a   
1FBE   CD 00 10               CALL   get_reg_addr   
1FC1   CD 10 10               CALL   set_slot_int16   
1FC4   C3 74 1D               JMP   vm_loop   
1FC7                             ; 
1FC7                GETKEY_NO_KEY:      
1FC7   3A 4D 17               LDA   send_reg_a   
1FCA   CD 00 10               CALL   get_reg_addr   
1FCD   06 FF                  MVI   b,0FFh   
1FCF   0E FF                  MVI   c,0FFh   ; -1
1FD1   CD 10 10               CALL   set_slot_int16   
1FD4   C3 74 1D               JMP   vm_loop   
1FD7                             ; 
1FD7                             ; ===============================================================
1FD7                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
1FD7                             ; 
1FD7                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
1FD7                             ; E レジスタにメソッド ID が入っている。
1FD7                             ; ===============================================================
1FD7                SEND_BUILTIN_EXT:      
1FD7   7B                     MOV   a,e   
1FD8   FE 1F                  CPI   METHOD_PUTS   
1FDA   CA FE 1F               JZ   send_puts   
1FDD   FE 20                  CPI   METHOD_SETSEG   
1FDF   CA A2 20               JZ   send_setseg   
1FE2   FE 21                  CPI   METHOD_RAND   
1FE4   CA 5C 21               JZ   send_rand   
1FE7   FE 12                  CPI   METHOD_LENGTH   
1FE9   CA 90 24               JZ   send_length   
1FEC   FE 14                  CPI   METHOD_CONCAT   
1FEE   CA A9 24               JZ   send_concat   
1FF1   FE 16                  CPI   METHOD_PUSH   
1FF3   CA 67 25               JZ   concat_array   ; push は concat_array と同じ
1FF6   FE 22                  CPI   METHOD_SLICE   
1FF8   CA 64 27               JZ   send_slice   
1FFB   C3 03 00               JMP   vm_error   ; 未対応メソッド
1FFE                             ; 
1FFE                             ; ===============================================================
1FFE                             ; send_puts — puts(value): 文字列を 7 セグに表示
1FFE                             ; 
1FFE                             ; R[a+1] が TT_STRING の場合:
1FFE                             ;   文字列データのアドレスから長さとバイト列を読み、
1FFE                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
1FFE                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
1FFE                             ; 
1FFE                             ; R[a+1] が TT_INTEGER の場合:
1FFE                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
1FFE                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
1FFE                             ; 
1FFE                             ; 使い方:
1FFE                             ;   puts "HELLO"          # 文字列を表示
1FFE                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
1FFE                             ; ===============================================================
1FFE                SEND_PUTS:      
1FFE   3A 4D 17               LDA   send_reg_a   
2001   3C                     INR   a   
2002   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2005   7E                     MOV   a,m   ; A = 型タグ
2006   FE 07                  CPI   TT_STRING   
2008   CA 42 20               JZ   puts_string   
200B                             ; TT_INTEGER: 従来のパック ASCII 処理
200B   FE 04                  CPI   TT_INTEGER   
200D   C2 03 00               JNZ   vm_error   
2010                             ; 
2010                             ; --- 整数パス (2 文字スクロール表示) ---
2010   3A 4D 17               LDA   send_reg_a   
2013   3C                     INR   a   
2014   CD 00 10               CALL   get_reg_addr   
2017   CD 32 10               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
201A   4E                     MOV   c,m   ; C = val_lo (右の文字)
201B   23                     INX   h   
201C   46                     MOV   b,m   ; B = val_hi (左の文字)
201D   C5                     PUSH   b   
201E                             ; 
201E                             ; 表示バッファを左に 2 桁スクロール
201E   21 FA FF               LXI   h,DISPLAY_BASE + 2   
2021   11 F8 FF               LXI   d,DISPLAY_BASE   
2024   06 06                  MVI   b,6   
2026                PUTS_SCROLL:      
2026   7E                     MOV   a,m   
2027   12                     STAX   d   
2028   23                     INX   h   
2029   13                     INX   d   
202A   05                     DCR   b   
202B   C2 26 20               JNZ   puts_scroll   
202E                             ; 
202E   C1                     POP   b   
202F   C5                     PUSH   b   
2030   78                     MOV   a,b   
2031   CD DB 20               CALL   ascii_to_seg   
2034   32 FE FF               STA   DISPLAY_BASE + 6   
2037                             ; 
2037   C1                     POP   b   
2038   79                     MOV   a,c   
2039   CD DB 20               CALL   ascii_to_seg   
203C   32 FF FF               STA   DISPLAY_BASE + 7   
203F   C3 8F 20               JMP   puts_ret_nil   
2042                             ; 
2042                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
2042                PUTS_STRING:      
2042   3A 4D 17               LDA   send_reg_a   
2045   3C                     INR   a   
2046   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2049   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロットアドレス
204C                             ; 
204C                             ; +1: count (文字列長)
204C   23                     INX   h   
204D   7E                     MOV   a,m   ; A = 文字列長
204E   B7                     ORA   a   
204F   CA 8F 20               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
2052   FE 09                  CPI   9   
2054   DA 59 20               JC   sp_len_ok   
2057   3E 08                  MVI   a,8   ; 最大 8 文字
2059                SP_LEN_OK:      
2059   32 9D 20               STA   sp_count   
205C   23                     INX   h   ; HL → データ領域先頭
205D   22 9E 20               SHLD   sp_src   ; 文字列ソースポインタ退避
2060                             ; 
2060                             ; 表示バッファ全体をクリア
2060   21 F8 FF               LXI   h,DISPLAY_BASE   
2063   0E 08                  MVI   c,DISPLAY_SIZE   
2065                PUTS_STR_CLEAR:      
2065   36 00                  MVI   m,0   
2067   23                     INX   h   
2068   0D                     DCR   c   
2069   C2 65 20               JNZ   puts_str_clear   
206C                             ; 
206C                             ; 文字列の各バイトを変換して表示
206C   21 F8 FF               LXI   h,DISPLAY_BASE   
206F   22 A0 20               SHLD   sp_dst   ; 表示書き込みポインタ
2072                PUTS_STR_LOOP:      
2072   2A 9E 20               LHLD   sp_src   
2075   7E                     MOV   a,m   ; A = ASCII コード
2076   23                     INX   h   
2077   22 9E 20               SHLD   sp_src   
207A   CD DB 20               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
207D   2A A0 20               LHLD   sp_dst   
2080   77                     MOV   m,a   
2081   23                     INX   h   
2082   22 A0 20               SHLD   sp_dst   
2085   3A 9D 20               LDA   sp_count   
2088   3D                     DCR   a   
2089   32 9D 20               STA   sp_count   
208C   C2 72 20               JNZ   puts_str_loop   
208F                             ; 
208F                PUTS_RET_NIL:      
208F   3A 4D 17               LDA   send_reg_a   
2092   CD 00 10               CALL   get_reg_addr   
2095   3E 01                  MVI   a,TT_NIL   
2097   CD 1A 10               CALL   set_slot_special   
209A   C3 74 1D               JMP   vm_loop   
209D                             ; 
209D   00           SP_COUNT:   DB   0   
209E   00 00        SP_SRC:   DW   0   
20A0   00 00        SP_DST:   DW   0   
20A2                             ; 
20A2                             ; ===============================================================
20A2                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
20A2                             ; 
20A2                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
20A2                             ; ===============================================================
20A2                SEND_SETSEG:      
20A2                             ; 桁位置を取得
20A2   3A 4D 17               LDA   send_reg_a   
20A5   3C                     INR   a   
20A6   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
20A9   CD 32 10               CALL   slot_to_value   
20AC   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
20AD   FE 08                  CPI   DISPLAY_SIZE   
20AF   D2 03 00               JNC   vm_error   ; 桁位置 >= 8 → エラー
20B2   32 DA 20               STA   ss_pos   
20B5                             ; 
20B5                             ; パターンを取得
20B5   3A 4D 17               LDA   send_reg_a   
20B8   3C                     INR   a   
20B9   3C                     INR   a   
20BA   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
20BD   CD 32 10               CALL   slot_to_value   
20C0   46                     MOV   b,m   ; B = パターン (val_lo)
20C1                             ; 
20C1                             ; DISPLAY_BASE + pos にパターンを書く
20C1   3A DA 20               LDA   ss_pos   
20C4   6F                     MOV   l,a   
20C5   26 00                  MVI   h,0   
20C7   11 F8 FF               LXI   d,DISPLAY_BASE   
20CA   19                     DAD   d   ; HL = DISPLAY_BASE + pos
20CB   70                     MOV   m,b   
20CC                             ; 
20CC                             ; R[a] に nil を返す
20CC   3A 4D 17               LDA   send_reg_a   
20CF   CD 00 10               CALL   get_reg_addr   
20D2   3E 01                  MVI   a,TT_NIL   
20D4   CD 1A 10               CALL   set_slot_special   
20D7   C3 74 1D               JMP   vm_loop   
20DA                             ; 
20DA   00           SS_POS:   DB   0   
20DB                             ; 
20DB                             ; ===============================================================
20DB                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
20DB                             ; 
20DB                             ;   入力: A = ASCII コード
20DB                             ;   出力: A = セグメントパターン
20DB                             ;   破壊: HL, BC
20DB                             ; 
20DB                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
20DB                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
20DB                             ; 範囲外はブランク (0x00) を返す。
20DB                             ; ===============================================================
20DB                ASCII_TO_SEG:      
20DB   FE 60                  CPI   60h   
20DD   DA E2 20               JC   ats_no_fold   
20E0   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
20E2                ATS_NO_FOLD:      
20E2   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
20E4   DA F5 20               JC   ats_blank   ; 元が < 0x20 → ブランク
20E7   FE 40                  CPI   40h   
20E9   D2 F5 20               JNC   ats_blank   ; >= 64 → ブランク
20EC                             ; テーブル参照
20EC   6F                     MOV   l,a   
20ED   26 00                  MVI   h,0   
20EF   01 F7 20               LXI   b,ascii_seg_table   
20F2   09                     DAD   b   ; HL = ascii_seg_table + index
20F3   7E                     MOV   a,m   
20F4   C9                     RET      
20F5                ATS_BLANK:      
20F5   AF                     XRA   a   ; A = 0 (ブランク)
20F6   C9                     RET      
20F7                             ; 
20F7                             ; ===============================================================
20F7                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
20F7                             ; 
20F7                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
20F7                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
20F7                             ; 
20F7                             ; セグメント配置:
20F7                             ;     aaa        bit 0 = a (上)
20F7                             ;    f   b       bit 1 = b (右上)
20F7                             ;     ggg        bit 2 = c (右下)
20F7                             ;    e   c       bit 3 = d (下)
20F7                             ;     ddd        bit 4 = e (左下)
20F7                             ;                bit 5 = f (左上)
20F7                             ;                bit 6 = g (中)
20F7                             ; 
20F7                             ; 表現できない文字は 0x00 (消灯)。
20F7                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
20F7                             ; ===============================================================
20F7                ASCII_SEG_TABLE:      
20F7                             ; 0x20-0x2F: 記号
20F7   00                     DB   00h   ; 0x20 " " (スペース)
20F8   06                     DB   06h   ; 0x21 "!" (bc)
20F9   22                     DB   22h   ; 0x22 """ (bf)
20FA   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
20FB   6D                     DB   6Dh   ; 0x24 "$" (= S)
20FC   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
20FD   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
20FE   02                     DB   02h   ; 0x27 "'" (b)
20FF   39                     DB   39h   ; 0x28 "(" (= C)
2100   0F                     DB   0Fh   ; 0x29 ")" (abcd)
2101   49                     DB   49h   ; 0x2A "*" (adg = 三)
2102   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
2103   04                     DB   04h   ; 0x2C "," (c)
2104   40                     DB   40h   ; 0x2D "-" (g)
2105   08                     DB   08h   ; 0x2E "." (d)
2106   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
2107                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
2107   5C                     DB   5Ch   ; 0x30 "0"
2108   06                     DB   06h   ; 0x31 "1"
2109   5B                     DB   5Bh   ; 0x32 "2"
210A   4F                     DB   4Fh   ; 0x33 "3"
210B   66                     DB   66h   ; 0x34 "4"
210C   6D                     DB   6Dh   ; 0x35 "5"
210D   7D                     DB   7Dh   ; 0x36 "6"
210E   27                     DB   27h   ; 0x37 "7"
210F   7F                     DB   7Fh   ; 0x38 "8"
2110   6F                     DB   6Fh   ; 0x39 "9"
2111                             ; 0x3A-0x40: 記号
2111   09                     DB   09h   ; 0x3A ":" (ad)
2112   00                     DB   00h   ; 0x3B ";"
2113   00                     DB   00h   ; 0x3C "<"
2114   48                     DB   48h   ; 0x3D "=" (dg)
2115   00                     DB   00h   ; 0x3E ">"
2116   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
2117   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
2118                             ; 0x41-0x5A: 英字
2118   77                     DB   77h   ; 0x41 "A" (abcefg)
2119   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
211A   39                     DB   39h   ; 0x43 "C" (adef)
211B   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
211C   79                     DB   79h   ; 0x45 "E" (adefg)
211D   71                     DB   71h   ; 0x46 "F" (aefg)
211E   3D                     DB   3Dh   ; 0x47 "G" (acdef)
211F   76                     DB   76h   ; 0x48 "H" (bcefg)
2120   06                     DB   06h   ; 0x49 "I" (bc)
2121   1E                     DB   1Eh   ; 0x4A "J" (bcde)
2122   74                     DB   74h   ; 0x4B "K" (cefg = h)
2123   38                     DB   38h   ; 0x4C "L" (def)
2124   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
2125   54                     DB   54h   ; 0x4E "N" (ceg = n)
2126   5C                     DB   5Ch   ; 0x4F "O" (= 0)
2127   73                     DB   73h   ; 0x50 "P" (abefg)
2128   67                     DB   67h   ; 0x51 "Q" (abcfg)
2129   50                     DB   50h   ; 0x52 "R" (eg = r)
212A   6D                     DB   6Dh   ; 0x53 "S" (= 5)
212B   78                     DB   78h   ; 0x54 "T" (defg = t)
212C   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
212D   3E                     DB   3Eh   ; 0x56 "V" (= U)
212E   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
212F   76                     DB   76h   ; 0x58 "X" (bcefg = H)
2130   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
2131   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
2132                             ; 0x5B-0x5F: 記号
2132   39                     DB   39h   ; 0x5B "[" (= C)
2133   00                     DB   00h   ; 0x5C "\"
2134   0F                     DB   0Fh   ; 0x5D "]" (= ))
2135   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
2136   08                     DB   08h   ; 0x5F "_" (d)
2137                             ; 
2137                             ; ===============================================================
2137                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
2137                             ; 
2137                             ;   入力: なし
2137                             ;   出力: HL = 新しい乱数値
2137                             ;   破壊: A, HL
2137                             ; 
2137                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
2137                             ; 周期: 65535
2137                             ; ===============================================================
2137                LFSR_NEXT:      
2137   2A 5A 21               LHLD   lfsr_state   
213A   7D                     MOV   a,l   
213B   E6 01                  ANI   1   ; LSB チェック
213D   CA 4F 21               JZ   lfsr_no_tap   
2140                             ; LSB=1: 右シフト + XOR タップ
2140   7C                     MOV   a,h   
2141   B7                     ORA   a   ; CY=0 クリア
2142   1F                     RAR      
2143   67                     MOV   h,a   
2144   7D                     MOV   a,l   
2145   1F                     RAR      
2146   6F                     MOV   l,a   
2147   7C                     MOV   a,h   
2148   EE B4                  XRI   0B4h   
214A   67                     MOV   h,a   
214B   22 5A 21               SHLD   lfsr_state   
214E   C9                     RET      
214F                LFSR_NO_TAP:      
214F                             ; LSB=0: 右シフトのみ
214F   7C                     MOV   a,h   
2150   B7                     ORA   a   
2151   1F                     RAR      
2152   67                     MOV   h,a   
2153   7D                     MOV   a,l   
2154   1F                     RAR      
2155   6F                     MOV   l,a   
2156   22 5A 21               SHLD   lfsr_state   
2159   C9                     RET      
215A                             ; 
215A   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
215C                             ; 
215C                             ; ===============================================================
215C                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
215C                             ; 
215C                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
215C                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
215C                             ; ===============================================================
215C                SEND_RAND:      
215C                             ; R[a+1] から n を取得
215C   3A 4D 17               LDA   send_reg_a   
215F   3C                     INR   a   
2160   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2163   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
2166   5E                     MOV   e,m   
2167   23                     INX   h   
2168   56                     MOV   d,m   ; DE = n
2169                             ; 
2169                             ; n == 0 チェック
2169   7A                     MOV   a,d   
216A   B3                     ORA   e   
216B   CA 86 21               JZ   rand_zero   
216E                             ; 
216E   D5                     PUSH   d   ; n を退避
216F   CD 37 21               CALL   lfsr_next   ; HL = 乱数
2172   44                     MOV   b,h   
2173   4D                     MOV   c,l   ; BC = 乱数 (被除数)
2174   D1                     POP   d   ; DE = n (除数)
2175   CD A5 12               CALL   udiv16   ; BC=商, HL=剰余
2178                             ; 
2178                             ; HL (剰余) → BC → R[a]
2178   44                     MOV   b,h   
2179   4D                     MOV   c,l   
217A   3A 4D 17               LDA   send_reg_a   
217D   CD 00 10               CALL   get_reg_addr   
2180   CD 10 10               CALL   set_slot_int16   
2183   C3 74 1D               JMP   vm_loop   
2186                             ; 
2186                RAND_ZERO:      
2186   06 00                  MVI   b,0   
2188   0E 00                  MVI   c,0   
218A   3A 4D 17               LDA   send_reg_a   
218D   CD 00 10               CALL   get_reg_addr   
2190   CD 10 10               CALL   set_slot_int16   
2193   C3 74 1D               JMP   vm_loop   
2196                             ; 
2196                             ; ===============================================================
2196                             ; コレクションプール基盤ルーチン
2196                             ; ===============================================================
2196                             ; 
2196                             ; ---------------------------------------------------------------
2196                             ; col_slot_addr — スロット番号からアドレスを計算
2196                             ; 
2196                             ;   入力: A = スロット番号 (0-based)
2196                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
2196                             ;   破壊: A, DE
2196                             ; ---------------------------------------------------------------
2196                COL_SLOT_ADDR:      
2196                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
2196                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
2196   6F                     MOV   l,a   
2197   26 00                  MVI   h,0   ; HL = slot_number
2199   29                     DAD   h   ; HL = slot_number × 2
219A   29                     DAD   h   ; HL = slot_number × 4
219B   54                     MOV   d,h   
219C   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
219D   29                     DAD   h   ; HL = slot_number × 8
219E   29                     DAD   h   ; HL = slot_number × 16
219F   29                     DAD   h   ; HL = slot_number × 32
21A0   19                     DAD   d   ; HL = slot_number × 36
21A1   11 C0 96               LXI   d,COLLECTION_POOL_BASE   
21A4   19                     DAD   d   
21A5   C9                     RET      
21A6                             ; 
21A6                             ; ---------------------------------------------------------------
21A6                             ; col_alloc — コレクションスロットを確保
21A6                             ; 
21A6                             ;   入力: なし
21A6                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
21A6                             ;   破壊: DE
21A6                             ;   エラー: プール満杯かつ GC で回収不可 → vm_error
21A6                             ; ---------------------------------------------------------------
21A6                COL_ALLOC:      
21A6   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
21A9   FE 40                  CPI   MAX_COL_SLOTS   
21AB   D2 11 28               JNC   col_gc_alloc   ; プール満杯 → GC 試行
21AE   F5                     PUSH   psw   ; スロット番号を退避
21AF   CD 96 21               CALL   col_slot_addr   ; HL = スロットアドレス
21B2                             ; COL_SP++
21B2   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
21B5   3C                     INR   a   
21B6   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
21B9   F1                     POP   psw   ; A = スロット番号
21BA   C9                     RET      
21BB                             ; 
21BB                             ; ---------------------------------------------------------------
21BB                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
21BB                             ; 
21BB                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
21BB                             ;   出力: HL = コレクションスロットアドレス
21BB                             ;   破壊: A, DE
21BB                             ; ---------------------------------------------------------------
21BB                COL_FROM_REG:      
21BB   CD 32 10               CALL   slot_to_value   ; HL = val アドレス
21BE   7E                     MOV   a,m   ; A = val_lo = slot+1
21BF   3D                     DCR   a   ; A = slot_number (0-based)
21C0   C3 96 21               JMP   col_slot_addr   
21C3                             ; 
21C3                             ; ===============================================================
21C3                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
21C3                             ; 
21C3                             ; R[a] の型で分岐:
21C3                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
21C3                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
21C3                             ; ===============================================================
21C3                DO_OP_GETIDX:      
21C3   CD C0 10               CALL   fetch_byte   ; A = a
21C6   32 66 22               STA   gidx_reg_a   
21C9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
21CC   7E                     MOV   a,m   ; A = 型タグ
21CD   FE 07                  CPI   TT_STRING   
21CF   CA DF 21               JZ   gidx_string   
21D2   FE 08                  CPI   TT_ARRAY   
21D4   CA 2B 22               JZ   gidx_array   
21D7   FE 09                  CPI   TT_HASH   
21D9   CA 18 26               JZ   gidx_hash   
21DC   C3 03 00               JMP   vm_error   
21DF                             ; 
21DF                GIDX_STRING:      
21DF                             ; R[a] のコレクションスロットを取得
21DF   3A 66 22               LDA   gidx_reg_a   
21E2   CD 00 10               CALL   get_reg_addr   
21E5   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
21E8   23                     INX   h   ; +1: count
21E9   46                     MOV   b,m   ; B = 文字列長
21EA   23                     INX   h   ; HL → データ領域先頭
21EB   22 67 22               SHLD   gidx_data_addr   
21EE                             ; 
21EE                             ; R[a+1] からインデックスを取得
21EE   3A 66 22               LDA   gidx_reg_a   
21F1   3C                     INR   a   
21F2   CD 00 10               CALL   get_reg_addr   
21F5   CD 32 10               CALL   slot_to_value   
21F8   7E                     MOV   a,m   ; A = index (val_lo)
21F9                             ; 範囲チェック: index < 文字列長
21F9   B8                     CMP   b   
21FA   D2 03 00               JNC   vm_error   ; index >= 長さ → エラー
21FD                             ; データ先頭 + index で 1 文字を取得
21FD   5F                     MOV   e,a   
21FE   16 00                  MVI   d,0   
2200   2A 67 22               LHLD   gidx_data_addr   
2203   19                     DAD   d   ; HL = &data[index]
2204   4E                     MOV   c,m   ; C = 文字コード
2205                             ; 
2205                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
2205   C5                     PUSH   b   ; C = 文字コード退避
2206   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2209   32 69 22               STA   gidx_new_slot   
220C   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
220E   23                     INX   h   
220F   36 01                  MVI   m,1   ; +1: count = 1
2211   23                     INX   h   
2212   C1                     POP   b   
2213   71                     MOV   m,c   ; +2: data[0] = 文字コード
2214                             ; 
2214                             ; R[a] = TT_STRING, val_lo = new_slot+1
2214   3A 66 22               LDA   gidx_reg_a   
2217   CD 00 10               CALL   get_reg_addr   
221A   36 07                  MVI   m,TT_STRING   
221C   23                     INX   h   
221D   36 00                  MVI   m,0   
221F   23                     INX   h   
2220   3A 69 22               LDA   gidx_new_slot   
2223   3C                     INR   a   
2224   77                     MOV   m,a   
2225   23                     INX   h   
2226   36 00                  MVI   m,0   
2228   C3 74 1D               JMP   vm_loop   
222B                             ; 
222B                GIDX_ARRAY:      
222B                             ; R[a] のコレクションスロットを取得
222B   3A 66 22               LDA   gidx_reg_a   
222E   CD 00 10               CALL   get_reg_addr   
2231   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
2234   23                     INX   h   ; +1: count
2235   46                     MOV   b,m   ; B = 要素数
2236   23                     INX   h   ; HL → データ領域先頭
2237   22 67 22               SHLD   gidx_data_addr   
223A                             ; 
223A                             ; R[a+1] からインデックスを取得
223A   3A 66 22               LDA   gidx_reg_a   
223D   3C                     INR   a   
223E   CD 00 10               CALL   get_reg_addr   
2241   CD 32 10               CALL   slot_to_value   
2244   7E                     MOV   a,m   ; A = index (val_lo)
2245                             ; 範囲チェック: index < 要素数
2245   B8                     CMP   b   
2246   D2 03 00               JNC   vm_error   
2249                             ; data + index * 4 で要素スロットの先頭を求める
2249   87                     ADD   a   ; ×2
224A   87                     ADD   a   ; ×4
224B   5F                     MOV   e,a   
224C   16 00                  MVI   d,0   
224E   2A 67 22               LHLD   gidx_data_addr   
2251   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
2252   EB                     XCHG      ; DE = &data[index * 4]
2253                             ; 
2253                             ; R[a] にコピー (4 バイト)
2253   3A 66 22               LDA   gidx_reg_a   
2256   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
2259   0E 04                  MVI   c,SLOT_BYTES   
225B                GIDX_ARY_COPY:      
225B   1A                     LDAX   d   
225C   77                     MOV   m,a   
225D   23                     INX   h   
225E   13                     INX   d   
225F   0D                     DCR   c   
2260   C2 5B 22               JNZ   gidx_ary_copy   
2263   C3 74 1D               JMP   vm_loop   
2266                             ; 
2266   00           GIDX_REG_A:   DB   0   
2267   00 00        GIDX_DATA_ADDR:   DW   0   
2269   00           GIDX_NEW_SLOT:   DB   0   
226A                             ; 
226A                             ; ===============================================================
226A                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
226A                             ; 
226A                             ; R[a] の型で分岐:
226A                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
226A                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
226A                             ; ===============================================================
226A                DO_OP_SETIDX:      
226A   CD C0 10               CALL   fetch_byte   ; A = a
226D   32 1D 23               STA   sidx_reg_a   
2270   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2273   7E                     MOV   a,m   ; A = 型タグ
2274   FE 07                  CPI   TT_STRING   
2276   CA 86 22               JZ   sidx_string   
2279   FE 08                  CPI   TT_ARRAY   
227B   CA E0 22               JZ   sidx_array   
227E   FE 09                  CPI   TT_HASH   
2280   CA 80 26               JZ   sidx_hash   
2283   C3 03 00               JMP   vm_error   
2286                             ; 
2286                SIDX_STRING:      
2286                             ; R[a] のコレクションスロットを取得
2286   3A 1D 23               LDA   sidx_reg_a   
2289   CD 00 10               CALL   get_reg_addr   
228C   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
228F   23                     INX   h   ; +1: count
2290   46                     MOV   b,m   ; B = 文字列長
2291   23                     INX   h   ; HL → データ領域先頭
2292   22 1E 23               SHLD   sidx_data_addr   
2295                             ; 
2295                             ; R[a+1] からインデックスを取得
2295   3A 1D 23               LDA   sidx_reg_a   
2298   3C                     INR   a   
2299   CD 00 10               CALL   get_reg_addr   
229C   CD 32 10               CALL   slot_to_value   
229F   7E                     MOV   a,m   ; A = index
22A0   B8                     CMP   b   
22A1   D2 03 00               JNC   vm_error   ; index >= 長さ
22A4                             ; 
22A4                             ; data[index] に R[a+2] の文字を書き込む
22A4   5F                     MOV   e,a   
22A5   16 00                  MVI   d,0   
22A7   2A 1E 23               LHLD   sidx_data_addr   
22AA   19                     DAD   d   ; HL = &data[index]
22AB                             ; 
22AB                             ; R[a+2] から文字コードを取得
22AB   3A 1D 23               LDA   sidx_reg_a   
22AE   3C                     INR   a   
22AF   3C                     INR   a   
22B0   CD 00 10               CALL   get_reg_addr   
22B3                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
22B3   7E                     MOV   a,m   ; 型タグ
22B4   FE 07                  CPI   TT_STRING   
22B6   CA C0 22               JZ   sidx_str_char   
22B9                             ; TT_INTEGER: val_lo を文字コードとして使う
22B9   CD 32 10               CALL   slot_to_value   
22BC   7E                     MOV   a,m   
22BD   C3 C6 22               JMP   sidx_write_char   
22C0                SIDX_STR_CHAR:      
22C0                             ; TT_STRING: コレクションスロットの先頭文字
22C0   CD BB 21               CALL   col_from_reg   
22C3   23                     INX   h   ; +1: count
22C4   23                     INX   h   ; +2: data[0]
22C5   7E                     MOV   a,m   
22C6                SIDX_WRITE_CHAR:      
22C6   2A 1E 23               LHLD   sidx_data_addr   
22C9   5F                     MOV   e,a   ; E = 文字コード
22CA   3A 1D 23               LDA   sidx_reg_a   
22CD   3C                     INR   a   
22CE   CD 00 10               CALL   get_reg_addr   
22D1   CD 32 10               CALL   slot_to_value   
22D4   7E                     MOV   a,m   ; A = index
22D5   4F                     MOV   c,a   
22D6   06 00                  MVI   b,0   
22D8   2A 1E 23               LHLD   sidx_data_addr   
22DB   09                     DAD   b   ; HL = &data[index]
22DC   73                     MOV   m,e   ; 書き込み
22DD   C3 74 1D               JMP   vm_loop   
22E0                             ; 
22E0                SIDX_ARRAY:      
22E0                             ; R[a] のコレクションスロットを取得
22E0   3A 1D 23               LDA   sidx_reg_a   
22E3   CD 00 10               CALL   get_reg_addr   
22E6   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
22E9   23                     INX   h   ; +1: count
22EA   46                     MOV   b,m   ; B = 要素数
22EB   23                     INX   h   ; HL → データ領域先頭
22EC   22 1E 23               SHLD   sidx_data_addr   
22EF                             ; 
22EF                             ; R[a+1] からインデックスを取得
22EF   3A 1D 23               LDA   sidx_reg_a   
22F2   3C                     INR   a   
22F3   CD 00 10               CALL   get_reg_addr   
22F6   CD 32 10               CALL   slot_to_value   
22F9   7E                     MOV   a,m   ; A = index
22FA   B8                     CMP   b   
22FB   D2 03 00               JNC   vm_error   
22FE                             ; 
22FE                             ; data[index * 4] に R[a+2] をコピー
22FE   87                     ADD   a   ; ×2
22FF   87                     ADD   a   ; ×4
2300   5F                     MOV   e,a   
2301   16 00                  MVI   d,0   
2303   2A 1E 23               LHLD   sidx_data_addr   
2306   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
2307   EB                     XCHG      ; DE = コピー先
2308                             ; 
2308                             ; R[a+2] を取得 (コピー元)
2308   3A 1D 23               LDA   sidx_reg_a   
230B   3C                     INR   a   
230C   3C                     INR   a   
230D   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
2310   0E 04                  MVI   c,SLOT_BYTES   
2312                SIDX_ARY_COPY:      
2312   7E                     MOV   a,m   
2313   12                     STAX   d   
2314   23                     INX   h   
2315   13                     INX   d   
2316   0D                     DCR   c   
2317   C2 12 23               JNZ   sidx_ary_copy   
231A   C3 74 1D               JMP   vm_loop   
231D                             ; 
231D   00           SIDX_REG_A:   DB   0   
231E   00 00        SIDX_DATA_ADDR:   DW   0   
2320                             ; 
2320                             ; ===============================================================
2320                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
2320                             ; 
2320                             ; b 個のレジスタからコレクションプールに配列を構築する。
2320                             ; ===============================================================
2320                DO_OP_ARRAY:      
2320   CD C0 10               CALL   fetch_byte   ; A = a
2323   32 97 23               STA   oary_reg_a   
2326   32 98 23               STA   oary_src_reg   ; BB 形式: ソース = a
2329   CD C0 10               CALL   fetch_byte   ; A = b (要素数)
232C                OA2_JOIN:      ; OP_ARRAY2 からの合流点
232C   32 99 23               STA   oary_count   
232F   B7                     ORA   a   
2330   CA 89 23               JZ   oary_empty   ; 空配列
2333                             ; 
2333                             ; 要素数チェック
2333   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2335   D2 03 00               JNC   vm_error   ; 要素数 > 7
2338                             ; 
2338                             ; コレクションスロットを確保
2338   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
233B   32 9A 23               STA   oary_slot_num   
233E   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
2340   23                     INX   h   
2341   3A 99 23               LDA   oary_count   
2344   77                     MOV   m,a   ; +1: count
2345   23                     INX   h   ; HL → データ領域先頭
2346   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
2347                             ; 
2347                             ; ソースレジスタから b 個のスロットをコピー
2347   3A 98 23               LDA   oary_src_reg   
234A   47                     MOV   b,a   ; B = 現在のレジスタ番号
234B   3A 99 23               LDA   oary_count   
234E   4F                     MOV   c,a   ; C = 残り要素数
234F                OARY_COPY_LOOP:      
234F   3E 04                  MVI   a,SLOT_BYTES   
2351   32 9B 23               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
2354   C5                     PUSH   b   
2355   D5                     PUSH   d   
2356   78                     MOV   a,b   
2357   CD 00 10               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
235A   D1                     POP   d   
235B                OARY_COPY_ELEM:      
235B   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
235C   23                     INX   h   
235D   78                     MOV   a,b   
235E   12                     STAX   d   
235F   13                     INX   d   
2360   E5                     PUSH   h   
2361   21 9B 23               LXI   h,oary_elem_cnt   
2364   35                     DCR   m   
2365   E1                     POP   h   
2366   C2 5B 23               JNZ   oary_copy_elem   
2369   C1                     POP   b   
236A   04                     INR   b   ; 次のレジスタ
236B   0D                     DCR   c   
236C   CA 72 23               JZ   oary_done   
236F   C3 4F 23               JMP   oary_copy_loop   
2372                             ; 
2372                OARY_DONE:      
2372                             ; R[a] = TT_ARRAY, val_lo = slot+1
2372   3A 97 23               LDA   oary_reg_a   
2375   CD 00 10               CALL   get_reg_addr   
2378   36 08                  MVI   m,TT_ARRAY   
237A   23                     INX   h   
237B   36 00                  MVI   m,0   
237D   23                     INX   h   
237E   3A 9A 23               LDA   oary_slot_num   
2381   3C                     INR   a   
2382   77                     MOV   m,a   
2383   23                     INX   h   
2384   36 00                  MVI   m,0   
2386   C3 74 1D               JMP   vm_loop   
2389                             ; 
2389                OARY_EMPTY:      
2389                             ; 空配列: スロット確保して count=0
2389   CD A6 21               CALL   col_alloc   
238C   32 9A 23               STA   oary_slot_num   
238F   36 02                  MVI   m,COL_TYPE_ARRAY   
2391   23                     INX   h   
2392   36 00                  MVI   m,0   ; count = 0
2394   C3 72 23               JMP   oary_done   
2397                             ; 
2397   00           OARY_REG_A:   DB   0   
2398   00           OARY_SRC_REG:   DB   0   
2399   00           OARY_COUNT:   DB   0   
239A   00           OARY_SLOT_NUM:   DB   0   
239B   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
239C                             ; 
239C                             ; ===============================================================
239C                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
239C                             ; 
239C                             ; R[a] の配列の末尾に要素を追加する。
239C                             ; ===============================================================
239C                DO_OP_ARYPUSH:      
239C   CD C0 10               CALL   fetch_byte   ; A = a
239F   32 10 24               STA   apush_reg_a   
23A2   CD C0 10               CALL   fetch_byte   ; A = b (追加する要素数)
23A5   32 11 24               STA   apush_add_count   
23A8                             ; 
23A8                             ; R[a] のコレクションスロットを取得
23A8   3A 10 24               LDA   apush_reg_a   
23AB   CD 00 10               CALL   get_reg_addr   
23AE   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
23B1   23                     INX   h   ; +1: count
23B2   7E                     MOV   a,m   ; A = 現在の要素数
23B3   32 12 24               STA   apush_cur_count   
23B6                             ; 容量チェック: count + add_count <= MAX
23B6   3A 11 24               LDA   apush_add_count   
23B9   47                     MOV   b,a   
23BA   3A 12 24               LDA   apush_cur_count   
23BD   80                     ADD   b   
23BE   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
23C0   D2 03 00               JNC   vm_error   ; オーバーフロー
23C3                             ; 
23C3                             ; 書き込み先: data + count * 4
23C3   3A 12 24               LDA   apush_cur_count   
23C6   87                     ADD   a   ; ×2
23C7   87                     ADD   a   ; ×4
23C8   5F                     MOV   e,a   
23C9   16 00                  MVI   d,0   
23CB   23                     INX   h   ; HL → データ領域先頭
23CC   19                     DAD   d   ; HL = 書き込み位置
23CD   EB                     XCHG      ; DE = 書き込み位置
23CE                             ; 
23CE                             ; R[a+1] から b 個のスロットをコピー
23CE   3A 10 24               LDA   apush_reg_a   
23D1   3C                     INR   a   
23D2   47                     MOV   b,a   ; B = 現在のレジスタ番号
23D3   3A 11 24               LDA   apush_add_count   
23D6   4F                     MOV   c,a   ; C = 残り要素数
23D7                APUSH_LOOP:      
23D7   3E 04                  MVI   a,SLOT_BYTES   
23D9   32 13 24               STA   apush_byte_cnt   ; 毎回初期化
23DC   C5                     PUSH   b   
23DD   D5                     PUSH   d   
23DE   78                     MOV   a,b   
23DF   CD 00 10               CALL   get_reg_addr   ; HL = R[reg]
23E2   D1                     POP   d   
23E3                APUSH_COPY:      
23E3   46                     MOV   b,m   
23E4   78                     MOV   a,b   
23E5   12                     STAX   d   
23E6   23                     INX   h   
23E7   13                     INX   d   
23E8   E5                     PUSH   h   
23E9   21 13 24               LXI   h,apush_byte_cnt   
23EC   35                     DCR   m   
23ED   E1                     POP   h   
23EE   C2 E3 23               JNZ   apush_copy   
23F1   C1                     POP   b   
23F2   04                     INR   b   
23F3   0D                     DCR   c   
23F4   CA FA 23               JZ   apush_done   
23F7   C3 D7 23               JMP   apush_loop   
23FA                             ; 
23FA                APUSH_DONE:      
23FA                             ; count を更新
23FA   3A 10 24               LDA   apush_reg_a   
23FD   CD 00 10               CALL   get_reg_addr   
2400   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
2403   23                     INX   h   ; +1: count
2404   3A 12 24               LDA   apush_cur_count   
2407   47                     MOV   b,a   
2408   3A 11 24               LDA   apush_add_count   
240B   80                     ADD   b   
240C   77                     MOV   m,a   ; count = old + added
240D   C3 74 1D               JMP   vm_loop   
2410                             ; 
2410   00           APUSH_REG_A:   DB   0   
2411   00           APUSH_ADD_COUNT:   DB   0   
2412   00           APUSH_CUR_COUNT:   DB   0   
2413   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
2414                             ; 
2414                             ; ===============================================================
2414                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
2414                             ; 
2414                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
2414                             ; ===============================================================
2414                DO_OP_STRCAT:      
2414   CD C0 10               CALL   fetch_byte   ; A = a
2417   32 8A 24               STA   scat_reg_a   
241A                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
241A                             ; 
241A                             ; R[a+1] のコレクションスロット (ソース)
241A   3C                     INR   a   
241B   CD 00 10               CALL   get_reg_addr   
241E   CD BB 21               CALL   col_from_reg   ; HL = ソーススロット
2421   23                     INX   h   ; +1: count
2422   7E                     MOV   a,m   ; A = ソース文字列長
2423   32 8B 24               STA   scat_src_len   
2426   23                     INX   h   ; HL → データ先頭
2427   22 8E 24               SHLD   scat_src_data   
242A                             ; 
242A                             ; R[a] のコレクションスロット (デスト)
242A   3A 8A 24               LDA   scat_reg_a   
242D   CD 00 10               CALL   get_reg_addr   
2430   CD BB 21               CALL   col_from_reg   ; HL = デストスロット
2433   23                     INX   h   ; +1: count
2434   7E                     MOV   a,m   ; A = デスト文字列長
2435   32 8C 24               STA   scat_dst_len   
2438                             ; 
2438                             ; 合計長チェック
2438   3A 8B 24               LDA   scat_src_len   
243B   47                     MOV   b,a   
243C   3A 8C 24               LDA   scat_dst_len   
243F   80                     ADD   b   
2440   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2442   DA 5A 24               JC   scat_len_ok   
2445                             ; 切り詰め: 追記できる分だけ
2445   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2447   47                     MOV   b,a   
2448   3A 8C 24               LDA   scat_dst_len   
244B   90                     SUB   b   ; この結果は負 (使わない)
244C   3E 22                  MVI   a,COL_MAX_STRING_LEN   
244E   47                     MOV   b,a   
244F   3A 8C 24               LDA   scat_dst_len   
2452   4F                     MOV   c,a   
2453   78                     MOV   a,b   
2454   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
2455   32 8B 24               STA   scat_src_len   
2458                             ; 合計を MAX に
2458   3E 22                  MVI   a,COL_MAX_STRING_LEN   
245A                SCAT_LEN_OK:      
245A   32 8D 24               STA   scat_total_len   
245D                             ; 
245D                             ; デスト count を更新
245D   3A 8A 24               LDA   scat_reg_a   
2460   CD 00 10               CALL   get_reg_addr   
2463   CD BB 21               CALL   col_from_reg   
2466   23                     INX   h   
2467   3A 8D 24               LDA   scat_total_len   
246A   77                     MOV   m,a   ; count = 合計長
246B   23                     INX   h   ; HL → データ先頭
246C                             ; 
246C                             ; デストデータ末尾 = data + dst_len
246C   3A 8C 24               LDA   scat_dst_len   
246F   5F                     MOV   e,a   
2470   16 00                  MVI   d,0   
2472   19                     DAD   d   ; HL = 書き込み位置
2473                             ; 
2473                             ; ソースデータをコピー
2473   EB                     XCHG      ; DE = 書き込み位置
2474   2A 8E 24               LHLD   scat_src_data   ; HL = ソースデータ
2477   3A 8B 24               LDA   scat_src_len   
247A   B7                     ORA   a   
247B   CA 87 24               JZ   scat_done   
247E   4F                     MOV   c,a   
247F                SCAT_COPY:      
247F   7E                     MOV   a,m   
2480   12                     STAX   d   
2481   23                     INX   h   
2482   13                     INX   d   
2483   0D                     DCR   c   
2484   C2 7F 24               JNZ   scat_copy   
2487                             ; 
2487                SCAT_DONE:      
2487   C3 74 1D               JMP   vm_loop   
248A                             ; 
248A   00           SCAT_REG_A:   DB   0   
248B   00           SCAT_SRC_LEN:   DB   0   
248C   00           SCAT_DST_LEN:   DB   0   
248D   00           SCAT_TOTAL_LEN:   DB   0   
248E   00 00        SCAT_SRC_DATA:   DW   0   
2490                             ; 
2490                             ; ===============================================================
2490                             ; send_length — length / size: 文字列長・配列長を返す
2490                             ; 
2490                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
2490                             ; ===============================================================
2490                SEND_LENGTH:      
2490   3A 4D 17               LDA   send_reg_a   
2493   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2496   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
2499   23                     INX   h   ; +1: count
249A   4E                     MOV   c,m   ; C = count
249B   06 00                  MVI   b,0   ; BC = count (16-bit)
249D   3A 4D 17               LDA   send_reg_a   
24A0   CD 00 10               CALL   get_reg_addr   
24A3   CD 10 10               CALL   set_slot_int16   ; R[a] = count
24A6   C3 74 1D               JMP   vm_loop   
24A9                             ; 
24A9                             ; ===============================================================
24A9                             ; send_concat — << (文字列追記 / 配列追加)
24A9                             ; 
24A9                             ; R[a] の型で分岐:
24A9                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
24A9                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
24A9                             ; ===============================================================
24A9                SEND_CONCAT:      
24A9   3A 4D 17               LDA   send_reg_a   
24AC   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
24AF   7E                     MOV   a,m   ; A = 型タグ
24B0   FE 07                  CPI   TT_STRING   
24B2   CA BD 24               JZ   concat_string   
24B5   FE 08                  CPI   TT_ARRAY   
24B7   CA 67 25               JZ   concat_array   
24BA   C3 03 00               JMP   vm_error   
24BD                             ; 
24BD                CONCAT_STRING:      
24BD                             ; R[a+1] の型を確認
24BD   3A 4D 17               LDA   send_reg_a   
24C0   3C                     INR   a   
24C1   CD 00 10               CALL   get_reg_addr   
24C4   7E                     MOV   a,m   ; A = R[a+1] の型タグ
24C5   FE 07                  CPI   TT_STRING   
24C7   CA D2 24               JZ   concat_str_str   
24CA   FE 04                  CPI   TT_INTEGER   
24CC   CA 42 25               JZ   concat_str_int   
24CF   C3 03 00               JMP   vm_error   
24D2                             ; 
24D2                CONCAT_STR_STR:      
24D2                             ; R[a+1] のコレクションスロット (ソース)
24D2   3A 4D 17               LDA   send_reg_a   
24D5   3C                     INR   a   
24D6   CD 00 10               CALL   get_reg_addr   
24D9   CD BB 21               CALL   col_from_reg   ; HL = ソーススロット
24DC   23                     INX   h   ; +1: count
24DD   7E                     MOV   a,m   ; A = ソース文字列長
24DE   32 20 80               STA   cc_src_len   
24E1   23                     INX   h   ; HL → データ先頭
24E2   22 23 80               SHLD   cc_src_data   
24E5                             ; 
24E5                             ; R[a] のコレクションスロット (デスト)
24E5   3A 4D 17               LDA   send_reg_a   
24E8   CD 00 10               CALL   get_reg_addr   
24EB   CD BB 21               CALL   col_from_reg   ; HL = デストスロット
24EE   23                     INX   h   ; +1: count
24EF   7E                     MOV   a,m   
24F0   32 21 80               STA   cc_dst_len   
24F3                             ; 
24F3                             ; コピー可能バイト数を計算
24F3   3A 20 80               LDA   cc_src_len   
24F6   47                     MOV   b,a   
24F7   3A 21 80               LDA   cc_dst_len   
24FA   80                     ADD   b   
24FB   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
24FD   DA 12 25               JC   cc_str_len_ok   
2500                             ; 切り詰め
2500   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2502   47                     MOV   b,a   
2503   3A 21 80               LDA   cc_dst_len   
2506   4F                     MOV   c,a   
2507   78                     MOV   a,b   
2508   91                     SUB   c   
2509   32 20 80               STA   cc_src_len   
250C   3A 21 80               LDA   cc_dst_len   
250F   87                     ADD   a   ; ここでは使わない — 合計は MAX
2510   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2512                CC_STR_LEN_OK:      
2512   32 22 80               STA   cc_total_len   
2515                             ; 
2515                             ; count を更新
2515   3A 4D 17               LDA   send_reg_a   
2518   CD 00 10               CALL   get_reg_addr   
251B   CD BB 21               CALL   col_from_reg   
251E   23                     INX   h   
251F   3A 22 80               LDA   cc_total_len   
2522   77                     MOV   m,a   
2523   23                     INX   h   ; HL → データ先頭
2524                             ; 
2524                             ; 書き込み位置 = data + dst_len
2524   3A 21 80               LDA   cc_dst_len   
2527   5F                     MOV   e,a   
2528   16 00                  MVI   d,0   
252A   19                     DAD   d   
252B                             ; 
252B                             ; コピー
252B   EB                     XCHG      
252C   2A 23 80               LHLD   cc_src_data   
252F   3A 20 80               LDA   cc_src_len   
2532   B7                     ORA   a   
2533   CA 3F 25               JZ   cc_str_done   
2536   4F                     MOV   c,a   
2537                CC_STR_COPY:      
2537   7E                     MOV   a,m   
2538   12                     STAX   d   
2539   23                     INX   h   
253A   13                     INX   d   
253B   0D                     DCR   c   
253C   C2 37 25               JNZ   cc_str_copy   
253F                CC_STR_DONE:      
253F                             ; R[a] をそのまま返す (破壊的操作)
253F   C3 74 1D               JMP   vm_loop   
2542                             ; 
2542                CONCAT_STR_INT:      
2542                             ; R[a+1] の val_lo を 1 バイトとして追記
2542   3A 4D 17               LDA   send_reg_a   
2545   3C                     INR   a   
2546   CD 00 10               CALL   get_reg_addr   
2549   CD 32 10               CALL   slot_to_value   
254C   4E                     MOV   c,m   ; C = 文字コード (val_lo)
254D                             ; 
254D                             ; R[a] のコレクションスロット
254D   3A 4D 17               LDA   send_reg_a   
2550   CD 00 10               CALL   get_reg_addr   
2553   CD BB 21               CALL   col_from_reg   ; HL = デストスロット
2556   23                     INX   h   ; +1: count
2557   7E                     MOV   a,m   
2558   FE 22                  CPI   COL_MAX_STRING_LEN   
255A   D2 74 1D               JNC   vm_loop   ; 満杯なら何もしない
255D   34                     INR   m   ; count++
255E   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
255F   23                     INX   h   ; HL → データ先頭
2560   16 00                  MVI   d,0   
2562   19                     DAD   d   ; HL = &data[old_count]
2563   71                     MOV   m,c   ; 書き込み
2564   C3 74 1D               JMP   vm_loop   
2567                             ; 
2567                CONCAT_ARRAY:      
2567                             ; R[a] のコレクションスロット
2567   3A 4D 17               LDA   send_reg_a   
256A   CD 00 10               CALL   get_reg_addr   
256D   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
2570   23                     INX   h   ; +1: count
2571   7E                     MOV   a,m   
2572   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
2574   D2 03 00               JNC   vm_error   ; 満杯
2577   32 25 80               STA   cc_ary_count   
257A   34                     INR   m   ; count++
257B                             ; 
257B                             ; 書き込み位置: data + count * 4
257B   23                     INX   h   ; HL → データ先頭
257C   3A 25 80               LDA   cc_ary_count   
257F   87                     ADD   a   ; ×2
2580   87                     ADD   a   ; ×4
2581   5F                     MOV   e,a   
2582   16 00                  MVI   d,0   
2584   19                     DAD   d   ; HL = 書き込み位置
2585   EB                     XCHG      ; DE = 書き込み位置
2586                             ; 
2586                             ; R[a+1] をコピー
2586   3A 4D 17               LDA   send_reg_a   
2589   3C                     INR   a   
258A   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
258D   0E 04                  MVI   c,SLOT_BYTES   
258F                CC_ARY_COPY:      
258F   7E                     MOV   a,m   
2590   12                     STAX   d   
2591   23                     INX   h   
2592   13                     INX   d   
2593   0D                     DCR   c   
2594   C2 8F 25               JNZ   cc_ary_copy   
2597   C3 74 1D               JMP   vm_loop   
259A                             ; 
259A                             ; --- concat 一時変数 ---
259A                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
259A                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
259A                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
259A                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
259A                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
259A                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
259A                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
259A                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
259A                             ; 
259A                             ; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
259A                             ; 
259A                             ; Hash スロット形式 (コレクションプール 36B スロット内):
259A                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
259A                             ;   +1: count (1B)  ペア数 (最大 4)
259A                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
259A                             ; 
259A                             ; キー検索は線形 4 バイト比較。
259A                             ; 
259A                             ; ===============================================================
259A                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
259A                             ; 
259A                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
259A                             ; ===============================================================
259A                DO_OP_ARRAY2:      
259A   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
259D   32 97 23               STA   oary_reg_a   
25A0   CD C0 10               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
25A3   32 98 23               STA   oary_src_reg   
25A6   CD C0 10               CALL   fetch_byte   ; A = c (要素数)
25A9   C3 2C 23               JMP   oa2_join   
25AC                             ; 
25AC                             ; ===============================================================
25AC                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
25AC                             ; 
25AC                             ;   a = 書き込み先レジスタ
25AC                             ;   b = ペア数 (0 = 空 Hash)
25AC                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
25AC                             ; ===============================================================
25AC                DO_OP_HASH:      
25AC   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
25AF   32 14 26               STA   hash_reg_a   
25B2   CD C0 10               CALL   fetch_byte   ; A = b (ペア数)
25B5   32 15 26               STA   hash_count   
25B8                             ; 
25B8                             ; コレクションスロット確保
25B8   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
25BB   32 16 26               STA   hash_slot_num   
25BE                             ; 
25BE                             ; ヘッダ書き込み
25BE   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
25C0   23                     INX   h   
25C1   3A 15 26               LDA   hash_count   
25C4   77                     MOV   m,a   ; +1: count
25C5   23                     INX   h   ; HL → データ領域先頭
25C6                             ; 
25C6                             ; ペアがなければ結果書き込みへ
25C6   3A 15 26               LDA   hash_count   
25C9   B7                     ORA   a   
25CA   CA FD 25               JZ   hash_write_result   
25CD                             ; 
25CD                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
25CD   3A 14 26               LDA   hash_reg_a   
25D0   32 17 26               STA   hash_src_reg   
25D3                             ; 
25D3                HASH_COPY_PAIR:      
25D3                             ; HL = コレクションプール内の書き込み位置
25D3                             ; key (4B) をコピー: R[src] → [HL]
25D3   E5                     PUSH   h   ; 書き込み先を退避
25D4   3A 17 26               LDA   hash_src_reg   
25D7   CD 00 10               CALL   get_reg_addr   ; HL = R[src]
25DA   D1                     POP   d   ; DE = 書き込み先
25DB   CD 25 10               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
25DE                             ; DE = value 書き込み位置
25DE                             ; 
25DE                             ; value (4B) をコピー: R[src+1] → [DE]
25DE   D5                     PUSH   d   ; value 書き込み先を退避
25DF   3A 17 26               LDA   hash_src_reg   
25E2   3C                     INR   a   
25E3   CD 00 10               CALL   get_reg_addr   ; HL = R[src+1]
25E6   D1                     POP   d   ; DE = value 書き込み先
25E7   CD 25 10               CALL   copy_slot   ; 4B コピー
25EA                             ; DE = 次ペアの先頭
25EA                             ; 
25EA                             ; ソースレジスタを +2
25EA   3A 17 26               LDA   hash_src_reg   
25ED   C6 02                  ADI   2   
25EF   32 17 26               STA   hash_src_reg   
25F2                             ; 
25F2                             ; HL = 次の書き込み位置 (DE から)
25F2   EB                     XCHG      
25F3                             ; 
25F3                             ; ペアカウンタ
25F3   3A 15 26               LDA   hash_count   
25F6   3D                     DCR   a   
25F7   32 15 26               STA   hash_count   
25FA   C2 D3 25               JNZ   hash_copy_pair   
25FD                             ; 
25FD                HASH_WRITE_RESULT:      
25FD                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
25FD   3A 14 26               LDA   hash_reg_a   
2600   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2603   36 09                  MVI   m,TT_HASH   ; +0: type
2605   23                     INX   h   
2606   36 00                  MVI   m,0   ; +1: reserved
2608   23                     INX   h   
2609   3A 16 26               LDA   hash_slot_num   
260C   3C                     INR   a   ; slot + 1
260D   77                     MOV   m,a   ; +2: val_lo
260E   23                     INX   h   
260F   36 00                  MVI   m,0   ; +3: val_hi
2611   C3 74 1D               JMP   vm_loop   
2614                             ; 
2614                             ; --- do_op_hash データ ---
2614   00           HASH_REG_A:   DB   0   
2615   00           HASH_COUNT:   DB   0   
2616   00           HASH_SLOT_NUM:   DB   0   
2617   00           HASH_SRC_REG:   DB   0   
2618                             ; 
2618                             ; ===============================================================
2618                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
2618                             ; 
2618                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
2618                             ;   キーが見つからなければ R[a] = nil
2618                             ; ===============================================================
2618                GIDX_HASH:      
2618                             ; コレクションスロットを取得
2618   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
261B   23                     INX   h   ; +1: count
261C   7E                     MOV   a,m   ; A = ペア数
261D   23                     INX   h   ; HL → データ領域
261E   B7                     ORA   a   
261F   CA 6B 26               JZ   ghash_not_found   ; 空 Hash
2622                             ; 
2622   32 7F 26               STA   ghash_loop_cnt   
2625   22 79 26               SHLD   ghash_data_ptr   
2628                             ; 
2628                             ; 検索キー R[a+1] のアドレスを取得
2628   3A 66 22               LDA   gidx_reg_a   
262B   3C                     INR   a   
262C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
262F   22 7B 26               SHLD   ghash_key_ptr   
2632                             ; 
2632                             ; 検索ループ
2632   2A 79 26               LHLD   ghash_data_ptr   
2635                GHASH_SEARCH:      
2635   22 7D 26               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
2638                             ; 
2638                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
2638   E5                     PUSH   h   
2639   2A 7B 26               LHLD   ghash_key_ptr   
263C   EB                     XCHG      ; DE = 検索キー
263D   E1                     POP   h   ; HL = hash ペアのキー
263E                             ; 
263E   0E 04                  MVI   c,SLOT_BYTES   
2640                GHASH_CMP:      
2640   1A                     LDAX   d   
2641   BE                     CMP   m   
2642   C2 5A 26               JNZ   ghash_next   
2645   23                     INX   h   
2646   13                     INX   d   
2647   0D                     DCR   c   
2648   C2 40 26               JNZ   ghash_cmp   
264B                             ; 
264B                             ; 一致! HL = value 位置 (キー直後)
264B                             ; value (4B) を R[a] にコピー
264B   E5                     PUSH   h   ; value ソース
264C   3A 66 22               LDA   gidx_reg_a   
264F   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2652   EB                     XCHG      ; DE = R[a] (コピー先)
2653   E1                     POP   h   ; HL = value (コピー元)
2654   CD 25 10               CALL   copy_slot   
2657   C3 74 1D               JMP   vm_loop   
265A                             ; 
265A                GHASH_NEXT:      
265A                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
265A   2A 7D 26               LHLD   ghash_cur_ptr   
265D   11 08 00               LXI   d,HASH_PAIR_BYTES   
2660   19                     DAD   d   
2661   3A 7F 26               LDA   ghash_loop_cnt   
2664   3D                     DCR   a   
2665   32 7F 26               STA   ghash_loop_cnt   
2668   C2 35 26               JNZ   ghash_search   
266B                             ; 
266B                GHASH_NOT_FOUND:      
266B                             ; R[a] = nil
266B   3A 66 22               LDA   gidx_reg_a   
266E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2671   3E 01                  MVI   a,TT_NIL   
2673   CD 1A 10               CALL   set_slot_special   
2676   C3 74 1D               JMP   vm_loop   
2679                             ; 
2679                             ; --- gidx_hash データ ---
2679   00 00        GHASH_DATA_PTR:   DW   0   
267B   00 00        GHASH_KEY_PTR:   DW   0   
267D   00 00        GHASH_CUR_PTR:   DW   0   
267F   00           GHASH_LOOP_CNT:   DB   0   
2680                             ; 
2680                             ; ===============================================================
2680                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
2680                             ; 
2680                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
2680                             ;   既存キー → 値を上書き
2680                             ;   新規キー → count < MAX なら末尾に追加
2680                             ; ===============================================================
2680                SIDX_HASH:      
2680                             ; コレクションスロットを取得
2680   CD BB 21               CALL   col_from_reg   ; HL = コレクションスロット
2683   22 0F 27               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
2686   23                     INX   h   ; +1: count
2687   7E                     MOV   a,m   
2688   32 19 27               STA   shash_pair_cnt   ; 元のペア数
268B   23                     INX   h   ; HL → データ領域
268C   22 11 27               SHLD   shash_data_ptr   
268F                             ; 
268F                             ; R[a+1] キーのアドレス
268F   3A 1D 23               LDA   sidx_reg_a   
2692   3C                     INR   a   
2693   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2696   22 13 27               SHLD   shash_key_ptr   
2699                             ; 
2699                             ; R[a+2] 値のアドレス
2699   3A 1D 23               LDA   sidx_reg_a   
269C   C6 02                  ADI   2   
269E   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
26A1   22 15 27               SHLD   shash_val_ptr   
26A4                             ; 
26A4                             ; 既存キーを検索
26A4   3A 19 27               LDA   shash_pair_cnt   
26A7   B7                     ORA   a   
26A8   CA E2 26               JZ   shash_append   ; 空 Hash → 追加
26AB                             ; 
26AB   32 1A 27               STA   shash_loop_cnt   
26AE   2A 11 27               LHLD   shash_data_ptr   
26B1                             ; 
26B1                SHASH_SEARCH:      
26B1   22 17 27               SHLD   shash_cur_ptr   
26B4                             ; 
26B4   E5                     PUSH   h   
26B5   2A 13 27               LHLD   shash_key_ptr   
26B8   EB                     XCHG      ; DE = 検索キー
26B9   E1                     POP   h   ; HL = hash ペアのキー
26BA                             ; 
26BA   0E 04                  MVI   c,SLOT_BYTES   
26BC                SHASH_CMP:      
26BC   1A                     LDAX   d   
26BD   BE                     CMP   m   
26BE   C2 D1 26               JNZ   shash_snext   
26C1   23                     INX   h   
26C2   13                     INX   d   
26C3   0D                     DCR   c   
26C4   C2 BC 26               JNZ   shash_cmp   
26C7                             ; 
26C7                             ; 一致! HL = value 位置
26C7                             ; R[a+2] を value にコピー
26C7   EB                     XCHG      ; DE = hash value 位置
26C8   2A 15 27               LHLD   shash_val_ptr   ; HL = R[a+2]
26CB   CD 25 10               CALL   copy_slot   
26CE   C3 74 1D               JMP   vm_loop   
26D1                             ; 
26D1                SHASH_SNEXT:      
26D1   2A 17 27               LHLD   shash_cur_ptr   
26D4   11 08 00               LXI   d,HASH_PAIR_BYTES   
26D7   19                     DAD   d   
26D8   3A 1A 27               LDA   shash_loop_cnt   
26DB   3D                     DCR   a   
26DC   32 1A 27               STA   shash_loop_cnt   
26DF   C2 B1 26               JNZ   shash_search   
26E2                             ; 
26E2                             ; 見つからなかった → 末尾に追加
26E2                             ; 
26E2                SHASH_APPEND:      
26E2                             ; 容量チェック
26E2   3A 19 27               LDA   shash_pair_cnt   
26E5   FE 04                  CPI   COL_MAX_HASH_PAIRS   
26E7   D2 03 00               JNC   vm_error   ; Hash 満杯
26EA                             ; 
26EA                             ; count++ を書き込み
26EA   3C                     INR   a   
26EB   F5                     PUSH   psw   
26EC   2A 0F 27               LHLD   shash_col_ptr   
26EF   23                     INX   h   ; +1: count フィールド
26F0   77                     MOV   m,a   
26F1   F1                     POP   psw   
26F2                             ; 
26F2                             ; 追加位置 = data + old_count * 8
26F2   3A 19 27               LDA   shash_pair_cnt   ; old count
26F5   87                     ADD   a   ; ×2
26F6   87                     ADD   a   ; ×4
26F7   87                     ADD   a   ; ×8
26F8   5F                     MOV   e,a   
26F9   16 00                  MVI   d,0   
26FB   2A 11 27               LHLD   shash_data_ptr   
26FE   19                     DAD   d   ; HL = 追加位置
26FF                             ; 
26FF                             ; key をコピー (R[a+1] → [HL])
26FF   EB                     XCHG      ; DE = 追加位置
2700   2A 13 27               LHLD   shash_key_ptr   ; HL = R[a+1]
2703   CD 25 10               CALL   copy_slot   ; key 4B、DE は value 位置に進む
2706                             ; 
2706                             ; value をコピー (R[a+2] → [DE])
2706   2A 15 27               LHLD   shash_val_ptr   ; HL = R[a+2]
2709                             ; DE は既に value 位置
2709   CD 25 10               CALL   copy_slot   
270C   C3 74 1D               JMP   vm_loop   
270F                             ; 
270F                             ; --- sidx_hash データ ---
270F   00 00        SHASH_COL_PTR:   DW   0   
2711   00 00        SHASH_DATA_PTR:   DW   0   
2713   00 00        SHASH_KEY_PTR:   DW   0   
2715   00 00        SHASH_VAL_PTR:   DW   0   
2717   00 00        SHASH_CUR_PTR:   DW   0   
2719   00           SHASH_PAIR_CNT:   DB   0   
271A   00           SHASH_LOOP_CNT:   DB   0   
271B                             ; 
271B                             ; ===============================================================
271B                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
271B                             ; 
271B                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
271B                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
271B                             ; ROM がなければ即 nil。
271B                             ; 
271B                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
271B                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
271B                             ; ===============================================================
271B                SEND_GETKEY_TIMEOUT:      
271B                             ; R[a+1] からタイムアウト回数を読む
271B   3A 4D 17               LDA   send_reg_a   
271E   C6 01                  ADI   1   
2720   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2723   23                     INX   h   
2724   23                     INX   h   ; +2: val_lo
2725   4E                     MOV   c,m   
2726   23                     INX   h   ; +3: val_hi
2727   46                     MOV   b,m   ; BC = タイムアウト回数
2728                             ; 
2728                             ; ROM チェック
2728   3A 47 06               LDA   KEY_ADDR   
272B   B7                     ORA   a   
272C   CA 56 27               JZ   getkey_timeout_nil   ; ROM なし → nil
272F                             ; 
272F                GETKEY_POLL_LOOP:      
272F   78                     MOV   a,b   
2730   B1                     ORA   c   
2731   CA 56 27               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
2734                             ; 
2734   C5                     PUSH   b   ; カウンタ退避
2735   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
2738   C1                     POP   b   ; カウンタ復帰
2739   FE FF                  CPI   0FFh   
273B   C2 47 27               JNZ   getkey_timeout_got   ; キー押下!
273E                             ; 
273E   C5                     PUSH   b   ; カウンタ退避
273F   CD 37 21               CALL   lfsr_next   ; 待機中に LFSR を進める
2742   C1                     POP   b   
2743   0B                     DCX   b   ; カウンタ--
2744   C3 2F 27               JMP   getkey_poll_loop   
2747                             ; 
2747                GETKEY_TIMEOUT_GOT:      
2747                             ; A = キーコード (0x00-0x17)
2747   4F                     MOV   c,a   
2748   06 00                  MVI   b,0   
274A   3A 4D 17               LDA   send_reg_a   
274D   CD 00 10               CALL   get_reg_addr   
2750   CD 10 10               CALL   set_slot_int16   
2753   C3 74 1D               JMP   vm_loop   
2756                             ; 
2756                GETKEY_TIMEOUT_NIL:      
2756   3A 4D 17               LDA   send_reg_a   
2759   CD 00 10               CALL   get_reg_addr   
275C   3E 01                  MVI   a,TT_NIL   
275E   CD 1A 10               CALL   set_slot_special   
2761   C3 74 1D               JMP   vm_loop   
2764                             ; 
2764                             ; ===============================================================
2764                             ; send_slice — [](offset, length): 文字列スライス
2764                             ; 
2764                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
2764                             ; 
2764                             ;   入力: send_reg_a = a, send_argc = 2
2764                             ;         R[a] = TT_STRING (対象文字列)
2764                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
2764                             ;         R[a+2] = length (TT_INTEGER)
2764                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
2764                             ;         offset >= 文字列長 → 空文字列
2764                             ;         length は利用可能バイト数にクランプ
2764                             ; ===============================================================
2764                SEND_SLICE:      
2764                             ; R[a] が TT_STRING か確認
2764   3A 4D 17               LDA   send_reg_a   
2767   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
276A   7E                     MOV   a,m   ; A = 型タグ
276B   FE 07                  CPI   TT_STRING   
276D   C2 03 00               JNZ   vm_error   
2770                             ; 
2770                             ; ソース文字列のコレクションスロットを取得
2770   3A 4D 17               LDA   send_reg_a   
2773   CD 00 10               CALL   get_reg_addr   
2776   CD BB 21               CALL   col_from_reg   ; HL = collection slot
2779   23                     INX   h   ; +1: count
277A   7E                     MOV   a,m   
277B   32 0B 28               STA   slice_src_count   
277E   23                     INX   h   ; HL → data
277F   22 0C 28               SHLD   slice_src_data   
2782                             ; 
2782                             ; R[a+1] から offset を取得
2782   3A 4D 17               LDA   send_reg_a   
2785   C6 01                  ADI   1   
2787   CD 00 10               CALL   get_reg_addr   
278A   CD 32 10               CALL   slot_to_value   
278D   7E                     MOV   a,m   ; A = offset (val_lo)
278E   32 0E 28               STA   slice_offset   
2791                             ; 
2791                             ; R[a+2] から length を取得
2791   3A 4D 17               LDA   send_reg_a   
2794   C6 02                  ADI   2   
2796   CD 00 10               CALL   get_reg_addr   
2799   CD 32 10               CALL   slot_to_value   
279C   7E                     MOV   a,m   ; A = length (val_lo)
279D   32 0F 28               STA   slice_length   
27A0                             ; 
27A0                             ; offset >= src_count → 空文字列
27A0   3A 0E 28               LDA   slice_offset   
27A3   47                     MOV   b,a   ; B = offset
27A4   3A 0B 28               LDA   slice_src_count   ; A = src_count
27A7   B8                     CMP   b   
27A8   DA FD 27               JC   slice_empty   ; src_count < offset
27AB   CA FD 27               JZ   slice_empty   ; src_count == offset
27AE                             ; 
27AE                             ; available = src_count - offset
27AE   90                     SUB   b   ; A = available
27AF   47                     MOV   b,a   ; B = available
27B0   3A 0F 28               LDA   slice_length   
27B3   B8                     CMP   b   
27B4   DA B8 27               JC   slice_len_ok   ; length < available → そのまま
27B7   78                     MOV   a,b   ; clamp: length = available
27B8                SLICE_LEN_OK:      
27B8   32 0F 28               STA   slice_length   ; 実際のコピー長
27BB                             ; 
27BB                             ; 新しいコレクションスロットを確保
27BB   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
27BE   32 10 28               STA   slice_new_slot   
27C1   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
27C3   23                     INX   h   
27C4   3A 0F 28               LDA   slice_length   
27C7   77                     MOV   m,a   ; +1: count = コピー長
27C8   23                     INX   h   ; HL → new data area
27C9                             ; 
27C9                             ; ソースデータ先頭 + offset
27C9   E5                     PUSH   h   ; dest を退避
27CA   2A 0C 28               LHLD   slice_src_data   
27CD   3A 0E 28               LDA   slice_offset   
27D0   5F                     MOV   e,a   
27D1   16 00                  MVI   d,0   
27D3   19                     DAD   d   ; HL = src_data + offset
27D4   EB                     XCHG      ; DE = src + offset
27D5   E1                     POP   h   ; HL = dest
27D6                             ; 
27D6                             ; バイトコピー
27D6   3A 0F 28               LDA   slice_length   
27D9   B7                     ORA   a   
27DA   CA E6 27               JZ   slice_done   
27DD   4F                     MOV   c,a   
27DE                SLICE_COPY:      
27DE   1A                     LDAX   d   
27DF   77                     MOV   m,a   
27E0   23                     INX   h   
27E1   13                     INX   d   
27E2   0D                     DCR   c   
27E3   C2 DE 27               JNZ   slice_copy   
27E6                             ; 
27E6                SLICE_DONE:      
27E6                             ; R[a] = TT_STRING, val_lo = new_slot + 1
27E6   3A 4D 17               LDA   send_reg_a   
27E9   CD 00 10               CALL   get_reg_addr   
27EC   36 07                  MVI   m,TT_STRING   ; +0: type
27EE   23                     INX   h   
27EF   36 00                  MVI   m,0   ; +1: reserved
27F1   23                     INX   h   
27F2   3A 10 28               LDA   slice_new_slot   
27F5   3C                     INR   a   ; slot + 1
27F6   77                     MOV   m,a   ; +2: val_lo
27F7   23                     INX   h   
27F8   36 00                  MVI   m,0   ; +3: val_hi
27FA   C3 74 1D               JMP   vm_loop   
27FD                             ; 
27FD                SLICE_EMPTY:      
27FD                             ; 空文字列を返す
27FD   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2800   32 10 28               STA   slice_new_slot   
2803   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2805   23                     INX   h   
2806   36 00                  MVI   m,0   ; +1: count = 0
2808   C3 E6 27               JMP   slice_done   
280B                             ; 
280B                             ; --- send_slice データ ---
280B   00           SLICE_SRC_COUNT:   DB   0   
280C   00 00        SLICE_SRC_DATA:   DW   0   
280E   00           SLICE_OFFSET:   DB   0   
280F   00           SLICE_LENGTH:   DB   0   
2810   00           SLICE_NEW_SLOT:   DB   0   
2811                             ; 
2811                             ; ===============================================================
2811                             ; col_gc_alloc — 到達性を辿る回収つきのスロット確保
2811                             ; 
2811                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
2811                             ; 
2811                             ; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
2811                             ; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
2811                             ; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
2811                             ; 
2811                             ; ルート:
2811                             ;   レジスタファイル    MAX_REGS 個の値スロット
2811                             ;   グローバル変数      MAX_GLOBALS 個の値スロット
2811                             ;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
2811                             ; 
2811                             ; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
2811                             ; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
2811                             ; 起動時にゼロクリアされていて型 0 なので素通りする。
2811                             ; 
2811                             ; 伝播:
2811                             ;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
2811                             ;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
2811                             ; 
2811                             ;   出力: A = スロット番号, HL = スロットアドレス
2811                             ;   エラー: 全スロット生きている → vm_error
2811                             ; ===============================================================
2811                COL_GC_ALLOC:      
2811                             ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
2811   AF                     XRA   a   
2812   21 7A 29               LXI   h,gc_bitmap   
2815   0E 10                  MVI   c,16   
2817                GC_CLEAR_BM:      
2817   77                     MOV   m,a   
2818   23                     INX   h   
2819   0D                     DCR   c   
281A   C2 17 28               JNZ   gc_clear_bm   
281D                             ; 
281D                             ; --- ルート: レジスタファイル ---
281D                             ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
281D   21 00 81               LXI   h,REG_FILE_BASE   
2820   06 40                  MVI   b,MAX_REGS   
2822                GC_ROOT_REG:      
2822   CD FF 28               CALL   gc_mark_value   
2825   23                     INX   h   
2826   23                     INX   h   
2827   23                     INX   h   
2828   23                     INX   h   
2829   05                     DCR   b   
282A   C2 22 28               JNZ   gc_root_reg   
282D                             ; 
282D                             ; --- ルート: グローバル変数 ---
282D   21 00 90               LXI   h,GLOBALS_BASE   
2830   06 40                  MVI   b,MAX_GLOBALS   
2832                GC_ROOT_GLOBAL:      
2832   CD FF 28               CALL   gc_mark_value   
2835   23                     INX   h   
2836   23                     INX   h   
2837   23                     INX   h   
2838   23                     INX   h   
2839   05                     DCR   b   
283A   C2 32 28               JNZ   gc_root_global   
283D                             ; 
283D                             ; --- ルート: オブジェクトのインスタンス変数 ---
283D   21 C4 92               LXI   h,OBJECT_POOL_BASE + OBJECT_HEADER_SIZE   
2840   06 20                  MVI   b,MAX_OBJECTS   
2842                GC_ROOT_OBJ:      
2842   C5                     PUSH   b   
2843   E5                     PUSH   h   
2844   06 07                  MVI   b,MAX_IVARS   
2846                GC_ROOT_IVAR:      
2846   CD FF 28               CALL   gc_mark_value   
2849   23                     INX   h   
284A   23                     INX   h   
284B   23                     INX   h   
284C   23                     INX   h   
284D   05                     DCR   b   
284E   C2 46 28               JNZ   gc_root_ivar   
2851   E1                     POP   h   
2852   11 20 00               LXI   d,OBJECT_SLOT_SIZE   
2855   19                     DAD   d   ; 次のオブジェクトの ivar 先頭
2856   C1                     POP   b   
2857   05                     DCR   b   
2858   C2 42 28               JNZ   gc_root_obj   
285B                             ; 
285B                             ; --- 到達性を伝播する ---
285B   CD 78 28               CALL   gc_propagate   
285E                             ; 
285E                             ; --- 印の付かなかったスロットを探す ---
285E                             ; B をカウンタに使う (gc_check_bit は B を壊さない)
285E   06 00                  MVI   b,0   
2860                GC_FIND_FREE:      
2860   78                     MOV   a,b   ; A = 検査対象スロット番号
2861   CD 55 29               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
2864   CA 71 28               JZ   gc_found_free   
2867   04                     INR   b   
2868   78                     MOV   a,b   
2869   FE 40                  CPI   MAX_COL_SLOTS   
286B   DA 60 28               JC   gc_find_free   
286E   C3 03 00               JMP   vm_error   ; 全スロット使用中
2871                             ; 
2871                GC_FOUND_FREE:      
2871   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
2872   F5                     PUSH   psw   ; スロット番号を退避
2873   CD 96 21               CALL   col_slot_addr   ; HL = スロットアドレス
2876   F1                     POP   psw   ; A = スロット番号を復帰
2877   C9                     RET      
2878                             ; 
2878                             ; ---------------------------------------------------------------
2878                             ; gc_propagate — 印が増えなくなるまで中身を辿る
2878                             ; 
2878                             ; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
2878                             ; 1 周で 1 つも走査しなければ終わり。
2878                             ; ---------------------------------------------------------------
2878                GC_PROPAGATE:      
2878   AF                     XRA   a   
2879   32 8A 29               STA   gc_changed   
287C   06 00                  MVI   b,0   ; B = スロット番号
287E                GC_PROP_SLOT:      
287E   78                     MOV   a,b   
287F   CD 55 29               CALL   gc_check_bit   ; 印が無ければ飛ばす
2882   CA 9B 28               JZ   gc_prop_next   
2885   78                     MOV   a,b   
2886   CD 6E 29               CALL   gc_check_scanned   ; 走査済みなら飛ばす
2889   C2 9B 28               JNZ   gc_prop_next   
288C   78                     MOV   a,b   
288D   CD 61 29               CALL   gc_set_scanned   
2890   3E 01                  MVI   a,1   
2892   32 8A 29               STA   gc_changed   
2895   78                     MOV   a,b   
2896   C5                     PUSH   b   
2897   CD AA 28               CALL   gc_scan_slot   
289A   C1                     POP   b   
289B                GC_PROP_NEXT:      
289B   04                     INR   b   
289C   78                     MOV   a,b   
289D   FE 40                  CPI   MAX_COL_SLOTS   
289F   DA 7E 28               JC   gc_prop_slot   
28A2   3A 8A 29               LDA   gc_changed   
28A5   B7                     ORA   a   
28A6   C2 78 28               JNZ   gc_propagate   ; 印が増えたのでもう 1 周
28A9   C9                     RET      
28AA                             ; 
28AA                             ; ---------------------------------------------------------------
28AA                             ; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
28AA                             ; 
28AA                             ; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
28AA                             ; 読むと、前に入っていた文字列のバイトが型タグに見える。
28AA                             ; 
28AA                             ; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
28AA                             ; でも隣のスロットまで歩かないようにする。
28AA                             ; ---------------------------------------------------------------
28AA                GC_SCAN_SLOT:      
28AA   C5                     PUSH   b   
28AB   CD 96 21               CALL   col_slot_addr   ; HL = スロットアドレス (A は残る)
28AE   7E                     MOV   a,m   ; +0: 型
28AF   23                     INX   h   
28B0   46                     MOV   b,m   ; +1: 要素数 / 組の数
28B1   23                     INX   h   ; HL = データ先頭
28B2   FE 02                  CPI   COL_TYPE_ARRAY   
28B4   CA BF 28               JZ   gc_scan_array   
28B7   FE 03                  CPI   COL_TYPE_HASH   
28B9   CA DC 28               JZ   gc_scan_hash   
28BC   C3 FD 28               JMP   gc_scan_done   ; 文字列と空きは辿らない
28BF                GC_SCAN_ARRAY:      
28BF   78                     MOV   a,b   
28C0   B7                     ORA   a   
28C1   CA FD 28               JZ   gc_scan_done   ; 要素数 0
28C4                             ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
28C4                             ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
28C4   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
28C6   DA CE 28               JC   gc_scan_aloop   ; 容量未満
28C9   CA CE 28               JZ   gc_scan_aloop   ; ちょうど容量
28CC   06 08                  MVI   b,COL_MAX_ARRAY_ELEMS   
28CE                GC_SCAN_ALOOP:      
28CE   CD FF 28               CALL   gc_mark_value   
28D1   23                     INX   h   
28D2   23                     INX   h   
28D3   23                     INX   h   
28D4   23                     INX   h   
28D5   05                     DCR   b   
28D6   C2 CE 28               JNZ   gc_scan_aloop   
28D9   C3 FD 28               JMP   gc_scan_done   
28DC                GC_SCAN_HASH:      
28DC   78                     MOV   a,b   
28DD   B7                     ORA   a   
28DE   CA FD 28               JZ   gc_scan_done   ; 組の数 0
28E1   FE 04                  CPI   COL_MAX_HASH_PAIRS   
28E3   DA EB 28               JC   gc_scan_hloop   
28E6   CA EB 28               JZ   gc_scan_hloop   
28E9   06 04                  MVI   b,COL_MAX_HASH_PAIRS   
28EB                GC_SCAN_HLOOP:      
28EB   CD FF 28               CALL   gc_mark_value   ; 鍵
28EE   23                     INX   h   
28EF   23                     INX   h   
28F0   23                     INX   h   
28F1   23                     INX   h   
28F2   CD FF 28               CALL   gc_mark_value   ; 値
28F5   23                     INX   h   
28F6   23                     INX   h   
28F7   23                     INX   h   
28F8   23                     INX   h   
28F9   05                     DCR   b   
28FA   C2 EB 28               JNZ   gc_scan_hloop   
28FD                GC_SCAN_DONE:      
28FD   C1                     POP   b   
28FE   C9                     RET      
28FF                             ; 
28FF                             ; ---------------------------------------------------------------
28FF                             ; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
28FF                             ; 
28FF                             ; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
28FF                             ; なのでここでは何もしない (中身はルート走査で辿る)。
28FF                             ; 
28FF                             ; **値は スロット + 1。** 0 は「無し」。
28FF                             ; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
28FF                             ; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
28FF                             ; 
28FF                             ;   HL / DE / BC は保たれる
28FF                             ; ---------------------------------------------------------------
28FF                GC_MARK_VALUE:      
28FF   E5                     PUSH   h   
2900   D5                     PUSH   d   
2901   C5                     PUSH   b   
2902   7E                     MOV   a,m   ; A = 型タグ
2903   FE 07                  CPI   TT_STRING   
2905   CA 15 29               JZ   gc_mv_ref   
2908   FE 08                  CPI   TT_ARRAY   
290A   CA 15 29               JZ   gc_mv_ref   
290D   FE 09                  CPI   TT_HASH   
290F   CA 15 29               JZ   gc_mv_ref   
2912   C3 2C 29               JMP   gc_mv_done   
2915                GC_MV_REF:      
2915   23                     INX   h   
2916   23                     INX   h   
2917   23                     INX   h   
2918   7E                     MOV   a,m   ; +3: val_hi
2919   B7                     ORA   a   
291A   C2 2C 29               JNZ   gc_mv_done   ; 上位が 0 でなければスロット番号ではない
291D   2B                     DCX   h   
291E   7E                     MOV   a,m   ; +2: val_lo = スロット + 1
291F   B7                     ORA   a   
2920   CA 2C 29               JZ   gc_mv_done   ; 0 = 無し
2923   3D                     DCR   a   ; A = スロット番号
2924   FE 40                  CPI   MAX_COL_SLOTS   
2926   D2 2C 29               JNC   gc_mv_done   ; 範囲外
2929   CD 48 29               CALL   gc_set_bit   
292C                GC_MV_DONE:      
292C   C1                     POP   b   
292D   D1                     POP   d   
292E   E1                     POP   h   
292F   C9                     RET      
2930                             ; 
2930                             ; ---------------------------------------------------------------
2930                             ; ビットの出し入れ
2930                             ; 
2930                             ; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
2930                             ; 直して食い違うのを避けるため。
2930                             ; 
2930                             ; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
2930                             ;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
2930                             ; ---------------------------------------------------------------
2930                GC_BIT_PTR:      
2930   4F                     MOV   c,a   ; C = スロット番号
2931   0F                     RRC      
2932   0F                     RRC      
2933   0F                     RRC      
2934   E6 07                  ANI   07h   ; A = バイト位置 (slot >> 3)
2936   6F                     MOV   l,a   
2937   26 00                  MVI   h,0   
2939   19                     DAD   d   ; HL = 先頭 + バイト位置
293A   E5                     PUSH   h   
293B   79                     MOV   a,c   
293C   E6 07                  ANI   07h   ; ビット位置 (slot & 7)
293E   6F                     MOV   l,a   
293F   26 00                  MVI   h,0   
2941   11 8B 29               LXI   d,gc_bit_table   
2944   19                     DAD   d   
2945   7E                     MOV   a,m   ; A = ビットマスク
2946   E1                     POP   h   ; HL = ビットマップのバイト
2947   C9                     RET      
2948                             ; 
2948                             ; --- gc_set_bit: A = slot (0-63) の印を立てる ---
2948                GC_SET_BIT:      
2948   E5                     PUSH   h   
2949   D5                     PUSH   d   
294A   11 7A 29               LXI   d,gc_bitmap   
294D   CD 30 29               CALL   gc_bit_ptr   
2950   B6                     ORA   m   
2951   77                     MOV   m,a   
2952   D1                     POP   d   
2953   E1                     POP   h   
2954   C9                     RET      
2955                             ; 
2955                             ; --- gc_check_bit: A = slot の印を検査 ---
2955                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
2955                GC_CHECK_BIT:      
2955   E5                     PUSH   h   
2956   D5                     PUSH   d   
2957   11 7A 29               LXI   d,gc_bitmap   
295A   CD 30 29               CALL   gc_bit_ptr   
295D   A6                     ANA   m   ; Z=1 ならビットクリア
295E   D1                     POP   d   ; POP はフラグを変えない
295F   E1                     POP   h   
2960   C9                     RET      
2961                             ; 
2961                             ; --- gc_set_scanned: A = slot を走査済みにする ---
2961                GC_SET_SCANNED:      
2961   E5                     PUSH   h   
2962   D5                     PUSH   d   
2963   11 82 29               LXI   d,gc_scanned   
2966   CD 30 29               CALL   gc_bit_ptr   
2969   B6                     ORA   m   
296A   77                     MOV   m,a   
296B   D1                     POP   d   
296C   E1                     POP   h   
296D   C9                     RET      
296E                             ; 
296E                             ; --- gc_check_scanned: A = slot が走査済みか ---
296E                             ; 戻り: Z=1 → まだ、Z=0 → 済み
296E                GC_CHECK_SCANNED:      
296E   E5                     PUSH   h   
296F   D5                     PUSH   d   
2970   11 82 29               LXI   d,gc_scanned   
2973   CD 30 29               CALL   gc_bit_ptr   
2976   A6                     ANA   m   
2977   D1                     POP   d   
2978   E1                     POP   h   
2979   C9                     RET      
297A                             ; 
297A                             ; --- GC データ ---
297A                             ; 
297A                             ; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
297A                             ; 回している
297A   00 00 00 00 00 00 00 00 GC_BITMAP:   DB   0,0,0,0,0,0,0,0   
2982   00 00 00 00 00 00 00 00 GC_SCANNED:   DB   0,0,0,0,0,0,0,0   
298A   00           GC_CHANGED:   DB   0   
298B   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
2993                             ; 
2993                             ; ===============================================================
2993                             ; sendb_each — Array#each / Hash#each
2993                             ; 
2993                             ;   R[a] = TT_ARRAY か TT_HASH (レシーバ)
2993                             ;   R[a+argc+1] = TT_PROC (ブロック)
2993                             ;   配列: 各反復で R[1] = array[index]
2993                             ;   ハッシュ: 各反復で R[1] = 鍵, R[2] = 値
2993                             ; 
2993                             ; FRAME_KIND_EACH / FRAME_KIND_HASH_EACH を使い、フレーム +11
2993                             ; (reserved) にコレクションスロット番号を格納する。
2993                             ; 
2993                             ; **見出しの +1 (count) はどちらも「反復の回数」です。** 配列なら要素数、
2993                             ; ハッシュならペア数なので、上限の出し方を分ける必要がありません。
2993                             ; 違うのはブロックへ渡す値だけで、そこは each_block_args に出しています。
2993                             ; ===============================================================
2993                SENDB_EACH:      
2993                             ; each はレシーバの型でフレーム種別を決める
2993                             ; (述語は sendb_pred が種別を書いてから合流する)
2993   3A C9 19               LDA   sendb_reg_a   
2996   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2999   7E                     MOV   a,m   
299A   FE 08                  CPI   TT_ARRAY   
299C   CA A9 29               JZ   each_kind_array   
299F   FE 09                  CPI   TT_HASH   
29A1   C2 03 00               JNZ   vm_error   
29A4   3E 03                  MVI   a,FRAME_KIND_HASH_EACH   
29A6   C3 AB 29               JMP   each_kind_set   
29A9                EACH_KIND_ARRAY:      
29A9   3E 02                  MVI   a,FRAME_KIND_EACH   
29AB                EACH_KIND_SET:      
29AB   32 96 2B               STA   each_arg_kind   
29AE                             ; 
29AE                SENDB_EACH_JOIN:      
29AE                             ; レシーバが配列かハッシュであること (述語もここを通る)
29AE   3A C9 19               LDA   sendb_reg_a   
29B1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
29B4   7E                     MOV   a,m   
29B5   FE 08                  CPI   TT_ARRAY   
29B7   CA BF 29               JZ   each_recv_ok   
29BA   FE 09                  CPI   TT_HASH   
29BC   C2 03 00               JNZ   vm_error   
29BF                EACH_RECV_OK:      
29BF                             ; 
29BF                             ; コレクションスロット番号を取得 (配列・ハッシュとも val_lo = slot + 1)
29BF   3A C9 19               LDA   sendb_reg_a   
29C2   CD 00 10               CALL   get_reg_addr   
29C5   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
29C8   7E                     MOV   a,m   ; val_lo = slot + 1
29C9   3D                     DCR   a   ; slot number (0-based)
29CA   32 94 2B               STA   each_col_slot   
29CD                             ; 
29CD                             ; 反復の回数を読む (配列なら要素数、ハッシュならペア数)
29CD   3A 94 2B               LDA   each_col_slot   
29D0   CD 96 21               CALL   col_slot_addr   ; HL = スロットアドレス
29D3   23                     INX   h   ; +1: count
29D4   7E                     MOV   a,m   
29D5   32 95 2B               STA   each_count   
29D8   B7                     ORA   a   
29D9   CA 32 2A               JZ   each_empty   ; 空 → ブロック実行しない
29DC                             ; 
29DC                             ; ブロック (TT_PROC) の情報を読む
29DC   3A CB 19               LDA   sendb_argc   
29DF   3C                     INR   a   ; argc + 1
29E0   47                     MOV   b,a   
29E1   3A C9 19               LDA   sendb_reg_a   
29E4   80                     ADD   b   ; A = a + argc + 1
29E5   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1]
29E8   CD 32 10               CALL   slot_to_value   
29EB   7E                     MOV   a,m   ; irep 番号
29EC   32 CD 19               STA   sendb_block_irep   
29EF   23                     INX   h   
29F0   7E                     MOV   a,m   ; outer
29F1   32 CE 19               STA   sendb_block_outer   
29F4                             ; 
29F4                             ; push_frame(a, kind, outer)
29F4   3A 96 2B               LDA   each_arg_kind   
29F7   47                     MOV   b,a   
29F8   3A CE 19               LDA   sendb_block_outer   
29FB   4F                     MOV   c,a   
29FC   3A C9 19               LDA   sendb_reg_a   
29FF   CD 9C 17               CALL   push_frame   
2A02                             ; 
2A02                             ; フレームに limit = count - 1 を設定
2A02   CD 95 17               CALL   cur_frame_addr   
2A05   11 08 00               LXI   d,FRAME_OFF_LIMIT   
2A08   19                     DAD   d   
2A09   3A 95 2B               LDA   each_count   
2A0C   3D                     DCR   a   ; limit = count - 1
2A0D   77                     MOV   m,a   ; limit_lo
2A0E   23                     INX   h   
2A0F   36 00                  MVI   m,0   ; limit_hi
2A11                             ; 
2A11                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
2A11   CD 95 17               CALL   cur_frame_addr   
2A14   11 0B 00               LXI   d,11   
2A17   19                     DAD   d   
2A18   3A 94 2B               LDA   each_col_slot   
2A1B   77                     MOV   m,a   
2A1C                             ; 
2A1C                             ; 最初の回のブロック引数 (index = 0)
2A1C   AF                     XRA   a   
2A1D   32 97 2B               STA   each_index   
2A20   CD 40 2B               CALL   each_block_args   
2A23                             ; 
2A23                             ; 子 irep に切り替え
2A23   3A CD 19               LDA   sendb_block_irep   
2A26   CD 21 18               CALL   switch_irep   
2A29                             ; 
2A29                             ; PC = 0
2A29   21 00 00               LXI   h,0   
2A2C   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
2A2F   C3 74 1D               JMP   vm_loop   
2A32                             ; 
2A32                             ; ===============================================================
2A32                             ; each_empty — 1 回も回らないとき
2A32                             ; 
2A32                             ; each はレシーバがそのまま呼び出しの値になるので何もしません。
2A32                             ; **述語だけは答えを書きます** (空の any? は false、all? と none? は true)。
2A32                             ; フレームを積まないので、ここで決まります。
2A32                             ; ===============================================================
2A32                EACH_EMPTY:      
2A32   3A 96 2B               LDA   each_arg_kind   
2A35   FE 06                  CPI   FRAME_KIND_ANY   
2A37   DA 74 1D               JC   vm_loop   ; 述語ではない → レシーバのまま
2A3A   FE 06                  CPI   FRAME_KIND_ANY   
2A3C   CA 44 2A               JZ   each_empty_false   ; any? → false
2A3F   3E 03                  MVI   a,TT_TRUE   ; all? / none? → true
2A41   C3 46 2A               JMP   each_empty_write   
2A44                EACH_EMPTY_FALSE:      
2A44   3E 02                  MVI   a,TT_FALSE   
2A46                EACH_EMPTY_WRITE:      
2A46   32 58 2A               STA   each_empty_tag   
2A49   3A C9 19               LDA   sendb_reg_a   
2A4C   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (呼び出しの値になる場所)
2A4F   3A 58 2A               LDA   each_empty_tag   
2A52   CD 1A 10               CALL   set_slot_special   
2A55   C3 74 1D               JMP   vm_loop   
2A58                             ; 
2A58   00           EACH_EMPTY_TAG:   DB   0   
2A59                             ; 
2A59                             ; ===============================================================
2A59                             ; sendb_array_new — Array.new(n) 00bbIHxpfCA=
2A59                             ; 
2A59                             ; **先に配列を確保して R[a] に置く。** 窓をずらすと R[0] が配列になり、
2A59                             ; 反復の間ずっとそこから書き込む先を引ける。尽きればそれが呼び出しの値。
2A59                             ; 
2A59                             ; 渡すのは添字 (times と同じ)。ブロックの値は advance_iteration が
2A59                             ; その回の要素へ書く。**先に nil で埋めておく** — break で途中で抜けても、
2A59                             ; 書いていない要素を値スロットとして読まれないようにするため。
2A59                             ; ===============================================================
2A59                SENDB_ARRAY_NEW:      
2A59                             ; レシーバが Array であること
2A59   3A C9 19               LDA   sendb_reg_a   
2A5C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2A5F   7E                     MOV   a,m   
2A60   FE 0E                  CPI   TT_BUILTIN_CLASS   
2A62   C2 03 00               JNZ   vm_error   
2A65   3A C9 19               LDA   sendb_reg_a   
2A68   CD 00 10               CALL   get_reg_addr   
2A6B   CD 32 10               CALL   slot_to_value   
2A6E   7E                     MOV   a,m   
2A6F   FE 01                  CPI   BUILTIN_CLASS_ARRAY   
2A71   C2 03 00               JNZ   vm_error   
2A74                             ; 
2A74                             ; 大きさは R[a+1]
2A74   3A C9 19               LDA   sendb_reg_a   
2A77   3C                     INR   a   
2A78   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2A7B   7E                     MOV   a,m   
2A7C   FE 04                  CPI   TT_INTEGER   
2A7E   C2 03 00               JNZ   vm_error   
2A81   23                     INX   h   
2A82   23                     INX   h   ; +2: val_lo
2A83   4E                     MOV   c,m   
2A84   23                     INX   h   
2A85   7E                     MOV   a,m   ; 上位バイト
2A86   B7                     ORA   a   
2A87   C2 03 00               JNZ   vm_error   ; 負か大きすぎる
2A8A   79                     MOV   a,c   
2A8B   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2A8D   D2 03 00               JNC   vm_error   
2A90   32 3B 2B               STA   san_count   
2A93                             ; 
2A93                             ; スロットを確保して nil で埋める
2A93   CD A6 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2A96   32 3C 2B               STA   san_slot   
2A99   36 02                  MVI   m,COL_TYPE_ARRAY   
2A9B   23                     INX   h   
2A9C   3A 3B 2B               LDA   san_count   
2A9F   77                     MOV   m,a   ; +1: count
2AA0   23                     INX   h   ; HL → データ領域
2AA1   22 3E 2B               SHLD   san_data   
2AA4   3A 3B 2B               LDA   san_count   
2AA7   B7                     ORA   a   
2AA8   CA C7 2A               JZ   san_no_fill   
2AAB   32 3D 2B               STA   san_left   
2AAE                SAN_FILL_LOOP:      
2AAE   2A 3E 2B               LHLD   san_data   
2AB1   36 01                  MVI   m,TT_NIL   
2AB3   23                     INX   h   
2AB4   36 00                  MVI   m,0   
2AB6   23                     INX   h   
2AB7   36 00                  MVI   m,0   
2AB9   23                     INX   h   
2ABA   36 00                  MVI   m,0   
2ABC   23                     INX   h   
2ABD   22 3E 2B               SHLD   san_data   
2AC0   21 3D 2B               LXI   h,san_left   
2AC3   35                     DCR   m   
2AC4   C2 AE 2A               JNZ   san_fill_loop   
2AC7                             ; 
2AC7                SAN_NO_FILL:      
2AC7                             ; R[a] = TT_ARRAY, val_lo = slot+1。**これが呼び出しの値になる**
2AC7   3A C9 19               LDA   sendb_reg_a   
2ACA   CD 00 10               CALL   get_reg_addr   
2ACD   36 08                  MVI   m,TT_ARRAY   
2ACF   23                     INX   h   
2AD0   36 00                  MVI   m,0   
2AD2   23                     INX   h   
2AD3   3A 3C 2B               LDA   san_slot   
2AD6   3C                     INR   a   
2AD7   77                     MOV   m,a   
2AD8   23                     INX   h   
2AD9   36 00                  MVI   m,0   
2ADB                             ; 
2ADB                             ; 0 個ならブロックを 1 回も回さない (配列はもう R[a] にある)
2ADB   3A 3B 2B               LDA   san_count   
2ADE   B7                     ORA   a   
2ADF   CA 74 1D               JZ   vm_loop   
2AE2                             ; 
2AE2                             ; ブロック (TT_PROC) の情報を読む
2AE2   3A CB 19               LDA   sendb_argc   
2AE5   3C                     INR   a   
2AE6   47                     MOV   b,a   
2AE7   3A C9 19               LDA   sendb_reg_a   
2AEA   80                     ADD   b   ; A = a + argc + 1
2AEB   CD 00 10               CALL   get_reg_addr   
2AEE   CD 32 10               CALL   slot_to_value   
2AF1   7E                     MOV   a,m   
2AF2   32 CD 19               STA   sendb_block_irep   
2AF5   23                     INX   h   
2AF6   7E                     MOV   a,m   
2AF7   32 CE 19               STA   sendb_block_outer   
2AFA                             ; 
2AFA                             ; push_frame(a, FRAME_KIND_ARRAY_FILL, outer)
2AFA   06 09                  MVI   b,FRAME_KIND_ARRAY_FILL   
2AFC   3A CE 19               LDA   sendb_block_outer   
2AFF   4F                     MOV   c,a   
2B00   3A C9 19               LDA   sendb_reg_a   
2B03   CD 9C 17               CALL   push_frame   
2B06                             ; 
2B06                             ; limit = count - 1
2B06   CD 95 17               CALL   cur_frame_addr   
2B09   11 08 00               LXI   d,FRAME_OFF_LIMIT   
2B0C   19                     DAD   d   
2B0D   3A 3B 2B               LDA   san_count   
2B10   3D                     DCR   a   
2B11   77                     MOV   m,a   
2B12   23                     INX   h   
2B13   36 00                  MVI   m,0   
2B15                             ; 
2B15                             ; フレーム +11 にコレクションスロット番号 (書き込む先を引くのに使う)
2B15   CD 95 17               CALL   cur_frame_addr   
2B18   11 0B 00               LXI   d,11   
2B1B   19                     DAD   d   
2B1C   3A 3C 2B               LDA   san_slot   
2B1F   77                     MOV   m,a   
2B20                             ; 
2B20                             ; ブロック引数 R[1] = 0 (添字)
2B20   3E 01                  MVI   a,1   
2B22   CD 00 10               CALL   get_reg_addr   
2B25   06 00                  MVI   b,0   
2B27   0E 00                  MVI   c,0   
2B29   CD 10 10               CALL   set_slot_int16   
2B2C                             ; 
2B2C                             ; 子 irep に切り替えて PC = 0
2B2C   3A CD 19               LDA   sendb_block_irep   
2B2F   CD 21 18               CALL   switch_irep   
2B32   21 00 00               LXI   h,0   
2B35   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
2B38   C3 74 1D               JMP   vm_loop   
2B3B                             ; 
2B3B   00           SAN_COUNT:   DB   0   
2B3C   00           SAN_SLOT:   DB   0   
2B3D   00           SAN_LEFT:   DB   0   
2B3E   00 00        SAN_DATA:   DW   0   
2B40                             ; 
2B40                             ; ===============================================================
2B40                             ; each_block_args — 反復のその回の値をブロックの引数へ
2B40                             ; 
2B40                             ;   入力: each_arg_kind / each_col_slot / each_index
2B40                             ;   出力: R[1] (配列なら要素、ハッシュなら鍵)
2B40                             ;         ハッシュなら R[2] にも値
2B40                             ; 
2B40                             ; **sendb_each と advance_iteration の両方から呼びます。** 最初の回と
2B40                             ; 2 回目以降で同じ場所の出し方をするためで、以前は 1 回目を sendb_each に
2B40                             ; 書き写していました。
2B40                             ; 
2B40                             ; **添字は下位バイトだけ見ます。** 配列は 8 要素、ハッシュは 4 ペアまでで、
2B40                             ; 上限がバイトに収まります。
2B40                             ; ===============================================================
2B40                EACH_BLOCK_ARGS:      
2B40   3A 94 2B               LDA   each_col_slot   
2B43   CD 96 21               CALL   col_slot_addr   ; HL = スロットアドレス
2B46   7E                     MOV   a,m   ; +0: 見出しの種別 (COL_TYPE_*)
2B47   32 9A 2B               STA   eba_col_type   
2B4A   23                     INX   h   ; skip type
2B4B   23                     INX   h   ; skip count → data
2B4C                             ; **渡す値はスロットの見出しで決めます。** フレームの種別ではありません —
2B4C                             ; 述語は配列とハッシュで種別を分けていないためです
2B4C   3A 9A 2B               LDA   eba_col_type   
2B4F   FE 03                  CPI   COL_TYPE_HASH   
2B51   CA 69 2B               JZ   eba_hash   
2B54                             ; 
2B54                             ; --- 配列: data + index * 4 ---
2B54   3A 97 2B               LDA   each_index   
2B57   87                     ADD   a   ; ×2
2B58   87                     ADD   a   ; ×4
2B59   5F                     MOV   e,a   
2B5A   16 00                  MVI   d,0   
2B5C   19                     DAD   d   ; HL = &data[index*4]
2B5D   E5                     PUSH   h   
2B5E   3E 01                  MVI   a,1   
2B60   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2B63   EB                     XCHG      ; DE = R[1] (コピー先)
2B64   E1                     POP   h   ; HL = コピー元
2B65   CD 25 10               CALL   copy_slot   ; R[1] = array[index]
2B68   C9                     RET      
2B69                             ; 
2B69                             ; --- ハッシュ: data + index * 8 が鍵、その +4 が値 ---
2B69                EBA_HASH:      
2B69   3A 97 2B               LDA   each_index   
2B6C   87                     ADD   a   ; ×2
2B6D   87                     ADD   a   ; ×4
2B6E   87                     ADD   a   ; ×8
2B6F   5F                     MOV   e,a   
2B70   16 00                  MVI   d,0   
2B72   19                     DAD   d   ; HL = &pair
2B73   22 98 2B               SHLD   eba_pair   ; copy_slot が HL を進めるので退避
2B76   E5                     PUSH   h   
2B77   3E 01                  MVI   a,1   
2B79   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2B7C   EB                     XCHG      ; DE = R[1]
2B7D   E1                     POP   h   ; HL = &鍵
2B7E   CD 25 10               CALL   copy_slot   ; R[1] = 鍵
2B81   2A 98 2B               LHLD   eba_pair   
2B84   11 04 00               LXI   d,4   
2B87   19                     DAD   d   ; HL = &値
2B88   E5                     PUSH   h   
2B89   3E 02                  MVI   a,2   
2B8B   CD 00 10               CALL   get_reg_addr   ; HL = R[2]
2B8E   EB                     XCHG      ; DE = R[2]
2B8F   E1                     POP   h   ; HL = &値
2B90   CD 25 10               CALL   copy_slot   ; R[2] = 値
2B93   C9                     RET      
2B94                             ; 
2B94                             ; --- sendb_each データ ---
2B94   00           EACH_COL_SLOT:   DB   0   
2B95   00           EACH_COUNT:   DB   0   
2B96   00           EACH_ARG_KIND:   DB   0   
2B97   00           EACH_INDEX:   DB   0   
2B98   00 00        EBA_PAIR:   DW   0   
2B9A   00           EBA_COL_TYPE:   DB   0   
2B9B                             ; 
2B9B                          END      


