0000                             ; vm_main.a80 — faRuby i8080 VM エントリポイント
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (32KB RAM: 0x8000-0xFFFF) を想定。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; --- メモリマップ ---
0000                VM_CODE_ORG:   EQU   8400h   
0000                BYTECODE_BASE:   EQU   9000h   
0000                BYTECODE_SIZE:   EQU   1000h   
0000                POOL_BASE:   EQU   0A000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                INIT_METHOD_ID_STORE:   EQU   82FEh   ; initialize の method_id 格納アドレス
0000                             ; --- バリュースロット ---
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; --- VM 状態領域のオフセット ---
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                OFF_OBJ_SP:   EQU   1Bh   ; 1B  次の空きオブジェクトスロット
0000                OFF_INIT_METHOD_ID:   EQU   1Ch   ; 1B  initialize のメソッド ID
0000                OFF_POOL_BASE:   EQU   1Dh   ; 2B  現在の IREP の定数プール先頭
0000                OFF_COL_SP:   EQU   1Fh   ; 1B  次の空きコレクションスロット
0000                             ; --- IREP テーブルエントリ ---
0000                IREP_ENTRY_BYTES:   EQU   0Ah   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_SUBTREE_SIZE:   EQU   07h   ; 1B  DFS 前順サブツリーサイズ
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_STRING:   EQU   07h   
0000                TT_ARRAY:   EQU   08h   
0000                TT_HASH:   EQU   09h   
0000                TT_OBJECT:   EQU   0Ah   
0000                TT_PROC:   EQU   0Ch   
0000                TT_CLASS:   EQU   0Dh   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; --- VM 実行状態 ---
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   0B000h   
0000                             ; シンボル種別コード (上位バイト)
0000                SYM_KIND_USER_METHOD:   EQU   01h   ; ユーザー定義メソッド
0000                SYM_KIND_CLASS:   EQU   02h   ; クラス名
0000                SYM_KIND_IVAR:   EQU   03h   ; インスタンス変数
0000                             ; --- フレームスタック ---
0000                FRAME_STACK_BASE:   EQU   0B100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   08h   
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_EACH:   EQU   02h   ; each (配列要素反復)
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                FRAME_KIND_NEW:   EQU   05h   ; Class#new → initialize
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; --- メソッド表 ---
0000                METHOD_TABLE_BASE:   EQU   0B160h   
0000                MAX_CLASSES:   EQU   04h   
0000                MAX_METHODS_PER_CLASS:   EQU   20h   
0000                METHOD_TABLE_SIZE:   EQU   80h   
0000                CLASS_MAIN:   EQU   00h   
0000                METHOD_NEW:   EQU   1Ch   ; Class#new
0000                METHOD_DISPLAY:   EQU   1Dh   ; display(value)
0000                METHOD_GETKEY:   EQU   1Eh   ; getkey
0000                METHOD_PUTS:   EQU   1Fh   ; puts(value): ASCII 2 文字表示
0000                METHOD_SETSEG:   EQU   20h   ; setseg(pos, pattern)
0000                METHOD_RAND:   EQU   21h   ; rand(n)
0000                METHOD_SLICE:   EQU   22h   ; [](offset, length) 文字列スライス
0000                METHOD_LENGTH:   EQU   12h   ; length / size
0000                METHOD_CONCAT:   EQU   14h   ; << (文字列追記/配列追加)
0000                METHOD_EACH:   EQU   15h   ; each (配列要素反復)
0000                METHOD_PUSH:   EQU   16h   ; push (配列追加)
0000                KEYIN1_ADDR:   EQU   0616h   ; ND80Z モニタキー入力 (ブロッキング)
0000                KEY_ADDR:   EQU   0647h   ; ND80Z キー 1 回スキャン (ノンブロッキング)
0000                             ; --- オブジェクトプール ---
0000                OBJECT_POOL_BASE:   EQU   0B1E0h   
0000                MAX_OBJECTS:   EQU   08h   
0000                OBJECT_SLOT_SIZE:   EQU   20h   ; 32B/スロット
0000                OBJECT_HEADER_SIZE:   EQU   04h   
0000                MAX_IVARS:   EQU   07h   
0000                             ; --- コレクションプール (文字列・配列) ---
0000                COLLECTION_POOL_BASE:   EQU   0B2E0h   
0000                MAX_COL_SLOTS:   EQU   10h   
0000                COL_SLOT_SIZE:   EQU   24h   ; 36B/スロット
0000                COL_HEADER_SIZE:   EQU   02h   ; +0: type, +1: count
0000                COL_DATA_SIZE:   EQU   22h   ; データ領域 (34B)
0000                COL_MAX_STRING_LEN:   EQU   22h   
0000                COL_MAX_ARRAY_ELEMS:   EQU   08h   
0000                COL_TYPE_FREE:   EQU   00h   
0000                COL_TYPE_STRING:   EQU   01h   
0000                COL_TYPE_ARRAY:   EQU   02h   
0000                COL_TYPE_HASH:   EQU   03h   
0000                HASH_PAIR_BYTES:   EQU   08h   ; 8B/ペア (key+value)
0000                COL_MAX_HASH_PAIRS:   EQU   04h   ; 最大4ペア
0000                             ; --- Phase 1 オペコード ---
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
8400                          .ORG   08400h   
8400                             ; ===============================================================
8400                             ; リセットベクタ
8400                             ; ===============================================================
8400   C3 D4 A8               JMP   vm_start   
8403                             ; ===============================================================
8403                             ; サブルーチン群 (.include で取り込む)
8403                             ; ===============================================================
8403                             ; vm_util.a80 — ユーティリティサブルーチン
8403                             ; 
8403                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
8403                             ; 他のすべてのモジュールがここに依存します。
8403                             ; 
8403                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
8403                             ;   +0: 型タグ (1B)
8403                             ;   +1: 予約   (1B, 常に 0)
8403                             ;   +2: val_lo (1B)
8403                             ;   +3: val_hi (1B)
8403                             ; ---------------------------------------------------------------
8403                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
8403                             ; 
8403                             ;   入力: A = レジスタ番号 (0-63)
8403                             ;   出力: HL = スロット先頭アドレス
8403                             ;   破壊: A
8403                             ; 
8403                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
8403                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
8403                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
8403                             ; ---------------------------------------------------------------
8403                GET_REG_ADDR:      
8403   87                     ADD   a   ; ×2
8404   87                     ADD   a   ; ×4 (オフセット、A に残る)
8405   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
8408   85                     ADD   l   ; A = base_lo + offset
8409   6F                     MOV   l,a   
840A   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
840C   8C                     ADC   h   ; A = base_hi + CY
840D   67                     MOV   h,a   
840E   C9                     RET      
840F                             ; ---------------------------------------------------------------
840F                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
840F                             ; 
840F                             ;   入力: A = レジスタ番号 a
840F                             ;   出力: HL = R[a+1] のスロット先頭アドレス
840F                             ;   破壊: A
840F                             ; ---------------------------------------------------------------
840F                GET_REG_ADDR_NEXT:      
840F   3C                     INR   a   
8410   C3 03 84               JMP   get_reg_addr   
8413                             ; ---------------------------------------------------------------
8413                             ; set_slot_int16 — スロットに 16 ビット整数を書く
8413                             ; 
8413                             ;   入力: HL = スロット先頭アドレス
8413                             ;          B  = val_hi (上位バイト)
8413                             ;          C  = val_lo (下位バイト)
8413                             ;   出力: なし
8413                             ;   破壊: HL
8413                             ; ---------------------------------------------------------------
8413                SET_SLOT_INT16:      
8413   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
8415   23                     INX   h   
8416   36 00                  MVI   m,0   ; +1: 予約
8418   23                     INX   h   
8419   71                     MOV   m,c   ; +2: val_lo
841A   23                     INX   h   
841B   70                     MOV   m,b   ; +3: val_hi
841C   C9                     RET      
841D                             ; ---------------------------------------------------------------
841D                             ; set_slot_special — 値を持たない型をスロットに書く
841D                             ; 
841D                             ;   入力: HL = スロット先頭アドレス
841D                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
841D                             ;   出力: なし
841D                             ;   破壊: A, HL
841D                             ; ---------------------------------------------------------------
841D                SET_SLOT_SPECIAL:      
841D   77                     MOV   m,a   ; +0: 型タグ
841E   23                     INX   h   
841F   36 00                  MVI   m,0   ; +1: 予約
8421   23                     INX   h   
8422   36 00                  MVI   m,0   ; +2: val_lo = 0
8424   23                     INX   h   
8425   36 00                  MVI   m,0   ; +3: val_hi = 0
8427   C9                     RET      
8428                             ; ---------------------------------------------------------------
8428                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
8428                             ; 
8428                             ;   入力: HL = コピー元先頭
8428                             ;         DE = コピー先先頭
8428                             ;   出力: なし
8428                             ;   破壊: A, C, HL, DE
8428                             ; ---------------------------------------------------------------
8428                COPY_SLOT:      
8428   0E 04                  MVI   c,SLOT_BYTES   
842A                COPY_SLOT_LOOP:      
842A   7E                     MOV   a,m   
842B   12                     STAX   d   
842C   23                     INX   h   
842D   13                     INX   d   
842E   0D                     DCR   c   
842F   C2 2A 84               JNZ   copy_slot_loop   
8432   C9                     RET      
8433                             ; ---------------------------------------------------------------
8433                             ; get_slot_type — スロットの型タグを読む
8433                             ; 
8433                             ;   入力: HL = スロット先頭アドレス
8433                             ;   出力: A = 型タグ
8433                             ;   破壊: なし (HL 保存)
8433                             ; ---------------------------------------------------------------
8433                GET_SLOT_TYPE:      
8433   7E                     MOV   a,m   
8434   C9                     RET      
8435                             ; ---------------------------------------------------------------
8435                             ; slot_to_value — スロット先頭から値の先頭へ進める
8435                             ; 
8435                             ;   入力: HL = スロット先頭アドレス
8435                             ;   出力: HL = 値の先頭 (スロット +2)
8435                             ;   破壊: なし
8435                             ; ---------------------------------------------------------------
8435                SLOT_TO_VALUE:      
8435   23                     INX   h   
8436   23                     INX   h   
8437   C9                     RET      
8438                             ; ---------------------------------------------------------------
8438                             ; add_value16 — 16 ビット加算 (val1 += val2)
8438                             ; 
8438                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8438                             ;         DE = 値 2 の先頭
8438                             ;   出力: 結果を HL の元の位置に上書き
8438                             ;   破壊: A, HL, DE
8438                             ; 
8438                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
8438                             ; ---------------------------------------------------------------
8438                ADD_VALUE16:      
8438   1A                     LDAX   d   ; A = val2[lo]
8439   86                     ADD   m   ; A += val1[lo]
843A   77                     MOV   m,a   ; val1[lo] = result
843B   23                     INX   h   
843C   13                     INX   d   
843D   1A                     LDAX   d   ; A = val2[hi]
843E   8E                     ADC   m   ; A += val1[hi] + CY
843F   77                     MOV   m,a   
8440   C9                     RET      
8441                             ; ---------------------------------------------------------------
8441                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
8441                             ; 
8441                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8441                             ;         DE = 値 2 の先頭
8441                             ;   出力: 結果を HL の元の位置に上書き
8441                             ;   破壊: A, HL, DE
8441                             ; 
8441                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
8441                             ; ---------------------------------------------------------------
8441                SUB_VALUE16:      
8441   7E                     MOV   a,m   ; A = val1[lo]
8442   EB                     XCHG      ; HL=val2, DE=val1
8443   96                     SUB   m   ; A -= val2[lo]
8444   EB                     XCHG      ; HL=val1, DE=val2
8445   77                     MOV   m,a   ; val1[lo] = result
8446   23                     INX   h   
8447   13                     INX   d   
8448   7E                     MOV   a,m   ; A = val1[hi]
8449   EB                     XCHG      
844A   9E                     SBB   m   ; A -= val2[hi] - CY
844B   EB                     XCHG      
844C   77                     MOV   m,a   
844D   C9                     RET      
844E                             ; ---------------------------------------------------------------
844E                             ; cmp_value16 — 16 ビット符号付き比較
844E                             ; 
844E                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
844E                             ;         DE = 値 2 の先頭 (byte0 の位置)
844E                             ;   出力: A = 比較結果
844E                             ;           00h → val1 == val2
844E                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
844E                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
844E                             ;   破壊: A, B, HL, DE
844E                             ; 
844E                             ; 手順:
844E                             ;   1. 上位バイト (byte1) の符号ビットを比べる
844E                             ;   2. 符号が違えば、負の方が小さい
844E                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
844E                             ; ---------------------------------------------------------------
844E                CMP_VALUE16:      
844E                             ; byte1 (上位) の位置を求める
844E   23                     INX   h   ; HL = val1+1 (hi)
844F   13                     INX   d   ; DE = val2+1 (hi)
8450                             ; 符号ビットを比べる
8450   7E                     MOV   a,m   ; A = val1[hi]
8451   47                     MOV   b,a   ; B = val1[hi] (退避)
8452   1A                     LDAX   d   ; A = val2[hi]
8453   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
8454   F2 60 84               JP   cmp16_same_sign   
8457                             ; 符号が違う: val1 が負なら val1 < val2
8457   78                     MOV   a,b   ; A = val1[hi]
8458   E6 80                  ANI   80h   ; bit7 を取り出す
845A   C2 74 84               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
845D   C3 77 84               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
8460                CMP16_SAME_SIGN:      
8460                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
8460   1A                     LDAX   d   
8461   BE                     CMP   m   ; val2[hi] - val1[hi]
8462   DA 77 84               JC   cmp16_ret_pos   
8465   C2 74 84               JNZ   cmp16_ret_neg   
8468   2B                     DCX   h   
8469   1B                     DCX   d   
846A   1A                     LDAX   d   
846B   BE                     CMP   m   ; val2[lo] - val1[lo]
846C   DA 77 84               JC   cmp16_ret_pos   
846F   C2 74 84               JNZ   cmp16_ret_neg   
8472                             ; すべて等しい
8472   AF                     XRA   a   ; A = 00h
8473   C9                     RET      
8474                CMP16_RET_NEG:      
8474   3E FF                  MVI   a,0FFh   ; val1 < val2
8476   C9                     RET      
8477                CMP16_RET_POS:      
8477   3E 01                  MVI   a,01h   ; val1 > val2
8479   C9                     RET      
847A                             ; ---------------------------------------------------------------
847A                             ; calc_child_irep — 子 irep 番号を算出
847A                             ; 
847A                             ;   入力: A = 子インデックス (オペランド b)
847A                             ;   出力: A = irep 番号
847A                             ;   破壊: B, C, DE, HL
847A                             ; 
847A                             ; pos = cur_irep + 1 から開始し、b 個のサブツリーを
847A                             ; subtree_size で飛ばして目的の子 irep 番号を求める。
847A                             ; OP_BLOCK, OP_METHOD, OP_EXEC の共通サブルーチン。
847A                             ; レジスタのみ使用 (メモリ変数なし): B=残りカウント, C=pos。
847A                             ; ---------------------------------------------------------------
847A                CALC_CHILD_IREP:      
847A   47                     MOV   b,a   ; B = スキップ回数
847B   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
847E   3C                     INR   a   ; A = cur_irep + 1
847F   4F                     MOV   c,a   ; C = pos
8480   78                     MOV   a,b   
8481   B7                     ORA   a   
8482   CA 9C 84               JZ   cci_done   ; b == 0 → C をそのまま返す
8485                CCI_LOOP:      
8485                             ; HL = IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE + pos * 10
8485   79                     MOV   a,c   ; A = pos
8486   57                     MOV   d,a   ; D = pos (退避)
8487   87                     ADD   a   ; ×2
8488   5F                     MOV   e,a   ; E = ×2
8489   7A                     MOV   a,d   
848A   87                     ADD   a   ; ×2
848B   87                     ADD   a   ; ×4
848C   87                     ADD   a   ; ×8
848D   83                     ADD   e   ; ×10
848E   5F                     MOV   e,a   
848F   16 00                  MVI   d,0   
8491   21 07 82               LXI   h,IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE   
8494   19                     DAD   d   ; HL = &subtree_size[pos]
8495                             ; pos += subtree_size
8495   79                     MOV   a,c   
8496   86                     ADD   m   ; A = pos + subtree_size
8497   4F                     MOV   c,a   ; C = 新しい pos
8498   05                     DCR   b   
8499   C2 85 84               JNZ   cci_loop   
849C                CCI_DONE:      
849C   79                     MOV   a,c   ; A = 最終的な pos
849D   C9                     RET      
849E                             ; ---------------------------------------------------------------
849E                             ; class_of_reg — レジスタスロットからクラス番号を求める
849E                             ; 
849E                             ;   入力: HL = スロットアドレス
849E                             ;   出力: A = class_number
849E                             ;   破壊: B, DE, HL
849E                             ; 
849E                             ; - TT_CLASS  → val_lo (クラス自身の番号)
849E                             ; - TT_OBJECT, val_lo=0 → 0 (main)
849E                             ; - TT_OBJECT, val_lo>0 → OBJECT_POOL_BASE + (val-1)*32 のヘッダから読む
849E                             ; - その他 → 0 (main)
849E                             ; ---------------------------------------------------------------
849E                CLASS_OF_REG:      
849E   7E                     MOV   a,m   ; A = 型タグ
849F   FE 0D                  CPI   TT_CLASS   
84A1   CA AB 84               JZ   cor_class   
84A4   FE 0A                  CPI   TT_OBJECT   
84A6   CA AF 84               JZ   cor_object   
84A9                             ; その他 → main (class 0)
84A9   AF                     XRA   a   
84AA   C9                     RET      
84AB                COR_CLASS:      
84AB                             ; val_lo = class_number
84AB   23                     INX   h   
84AC   23                     INX   h   
84AD   7E                     MOV   a,m   ; A = val_lo = class_number
84AE   C9                     RET      
84AF                COR_OBJECT:      
84AF                             ; val_lo = slot+1 (0=main)
84AF   23                     INX   h   
84B0   23                     INX   h   
84B1   7E                     MOV   a,m   ; A = val_lo
84B2   B7                     ORA   a   
84B3   C8                     RZ      ; val_lo==0 → main (A=0)
84B4                             ; slot = val_lo - 1, ヘッダアドレス = OBJECT_POOL_BASE + slot * 32
84B4   3D                     DCR   a   ; A = slot
84B5                             ; × 32 = 5 回の add a
84B5   87                     ADD   a   ; ×2
84B6   87                     ADD   a   ; ×4
84B7   87                     ADD   a   ; ×8
84B8   87                     ADD   a   ; ×16
84B9   87                     ADD   a   ; ×32
84BA   5F                     MOV   e,a   
84BB   16 00                  MVI   d,0   
84BD   21 E0 B1               LXI   h,OBJECT_POOL_BASE   
84C0   19                     DAD   d   ; HL = スロット先頭
84C1   7E                     MOV   a,m   ; A = class_number (ヘッダ +0)
84C2   C9                     RET      
84C3                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
84C3                             ; 
84C3                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
84C3                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
84C3                             ; ---------------------------------------------------------------
84C3                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
84C3                             ; 
84C3                             ;   入力: なし
84C3                             ;   出力: A = 読んだバイト
84C3                             ;   破壊: HL, DE
84C3                             ; 
84C3                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
84C3                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
84C3                             ; 子 irep の先頭に変わります。
84C3                             ; ---------------------------------------------------------------
84C3                FETCH_BYTE:      
84C3   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
84C6   EB                     XCHG      ; DE = PC
84C7   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
84CA   19                     DAD   d   ; HL = 絶対アドレス
84CB   7E                     MOV   a,m   ; A = bytecode[PC]
84CC                             ; PC をインクリメント
84CC   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
84CF   23                     INX   h   
84D0   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
84D3   C9                     RET      
84D4                             ; ---------------------------------------------------------------
84D4                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
84D4                             ; 
84D4                             ;   入力: なし
84D4                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
84D4                             ;   破壊: A, B, DE
84D4                             ; 
84D4                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
84D4                             ; 1 バイト目が上位、2 バイト目が下位。
84D4                             ; ---------------------------------------------------------------
84D4                FETCH_U16BE:      
84D4   CD C3 84               CALL   fetch_byte   ; A = 上位バイト
84D7   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
84D8   CD C3 84               CALL   fetch_byte   ; A = 下位バイト
84DB   6F                     MOV   l,a   
84DC   60                     MOV   h,b   
84DD   C9                     RET      
84DE                             ; ---------------------------------------------------------------
84DE                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
84DE                             ; 
84DE                             ;   入力: なし
84DE                             ;   出力: HL = 読んだ符号付き 16 ビット値
84DE                             ;   破壊: A, DE
84DE                             ; 
84DE                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
84DE                             ; ---------------------------------------------------------------
84DE                FETCH_S16BE:      
84DE   C3 D4 84               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
84E1                             ; vm_load.a80 — ロード命令
84E1                             ; 
84E1                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
84E1                             ; 
84E1                             ; Phase 2: 16 ビットスロット (4 バイト)
84E1                             ;   set_slot_int16: B=val_hi, C=val_lo
84E1                             ; ---------------------------------------------------------------
84E1                             ; OP_NOP (Z): 何もしない
84E1                             ; ---------------------------------------------------------------
84E1                DO_OP_NOP:      
84E1   C3 89 8F               JMP   vm_loop   
84E4                             ; ---------------------------------------------------------------
84E4                             ; OP_MOVE (BB): R[a] = R[b]
84E4                             ; ---------------------------------------------------------------
84E4                DO_OP_MOVE:      
84E4   CD C3 84               CALL   fetch_byte   ; A = a (コピー先)
84E7   F5                     PUSH   psw   
84E8   CD C3 84               CALL   fetch_byte   ; A = b (コピー元)
84EB   CD 03 84               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
84EE   EB                     XCHG      ; DE = R[b]
84EF   F1                     POP   psw   ; A = a
84F0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84F3   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
84F4   CD 28 84               CALL   copy_slot   
84F7   C3 89 8F               JMP   vm_loop   
84FA                             ; ---------------------------------------------------------------
84FA                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
84FA                             ; ---------------------------------------------------------------
84FA                DO_OP_LOADI:      
84FA   CD C3 84               CALL   fetch_byte   ; A = a
84FD   F5                     PUSH   psw   
84FE   CD C3 84               CALL   fetch_byte   ; A = b (値)
8501   4F                     MOV   c,a   ; C = val_lo
8502   F1                     POP   psw   ; A = a
8503   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8506   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
8507   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
8509   CD 13 84               CALL   set_slot_int16   
850C   C3 89 8F               JMP   vm_loop   
850F                             ; ---------------------------------------------------------------
850F                             ; OP_LOADINEG (BB): R[a] = -b
850F                             ; ---------------------------------------------------------------
850F                DO_OP_LOADINEG:      
850F   CD C3 84               CALL   fetch_byte   ; A = a
8512   F5                     PUSH   psw   
8513   CD C3 84               CALL   fetch_byte   ; A = b
8516                             ; -b を計算 (0 - b)
8516   4F                     MOV   c,a   ; C = b (退避)
8517   AF                     XRA   a   ; A = 0
8518   91                     SUB   c   ; A = -b
8519   4F                     MOV   c,a   ; C = val_lo (-b)
851A   F1                     POP   psw   ; A = a
851B   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
851E   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
8520   CD 13 84               CALL   set_slot_int16   
8523   C3 89 8F               JMP   vm_loop   
8526                             ; ---------------------------------------------------------------
8526                             ; OP_LOADI__1 (B): R[a] = -1
8526                             ; ---------------------------------------------------------------
8526                DO_OP_LOADI__1:      
8526   CD C3 84               CALL   fetch_byte   ; A = a
8529   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
852C   0E FF                  MVI   c,0FFh   ; val_lo = FFh
852E   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
8530   CD 13 84               CALL   set_slot_int16   
8533   C3 89 8F               JMP   vm_loop   
8536                             ; ---------------------------------------------------------------
8536                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
8536                             ; ---------------------------------------------------------------
8536                DO_OP_LOADI_0:      
8536   0E 00                  MVI   c,0   
8538   C3 5B 85               JMP   loadi_small   
853B                DO_OP_LOADI_1:      
853B   0E 01                  MVI   c,1   
853D   C3 5B 85               JMP   loadi_small   
8540                DO_OP_LOADI_2:      
8540   0E 02                  MVI   c,2   
8542   C3 5B 85               JMP   loadi_small   
8545                DO_OP_LOADI_3:      
8545   0E 03                  MVI   c,3   
8547   C3 5B 85               JMP   loadi_small   
854A                DO_OP_LOADI_4:      
854A   0E 04                  MVI   c,4   
854C   C3 5B 85               JMP   loadi_small   
854F                DO_OP_LOADI_5:      
854F   0E 05                  MVI   c,5   
8551   C3 5B 85               JMP   loadi_small   
8554                DO_OP_LOADI_6:      
8554   0E 06                  MVI   c,6   
8556   C3 5B 85               JMP   loadi_small   
8559                DO_OP_LOADI_7:      
8559   0E 07                  MVI   c,7   
855B                LOADI_SMALL:      
855B                             ; C = 即値 (0-7)
855B   CD C3 84               CALL   fetch_byte   ; A = a
855E   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8561   06 00                  MVI   b,0   ; val_hi = 0 (正)
8563   CD 13 84               CALL   set_slot_int16   
8566   C3 89 8F               JMP   vm_loop   
8569                             ; ---------------------------------------------------------------
8569                             ; OP_LOADI16 (BS): R[a] = signed16(b)
8569                             ; 
8569                             ; b は符号付き 16 ビット (ビッグエンディアン)。
8569                             ; 16 ビットスロットではそのままネイティブサイズ。
8569                             ; 符号拡張は不要。
8569                             ; ---------------------------------------------------------------
8569                DO_OP_LOADI16:      
8569   CD C3 84               CALL   fetch_byte   ; A = a
856C   F5                     PUSH   psw   
856D   CD DE 84               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
8570   4D                     MOV   c,l   ; C = val_lo
8571   44                     MOV   b,h   ; B = val_hi
8572   F1                     POP   psw   ; A = a
8573   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8576                             ; 型タグと値を書く
8576   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
8578   23                     INX   h   
8579   36 00                  MVI   m,0   ; +1: 予約
857B   23                     INX   h   
857C   71                     MOV   m,c   ; +2: val_lo
857D   23                     INX   h   
857E   70                     MOV   m,b   ; +3: val_hi
857F   C3 89 8F               JMP   vm_loop   
8582                             ; ---------------------------------------------------------------
8582                             ; OP_LOADNIL (B): R[a] = nil
8582                             ; ---------------------------------------------------------------
8582                DO_OP_LOADNIL:      
8582   CD C3 84               CALL   fetch_byte   ; A = a
8585   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8588   3E 01                  MVI   a,TT_NIL   
858A   CD 1D 84               CALL   set_slot_special   
858D   C3 89 8F               JMP   vm_loop   
8590                             ; ---------------------------------------------------------------
8590                             ; OP_LOADT (B): R[a] = true
8590                             ; ---------------------------------------------------------------
8590                DO_OP_LOADT:      
8590   CD C3 84               CALL   fetch_byte   ; A = a
8593   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8596   3E 03                  MVI   a,TT_TRUE   
8598   CD 1D 84               CALL   set_slot_special   
859B   C3 89 8F               JMP   vm_loop   
859E                             ; ---------------------------------------------------------------
859E                             ; OP_LOADF (B): R[a] = false
859E                             ; ---------------------------------------------------------------
859E                DO_OP_LOADF:      
859E   CD C3 84               CALL   fetch_byte   ; A = a
85A1   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85A4   3E 02                  MVI   a,TT_FALSE   
85A6   CD 1D 84               CALL   set_slot_special   
85A9   C3 89 8F               JMP   vm_loop   
85AC                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
85AC                             ; 
85AC                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
85AC                             ; ---------------------------------------------------------------
85AC                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
85AC                             ; 
85AC                             ; R[a] の型で分岐:
85AC                             ;   TT_INTEGER: 16 ビット加算
85AC                             ;   TT_STRING:  文字列連結 (STRCAT と同じ)
85AC                             ; ---------------------------------------------------------------
85AC                DO_OP_ADD:      
85AC   CD C3 84               CALL   fetch_byte   ; A = a
85AF   F5                     PUSH   psw   
85B0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85B3   7E                     MOV   a,m   ; A = 型タグ
85B4   FE 07                  CPI   TT_STRING   
85B6   CA CF 85               JZ   add_string   
85B9                             ; --- 整数パス ---
85B9   F1                     POP   psw   ; A = a
85BA   F5                     PUSH   psw   
85BB                             ; R[a+1] のスロットアドレスを求める
85BB   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85BE   CD 35 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
85C1   EB                     XCHG      ; DE = R[a+1] の値先頭
85C2   F1                     POP   psw   ; A = a
85C3                             ; R[a] のスロットアドレスを求める
85C3   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85C6   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85C9                             ; 16 ビット加算: val[a] += val[a+1]
85C9   CD 38 84               CALL   add_value16   
85CC   C3 89 8F               JMP   vm_loop   
85CF                             ; --- 文字列パス ---
85CF                ADD_STRING:      
85CF   F1                     POP   psw   ; A = a
85D0   32 E0 AE               STA   scat_reg_a   
85D3   C3 70 AE               JMP   strcat_body   ; do_op_strcat の本体を再利用
85D6                             ; ---------------------------------------------------------------
85D6                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
85D6                             ; ---------------------------------------------------------------
85D6                DO_OP_SUB:      
85D6   CD C3 84               CALL   fetch_byte   ; A = a
85D9   F5                     PUSH   psw   
85DA   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85DD   CD 35 84               CALL   slot_to_value   
85E0   EB                     XCHG      ; DE = R[a+1] の値先頭
85E1   F1                     POP   psw   ; A = a
85E2   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85E5   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85E8   CD 41 84               CALL   sub_value16   
85EB   C3 89 8F               JMP   vm_loop   
85EE                             ; ---------------------------------------------------------------
85EE                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
85EE                             ; 
85EE                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
85EE                             ; ---------------------------------------------------------------
85EE                DO_OP_ADDI:      
85EE   CD C3 84               CALL   fetch_byte   ; A = a
85F1   F5                     PUSH   psw   
85F2   CD C3 84               CALL   fetch_byte   ; A = b (即値)
85F5   4F                     MOV   c,a   ; C = b
85F6   F1                     POP   psw   ; A = a
85F7   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85FA   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85FD   7E                     MOV   a,m   ; val_lo
85FE   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
85FF   77                     MOV   m,a   
8600   23                     INX   h   
8601   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
8602   CE 00                  ACI   0   ; val_hi + CY
8604   77                     MOV   m,a   
8605   C3 89 8F               JMP   vm_loop   
8608                             ; ---------------------------------------------------------------
8608                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
8608                             ; ---------------------------------------------------------------
8608                DO_OP_SUBI:      
8608   CD C3 84               CALL   fetch_byte   ; A = a
860B   F5                     PUSH   psw   
860C   CD C3 84               CALL   fetch_byte   ; A = b (即値)
860F   4F                     MOV   c,a   ; C = b
8610   F1                     POP   psw   ; A = a
8611   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8614   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
8617   7E                     MOV   a,m   ; val_lo
8618   91                     SUB   c   ; val_lo - b (CY = 借り)
8619   77                     MOV   m,a   
861A   23                     INX   h   
861B   7E                     MOV   a,m   ; val_hi
861C   DE 00                  SBI   0   ; val_hi - CY
861E   77                     MOV   m,a   
861F   C3 89 8F               JMP   vm_loop   
8622                             ; ---------------------------------------------------------------
8622                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
8622                             ; 
8622                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
8622                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
8622                             ; ---------------------------------------------------------------
8622                DO_OP_MUL:      
8622   CD C3 84               CALL   fetch_byte   ; A = a
8625   F5                     PUSH   psw   
8626   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8629   CD 35 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
862C   5E                     MOV   e,m   ; E = val2_lo
862D   23                     INX   h   
862E   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
862F   F1                     POP   psw   ; A = a
8630   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8633   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8636   E5                     PUSH   h   ; 書き戻し先を退避
8637   4E                     MOV   c,m   
8638   23                     INX   h   
8639   46                     MOV   b,m   ; BC = 被乗数
863A   CD 71 86               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
863D   D1                     POP   d   ; DE = 書き戻し先
863E   7D                     MOV   a,l   
863F   12                     STAX   d   
8640   13                     INX   d   
8641   7C                     MOV   a,h   
8642   12                     STAX   d   
8643   C3 89 8F               JMP   vm_loop   
8646                             ; ---------------------------------------------------------------
8646                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
8646                             ; 
8646                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
8646                             ; 除数 0 はエラー停止。
8646                             ; ---------------------------------------------------------------
8646                DO_OP_DIV:      
8646   CD C3 84               CALL   fetch_byte   ; A = a
8649   F5                     PUSH   psw   
864A   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
864D   CD 35 84               CALL   slot_to_value   
8650   5E                     MOV   e,m   
8651   23                     INX   h   
8652   56                     MOV   d,m   ; DE = 除数
8653                             ; ゼロ除算チェック
8653   7A                     MOV   a,d   
8654   B3                     ORA   e   
8655   C2 5C 86               JNZ   do_div_nonzero   
8658   F1                     POP   psw   
8659   C3 03 00               JMP   vm_error   
865C                DO_DIV_NONZERO:      
865C   F1                     POP   psw   ; A = a
865D   CD 03 84               CALL   get_reg_addr   
8660   CD 35 84               CALL   slot_to_value   
8663   E5                     PUSH   h   ; 書き戻し先を退避
8664   4E                     MOV   c,m   
8665   23                     INX   h   
8666   46                     MOV   b,m   ; BC = 被除数
8667   CD 83 86               CALL   sdiv16   ; BC = 商
866A   E1                     POP   h   ; HL = 書き戻し先
866B   71                     MOV   m,c   
866C   23                     INX   h   
866D   70                     MOV   m,b   
866E   C3 89 8F               JMP   vm_loop   
8671                             ; ---------------------------------------------------------------
8671                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
8671                             ; 
8671                             ;   入力: BC = 被乗数, DE = 乗数
8671                             ;   出力: HL = 積の下位 16 ビット
8671                             ;   破壊: A, DE
8671                             ; ---------------------------------------------------------------
8671                UMUL16:      
8671   21 00 00               LXI   h,0   ; 積 = 0
8674   3E 10                  MVI   a,16   ; ビットカウンタ
8676                UMUL16_LOOP:      
8676   29                     DAD   h   ; 積 <<= 1
8677   EB                     XCHG      ; HL ↔ DE
8678   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
8679   EB                     XCHG      ; HL ↔ DE
867A   D2 7E 86               JNC   umul16_noadd   
867D   09                     DAD   b   ; 積 += 被乗数
867E                UMUL16_NOADD:      
867E   3D                     DCR   a   
867F   C2 76 86               JNZ   umul16_loop   
8682   C9                     RET      
8683                             ; ---------------------------------------------------------------
8683                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
8683                             ; 
8683                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
8683                             ;   出力: BC = 商
8683                             ;   破壊: A, DE, HL
8683                             ; 
8683                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
8683                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
8683                             ; ---------------------------------------------------------------
8683                SDIV16:      
8683   78                     MOV   a,b   
8684   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
8685   F5                     PUSH   psw   ; 符号情報を退避
8686                             ; 被除数を正にする
8686   78                     MOV   a,b   
8687   E6 80                  ANI   80h   
8689   CA 8F 86               JZ   sdiv16_chk_div   
868C   CD DF 86               CALL   neg_bc   
868F                SDIV16_CHK_DIV:      
868F                             ; 除数を正にする
868F   7A                     MOV   a,d   
8690   E6 80                  ANI   80h   
8692   CA 98 86               JZ   sdiv16_do   
8695   CD E7 86               CALL   neg_de   
8698                SDIV16_DO:      
8698   CD A8 86               CALL   udiv16   ; BC = |商|, HL = |剰余|
869B   F1                     POP   psw   
869C   E6 80                  ANI   80h   
869E   C8                     RZ      ; 同符号 → 正の商をそのまま返す
869F                             ; 異符号: 剰余があれば floor 調整
869F   7C                     MOV   a,h   
86A0   B5                     ORA   l   
86A1   CA A5 86               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
86A4   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
86A5                SDIV16_NEG:      
86A5   C3 DF 86               JMP   neg_bc   
86A8                             ; ---------------------------------------------------------------
86A8                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
86A8                             ; 
86A8                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
86A8                             ;   出力: BC = 商, HL = 剰余
86A8                             ;   破壊: A
86A8                             ; 
86A8                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
86A8                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
86A8                             ; ---------------------------------------------------------------
86A8                UDIV16:      
86A8   21 00 00               LXI   h,0   ; 剰余 = 0
86AB   3E 10                  MVI   a,16   
86AD   32 DE 86               STA   udiv_cnt   
86B0                UDIV16_LOOP:      
86B0                             ; BC を 1 ビット左シフト (MSB → CY)
86B0   79                     MOV   a,c   
86B1   87                     ADD   a   ; C <<= 1, bit7 → CY
86B2   4F                     MOV   c,a   
86B3   78                     MOV   a,b   
86B4   8F                     ADC   a   ; B <<= 1 + CY from C
86B5   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
86B6                             ; CY を剰余 (HL) にシフトイン
86B6   7D                     MOV   a,l   
86B7   17                     RAL      
86B8   6F                     MOV   l,a   
86B9   7C                     MOV   a,h   
86BA   17                     RAL      
86BB   67                     MOV   h,a   
86BC                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
86BC   DA CC 86               JC   udiv16_sub   
86BF                             ; 剰余 (HL) と 除数 (DE) を比較
86BF   7C                     MOV   a,h   
86C0   BA                     CMP   d   
86C1   DA D3 86               JC   udiv16_nosub   ; H < D → HL < DE
86C4   C2 CC 86               JNZ   udiv16_sub   ; H > D → HL > DE
86C7   7D                     MOV   a,l   
86C8   BB                     CMP   e   
86C9   DA D3 86               JC   udiv16_nosub   ; L < E → HL < DE
86CC                UDIV16_SUB:      
86CC                             ; 剰余 ≧ 除数: 減算して商ビット = 1
86CC   7D                     MOV   a,l   
86CD   93                     SUB   e   
86CE   6F                     MOV   l,a   
86CF   7C                     MOV   a,h   
86D0   9A                     SBB   d   
86D1   67                     MOV   h,a   
86D2   0C                     INR   c   ; 商の bit0 を立てる
86D3                UDIV16_NOSUB:      
86D3   3A DE 86               LDA   udiv_cnt   ; LDA は CY に影響しない
86D6   3D                     DCR   a   ; DCR は CY に影響しない
86D7   32 DE 86               STA   udiv_cnt   
86DA   C2 B0 86               JNZ   udiv16_loop   
86DD   C9                     RET      
86DE                UDIV_CNT:      
86DE   00                     DB   0   
86DF                             ; ---------------------------------------------------------------
86DF                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
86DF                             ; ---------------------------------------------------------------
86DF                NEG_BC:      
86DF   79                     MOV   a,c   
86E0   2F                     CMA      
86E1   4F                     MOV   c,a   
86E2   78                     MOV   a,b   
86E3   2F                     CMA      
86E4   47                     MOV   b,a   
86E5   03                     INX   b   
86E6   C9                     RET      
86E7                NEG_DE:      
86E7   7B                     MOV   a,e   
86E8   2F                     CMA      
86E9   5F                     MOV   e,a   
86EA   7A                     MOV   a,d   
86EB   2F                     CMA      
86EC   57                     MOV   d,a   
86ED   13                     INX   d   
86EE   C9                     RET      
86EF                             ; vm_compare.a80 — 比較命令
86EF                             ; 
86EF                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
86EF                             ; 
86EF                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
86EF                             ; Phase 2 は整数のみ。
86EF                             ; 
86EF                             ; cmp_value16 は結果を A で返す:
86EF                             ;   A = 00h → 等しい
86EF                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
86EF                             ;   A = 01h → val1 > val2
86EF                             ; 
86EF                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
86EF                             ; ---------------------------------------------------------------
86EF                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
86EF                             ; 
86EF                             ;   出力: A = 比較結果 (00h/FFh/01h)
86EF                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
86EF                             ;   破壊: A, B, HL, DE
86EF                             ; ---------------------------------------------------------------
86EF                CMP_REG_PAIR:      
86EF   CD C3 84               CALL   fetch_byte   
86F2   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
86F5                             ; R[a+1] の値先頭
86F5   CD 0F 84               CALL   get_reg_addr_next   
86F8   CD 35 84               CALL   slot_to_value   
86FB   EB                     XCHG      ; DE = R[a+1] 値先頭
86FC                             ; R[a] の値先頭
86FC   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86FF   CD 03 84               CALL   get_reg_addr   
8702   CD 35 84               CALL   slot_to_value   ; HL = R[a] 値先頭
8705   CD 4E 84               CALL   cmp_value16   ; A = 結果
8708   C9                     RET      
8709                             ; ---------------------------------------------------------------
8709                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
8709                             ; 
8709                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
8709                             ; ---------------------------------------------------------------
8709                CMP_SET_TRUE:      
8709   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
870C   CD 03 84               CALL   get_reg_addr   
870F   3E 03                  MVI   a,TT_TRUE   
8711   CD 1D 84               CALL   set_slot_special   
8714   C3 89 8F               JMP   vm_loop   
8717                CMP_SET_FALSE:      
8717   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
871A   CD 03 84               CALL   get_reg_addr   
871D   3E 02                  MVI   a,TT_FALSE   
871F   CD 1D 84               CALL   set_slot_special   
8722   C3 89 8F               JMP   vm_loop   
8725                             ; ---------------------------------------------------------------
8725                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
8725                             ; 
8725                             ; 型タグと値の両方が一致したときだけ true。
8725                             ; ---------------------------------------------------------------
8725                DO_OP_EQ:      
8725   CD C3 84               CALL   fetch_byte   
8728   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
872B                             ; R[a] と R[a+1] のスロットアドレスを求める
872B   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
872E   E5                     PUSH   h   ; R[a] を退避
872F   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
8732   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8735   D1                     POP   d   ; DE = R[a]
8736                             ; HL = R[a+1], DE = R[a]
8736                             ; 型タグを比べる
8736   46                     MOV   b,m   ; B = R[a+1].type
8737   1A                     LDAX   d   ; A = R[a].type
8738   B8                     CMP   b   
8739   C2 17 87               JNZ   cmp_set_false   ; 型が違えば false
873C                             ; 型が同じ → 値を 2 バイト比べる
873C   23                     INX   h   
873D   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
873E   13                     INX   d   
873F   13                     INX   d   ; DE = R[a] + 2 (値先頭)
8740   1A                     LDAX   d   ; A = R[a].val_lo
8741   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
8742   C2 17 87               JNZ   cmp_set_false   
8745   23                     INX   h   
8746   13                     INX   d   
8747   1A                     LDAX   d   ; A = R[a].val_hi
8748   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
8749   C2 17 87               JNZ   cmp_set_false   
874C   C3 09 87               JMP   cmp_set_true   ; すべて一致
874F                             ; ---------------------------------------------------------------
874F                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
874F                             ; ---------------------------------------------------------------
874F                DO_OP_LT:      
874F   CD EF 86               CALL   cmp_reg_pair   ; A = 結果
8752   B7                     ORA   a   
8753   FA 09 87               JM   cmp_set_true   ; A = FFh → val1 < val2
8756   C3 17 87               JMP   cmp_set_false   
8759                             ; ---------------------------------------------------------------
8759                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
8759                             ; ---------------------------------------------------------------
8759                DO_OP_LE:      
8759   CD EF 86               CALL   cmp_reg_pair   
875C   B7                     ORA   a   
875D   FA 09 87               JM   cmp_set_true   ; val1 < val2
8760   CA 09 87               JZ   cmp_set_true   ; val1 == val2
8763   C3 17 87               JMP   cmp_set_false   
8766                             ; ---------------------------------------------------------------
8766                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
8766                             ; ---------------------------------------------------------------
8766                DO_OP_GT:      
8766   CD EF 86               CALL   cmp_reg_pair   
8769   B7                     ORA   a   
876A   CA 17 87               JZ   cmp_set_false   ; val1 == val2
876D   F2 09 87               JP   cmp_set_true   ; A = 01h → val1 > val2
8770   C3 17 87               JMP   cmp_set_false   ; A = FFh → val1 < val2
8773                             ; ---------------------------------------------------------------
8773                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
8773                             ; ---------------------------------------------------------------
8773                DO_OP_GE:      
8773   CD EF 86               CALL   cmp_reg_pair   
8776   B7                     ORA   a   
8777   FA 17 87               JM   cmp_set_false   ; val1 < val2
877A   C3 09 87               JMP   cmp_set_true   ; val1 >= val2
877D                             ; vm_jump.a80 — ジャンプ命令
877D                             ; 
877D                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
877D                             ; 
877D                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
877D                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
877D                             ; ---------------------------------------------------------------
877D                             ; apply_jump — PC に符号付きオフセットを加える
877D                             ; 
877D                             ;   入力: HL = 符号付き 16 ビットオフセット
877D                             ;   出力: なし (PC が更新される)
877D                             ;   破壊: A, HL, DE
877D                             ; ---------------------------------------------------------------
877D                APPLY_JUMP:      
877D   EB                     XCHG      ; DE = オフセット
877E   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
8781   19                     DAD   d   ; HL = PC + オフセット
8782   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8785   C9                     RET      
8786                             ; ---------------------------------------------------------------
8786                             ; OP_JMP (S): PC += signed16(a)
8786                             ; ---------------------------------------------------------------
8786                DO_OP_JMP:      
8786   CD DE 84               CALL   fetch_s16be   ; HL = オフセット
8789   CD 7D 87               CALL   apply_jump   
878C   C3 89 8F               JMP   vm_loop   
878F                             ; ---------------------------------------------------------------
878F                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
878F                             ; 
878F                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
878F                             ; ---------------------------------------------------------------
878F                DO_OP_JMPIF:      
878F   CD C3 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8792   F5                     PUSH   psw   
8793   CD DE 84               CALL   fetch_s16be   ; HL = オフセット
8796   E5                     PUSH   h   ; オフセットを退避
8797   D1                     POP   d   ; DE = オフセット
8798   F1                     POP   psw   ; A = a
8799   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
879C   CD 33 84               CALL   get_slot_type   ; A = 型タグ
879F   FE 03                  CPI   TT_FALSY_MAX + 1   
87A1   DA AB 87               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
87A4                             ; 真 → ジャンプする
87A4   EB                     XCHG      ; HL = オフセット (DE にあった)
87A5   CD 7D 87               CALL   apply_jump   
87A8   C3 89 8F               JMP   vm_loop   
87AB                JMPIF_SKIP:      
87AB   C3 89 8F               JMP   vm_loop   
87AE                             ; ---------------------------------------------------------------
87AE                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
87AE                             ; ---------------------------------------------------------------
87AE                DO_OP_JMPNOT:      
87AE   CD C3 84               CALL   fetch_byte   ; A = a
87B1   F5                     PUSH   psw   
87B2   CD DE 84               CALL   fetch_s16be   ; HL = オフセット
87B5   E5                     PUSH   h   
87B6   D1                     POP   d   ; DE = オフセット
87B7   F1                     POP   psw   ; A = a
87B8   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
87BB   CD 33 84               CALL   get_slot_type   ; A = 型タグ
87BE   FE 03                  CPI   TT_FALSY_MAX + 1   
87C0   D2 CA 87               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
87C3                             ; 偽 → ジャンプする
87C3   EB                     XCHG      ; HL = オフセット
87C4   CD 7D 87               CALL   apply_jump   
87C7   C3 89 8F               JMP   vm_loop   
87CA                JMPNOT_SKIP:      
87CA   C3 89 8F               JMP   vm_loop   
87CD                             ; vm_globals.a80 — グローバル変数・インスタンス変数アクセス
87CD                             ; 
87CD                             ; OP_GETGV, OP_SETGV, OP_GETIV, OP_SETIV
87CD                             ; 
87CD                             ; シンボルテーブル (SYM_TABLE_BASE) の 2 バイトエントリ (D,E) で振り分ける:
87CD                             ;   D >= 0x80      : グローバル変数アドレス (DE = アドレス)
87CD                             ;   D == 0x03      : インスタンス変数 (E = ivar_index)
87CD                             ;   D == 0, E == 0 : 未対応シンボル → エラー
87CD                             ; 
87CD                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
87CD                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
87CD                             ; ---------------------------------------------------------------
87CD                             ; OP_GETGV / OP_GETIV (BB): R[a] = global[symbols[b]]
87CD                             ; ---------------------------------------------------------------
87CD                DO_OP_GETGV:      
87CD   CD C3 84               CALL   fetch_byte   ; A = a (レジスタ番号)
87D0   F5                     PUSH   psw   
87D1   CD C3 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
87D4                             ; シンボルテーブルからエントリを取得
87D4   87                     ADD   a   ; A = b * 2
87D5   5F                     MOV   e,a   
87D6   16 00                  MVI   d,0   
87D8   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
87DB   19                     DAD   d   ; HL = &sym_table[b]
87DC   5E                     MOV   e,m   
87DD   23                     INX   h   
87DE   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
87DF                             ; D == SYM_KIND_IVAR → インスタンス変数
87DF   7A                     MOV   a,d   
87E0   FE 03                  CPI   SYM_KIND_IVAR   
87E2   CA FB 87               JZ   getiv_handler   
87E5                             ; アドレスが 0 なら未対応シンボル
87E5   7A                     MOV   a,d   
87E6   B3                     ORA   e   
87E7   C2 EE 87               JNZ   getgv_ok   
87EA   F1                     POP   psw   
87EB   C3 03 00               JMP   vm_error   
87EE                GETGV_OK:      
87EE   F1                     POP   psw   ; A = a
87EF   D5                     PUSH   d   ; グローバルアドレスを退避
87F0   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
87F3   EB                     XCHG      ; DE = R[a]
87F4   E1                     POP   h   ; HL = グローバルスロット (コピー元)
87F5   CD 28 84               CALL   copy_slot   ; [HL] → [DE]
87F8   C3 89 8F               JMP   vm_loop   
87FB                             ; --- IVAR GET ---
87FB                             ; E = ivar_index, スタックに a が積まれている
87FB                GETIV_HANDLER:      
87FB   7B                     MOV   a,e   
87FC   32 6F 88               STA   gv_ivar_idx   
87FF   CD 4C 88               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
8802   F1                     POP   psw   ; A = a
8803   E5                     PUSH   h   ; IVAR アドレスを退避
8804   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
8807   EB                     XCHG      ; DE = R[a]
8808   E1                     POP   h   ; HL = IVAR スロット (コピー元)
8809   CD 28 84               CALL   copy_slot   ; [HL] → [DE]
880C   C3 89 8F               JMP   vm_loop   
880F                             ; ---------------------------------------------------------------
880F                             ; OP_SETGV / OP_SETIV (BB): global[symbols[b]] = R[a]
880F                             ; ---------------------------------------------------------------
880F                DO_OP_SETGV:      
880F   CD C3 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8812   F5                     PUSH   psw   
8813   CD C3 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
8816   87                     ADD   a   
8817   5F                     MOV   e,a   
8818   16 00                  MVI   d,0   
881A   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
881D   19                     DAD   d   ; HL = &sym_table[b]
881E   5E                     MOV   e,m   
881F   23                     INX   h   
8820   56                     MOV   d,m   ; DE = エントリ値
8821                             ; D == SYM_KIND_IVAR → インスタンス変数
8821   7A                     MOV   a,d   
8822   FE 03                  CPI   SYM_KIND_IVAR   
8824   CA 3A 88               JZ   setiv_handler   
8827   7A                     MOV   a,d   
8828   B3                     ORA   e   
8829   C2 30 88               JNZ   setgv_ok   
882C   F1                     POP   psw   
882D   C3 03 00               JMP   vm_error   
8830                SETGV_OK:      
8830   F1                     POP   psw   ; A = a
8831   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
8834                             ; copy_slot: [HL] → [DE]
8834   CD 28 84               CALL   copy_slot   
8837   C3 89 8F               JMP   vm_loop   
883A                             ; --- IVAR SET ---
883A                             ; E = ivar_index, スタックに a が積まれている
883A                SETIV_HANDLER:      
883A   7B                     MOV   a,e   
883B   32 6F 88               STA   gv_ivar_idx   
883E   CD 4C 88               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
8841   EB                     XCHG      ; DE = IVAR スロット (コピー先)
8842   F1                     POP   psw   ; A = a
8843   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
8846   CD 28 84               CALL   copy_slot   ; [HL] → [DE]
8849   C3 89 8F               JMP   vm_loop   
884C                             ; ---------------------------------------------------------------
884C                             ; calc_ivar_addr — R[0] (self) から IVAR スロットアドレスを算出
884C                             ; 
884C                             ;   入力: gv_ivar_idx = ivar_index
884C                             ;   出力: HL = OBJECT_POOL_BASE + (val_lo-1)*32 + 4 + ivar_index*4
884C                             ;   破壊: A, B, DE
884C                             ; 
884C                             ; R[0].val_lo = slot+1 (TT_OBJECT)
884C                             ; ---------------------------------------------------------------
884C                CALC_IVAR_ADDR:      
884C                             ; R[0] の val_lo を読む
884C   3E 00                  MVI   a,0   
884E   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8851   23                     INX   h   
8852   23                     INX   h   
8853   7E                     MOV   a,m   ; A = val_lo (slot+1)
8854   3D                     DCR   a   ; A = slot
8855                             ; slot * 32
8855   87                     ADD   a   ; ×2
8856   87                     ADD   a   ; ×4
8857   87                     ADD   a   ; ×8
8858   87                     ADD   a   ; ×16
8859   87                     ADD   a   ; ×32
885A   5F                     MOV   e,a   
885B   16 00                  MVI   d,0   
885D   21 E0 B1               LXI   h,OBJECT_POOL_BASE   
8860   19                     DAD   d   ; HL = スロット先頭
8861                             ; + OBJECT_HEADER_SIZE (4)
8861   11 04 00               LXI   d,OBJECT_HEADER_SIZE   
8864   19                     DAD   d   
8865                             ; + ivar_index * 4
8865   3A 6F 88               LDA   gv_ivar_idx   
8868   87                     ADD   a   ; ×2
8869   87                     ADD   a   ; ×4
886A   5F                     MOV   e,a   
886B   16 00                  MVI   d,0   
886D   19                     DAD   d   ; HL = IVAR スロットアドレス
886E   C9                     RET      
886F   00           GV_IVAR_IDX:   DB   0   
8870                             ; vm_send.a80 — メソッド呼び出し
8870                             ; 
8870                             ; OP_SEND, OP_SSEND
8870                             ; 
8870                             ; シンボルテーブルの 2 バイトエントリで振り分ける:
8870                             ;   D=0x00, E=1-31 : 組み込みメソッド
8870                             ;   D=0x01, E=id   : ユーザー定義メソッド
8870                             ;   D>=0x80         : グローバルアドレス (メソッドではない → エラー)
8870                             ; ---------------------------------------------------------------
8870                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
8870                             ; 
8870                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
8870                             ; ---------------------------------------------------------------
8870                DO_OP_SSEND:      
8870   CD C3 84               CALL   fetch_byte   ; A = a
8873   F5                     PUSH   psw   
8874   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
8877   EB                     XCHG      ; DE = R[a]
8878   AF                     XRA   a   ; A = 0
8879   CD 03 84               CALL   get_reg_addr   ; HL = R[0] (self)
887C   CD 28 84               CALL   copy_slot   ; R[a] = R[0]
887F   F1                     POP   psw   ; A = a
8880   32 58 8A               STA   send_reg_a   
8883   CD C3 84               CALL   fetch_byte   ; A = b (シンボル)
8886   F5                     PUSH   psw   
8887   CD C3 84               CALL   fetch_byte   ; A = c (argc)
888A   32 59 8A               STA   send_argc   
888D   F1                     POP   psw   ; A = b
888E   C3 A2 88               JMP   send_dispatch   
8891                             ; ---------------------------------------------------------------
8891                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
8891                             ; ---------------------------------------------------------------
8891                DO_OP_SEND:      
8891   CD C3 84               CALL   fetch_byte   ; A = a
8894   32 58 8A               STA   send_reg_a   
8897   CD C3 84               CALL   fetch_byte   ; A = b (シンボル)
889A   F5                     PUSH   psw   
889B   CD C3 84               CALL   fetch_byte   ; A = c (argc)
889E   32 59 8A               STA   send_argc   
88A1   F1                     POP   psw   ; A = b
88A2                SEND_DISPATCH:      
88A2                             ; シンボルテーブルからメソッド ID を取得
88A2   87                     ADD   a   ; b * 2
88A3   5F                     MOV   e,a   
88A4   16 00                  MVI   d,0   
88A6   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
88A9   19                     DAD   d   
88AA   5E                     MOV   e,m   
88AB   23                     INX   h   
88AC   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=id)
88AD                             ; D で振り分け
88AD   7A                     MOV   a,d   
88AE   B7                     ORA   a   
88AF   CA BA 88               JZ   send_builtin   ; D=0x00 → 組み込みメソッド
88B2   FE 01                  CPI   SYM_KIND_USER_METHOD   
88B4   CA E5 88               JZ   send_user_method   ; D=0x01 → ユーザー定義メソッド
88B7                             ; D >= 0x80 or other → エラー
88B7   C3 03 00               JMP   vm_error   
88BA                SEND_BUILTIN:      
88BA                             ; E = メソッド ID (0 = 未対応)
88BA   7B                     MOV   a,e   
88BB   B7                     ORA   a   
88BC   CA 03 00               JZ   vm_error   
88BF                             ; 組み込みメソッドディスパッチ
88BF   FE 01                  CPI   1   
88C1   CA B3 89               JZ   send_ne   ; != (不等号)
88C4   FE 02                  CPI   2   
88C6   CA E8 89               JZ   send_not   ; !  (論理否定)
88C9   FE 03                  CPI   3   
88CB   CA 10 8A               JZ   send_mod   ; %  (剰余)
88CE   FE 04                  CPI   4   
88D0   CA 3B 8A               JZ   send_abs   ; abs (絶対値)
88D3   FE 1C                  CPI   METHOD_NEW   
88D5   CA 28 89               JZ   send_new   ; Class#new
88D8   FE 1D                  CPI   METHOD_DISPLAY   
88DA   CA D7 A9               JZ   send_display   ; display(value)
88DD   FE 1E                  CPI   METHOD_GETKEY   
88DF   CA F2 A9               JZ   send_getkey   ; getkey
88E2   C3 2D AA               JMP   send_builtin_ext   ; 拡張ビルトイン (0xA800+ 領域)
88E5                             ; ---------------------------------------------------------------
88E5                             ; send_user_method — ユーザー定義メソッド呼び出し
88E5                             ; 
88E5                             ; E = method_id。メソッド表から irep 番号を引き、
88E5                             ; push_frame + switch_irep で呼び出す。
88E5                             ; ---------------------------------------------------------------
88E5                SEND_USER_METHOD:      
88E5                             ; method_id を退避
88E5   7B                     MOV   a,e   
88E6   32 26 89               STA   sum_method_id   
88E9                             ; R[a] から class_number を取得
88E9   3A 58 8A               LDA   send_reg_a   
88EC   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
88EF   CD 9E 84               CALL   class_of_reg   ; A = class_number
88F2                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
88F2   87                     ADD   a   ; ×2
88F3   87                     ADD   a   ; ×4
88F4   87                     ADD   a   ; ×8
88F5   87                     ADD   a   ; ×16
88F6   87                     ADD   a   ; ×32
88F7   5F                     MOV   e,a   
88F8   16 00                  MVI   d,0   
88FA   21 60 B1               LXI   h,METHOD_TABLE_BASE   
88FD   19                     DAD   d   
88FE   3A 26 89               LDA   sum_method_id   
8901   5F                     MOV   e,a   
8902   16 00                  MVI   d,0   
8904   19                     DAD   d   ; HL = メソッド表エントリ
8905   7E                     MOV   a,m   ; A = irep 番号
8906   B7                     ORA   a   
8907   CA 03 00               JZ   vm_error   ; 0 = 未定義
890A   32 27 89               STA   sum_irep   
890D                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
890D   3A 58 8A               LDA   send_reg_a   
8910   06 00                  MVI   b,FRAME_KIND_CALL   
8912   0E FF                  MVI   c,FRAME_NONE   
8914   CD A7 8A               CALL   push_frame   
8917                             ; 子 irep に切り替え
8917   3A 27 89               LDA   sum_irep   
891A   CD 2C 8B               CALL   switch_irep   
891D                             ; PC = 0
891D   21 00 00               LXI   h,0   
8920   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8923   C3 89 8F               JMP   vm_loop   
8926   00           SUM_METHOD_ID:   DB   0   
8927   00           SUM_IREP:   DB   0   
8928                             ; ---------------------------------------------------------------
8928                             ; send_new — Class#new (オブジェクト生成)
8928                             ; 
8928                             ; 1. オブジェクトプールにスロットを確保
8928                             ; 2. R[a] を TT_OBJECT に設定 (val_lo = slot+1)
8928                             ; 3. initialize メソッドがあれば呼び出す
8928                             ; ---------------------------------------------------------------
8928                SEND_NEW:      
8928                             ; OBJ_SP < MAX_OBJECTS を確認
8928   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
892B   FE 08                  CPI   MAX_OBJECTS   
892D   D2 03 00               JNC   vm_error   ; オブジェクトプール満杯
8930                             ; R[a] (TT_CLASS) から class_number を取得
8930   32 AF 89               STA   sn_slot   ; OBJ_SP = slot 番号
8933   3A 58 8A               LDA   send_reg_a   
8936   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8939   CD 35 84               CALL   slot_to_value   
893C   7E                     MOV   a,m   ; A = class_number
893D   32 B0 89               STA   sn_class_num   
8940                             ; オブジェクトプールにヘッダを書く
8940                             ; OBJECT_POOL_BASE + slot * 32
8940   3A AF 89               LDA   sn_slot   
8943   87                     ADD   a   ; ×2
8944   87                     ADD   a   ; ×4
8945   87                     ADD   a   ; ×8
8946   87                     ADD   a   ; ×16
8947   87                     ADD   a   ; ×32
8948   5F                     MOV   e,a   
8949   16 00                  MVI   d,0   
894B   21 E0 B1               LXI   h,OBJECT_POOL_BASE   
894E   19                     DAD   d   ; HL = スロット先頭
894F   3A B0 89               LDA   sn_class_num   
8952   77                     MOV   m,a   ; +0: class_number
8953                             ; R[a] = TT_OBJECT, val_lo = slot+1
8953   3A 58 8A               LDA   send_reg_a   
8956   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8959   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
895B   23                     INX   h   
895C   36 00                  MVI   m,0   ; +1: 予約
895E   23                     INX   h   
895F   3A AF 89               LDA   sn_slot   
8962   3C                     INR   a   ; slot + 1
8963   77                     MOV   m,a   ; +2: val_lo
8964   23                     INX   h   
8965   36 00                  MVI   m,0   ; +3: val_hi = 0
8967                             ; OBJ_SP++
8967   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
896A   3C                     INR   a   
896B   32 1B 80               STA   VM_STATE_BASE + OFF_OBJ_SP   
896E                             ; initialize メソッドがあれば呼び出す
896E   3A 1C 80               LDA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
8971   B7                     ORA   a   
8972   CA 89 8F               JZ   vm_loop   ; INIT_METHOD_ID=0 → initialize なし
8975                             ; method_table[class * 32 + init_id] を引く
8975   32 B1 89               STA   sn_init_id   
8978   3A B0 89               LDA   sn_class_num   
897B   87                     ADD   a   
897C   87                     ADD   a   
897D   87                     ADD   a   
897E   87                     ADD   a   
897F   87                     ADD   a   ; class * 32
8980   5F                     MOV   e,a   
8981   16 00                  MVI   d,0   
8983   21 60 B1               LXI   h,METHOD_TABLE_BASE   
8986   19                     DAD   d   
8987   3A B1 89               LDA   sn_init_id   
898A   5F                     MOV   e,a   
898B   16 00                  MVI   d,0   
898D   19                     DAD   d   ; HL = メソッド表エントリ
898E   7E                     MOV   a,m   ; A = irep 番号
898F   B7                     ORA   a   
8990   CA 89 8F               JZ   vm_loop   ; 未定義 → 呼ばない
8993   32 B2 89               STA   sn_init_irep   
8996                             ; push_frame(a, FRAME_KIND_NEW, FRAME_NONE)
8996   3A 58 8A               LDA   send_reg_a   
8999   06 05                  MVI   b,FRAME_KIND_NEW   
899B   0E FF                  MVI   c,FRAME_NONE   
899D   CD A7 8A               CALL   push_frame   
89A0                             ; 子 irep に切り替え
89A0   3A B2 89               LDA   sn_init_irep   
89A3   CD 2C 8B               CALL   switch_irep   
89A6                             ; PC = 0
89A6   21 00 00               LXI   h,0   
89A9   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
89AC   C3 89 8F               JMP   vm_loop   
89AF   00           SN_SLOT:   DB   0   
89B0   00           SN_CLASS_NUM:   DB   0   
89B1   00           SN_INIT_ID:   DB   0   
89B2   00           SN_INIT_IREP:   DB   0   
89B3                             ; ---------------------------------------------------------------
89B3                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
89B3                             ; 
89B3                             ; スロット全体 (4 バイト) をバイト比較する。
89B3                             ; 型タグも含めて比較するので異なる型は常に true。
89B3                             ; ---------------------------------------------------------------
89B3                SEND_NE:      
89B3   3A 58 8A               LDA   send_reg_a   
89B6   F5                     PUSH   psw   
89B7   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
89BA   EB                     XCHG      ; DE = R[a+1]
89BB   F1                     POP   psw   
89BC   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
89BF   0E 04                  MVI   c,SLOT_BYTES   
89C1                SEND_NE_CMP:      
89C1   1A                     LDAX   d   
89C2   BE                     CMP   m   
89C3   C2 DA 89               JNZ   send_ne_diff   
89C6   23                     INX   h   
89C7   13                     INX   d   
89C8   0D                     DCR   c   
89C9   C2 C1 89               JNZ   send_ne_cmp   
89CC                             ; 全バイト一致 → 等しい → false
89CC   3A 58 8A               LDA   send_reg_a   
89CF   CD 03 84               CALL   get_reg_addr   
89D2   3E 02                  MVI   a,TT_FALSE   
89D4   CD 1D 84               CALL   set_slot_special   
89D7   C3 89 8F               JMP   vm_loop   
89DA                SEND_NE_DIFF:      
89DA   3A 58 8A               LDA   send_reg_a   
89DD   CD 03 84               CALL   get_reg_addr   
89E0   3E 03                  MVI   a,TT_TRUE   
89E2   CD 1D 84               CALL   set_slot_special   
89E5   C3 89 8F               JMP   vm_loop   
89E8                             ; ---------------------------------------------------------------
89E8                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
89E8                             ; 
89E8                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
89E8                             ; ---------------------------------------------------------------
89E8                SEND_NOT:      
89E8   3A 58 8A               LDA   send_reg_a   
89EB   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
89EE   7E                     MOV   a,m   ; A = 型タグ
89EF   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
89F1   DA 02 8A               JC   send_not_falsy   
89F4                             ; 真だった → false
89F4   3A 58 8A               LDA   send_reg_a   
89F7   CD 03 84               CALL   get_reg_addr   
89FA   3E 02                  MVI   a,TT_FALSE   
89FC   CD 1D 84               CALL   set_slot_special   
89FF   C3 89 8F               JMP   vm_loop   
8A02                SEND_NOT_FALSY:      
8A02                             ; 偽だった → true
8A02   3A 58 8A               LDA   send_reg_a   
8A05   CD 03 84               CALL   get_reg_addr   
8A08   3E 03                  MVI   a,TT_TRUE   
8A0A   CD 1D 84               CALL   set_slot_special   
8A0D   C3 89 8F               JMP   vm_loop   
8A10                             ; ---------------------------------------------------------------
8A10                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
8A10                             ; ---------------------------------------------------------------
8A10                SEND_MOD:      
8A10   3A 58 8A               LDA   send_reg_a   
8A13   F5                     PUSH   psw   
8A14   CD 0F 84               CALL   get_reg_addr_next   
8A17   CD 35 84               CALL   slot_to_value   
8A1A   5E                     MOV   e,m   
8A1B   23                     INX   h   
8A1C   56                     MOV   d,m   ; DE = 除数
8A1D   7A                     MOV   a,d   
8A1E   B3                     ORA   e   
8A1F   C2 26 8A               JNZ   send_mod_ok   
8A22   F1                     POP   psw   
8A23   C3 03 00               JMP   vm_error   ; ゼロ除算
8A26                SEND_MOD_OK:      
8A26   F1                     POP   psw   
8A27   CD 03 84               CALL   get_reg_addr   
8A2A   CD 35 84               CALL   slot_to_value   
8A2D   E5                     PUSH   h   ; 書き戻し先
8A2E   4E                     MOV   c,m   
8A2F   23                     INX   h   
8A30   46                     MOV   b,m   ; BC = 被除数
8A31   CD 5A 8A               CALL   smod16   ; BC = 剰余 (除数と同符号)
8A34   E1                     POP   h   
8A35   71                     MOV   m,c   
8A36   23                     INX   h   
8A37   70                     MOV   m,b   
8A38   C3 89 8F               JMP   vm_loop   
8A3B                             ; ---------------------------------------------------------------
8A3B                             ; abs (絶対値): R[a] = |R[a]|
8A3B                             ; ---------------------------------------------------------------
8A3B                SEND_ABS:      
8A3B   3A 58 8A               LDA   send_reg_a   
8A3E   CD 03 84               CALL   get_reg_addr   
8A41   CD 35 84               CALL   slot_to_value   ; HL = 値の先頭
8A44   23                     INX   h   ; HL → val_hi
8A45   7E                     MOV   a,m   
8A46   E6 80                  ANI   80h   
8A48   CA 89 8F               JZ   vm_loop   ; 正ならそのまま
8A4B   2B                     DCX   h   ; HL → val_lo
8A4C   4E                     MOV   c,m   
8A4D   23                     INX   h   
8A4E   46                     MOV   b,m   ; BC = 値
8A4F   CD DF 86               CALL   neg_bc   
8A52   70                     MOV   m,b   ; val_hi
8A53   2B                     DCX   h   
8A54   71                     MOV   m,c   ; val_lo
8A55   C3 89 8F               JMP   vm_loop   
8A58                             ; --- 一時変数 ---
8A58                SEND_REG_A:      
8A58   00                     DB   0   
8A59                SEND_ARGC:      
8A59   00                     DB   0   
8A5A                             ; ---------------------------------------------------------------
8A5A                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
8A5A                             ; 
8A5A                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
8A5A                             ;   出力: BC = 剰余 (除数と同符号)
8A5A                             ;   破壊: A, DE, HL
8A5A                             ; 
8A5A                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
8A5A                             ; ---------------------------------------------------------------
8A5A                SMOD16:      
8A5A                             ; 除数の符号を保存
8A5A   7A                     MOV   a,d   
8A5B   F5                     PUSH   psw   
8A5C                             ; 符号の差を保存 (bit7: 異符号なら 1)
8A5C   78                     MOV   a,b   
8A5D   AA                     XRA   d   
8A5E   F5                     PUSH   psw   
8A5F                             ; 被除数を正にする
8A5F   78                     MOV   a,b   
8A60   E6 80                  ANI   80h   
8A62   CA 68 8A               JZ   smod_chk_div   
8A65   CD DF 86               CALL   neg_bc   
8A68                SMOD_CHK_DIV:      
8A68   7A                     MOV   a,d   
8A69   E6 80                  ANI   80h   
8A6B   CA 71 8A               JZ   smod_do   
8A6E   CD E7 86               CALL   neg_de   
8A71                SMOD_DO:      
8A71   D5                     PUSH   d   ; |除数| を退避
8A72   CD A8 86               CALL   udiv16   ; BC = 商, HL = 剰余
8A75   44                     MOV   b,h   
8A76   4D                     MOV   c,l   ; BC = |剰余|
8A77   78                     MOV   a,b   
8A78   B1                     ORA   c   
8A79   D1                     POP   d   ; DE = |除数|
8A7A   F1                     POP   psw   ; 符号差 (bit7)
8A7B   CA 90 8A               JZ   smod_zero   ; 剰余 = 0
8A7E   E6 80                  ANI   80h   
8A80   CA 89 8A               JZ   smod_sign   ; 同符号 → 大きさはそのまま
8A83                             ; 異符号: 大きさ = |除数| - |剰余|
8A83   7B                     MOV   a,e   
8A84   91                     SUB   c   
8A85   4F                     MOV   c,a   
8A86   7A                     MOV   a,d   
8A87   98                     SBB   b   
8A88   47                     MOV   b,a   
8A89                SMOD_SIGN:      
8A89   F1                     POP   psw   ; 除数の符号 (bit7)
8A8A   E6 80                  ANI   80h   
8A8C   C8                     RZ      ; 除数が正 → 正の剰余
8A8D   C3 DF 86               JMP   neg_bc   ; 除数が負 → 負にする
8A90                SMOD_ZERO:      
8A90   F1                     POP   psw   ; 除数の符号を捨てる
8A91   C9                     RET      
8A92                             ; vm_frame.a80 — フレームスタック管理
8A92                             ; 
8A92                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
8A92                             ; 
8A92                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
8A92                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
8A92                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
8A92                             ;   get_frame_addr : フレーム番号 → メモリアドレス
8A92                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
8A92                             ; ---------------------------------------------------------------
8A92                             ; get_frame_addr — フレーム番号 → アドレス
8A92                             ; 
8A92                             ;   入力: A = フレーム番号 (0-7)
8A92                             ;   出力: HL = FRAME_STACK_BASE + A * 12
8A92                             ;   破壊: A, B, DE
8A92                             ; ---------------------------------------------------------------
8A92                GET_FRAME_ADDR:      
8A92   4F                     MOV   c,a   ; C = 元の値 (退避)
8A93   87                     ADD   a   ; ×2
8A94   47                     MOV   b,a   ; B = ×2
8A95   87                     ADD   a   ; ×4
8A96   80                     ADD   b   ; ×4 + ×2 = ×6
8A97   87                     ADD   a   ; ×12
8A98   5F                     MOV   e,a   
8A99   16 00                  MVI   d,0   ; DE = frame * 12
8A9B   21 00 B1               LXI   h,FRAME_STACK_BASE   
8A9E   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
8A9F   C9                     RET      
8AA0                             ; ---------------------------------------------------------------
8AA0                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
8AA0                             ; 
8AA0                             ;   入力: なし
8AA0                             ;   出力: HL = 現在のフレームのアドレス
8AA0                             ;   破壊: A, B, C, DE
8AA0                             ; ---------------------------------------------------------------
8AA0                CUR_FRAME_ADDR:      
8AA0   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8AA3   3D                     DCR   a   
8AA4   C3 92 8A               JMP   get_frame_addr   
8AA7                             ; ---------------------------------------------------------------
8AA7                             ; push_frame — 現在の状態をフレームに保存
8AA7                             ; 
8AA7                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
8AA7                             ;          B = フレーム種別 (FRAME_KIND_*)
8AA7                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
8AA7                             ;   出力: なし
8AA7                             ;   破壊: A, B, C, HL, DE
8AA7                             ; 
8AA7                             ; frame_sp のスロットに保存して frame_sp++。
8AA7                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
8AA7                             ; ---------------------------------------------------------------
8AA7                PUSH_FRAME:      
8AA7                             ; パラメータを退避
8AA7   32 FF 8A               STA   pf_shift_reg   
8AAA   78                     MOV   a,b   
8AAB   32 00 8B               STA   pf_kind   
8AAE   79                     MOV   a,c   
8AAF   32 01 8B               STA   pf_outer   
8AB2                             ; HL = frame[frame_sp]
8AB2   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8AB5   CD 92 8A               CALL   get_frame_addr   
8AB8                             ; +0,+1: return_pc
8AB8   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
8ABB   77                     MOV   m,a   
8ABC   23                     INX   h   
8ABD   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
8AC0   77                     MOV   m,a   
8AC1   23                     INX   h   
8AC2                             ; +2: return_irep
8AC2   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
8AC5   77                     MOV   m,a   
8AC6   23                     INX   h   
8AC7                             ; +3,+4: return_reg_base
8AC7   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
8ACA   77                     MOV   m,a   
8ACB   23                     INX   h   
8ACC   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
8ACF   77                     MOV   m,a   
8AD0   23                     INX   h   
8AD1                             ; +5: kind
8AD1   3A 00 8B               LDA   pf_kind   
8AD4   77                     MOV   m,a   
8AD5   23                     INX   h   
8AD6                             ; +6,+7: index = 0
8AD6   36 00                  MVI   m,0   
8AD8   23                     INX   h   
8AD9   36 00                  MVI   m,0   
8ADB   23                     INX   h   
8ADC                             ; +8,+9: limit = 0
8ADC   36 00                  MVI   m,0   
8ADE   23                     INX   h   
8ADF   36 00                  MVI   m,0   
8AE1   23                     INX   h   
8AE2                             ; +10: outer
8AE2   3A 01 8B               LDA   pf_outer   
8AE5   77                     MOV   m,a   
8AE6                             ; reg_base += shift_reg * 4
8AE6   3A FF 8A               LDA   pf_shift_reg   
8AE9   87                     ADD   a   ; ×2
8AEA   87                     ADD   a   ; ×4
8AEB   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
8AEE   85                     ADD   l   
8AEF   6F                     MOV   l,a   
8AF0   3E 00                  MVI   a,0   
8AF2   8C                     ADC   h   
8AF3   67                     MOV   h,a   
8AF4   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
8AF7                             ; frame_sp++
8AF7   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8AFA   3C                     INR   a   
8AFB   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
8AFE   C9                     RET      
8AFF                             ; push_frame の一時変数
8AFF   00           PF_SHIFT_REG:   DB   0   
8B00   00           PF_KIND:   DB   0   
8B01   00           PF_OUTER:   DB   0   
8B02                             ; ---------------------------------------------------------------
8B02                             ; pop_frame — frame_sp-- して保存した状態を復帰
8B02                             ; 
8B02                             ;   入力: なし
8B02                             ;   出力: なし
8B02                             ;   破壊: A, B, C, HL, DE
8B02                             ; 
8B02                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
8B02                             ; ---------------------------------------------------------------
8B02                POP_FRAME:      
8B02                             ; frame_sp--
8B02   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8B05   3D                     DCR   a   
8B06   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
8B09                             ; HL = frame[frame_sp] (decremented value)
8B09   CD 92 8A               CALL   get_frame_addr   
8B0C                             ; +0,+1: restore return_pc
8B0C   7E                     MOV   a,m   
8B0D   32 00 80               STA   VM_STATE_BASE + OFF_PC   
8B10   23                     INX   h   
8B11   7E                     MOV   a,m   
8B12   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
8B15   23                     INX   h   
8B16                             ; +2: return_irep → switch_irep 用に退避
8B16   7E                     MOV   a,m   
8B17   32 2B 8B               STA   popf_ret_irep   
8B1A   23                     INX   h   
8B1B                             ; +3,+4: restore return_reg_base
8B1B   7E                     MOV   a,m   
8B1C   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
8B1F   23                     INX   h   
8B20   7E                     MOV   a,m   
8B21   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
8B24                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
8B24   3A 2B 8B               LDA   popf_ret_irep   
8B27   CD 2C 8B               CALL   switch_irep   
8B2A   C9                     RET      
8B2B   00           POPF_RET_IREP:   DB   0   
8B2C                             ; ---------------------------------------------------------------
8B2C                             ; switch_irep — IREP テーブルから実行情報をロード
8B2C                             ; 
8B2C                             ;   入力: A = IREP 番号
8B2C                             ;   出力: なし
8B2C                             ;   破壊: A, B, C, HL, DE
8B2C                             ; 
8B2C                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
8B2C                             ; ---------------------------------------------------------------
8B2C                SWITCH_IREP:      
8B2C   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
8B2F                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
8B2F                             ; A * 10 = A * 8 + A * 2
8B2F   4F                     MOV   c,a   ; C = A (退避)
8B30   87                     ADD   a   ; ×2
8B31   47                     MOV   b,a   ; B = A*2
8B32   79                     MOV   a,c   
8B33   87                     ADD   a   ; ×2
8B34   87                     ADD   a   ; ×4
8B35   87                     ADD   a   ; ×8
8B36   80                     ADD   b   ; A*8 + A*2 = A*10
8B37   5F                     MOV   e,a   
8B38   16 00                  MVI   d,0   
8B3A   21 00 82               LXI   h,IREP_TABLE_BASE   
8B3D   19                     DAD   d   ; HL = エントリアドレス
8B3E                             ; +0,+1: bytecode base → BC_BASE
8B3E   7E                     MOV   a,m   
8B3F   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
8B42   23                     INX   h   
8B43   7E                     MOV   a,m   
8B44   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
8B47   23                     INX   h   
8B48                             ; +2,+3: bytecode len → BC_LEN
8B48   7E                     MOV   a,m   
8B49   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
8B4C   23                     INX   h   
8B4D   7E                     MOV   a,m   
8B4E   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
8B51   23                     INX   h   
8B52                             ; +4,+5: pool base → POOL_BASE
8B52   7E                     MOV   a,m   
8B53   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
8B56   23                     INX   h   
8B57   7E                     MOV   a,m   
8B58   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
8B5B   23                     INX   h   
8B5C                             ; +6: nregs
8B5C   7E                     MOV   a,m   
8B5D   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
8B60                             ; +7: subtree_size (スキップ)
8B60   23                     INX   h   
8B61                             ; +8,+9: sym_table_base → SYM_BASE
8B61   23                     INX   h   
8B62   7E                     MOV   a,m   
8B63   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
8B66   23                     INX   h   
8B67   7E                     MOV   a,m   
8B68   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
8B6B   C9                     RET      
8B6C                             ; vm_block.a80 — ブロック関連オペコード
8B6C                             ; 
8B6C                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
8B6C                             ; ---------------------------------------------------------------
8B6C                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
8B6C                             ; ---------------------------------------------------------------
8B6C                DO_OP_LOADSELF:      
8B6C   CD C3 84               CALL   fetch_byte   ; A = a
8B6F   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8B72   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
8B74   23                     INX   h   
8B75   36 00                  MVI   m,0   ; +1: 予約
8B77   23                     INX   h   
8B78   36 00                  MVI   m,0   ; +2: val_lo = 0
8B7A   23                     INX   h   
8B7B   36 00                  MVI   m,0   ; +3: val_hi = 0
8B7D   C3 89 8F               JMP   vm_loop   
8B80                             ; ---------------------------------------------------------------
8B80                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
8B80                             ; 
8B80                             ; ブロックを TT_PROC としてレジスタに格納する。
8B80                             ;   値の下位バイト = 子 irep 番号
8B80                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
8B80                             ; ---------------------------------------------------------------
8B80                DO_OP_BLOCK:      
8B80   CD C3 84               CALL   fetch_byte   ; A = a
8B83   32 AC 8B               STA   blk_reg_a   
8B86   CD C3 84               CALL   fetch_byte   ; A = b (子 irep インデックス)
8B89                             ; 子 irep 番号を算出 (共通サブルーチン)
8B89   CD 7A 84               CALL   calc_child_irep   ; A = child irep 番号
8B8C                             ; R[a] に TT_PROC を書く
8B8C   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
8B8D   3A AC 8B               LDA   blk_reg_a   
8B90   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8B93   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
8B95   23                     INX   h   
8B96   36 00                  MVI   m,0   ; +1: 予約
8B98   23                     INX   h   
8B99   71                     MOV   m,c   ; +2: val_lo = irep 番号
8B9A   23                     INX   h   
8B9B                             ; val_hi = 外側フレーム番号
8B9B                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
8B9B                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
8B9B   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8B9E   B7                     ORA   a   
8B9F   C2 A7 8B               JNZ   block_in_frame   
8BA2   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
8BA4   C3 A8 8B               JMP   block_set_outer   
8BA7                BLOCK_IN_FRAME:      
8BA7   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
8BA8                BLOCK_SET_OUTER:      
8BA8   77                     MOV   m,a   ; +3: val_hi = outer frame
8BA9   C3 89 8F               JMP   vm_loop   
8BAC   00           BLK_REG_A:   DB   0   
8BAD                             ; ---------------------------------------------------------------
8BAD                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
8BAD                             ; 
8BAD                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
8BAD                             ; ---------------------------------------------------------------
8BAD                DO_OP_ENTER:      
8BAD   CD C3 84               CALL   fetch_byte   ; 読み飛ばし (byte 1)
8BB0   CD C3 84               CALL   fetch_byte   ; 読み飛ばし (byte 2)
8BB3   CD C3 84               CALL   fetch_byte   ; 読み飛ばし (byte 3)
8BB6   C3 89 8F               JMP   vm_loop   
8BB9                             ; ---------------------------------------------------------------
8BB9                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
8BB9                             ; 
8BB9                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
8BB9                             ; ブロック付きメソッド呼び出しを行う。
8BB9                             ; ---------------------------------------------------------------
8BB9                DO_OP_SSENDB:      
8BB9                             ; オペランドをプリフェッチ
8BB9   CD C3 84               CALL   fetch_byte   ; A = a
8BBC   32 AE 8C               STA   sendb_reg_a   
8BBF   CD C3 84               CALL   fetch_byte   ; A = b (シンボル番号)
8BC2   32 AF 8C               STA   sendb_sym_b   
8BC5   CD C3 84               CALL   fetch_byte   ; A = c (argc)
8BC8   32 B0 8C               STA   sendb_argc   
8BCB                             ; R[0] → R[a] コピー (self を設定)
8BCB   3E 00                  MVI   a,0   
8BCD   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8BD0   E5                     PUSH   h   ; R[0] アドレス退避
8BD1   3A AE 8C               LDA   sendb_reg_a   
8BD4   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8BD7   EB                     XCHG      ; DE = R[a]
8BD8   E1                     POP   h   ; HL = R[0]
8BD9   CD 28 84               CALL   copy_slot   ; R[a] = R[0]
8BDC   C3 F1 8B               JMP   sendb_dispatch   
8BDF                             ; ---------------------------------------------------------------
8BDF                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
8BDF                             ; 
8BDF                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
8BDF                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
8BDF                             ; ---------------------------------------------------------------
8BDF                DO_OP_SENDB:      
8BDF   CD C3 84               CALL   fetch_byte   ; A = a
8BE2   32 AE 8C               STA   sendb_reg_a   
8BE5   CD C3 84               CALL   fetch_byte   ; A = b (シンボル番号)
8BE8   32 AF 8C               STA   sendb_sym_b   
8BEB   CD C3 84               CALL   fetch_byte   ; A = c (argc)
8BEE   32 B0 8C               STA   sendb_argc   
8BF1                SENDB_DISPATCH:      
8BF1                             ; シンボルテーブルからメソッド ID を取得
8BF1   3A AF 8C               LDA   sendb_sym_b   
8BF4   87                     ADD   a   ; ×2
8BF5   5F                     MOV   e,a   
8BF6   16 00                  MVI   d,0   
8BF8   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
8BFB   19                     DAD   d   ; HL = sym_table[b]
8BFC   7E                     MOV   a,m   ; メソッド ID (下位)
8BFD   32 B1 8C               STA   sendb_method_id   
8C00                             ; メソッド ID で振り分け
8C00   3A B1 8C               LDA   sendb_method_id   
8C03   FE 0B                  CPI   11   ; METHOD_TIMES
8C05   CA 15 8C               JZ   sendb_times   
8C08   FE 15                  CPI   METHOD_EACH   
8C0A   CA 65 B8               JZ   sendb_each   
8C0D   FE 1B                  CPI   27   ; METHOD_LOOP
8C0F   CA 78 8C               JZ   sendb_loop   
8C12                             ; 未対応のブロックメソッド
8C12   C3 03 00               JMP   vm_error   
8C15                             ; --- times ---
8C15                SENDB_TIMES:      
8C15                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
8C15   3A AE 8C               LDA   sendb_reg_a   
8C18   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8C1B   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
8C1E   4E                     MOV   c,m   ; C = val_lo
8C1F   23                     INX   h   
8C20   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
8C21                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
8C21   78                     MOV   a,b   
8C22   B1                     ORA   c   
8C23   CA 89 8F               JZ   vm_loop   ; receiver == 0 → スキップ
8C26                             ; limit = BC - 1
8C26   0B                     DCX   b   ; BC = limit
8C27                             ; push_frame: A=レジスタ番号, B=kind, C=outer
8C27                             ; ブロックの位置: R[a + argc + 1]
8C27   3A AE 8C               LDA   sendb_reg_a   
8C2A   C5                     PUSH   b   ; limit を退避
8C2B                             ; ブロック (TT_PROC) の情報を読む
8C2B   3A B0 8C               LDA   sendb_argc   
8C2E   3C                     INR   a   ; argc + 1
8C2F   47                     MOV   b,a   
8C30   3A AE 8C               LDA   sendb_reg_a   
8C33   80                     ADD   b   ; A = a + argc + 1
8C34   CD 03 84               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
8C37   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
8C3A   7E                     MOV   a,m   ; A = irep 番号
8C3B   32 B2 8C               STA   sendb_block_irep   
8C3E   23                     INX   h   
8C3F   7E                     MOV   a,m   ; A = outer frame (val_hi)
8C40   32 B3 8C               STA   sendb_block_outer   
8C43                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
8C43   3A AE 8C               LDA   sendb_reg_a   
8C46   06 01                  MVI   b,FRAME_KIND_ITERATE   
8C48   3A B3 8C               LDA   sendb_block_outer   
8C4B   4F                     MOV   c,a   
8C4C   3A AE 8C               LDA   sendb_reg_a   
8C4F   CD A7 8A               CALL   push_frame   
8C52                             ; フレームに limit を設定
8C52                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
8C52   CD A0 8A               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
8C55   11 08 00               LXI   d,FRAME_OFF_LIMIT   
8C58   19                     DAD   d   ; HL = &limit
8C59   C1                     POP   b   ; BC = limit (ここで復帰)
8C5A   71                     MOV   m,c   ; limit_lo
8C5B   23                     INX   h   
8C5C   70                     MOV   m,b   ; limit_hi
8C5D                             ; ブロック引数 R[1] = 0 (初期カウンタ)
8C5D                             ; R[1] は新しい reg_base から見た R[1]
8C5D   3E 01                  MVI   a,1   
8C5F   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8C62   06 00                  MVI   b,0   
8C64   0E 00                  MVI   c,0   
8C66   CD 13 84               CALL   set_slot_int16   ; R[1] = 0
8C69                             ; 子 irep に切り替え
8C69   3A B2 8C               LDA   sendb_block_irep   
8C6C   CD 2C 8B               CALL   switch_irep   
8C6F                             ; PC = 0
8C6F   21 00 00               LXI   h,0   
8C72   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8C75   C3 89 8F               JMP   vm_loop   
8C78                             ; --- loop ---
8C78                SENDB_LOOP:      
8C78                             ; ブロックの位置: R[a + argc + 1]
8C78   3A B0 8C               LDA   sendb_argc   
8C7B   3C                     INR   a   
8C7C   47                     MOV   b,a   
8C7D   3A AE 8C               LDA   sendb_reg_a   
8C80   80                     ADD   b   ; A = a + argc + 1
8C81   CD 03 84               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
8C84   CD 35 84               CALL   slot_to_value   
8C87   7E                     MOV   a,m   ; irep 番号
8C88   32 B2 8C               STA   sendb_block_irep   
8C8B   23                     INX   h   
8C8C   7E                     MOV   a,m   ; outer
8C8D   32 B3 8C               STA   sendb_block_outer   
8C90                             ; push_frame(a, FRAME_KIND_LOOP, outer)
8C90   3A AE 8C               LDA   sendb_reg_a   
8C93   06 04                  MVI   b,FRAME_KIND_LOOP   
8C95   3A B3 8C               LDA   sendb_block_outer   
8C98   4F                     MOV   c,a   
8C99   3A AE 8C               LDA   sendb_reg_a   
8C9C   CD A7 8A               CALL   push_frame   
8C9F                             ; 子 irep に切り替え
8C9F   3A B2 8C               LDA   sendb_block_irep   
8CA2   CD 2C 8B               CALL   switch_irep   
8CA5                             ; PC = 0
8CA5   21 00 00               LXI   h,0   
8CA8   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8CAB   C3 89 8F               JMP   vm_loop   
8CAE                             ; OP_SENDB の一時変数
8CAE   00           SENDB_REG_A:   DB   0   
8CAF   00           SENDB_SYM_B:   DB   0   
8CB0   00           SENDB_ARGC:   DB   0   
8CB1   00           SENDB_METHOD_ID:   DB   0   
8CB2   00           SENDB_BLOCK_IREP:   DB   0   
8CB3   00           SENDB_BLOCK_OUTER:   DB   0   
8CB4                             ; ---------------------------------------------------------------
8CB4                             ; OP_BREAK (B): ブロックから脱出
8CB4                             ; 
8CB4                             ; R[a] の値を R[0] にコピーして pop_frame。
8CB4                             ; ---------------------------------------------------------------
8CB4                DO_OP_BREAK:      
8CB4   CD C3 84               CALL   fetch_byte   ; A = a
8CB7                             ; R[a] → R[0] コピー
8CB7   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8CBA   E5                     PUSH   h   ; R[a] アドレス退避
8CBB   3E 00                  MVI   a,0   
8CBD   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8CC0   EB                     XCHG      ; DE = R[0]
8CC1   E1                     POP   h   ; HL = R[a]
8CC2   CD 28 84               CALL   copy_slot   ; R[0] = R[a]
8CC5   CD 02 8B               CALL   pop_frame   
8CC8   C3 89 8F               JMP   vm_loop   
8CCB                             ; vm_upvar.a80 — 外側スコープの変数アクセス
8CCB                             ; 
8CCB                             ; OP_GETUPVAR, OP_SETUPVAR
8CCB                             ; 
8CCB                             ; ブロック内から外側のローカル変数にアクセスする。
8CCB                             ; outer フレーム chain を level 段辿って reg_base を求める。
8CCB                             ; ---------------------------------------------------------------
8CCB                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
8CCB                             ; 
8CCB                             ;   入力: A = level (何段外側か)
8CCB                             ;   出力: HL = 外側スコープの reg_base アドレス
8CCB                             ;   破壊: A, B, C, DE
8CCB                             ; 
8CCB                             ; outer chain を level 段辿る。FRAME_NONE に達したら
8CCB                             ; REG_FILE_BASE (トップレベル) を返す。
8CCB                             ; ---------------------------------------------------------------
8CCB                UPVAR_BASE:      
8CCB   47                     MOV   b,a   ; B = level (残り段数)
8CCC                             ; まず現在のフレームの outer を読む
8CCC   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8CCF   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
8CD0   32 02 8D               STA   upvar_frame   
8CD3                             ; level == 0 なら outer chain を辿らずに
8CD3                             ; 現在のフレームの return_reg_base をそのまま返す
8CD3   78                     MOV   a,b   
8CD4   B7                     ORA   a   
8CD5   CA EF 8C               JZ   upvar_found   
8CD8                UPVAR_LOOP:      
8CD8                             ; outer フレーム番号を読む
8CD8   3A 02 8D               LDA   upvar_frame   
8CDB   CD 92 8A               CALL   get_frame_addr   ; HL = フレームアドレス
8CDE   11 0A 00               LXI   d,FRAME_OFF_OUTER   
8CE1   19                     DAD   d   
8CE2   7E                     MOV   a,m   ; A = outer frame 番号
8CE3   FE FF                  CPI   FRAME_NONE   
8CE5   CA FE 8C               JZ   upvar_toplevel   ; トップレベルに達した
8CE8   32 02 8D               STA   upvar_frame   ; 次のフレーム
8CEB   05                     DCR   b   
8CEC   C2 D8 8C               JNZ   upvar_loop   ; まだ辿る段がある
8CEF                             ; level 回辿り終わった — upvar_frame の reg_base を返す
8CEF                UPVAR_FOUND:      
8CEF   3A 02 8D               LDA   upvar_frame   
8CF2   CD 92 8A               CALL   get_frame_addr   ; HL = フレームアドレス
8CF5   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
8CF8   19                     DAD   d   
8CF9   5E                     MOV   e,m   
8CFA   23                     INX   h   
8CFB   56                     MOV   d,m   ; DE = return_reg_base
8CFC   EB                     XCHG      ; HL = return_reg_base
8CFD   C9                     RET      
8CFE                UPVAR_TOPLEVEL:      
8CFE   21 00 81               LXI   h,REG_FILE_BASE   
8D01   C9                     RET      
8D02   00           UPVAR_FRAME:   DB   0   
8D03                             ; ---------------------------------------------------------------
8D03                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
8D03                             ; 
8D03                             ;   a = コピー先レジスタ
8D03                             ;   b = 外側スコープのレジスタ番号
8D03                             ;   c = level (何段外側か)
8D03                             ; ---------------------------------------------------------------
8D03                DO_OP_GETUPVAR:      
8D03   CD C3 84               CALL   fetch_byte   ; A = a
8D06   32 59 8D               STA   upvar_reg_a   
8D09   CD C3 84               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
8D0C   32 5A 8D               STA   upvar_reg_b   
8D0F   CD C3 84               CALL   fetch_byte   ; A = c (level)
8D12                             ; 外側の reg_base を求める
8D12   CD CB 8C               CALL   upvar_base   ; HL = 外側の reg_base
8D15                             ; 外側の R[b] のアドレス = base + b * 4
8D15   3A 5A 8D               LDA   upvar_reg_b   
8D18   87                     ADD   a   ; ×2
8D19   87                     ADD   a   ; ×4
8D1A   85                     ADD   l   
8D1B   6F                     MOV   l,a   
8D1C   3E 00                  MVI   a,0   
8D1E   8C                     ADC   h   
8D1F   67                     MOV   h,a   ; HL = 外側の R[b]
8D20                             ; R[a] にコピー
8D20   E5                     PUSH   h   ; コピー元退避
8D21   3A 59 8D               LDA   upvar_reg_a   
8D24   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8D27   EB                     XCHG      ; DE = R[a] (コピー先)
8D28   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
8D29   CD 28 84               CALL   copy_slot   
8D2C   C3 89 8F               JMP   vm_loop   
8D2F                             ; ---------------------------------------------------------------
8D2F                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
8D2F                             ; 
8D2F                             ;   a = コピー元レジスタ
8D2F                             ;   b = 外側スコープのレジスタ番号
8D2F                             ;   c = level (何段外側か)
8D2F                             ; ---------------------------------------------------------------
8D2F                DO_OP_SETUPVAR:      
8D2F   CD C3 84               CALL   fetch_byte   ; A = a
8D32   32 59 8D               STA   upvar_reg_a   
8D35   CD C3 84               CALL   fetch_byte   ; A = b
8D38   32 5A 8D               STA   upvar_reg_b   
8D3B   CD C3 84               CALL   fetch_byte   ; A = c (level)
8D3E                             ; 外側の reg_base を求める
8D3E   CD CB 8C               CALL   upvar_base   ; HL = 外側の reg_base
8D41                             ; 外側の R[b] のアドレス = base + b * 4
8D41   3A 5A 8D               LDA   upvar_reg_b   
8D44   87                     ADD   a   
8D45   87                     ADD   a   
8D46   85                     ADD   l   
8D47   6F                     MOV   l,a   
8D48   3E 00                  MVI   a,0   
8D4A   8C                     ADC   h   
8D4B   67                     MOV   h,a   ; HL = 外側の R[b]
8D4C   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
8D4D                             ; R[a] からコピー
8D4D   3A 59 8D               LDA   upvar_reg_a   
8D50   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
8D53   CD 28 84               CALL   copy_slot   
8D56   C3 89 8F               JMP   vm_loop   
8D59   00           UPVAR_REG_A:   DB   0   
8D5A   00           UPVAR_REG_B:   DB   0   
8D5B                             ; vm_class.a80 — クラス・メソッド定義オペコード
8D5B                             ; 
8D5B                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
8D5B                             ; ---------------------------------------------------------------
8D5B                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
8D5B                             ; 
8D5B                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
8D5B                             ; クラス本体内ではそのクラス (TT_CLASS)。
8D5B                             ; ---------------------------------------------------------------
8D5B                DO_OP_TCLASS:      
8D5B   CD C3 84               CALL   fetch_byte   ; A = a
8D5E   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8D61   EB                     XCHG      ; DE = R[a] (コピー先)
8D62   3E 00                  MVI   a,0   
8D64   CD 03 84               CALL   get_reg_addr   ; HL = R[0] (コピー元)
8D67   CD 28 84               CALL   copy_slot   ; R[a] = R[0]
8D6A   C3 89 8F               JMP   vm_loop   
8D6D                             ; ---------------------------------------------------------------
8D6D                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
8D6D                             ; 
8D6D                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
8D6D                             ; ではないため、外側フレームへの参照を持たない)。
8D6D                             ; ---------------------------------------------------------------
8D6D                DO_OP_METHOD:      
8D6D   CD C3 84               CALL   fetch_byte   ; A = a
8D70   32 8D 8D               STA   meth_reg_a   
8D73   CD C3 84               CALL   fetch_byte   ; A = b (子 irep インデックス)
8D76   CD 7A 84               CALL   calc_child_irep   ; A = irep 番号
8D79   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
8D7A   3A 8D 8D               LDA   meth_reg_a   
8D7D   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8D80   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
8D82   23                     INX   h   
8D83   36 00                  MVI   m,0   ; +1: 予約
8D85   23                     INX   h   
8D86   71                     MOV   m,c   ; +2: val_lo = irep 番号
8D87   23                     INX   h   
8D88   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
8D8A   C3 89 8F               JMP   vm_loop   
8D8D   00           METH_REG_A:   DB   0   
8D8E                             ; ---------------------------------------------------------------
8D8E                             ; OP_DEF (BB): メソッド表に登録
8D8E                             ; 
8D8E                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
8D8E                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
8D8E                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
8D8E                             ; 
8D8E                             ; method_table[class_number * 32 + method_id] = irep 番号
8D8E                             ; ---------------------------------------------------------------
8D8E                DO_OP_DEF:      
8D8E   CD C3 84               CALL   fetch_byte   ; A = a
8D91   32 F2 8D               STA   def_reg_a   
8D94   CD C3 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
8D97                             ; シンボルテーブルから method_id を取得
8D97   87                     ADD   a   ; ×2
8D98   5F                     MOV   e,a   
8D99   16 00                  MVI   d,0   
8D9B   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
8D9E   19                     DAD   d   ; HL = &sym_table[b]
8D9F   5E                     MOV   e,m   ; E = method_id (下位)
8DA0   23                     INX   h   
8DA1   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
8DA2                             ; 種別チェックは省略 (バイトコードツールが保証)
8DA2                             ; method_id を退避
8DA2   7B                     MOV   a,e   
8DA3   32 F3 8D               STA   def_method_id   
8DA6                             ; R[a] から class_number を取得
8DA6   3A F2 8D               LDA   def_reg_a   
8DA9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8DAC   CD 9E 84               CALL   class_of_reg   ; A = class_number
8DAF                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
8DAF                             ; A * 32
8DAF   87                     ADD   a   ; ×2
8DB0   87                     ADD   a   ; ×4
8DB1   87                     ADD   a   ; ×8
8DB2   87                     ADD   a   ; ×16
8DB3   87                     ADD   a   ; ×32
8DB4   5F                     MOV   e,a   
8DB5   16 00                  MVI   d,0   
8DB7   21 60 B1               LXI   h,METHOD_TABLE_BASE   
8DBA   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
8DBB   3A F3 8D               LDA   def_method_id   
8DBE   5F                     MOV   e,a   
8DBF   16 00                  MVI   d,0   
8DC1   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
8DC2                             ; R[a+1].val_lo = irep 番号
8DC2   3A F2 8D               LDA   def_reg_a   
8DC5   CD 0F 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8DC8   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
8DCB   7E                     MOV   a,m   ; A = val_lo = irep 番号
8DCC                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
8DCC   32 F4 8D               STA   def_irep_num   
8DCF   3A F2 8D               LDA   def_reg_a   
8DD2   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8DD5   CD 9E 84               CALL   class_of_reg   ; A = class_number
8DD8   87                     ADD   a   
8DD9   87                     ADD   a   
8DDA   87                     ADD   a   
8DDB   87                     ADD   a   
8DDC   87                     ADD   a   ; A = class * 32
8DDD   5F                     MOV   e,a   
8DDE   16 00                  MVI   d,0   
8DE0   21 60 B1               LXI   h,METHOD_TABLE_BASE   
8DE3   19                     DAD   d   
8DE4   3A F3 8D               LDA   def_method_id   
8DE7   5F                     MOV   e,a   
8DE8   16 00                  MVI   d,0   
8DEA   19                     DAD   d   ; HL = メソッド表エントリ
8DEB   3A F4 8D               LDA   def_irep_num   
8DEE   77                     MOV   m,a   ; method_table[...] = irep 番号
8DEF   C3 89 8F               JMP   vm_loop   
8DF2   00           DEF_REG_A:   DB   0   
8DF3   00           DEF_METHOD_ID:   DB   0   
8DF4   00           DEF_IREP_NUM:   DB   0   
8DF5                             ; ---------------------------------------------------------------
8DF5                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
8DF5                             ; 
8DF5                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
8DF5                             ; ---------------------------------------------------------------
8DF5                DO_OP_CLASS:      
8DF5                DO_OP_GETCONST:      
8DF5   CD C3 84               CALL   fetch_byte   ; A = a
8DF8   32 20 8E               STA   cls_reg_a   
8DFB   CD C3 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
8DFE                             ; シンボルテーブルから class_number を取得
8DFE   87                     ADD   a   ; ×2
8DFF   5F                     MOV   e,a   
8E00   16 00                  MVI   d,0   
8E02   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
8E05   19                     DAD   d   ; HL = &sym_table[b]
8E06   7E                     MOV   a,m   ; A = class_number (下位)
8E07   32 21 8E               STA   cls_class_num   
8E0A                             ; R[a] に TT_CLASS を書く
8E0A   3A 20 8E               LDA   cls_reg_a   
8E0D   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8E10   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
8E12   23                     INX   h   
8E13   36 00                  MVI   m,0   ; +1: 予約
8E15   23                     INX   h   
8E16   3A 21 8E               LDA   cls_class_num   
8E19   77                     MOV   m,a   ; +2: val_lo = class_number
8E1A   23                     INX   h   
8E1B   36 00                  MVI   m,0   ; +3: val_hi = 0
8E1D   C3 89 8F               JMP   vm_loop   
8E20   00           CLS_REG_A:   DB   0   
8E21   00           CLS_CLASS_NUM:   DB   0   
8E22                             ; ---------------------------------------------------------------
8E22                             ; OP_EXEC (BB): クラス本体を実行
8E22                             ; 
8E22                             ; push_frame して子 irep に切り替える。
8E22                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
8E22                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
8E22                             ; ---------------------------------------------------------------
8E22                DO_OP_EXEC:      
8E22   CD C3 84               CALL   fetch_byte   ; A = a
8E25   32 4A 8E               STA   exec_reg_a   
8E28   CD C3 84               CALL   fetch_byte   ; A = b (子 irep インデックス)
8E2B   CD 7A 84               CALL   calc_child_irep   ; A = irep 番号
8E2E   32 4B 8E               STA   exec_irep   
8E31                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
8E31   3A 4A 8E               LDA   exec_reg_a   
8E34   06 00                  MVI   b,FRAME_KIND_CALL   
8E36   0E FF                  MVI   c,FRAME_NONE   
8E38   CD A7 8A               CALL   push_frame   
8E3B                             ; 子 irep に切り替え
8E3B   3A 4B 8E               LDA   exec_irep   
8E3E   CD 2C 8B               CALL   switch_irep   
8E41                             ; PC = 0
8E41   21 00 00               LXI   h,0   
8E44   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8E47   C3 89 8F               JMP   vm_loop   
8E4A   00           EXEC_REG_A:   DB   0   
8E4B   00           EXEC_IREP:   DB   0   
8E4C                             ; vm_display.a80 — 7 セグメント表示
8E4C                             ; 
8E4C                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
8E4C                             ; 上位 4 桁はブランク（消灯）にする。
8E4C                             ; セグメントパターンは seg_table にまとめる。
8E4C                             ; ---------------------------------------------------------------
8E4C                             ; display_hex16 — 16 ビット値を 7 セグに表示
8E4C                             ; 
8E4C                             ;   入力: HL = 値の先頭 (val_lo の位置)
8E4C                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
8E4C                             ;   破壊: A, B, C, HL, DE
8E4C                             ; 
8E4C                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
8E4C                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
8E4C                             ; ---------------------------------------------------------------
8E4C                DISPLAY_HEX16:      
8E4C   E5                     PUSH   h   ; 値のアドレスを退避
8E4D                             ; 上位 4 桁をブランク (消灯) にする
8E4D   11 F8 FF               LXI   d,DISPLAY_BASE   
8E50   AF                     XRA   a   ; A = 0 (全セグメント消灯)
8E51   12                     STAX   d   
8E52   13                     INX   d   
8E53   12                     STAX   d   
8E54   13                     INX   d   
8E55   12                     STAX   d   
8E56   13                     INX   d   
8E57   12                     STAX   d   
8E58   13                     INX   d   ; DE = DISPLAY_BASE + 4
8E59                             ; 値の byte1 (val_hi) から表示
8E59   E1                     POP   h   ; HL = val_lo
8E5A   23                     INX   h   ; HL = val_hi
8E5B   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
8E5D                DISPLAY_BYTE_LOOP:      
8E5D                             ; 上位ニブル
8E5D   7E                     MOV   a,m   
8E5E   0F                     RRC      
8E5F   0F                     RRC      
8E60   0F                     RRC      
8E61   0F                     RRC      
8E62   E6 0F                  ANI   0Fh   
8E64   CD 77 8E               CALL   nibble_to_seg   
8E67   12                     STAX   d   
8E68   13                     INX   d   
8E69                             ; 下位ニブル
8E69   7E                     MOV   a,m   
8E6A   E6 0F                  ANI   0Fh   
8E6C   CD 77 8E               CALL   nibble_to_seg   
8E6F   12                     STAX   d   
8E70   13                     INX   d   
8E71                             ; 次のバイト (val_hi → val_lo)
8E71   2B                     DCX   h   
8E72   0D                     DCR   c   
8E73   C2 5D 8E               JNZ   display_byte_loop   
8E76   C9                     RET      
8E77                             ; ---------------------------------------------------------------
8E77                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
8E77                             ; 
8E77                             ;   入力: A = 0-F
8E77                             ;   出力: A = セグメントパターン
8E77                             ;   破壊: なし (HL, BC は内部で退避・復元)
8E77                             ; ---------------------------------------------------------------
8E77                NIBBLE_TO_SEG:      
8E77   E5                     PUSH   h   
8E78   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
8E79   6F                     MOV   l,a   
8E7A   26 00                  MVI   h,0   
8E7C   01 84 8E               LXI   b,seg_table   
8E7F   09                     DAD   b   ; HL = seg_table + nibble
8E80   7E                     MOV   a,m   
8E81   C1                     POP   b   ; BC を復元
8E82   E1                     POP   h   
8E83   C9                     RET      
8E84                             ; ---------------------------------------------------------------
8E84                             ; 7 セグメントパターンテーブル
8E84                             ; 
8E84                             ;   bit 0 = a (上)
8E84                             ;   bit 1 = b (右上)
8E84                             ;   bit 2 = c (右下)
8E84                             ;   bit 3 = d (下)
8E84                             ;   bit 4 = e (左下)
8E84                             ;   bit 5 = f (左上)
8E84                             ;   bit 6 = g (中)
8E84                             ; 
8E84                             ;       aaa
8E84                             ;      f   b
8E84                             ;       ggg
8E84                             ;      e   c
8E84                             ;       ddd
8E84                             ; ---------------------------------------------------------------
8E84                SEG_TABLE:      
8E84   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
8E85   06                     DB   06h   ; 1
8E86   5B                     DB   5Bh   ; 2
8E87   4F                     DB   4Fh   ; 3
8E88   66                     DB   66h   ; 4
8E89   6D                     DB   6Dh   ; 5
8E8A   7D                     DB   7Dh   ; 6
8E8B   27                     DB   27h   ; 7  (ND8080 ROM パターン)
8E8C   7F                     DB   7Fh   ; 8
8E8D   6F                     DB   6Fh   ; 9
8E8E   77                     DB   77h   ; A
8E8F   7C                     DB   7Ch   ; b
8E90   39                     DB   39h   ; C
8E91   5E                     DB   5Eh   ; d
8E92   79                     DB   79h   ; E
8E93   71                     DB   71h   ; F
8E94                             ; ===============================================================
8E94                             ; OP_RETURN (B): フレーム種別に応じて復帰
8E94                             ; 
8E94                             ; frame_sp == 0 → トップレベル: 表示して停止
8E94                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
8E94                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
8E94                             ; FRAME_KIND_ITERATE/LOOP → ブロック内: advance_iteration
8E94                             ; ===============================================================
8E94                DO_OP_RETURN:      
8E94   CD C3 84               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
8E97   32 E7 8E               STA   return_reg_a   
8E9A                             ; フレームスタックが空ならトップレベル
8E9A   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
8E9D   B7                     ORA   a   
8E9E   CA D3 8E               JZ   do_op_return_top   
8EA1                             ; フレーム種別を確認
8EA1   CD A0 8A               CALL   cur_frame_addr   ; HL = 現在のフレーム
8EA4   11 05 00               LXI   d,FRAME_OFF_KIND   
8EA7   19                     DAD   d   
8EA8   7E                     MOV   a,m   ; A = kind
8EA9   FE 00                  CPI   FRAME_KIND_CALL   
8EAB   CA B6 8E               JZ   return_call   
8EAE   FE 05                  CPI   FRAME_KIND_NEW   
8EB0   CA CD 8E               JZ   return_new   
8EB3                             ; ITERATE / LOOP → advance_iteration
8EB3   C3 E8 8E               JMP   advance_iteration   
8EB6                RETURN_CALL:      
8EB6                             ; R[a] の値を R[0] にコピー
8EB6   3A E7 8E               LDA   return_reg_a   
8EB9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8EBC   E5                     PUSH   h   
8EBD   3E 00                  MVI   a,0   
8EBF   CD 03 84               CALL   get_reg_addr   ; HL = R[0]
8EC2   EB                     XCHG      ; DE = R[0] (コピー先)
8EC3   E1                     POP   h   ; HL = R[a] (コピー元)
8EC4   CD 28 84               CALL   copy_slot   ; R[0] = R[a]
8EC7   CD 02 8B               CALL   pop_frame   
8ECA   C3 89 8F               JMP   vm_loop   
8ECD                RETURN_NEW:      
8ECD                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
8ECD   CD 02 8B               CALL   pop_frame   
8ED0   C3 89 8F               JMP   vm_loop   
8ED3                DO_OP_RETURN_TOP:      
8ED3   3A E7 8E               LDA   return_reg_a   
8ED6   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8ED9   CD 35 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8EDC   CD 4C 8E               CALL   display_hex16   
8EDF   3E 02                  MVI   a,VM_FINISHED   
8EE1   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8EE4   C3 77 8F               JMP   vm_halt   
8EE7   00           RETURN_REG_A:   DB   0   
8EE8                             ; ===============================================================
8EE8                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
8EE8                             ; 
8EE8                             ; ITERATE (times): index++ して limit と比較。超えたら pop_frame。
8EE8                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
8EE8                             ; ===============================================================
8EE8                ADVANCE_ITERATION:      
8EE8                             ; フレーム種別を確認
8EE8   CD A0 8A               CALL   cur_frame_addr   ; HL = 現在のフレーム
8EEB   11 05 00               LXI   d,FRAME_OFF_KIND   
8EEE   19                     DAD   d   
8EEF   7E                     MOV   a,m   ; A = kind
8EF0   FE 04                  CPI   FRAME_KIND_LOOP   
8EF2   CA 46 8F               JZ   adv_reenter   ; loop → 常に再実行
8EF5   32 55 8F               STA   adv_kind   ; kind を退避 (ITERATE or EACH)
8EF8                             ; --- ITERATE / EACH 共通: index インクリメント + limit チェック ---
8EF8   CD A0 8A               CALL   cur_frame_addr   
8EFB   11 06 00               LXI   d,FRAME_OFF_INDEX   
8EFE   19                     DAD   d   
8EFF   4E                     MOV   c,m   ; C = index_lo
8F00   23                     INX   h   
8F01   46                     MOV   b,m   ; B = index_hi
8F02   03                     INX   b   ; BC = index + 1
8F03                             ; 書き戻す
8F03   70                     MOV   m,b   ; index_hi
8F04   2B                     DCX   h   
8F05   71                     MOV   m,c   ; index_lo
8F06                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
8F06   23                     INX   h   ; → &index_hi
8F07   23                     INX   h   ; → &limit_lo
8F08   5E                     MOV   e,m   ; E = limit_lo
8F09   23                     INX   h   ; → &limit_hi
8F0A   56                     MOV   d,m   ; D = limit_hi
8F0B                             ; BC = new index, DE = limit
8F0B                             ; index > limit なら反復終了 (DE - BC でボロー発生)
8F0B   7B                     MOV   a,e   
8F0C   91                     SUB   c   
8F0D   7A                     MOV   a,d   
8F0E   98                     SBB   b   
8F0F   DA 4F 8F               JC   adv_done   ; index > limit → 反復終了
8F12                             ; kind で R[1] の設定を分岐
8F12   3A 55 8F               LDA   adv_kind   
8F15   FE 02                  CPI   FRAME_KIND_EACH   
8F17   CA 25 8F               JZ   adv_each_load   
8F1A                             ; --- ITERATE (times): R[1] = index ---
8F1A   3E 01                  MVI   a,1   
8F1C   CD 03 84               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
8F1F   CD 13 84               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
8F22   C3 46 8F               JMP   adv_reenter   
8F25                             ; --- EACH: R[1] = array[index] ---
8F25                ADV_EACH_LOAD:      
8F25                             ; BC = index を退避 (cur_frame_addr が BC を破壊するため)
8F25   C5                     PUSH   b   
8F26                             ; フレーム +11 からコレクションスロット番号を読む
8F26   CD A0 8A               CALL   cur_frame_addr   
8F29   11 0B 00               LXI   d,11   
8F2C   19                     DAD   d   
8F2D   7E                     MOV   a,m   ; A = col_slot
8F2E   CD EC AB               CALL   col_slot_addr   ; HL = スロットアドレス
8F31   23                     INX   h   ; skip type
8F32   23                     INX   h   ; skip count → data
8F33   C1                     POP   b   ; BC = index (復帰)
8F34                             ; data + index * 4 (C = index_lo, 配列は最大 8 要素)
8F34   79                     MOV   a,c   
8F35   87                     ADD   a   ; ×2
8F36   87                     ADD   a   ; ×4
8F37   5F                     MOV   e,a   
8F38   16 00                  MVI   d,0   
8F3A   19                     DAD   d   ; HL = &data[index*4] (source)
8F3B   E5                     PUSH   h   
8F3C   3E 01                  MVI   a,1   
8F3E   CD 03 84               CALL   get_reg_addr   ; HL = R[1] (dest)
8F41   EB                     XCHG      ; DE = R[1]
8F42   E1                     POP   h   ; HL = source
8F43   CD 28 84               CALL   copy_slot   ; R[1] = array[index]
8F46                ADV_REENTER:      
8F46                             ; PC = 0 で再実行
8F46   21 00 00               LXI   h,0   
8F49   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8F4C   C3 89 8F               JMP   vm_loop   
8F4F                ADV_DONE:      
8F4F                             ; 反復完了 → フレームを破棄して親に戻る
8F4F   CD 02 8B               CALL   pop_frame   
8F52   C3 89 8F               JMP   vm_loop   
8F55   00           ADV_KIND:   DB   0   
8F56                             ; ===============================================================
8F56                             ; OP_STOP (Z): VM 停止
8F56                             ; ===============================================================
8F56                DO_OP_STOP:      
8F56   3E 02                  MVI   a,VM_FINISHED   
8F58   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8F5B                             ; R[1] の値を 7 セグに表示
8F5B   3E 01                  MVI   a,1   
8F5D   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
8F60   CD 35 84               CALL   slot_to_value   ; HL = R[1] の値先頭
8F63   CD 4C 8E               CALL   display_hex16   
8F66   C3 77 8F               JMP   vm_halt   
8F69                             ; ===============================================================
8F69                             ; エラー停止
8F69                             ; 
8F69                             ; 未対応のオペコードを踏んだとき。
8F69                             ; 現在のオペコードをエラーコードとして保存する。
8F69                             ; ===============================================================
8F69                VM_ERROR:      
8F69   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8F6C   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
8F6F   3E 03                  MVI   a,VM_ERROR   
8F71   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8F74   C3 77 8F               JMP   vm_halt   
8F77                             ; ===============================================================
8F77                             ; 停止 — ND80Z モニタのリモートモードへ復帰
8F77                             ; 
8F77                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
8F77                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
8F77                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
8F77                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
8F77                             ; これにより自動的にリモートモードへ復帰する。
8F77                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
8F77                             ; ===============================================================
8F77                VM_HALT:      
8F77                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
8F77                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
8F77                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
8F77   06 04                  MVI   b,4   
8F79                VM_HALT_OUTER:      
8F79   11 00 00               LXI   d,0   
8F7C                VM_HALT_INNER:      
8F7C   1B                     DCX   d   
8F7D   7A                     MOV   a,d   
8F7E   B3                     ORA   e   
8F7F   C2 7C 8F               JNZ   vm_halt_inner   
8F82   05                     DCR   b   
8F83   C2 79 8F               JNZ   vm_halt_outer   
8F86   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
8F89                             ; ===============================================================
8F89                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
8F89                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
8F89                             ; ===============================================================
8F89                             ; ===============================================================
8F89                             ; メインループ (fetch-decode-execute)
8F89                             ; ===============================================================
8F89                VM_LOOP:      
8F89                             ; --- 実行状態の確認 ---
8F89   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
8F8C   FE 01                  CPI   VM_RUNNING   
8F8E   C2 77 8F               JNZ   vm_halt   
8F91                             ; --- PC がバイトコード長を超えていないか ---
8F91   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
8F94   EB                     XCHG      ; DE = PC
8F95   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
8F98                             ; HL = bytecode_len, DE = PC
8F98                             ; PC >= bytecode_len ならエラー
8F98   7B                     MOV   a,e   
8F99   95                     SUB   l   
8F9A   7A                     MOV   a,d   
8F9B   9C                     SBB   h   ; DE - HL (PC - len)
8F9C   D2 03 00               JNC   vm_error   ; PC >= len → エラー
8F9F                             ; --- オペコードフェッチ ---
8F9F   CD C3 84               CALL   fetch_byte   ; A = opcode
8FA2   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8FA5                             ; --- ステップカウント ---
8FA5   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
8FA8   23                     INX   h   
8FA9   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
8FAC                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
8FAC   7C                     MOV   a,h   
8FAD   B5                     ORA   l   
8FAE   C2 B8 8F               JNZ   vm_dispatch   
8FB1   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
8FB4   23                     INX   h   
8FB5   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
8FB8                             ; --- ディスパッチ ---
8FB8                VM_DISPATCH:      
8FB8   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8FBB                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
8FBB   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
8FBC   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
8FBF   5F                     MOV   e,a   
8FC0   16 00                  MVI   d,0   ; DE = opcode * 2
8FC2   21 00 A8               LXI   h,dispatch_table   
8FC5   19                     DAD   d   ; HL = &dispatch_table[opcode]
8FC6                             ; テーブル上限チェック
8FC6   11 D4 A8               LXI   d,dispatch_table_end   
8FC9   7B                     MOV   a,e   
8FCA   95                     SUB   l   
8FCB   7A                     MOV   a,d   
8FCC   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
8FCD   DA 03 00               JC   vm_error   ; テーブル範囲外
8FD0                             ; アドレスを読んでジャンプ
8FD0   5E                     MOV   e,m   ; E = 下位バイト
8FD1   23                     INX   h   
8FD2   56                     MOV   d,m   ; D = 上位バイト
8FD3   EB                     XCHG      ; HL = ハンドラアドレス
8FD4                             ; 0000h ならエラー (未実装マーカー)
8FD4   7C                     MOV   a,h   
8FD5   B5                     ORA   l   
8FD6   CA 03 00               JZ   vm_error   
8FD9   E9                     PCHL      ; ハンドラへジャンプ
8FDA                             ; ===============================================================
8FDA                             ; ディスパッチテーブル
8FDA                             ; 
8FDA                             ; オペコード番号順に 2 バイトのアドレスを並べる。
8FDA                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
8FDA                             ; 
8FDA                             ; VM コード (0x8400-0x8FFF) に収まらないため、定数プール後の空き領域
8FDA                             ; (0xA800-0xAFFF) に配置する。ディスパッチは 16 ビットアドレスなので
8FDA                             ; テーブルがどこにあっても動作する。
8FDA                             ; ===============================================================
A800                          .ORG   0A800h   
A800                DISPATCH_TABLE:      
A800   E1 84                  DW   do_op_nop   ; 00 OP_NOP
A802   E4 84                  DW   do_op_move   ; 01 OP_MOVE
A804   00 00                  DW   0000h   ; 02 OP_LOADL
A806   FA 84                  DW   do_op_loadi   ; 03 OP_LOADI
A808   0F 85                  DW   do_op_loadineg   ; 04 OP_LOADINEG
A80A   26 85                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
A80C   36 85                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
A80E   3B 85                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
A810   40 85                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
A812   45 85                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
A814   4A 85                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
A816   4F 85                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
A818   54 85                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
A81A   59 85                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
A81C   69 85                  DW   do_op_loadi16   ; 0E OP_LOADI16
A81E   00 00                  DW   0000h   ; 0F OP_LOADI32
A820   00 00                  DW   0000h   ; 10 OP_LOADSYM
A822   82 85                  DW   do_op_loadnil   ; 11 OP_LOADNIL
A824   6C 8B                  DW   do_op_loadself   ; 12 OP_LOADSELF
A826   90 85                  DW   do_op_loadt   ; 13 OP_LOADT
A828   9E 85                  DW   do_op_loadf   ; 14 OP_LOADF
A82A   CD 87                  DW   do_op_getgv   ; 15 OP_GETGV
A82C   0F 88                  DW   do_op_setgv   ; 16 OP_SETGV
A82E   00 00                  DW   0000h   ; 17 OP_GETSV
A830   00 00                  DW   0000h   ; 18 OP_SETSV
A832   CD 87                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
A834   0F 88                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
A836   00 00                  DW   0000h   ; 1B OP_GETCV
A838   00 00                  DW   0000h   ; 1C OP_SETCV
A83A   F5 8D                  DW   do_op_getconst   ; 1D OP_GETCONST
A83C   00 00                  DW   0000h   ; 1E OP_SETCONST
A83E   00 00                  DW   0000h   ; 1F OP_GETMCNST
A840   00 00                  DW   0000h   ; 20 OP_SETMCNST
A842   03 8D                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
A844   2F 8D                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
A846   19 AC                  DW   do_op_getidx   ; 23 OP_GETIDX
A848   C0 AC                  DW   do_op_setidx   ; 24 OP_SETIDX
A84A   86 87                  DW   do_op_jmp   ; 25 OP_JMP
A84C   8F 87                  DW   do_op_jmpif   ; 26 OP_JMPIF
A84E   AE 87                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
A850   00 00                  DW   0000h   ; 28 OP_JMPNIL
A852   00 00                  DW   0000h   ; 29 OP_JMPUW
A854   00 00                  DW   0000h   ; 2A OP_EXCEPT
A856   00 00                  DW   0000h   ; 2B OP_RESCUE
A858   00 00                  DW   0000h   ; 2C OP_RAISEIF
A85A   70 88                  DW   do_op_ssend   ; 2D OP_SSEND
A85C   B9 8B                  DW   do_op_ssendb   ; 2E OP_SSENDB
A85E   91 88                  DW   do_op_send   ; 2F OP_SEND
A860   DF 8B                  DW   do_op_sendb   ; 30 OP_SENDB
A862   00 00                  DW   0000h   ; 31 OP_CALL
A864   00 00                  DW   0000h   ; 32 OP_SUPER
A866   00 00                  DW   0000h   ; 33 OP_ARGARY
A868   AD 8B                  DW   do_op_enter   ; 34 OP_ENTER
A86A   00 00                  DW   0000h   ; 35 OP_KEY_P
A86C   00 00                  DW   0000h   ; 36 OP_KEYEND
A86E   00 00                  DW   0000h   ; 37 OP_KARG
A870   94 8E                  DW   do_op_return   ; 38 OP_RETURN
A872   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
A874   B4 8C                  DW   do_op_break   ; 3A OP_BREAK
A876   00 00                  DW   0000h   ; 3B OP_BLKPUSH
A878   AC 85                  DW   do_op_add   ; 3C OP_ADD
A87A   EE 85                  DW   do_op_addi   ; 3D OP_ADDI
A87C   D6 85                  DW   do_op_sub   ; 3E OP_SUB
A87E   08 86                  DW   do_op_subi   ; 3F OP_SUBI
A880   22 86                  DW   do_op_mul   ; 40 OP_MUL
A882   46 86                  DW   do_op_div   ; 41 OP_DIV
A884   25 87                  DW   do_op_eq   ; 42 OP_EQ
A886   4F 87                  DW   do_op_lt   ; 43 OP_LT
A888   59 87                  DW   do_op_le   ; 44 OP_LE
A88A   66 87                  DW   do_op_gt   ; 45 OP_GT
A88C   73 87                  DW   do_op_ge   ; 46 OP_GE
A88E   76 AD                  DW   do_op_array   ; 47 OP_ARRAY
A890   20 B5                  DW   do_op_array2   ; 48 OP_ARRAY2
A892   00 00                  DW   0000h   ; 49 OP_ARYCAT
A894   F2 AD                  DW   do_op_arypush   ; 4A OP_ARYPUSH
A896   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
A898   00 00                  DW   0000h   ; 4C OP_AREF
A89A   00 00                  DW   0000h   ; 4D OP_ASET
A89C   00 00                  DW   0000h   ; 4E OP_APOST
A89E   00 00                  DW   0000h   ; 4F OP_INTERN
A8A0   00 00                  DW   0000h   ; 50 OP_SYMBOL
A8A2   77 A9                  DW   do_op_string   ; 51 OP_STRING
A8A4   6A AE                  DW   do_op_strcat   ; 52 OP_STRCAT
A8A6   32 B5                  DW   do_op_hash   ; 53 OP_HASH
A8A8   00 00                  DW   0000h   ; 54 OP_HASHADD
A8AA   00 00                  DW   0000h   ; 55 OP_HASHCAT
A8AC   00 00                  DW   0000h   ; 56 OP_LAMBDA
A8AE   80 8B                  DW   do_op_block   ; 57 OP_BLOCK
A8B0   6D 8D                  DW   do_op_method   ; 58 OP_METHOD
A8B2   00 00                  DW   0000h   ; 59 OP_RANGE_INC
A8B4   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
A8B6   00 00                  DW   0000h   ; 5B OP_OCLASS
A8B8   F5 8D                  DW   do_op_class   ; 5C OP_CLASS
A8BA   00 00                  DW   0000h   ; 5D OP_MODULE
A8BC   22 8E                  DW   do_op_exec   ; 5E OP_EXEC
A8BE   8E 8D                  DW   do_op_def   ; 5F OP_DEF
A8C0   00 00                  DW   0000h   ; 60 OP_ALIAS
A8C2   00 00                  DW   0000h   ; 61 OP_UNDEF
A8C4   00 00                  DW   0000h   ; 62 OP_SCLASS
A8C6   5B 8D                  DW   do_op_tclass   ; 63 OP_TCLASS
A8C8   00 00                  DW   0000h   ; 64 OP_DEBUG
A8CA   00 00                  DW   0000h   ; 65 OP_ERR
A8CC   00 00                  DW   0000h   ; 66 OP_EXT1
A8CE   00 00                  DW   0000h   ; 67 OP_EXT2
A8D0   00 00                  DW   0000h   ; 68 OP_EXT3
A8D2   56 8F                  DW   do_op_stop   ; 69 OP_STOP
A8D4                DISPATCH_TABLE_END:      
A8D4                             ; ===============================================================
A8D4                             ; 初期化 (起動時 1 回だけ。ディスパッチテーブル後に配置)
A8D4                             ; ===============================================================
A8D4                VM_START:      
A8D4                             ; スタックポインタを設定
A8D4   31 00 FE               LXI   sp,STACK_TOP + 1   
A8D7                             ; VM 状態領域をゼロクリア (256 バイト)
A8D7   21 00 80               LXI   h,VM_STATE_BASE   
A8DA   0E 00                  MVI   c,0   ; 256 回 (0 は 256 として扱う)
A8DC                VM_CLEAR_STATE:      
A8DC   36 00                  MVI   m,0   
A8DE   23                     INX   h   
A8DF   0D                     DCR   c   
A8E0   C2 DC A8               JNZ   vm_clear_state   
A8E3                             ; レジスタファイルをゼロクリア (256 バイト)
A8E3   21 00 81               LXI   h,REG_FILE_BASE   
A8E6   0E 00                  MVI   c,0   
A8E8                VM_CLEAR_REGS:      
A8E8   36 00                  MVI   m,0   
A8EA   23                     INX   h   
A8EB   0D                     DCR   c   
A8EC   C2 E8 A8               JNZ   vm_clear_regs   
A8EF                             ; メソッド表をゼロクリア (128 バイト)
A8EF   21 60 B1               LXI   h,METHOD_TABLE_BASE   
A8F2   0E 80                  MVI   c,METHOD_TABLE_SIZE   
A8F4                VM_CLEAR_MTABLE:      
A8F4   36 00                  MVI   m,0   
A8F6   23                     INX   h   
A8F7   0D                     DCR   c   
A8F8   C2 F4 A8               JNZ   vm_clear_mtable   
A8FB                             ; オブジェクトプールをゼロクリア (256 バイト)
A8FB   21 E0 B1               LXI   h,OBJECT_POOL_BASE   
A8FE   0E 00                  MVI   c,0   ; 256 回
A900                VM_CLEAR_OBJPOOL:      
A900   36 00                  MVI   m,0   
A902   23                     INX   h   
A903   0D                     DCR   c   
A904   C2 00 A9               JNZ   vm_clear_objpool   
A907                             ; コレクションプールをゼロクリア (576 バイト = 2 × 256 + 64)
A907   21 E0 B2               LXI   h,COLLECTION_POOL_BASE   
A90A   0E 00                  MVI   c,0   ; 256 回
A90C                VM_CLEAR_COLPOOL1:      
A90C   36 00                  MVI   m,0   
A90E   23                     INX   h   
A90F   0D                     DCR   c   
A910   C2 0C A9               JNZ   vm_clear_colpool1   
A913   0E 00                  MVI   c,0   ; 256 回
A915                VM_CLEAR_COLPOOL2:      
A915   36 00                  MVI   m,0   
A917   23                     INX   h   
A918   0D                     DCR   c   
A919   C2 15 A9               JNZ   vm_clear_colpool2   
A91C   0E 40                  MVI   c,64   ; 残り 64 バイト
A91E                VM_CLEAR_COLPOOL3:      
A91E   36 00                  MVI   m,0   
A920   23                     INX   h   
A921   0D                     DCR   c   
A922   C2 1E A9               JNZ   vm_clear_colpool3   
A925                             ; IREP 0 のバイトコード長を VM 状態に設定
A925                             ; IREP テーブルの先頭エントリから読む
A925   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
A928   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
A92B   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
A92E   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
A931                             ; レジスタベースを初期化 (REG_FILE_BASE)
A931   21 00 81               LXI   h,REG_FILE_BASE   
A934   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
A937                             ; バイトコードベースを IREP 0 から読んで設定
A937   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
A93A   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
A93D   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
A940   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
A943                             ; シンボルテーブルベースを IREP 0 から読んで設定
A943   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
A946   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
A949   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
A94C   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
A94F                             ; 定数プールベースを IREP 0 から読んで設定
A94F   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
A952   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
A955   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
A958   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
A95B                             ; フレーム SP = 0 (ゼロクリア済み)
A95B                             ; PC = 0 (ゼロクリア済み)
A95B                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
A95B                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
A95B   3A FE 82               LDA   INIT_METHOD_ID_STORE   
A95E   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
A961                             ; R[0] = self (TT_OBJECT, 値 = 0)
A961   21 00 81               LXI   h,REG_FILE_BASE   
A964   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
A966   23                     INX   h   
A967   36 00                  MVI   m,0   ; +1: 予約
A969   23                     INX   h   
A96A   36 00                  MVI   m,0   ; +2: val_lo
A96C   23                     INX   h   
A96D   36 00                  MVI   m,0   ; +3: val_hi
A96F                             ; 実行状態を RUNNING に設定
A96F   3E 01                  MVI   a,VM_RUNNING   
A971   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
A974                             ; メインループへ
A974   C3 89 8F               JMP   vm_loop   
A977                             ; ===============================================================
A977                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
A977                             ; 
A977                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
A977                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
A977                             ; ===============================================================
A977                DO_OP_STRING:      
A977   CD C3 84               CALL   fetch_byte   ; A = a
A97A   32 D4 A9               STA   ops_reg_a   
A97D   CD C3 84               CALL   fetch_byte   ; A = b (プールインデックス)
A980                             ; pool_base + b * 4 を計算
A980   87                     ADD   a   ; b * 2
A981   87                     ADD   a   ; b * 4
A982   5F                     MOV   e,a   
A983   16 00                  MVI   d,0   
A985   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
A988   19                     DAD   d   ; HL = &Pool[b]
A989                             ; Pool[b] の val (文字列データアドレス) を取得
A989   23                     INX   h   ; +1: 予約
A98A   23                     INX   h   ; +2: val_lo
A98B   5E                     MOV   e,m   
A98C   23                     INX   h   ; +3: val_hi
A98D   56                     MOV   d,m   ; DE = 文字列データアドレス
A98E                             ; DE → 長さバイト + ASCII データ
A98E   1A                     LDAX   d   ; A = 文字列長
A98F   32 D5 A9               STA   ops_str_len   
A992   13                     INX   d   ; DE → 最初のバイト
A993   D5                     PUSH   d   ; 文字列データソース退避
A994                             ; コレクションスロットを確保
A994   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
A997   32 D6 A9               STA   ops_slot_num   
A99A                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
A99A   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
A99C   23                     INX   h   
A99D   3A D5 A9               LDA   ops_str_len   
A9A0   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
A9A2   DA A7 A9               JC   ops_len_ok   
A9A5   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
A9A7                OPS_LEN_OK:      
A9A7   77                     MOV   m,a   ; +1: count
A9A8   32 D5 A9               STA   ops_str_len   ; 切り詰め後の長さ
A9AB   23                     INX   h   ; HL → データ領域先頭
A9AC                             ; 文字列データをコピー
A9AC   D1                     POP   d   ; DE = ソースデータ
A9AD   3A D5 A9               LDA   ops_str_len   
A9B0   B7                     ORA   a   
A9B1   CA BD A9               JZ   ops_set_reg   ; 空文字列
A9B4   4F                     MOV   c,a   
A9B5                OPS_STR_COPY:      
A9B5   1A                     LDAX   d   
A9B6   77                     MOV   m,a   
A9B7   23                     INX   h   
A9B8   13                     INX   d   
A9B9   0D                     DCR   c   
A9BA   C2 B5 A9               JNZ   ops_str_copy   
A9BD                OPS_SET_REG:      
A9BD                             ; R[a] = TT_STRING, val_lo = slot+1
A9BD   3A D4 A9               LDA   ops_reg_a   
A9C0   CD 03 84               CALL   get_reg_addr   ; HL = &R[a]
A9C3   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
A9C5   23                     INX   h   
A9C6   36 00                  MVI   m,0   ; +1: 予約
A9C8   23                     INX   h   
A9C9   3A D6 A9               LDA   ops_slot_num   
A9CC   3C                     INR   a   ; slot + 1
A9CD   77                     MOV   m,a   ; +2: val_lo
A9CE   23                     INX   h   
A9CF   36 00                  MVI   m,0   ; +3: val_hi
A9D1   C3 89 8F               JMP   vm_loop   
A9D4   00           OPS_REG_A:   DB   0   
A9D5   00           OPS_STR_LEN:   DB   0   
A9D6   00           OPS_SLOT_NUM:   DB   0   
A9D7                             ; ===============================================================
A9D7                             ; send_display — display(value): 7 セグに hex 表示
A9D7                             ; 
A9D7                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
A9D7                             ; R[a] に nil を返す。
A9D7                             ; ===============================================================
A9D7                SEND_DISPLAY:      
A9D7   3A 58 8A               LDA   send_reg_a   
A9DA   3C                     INR   a   
A9DB   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
A9DE   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
A9E1   CD 4C 8E               CALL   display_hex16   ; 7 セグに書く
A9E4                             ; return nil
A9E4   3A 58 8A               LDA   send_reg_a   
A9E7   CD 03 84               CALL   get_reg_addr   
A9EA   3E 01                  MVI   a,TT_NIL   
A9EC   CD 1D 84               CALL   set_slot_special   
A9EF   C3 89 8F               JMP   vm_loop   
A9F2                             ; ===============================================================
A9F2                             ; send_getkey — getkey / getkey(timeout)
A9F2                             ; 
A9F2                             ; getkey (引数なし): KEYIN1 でブロッキング入力
A9F2                             ;   ROM なし → -1
A9F2                             ;   キー押下 → キーコード (0x00-0x17)
A9F2                             ; 
A9F2                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
A9F2                             ;   最大 n 回スキャン、キー押下 → キーコード
A9F2                             ;   タイムアウト / ROM なし → nil
A9F2                             ; 
A9F2                             ; キーコード割り当て (KEYIN1/KEY 共通):
A9F2                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
A9F2                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
A9F2                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
A9F2                             ;                                           0x17: LOAD
A9F2                             ; ===============================================================
A9F2                SEND_GETKEY:      
A9F2                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
A9F2   3A 59 8A               LDA   send_argc   
A9F5   B7                     ORA   a   
A9F6   C2 A1 B6               JNZ   send_getkey_timeout   
A9F9                             ; --- ブロッキング版 (引数なし) ---
A9F9   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
A9FC   B7                     ORA   a   
A9FD   CA 1D AA               JZ   getkey_no_key   ; ROM なし → -1
AA00                             ; キー入力をポーリングしながら LFSR を回す。
AA00                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
AA00                             ; 乱数の種が毎回異なる。
AA00                GETKEY_POLL:      
AA00   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
AA03   FE FF                  CPI   0FFh   
AA05   C2 0E AA               JNZ   getkey_got_key   
AA08   CD 8D AB               CALL   lfsr_next   ; 待機中に LFSR を進める
AA0B   C3 00 AA               JMP   getkey_poll   
AA0E                GETKEY_GOT_KEY:      
AA0E                             ; キーコードを R[a] に返す
AA0E   4F                     MOV   c,a   
AA0F   06 00                  MVI   b,0   
AA11   3A 58 8A               LDA   send_reg_a   
AA14   CD 03 84               CALL   get_reg_addr   
AA17   CD 13 84               CALL   set_slot_int16   
AA1A   C3 89 8F               JMP   vm_loop   
AA1D                GETKEY_NO_KEY:      
AA1D   3A 58 8A               LDA   send_reg_a   
AA20   CD 03 84               CALL   get_reg_addr   
AA23   06 FF                  MVI   b,0FFh   
AA25   0E FF                  MVI   c,0FFh   ; -1
AA27   CD 13 84               CALL   set_slot_int16   
AA2A   C3 89 8F               JMP   vm_loop   
AA2D                             ; ===============================================================
AA2D                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
AA2D                             ; 
AA2D                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
AA2D                             ; E レジスタにメソッド ID が入っている。
AA2D                             ; ===============================================================
AA2D                SEND_BUILTIN_EXT:      
AA2D   7B                     MOV   a,e   
AA2E   FE 1F                  CPI   METHOD_PUTS   
AA30   CA 54 AA               JZ   send_puts   
AA33   FE 20                  CPI   METHOD_SETSEG   
AA35   CA F8 AA               JZ   send_setseg   
AA38   FE 21                  CPI   METHOD_RAND   
AA3A   CA B2 AB               JZ   send_rand   
AA3D   FE 12                  CPI   METHOD_LENGTH   
AA3F   CA E6 AE               JZ   send_length   
AA42   FE 14                  CPI   METHOD_CONCAT   
AA44   CA FF AE               JZ   send_concat   
AA47   FE 16                  CPI   METHOD_PUSH   
AA49   CA BD AF               JZ   concat_array   ; push は concat_array と同じ
AA4C   FE 22                  CPI   METHOD_SLICE   
AA4E   CA EA B6               JZ   send_slice   
AA51   C3 03 00               JMP   vm_error   ; 未対応メソッド
AA54                             ; ===============================================================
AA54                             ; send_puts — puts(value): 文字列を 7 セグに表示
AA54                             ; 
AA54                             ; R[a+1] が TT_STRING の場合:
AA54                             ;   文字列データのアドレスから長さとバイト列を読み、
AA54                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
AA54                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
AA54                             ; 
AA54                             ; R[a+1] が TT_INTEGER の場合:
AA54                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
AA54                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
AA54                             ; 
AA54                             ; 使い方:
AA54                             ;   puts "HELLO"          # 文字列を表示
AA54                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
AA54                             ; ===============================================================
AA54                SEND_PUTS:      
AA54   3A 58 8A               LDA   send_reg_a   
AA57   3C                     INR   a   
AA58   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
AA5B   7E                     MOV   a,m   ; A = 型タグ
AA5C   FE 07                  CPI   TT_STRING   
AA5E   CA 98 AA               JZ   puts_string   
AA61                             ; TT_INTEGER: 従来のパック ASCII 処理
AA61   FE 04                  CPI   TT_INTEGER   
AA63   C2 03 00               JNZ   vm_error   
AA66                             ; --- 整数パス (2 文字スクロール表示) ---
AA66   3A 58 8A               LDA   send_reg_a   
AA69   3C                     INR   a   
AA6A   CD 03 84               CALL   get_reg_addr   
AA6D   CD 35 84               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
AA70   4E                     MOV   c,m   ; C = val_lo (右の文字)
AA71   23                     INX   h   
AA72   46                     MOV   b,m   ; B = val_hi (左の文字)
AA73   C5                     PUSH   b   
AA74                             ; 表示バッファを左に 2 桁スクロール
AA74   21 FA FF               LXI   h,DISPLAY_BASE + 2   
AA77   11 F8 FF               LXI   d,DISPLAY_BASE   
AA7A   06 06                  MVI   b,6   
AA7C                PUTS_SCROLL:      
AA7C   7E                     MOV   a,m   
AA7D   12                     STAX   d   
AA7E   23                     INX   h   
AA7F   13                     INX   d   
AA80   05                     DCR   b   
AA81   C2 7C AA               JNZ   puts_scroll   
AA84   C1                     POP   b   
AA85   C5                     PUSH   b   
AA86   78                     MOV   a,b   
AA87   CD 31 AB               CALL   ascii_to_seg   
AA8A   32 FE FF               STA   DISPLAY_BASE + 6   
AA8D   C1                     POP   b   
AA8E   79                     MOV   a,c   
AA8F   CD 31 AB               CALL   ascii_to_seg   
AA92   32 FF FF               STA   DISPLAY_BASE + 7   
AA95   C3 E5 AA               JMP   puts_ret_nil   
AA98                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
AA98                PUTS_STRING:      
AA98   3A 58 8A               LDA   send_reg_a   
AA9B   3C                     INR   a   
AA9C   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
AA9F   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロットアドレス
AAA2                             ; +1: count (文字列長)
AAA2   23                     INX   h   
AAA3   7E                     MOV   a,m   ; A = 文字列長
AAA4   B7                     ORA   a   
AAA5   CA E5 AA               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
AAA8   FE 09                  CPI   9   
AAAA   DA AF AA               JC   sp_len_ok   
AAAD   3E 08                  MVI   a,8   ; 最大 8 文字
AAAF                SP_LEN_OK:      
AAAF   32 F3 AA               STA   sp_count   
AAB2   23                     INX   h   ; HL → データ領域先頭
AAB3   22 F4 AA               SHLD   sp_src   ; 文字列ソースポインタ退避
AAB6                             ; 表示バッファ全体をクリア
AAB6   21 F8 FF               LXI   h,DISPLAY_BASE   
AAB9   0E 08                  MVI   c,DISPLAY_SIZE   
AABB                PUTS_STR_CLEAR:      
AABB   36 00                  MVI   m,0   
AABD   23                     INX   h   
AABE   0D                     DCR   c   
AABF   C2 BB AA               JNZ   puts_str_clear   
AAC2                             ; 文字列の各バイトを変換して表示
AAC2   21 F8 FF               LXI   h,DISPLAY_BASE   
AAC5   22 F6 AA               SHLD   sp_dst   ; 表示書き込みポインタ
AAC8                PUTS_STR_LOOP:      
AAC8   2A F4 AA               LHLD   sp_src   
AACB   7E                     MOV   a,m   ; A = ASCII コード
AACC   23                     INX   h   
AACD   22 F4 AA               SHLD   sp_src   
AAD0   CD 31 AB               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
AAD3   2A F6 AA               LHLD   sp_dst   
AAD6   77                     MOV   m,a   
AAD7   23                     INX   h   
AAD8   22 F6 AA               SHLD   sp_dst   
AADB   3A F3 AA               LDA   sp_count   
AADE   3D                     DCR   a   
AADF   32 F3 AA               STA   sp_count   
AAE2   C2 C8 AA               JNZ   puts_str_loop   
AAE5                PUTS_RET_NIL:      
AAE5   3A 58 8A               LDA   send_reg_a   
AAE8   CD 03 84               CALL   get_reg_addr   
AAEB   3E 01                  MVI   a,TT_NIL   
AAED   CD 1D 84               CALL   set_slot_special   
AAF0   C3 89 8F               JMP   vm_loop   
AAF3   00           SP_COUNT:   DB   0   
AAF4   00 00        SP_SRC:   DW   0   
AAF6   00 00        SP_DST:   DW   0   
AAF8                             ; ===============================================================
AAF8                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
AAF8                             ; 
AAF8                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
AAF8                             ; ===============================================================
AAF8                SEND_SETSEG:      
AAF8                             ; 桁位置を取得
AAF8   3A 58 8A               LDA   send_reg_a   
AAFB   3C                     INR   a   
AAFC   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
AAFF   CD 35 84               CALL   slot_to_value   
AB02   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
AB03   FE 08                  CPI   DISPLAY_SIZE   
AB05   D2 03 00               JNC   vm_error   ; 桁位置 >= 8 → エラー
AB08   32 30 AB               STA   ss_pos   
AB0B                             ; パターンを取得
AB0B   3A 58 8A               LDA   send_reg_a   
AB0E   3C                     INR   a   
AB0F   3C                     INR   a   
AB10   CD 03 84               CALL   get_reg_addr   ; HL = R[a+2]
AB13   CD 35 84               CALL   slot_to_value   
AB16   46                     MOV   b,m   ; B = パターン (val_lo)
AB17                             ; DISPLAY_BASE + pos にパターンを書く
AB17   3A 30 AB               LDA   ss_pos   
AB1A   6F                     MOV   l,a   
AB1B   26 00                  MVI   h,0   
AB1D   11 F8 FF               LXI   d,DISPLAY_BASE   
AB20   19                     DAD   d   ; HL = DISPLAY_BASE + pos
AB21   70                     MOV   m,b   
AB22                             ; R[a] に nil を返す
AB22   3A 58 8A               LDA   send_reg_a   
AB25   CD 03 84               CALL   get_reg_addr   
AB28   3E 01                  MVI   a,TT_NIL   
AB2A   CD 1D 84               CALL   set_slot_special   
AB2D   C3 89 8F               JMP   vm_loop   
AB30   00           SS_POS:   DB   0   
AB31                             ; ===============================================================
AB31                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
AB31                             ; 
AB31                             ;   入力: A = ASCII コード
AB31                             ;   出力: A = セグメントパターン
AB31                             ;   破壊: HL, BC
AB31                             ; 
AB31                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
AB31                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
AB31                             ; 範囲外はブランク (0x00) を返す。
AB31                             ; ===============================================================
AB31                ASCII_TO_SEG:      
AB31   FE 60                  CPI   60h   
AB33   DA 38 AB               JC   ats_no_fold   
AB36   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
AB38                ATS_NO_FOLD:      
AB38   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
AB3A   DA 4B AB               JC   ats_blank   ; 元が < 0x20 → ブランク
AB3D   FE 40                  CPI   40h   
AB3F   D2 4B AB               JNC   ats_blank   ; >= 64 → ブランク
AB42                             ; テーブル参照
AB42   6F                     MOV   l,a   
AB43   26 00                  MVI   h,0   
AB45   01 4D AB               LXI   b,ascii_seg_table   
AB48   09                     DAD   b   ; HL = ascii_seg_table + index
AB49   7E                     MOV   a,m   
AB4A   C9                     RET      
AB4B                ATS_BLANK:      
AB4B   AF                     XRA   a   ; A = 0 (ブランク)
AB4C   C9                     RET      
AB4D                             ; ===============================================================
AB4D                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
AB4D                             ; 
AB4D                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
AB4D                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
AB4D                             ; 
AB4D                             ; セグメント配置:
AB4D                             ;     aaa        bit 0 = a (上)
AB4D                             ;    f   b       bit 1 = b (右上)
AB4D                             ;     ggg        bit 2 = c (右下)
AB4D                             ;    e   c       bit 3 = d (下)
AB4D                             ;     ddd        bit 4 = e (左下)
AB4D                             ;                bit 5 = f (左上)
AB4D                             ;                bit 6 = g (中)
AB4D                             ; 
AB4D                             ; 表現できない文字は 0x00 (消灯)。
AB4D                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
AB4D                             ; ===============================================================
AB4D                ASCII_SEG_TABLE:      
AB4D                             ; 0x20-0x2F: 記号
AB4D   00                     DB   00h   ; 0x20 " " (スペース)
AB4E   06                     DB   06h   ; 0x21 "!" (bc)
AB4F   22                     DB   22h   ; 0x22 """ (bf)
AB50   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
AB51   6D                     DB   6Dh   ; 0x24 "$" (= S)
AB52   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
AB53   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
AB54   02                     DB   02h   ; 0x27 "'" (b)
AB55   39                     DB   39h   ; 0x28 "(" (= C)
AB56   0F                     DB   0Fh   ; 0x29 ")" (abcd)
AB57   49                     DB   49h   ; 0x2A "*" (adg = 三)
AB58   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
AB59   04                     DB   04h   ; 0x2C "," (c)
AB5A   40                     DB   40h   ; 0x2D "-" (g)
AB5B   08                     DB   08h   ; 0x2E "." (d)
AB5C   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
AB5D                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
AB5D   5C                     DB   5Ch   ; 0x30 "0"
AB5E   06                     DB   06h   ; 0x31 "1"
AB5F   5B                     DB   5Bh   ; 0x32 "2"
AB60   4F                     DB   4Fh   ; 0x33 "3"
AB61   66                     DB   66h   ; 0x34 "4"
AB62   6D                     DB   6Dh   ; 0x35 "5"
AB63   7D                     DB   7Dh   ; 0x36 "6"
AB64   27                     DB   27h   ; 0x37 "7"
AB65   7F                     DB   7Fh   ; 0x38 "8"
AB66   6F                     DB   6Fh   ; 0x39 "9"
AB67                             ; 0x3A-0x40: 記号
AB67   09                     DB   09h   ; 0x3A ":" (ad)
AB68   00                     DB   00h   ; 0x3B ";"
AB69   00                     DB   00h   ; 0x3C "<"
AB6A   48                     DB   48h   ; 0x3D "=" (dg)
AB6B   00                     DB   00h   ; 0x3E ">"
AB6C   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
AB6D   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
AB6E                             ; 0x41-0x5A: 英字
AB6E   77                     DB   77h   ; 0x41 "A" (abcefg)
AB6F   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
AB70   39                     DB   39h   ; 0x43 "C" (adef)
AB71   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
AB72   79                     DB   79h   ; 0x45 "E" (adefg)
AB73   71                     DB   71h   ; 0x46 "F" (aefg)
AB74   3D                     DB   3Dh   ; 0x47 "G" (acdef)
AB75   76                     DB   76h   ; 0x48 "H" (bcefg)
AB76   06                     DB   06h   ; 0x49 "I" (bc)
AB77   1E                     DB   1Eh   ; 0x4A "J" (bcde)
AB78   74                     DB   74h   ; 0x4B "K" (cefg = h)
AB79   38                     DB   38h   ; 0x4C "L" (def)
AB7A   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
AB7B   54                     DB   54h   ; 0x4E "N" (ceg = n)
AB7C   5C                     DB   5Ch   ; 0x4F "O" (= 0)
AB7D   73                     DB   73h   ; 0x50 "P" (abefg)
AB7E   67                     DB   67h   ; 0x51 "Q" (abcfg)
AB7F   50                     DB   50h   ; 0x52 "R" (eg = r)
AB80   6D                     DB   6Dh   ; 0x53 "S" (= 5)
AB81   78                     DB   78h   ; 0x54 "T" (defg = t)
AB82   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
AB83   3E                     DB   3Eh   ; 0x56 "V" (= U)
AB84   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
AB85   76                     DB   76h   ; 0x58 "X" (bcefg = H)
AB86   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
AB87   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
AB88                             ; 0x5B-0x5F: 記号
AB88   39                     DB   39h   ; 0x5B "[" (= C)
AB89   00                     DB   00h   ; 0x5C "\"
AB8A   0F                     DB   0Fh   ; 0x5D "]" (= ))
AB8B   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
AB8C   08                     DB   08h   ; 0x5F "_" (d)
AB8D                             ; ===============================================================
AB8D                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
AB8D                             ; 
AB8D                             ;   入力: なし
AB8D                             ;   出力: HL = 新しい乱数値
AB8D                             ;   破壊: A, HL
AB8D                             ; 
AB8D                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
AB8D                             ; 周期: 65535
AB8D                             ; ===============================================================
AB8D                LFSR_NEXT:      
AB8D   2A B0 AB               LHLD   lfsr_state   
AB90   7D                     MOV   a,l   
AB91   E6 01                  ANI   1   ; LSB チェック
AB93   CA A5 AB               JZ   lfsr_no_tap   
AB96                             ; LSB=1: 右シフト + XOR タップ
AB96   7C                     MOV   a,h   
AB97   B7                     ORA   a   ; CY=0 クリア
AB98   1F                     RAR      
AB99   67                     MOV   h,a   
AB9A   7D                     MOV   a,l   
AB9B   1F                     RAR      
AB9C   6F                     MOV   l,a   
AB9D   7C                     MOV   a,h   
AB9E   EE B4                  XRI   0B4h   
ABA0   67                     MOV   h,a   
ABA1   22 B0 AB               SHLD   lfsr_state   
ABA4   C9                     RET      
ABA5                LFSR_NO_TAP:      
ABA5                             ; LSB=0: 右シフトのみ
ABA5   7C                     MOV   a,h   
ABA6   B7                     ORA   a   
ABA7   1F                     RAR      
ABA8   67                     MOV   h,a   
ABA9   7D                     MOV   a,l   
ABAA   1F                     RAR      
ABAB   6F                     MOV   l,a   
ABAC   22 B0 AB               SHLD   lfsr_state   
ABAF   C9                     RET      
ABB0   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
ABB2                             ; ===============================================================
ABB2                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
ABB2                             ; 
ABB2                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
ABB2                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
ABB2                             ; ===============================================================
ABB2                SEND_RAND:      
ABB2                             ; R[a+1] から n を取得
ABB2   3A 58 8A               LDA   send_reg_a   
ABB5   3C                     INR   a   
ABB6   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
ABB9   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
ABBC   5E                     MOV   e,m   
ABBD   23                     INX   h   
ABBE   56                     MOV   d,m   ; DE = n
ABBF                             ; n == 0 チェック
ABBF   7A                     MOV   a,d   
ABC0   B3                     ORA   e   
ABC1   CA DC AB               JZ   rand_zero   
ABC4   D5                     PUSH   d   ; n を退避
ABC5   CD 8D AB               CALL   lfsr_next   ; HL = 乱数
ABC8   44                     MOV   b,h   
ABC9   4D                     MOV   c,l   ; BC = 乱数 (被除数)
ABCA   D1                     POP   d   ; DE = n (除数)
ABCB   CD A8 86               CALL   udiv16   ; BC=商, HL=剰余
ABCE                             ; HL (剰余) → BC → R[a]
ABCE   44                     MOV   b,h   
ABCF   4D                     MOV   c,l   
ABD0   3A 58 8A               LDA   send_reg_a   
ABD3   CD 03 84               CALL   get_reg_addr   
ABD6   CD 13 84               CALL   set_slot_int16   
ABD9   C3 89 8F               JMP   vm_loop   
ABDC                RAND_ZERO:      
ABDC   06 00                  MVI   b,0   
ABDE   0E 00                  MVI   c,0   
ABE0   3A 58 8A               LDA   send_reg_a   
ABE3   CD 03 84               CALL   get_reg_addr   
ABE6   CD 13 84               CALL   set_slot_int16   
ABE9   C3 89 8F               JMP   vm_loop   
ABEC                             ; ===============================================================
ABEC                             ; コレクションプール基盤ルーチン
ABEC                             ; ===============================================================
ABEC                             ; ---------------------------------------------------------------
ABEC                             ; col_slot_addr — スロット番号からアドレスを計算
ABEC                             ; 
ABEC                             ;   入力: A = スロット番号 (0-based)
ABEC                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
ABEC                             ;   破壊: A, DE
ABEC                             ; ---------------------------------------------------------------
ABEC                COL_SLOT_ADDR:      
ABEC                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
ABEC                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
ABEC   6F                     MOV   l,a   
ABED   26 00                  MVI   h,0   ; HL = slot_number
ABEF   29                     DAD   h   ; HL = slot_number × 2
ABF0   29                     DAD   h   ; HL = slot_number × 4
ABF1   54                     MOV   d,h   
ABF2   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
ABF3   29                     DAD   h   ; HL = slot_number × 8
ABF4   29                     DAD   h   ; HL = slot_number × 16
ABF5   29                     DAD   h   ; HL = slot_number × 32
ABF6   19                     DAD   d   ; HL = slot_number × 36
ABF7   11 E0 B2               LXI   d,COLLECTION_POOL_BASE   
ABFA   19                     DAD   d   
ABFB   C9                     RET      
ABFC                             ; ---------------------------------------------------------------
ABFC                             ; col_alloc — コレクションスロットを確保
ABFC                             ; 
ABFC                             ;   入力: なし
ABFC                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
ABFC                             ;   破壊: DE
ABFC                             ;   エラー: プール満杯かつ GC で回収不可 → vm_error
ABFC                             ; ---------------------------------------------------------------
ABFC                COL_ALLOC:      
ABFC   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
ABFF   FE 10                  CPI   MAX_COL_SLOTS   
AC01   D2 97 B7               JNC   col_gc_alloc   ; プール満杯 → GC 試行
AC04   F5                     PUSH   psw   ; スロット番号を退避
AC05   CD EC AB               CALL   col_slot_addr   ; HL = スロットアドレス
AC08                             ; COL_SP++
AC08   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
AC0B   3C                     INR   a   
AC0C   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
AC0F   F1                     POP   psw   ; A = スロット番号
AC10   C9                     RET      
AC11                             ; ---------------------------------------------------------------
AC11                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
AC11                             ; 
AC11                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
AC11                             ;   出力: HL = コレクションスロットアドレス
AC11                             ;   破壊: A, DE
AC11                             ; ---------------------------------------------------------------
AC11                COL_FROM_REG:      
AC11   CD 35 84               CALL   slot_to_value   ; HL = val アドレス
AC14   7E                     MOV   a,m   ; A = val_lo = slot+1
AC15   3D                     DCR   a   ; A = slot_number (0-based)
AC16   C3 EC AB               JMP   col_slot_addr   
AC19                             ; ===============================================================
AC19                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
AC19                             ; 
AC19                             ; R[a] の型で分岐:
AC19                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
AC19                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
AC19                             ; ===============================================================
AC19                DO_OP_GETIDX:      
AC19   CD C3 84               CALL   fetch_byte   ; A = a
AC1C   32 BC AC               STA   gidx_reg_a   
AC1F   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
AC22   7E                     MOV   a,m   ; A = 型タグ
AC23   FE 07                  CPI   TT_STRING   
AC25   CA 35 AC               JZ   gidx_string   
AC28   FE 08                  CPI   TT_ARRAY   
AC2A   CA 81 AC               JZ   gidx_array   
AC2D   FE 09                  CPI   TT_HASH   
AC2F   CA 9E B5               JZ   gidx_hash   
AC32   C3 03 00               JMP   vm_error   
AC35                GIDX_STRING:      
AC35                             ; R[a] のコレクションスロットを取得
AC35   3A BC AC               LDA   gidx_reg_a   
AC38   CD 03 84               CALL   get_reg_addr   
AC3B   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AC3E   23                     INX   h   ; +1: count
AC3F   46                     MOV   b,m   ; B = 文字列長
AC40   23                     INX   h   ; HL → データ領域先頭
AC41   22 BD AC               SHLD   gidx_data_addr   
AC44                             ; R[a+1] からインデックスを取得
AC44   3A BC AC               LDA   gidx_reg_a   
AC47   3C                     INR   a   
AC48   CD 03 84               CALL   get_reg_addr   
AC4B   CD 35 84               CALL   slot_to_value   
AC4E   7E                     MOV   a,m   ; A = index (val_lo)
AC4F                             ; 範囲チェック: index < 文字列長
AC4F   B8                     CMP   b   
AC50   D2 03 00               JNC   vm_error   ; index >= 長さ → エラー
AC53                             ; データ先頭 + index で 1 文字を取得
AC53   5F                     MOV   e,a   
AC54   16 00                  MVI   d,0   
AC56   2A BD AC               LHLD   gidx_data_addr   
AC59   19                     DAD   d   ; HL = &data[index]
AC5A   4E                     MOV   c,m   ; C = 文字コード
AC5B                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
AC5B   C5                     PUSH   b   ; C = 文字コード退避
AC5C   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
AC5F   32 BF AC               STA   gidx_new_slot   
AC62   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
AC64   23                     INX   h   
AC65   36 01                  MVI   m,1   ; +1: count = 1
AC67   23                     INX   h   
AC68   C1                     POP   b   
AC69   71                     MOV   m,c   ; +2: data[0] = 文字コード
AC6A                             ; R[a] = TT_STRING, val_lo = new_slot+1
AC6A   3A BC AC               LDA   gidx_reg_a   
AC6D   CD 03 84               CALL   get_reg_addr   
AC70   36 07                  MVI   m,TT_STRING   
AC72   23                     INX   h   
AC73   36 00                  MVI   m,0   
AC75   23                     INX   h   
AC76   3A BF AC               LDA   gidx_new_slot   
AC79   3C                     INR   a   
AC7A   77                     MOV   m,a   
AC7B   23                     INX   h   
AC7C   36 00                  MVI   m,0   
AC7E   C3 89 8F               JMP   vm_loop   
AC81                GIDX_ARRAY:      
AC81                             ; R[a] のコレクションスロットを取得
AC81   3A BC AC               LDA   gidx_reg_a   
AC84   CD 03 84               CALL   get_reg_addr   
AC87   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AC8A   23                     INX   h   ; +1: count
AC8B   46                     MOV   b,m   ; B = 要素数
AC8C   23                     INX   h   ; HL → データ領域先頭
AC8D   22 BD AC               SHLD   gidx_data_addr   
AC90                             ; R[a+1] からインデックスを取得
AC90   3A BC AC               LDA   gidx_reg_a   
AC93   3C                     INR   a   
AC94   CD 03 84               CALL   get_reg_addr   
AC97   CD 35 84               CALL   slot_to_value   
AC9A   7E                     MOV   a,m   ; A = index (val_lo)
AC9B                             ; 範囲チェック: index < 要素数
AC9B   B8                     CMP   b   
AC9C   D2 03 00               JNC   vm_error   
AC9F                             ; data + index * 4 で要素スロットの先頭を求める
AC9F   87                     ADD   a   ; ×2
ACA0   87                     ADD   a   ; ×4
ACA1   5F                     MOV   e,a   
ACA2   16 00                  MVI   d,0   
ACA4   2A BD AC               LHLD   gidx_data_addr   
ACA7   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
ACA8   EB                     XCHG      ; DE = &data[index * 4]
ACA9                             ; R[a] にコピー (4 バイト)
ACA9   3A BC AC               LDA   gidx_reg_a   
ACAC   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
ACAF   0E 04                  MVI   c,SLOT_BYTES   
ACB1                GIDX_ARY_COPY:      
ACB1   1A                     LDAX   d   
ACB2   77                     MOV   m,a   
ACB3   23                     INX   h   
ACB4   13                     INX   d   
ACB5   0D                     DCR   c   
ACB6   C2 B1 AC               JNZ   gidx_ary_copy   
ACB9   C3 89 8F               JMP   vm_loop   
ACBC   00           GIDX_REG_A:   DB   0   
ACBD   00 00        GIDX_DATA_ADDR:   DW   0   
ACBF   00           GIDX_NEW_SLOT:   DB   0   
ACC0                             ; ===============================================================
ACC0                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
ACC0                             ; 
ACC0                             ; R[a] の型で分岐:
ACC0                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
ACC0                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
ACC0                             ; ===============================================================
ACC0                DO_OP_SETIDX:      
ACC0   CD C3 84               CALL   fetch_byte   ; A = a
ACC3   32 73 AD               STA   sidx_reg_a   
ACC6   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
ACC9   7E                     MOV   a,m   ; A = 型タグ
ACCA   FE 07                  CPI   TT_STRING   
ACCC   CA DC AC               JZ   sidx_string   
ACCF   FE 08                  CPI   TT_ARRAY   
ACD1   CA 36 AD               JZ   sidx_array   
ACD4   FE 09                  CPI   TT_HASH   
ACD6   CA 06 B6               JZ   sidx_hash   
ACD9   C3 03 00               JMP   vm_error   
ACDC                SIDX_STRING:      
ACDC                             ; R[a] のコレクションスロットを取得
ACDC   3A 73 AD               LDA   sidx_reg_a   
ACDF   CD 03 84               CALL   get_reg_addr   
ACE2   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
ACE5   23                     INX   h   ; +1: count
ACE6   46                     MOV   b,m   ; B = 文字列長
ACE7   23                     INX   h   ; HL → データ領域先頭
ACE8   22 74 AD               SHLD   sidx_data_addr   
ACEB                             ; R[a+1] からインデックスを取得
ACEB   3A 73 AD               LDA   sidx_reg_a   
ACEE   3C                     INR   a   
ACEF   CD 03 84               CALL   get_reg_addr   
ACF2   CD 35 84               CALL   slot_to_value   
ACF5   7E                     MOV   a,m   ; A = index
ACF6   B8                     CMP   b   
ACF7   D2 03 00               JNC   vm_error   ; index >= 長さ
ACFA                             ; data[index] に R[a+2] の文字を書き込む
ACFA   5F                     MOV   e,a   
ACFB   16 00                  MVI   d,0   
ACFD   2A 74 AD               LHLD   sidx_data_addr   
AD00   19                     DAD   d   ; HL = &data[index]
AD01                             ; R[a+2] から文字コードを取得
AD01   3A 73 AD               LDA   sidx_reg_a   
AD04   3C                     INR   a   
AD05   3C                     INR   a   
AD06   CD 03 84               CALL   get_reg_addr   
AD09                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
AD09   7E                     MOV   a,m   ; 型タグ
AD0A   FE 07                  CPI   TT_STRING   
AD0C   CA 16 AD               JZ   sidx_str_char   
AD0F                             ; TT_INTEGER: val_lo を文字コードとして使う
AD0F   CD 35 84               CALL   slot_to_value   
AD12   7E                     MOV   a,m   
AD13   C3 1C AD               JMP   sidx_write_char   
AD16                SIDX_STR_CHAR:      
AD16                             ; TT_STRING: コレクションスロットの先頭文字
AD16   CD 11 AC               CALL   col_from_reg   
AD19   23                     INX   h   ; +1: count
AD1A   23                     INX   h   ; +2: data[0]
AD1B   7E                     MOV   a,m   
AD1C                SIDX_WRITE_CHAR:      
AD1C   2A 74 AD               LHLD   sidx_data_addr   
AD1F   5F                     MOV   e,a   ; E = 文字コード
AD20   3A 73 AD               LDA   sidx_reg_a   
AD23   3C                     INR   a   
AD24   CD 03 84               CALL   get_reg_addr   
AD27   CD 35 84               CALL   slot_to_value   
AD2A   7E                     MOV   a,m   ; A = index
AD2B   4F                     MOV   c,a   
AD2C   06 00                  MVI   b,0   
AD2E   2A 74 AD               LHLD   sidx_data_addr   
AD31   09                     DAD   b   ; HL = &data[index]
AD32   73                     MOV   m,e   ; 書き込み
AD33   C3 89 8F               JMP   vm_loop   
AD36                SIDX_ARRAY:      
AD36                             ; R[a] のコレクションスロットを取得
AD36   3A 73 AD               LDA   sidx_reg_a   
AD39   CD 03 84               CALL   get_reg_addr   
AD3C   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AD3F   23                     INX   h   ; +1: count
AD40   46                     MOV   b,m   ; B = 要素数
AD41   23                     INX   h   ; HL → データ領域先頭
AD42   22 74 AD               SHLD   sidx_data_addr   
AD45                             ; R[a+1] からインデックスを取得
AD45   3A 73 AD               LDA   sidx_reg_a   
AD48   3C                     INR   a   
AD49   CD 03 84               CALL   get_reg_addr   
AD4C   CD 35 84               CALL   slot_to_value   
AD4F   7E                     MOV   a,m   ; A = index
AD50   B8                     CMP   b   
AD51   D2 03 00               JNC   vm_error   
AD54                             ; data[index * 4] に R[a+2] をコピー
AD54   87                     ADD   a   ; ×2
AD55   87                     ADD   a   ; ×4
AD56   5F                     MOV   e,a   
AD57   16 00                  MVI   d,0   
AD59   2A 74 AD               LHLD   sidx_data_addr   
AD5C   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
AD5D   EB                     XCHG      ; DE = コピー先
AD5E                             ; R[a+2] を取得 (コピー元)
AD5E   3A 73 AD               LDA   sidx_reg_a   
AD61   3C                     INR   a   
AD62   3C                     INR   a   
AD63   CD 03 84               CALL   get_reg_addr   ; HL = R[a+2]
AD66   0E 04                  MVI   c,SLOT_BYTES   
AD68                SIDX_ARY_COPY:      
AD68   7E                     MOV   a,m   
AD69   12                     STAX   d   
AD6A   23                     INX   h   
AD6B   13                     INX   d   
AD6C   0D                     DCR   c   
AD6D   C2 68 AD               JNZ   sidx_ary_copy   
AD70   C3 89 8F               JMP   vm_loop   
AD73   00           SIDX_REG_A:   DB   0   
AD74   00 00        SIDX_DATA_ADDR:   DW   0   
AD76                             ; ===============================================================
AD76                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
AD76                             ; 
AD76                             ; b 個のレジスタからコレクションプールに配列を構築する。
AD76                             ; ===============================================================
AD76                DO_OP_ARRAY:      
AD76   CD C3 84               CALL   fetch_byte   ; A = a
AD79   32 ED AD               STA   oary_reg_a   
AD7C   32 EE AD               STA   oary_src_reg   ; BB 形式: ソース = a
AD7F   CD C3 84               CALL   fetch_byte   ; A = b (要素数)
AD82                OA2_JOIN:      ; OP_ARRAY2 からの合流点
AD82   32 EF AD               STA   oary_count   
AD85   B7                     ORA   a   
AD86   CA DF AD               JZ   oary_empty   ; 空配列
AD89                             ; 要素数チェック
AD89   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
AD8B   D2 03 00               JNC   vm_error   ; 要素数 > 7
AD8E                             ; コレクションスロットを確保
AD8E   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
AD91   32 F0 AD               STA   oary_slot_num   
AD94   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
AD96   23                     INX   h   
AD97   3A EF AD               LDA   oary_count   
AD9A   77                     MOV   m,a   ; +1: count
AD9B   23                     INX   h   ; HL → データ領域先頭
AD9C   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
AD9D                             ; ソースレジスタから b 個のスロットをコピー
AD9D   3A EE AD               LDA   oary_src_reg   
ADA0   47                     MOV   b,a   ; B = 現在のレジスタ番号
ADA1   3A EF AD               LDA   oary_count   
ADA4   4F                     MOV   c,a   ; C = 残り要素数
ADA5                OARY_COPY_LOOP:      
ADA5   3E 04                  MVI   a,SLOT_BYTES   
ADA7   32 F1 AD               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
ADAA   C5                     PUSH   b   
ADAB   D5                     PUSH   d   
ADAC   78                     MOV   a,b   
ADAD   CD 03 84               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
ADB0   D1                     POP   d   
ADB1                OARY_COPY_ELEM:      
ADB1   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
ADB2   23                     INX   h   
ADB3   78                     MOV   a,b   
ADB4   12                     STAX   d   
ADB5   13                     INX   d   
ADB6   E5                     PUSH   h   
ADB7   21 F1 AD               LXI   h,oary_elem_cnt   
ADBA   35                     DCR   m   
ADBB   E1                     POP   h   
ADBC   C2 B1 AD               JNZ   oary_copy_elem   
ADBF   C1                     POP   b   
ADC0   04                     INR   b   ; 次のレジスタ
ADC1   0D                     DCR   c   
ADC2   CA C8 AD               JZ   oary_done   
ADC5   C3 A5 AD               JMP   oary_copy_loop   
ADC8                OARY_DONE:      
ADC8                             ; R[a] = TT_ARRAY, val_lo = slot+1
ADC8   3A ED AD               LDA   oary_reg_a   
ADCB   CD 03 84               CALL   get_reg_addr   
ADCE   36 08                  MVI   m,TT_ARRAY   
ADD0   23                     INX   h   
ADD1   36 00                  MVI   m,0   
ADD3   23                     INX   h   
ADD4   3A F0 AD               LDA   oary_slot_num   
ADD7   3C                     INR   a   
ADD8   77                     MOV   m,a   
ADD9   23                     INX   h   
ADDA   36 00                  MVI   m,0   
ADDC   C3 89 8F               JMP   vm_loop   
ADDF                OARY_EMPTY:      
ADDF                             ; 空配列: スロット確保して count=0
ADDF   CD FC AB               CALL   col_alloc   
ADE2   32 F0 AD               STA   oary_slot_num   
ADE5   36 02                  MVI   m,COL_TYPE_ARRAY   
ADE7   23                     INX   h   
ADE8   36 00                  MVI   m,0   ; count = 0
ADEA   C3 C8 AD               JMP   oary_done   
ADED   00           OARY_REG_A:   DB   0   
ADEE   00           OARY_SRC_REG:   DB   0   
ADEF   00           OARY_COUNT:   DB   0   
ADF0   00           OARY_SLOT_NUM:   DB   0   
ADF1   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
ADF2                             ; ===============================================================
ADF2                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
ADF2                             ; 
ADF2                             ; R[a] の配列の末尾に要素を追加する。
ADF2                             ; ===============================================================
ADF2                DO_OP_ARYPUSH:      
ADF2   CD C3 84               CALL   fetch_byte   ; A = a
ADF5   32 66 AE               STA   apush_reg_a   
ADF8   CD C3 84               CALL   fetch_byte   ; A = b (追加する要素数)
ADFB   32 67 AE               STA   apush_add_count   
ADFE                             ; R[a] のコレクションスロットを取得
ADFE   3A 66 AE               LDA   apush_reg_a   
AE01   CD 03 84               CALL   get_reg_addr   
AE04   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AE07   23                     INX   h   ; +1: count
AE08   7E                     MOV   a,m   ; A = 現在の要素数
AE09   32 68 AE               STA   apush_cur_count   
AE0C                             ; 容量チェック: count + add_count <= MAX
AE0C   3A 67 AE               LDA   apush_add_count   
AE0F   47                     MOV   b,a   
AE10   3A 68 AE               LDA   apush_cur_count   
AE13   80                     ADD   b   
AE14   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
AE16   D2 03 00               JNC   vm_error   ; オーバーフロー
AE19                             ; 書き込み先: data + count * 4
AE19   3A 68 AE               LDA   apush_cur_count   
AE1C   87                     ADD   a   ; ×2
AE1D   87                     ADD   a   ; ×4
AE1E   5F                     MOV   e,a   
AE1F   16 00                  MVI   d,0   
AE21   23                     INX   h   ; HL → データ領域先頭
AE22   19                     DAD   d   ; HL = 書き込み位置
AE23   EB                     XCHG      ; DE = 書き込み位置
AE24                             ; R[a+1] から b 個のスロットをコピー
AE24   3A 66 AE               LDA   apush_reg_a   
AE27   3C                     INR   a   
AE28   47                     MOV   b,a   ; B = 現在のレジスタ番号
AE29   3A 67 AE               LDA   apush_add_count   
AE2C   4F                     MOV   c,a   ; C = 残り要素数
AE2D                APUSH_LOOP:      
AE2D   3E 04                  MVI   a,SLOT_BYTES   
AE2F   32 69 AE               STA   apush_byte_cnt   ; 毎回初期化
AE32   C5                     PUSH   b   
AE33   D5                     PUSH   d   
AE34   78                     MOV   a,b   
AE35   CD 03 84               CALL   get_reg_addr   ; HL = R[reg]
AE38   D1                     POP   d   
AE39                APUSH_COPY:      
AE39   46                     MOV   b,m   
AE3A   78                     MOV   a,b   
AE3B   12                     STAX   d   
AE3C   23                     INX   h   
AE3D   13                     INX   d   
AE3E   E5                     PUSH   h   
AE3F   21 69 AE               LXI   h,apush_byte_cnt   
AE42   35                     DCR   m   
AE43   E1                     POP   h   
AE44   C2 39 AE               JNZ   apush_copy   
AE47   C1                     POP   b   
AE48   04                     INR   b   
AE49   0D                     DCR   c   
AE4A   CA 50 AE               JZ   apush_done   
AE4D   C3 2D AE               JMP   apush_loop   
AE50                APUSH_DONE:      
AE50                             ; count を更新
AE50   3A 66 AE               LDA   apush_reg_a   
AE53   CD 03 84               CALL   get_reg_addr   
AE56   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AE59   23                     INX   h   ; +1: count
AE5A   3A 68 AE               LDA   apush_cur_count   
AE5D   47                     MOV   b,a   
AE5E   3A 67 AE               LDA   apush_add_count   
AE61   80                     ADD   b   
AE62   77                     MOV   m,a   ; count = old + added
AE63   C3 89 8F               JMP   vm_loop   
AE66   00           APUSH_REG_A:   DB   0   
AE67   00           APUSH_ADD_COUNT:   DB   0   
AE68   00           APUSH_CUR_COUNT:   DB   0   
AE69   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
AE6A                             ; ===============================================================
AE6A                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
AE6A                             ; 
AE6A                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
AE6A                             ; ===============================================================
AE6A                DO_OP_STRCAT:      
AE6A   CD C3 84               CALL   fetch_byte   ; A = a
AE6D   32 E0 AE               STA   scat_reg_a   
AE70                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
AE70                             ; R[a+1] のコレクションスロット (ソース)
AE70   3C                     INR   a   
AE71   CD 03 84               CALL   get_reg_addr   
AE74   CD 11 AC               CALL   col_from_reg   ; HL = ソーススロット
AE77   23                     INX   h   ; +1: count
AE78   7E                     MOV   a,m   ; A = ソース文字列長
AE79   32 E1 AE               STA   scat_src_len   
AE7C   23                     INX   h   ; HL → データ先頭
AE7D   22 E4 AE               SHLD   scat_src_data   
AE80                             ; R[a] のコレクションスロット (デスト)
AE80   3A E0 AE               LDA   scat_reg_a   
AE83   CD 03 84               CALL   get_reg_addr   
AE86   CD 11 AC               CALL   col_from_reg   ; HL = デストスロット
AE89   23                     INX   h   ; +1: count
AE8A   7E                     MOV   a,m   ; A = デスト文字列長
AE8B   32 E2 AE               STA   scat_dst_len   
AE8E                             ; 合計長チェック
AE8E   3A E1 AE               LDA   scat_src_len   
AE91   47                     MOV   b,a   
AE92   3A E2 AE               LDA   scat_dst_len   
AE95   80                     ADD   b   
AE96   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
AE98   DA B0 AE               JC   scat_len_ok   
AE9B                             ; 切り詰め: 追記できる分だけ
AE9B   3E 22                  MVI   a,COL_MAX_STRING_LEN   
AE9D   47                     MOV   b,a   
AE9E   3A E2 AE               LDA   scat_dst_len   
AEA1   90                     SUB   b   ; この結果は負 (使わない)
AEA2   3E 22                  MVI   a,COL_MAX_STRING_LEN   
AEA4   47                     MOV   b,a   
AEA5   3A E2 AE               LDA   scat_dst_len   
AEA8   4F                     MOV   c,a   
AEA9   78                     MOV   a,b   
AEAA   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
AEAB   32 E1 AE               STA   scat_src_len   
AEAE                             ; 合計を MAX に
AEAE   3E 22                  MVI   a,COL_MAX_STRING_LEN   
AEB0                SCAT_LEN_OK:      
AEB0   32 E3 AE               STA   scat_total_len   
AEB3                             ; デスト count を更新
AEB3   3A E0 AE               LDA   scat_reg_a   
AEB6   CD 03 84               CALL   get_reg_addr   
AEB9   CD 11 AC               CALL   col_from_reg   
AEBC   23                     INX   h   
AEBD   3A E3 AE               LDA   scat_total_len   
AEC0   77                     MOV   m,a   ; count = 合計長
AEC1   23                     INX   h   ; HL → データ先頭
AEC2                             ; デストデータ末尾 = data + dst_len
AEC2   3A E2 AE               LDA   scat_dst_len   
AEC5   5F                     MOV   e,a   
AEC6   16 00                  MVI   d,0   
AEC8   19                     DAD   d   ; HL = 書き込み位置
AEC9                             ; ソースデータをコピー
AEC9   EB                     XCHG      ; DE = 書き込み位置
AECA   2A E4 AE               LHLD   scat_src_data   ; HL = ソースデータ
AECD   3A E1 AE               LDA   scat_src_len   
AED0   B7                     ORA   a   
AED1   CA DD AE               JZ   scat_done   
AED4   4F                     MOV   c,a   
AED5                SCAT_COPY:      
AED5   7E                     MOV   a,m   
AED6   12                     STAX   d   
AED7   23                     INX   h   
AED8   13                     INX   d   
AED9   0D                     DCR   c   
AEDA   C2 D5 AE               JNZ   scat_copy   
AEDD                SCAT_DONE:      
AEDD   C3 89 8F               JMP   vm_loop   
AEE0   00           SCAT_REG_A:   DB   0   
AEE1   00           SCAT_SRC_LEN:   DB   0   
AEE2   00           SCAT_DST_LEN:   DB   0   
AEE3   00           SCAT_TOTAL_LEN:   DB   0   
AEE4   00 00        SCAT_SRC_DATA:   DW   0   
AEE6                             ; ===============================================================
AEE6                             ; send_length — length / size: 文字列長・配列長を返す
AEE6                             ; 
AEE6                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
AEE6                             ; ===============================================================
AEE6                SEND_LENGTH:      
AEE6   3A 58 8A               LDA   send_reg_a   
AEE9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
AEEC   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AEEF   23                     INX   h   ; +1: count
AEF0   4E                     MOV   c,m   ; C = count
AEF1   06 00                  MVI   b,0   ; BC = count (16-bit)
AEF3   3A 58 8A               LDA   send_reg_a   
AEF6   CD 03 84               CALL   get_reg_addr   
AEF9   CD 13 84               CALL   set_slot_int16   ; R[a] = count
AEFC   C3 89 8F               JMP   vm_loop   
AEFF                             ; ===============================================================
AEFF                             ; send_concat — << (文字列追記 / 配列追加)
AEFF                             ; 
AEFF                             ; R[a] の型で分岐:
AEFF                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
AEFF                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
AEFF                             ; ===============================================================
AEFF                SEND_CONCAT:      
AEFF   3A 58 8A               LDA   send_reg_a   
AF02   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
AF05   7E                     MOV   a,m   ; A = 型タグ
AF06   FE 07                  CPI   TT_STRING   
AF08   CA 13 AF               JZ   concat_string   
AF0B   FE 08                  CPI   TT_ARRAY   
AF0D   CA BD AF               JZ   concat_array   
AF10   C3 03 00               JMP   vm_error   
AF13                CONCAT_STRING:      
AF13                             ; R[a+1] の型を確認
AF13   3A 58 8A               LDA   send_reg_a   
AF16   3C                     INR   a   
AF17   CD 03 84               CALL   get_reg_addr   
AF1A   7E                     MOV   a,m   ; A = R[a+1] の型タグ
AF1B   FE 07                  CPI   TT_STRING   
AF1D   CA 28 AF               JZ   concat_str_str   
AF20   FE 04                  CPI   TT_INTEGER   
AF22   CA 98 AF               JZ   concat_str_int   
AF25   C3 03 00               JMP   vm_error   
AF28                CONCAT_STR_STR:      
