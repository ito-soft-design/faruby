165F   3A 4D 17               LDA   send_reg_a   
1662   CD 00 10               CALL   get_reg_addr   
1665   36 08                  MVI   m,TT_ARRAY   
1667   23                     INX   h   
1668   36 00                  MVI   m,0   
166A   23                     INX   h   
166B   3A A0 16               LDA   snb_slot   
166E   3C                     INR   a   
