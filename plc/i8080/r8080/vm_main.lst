1688   3A 4D 17               LDA   send_reg_a   
168B   CD 00 10               CALL   get_reg_addr   
168E   36 09                  MVI   m,TT_HASH   
1690   23                     INX   h   
1691   36 00                  MVI   m,0   
1693   23                     INX   h   
1694   3A A0 16               LDA   snb_slot   
1697   3C                     INR   a   
