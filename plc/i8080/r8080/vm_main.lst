0000                             ; vm_main.a80 — faRuby i8080 VM
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (拡張 RAM 搭載: 0x0000-0xFFFF) を想定。
0000                             ; 
0000                             ; 0x8400: 起動スタブ (SP 設定 + バンク切り替え + JMP vm_start)
0000                             ; 0x1000: VM 本体コード (拡張 RAM 領域)
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行する。
0000                             ; hex ロードは拡張 RAM モード (ポート 9C bit3=1) のまま行われるため、
0000                             ; 0x1000-0x7FFF のデータは直接拡張 RAM に書き込まれる。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; 
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; 
0000                             ; --- メモリマップ ---
0000                             ; 
0000                VM_CODE_ORG:   EQU   1000h   
0000                VM_ENTRY_POINT:   EQU   8400h   ; 起動スタブ (通常 RAM)
0000                BYTECODE_BASE:   EQU   5000h   
0000                BYTECODE_SIZE:   EQU   2000h   
0000                POOL_BASE:   EQU   7000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                INIT_METHOD_ID_STORE:   EQU   82FEh   ; initialize の method_id 格納アドレス
0000                             ; 
0000                             ; --- バリュースロット ---
0000                             ; 
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; 
0000                             ; --- VM 状態領域のオフセット ---
0000                             ; 
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                OFF_OBJ_SP:   EQU   1Bh   ; 1B  次の空きオブジェクトスロット
0000                OFF_INIT_METHOD_ID:   EQU   1Ch   ; 1B  initialize のメソッド ID
0000                OFF_POOL_BASE:   EQU   1Dh   ; 2B  現在の IREP の定数プール先頭
0000                OFF_COL_SP:   EQU   1Fh   ; 1B  次の空きコレクションスロット
0000                             ; 
0000                             ; --- IREP テーブルエントリ ---
0000                             ; 
0000                IREP_ENTRY_BYTES:   EQU   0Ah   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_SUBTREE_SIZE:   EQU   07h   ; 1B  DFS 前順サブツリーサイズ
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; 
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                             ; 
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_STRING:   EQU   07h   
0000                TT_ARRAY:   EQU   08h   
0000                TT_HASH:   EQU   09h   
0000                TT_OBJECT:   EQU   0Ah   
0000                TT_PROC:   EQU   0Ch   
0000                TT_CLASS:   EQU   0Dh   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; 
0000                             ; --- VM 実行状態 ---
0000                             ; 
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; 
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                             ; 
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   9000h   
0000                MAX_GLOBALS:   EQU   40h   ; グローバル変数の数
0000                             ; 
0000                             ; シンボル種別コード (上位バイト)
0000                SYM_KIND_USER_METHOD:   EQU   01h   ; ユーザー定義メソッド
0000                SYM_KIND_CLASS:   EQU   02h   ; クラス名
0000                SYM_KIND_IVAR:   EQU   03h   ; インスタンス変数
0000                             ; 
0000                             ; --- フレームスタック ---
0000                             ; 
0000                FRAME_STACK_BASE:   EQU   9100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   10h   
0000                             ; 
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; 
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_EACH:   EQU   02h   ; each (配列要素反復)
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                FRAME_KIND_NEW:   EQU   05h   ; Class#new → initialize
0000                             ; 
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; 
0000                             ; --- メソッド表 ---
0000                             ; 
0000                METHOD_TABLE_BASE:   EQU   91C0h   
0000                MAX_CLASSES:   EQU   08h   
0000                MAX_METHODS_PER_CLASS:   EQU   20h   
0000                METHOD_TABLE_SIZE:   EQU   0100h   
0000                CLASS_MAIN:   EQU   00h   
0000                METHOD_NEW:   EQU   1Ch   ; Class#new
0000                METHOD_DISPLAY:   EQU   1Dh   ; display(value)
0000                METHOD_GETKEY:   EQU   1Eh   ; getkey
0000                METHOD_PUTS:   EQU   1Fh   ; puts(value): ASCII 2 文字表示
0000                METHOD_SETSEG:   EQU   20h   ; setseg(pos, pattern)
0000                METHOD_RAND:   EQU   21h   ; rand(n)
0000                METHOD_SLICE:   EQU   22h   ; [](offset, length) 文字列スライス
0000                METHOD_LENGTH:   EQU   12h   ; length / size
0000                METHOD_CONCAT:   EQU   14h   ; << (文字列追記/配列追加)
0000                METHOD_EACH:   EQU   15h   ; each (配列要素反復)
0000                METHOD_PUSH:   EQU   16h   ; push (配列追加)
0000                KEYIN1_ADDR:   EQU   0616h   ; ND80Z モニタキー入力 (ブロッキング)
0000                KEY_ADDR:   EQU   0647h   ; ND80Z キー 1 回スキャン (ノンブロッキング)
0000                             ; 
0000                             ; バンク切り替え (ND8080 拡張 RAM)
0000                PORT_9C:   EQU   9Ch   ; I/O ポート 9C
0000                PORT_9C_BANK_BIT:   EQU   08h   ; bit3: ROM/RAM 切替
0000                CLONE_BUF:   EQU   0EF00h   ; ROM クローン用バッファ
0000                             ; 
0000                             ; --- オブジェクトプール ---
0000                             ; 
0000                OBJECT_POOL_BASE:   EQU   92C0h   
0000                MAX_OBJECTS:   EQU   20h   
0000                OBJECT_SLOT_SIZE:   EQU   20h   ; 32B/スロット
0000                OBJECT_HEADER_SIZE:   EQU   04h   
0000                MAX_IVARS:   EQU   07h   
0000                             ; 
0000                             ; --- コレクションプール (文字列・配列) ---
0000                             ; 
0000                COLLECTION_POOL_BASE:   EQU   96C0h   
0000                MAX_COL_SLOTS:   EQU   40h   
0000                COL_SLOT_SIZE:   EQU   24h   ; 36B/スロット
0000                COL_HEADER_SIZE:   EQU   02h   ; +0: type, +1: count
0000                COL_DATA_SIZE:   EQU   22h   ; データ領域 (34B)
0000                COL_MAX_STRING_LEN:   EQU   22h   
0000                COL_MAX_ARRAY_ELEMS:   EQU   08h   
0000                COL_TYPE_FREE:   EQU   00h   
0000                COL_TYPE_STRING:   EQU   01h   
0000                COL_TYPE_ARRAY:   EQU   02h   
0000                COL_TYPE_HASH:   EQU   03h   
0000                HASH_PAIR_BYTES:   EQU   08h   ; 8B/ペア (key+value)
0000                COL_MAX_HASH_PAIRS:   EQU   04h   ; 最大4ペア
0000                             ; 
0000                             ; --- Phase 1 オペコード ---
0000                             ; 
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; 
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                             ; 
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
0000                             ; 
0000                             ; 
0000                             ; ===============================================================
0000                             ; 起動スタブ (通常 RAM 0x8400)
0000                             ; 
0000                             ; 1. SP 設定
0000                             ; 2. 拡張 RAM バンク切り替え (OUT PORT_9C, F8h)
0000                             ; 3. vm_start へジャンプ
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行済み。
0000                             ; hex ロードは拡張 RAM モードのまま行われるため、
0000                             ; VM コード・バイトコード・プールは直接拡張 RAM に書き込まれる。
0000                             ; ===============================================================
8400                          .ORG   08400h   
8400                             ; 
8400                STARTUP_STUB:      
8400   31 00 FE               LXI   sp,STACK_TOP + 1   
8403   3E F8                  MVI   a,0F8h   
8405   D3 9C                  OUT   PORT_9C   
8407   C3 BE 1C               JMP   vm_start   
840A                             ; 
840A                             ; ===============================================================
840A                             ; VM 本体コード (拡張 RAM 0x1000-)
840A                             ; ===============================================================
1000                          .ORG   01000h   
1000                             ; 
1000                             ; ===============================================================
1000                             ; サブルーチン群 (.include で取り込む)
1000                             ; ===============================================================
1000                             ; vm_util.a80 — ユーティリティサブルーチン
1000                             ; 
1000                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
1000                             ; 他のすべてのモジュールがここに依存します。
1000                             ; 
1000                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
1000                             ;   +0: 型タグ (1B)
1000                             ;   +1: 予約   (1B, 常に 0)
1000                             ;   +2: val_lo (1B)
1000                             ;   +3: val_hi (1B)
1000                             ; 
1000                             ; ---------------------------------------------------------------
1000                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
1000                             ; 
1000                             ;   入力: A = レジスタ番号 (0-63)
1000                             ;   出力: HL = スロット先頭アドレス
1000                             ;   破壊: A
1000                             ; 
1000                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
1000                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
1000                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
1000                             ; ---------------------------------------------------------------
1000                GET_REG_ADDR:      
1000   87                     ADD   a   ; ×2
1001   87                     ADD   a   ; ×4 (オフセット、A に残る)
1002   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
1005   85                     ADD   l   ; A = base_lo + offset
1006   6F                     MOV   l,a   
1007   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
1009   8C                     ADC   h   ; A = base_hi + CY
100A   67                     MOV   h,a   
100B   C9                     RET      
100C                             ; 
100C                             ; ---------------------------------------------------------------
100C                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
100C                             ; 
100C                             ;   入力: A = レジスタ番号 a
100C                             ;   出力: HL = R[a+1] のスロット先頭アドレス
100C                             ;   破壊: A
100C                             ; ---------------------------------------------------------------
100C                GET_REG_ADDR_NEXT:      
100C   3C                     INR   a   
100D   C3 00 10               JMP   get_reg_addr   
1010                             ; 
1010                             ; ---------------------------------------------------------------
1010                             ; set_slot_int16 — スロットに 16 ビット整数を書く
1010                             ; 
1010                             ;   入力: HL = スロット先頭アドレス
1010                             ;          B  = val_hi (上位バイト)
1010                             ;          C  = val_lo (下位バイト)
1010                             ;   出力: なし
1010                             ;   破壊: HL
1010                             ; ---------------------------------------------------------------
1010                SET_SLOT_INT16:      
1010   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1012   23                     INX   h   
1013   36 00                  MVI   m,0   ; +1: 予約
1015   23                     INX   h   
1016   71                     MOV   m,c   ; +2: val_lo
1017   23                     INX   h   
1018   70                     MOV   m,b   ; +3: val_hi
1019   C9                     RET      
101A                             ; 
101A                             ; ---------------------------------------------------------------
101A                             ; set_slot_special — 値を持たない型をスロットに書く
101A                             ; 
101A                             ;   入力: HL = スロット先頭アドレス
101A                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
101A                             ;   出力: なし
101A                             ;   破壊: A, HL
101A                             ; ---------------------------------------------------------------
101A                SET_SLOT_SPECIAL:      
101A   77                     MOV   m,a   ; +0: 型タグ
101B   23                     INX   h   
101C   36 00                  MVI   m,0   ; +1: 予約
101E   23                     INX   h   
101F   36 00                  MVI   m,0   ; +2: val_lo = 0
1021   23                     INX   h   
1022   36 00                  MVI   m,0   ; +3: val_hi = 0
1024   C9                     RET      
1025                             ; 
1025                             ; ---------------------------------------------------------------
1025                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
1025                             ; 
1025                             ;   入力: HL = コピー元先頭
1025                             ;         DE = コピー先先頭
1025                             ;   出力: なし
1025                             ;   破壊: A, C, HL, DE
1025                             ; ---------------------------------------------------------------
1025                COPY_SLOT:      
1025   0E 04                  MVI   c,SLOT_BYTES   
1027                COPY_SLOT_LOOP:      
1027   7E                     MOV   a,m   
1028   12                     STAX   d   
1029   23                     INX   h   
102A   13                     INX   d   
102B   0D                     DCR   c   
102C   C2 27 10               JNZ   copy_slot_loop   
102F   C9                     RET      
1030                             ; 
1030                             ; ---------------------------------------------------------------
1030                             ; get_slot_type — スロットの型タグを読む
1030                             ; 
1030                             ;   入力: HL = スロット先頭アドレス
1030                             ;   出力: A = 型タグ
1030                             ;   破壊: なし (HL 保存)
1030                             ; ---------------------------------------------------------------
1030                GET_SLOT_TYPE:      
1030   7E                     MOV   a,m   
1031   C9                     RET      
1032                             ; 
1032                             ; ---------------------------------------------------------------
1032                             ; slot_to_value — スロット先頭から値の先頭へ進める
1032                             ; 
1032                             ;   入力: HL = スロット先頭アドレス
1032                             ;   出力: HL = 値の先頭 (スロット +2)
1032                             ;   破壊: なし
1032                             ; ---------------------------------------------------------------
1032                SLOT_TO_VALUE:      
1032   23                     INX   h   
1033   23                     INX   h   
1034   C9                     RET      
1035                             ; 
1035                             ; ---------------------------------------------------------------
1035                             ; add_value16 — 16 ビット加算 (val1 += val2)
1035                             ; 
1035                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
1035                             ;         DE = 値 2 の先頭
1035                             ;   出力: 結果を HL の元の位置に上書き
1035                             ;   破壊: A, HL, DE
1035                             ; 
1035                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
1035                             ; ---------------------------------------------------------------
1035                ADD_VALUE16:      
1035   1A                     LDAX   d   ; A = val2[lo]
1036   86                     ADD   m   ; A += val1[lo]
1037   77                     MOV   m,a   ; val1[lo] = result
1038   23                     INX   h   
1039   13                     INX   d   
103A   1A                     LDAX   d   ; A = val2[hi]
103B   8E                     ADC   m   ; A += val1[hi] + CY
103C   77                     MOV   m,a   
103D   C9                     RET      
103E                             ; 
103E                             ; ---------------------------------------------------------------
103E                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
103E                             ; 
103E                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
103E                             ;         DE = 値 2 の先頭
103E                             ;   出力: 結果を HL の元の位置に上書き
103E                             ;   破壊: A, HL, DE
103E                             ; 
103E                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
103E                             ; ---------------------------------------------------------------
103E                SUB_VALUE16:      
103E   7E                     MOV   a,m   ; A = val1[lo]
103F   EB                     XCHG      ; HL=val2, DE=val1
1040   96                     SUB   m   ; A -= val2[lo]
1041   EB                     XCHG      ; HL=val1, DE=val2
1042   77                     MOV   m,a   ; val1[lo] = result
1043   23                     INX   h   
1044   13                     INX   d   
1045   7E                     MOV   a,m   ; A = val1[hi]
1046   EB                     XCHG      
1047   9E                     SBB   m   ; A -= val2[hi] - CY
1048   EB                     XCHG      
1049   77                     MOV   m,a   
104A   C9                     RET      
104B                             ; 
104B                             ; ---------------------------------------------------------------
104B                             ; cmp_value16 — 16 ビット符号付き比較
104B                             ; 
104B                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
104B                             ;         DE = 値 2 の先頭 (byte0 の位置)
104B                             ;   出力: A = 比較結果
104B                             ;           00h → val1 == val2
104B                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
104B                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
104B                             ;   破壊: A, B, HL, DE
104B                             ; 
104B                             ; 手順:
104B                             ;   1. 上位バイト (byte1) の符号ビットを比べる
104B                             ;   2. 符号が違えば、負の方が小さい
104B                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
104B                             ; ---------------------------------------------------------------
104B                CMP_VALUE16:      
104B                             ; byte1 (上位) の位置を求める
104B   23                     INX   h   ; HL = val1+1 (hi)
104C   13                     INX   d   ; DE = val2+1 (hi)
104D                             ; 符号ビットを比べる
104D   7E                     MOV   a,m   ; A = val1[hi]
104E   47                     MOV   b,a   ; B = val1[hi] (退避)
104F   1A                     LDAX   d   ; A = val2[hi]
1050   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
1051   F2 5D 10               JP   cmp16_same_sign   
1054                             ; 符号が違う: val1 が負なら val1 < val2
1054   78                     MOV   a,b   ; A = val1[hi]
1055   E6 80                  ANI   80h   ; bit7 を取り出す
1057   C2 71 10               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
105A   C3 74 10               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
105D                CMP16_SAME_SIGN:      
105D                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
105D   1A                     LDAX   d   
105E   BE                     CMP   m   ; val2[hi] - val1[hi]
105F   DA 74 10               JC   cmp16_ret_pos   
1062   C2 71 10               JNZ   cmp16_ret_neg   
1065   2B                     DCX   h   
1066   1B                     DCX   d   
1067   1A                     LDAX   d   
1068   BE                     CMP   m   ; val2[lo] - val1[lo]
1069   DA 74 10               JC   cmp16_ret_pos   
106C   C2 71 10               JNZ   cmp16_ret_neg   
106F                             ; すべて等しい
106F   AF                     XRA   a   ; A = 00h
1070   C9                     RET      
1071                CMP16_RET_NEG:      
1071   3E FF                  MVI   a,0FFh   ; val1 < val2
1073   C9                     RET      
1074                CMP16_RET_POS:      
1074   3E 01                  MVI   a,01h   ; val1 > val2
1076   C9                     RET      
1077                             ; 
1077                             ; ---------------------------------------------------------------
1077                             ; calc_child_irep — 子 irep 番号を算出
1077                             ; 
1077                             ;   入力: A = 子インデックス (オペランド b)
1077                             ;   出力: A = irep 番号
1077                             ;   破壊: B, C, DE, HL
1077                             ; 
1077                             ; pos = cur_irep + 1 から開始し、b 個のサブツリーを
1077                             ; subtree_size で飛ばして目的の子 irep 番号を求める。
1077                             ; OP_BLOCK, OP_METHOD, OP_EXEC の共通サブルーチン。
1077                             ; レジスタのみ使用 (メモリ変数なし): B=残りカウント, C=pos。
1077                             ; ---------------------------------------------------------------
1077                CALC_CHILD_IREP:      
1077   47                     MOV   b,a   ; B = スキップ回数
1078   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
107B   3C                     INR   a   ; A = cur_irep + 1
107C   4F                     MOV   c,a   ; C = pos
107D   78                     MOV   a,b   
107E   B7                     ORA   a   
107F   CA 99 10               JZ   cci_done   ; b == 0 → C をそのまま返す
1082                             ; 
1082                CCI_LOOP:      
1082                             ; HL = IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE + pos * 10
1082   79                     MOV   a,c   ; A = pos
1083   57                     MOV   d,a   ; D = pos (退避)
1084   87                     ADD   a   ; ×2
1085   5F                     MOV   e,a   ; E = ×2
1086   7A                     MOV   a,d   
1087   87                     ADD   a   ; ×2
1088   87                     ADD   a   ; ×4
1089   87                     ADD   a   ; ×8
108A   83                     ADD   e   ; ×10
108B   5F                     MOV   e,a   
108C   16 00                  MVI   d,0   
108E   21 07 82               LXI   h,IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE   
1091   19                     DAD   d   ; HL = &subtree_size[pos]
1092                             ; 
1092                             ; pos += subtree_size
1092   79                     MOV   a,c   
1093   86                     ADD   m   ; A = pos + subtree_size
1094   4F                     MOV   c,a   ; C = 新しい pos
1095                             ; 
1095   05                     DCR   b   
1096   C2 82 10               JNZ   cci_loop   
1099                             ; 
1099                CCI_DONE:      
1099   79                     MOV   a,c   ; A = 最終的な pos
109A   C9                     RET      
109B                             ; 
109B                             ; ---------------------------------------------------------------
109B                             ; class_of_reg — レジスタスロットからクラス番号を求める
109B                             ; 
109B                             ;   入力: HL = スロットアドレス
109B                             ;   出力: A = class_number
109B                             ;   破壊: B, DE, HL
109B                             ; 
109B                             ; - TT_CLASS  → val_lo (クラス自身の番号)
109B                             ; - TT_OBJECT, val_lo=0 → 0 (main)
109B                             ; - TT_OBJECT, val_lo>0 → OBJECT_POOL_BASE + (val-1)*32 のヘッダから読む
109B                             ; - その他 → 0 (main)
109B                             ; ---------------------------------------------------------------
109B                CLASS_OF_REG:      
109B   7E                     MOV   a,m   ; A = 型タグ
109C   FE 0D                  CPI   TT_CLASS   
109E   CA A8 10               JZ   cor_class   
10A1   FE 0A                  CPI   TT_OBJECT   
10A3   CA AC 10               JZ   cor_object   
10A6                             ; その他 → main (class 0)
10A6   AF                     XRA   a   
10A7   C9                     RET      
10A8                COR_CLASS:      
10A8                             ; val_lo = class_number
10A8   23                     INX   h   
10A9   23                     INX   h   
10AA   7E                     MOV   a,m   ; A = val_lo = class_number
10AB   C9                     RET      
10AC                COR_OBJECT:      
10AC                             ; val_lo = slot+1 (0=main)
10AC   23                     INX   h   
10AD   23                     INX   h   
10AE   7E                     MOV   a,m   ; A = val_lo
10AF   B7                     ORA   a   
10B0   C8                     RZ      ; val_lo==0 → main (A=0)
10B1                             ; slot = val_lo - 1, ヘッダアドレス = OBJECT_POOL_BASE + slot * 32
10B1   3D                     DCR   a   ; A = slot
10B2                             ; × 32 = 5 回の add a
10B2   87                     ADD   a   ; ×2
10B3   87                     ADD   a   ; ×4
10B4   87                     ADD   a   ; ×8
10B5   87                     ADD   a   ; ×16
10B6   87                     ADD   a   ; ×32
10B7   5F                     MOV   e,a   
10B8   16 00                  MVI   d,0   
10BA   21 C0 92               LXI   h,OBJECT_POOL_BASE   
10BD   19                     DAD   d   ; HL = スロット先頭
10BE   7E                     MOV   a,m   ; A = class_number (ヘッダ +0)
10BF   C9                     RET      
10C0                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
10C0                             ; 
10C0                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
10C0                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
10C0                             ; 
10C0                             ; ---------------------------------------------------------------
10C0                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
10C0                             ; 
10C0                             ;   入力: なし
10C0                             ;   出力: A = 読んだバイト
10C0                             ;   破壊: HL, DE
10C0                             ; 
10C0                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
10C0                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
10C0                             ; 子 irep の先頭に変わります。
10C0                             ; ---------------------------------------------------------------
10C0                FETCH_BYTE:      
10C0   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
10C3   EB                     XCHG      ; DE = PC
10C4   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
10C7   19                     DAD   d   ; HL = 絶対アドレス
10C8   7E                     MOV   a,m   ; A = bytecode[PC]
10C9                             ; PC をインクリメント
10C9   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
10CC   23                     INX   h   
10CD   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
10D0   C9                     RET      
10D1                             ; 
10D1                             ; ---------------------------------------------------------------
10D1                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
10D1                             ; 
10D1                             ;   入力: なし
10D1                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
10D1                             ;   破壊: A, B, DE
10D1                             ; 
10D1                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
10D1                             ; 1 バイト目が上位、2 バイト目が下位。
10D1                             ; ---------------------------------------------------------------
10D1                FETCH_U16BE:      
10D1   CD C0 10               CALL   fetch_byte   ; A = 上位バイト
10D4   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
10D5   CD C0 10               CALL   fetch_byte   ; A = 下位バイト
10D8   6F                     MOV   l,a   
10D9   60                     MOV   h,b   
10DA   C9                     RET      
10DB                             ; 
10DB                             ; ---------------------------------------------------------------
10DB                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
10DB                             ; 
10DB                             ;   入力: なし
10DB                             ;   出力: HL = 読んだ符号付き 16 ビット値
10DB                             ;   破壊: A, DE
10DB                             ; 
10DB                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
10DB                             ; ---------------------------------------------------------------
10DB                FETCH_S16BE:      
10DB   C3 D1 10               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
10DE                             ; vm_load.a80 — ロード命令
10DE                             ; 
10DE                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
10DE                             ; 
10DE                             ; Phase 2: 16 ビットスロット (4 バイト)
10DE                             ;   set_slot_int16: B=val_hi, C=val_lo
10DE                             ; 
10DE                             ; ---------------------------------------------------------------
10DE                             ; OP_NOP (Z): 何もしない
10DE                             ; ---------------------------------------------------------------
10DE                DO_OP_NOP:      
10DE   C3 8B 1B               JMP   vm_loop   
10E1                             ; 
10E1                             ; ---------------------------------------------------------------
10E1                             ; OP_MOVE (BB): R[a] = R[b]
10E1                             ; ---------------------------------------------------------------
10E1                DO_OP_MOVE:      
10E1   CD C0 10               CALL   fetch_byte   ; A = a (コピー先)
10E4   F5                     PUSH   psw   
10E5   CD C0 10               CALL   fetch_byte   ; A = b (コピー元)
10E8   CD 00 10               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
10EB   EB                     XCHG      ; DE = R[b]
10EC   F1                     POP   psw   ; A = a
10ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
10F0   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
10F1   CD 25 10               CALL   copy_slot   
10F4   C3 8B 1B               JMP   vm_loop   
10F7                             ; 
10F7                             ; ---------------------------------------------------------------
10F7                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
10F7                             ; ---------------------------------------------------------------
10F7                DO_OP_LOADI:      
10F7   CD C0 10               CALL   fetch_byte   ; A = a
10FA   F5                     PUSH   psw   
10FB   CD C0 10               CALL   fetch_byte   ; A = b (値)
10FE   4F                     MOV   c,a   ; C = val_lo
10FF   F1                     POP   psw   ; A = a
1100   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1103   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
1104   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
1106   CD 10 10               CALL   set_slot_int16   
1109   C3 8B 1B               JMP   vm_loop   
110C                             ; 
110C                             ; ---------------------------------------------------------------
110C                             ; OP_LOADINEG (BB): R[a] = -b
110C                             ; ---------------------------------------------------------------
110C                DO_OP_LOADINEG:      
110C   CD C0 10               CALL   fetch_byte   ; A = a
110F   F5                     PUSH   psw   
1110   CD C0 10               CALL   fetch_byte   ; A = b
1113                             ; -b を計算 (0 - b)
1113   4F                     MOV   c,a   ; C = b (退避)
1114   AF                     XRA   a   ; A = 0
1115   91                     SUB   c   ; A = -b
1116   4F                     MOV   c,a   ; C = val_lo (-b)
1117   F1                     POP   psw   ; A = a
1118   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
111B   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
111D   CD 10 10               CALL   set_slot_int16   
1120   C3 8B 1B               JMP   vm_loop   
1123                             ; 
1123                             ; ---------------------------------------------------------------
1123                             ; OP_LOADI__1 (B): R[a] = -1
1123                             ; ---------------------------------------------------------------
1123                DO_OP_LOADI__1:      
1123   CD C0 10               CALL   fetch_byte   ; A = a
1126   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1129   0E FF                  MVI   c,0FFh   ; val_lo = FFh
112B   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
112D   CD 10 10               CALL   set_slot_int16   
1130   C3 8B 1B               JMP   vm_loop   
1133                             ; 
1133                             ; ---------------------------------------------------------------
1133                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
1133                             ; ---------------------------------------------------------------
1133                DO_OP_LOADI_0:      
1133   0E 00                  MVI   c,0   
1135   C3 58 11               JMP   loadi_small   
1138                DO_OP_LOADI_1:      
1138   0E 01                  MVI   c,1   
113A   C3 58 11               JMP   loadi_small   
113D                DO_OP_LOADI_2:      
113D   0E 02                  MVI   c,2   
113F   C3 58 11               JMP   loadi_small   
1142                DO_OP_LOADI_3:      
1142   0E 03                  MVI   c,3   
1144   C3 58 11               JMP   loadi_small   
1147                DO_OP_LOADI_4:      
1147   0E 04                  MVI   c,4   
1149   C3 58 11               JMP   loadi_small   
114C                DO_OP_LOADI_5:      
114C   0E 05                  MVI   c,5   
114E   C3 58 11               JMP   loadi_small   
1151                DO_OP_LOADI_6:      
1151   0E 06                  MVI   c,6   
1153   C3 58 11               JMP   loadi_small   
1156                DO_OP_LOADI_7:      
1156   0E 07                  MVI   c,7   
1158                LOADI_SMALL:      
1158                             ; C = 即値 (0-7)
1158   CD C0 10               CALL   fetch_byte   ; A = a
115B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
115E   06 00                  MVI   b,0   ; val_hi = 0 (正)
1160   CD 10 10               CALL   set_slot_int16   
1163   C3 8B 1B               JMP   vm_loop   
1166                             ; 
1166                             ; ---------------------------------------------------------------
1166                             ; OP_LOADI16 (BS): R[a] = signed16(b)
1166                             ; 
1166                             ; b は符号付き 16 ビット (ビッグエンディアン)。
1166                             ; 16 ビットスロットではそのままネイティブサイズ。
1166                             ; 符号拡張は不要。
1166                             ; ---------------------------------------------------------------
1166                DO_OP_LOADI16:      
1166   CD C0 10               CALL   fetch_byte   ; A = a
1169   F5                     PUSH   psw   
116A   CD DB 10               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
116D   4D                     MOV   c,l   ; C = val_lo
116E   44                     MOV   b,h   ; B = val_hi
116F   F1                     POP   psw   ; A = a
1170   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1173                             ; 型タグと値を書く
1173   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1175   23                     INX   h   
1176   36 00                  MVI   m,0   ; +1: 予約
1178   23                     INX   h   
1179   71                     MOV   m,c   ; +2: val_lo
117A   23                     INX   h   
117B   70                     MOV   m,b   ; +3: val_hi
117C   C3 8B 1B               JMP   vm_loop   
117F                             ; 
117F                             ; ---------------------------------------------------------------
117F                             ; OP_LOADNIL (B): R[a] = nil
117F                             ; ---------------------------------------------------------------
117F                DO_OP_LOADNIL:      
117F   CD C0 10               CALL   fetch_byte   ; A = a
1182   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1185   3E 01                  MVI   a,TT_NIL   
1187   CD 1A 10               CALL   set_slot_special   
118A   C3 8B 1B               JMP   vm_loop   
118D                             ; 
118D                             ; ---------------------------------------------------------------
118D                             ; OP_LOADT (B): R[a] = true
118D                             ; ---------------------------------------------------------------
118D                DO_OP_LOADT:      
118D   CD C0 10               CALL   fetch_byte   ; A = a
1190   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1193   3E 03                  MVI   a,TT_TRUE   
1195   CD 1A 10               CALL   set_slot_special   
1198   C3 8B 1B               JMP   vm_loop   
119B                             ; 
119B                             ; ---------------------------------------------------------------
119B                             ; OP_LOADF (B): R[a] = false
119B                             ; ---------------------------------------------------------------
119B                DO_OP_LOADF:      
119B   CD C0 10               CALL   fetch_byte   ; A = a
119E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11A1   3E 02                  MVI   a,TT_FALSE   
11A3   CD 1A 10               CALL   set_slot_special   
11A6   C3 8B 1B               JMP   vm_loop   
11A9                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
11A9                             ; 
11A9                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
11A9                             ; 
11A9                             ; ---------------------------------------------------------------
11A9                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
11A9                             ; 
11A9                             ; R[a] の型で分岐:
11A9                             ;   TT_INTEGER: 16 ビット加算
11A9                             ;   TT_STRING:  文字列連結 (STRCAT と同じ)
11A9                             ; ---------------------------------------------------------------
11A9                DO_OP_ADD:      
11A9   CD C0 10               CALL   fetch_byte   ; A = a
11AC   F5                     PUSH   psw   
11AD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11B0   7E                     MOV   a,m   ; A = 型タグ
11B1   FE 07                  CPI   TT_STRING   
11B3   CA CC 11               JZ   add_string   
11B6                             ; --- 整数パス ---
11B6   F1                     POP   psw   ; A = a
11B7   F5                     PUSH   psw   
11B8                             ; R[a+1] のスロットアドレスを求める
11B8   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11BB   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
11BE   EB                     XCHG      ; DE = R[a+1] の値先頭
11BF   F1                     POP   psw   ; A = a
11C0                             ; R[a] のスロットアドレスを求める
11C0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11C3   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11C6                             ; 16 ビット加算: val[a] += val[a+1]
11C6   CD 35 10               CALL   add_value16   
11C9   C3 8B 1B               JMP   vm_loop   
11CC                             ; --- 文字列パス ---
11CC                ADD_STRING:      
11CC   F1                     POP   psw   ; A = a
11CD   32 A1 22               STA   scat_reg_a   
11D0   C3 31 22               JMP   strcat_body   ; do_op_strcat の本体を再利用
11D3                             ; 
11D3                             ; ---------------------------------------------------------------
11D3                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
11D3                             ; ---------------------------------------------------------------
11D3                DO_OP_SUB:      
11D3   CD C0 10               CALL   fetch_byte   ; A = a
11D6   F5                     PUSH   psw   
11D7   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11DA   CD 32 10               CALL   slot_to_value   
11DD   EB                     XCHG      ; DE = R[a+1] の値先頭
11DE   F1                     POP   psw   ; A = a
11DF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11E2   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11E5   CD 3E 10               CALL   sub_value16   
11E8   C3 8B 1B               JMP   vm_loop   
11EB                             ; 
11EB                             ; ---------------------------------------------------------------
11EB                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
11EB                             ; 
11EB                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
11EB                             ; ---------------------------------------------------------------
11EB                DO_OP_ADDI:      
11EB   CD C0 10               CALL   fetch_byte   ; A = a
11EE   F5                     PUSH   psw   
11EF   CD C0 10               CALL   fetch_byte   ; A = b (即値)
11F2   4F                     MOV   c,a   ; C = b
11F3   F1                     POP   psw   ; A = a
11F4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11F7   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
11FA   7E                     MOV   a,m   ; val_lo
11FB   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
11FC   77                     MOV   m,a   
11FD   23                     INX   h   
11FE   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
11FF   CE 00                  ACI   0   ; val_hi + CY
1201   77                     MOV   m,a   
1202   C3 8B 1B               JMP   vm_loop   
1205                             ; 
1205                             ; ---------------------------------------------------------------
1205                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
1205                             ; ---------------------------------------------------------------
1205                DO_OP_SUBI:      
1205   CD C0 10               CALL   fetch_byte   ; A = a
1208   F5                     PUSH   psw   
1209   CD C0 10               CALL   fetch_byte   ; A = b (即値)
120C   4F                     MOV   c,a   ; C = b
120D   F1                     POP   psw   ; A = a
120E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1211   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
1214   7E                     MOV   a,m   ; val_lo
1215   91                     SUB   c   ; val_lo - b (CY = 借り)
1216   77                     MOV   m,a   
1217   23                     INX   h   
1218   7E                     MOV   a,m   ; val_hi
1219   DE 00                  SBI   0   ; val_hi - CY
121B   77                     MOV   m,a   
121C   C3 8B 1B               JMP   vm_loop   
121F                             ; 
121F                             ; ---------------------------------------------------------------
121F                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
121F                             ; 
121F                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
121F                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
121F                             ; ---------------------------------------------------------------
121F                DO_OP_MUL:      
121F   CD C0 10               CALL   fetch_byte   ; A = a
1222   F5                     PUSH   psw   
1223   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1226   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
1229   5E                     MOV   e,m   ; E = val2_lo
122A   23                     INX   h   
122B   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
122C   F1                     POP   psw   ; A = a
122D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1230   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1233   E5                     PUSH   h   ; 書き戻し先を退避
1234   4E                     MOV   c,m   
1235   23                     INX   h   
1236   46                     MOV   b,m   ; BC = 被乗数
1237   CD 6E 12               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
123A   D1                     POP   d   ; DE = 書き戻し先
123B   7D                     MOV   a,l   
123C   12                     STAX   d   
123D   13                     INX   d   
123E   7C                     MOV   a,h   
123F   12                     STAX   d   
1240   C3 8B 1B               JMP   vm_loop   
1243                             ; 
1243                             ; ---------------------------------------------------------------
1243                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
1243                             ; 
1243                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
1243                             ; 除数 0 はエラー停止。
1243                             ; ---------------------------------------------------------------
1243                DO_OP_DIV:      
1243   CD C0 10               CALL   fetch_byte   ; A = a
1246   F5                     PUSH   psw   
1247   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
124A   CD 32 10               CALL   slot_to_value   
124D   5E                     MOV   e,m   
124E   23                     INX   h   
124F   56                     MOV   d,m   ; DE = 除数
1250                             ; ゼロ除算チェック
1250   7A                     MOV   a,d   
1251   B3                     ORA   e   
1252   C2 59 12               JNZ   do_div_nonzero   
1255   F1                     POP   psw   
1256   C3 03 00               JMP   vm_error   
1259                DO_DIV_NONZERO:      
1259   F1                     POP   psw   ; A = a
125A   CD 00 10               CALL   get_reg_addr   
125D   CD 32 10               CALL   slot_to_value   
1260   E5                     PUSH   h   ; 書き戻し先を退避
1261   4E                     MOV   c,m   
1262   23                     INX   h   
1263   46                     MOV   b,m   ; BC = 被除数
1264   CD 80 12               CALL   sdiv16   ; BC = 商
1267   E1                     POP   h   ; HL = 書き戻し先
1268   71                     MOV   m,c   
1269   23                     INX   h   
126A   70                     MOV   m,b   
126B   C3 8B 1B               JMP   vm_loop   
126E                             ; 
126E                             ; ---------------------------------------------------------------
126E                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
126E                             ; 
126E                             ;   入力: BC = 被乗数, DE = 乗数
126E                             ;   出力: HL = 積の下位 16 ビット
126E                             ;   破壊: A, DE
126E                             ; ---------------------------------------------------------------
126E                UMUL16:      
126E   21 00 00               LXI   h,0   ; 積 = 0
1271   3E 10                  MVI   a,16   ; ビットカウンタ
1273                UMUL16_LOOP:      
1273   29                     DAD   h   ; 積 <<= 1
1274   EB                     XCHG      ; HL ↔ DE
1275   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
1276   EB                     XCHG      ; HL ↔ DE
1277   D2 7B 12               JNC   umul16_noadd   
127A   09                     DAD   b   ; 積 += 被乗数
127B                UMUL16_NOADD:      
127B   3D                     DCR   a   
127C   C2 73 12               JNZ   umul16_loop   
127F   C9                     RET      
1280                             ; 
1280                             ; ---------------------------------------------------------------
1280                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
1280                             ; 
1280                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1280                             ;   出力: BC = 商
1280                             ;   破壊: A, DE, HL
1280                             ; 
1280                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
1280                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
1280                             ; ---------------------------------------------------------------
1280                SDIV16:      
1280   78                     MOV   a,b   
1281   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
1282   F5                     PUSH   psw   ; 符号情報を退避
1283                             ; 被除数を正にする
1283   78                     MOV   a,b   
1284   E6 80                  ANI   80h   
1286   CA 8C 12               JZ   sdiv16_chk_div   
1289   CD DC 12               CALL   neg_bc   
128C                SDIV16_CHK_DIV:      
128C                             ; 除数を正にする
128C   7A                     MOV   a,d   
128D   E6 80                  ANI   80h   
128F   CA 95 12               JZ   sdiv16_do   
1292   CD E4 12               CALL   neg_de   
1295                SDIV16_DO:      
1295   CD A5 12               CALL   udiv16   ; BC = |商|, HL = |剰余|
1298   F1                     POP   psw   
1299   E6 80                  ANI   80h   
129B   C8                     RZ      ; 同符号 → 正の商をそのまま返す
129C                             ; 異符号: 剰余があれば floor 調整
129C   7C                     MOV   a,h   
129D   B5                     ORA   l   
129E   CA A2 12               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
12A1   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
12A2                SDIV16_NEG:      
12A2   C3 DC 12               JMP   neg_bc   
12A5                             ; 
12A5                             ; ---------------------------------------------------------------
12A5                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
12A5                             ; 
12A5                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
12A5                             ;   出力: BC = 商, HL = 剰余
12A5                             ;   破壊: A
12A5                             ; 
12A5                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
12A5                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
12A5                             ; ---------------------------------------------------------------
12A5                UDIV16:      
12A5   21 00 00               LXI   h,0   ; 剰余 = 0
12A8   3E 10                  MVI   a,16   
12AA   32 DB 12               STA   udiv_cnt   
12AD                UDIV16_LOOP:      
12AD                             ; BC を 1 ビット左シフト (MSB → CY)
12AD   79                     MOV   a,c   
12AE   87                     ADD   a   ; C <<= 1, bit7 → CY
12AF   4F                     MOV   c,a   
12B0   78                     MOV   a,b   
12B1   8F                     ADC   a   ; B <<= 1 + CY from C
12B2   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
12B3                             ; CY を剰余 (HL) にシフトイン
12B3   7D                     MOV   a,l   
12B4   17                     RAL      
12B5   6F                     MOV   l,a   
12B6   7C                     MOV   a,h   
12B7   17                     RAL      
12B8   67                     MOV   h,a   
12B9                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
12B9   DA C9 12               JC   udiv16_sub   
12BC                             ; 剰余 (HL) と 除数 (DE) を比較
12BC   7C                     MOV   a,h   
12BD   BA                     CMP   d   
12BE   DA D0 12               JC   udiv16_nosub   ; H < D → HL < DE
12C1   C2 C9 12               JNZ   udiv16_sub   ; H > D → HL > DE
12C4   7D                     MOV   a,l   
12C5   BB                     CMP   e   
12C6   DA D0 12               JC   udiv16_nosub   ; L < E → HL < DE
12C9                UDIV16_SUB:      
12C9                             ; 剰余 ≧ 除数: 減算して商ビット = 1
12C9   7D                     MOV   a,l   
12CA   93                     SUB   e   
12CB   6F                     MOV   l,a   
12CC   7C                     MOV   a,h   
12CD   9A                     SBB   d   
12CE   67                     MOV   h,a   
12CF   0C                     INR   c   ; 商の bit0 を立てる
12D0                UDIV16_NOSUB:      
12D0   3A DB 12               LDA   udiv_cnt   ; LDA は CY に影響しない
12D3   3D                     DCR   a   ; DCR は CY に影響しない
12D4   32 DB 12               STA   udiv_cnt   
12D7   C2 AD 12               JNZ   udiv16_loop   
12DA   C9                     RET      
12DB                             ; 
12DB                UDIV_CNT:      
12DB   00                     DB   0   
12DC                             ; 
12DC                             ; ---------------------------------------------------------------
12DC                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
12DC                             ; ---------------------------------------------------------------
12DC                NEG_BC:      
12DC   79                     MOV   a,c   
12DD   2F                     CMA      
12DE   4F                     MOV   c,a   
12DF   78                     MOV   a,b   
12E0   2F                     CMA      
12E1   47                     MOV   b,a   
12E2   03                     INX   b   
12E3   C9                     RET      
12E4                             ; 
12E4                NEG_DE:      
12E4   7B                     MOV   a,e   
12E5   2F                     CMA      
12E6   5F                     MOV   e,a   
12E7   7A                     MOV   a,d   
12E8   2F                     CMA      
12E9   57                     MOV   d,a   
12EA   13                     INX   d   
12EB   C9                     RET      
12EC                             ; vm_compare.a80 — 比較命令
12EC                             ; 
12EC                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
12EC                             ; 
12EC                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
12EC                             ; Phase 2 は整数のみ。
12EC                             ; 
12EC                             ; cmp_value16 は結果を A で返す:
12EC                             ;   A = 00h → 等しい
12EC                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
12EC                             ;   A = 01h → val1 > val2
12EC                             ; 
12EC                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
12EC                             ; 
12EC                             ; ---------------------------------------------------------------
12EC                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
12EC                             ; 
12EC                             ;   出力: A = 比較結果 (00h/FFh/01h)
12EC                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
12EC                             ;   破壊: A, B, HL, DE
12EC                             ; ---------------------------------------------------------------
12EC                CMP_REG_PAIR:      
12EC   CD C0 10               CALL   fetch_byte   
12EF   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
12F2                             ; R[a+1] の値先頭
12F2   CD 0C 10               CALL   get_reg_addr_next   
12F5   CD 32 10               CALL   slot_to_value   
12F8   EB                     XCHG      ; DE = R[a+1] 値先頭
12F9                             ; R[a] の値先頭
12F9   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
12FC   CD 00 10               CALL   get_reg_addr   
12FF   CD 32 10               CALL   slot_to_value   ; HL = R[a] 値先頭
1302   CD 4B 10               CALL   cmp_value16   ; A = 結果
1305   C9                     RET      
1306                             ; 
1306                             ; ---------------------------------------------------------------
1306                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
1306                             ; 
1306                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
1306                             ; ---------------------------------------------------------------
1306                CMP_SET_TRUE:      
1306   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1309   CD 00 10               CALL   get_reg_addr   
130C   3E 03                  MVI   a,TT_TRUE   
130E   CD 1A 10               CALL   set_slot_special   
1311   C3 8B 1B               JMP   vm_loop   
1314                CMP_SET_FALSE:      
1314   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1317   CD 00 10               CALL   get_reg_addr   
131A   3E 02                  MVI   a,TT_FALSE   
131C   CD 1A 10               CALL   set_slot_special   
131F   C3 8B 1B               JMP   vm_loop   
1322                             ; 
1322                             ; ---------------------------------------------------------------
1322                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
1322                             ; 
1322                             ; 型タグと値の両方が一致したときだけ true。
1322                             ; ---------------------------------------------------------------
1322                DO_OP_EQ:      
1322   CD C0 10               CALL   fetch_byte   
1325   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
1328                             ; R[a] と R[a+1] のスロットアドレスを求める
1328   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
132B   E5                     PUSH   h   ; R[a] を退避
132C   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
132F   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1332   D1                     POP   d   ; DE = R[a]
1333                             ; HL = R[a+1], DE = R[a]
1333                             ; 型タグを比べる
1333   46                     MOV   b,m   ; B = R[a+1].type
1334   1A                     LDAX   d   ; A = R[a].type
1335   B8                     CMP   b   
1336   C2 14 13               JNZ   cmp_set_false   ; 型が違えば false
1339                             ; 型が同じ → 値を 2 バイト比べる
1339   23                     INX   h   
133A   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
133B   13                     INX   d   
133C   13                     INX   d   ; DE = R[a] + 2 (値先頭)
133D   1A                     LDAX   d   ; A = R[a].val_lo
133E   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
133F   C2 14 13               JNZ   cmp_set_false   
1342   23                     INX   h   
1343   13                     INX   d   
1344   1A                     LDAX   d   ; A = R[a].val_hi
1345   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
1346   C2 14 13               JNZ   cmp_set_false   
1349   C3 06 13               JMP   cmp_set_true   ; すべて一致
134C                             ; 
134C                             ; ---------------------------------------------------------------
134C                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
134C                             ; ---------------------------------------------------------------
134C                DO_OP_LT:      
134C   CD EC 12               CALL   cmp_reg_pair   ; A = 結果
134F   B7                     ORA   a   
1350   FA 06 13               JM   cmp_set_true   ; A = FFh → val1 < val2
1353   C3 14 13               JMP   cmp_set_false   
1356                             ; 
1356                             ; ---------------------------------------------------------------
1356                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
1356                             ; ---------------------------------------------------------------
1356                DO_OP_LE:      
1356   CD EC 12               CALL   cmp_reg_pair   
1359   B7                     ORA   a   
135A   FA 06 13               JM   cmp_set_true   ; val1 < val2
135D   CA 06 13               JZ   cmp_set_true   ; val1 == val2
1360   C3 14 13               JMP   cmp_set_false   
1363                             ; 
1363                             ; ---------------------------------------------------------------
1363                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
1363                             ; ---------------------------------------------------------------
1363                DO_OP_GT:      
1363   CD EC 12               CALL   cmp_reg_pair   
1366   B7                     ORA   a   
1367   CA 14 13               JZ   cmp_set_false   ; val1 == val2
136A   F2 06 13               JP   cmp_set_true   ; A = 01h → val1 > val2
136D   C3 14 13               JMP   cmp_set_false   ; A = FFh → val1 < val2
1370                             ; 
1370                             ; ---------------------------------------------------------------
1370                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
1370                             ; ---------------------------------------------------------------
1370                DO_OP_GE:      
1370   CD EC 12               CALL   cmp_reg_pair   
1373   B7                     ORA   a   
1374   FA 14 13               JM   cmp_set_false   ; val1 < val2
1377   C3 06 13               JMP   cmp_set_true   ; val1 >= val2
137A                             ; vm_jump.a80 — ジャンプ命令
137A                             ; 
137A                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
137A                             ; 
137A                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
137A                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
137A                             ; 
137A                             ; ---------------------------------------------------------------
137A                             ; apply_jump — PC に符号付きオフセットを加える
137A                             ; 
137A                             ;   入力: HL = 符号付き 16 ビットオフセット
137A                             ;   出力: なし (PC が更新される)
137A                             ;   破壊: A, HL, DE
137A                             ; ---------------------------------------------------------------
137A                APPLY_JUMP:      
137A   EB                     XCHG      ; DE = オフセット
137B   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
137E   19                     DAD   d   ; HL = PC + オフセット
137F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1382   C9                     RET      
1383                             ; 
1383                             ; ---------------------------------------------------------------
1383                             ; OP_JMP (S): PC += signed16(a)
1383                             ; ---------------------------------------------------------------
1383                DO_OP_JMP:      
1383   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1386   CD 7A 13               CALL   apply_jump   
1389   C3 8B 1B               JMP   vm_loop   
138C                             ; 
138C                             ; ---------------------------------------------------------------
138C                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
138C                             ; 
138C                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
138C                             ; ---------------------------------------------------------------
138C                DO_OP_JMPIF:      
138C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
138F   F5                     PUSH   psw   
1390   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1393   E5                     PUSH   h   ; オフセットを退避
1394   D1                     POP   d   ; DE = オフセット
1395   F1                     POP   psw   ; A = a
1396   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
1399   CD 30 10               CALL   get_slot_type   ; A = 型タグ
139C   FE 03                  CPI   TT_FALSY_MAX + 1   
139E   DA A8 13               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
13A1                             ; 真 → ジャンプする
13A1   EB                     XCHG      ; HL = オフセット (DE にあった)
13A2   CD 7A 13               CALL   apply_jump   
13A5   C3 8B 1B               JMP   vm_loop   
13A8                JMPIF_SKIP:      
13A8   C3 8B 1B               JMP   vm_loop   
13AB                             ; 
13AB                             ; ---------------------------------------------------------------
13AB                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
13AB                             ; ---------------------------------------------------------------
13AB                DO_OP_JMPNOT:      
13AB   CD C0 10               CALL   fetch_byte   ; A = a
13AE   F5                     PUSH   psw   
13AF   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
13B2   E5                     PUSH   h   
13B3   D1                     POP   d   ; DE = オフセット
13B4   F1                     POP   psw   ; A = a
13B5   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
13B8   CD 30 10               CALL   get_slot_type   ; A = 型タグ
13BB   FE 03                  CPI   TT_FALSY_MAX + 1   
13BD   D2 C7 13               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
13C0                             ; 偽 → ジャンプする
13C0   EB                     XCHG      ; HL = オフセット
13C1   CD 7A 13               CALL   apply_jump   
13C4   C3 8B 1B               JMP   vm_loop   
13C7                JMPNOT_SKIP:      
13C7   C3 8B 1B               JMP   vm_loop   
13CA                             ; vm_globals.a80 — グローバル変数・インスタンス変数アクセス
13CA                             ; 
13CA                             ; OP_GETGV, OP_SETGV, OP_GETIV, OP_SETIV
13CA                             ; 
13CA                             ; シンボルテーブル (SYM_TABLE_BASE) の 2 バイトエントリ (D,E) で振り分ける:
13CA                             ;   D >= 0x80      : グローバル変数アドレス (DE = アドレス)
13CA                             ;   D == 0x03      : インスタンス変数 (E = ivar_index)
13CA                             ;   D == 0, E == 0 : 未対応シンボル → エラー
13CA                             ; 
13CA                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
13CA                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
13CA                             ; 
13CA                             ; ---------------------------------------------------------------
13CA                             ; OP_GETGV / OP_GETIV (BB): R[a] = global[symbols[b]]
13CA                             ; ---------------------------------------------------------------
13CA                DO_OP_GETGV:      
13CA   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
13CD   F5                     PUSH   psw   
13CE   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
13D1                             ; シンボルテーブルからエントリを取得
13D1   87                     ADD   a   ; A = b * 2
13D2   5F                     MOV   e,a   
13D3   16 00                  MVI   d,0   
13D5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
13D8   19                     DAD   d   ; HL = &sym_table[b]
13D9   5E                     MOV   e,m   
13DA   23                     INX   h   
13DB   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
13DC                             ; 
13DC                             ; D == SYM_KIND_IVAR → インスタンス変数
13DC   7A                     MOV   a,d   
13DD   FE 03                  CPI   SYM_KIND_IVAR   
13DF   CA F8 13               JZ   getiv_handler   
13E2                             ; 
13E2                             ; アドレスが 0 なら未対応シンボル
13E2   7A                     MOV   a,d   
13E3   B3                     ORA   e   
13E4   C2 EB 13               JNZ   getgv_ok   
13E7   F1                     POP   psw   
13E8   C3 03 00               JMP   vm_error   
13EB                GETGV_OK:      
13EB   F1                     POP   psw   ; A = a
13EC   D5                     PUSH   d   ; グローバルアドレスを退避
13ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
13F0   EB                     XCHG      ; DE = R[a]
13F1   E1                     POP   h   ; HL = グローバルスロット (コピー元)
13F2   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
13F5   C3 8B 1B               JMP   vm_loop   
13F8                             ; 
13F8                             ; --- IVAR GET ---
13F8                             ; E = ivar_index, スタックに a が積まれている
13F8                GETIV_HANDLER:      
13F8   7B                     MOV   a,e   
13F9   32 6C 14               STA   gv_ivar_idx   
13FC   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
13FF   F1                     POP   psw   ; A = a
1400   E5                     PUSH   h   ; IVAR アドレスを退避
1401   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1404   EB                     XCHG      ; DE = R[a]
1405   E1                     POP   h   ; HL = IVAR スロット (コピー元)
1406   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1409   C3 8B 1B               JMP   vm_loop   
140C                             ; 
140C                             ; ---------------------------------------------------------------
140C                             ; OP_SETGV / OP_SETIV (BB): global[symbols[b]] = R[a]
140C                             ; ---------------------------------------------------------------
140C                DO_OP_SETGV:      
140C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
140F   F5                     PUSH   psw   
1410   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1413   87                     ADD   a   
1414   5F                     MOV   e,a   
1415   16 00                  MVI   d,0   
1417   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
141A   19                     DAD   d   ; HL = &sym_table[b]
141B   5E                     MOV   e,m   
141C   23                     INX   h   
141D   56                     MOV   d,m   ; DE = エントリ値
141E                             ; 
141E                             ; D == SYM_KIND_IVAR → インスタンス変数
141E   7A                     MOV   a,d   
141F   FE 03                  CPI   SYM_KIND_IVAR   
1421   CA 37 14               JZ   setiv_handler   
1424                             ; 
1424   7A                     MOV   a,d   
1425   B3                     ORA   e   
1426   C2 2D 14               JNZ   setgv_ok   
1429   F1                     POP   psw   
142A   C3 03 00               JMP   vm_error   
142D                SETGV_OK:      
142D   F1                     POP   psw   ; A = a
142E   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1431                             ; copy_slot: [HL] → [DE]
1431   CD 25 10               CALL   copy_slot   
1434   C3 8B 1B               JMP   vm_loop   
1437                             ; 
1437                             ; --- IVAR SET ---
1437                             ; E = ivar_index, スタックに a が積まれている
1437                SETIV_HANDLER:      
1437   7B                     MOV   a,e   
1438   32 6C 14               STA   gv_ivar_idx   
143B   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
143E   EB                     XCHG      ; DE = IVAR スロット (コピー先)
143F   F1                     POP   psw   ; A = a
1440   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1443   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1446   C3 8B 1B               JMP   vm_loop   
1449                             ; 
1449                             ; ---------------------------------------------------------------
1449                             ; calc_ivar_addr — R[0] (self) から IVAR スロットアドレスを算出
1449                             ; 
1449                             ;   入力: gv_ivar_idx = ivar_index
1449                             ;   出力: HL = OBJECT_POOL_BASE + (val_lo-1)*32 + 4 + ivar_index*4
1449                             ;   破壊: A, B, DE
1449                             ; 
1449                             ; R[0].val_lo = slot+1 (TT_OBJECT)
1449                             ; ---------------------------------------------------------------
1449                CALC_IVAR_ADDR:      
1449                             ; R[0] の val_lo を読む
1449   3E 00                  MVI   a,0   
144B   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
144E   23                     INX   h   
144F   23                     INX   h   
1450   7E                     MOV   a,m   ; A = val_lo (slot+1)
1451   3D                     DCR   a   ; A = slot
1452                             ; slot * 32
1452   87                     ADD   a   ; ×2
1453   87                     ADD   a   ; ×4
1454   87                     ADD   a   ; ×8
1455   87                     ADD   a   ; ×16
1456   87                     ADD   a   ; ×32
1457   5F                     MOV   e,a   
1458   16 00                  MVI   d,0   
145A   21 C0 92               LXI   h,OBJECT_POOL_BASE   
145D   19                     DAD   d   ; HL = スロット先頭
145E                             ; + OBJECT_HEADER_SIZE (4)
145E   11 04 00               LXI   d,OBJECT_HEADER_SIZE   
1461   19                     DAD   d   
1462                             ; + ivar_index * 4
1462   3A 6C 14               LDA   gv_ivar_idx   
1465   87                     ADD   a   ; ×2
1466   87                     ADD   a   ; ×4
1467   5F                     MOV   e,a   
1468   16 00                  MVI   d,0   
146A   19                     DAD   d   ; HL = IVAR スロットアドレス
146B   C9                     RET      
146C                             ; 
146C   00           GV_IVAR_IDX:   DB   0   
146D                             ; vm_send.a80 — メソッド呼び出し
146D                             ; 
146D                             ; OP_SEND, OP_SSEND
146D                             ; 
146D                             ; シンボルテーブルの 2 バイトエントリで振り分ける:
146D                             ;   D=0x00, E=1-31 : 組み込みメソッド
146D                             ;   D=0x01, E=id   : ユーザー定義メソッド
146D                             ;   D>=0x80         : グローバルアドレス (メソッドではない → エラー)
146D                             ; 
146D                             ; ---------------------------------------------------------------
146D                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
146D                             ; 
146D                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
146D                             ; ---------------------------------------------------------------
146D                DO_OP_SSEND:      
146D   CD C0 10               CALL   fetch_byte   ; A = a
1470   F5                     PUSH   psw   
1471   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1474   EB                     XCHG      ; DE = R[a]
1475   AF                     XRA   a   ; A = 0
1476   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (self)
1479   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
147C   F1                     POP   psw   ; A = a
147D   32 55 16               STA   send_reg_a   
1480   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1483   F5                     PUSH   psw   
1484   CD C0 10               CALL   fetch_byte   ; A = c (argc)
1487   32 56 16               STA   send_argc   
148A   F1                     POP   psw   ; A = b
148B   C3 9F 14               JMP   send_dispatch   
148E                             ; 
148E                             ; ---------------------------------------------------------------
148E                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
148E                             ; ---------------------------------------------------------------
148E                DO_OP_SEND:      
148E   CD C0 10               CALL   fetch_byte   ; A = a
1491   32 55 16               STA   send_reg_a   
1494   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1497   F5                     PUSH   psw   
1498   CD C0 10               CALL   fetch_byte   ; A = c (argc)
149B   32 56 16               STA   send_argc   
149E   F1                     POP   psw   ; A = b
149F                             ; 
149F                SEND_DISPATCH:      
149F                             ; シンボルテーブルからメソッド ID を取得
149F   87                     ADD   a   ; b * 2
14A0   5F                     MOV   e,a   
14A1   16 00                  MVI   d,0   
14A3   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
14A6   19                     DAD   d   
14A7   5E                     MOV   e,m   
14A8   23                     INX   h   
14A9   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=id)
14AA                             ; 
14AA                             ; D で振り分け
14AA   7A                     MOV   a,d   
14AB   B7                     ORA   a   
14AC   CA B7 14               JZ   send_builtin   ; D=0x00 → 組み込みメソッド
14AF   FE 01                  CPI   SYM_KIND_USER_METHOD   
14B1   CA E2 14               JZ   send_user_method   ; D=0x01 → ユーザー定義メソッド
14B4                             ; D >= 0x80 or other → エラー
14B4   C3 03 00               JMP   vm_error   
14B7                             ; 
14B7                SEND_BUILTIN:      
14B7                             ; E = メソッド ID (0 = 未対応)
14B7   7B                     MOV   a,e   
14B8   B7                     ORA   a   
14B9   CA 03 00               JZ   vm_error   
14BC                             ; 組み込みメソッドディスパッチ
14BC   FE 01                  CPI   1   
14BE   CA B0 15               JZ   send_ne   ; != (不等号)
14C1   FE 02                  CPI   2   
14C3   CA E5 15               JZ   send_not   ; !  (論理否定)
14C6   FE 03                  CPI   3   
14C8   CA 0D 16               JZ   send_mod   ; %  (剰余)
14CB   FE 04                  CPI   4   
14CD   CA 38 16               JZ   send_abs   ; abs (絶対値)
14D0   FE 1C                  CPI   METHOD_NEW   
14D2   CA 25 15               JZ   send_new   ; Class#new
14D5   FE 1D                  CPI   METHOD_DISPLAY   
14D7   CA 98 1D               JZ   send_display   ; display(value)
14DA   FE 1E                  CPI   METHOD_GETKEY   
14DC   CA B3 1D               JZ   send_getkey   ; getkey
14DF   C3 EE 1D               JMP   send_builtin_ext   ; 拡張ビルトイン (0xA800+ 領域)
14E2                             ; 
14E2                             ; ---------------------------------------------------------------
14E2                             ; send_user_method — ユーザー定義メソッド呼び出し
14E2                             ; 
14E2                             ; E = method_id。メソッド表から irep 番号を引き、
14E2                             ; push_frame + switch_irep で呼び出す。
14E2                             ; ---------------------------------------------------------------
14E2                SEND_USER_METHOD:      
14E2                             ; method_id を退避
14E2   7B                     MOV   a,e   
14E3   32 23 15               STA   sum_method_id   
14E6                             ; 
14E6                             ; R[a] から class_number を取得
14E6   3A 55 16               LDA   send_reg_a   
14E9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
14EC   CD 9B 10               CALL   class_of_reg   ; A = class_number
14EF                             ; 
14EF                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
14EF   87                     ADD   a   ; ×2
14F0   87                     ADD   a   ; ×4
14F1   87                     ADD   a   ; ×8
14F2   87                     ADD   a   ; ×16
14F3   87                     ADD   a   ; ×32
14F4   5F                     MOV   e,a   
14F5   16 00                  MVI   d,0   
14F7   21 C0 91               LXI   h,METHOD_TABLE_BASE   
14FA   19                     DAD   d   
14FB   3A 23 15               LDA   sum_method_id   
14FE   5F                     MOV   e,a   
14FF   16 00                  MVI   d,0   
1501   19                     DAD   d   ; HL = メソッド表エントリ
1502   7E                     MOV   a,m   ; A = irep 番号
1503   B7                     ORA   a   
1504   CA 03 00               JZ   vm_error   ; 0 = 未定義
1507   32 24 15               STA   sum_irep   
150A                             ; 
150A                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
150A   3A 55 16               LDA   send_reg_a   
150D   06 00                  MVI   b,FRAME_KIND_CALL   
150F   0E FF                  MVI   c,FRAME_NONE   
1511   CD A4 16               CALL   push_frame   
1514                             ; 
1514                             ; 子 irep に切り替え
1514   3A 24 15               LDA   sum_irep   
1517   CD 29 17               CALL   switch_irep   
151A                             ; 
151A                             ; PC = 0
151A   21 00 00               LXI   h,0   
151D   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1520   C3 8B 1B               JMP   vm_loop   
1523                             ; 
1523   00           SUM_METHOD_ID:   DB   0   
1524   00           SUM_IREP:   DB   0   
1525                             ; 
1525                             ; ---------------------------------------------------------------
1525                             ; send_new — Class#new (オブジェクト生成)
1525                             ; 
1525                             ; 1. オブジェクトプールにスロットを確保
1525                             ; 2. R[a] を TT_OBJECT に設定 (val_lo = slot+1)
1525                             ; 3. initialize メソッドがあれば呼び出す
1525                             ; ---------------------------------------------------------------
1525                SEND_NEW:      
1525                             ; OBJ_SP < MAX_OBJECTS を確認
1525   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1528   FE 20                  CPI   MAX_OBJECTS   
152A   D2 03 00               JNC   vm_error   ; オブジェクトプール満杯
152D                             ; 
152D                             ; R[a] (TT_CLASS) から class_number を取得
152D   32 AC 15               STA   sn_slot   ; OBJ_SP = slot 番号
1530   3A 55 16               LDA   send_reg_a   
1533   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1536   CD 32 10               CALL   slot_to_value   
1539   7E                     MOV   a,m   ; A = class_number
153A   32 AD 15               STA   sn_class_num   
153D                             ; 
153D                             ; オブジェクトプールにヘッダを書く
153D                             ; OBJECT_POOL_BASE + slot * 32
153D   3A AC 15               LDA   sn_slot   
1540   87                     ADD   a   ; ×2
1541   87                     ADD   a   ; ×4
1542   87                     ADD   a   ; ×8
1543   87                     ADD   a   ; ×16
1544   87                     ADD   a   ; ×32
1545   5F                     MOV   e,a   
1546   16 00                  MVI   d,0   
1548   21 C0 92               LXI   h,OBJECT_POOL_BASE   
154B   19                     DAD   d   ; HL = スロット先頭
154C   3A AD 15               LDA   sn_class_num   
154F   77                     MOV   m,a   ; +0: class_number
1550                             ; 
1550                             ; R[a] = TT_OBJECT, val_lo = slot+1
1550   3A 55 16               LDA   send_reg_a   
1553   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1556   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1558   23                     INX   h   
1559   36 00                  MVI   m,0   ; +1: 予約
155B   23                     INX   h   
155C   3A AC 15               LDA   sn_slot   
155F   3C                     INR   a   ; slot + 1
1560   77                     MOV   m,a   ; +2: val_lo
1561   23                     INX   h   
1562   36 00                  MVI   m,0   ; +3: val_hi = 0
1564                             ; 
1564                             ; OBJ_SP++
1564   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1567   3C                     INR   a   
1568   32 1B 80               STA   VM_STATE_BASE + OFF_OBJ_SP   
156B                             ; 
156B                             ; initialize メソッドがあれば呼び出す
156B   3A 1C 80               LDA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
156E   B7                     ORA   a   
156F   CA 8B 1B               JZ   vm_loop   ; INIT_METHOD_ID=0 → initialize なし
1572                             ; 
1572                             ; method_table[class * 32 + init_id] を引く
1572   32 AE 15               STA   sn_init_id   
1575   3A AD 15               LDA   sn_class_num   
1578   87                     ADD   a   
1579   87                     ADD   a   
157A   87                     ADD   a   
157B   87                     ADD   a   
157C   87                     ADD   a   ; class * 32
157D   5F                     MOV   e,a   
157E   16 00                  MVI   d,0   
1580   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1583   19                     DAD   d   
1584   3A AE 15               LDA   sn_init_id   
1587   5F                     MOV   e,a   
1588   16 00                  MVI   d,0   
158A   19                     DAD   d   ; HL = メソッド表エントリ
158B   7E                     MOV   a,m   ; A = irep 番号
158C   B7                     ORA   a   
158D   CA 8B 1B               JZ   vm_loop   ; 未定義 → 呼ばない
1590   32 AF 15               STA   sn_init_irep   
1593                             ; 
1593                             ; push_frame(a, FRAME_KIND_NEW, FRAME_NONE)
1593   3A 55 16               LDA   send_reg_a   
1596   06 05                  MVI   b,FRAME_KIND_NEW   
1598   0E FF                  MVI   c,FRAME_NONE   
159A   CD A4 16               CALL   push_frame   
159D                             ; 
159D                             ; 子 irep に切り替え
159D   3A AF 15               LDA   sn_init_irep   
15A0   CD 29 17               CALL   switch_irep   
15A3                             ; 
15A3                             ; PC = 0
15A3   21 00 00               LXI   h,0   
15A6   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
15A9   C3 8B 1B               JMP   vm_loop   
15AC                             ; 
15AC   00           SN_SLOT:   DB   0   
15AD   00           SN_CLASS_NUM:   DB   0   
15AE   00           SN_INIT_ID:   DB   0   
15AF   00           SN_INIT_IREP:   DB   0   
15B0                             ; 
15B0                             ; ---------------------------------------------------------------
15B0                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
15B0                             ; 
15B0                             ; スロット全体 (4 バイト) をバイト比較する。
15B0                             ; 型タグも含めて比較するので異なる型は常に true。
15B0                             ; ---------------------------------------------------------------
15B0                SEND_NE:      
15B0   3A 55 16               LDA   send_reg_a   
15B3   F5                     PUSH   psw   
15B4   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
15B7   EB                     XCHG      ; DE = R[a+1]
15B8   F1                     POP   psw   
15B9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15BC   0E 04                  MVI   c,SLOT_BYTES   
15BE                SEND_NE_CMP:      
15BE   1A                     LDAX   d   
15BF   BE                     CMP   m   
15C0   C2 D7 15               JNZ   send_ne_diff   
15C3   23                     INX   h   
15C4   13                     INX   d   
15C5   0D                     DCR   c   
15C6   C2 BE 15               JNZ   send_ne_cmp   
15C9                             ; 全バイト一致 → 等しい → false
15C9   3A 55 16               LDA   send_reg_a   
15CC   CD 00 10               CALL   get_reg_addr   
15CF   3E 02                  MVI   a,TT_FALSE   
15D1   CD 1A 10               CALL   set_slot_special   
15D4   C3 8B 1B               JMP   vm_loop   
15D7                SEND_NE_DIFF:      
15D7   3A 55 16               LDA   send_reg_a   
15DA   CD 00 10               CALL   get_reg_addr   
15DD   3E 03                  MVI   a,TT_TRUE   
15DF   CD 1A 10               CALL   set_slot_special   
15E2   C3 8B 1B               JMP   vm_loop   
15E5                             ; 
15E5                             ; ---------------------------------------------------------------
15E5                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
15E5                             ; 
15E5                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
15E5                             ; ---------------------------------------------------------------
15E5                SEND_NOT:      
15E5   3A 55 16               LDA   send_reg_a   
15E8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15EB   7E                     MOV   a,m   ; A = 型タグ
15EC   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
15EE   DA FF 15               JC   send_not_falsy   
15F1                             ; 真だった → false
15F1   3A 55 16               LDA   send_reg_a   
15F4   CD 00 10               CALL   get_reg_addr   
15F7   3E 02                  MVI   a,TT_FALSE   
15F9   CD 1A 10               CALL   set_slot_special   
15FC   C3 8B 1B               JMP   vm_loop   
15FF                SEND_NOT_FALSY:      
15FF                             ; 偽だった → true
15FF   3A 55 16               LDA   send_reg_a   
1602   CD 00 10               CALL   get_reg_addr   
1605   3E 03                  MVI   a,TT_TRUE   
1607   CD 1A 10               CALL   set_slot_special   
160A   C3 8B 1B               JMP   vm_loop   
160D                             ; 
160D                             ; ---------------------------------------------------------------
160D                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
160D                             ; ---------------------------------------------------------------
160D                SEND_MOD:      
160D   3A 55 16               LDA   send_reg_a   
1610   F5                     PUSH   psw   
1611   CD 0C 10               CALL   get_reg_addr_next   
1614   CD 32 10               CALL   slot_to_value   
1617   5E                     MOV   e,m   
1618   23                     INX   h   
1619   56                     MOV   d,m   ; DE = 除数
161A   7A                     MOV   a,d   
161B   B3                     ORA   e   
161C   C2 23 16               JNZ   send_mod_ok   
161F   F1                     POP   psw   
1620   C3 03 00               JMP   vm_error   ; ゼロ除算
1623                SEND_MOD_OK:      
1623   F1                     POP   psw   
1624   CD 00 10               CALL   get_reg_addr   
1627   CD 32 10               CALL   slot_to_value   
162A   E5                     PUSH   h   ; 書き戻し先
162B   4E                     MOV   c,m   
162C   23                     INX   h   
162D   46                     MOV   b,m   ; BC = 被除数
162E   CD 57 16               CALL   smod16   ; BC = 剰余 (除数と同符号)
1631   E1                     POP   h   
1632   71                     MOV   m,c   
1633   23                     INX   h   
1634   70                     MOV   m,b   
1635   C3 8B 1B               JMP   vm_loop   
1638                             ; 
1638                             ; ---------------------------------------------------------------
1638                             ; abs (絶対値): R[a] = |R[a]|
1638                             ; ---------------------------------------------------------------
1638                SEND_ABS:      
1638   3A 55 16               LDA   send_reg_a   
163B   CD 00 10               CALL   get_reg_addr   
163E   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭
1641   23                     INX   h   ; HL → val_hi
1642   7E                     MOV   a,m   
1643   E6 80                  ANI   80h   
1645   CA 8B 1B               JZ   vm_loop   ; 正ならそのまま
1648   2B                     DCX   h   ; HL → val_lo
1649   4E                     MOV   c,m   
164A   23                     INX   h   
164B   46                     MOV   b,m   ; BC = 値
164C   CD DC 12               CALL   neg_bc   
164F   70                     MOV   m,b   ; val_hi
1650   2B                     DCX   h   
1651   71                     MOV   m,c   ; val_lo
1652   C3 8B 1B               JMP   vm_loop   
1655                             ; 
1655                             ; --- 一時変数 ---
1655                SEND_REG_A:      
1655   00                     DB   0   
1656                SEND_ARGC:      
1656   00                     DB   0   
1657                             ; 
1657                             ; ---------------------------------------------------------------
1657                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
1657                             ; 
1657                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1657                             ;   出力: BC = 剰余 (除数と同符号)
1657                             ;   破壊: A, DE, HL
1657                             ; 
1657                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
1657                             ; ---------------------------------------------------------------
1657                SMOD16:      
1657                             ; 除数の符号を保存
1657   7A                     MOV   a,d   
1658   F5                     PUSH   psw   
1659                             ; 符号の差を保存 (bit7: 異符号なら 1)
1659   78                     MOV   a,b   
165A   AA                     XRA   d   
165B   F5                     PUSH   psw   
165C                             ; 被除数を正にする
165C   78                     MOV   a,b   
165D   E6 80                  ANI   80h   
165F   CA 65 16               JZ   smod_chk_div   
1662   CD DC 12               CALL   neg_bc   
1665                SMOD_CHK_DIV:      
1665   7A                     MOV   a,d   
1666   E6 80                  ANI   80h   
1668   CA 6E 16               JZ   smod_do   
166B   CD E4 12               CALL   neg_de   
166E                SMOD_DO:      
166E   D5                     PUSH   d   ; |除数| を退避
166F   CD A5 12               CALL   udiv16   ; BC = 商, HL = 剰余
1672   44                     MOV   b,h   
1673   4D                     MOV   c,l   ; BC = |剰余|
1674   78                     MOV   a,b   
1675   B1                     ORA   c   
1676   D1                     POP   d   ; DE = |除数|
1677   F1                     POP   psw   ; 符号差 (bit7)
1678   CA 8D 16               JZ   smod_zero   ; 剰余 = 0
167B   E6 80                  ANI   80h   
167D   CA 86 16               JZ   smod_sign   ; 同符号 → 大きさはそのまま
1680                             ; 異符号: 大きさ = |除数| - |剰余|
1680   7B                     MOV   a,e   
1681   91                     SUB   c   
1682   4F                     MOV   c,a   
1683   7A                     MOV   a,d   
1684   98                     SBB   b   
1685   47                     MOV   b,a   
1686                SMOD_SIGN:      
1686   F1                     POP   psw   ; 除数の符号 (bit7)
1687   E6 80                  ANI   80h   
1689   C8                     RZ      ; 除数が正 → 正の剰余
168A   C3 DC 12               JMP   neg_bc   ; 除数が負 → 負にする
168D                SMOD_ZERO:      
168D   F1                     POP   psw   ; 除数の符号を捨てる
168E   C9                     RET      
168F                             ; vm_frame.a80 — フレームスタック管理
168F                             ; 
168F                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
168F                             ; 
168F                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
168F                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
168F                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
168F                             ;   get_frame_addr : フレーム番号 → メモリアドレス
168F                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
168F                             ; 
168F                             ; ---------------------------------------------------------------
168F                             ; get_frame_addr — フレーム番号 → アドレス
168F                             ; 
168F                             ;   入力: A = フレーム番号 (0-7)
168F                             ;   出力: HL = FRAME_STACK_BASE + A * 12
168F                             ;   破壊: A, B, DE
168F                             ; ---------------------------------------------------------------
168F                GET_FRAME_ADDR:      
168F   4F                     MOV   c,a   ; C = 元の値 (退避)
1690   87                     ADD   a   ; ×2
1691   47                     MOV   b,a   ; B = ×2
1692   87                     ADD   a   ; ×4
1693   80                     ADD   b   ; ×4 + ×2 = ×6
1694   87                     ADD   a   ; ×12
1695   5F                     MOV   e,a   
1696   16 00                  MVI   d,0   ; DE = frame * 12
1698   21 00 91               LXI   h,FRAME_STACK_BASE   
169B   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
169C   C9                     RET      
169D                             ; 
169D                             ; ---------------------------------------------------------------
169D                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
169D                             ; 
169D                             ;   入力: なし
169D                             ;   出力: HL = 現在のフレームのアドレス
169D                             ;   破壊: A, B, C, DE
169D                             ; ---------------------------------------------------------------
169D                CUR_FRAME_ADDR:      
169D   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16A0   3D                     DCR   a   
16A1   C3 8F 16               JMP   get_frame_addr   
16A4                             ; 
16A4                             ; ---------------------------------------------------------------
16A4                             ; push_frame — 現在の状態をフレームに保存
16A4                             ; 
16A4                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
16A4                             ;          B = フレーム種別 (FRAME_KIND_*)
16A4                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
16A4                             ;   出力: なし
16A4                             ;   破壊: A, B, C, HL, DE
16A4                             ; 
16A4                             ; frame_sp のスロットに保存して frame_sp++。
16A4                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
16A4                             ; ---------------------------------------------------------------
16A4                PUSH_FRAME:      
16A4                             ; パラメータを退避
16A4   32 FC 16               STA   pf_shift_reg   
16A7   78                     MOV   a,b   
16A8   32 FD 16               STA   pf_kind   
16AB   79                     MOV   a,c   
16AC   32 FE 16               STA   pf_outer   
16AF                             ; 
16AF                             ; HL = frame[frame_sp]
16AF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16B2   CD 8F 16               CALL   get_frame_addr   
16B5                             ; 
16B5                             ; +0,+1: return_pc
16B5   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
16B8   77                     MOV   m,a   
16B9   23                     INX   h   
16BA   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
16BD   77                     MOV   m,a   
16BE   23                     INX   h   
16BF                             ; 
16BF                             ; +2: return_irep
16BF   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
16C2   77                     MOV   m,a   
16C3   23                     INX   h   
16C4                             ; 
16C4                             ; +3,+4: return_reg_base
16C4   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
16C7   77                     MOV   m,a   
16C8   23                     INX   h   
16C9   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
16CC   77                     MOV   m,a   
16CD   23                     INX   h   
16CE                             ; 
16CE                             ; +5: kind
16CE   3A FD 16               LDA   pf_kind   
16D1   77                     MOV   m,a   
16D2   23                     INX   h   
16D3                             ; 
16D3                             ; +6,+7: index = 0
16D3   36 00                  MVI   m,0   
16D5   23                     INX   h   
16D6   36 00                  MVI   m,0   
16D8   23                     INX   h   
16D9                             ; 
16D9                             ; +8,+9: limit = 0
16D9   36 00                  MVI   m,0   
16DB   23                     INX   h   
16DC   36 00                  MVI   m,0   
16DE   23                     INX   h   
16DF                             ; 
16DF                             ; +10: outer
16DF   3A FE 16               LDA   pf_outer   
16E2   77                     MOV   m,a   
16E3                             ; 
16E3                             ; reg_base += shift_reg * 4
16E3   3A FC 16               LDA   pf_shift_reg   
16E6   87                     ADD   a   ; ×2
16E7   87                     ADD   a   ; ×4
16E8   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
16EB   85                     ADD   l   
16EC   6F                     MOV   l,a   
16ED   3E 00                  MVI   a,0   
16EF   8C                     ADC   h   
16F0   67                     MOV   h,a   
16F1   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
16F4                             ; 
16F4                             ; frame_sp++
16F4   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16F7   3C                     INR   a   
16F8   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
16FB   C9                     RET      
16FC                             ; 
16FC                             ; push_frame の一時変数
16FC   00           PF_SHIFT_REG:   DB   0   
16FD   00           PF_KIND:   DB   0   
16FE   00           PF_OUTER:   DB   0   
16FF                             ; 
16FF                             ; ---------------------------------------------------------------
16FF                             ; pop_frame — frame_sp-- して保存した状態を復帰
16FF                             ; 
16FF                             ;   入力: なし
16FF                             ;   出力: なし
16FF                             ;   破壊: A, B, C, HL, DE
16FF                             ; 
16FF                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
16FF                             ; ---------------------------------------------------------------
16FF                POP_FRAME:      
16FF                             ; frame_sp--
16FF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1702   3D                     DCR   a   
1703   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
1706                             ; 
1706                             ; HL = frame[frame_sp] (decremented value)
1706   CD 8F 16               CALL   get_frame_addr   
1709                             ; 
1709                             ; +0,+1: restore return_pc
1709   7E                     MOV   a,m   
170A   32 00 80               STA   VM_STATE_BASE + OFF_PC   
170D   23                     INX   h   
170E   7E                     MOV   a,m   
170F   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
1712   23                     INX   h   
1713                             ; 
1713                             ; +2: return_irep → switch_irep 用に退避
1713   7E                     MOV   a,m   
1714   32 28 17               STA   popf_ret_irep   
1717   23                     INX   h   
1718                             ; 
1718                             ; +3,+4: restore return_reg_base
1718   7E                     MOV   a,m   
1719   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
171C   23                     INX   h   
171D   7E                     MOV   a,m   
171E   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
1721                             ; 
1721                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
1721   3A 28 17               LDA   popf_ret_irep   
1724   CD 29 17               CALL   switch_irep   
1727   C9                     RET      
1728                             ; 
1728   00           POPF_RET_IREP:   DB   0   
1729                             ; 
1729                             ; ---------------------------------------------------------------
1729                             ; switch_irep — IREP テーブルから実行情報をロード
1729                             ; 
1729                             ;   入力: A = IREP 番号
1729                             ;   出力: なし
1729                             ;   破壊: A, B, C, HL, DE
1729                             ; 
1729                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
1729                             ; ---------------------------------------------------------------
1729                SWITCH_IREP:      
1729   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
172C                             ; 
172C                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
172C                             ; A * 10 = A * 8 + A * 2
172C   4F                     MOV   c,a   ; C = A (退避)
172D   87                     ADD   a   ; ×2
172E   47                     MOV   b,a   ; B = A*2
172F   79                     MOV   a,c   
1730   87                     ADD   a   ; ×2
1731   87                     ADD   a   ; ×4
1732   87                     ADD   a   ; ×8
1733   80                     ADD   b   ; A*8 + A*2 = A*10
1734   5F                     MOV   e,a   
1735   16 00                  MVI   d,0   
1737   21 00 82               LXI   h,IREP_TABLE_BASE   
173A   19                     DAD   d   ; HL = エントリアドレス
173B                             ; 
173B                             ; +0,+1: bytecode base → BC_BASE
173B   7E                     MOV   a,m   
173C   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
173F   23                     INX   h   
1740   7E                     MOV   a,m   
1741   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1744   23                     INX   h   
1745                             ; 
1745                             ; +2,+3: bytecode len → BC_LEN
1745   7E                     MOV   a,m   
1746   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1749   23                     INX   h   
174A   7E                     MOV   a,m   
174B   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
174E   23                     INX   h   
174F                             ; 
174F                             ; +4,+5: pool base → POOL_BASE
174F   7E                     MOV   a,m   
1750   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1753   23                     INX   h   
1754   7E                     MOV   a,m   
1755   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1758   23                     INX   h   
1759                             ; 
1759                             ; +6: nregs
1759   7E                     MOV   a,m   
175A   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
175D                             ; 
175D                             ; +7: subtree_size (スキップ)
175D   23                     INX   h   
175E                             ; 
175E                             ; +8,+9: sym_table_base → SYM_BASE
175E   23                     INX   h   
175F   7E                     MOV   a,m   
1760   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1763   23                     INX   h   
1764   7E                     MOV   a,m   
1765   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1768                             ; 
1768   C9                     RET      
1769                             ; vm_block.a80 — ブロック関連オペコード
1769                             ; 
1769                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
1769                             ; 
1769                             ; ---------------------------------------------------------------
1769                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
1769                             ; ---------------------------------------------------------------
1769                DO_OP_LOADSELF:      
1769   CD C0 10               CALL   fetch_byte   ; A = a
176C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
176F   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1771   23                     INX   h   
1772   36 00                  MVI   m,0   ; +1: 予約
1774   23                     INX   h   
1775   36 00                  MVI   m,0   ; +2: val_lo = 0
1777   23                     INX   h   
1778   36 00                  MVI   m,0   ; +3: val_hi = 0
177A   C3 8B 1B               JMP   vm_loop   
177D                             ; 
177D                             ; ---------------------------------------------------------------
177D                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
177D                             ; 
177D                             ; ブロックを TT_PROC としてレジスタに格納する。
177D                             ;   値の下位バイト = 子 irep 番号
177D                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
177D                             ; ---------------------------------------------------------------
177D                DO_OP_BLOCK:      
177D   CD C0 10               CALL   fetch_byte   ; A = a
1780   32 A9 17               STA   blk_reg_a   
1783   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1786                             ; 
1786                             ; 子 irep 番号を算出 (共通サブルーチン)
1786   CD 77 10               CALL   calc_child_irep   ; A = child irep 番号
1789                             ; 
1789                             ; R[a] に TT_PROC を書く
1789   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
178A   3A A9 17               LDA   blk_reg_a   
178D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1790   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
1792   23                     INX   h   
1793   36 00                  MVI   m,0   ; +1: 予約
1795   23                     INX   h   
1796   71                     MOV   m,c   ; +2: val_lo = irep 番号
1797   23                     INX   h   
1798                             ; val_hi = 外側フレーム番号
1798                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
1798                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
1798   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
179B   B7                     ORA   a   
179C   C2 A4 17               JNZ   block_in_frame   
179F   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
17A1   C3 A5 17               JMP   block_set_outer   
17A4                BLOCK_IN_FRAME:      
17A4   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
17A5                BLOCK_SET_OUTER:      
17A5   77                     MOV   m,a   ; +3: val_hi = outer frame
17A6   C3 8B 1B               JMP   vm_loop   
17A9                             ; 
17A9   00           BLK_REG_A:   DB   0   
17AA                             ; 
17AA                             ; ---------------------------------------------------------------
17AA                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
17AA                             ; 
17AA                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
17AA                             ; ---------------------------------------------------------------
17AA                DO_OP_ENTER:      
17AA   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 1)
17AD   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 2)
17B0   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 3)
17B3   C3 8B 1B               JMP   vm_loop   
17B6                             ; 
17B6                             ; ---------------------------------------------------------------
17B6                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
17B6                             ; 
17B6                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
17B6                             ; ブロック付きメソッド呼び出しを行う。
17B6                             ; ---------------------------------------------------------------
17B6                DO_OP_SSENDB:      
17B6                             ; オペランドをプリフェッチ
17B6   CD C0 10               CALL   fetch_byte   ; A = a
17B9   32 AB 18               STA   sendb_reg_a   
17BC   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17BF   32 AC 18               STA   sendb_sym_b   
17C2   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17C5   32 AD 18               STA   sendb_argc   
17C8                             ; 
17C8                             ; R[0] → R[a] コピー (self を設定)
17C8   3E 00                  MVI   a,0   
17CA   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
17CD   E5                     PUSH   h   ; R[0] アドレス退避
17CE   3A AB 18               LDA   sendb_reg_a   
17D1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
17D4   EB                     XCHG      ; DE = R[a]
17D5   E1                     POP   h   ; HL = R[0]
17D6   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
17D9                             ; 
17D9   C3 EE 17               JMP   sendb_dispatch   
17DC                             ; 
17DC                             ; ---------------------------------------------------------------
17DC                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
17DC                             ; 
17DC                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
17DC                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
17DC                             ; ---------------------------------------------------------------
17DC                DO_OP_SENDB:      
17DC   CD C0 10               CALL   fetch_byte   ; A = a
17DF   32 AB 18               STA   sendb_reg_a   
17E2   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17E5   32 AC 18               STA   sendb_sym_b   
17E8   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17EB   32 AD 18               STA   sendb_argc   
17EE                             ; 
17EE                SENDB_DISPATCH:      
17EE                             ; シンボルテーブルからメソッド ID を取得
17EE   3A AC 18               LDA   sendb_sym_b   
17F1   87                     ADD   a   ; ×2
17F2   5F                     MOV   e,a   
17F3   16 00                  MVI   d,0   
17F5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
17F8   19                     DAD   d   ; HL = sym_table[b]
17F9   7E                     MOV   a,m   ; メソッド ID (下位)
17FA   32 AE 18               STA   sendb_method_id   
17FD                             ; 
17FD                             ; メソッド ID で振り分け
17FD   3A AE 18               LDA   sendb_method_id   
1800   FE 0B                  CPI   11   ; METHOD_TIMES
1802   CA 12 18               JZ   sendb_times   
1805   FE 15                  CPI   METHOD_EACH   
1807   CA AA 27               JZ   sendb_each   
180A   FE 1B                  CPI   27   ; METHOD_LOOP
180C   CA 75 18               JZ   sendb_loop   
180F                             ; 未対応のブロックメソッド
180F   C3 03 00               JMP   vm_error   
1812                             ; 
1812                             ; --- times ---
1812                SENDB_TIMES:      
1812                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
1812   3A AB 18               LDA   sendb_reg_a   
1815   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1818   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
181B   4E                     MOV   c,m   ; C = val_lo
181C   23                     INX   h   
181D   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
181E                             ; 
181E                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
181E   78                     MOV   a,b   
181F   B1                     ORA   c   
1820   CA 8B 1B               JZ   vm_loop   ; receiver == 0 → スキップ
1823                             ; 
1823                             ; limit = BC - 1
1823   0B                     DCX   b   ; BC = limit
1824                             ; 
1824                             ; push_frame: A=レジスタ番号, B=kind, C=outer
1824                             ; ブロックの位置: R[a + argc + 1]
1824   3A AB 18               LDA   sendb_reg_a   
1827   C5                     PUSH   b   ; limit を退避
1828                             ; ブロック (TT_PROC) の情報を読む
1828   3A AD 18               LDA   sendb_argc   
182B   3C                     INR   a   ; argc + 1
182C   47                     MOV   b,a   
182D   3A AB 18               LDA   sendb_reg_a   
1830   80                     ADD   b   ; A = a + argc + 1
1831   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1834   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1837   7E                     MOV   a,m   ; A = irep 番号
1838   32 AF 18               STA   sendb_block_irep   
183B   23                     INX   h   
183C   7E                     MOV   a,m   ; A = outer frame (val_hi)
183D   32 B0 18               STA   sendb_block_outer   
1840                             ; 
1840                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
1840   3A AB 18               LDA   sendb_reg_a   
1843   06 01                  MVI   b,FRAME_KIND_ITERATE   
1845   3A B0 18               LDA   sendb_block_outer   
1848   4F                     MOV   c,a   
1849   3A AB 18               LDA   sendb_reg_a   
184C   CD A4 16               CALL   push_frame   
184F                             ; 
184F                             ; フレームに limit を設定
184F                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
184F   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
1852   11 08 00               LXI   d,FRAME_OFF_LIMIT   
1855   19                     DAD   d   ; HL = &limit
1856   C1                     POP   b   ; BC = limit (ここで復帰)
1857   71                     MOV   m,c   ; limit_lo
1858   23                     INX   h   
1859   70                     MOV   m,b   ; limit_hi
185A                             ; 
185A                             ; ブロック引数 R[1] = 0 (初期カウンタ)
185A                             ; R[1] は新しい reg_base から見た R[1]
185A   3E 01                  MVI   a,1   
185C   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
185F   06 00                  MVI   b,0   
1861   0E 00                  MVI   c,0   
1863   CD 10 10               CALL   set_slot_int16   ; R[1] = 0
1866                             ; 
1866                             ; 子 irep に切り替え
1866   3A AF 18               LDA   sendb_block_irep   
1869   CD 29 17               CALL   switch_irep   
186C                             ; 
186C                             ; PC = 0
186C   21 00 00               LXI   h,0   
186F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1872   C3 8B 1B               JMP   vm_loop   
1875                             ; 
1875                             ; --- loop ---
1875                SENDB_LOOP:      
1875                             ; ブロックの位置: R[a + argc + 1]
1875   3A AD 18               LDA   sendb_argc   
1878   3C                     INR   a   
1879   47                     MOV   b,a   
187A   3A AB 18               LDA   sendb_reg_a   
187D   80                     ADD   b   ; A = a + argc + 1
187E   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1881   CD 32 10               CALL   slot_to_value   
1884   7E                     MOV   a,m   ; irep 番号
1885   32 AF 18               STA   sendb_block_irep   
1888   23                     INX   h   
1889   7E                     MOV   a,m   ; outer
188A   32 B0 18               STA   sendb_block_outer   
188D                             ; 
188D                             ; push_frame(a, FRAME_KIND_LOOP, outer)
188D   3A AB 18               LDA   sendb_reg_a   
1890   06 04                  MVI   b,FRAME_KIND_LOOP   
1892   3A B0 18               LDA   sendb_block_outer   
1895   4F                     MOV   c,a   
1896   3A AB 18               LDA   sendb_reg_a   
1899   CD A4 16               CALL   push_frame   
189C                             ; 
189C                             ; 子 irep に切り替え
189C   3A AF 18               LDA   sendb_block_irep   
189F   CD 29 17               CALL   switch_irep   
18A2                             ; 
18A2                             ; PC = 0
18A2   21 00 00               LXI   h,0   
18A5   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
18A8   C3 8B 1B               JMP   vm_loop   
18AB                             ; 
18AB                             ; OP_SENDB の一時変数
18AB   00           SENDB_REG_A:   DB   0   
18AC   00           SENDB_SYM_B:   DB   0   
18AD   00           SENDB_ARGC:   DB   0   
18AE   00           SENDB_METHOD_ID:   DB   0   
18AF   00           SENDB_BLOCK_IREP:   DB   0   
18B0   00           SENDB_BLOCK_OUTER:   DB   0   
18B1                             ; 
18B1                             ; ---------------------------------------------------------------
18B1                             ; OP_BREAK (B): ブロックから脱出
18B1                             ; 
18B1                             ; R[a] の値を R[0] にコピーして pop_frame。
18B1                             ; ---------------------------------------------------------------
18B1                DO_OP_BREAK:      
18B1   CD C0 10               CALL   fetch_byte   ; A = a
18B4                             ; R[a] → R[0] コピー
18B4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
18B7   E5                     PUSH   h   ; R[a] アドレス退避
18B8   3E 00                  MVI   a,0   
18BA   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
18BD   EB                     XCHG      ; DE = R[0]
18BE   E1                     POP   h   ; HL = R[a]
18BF   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
18C2                             ; 
18C2   CD FF 16               CALL   pop_frame   
18C5   C3 8B 1B               JMP   vm_loop   
18C8                             ; vm_upvar.a80 — 外側スコープの変数アクセス
18C8                             ; 
18C8                             ; OP_GETUPVAR, OP_SETUPVAR
18C8                             ; 
18C8                             ; ブロック内から外側のローカル変数にアクセスする。
18C8                             ; outer フレーム chain を level 段辿って reg_base を求める。
18C8                             ; 
18C8                             ; ---------------------------------------------------------------
18C8                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
18C8                             ; 
18C8                             ;   入力: A = level (何段外側か)
18C8                             ;   出力: HL = 外側スコープの reg_base アドレス
18C8                             ;   破壊: A, B, C, DE
18C8                             ; 
18C8                             ; outer chain を level 段辿る。FRAME_NONE に達したら
18C8                             ; REG_FILE_BASE (トップレベル) を返す。
18C8                             ; ---------------------------------------------------------------
18C8                UPVAR_BASE:      
18C8   47                     MOV   b,a   ; B = level (残り段数)
18C9                             ; まず現在のフレームの outer を読む
18C9   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
18CC   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
18CD   32 FF 18               STA   upvar_frame   
18D0                             ; 
18D0                             ; level == 0 なら outer chain を辿らずに
18D0                             ; 現在のフレームの return_reg_base をそのまま返す
18D0   78                     MOV   a,b   
18D1   B7                     ORA   a   
18D2   CA EC 18               JZ   upvar_found   
18D5                             ; 
18D5                UPVAR_LOOP:      
18D5                             ; outer フレーム番号を読む
18D5   3A FF 18               LDA   upvar_frame   
18D8   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
18DB   11 0A 00               LXI   d,FRAME_OFF_OUTER   
18DE   19                     DAD   d   
18DF   7E                     MOV   a,m   ; A = outer frame 番号
18E0                             ; 
18E0   FE FF                  CPI   FRAME_NONE   
18E2   CA FB 18               JZ   upvar_toplevel   ; トップレベルに達した
18E5                             ; 
18E5   32 FF 18               STA   upvar_frame   ; 次のフレーム
18E8                             ; 
18E8   05                     DCR   b   
18E9   C2 D5 18               JNZ   upvar_loop   ; まだ辿る段がある
18EC                             ; 
18EC                             ; level 回辿り終わった — upvar_frame の reg_base を返す
18EC                UPVAR_FOUND:      
18EC   3A FF 18               LDA   upvar_frame   
18EF   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
18F2   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
18F5   19                     DAD   d   
18F6   5E                     MOV   e,m   
18F7   23                     INX   h   
18F8   56                     MOV   d,m   ; DE = return_reg_base
18F9   EB                     XCHG      ; HL = return_reg_base
18FA   C9                     RET      
18FB                             ; 
18FB                UPVAR_TOPLEVEL:      
18FB   21 00 81               LXI   h,REG_FILE_BASE   
18FE   C9                     RET      
18FF                             ; 
18FF   00           UPVAR_FRAME:   DB   0   
1900                             ; 
1900                             ; ---------------------------------------------------------------
1900                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
1900                             ; 
1900                             ;   a = コピー先レジスタ
1900                             ;   b = 外側スコープのレジスタ番号
1900                             ;   c = level (何段外側か)
1900                             ; ---------------------------------------------------------------
1900                DO_OP_GETUPVAR:      
1900   CD C0 10               CALL   fetch_byte   ; A = a
1903   32 56 19               STA   upvar_reg_a   
1906   CD C0 10               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
1909   32 57 19               STA   upvar_reg_b   
190C   CD C0 10               CALL   fetch_byte   ; A = c (level)
190F                             ; 
190F                             ; 外側の reg_base を求める
190F   CD C8 18               CALL   upvar_base   ; HL = 外側の reg_base
1912                             ; 
1912                             ; 外側の R[b] のアドレス = base + b * 4
1912   3A 57 19               LDA   upvar_reg_b   
1915   87                     ADD   a   ; ×2
1916   87                     ADD   a   ; ×4
1917   85                     ADD   l   
1918   6F                     MOV   l,a   
1919   3E 00                  MVI   a,0   
191B   8C                     ADC   h   
191C   67                     MOV   h,a   ; HL = 外側の R[b]
191D                             ; 
191D                             ; R[a] にコピー
191D   E5                     PUSH   h   ; コピー元退避
191E   3A 56 19               LDA   upvar_reg_a   
1921   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1924   EB                     XCHG      ; DE = R[a] (コピー先)
1925   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
1926   CD 25 10               CALL   copy_slot   
1929   C3 8B 1B               JMP   vm_loop   
192C                             ; 
192C                             ; ---------------------------------------------------------------
192C                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
192C                             ; 
192C                             ;   a = コピー元レジスタ
192C                             ;   b = 外側スコープのレジスタ番号
192C                             ;   c = level (何段外側か)
192C                             ; ---------------------------------------------------------------
192C                DO_OP_SETUPVAR:      
192C   CD C0 10               CALL   fetch_byte   ; A = a
192F   32 56 19               STA   upvar_reg_a   
1932   CD C0 10               CALL   fetch_byte   ; A = b
1935   32 57 19               STA   upvar_reg_b   
1938   CD C0 10               CALL   fetch_byte   ; A = c (level)
193B                             ; 
193B                             ; 外側の reg_base を求める
193B   CD C8 18               CALL   upvar_base   ; HL = 外側の reg_base
193E                             ; 
193E                             ; 外側の R[b] のアドレス = base + b * 4
193E   3A 57 19               LDA   upvar_reg_b   
1941   87                     ADD   a   
1942   87                     ADD   a   
1943   85                     ADD   l   
1944   6F                     MOV   l,a   
1945   3E 00                  MVI   a,0   
1947   8C                     ADC   h   
1948   67                     MOV   h,a   ; HL = 外側の R[b]
1949   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
194A                             ; 
194A                             ; R[a] からコピー
194A   3A 56 19               LDA   upvar_reg_a   
194D   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1950   CD 25 10               CALL   copy_slot   
1953   C3 8B 1B               JMP   vm_loop   
1956                             ; 
1956   00           UPVAR_REG_A:   DB   0   
1957   00           UPVAR_REG_B:   DB   0   
1958                             ; vm_class.a80 — クラス・メソッド定義オペコード
1958                             ; 
1958                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
1958                             ; 
1958                             ; ---------------------------------------------------------------
1958                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
1958                             ; 
1958                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
1958                             ; クラス本体内ではそのクラス (TT_CLASS)。
1958                             ; ---------------------------------------------------------------
1958                DO_OP_TCLASS:      
1958   CD C0 10               CALL   fetch_byte   ; A = a
195B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
195E   EB                     XCHG      ; DE = R[a] (コピー先)
195F   3E 00                  MVI   a,0   
1961   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (コピー元)
1964   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
1967   C3 8B 1B               JMP   vm_loop   
196A                             ; 
196A                             ; ---------------------------------------------------------------
196A                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
196A                             ; 
196A                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
196A                             ; ではないため、外側フレームへの参照を持たない)。
196A                             ; ---------------------------------------------------------------
196A                DO_OP_METHOD:      
196A   CD C0 10               CALL   fetch_byte   ; A = a
196D   32 8A 19               STA   meth_reg_a   
1970   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1973   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1976   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1977                             ; 
1977   3A 8A 19               LDA   meth_reg_a   
197A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
197D   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
197F   23                     INX   h   
1980   36 00                  MVI   m,0   ; +1: 予約
1982   23                     INX   h   
1983   71                     MOV   m,c   ; +2: val_lo = irep 番号
1984   23                     INX   h   
1985   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
1987   C3 8B 1B               JMP   vm_loop   
198A                             ; 
198A   00           METH_REG_A:   DB   0   
198B                             ; 
198B                             ; ---------------------------------------------------------------
198B                             ; OP_DEF (BB): メソッド表に登録
198B                             ; 
198B                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
198B                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
198B                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
198B                             ; 
198B                             ; method_table[class_number * 32 + method_id] = irep 番号
198B                             ; ---------------------------------------------------------------
198B                DO_OP_DEF:      
198B   CD C0 10               CALL   fetch_byte   ; A = a
198E   32 EF 19               STA   def_reg_a   
1991   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1994                             ; 
1994                             ; シンボルテーブルから method_id を取得
1994   87                     ADD   a   ; ×2
1995   5F                     MOV   e,a   
1996   16 00                  MVI   d,0   
1998   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
199B   19                     DAD   d   ; HL = &sym_table[b]
199C   5E                     MOV   e,m   ; E = method_id (下位)
199D   23                     INX   h   
199E   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
199F                             ; 種別チェックは省略 (バイトコードツールが保証)
199F                             ; 
199F                             ; method_id を退避
199F   7B                     MOV   a,e   
19A0   32 F0 19               STA   def_method_id   
19A3                             ; 
19A3                             ; R[a] から class_number を取得
19A3   3A EF 19               LDA   def_reg_a   
19A6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19A9   CD 9B 10               CALL   class_of_reg   ; A = class_number
19AC                             ; 
19AC                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
19AC                             ; A * 32
19AC   87                     ADD   a   ; ×2
19AD   87                     ADD   a   ; ×4
19AE   87                     ADD   a   ; ×8
19AF   87                     ADD   a   ; ×16
19B0   87                     ADD   a   ; ×32
19B1   5F                     MOV   e,a   
19B2   16 00                  MVI   d,0   
19B4   21 C0 91               LXI   h,METHOD_TABLE_BASE   
19B7   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
19B8   3A F0 19               LDA   def_method_id   
19BB   5F                     MOV   e,a   
19BC   16 00                  MVI   d,0   
19BE   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
19BF                             ; 
19BF                             ; R[a+1].val_lo = irep 番号
19BF   3A EF 19               LDA   def_reg_a   
19C2   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
19C5   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
19C8   7E                     MOV   a,m   ; A = val_lo = irep 番号
19C9                             ; 
19C9                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
19C9   32 F1 19               STA   def_irep_num   
19CC   3A EF 19               LDA   def_reg_a   
19CF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19D2   CD 9B 10               CALL   class_of_reg   ; A = class_number
19D5   87                     ADD   a   
19D6   87                     ADD   a   
19D7   87                     ADD   a   
19D8   87                     ADD   a   
19D9   87                     ADD   a   ; A = class * 32
19DA   5F                     MOV   e,a   
19DB   16 00                  MVI   d,0   
19DD   21 C0 91               LXI   h,METHOD_TABLE_BASE   
19E0   19                     DAD   d   
19E1   3A F0 19               LDA   def_method_id   
19E4   5F                     MOV   e,a   
19E5   16 00                  MVI   d,0   
19E7   19                     DAD   d   ; HL = メソッド表エントリ
19E8   3A F1 19               LDA   def_irep_num   
19EB   77                     MOV   m,a   ; method_table[...] = irep 番号
19EC   C3 8B 1B               JMP   vm_loop   
19EF                             ; 
19EF   00           DEF_REG_A:   DB   0   
19F0   00           DEF_METHOD_ID:   DB   0   
19F1   00           DEF_IREP_NUM:   DB   0   
19F2                             ; 
19F2                             ; ---------------------------------------------------------------
19F2                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
19F2                             ; 
19F2                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
19F2                             ; ---------------------------------------------------------------
19F2                DO_OP_CLASS:      
19F2                             ; **クラス名と利用者の定数が同じ命令で来ます。** `Counter.new` の `Counter` も
19F2                             ; `LIMIT` も OP_GETCONST なので、シンボルテーブルの種別で分けます。
19F2                             ; ホスト側は `OP_CLASS` に出てきた名前だけをクラスとして登録するので、
19F2                             ; 残りは定数です (tools/i8080_bytecode_hex.rb)。
19F2                             ; 
19F2                             ; 定数はグローバル変数と同じ 4 バイトのスロットに置いてあるので、
19F2                             ; **写しは do_op_getgv の続き (getgv_ok) に合流させます。** 同じ並びを
19F2                             ; 2 か所に書くと、片方だけ直して食い違います。
19F2                DO_OP_GETCONST:      
19F2   CD C0 10               CALL   fetch_byte   ; A = a
19F5   F5                     PUSH   psw   
19F6   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
19F9                             ; 
19F9                             ; シンボルテーブルのエントリを取る
19F9   87                     ADD   a   ; ×2
19FA   5F                     MOV   e,a   
19FB   16 00                  MVI   d,0   
19FD   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1A00   19                     DAD   d   ; HL = &sym_table[b]
1A01   5E                     MOV   e,m   
1A02   23                     INX   h   
1A03   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
1A04                             ; 
1A04   7A                     MOV   a,d   
1A05   FE 02                  CPI   SYM_KIND_CLASS   
1A07   CA 13 1A               JZ   getconst_class   
1A0A                             ; 
1A0A                             ; 利用者の定数。DE がグローバルスロットのアドレス
1A0A   7A                     MOV   a,d   
1A0B   B3                     ORA   e   
1A0C   C2 EB 13               JNZ   getgv_ok   ; do_op_getgv の続きへ (a はスタックにある)
1A0F   F1                     POP   psw   
1A10   C3 03 00               JMP   vm_error   ; クラスでも定数でもない
1A13                             ; 
1A13                GETCONST_CLASS:      
1A13   F1                     POP   psw   ; A = a
1A14   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A17   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
1A19   23                     INX   h   
1A1A   36 00                  MVI   m,0   ; +1: 予約
1A1C   23                     INX   h   
1A1D   73                     MOV   m,e   ; +2: val_lo = class_number
1A1E   23                     INX   h   
1A1F   36 00                  MVI   m,0   ; +3: val_hi = 0
1A21   C3 8B 1B               JMP   vm_loop   
1A24                             ; 
1A24                             ; ---------------------------------------------------------------
1A24                             ; OP_EXEC (BB): クラス本体を実行
1A24                             ; 
1A24                             ; push_frame して子 irep に切り替える。
1A24                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
1A24                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
1A24                             ; ---------------------------------------------------------------
1A24                DO_OP_EXEC:      
1A24   CD C0 10               CALL   fetch_byte   ; A = a
1A27   32 4C 1A               STA   exec_reg_a   
1A2A   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1A2D   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1A30   32 4D 1A               STA   exec_irep   
1A33                             ; 
1A33                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
1A33   3A 4C 1A               LDA   exec_reg_a   
1A36   06 00                  MVI   b,FRAME_KIND_CALL   
1A38   0E FF                  MVI   c,FRAME_NONE   
1A3A   CD A4 16               CALL   push_frame   
1A3D                             ; 
1A3D                             ; 子 irep に切り替え
1A3D   3A 4D 1A               LDA   exec_irep   
1A40   CD 29 17               CALL   switch_irep   
1A43                             ; 
1A43                             ; PC = 0
1A43   21 00 00               LXI   h,0   
1A46   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1A49   C3 8B 1B               JMP   vm_loop   
1A4C                             ; 
1A4C   00           EXEC_REG_A:   DB   0   
1A4D   00           EXEC_IREP:   DB   0   
1A4E                             ; vm_display.a80 — 7 セグメント表示
1A4E                             ; 
1A4E                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
1A4E                             ; 上位 4 桁はブランク（消灯）にする。
1A4E                             ; セグメントパターンは seg_table にまとめる。
1A4E                             ; 
1A4E                             ; ---------------------------------------------------------------
1A4E                             ; display_hex16 — 16 ビット値を 7 セグに表示
1A4E                             ; 
1A4E                             ;   入力: HL = 値の先頭 (val_lo の位置)
1A4E                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
1A4E                             ;   破壊: A, B, C, HL, DE
1A4E                             ; 
1A4E                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
1A4E                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
1A4E                             ; ---------------------------------------------------------------
1A4E                DISPLAY_HEX16:      
1A4E   E5                     PUSH   h   ; 値のアドレスを退避
1A4F                             ; 上位 4 桁をブランク (消灯) にする
1A4F   11 F8 FF               LXI   d,DISPLAY_BASE   
1A52   AF                     XRA   a   ; A = 0 (全セグメント消灯)
1A53   12                     STAX   d   
1A54   13                     INX   d   
1A55   12                     STAX   d   
1A56   13                     INX   d   
1A57   12                     STAX   d   
1A58   13                     INX   d   
1A59   12                     STAX   d   
1A5A   13                     INX   d   ; DE = DISPLAY_BASE + 4
1A5B                             ; 値の byte1 (val_hi) から表示
1A5B   E1                     POP   h   ; HL = val_lo
1A5C   23                     INX   h   ; HL = val_hi
1A5D   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
1A5F                DISPLAY_BYTE_LOOP:      
1A5F                             ; 上位ニブル
1A5F   7E                     MOV   a,m   
1A60   0F                     RRC      
1A61   0F                     RRC      
1A62   0F                     RRC      
1A63   0F                     RRC      
1A64   E6 0F                  ANI   0Fh   
1A66   CD 79 1A               CALL   nibble_to_seg   
1A69   12                     STAX   d   
1A6A   13                     INX   d   
1A6B                             ; 下位ニブル
1A6B   7E                     MOV   a,m   
1A6C   E6 0F                  ANI   0Fh   
1A6E   CD 79 1A               CALL   nibble_to_seg   
1A71   12                     STAX   d   
1A72   13                     INX   d   
1A73                             ; 次のバイト (val_hi → val_lo)
1A73   2B                     DCX   h   
1A74   0D                     DCR   c   
1A75   C2 5F 1A               JNZ   display_byte_loop   
1A78   C9                     RET      
1A79                             ; 
1A79                             ; ---------------------------------------------------------------
1A79                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
1A79                             ; 
1A79                             ;   入力: A = 0-F
1A79                             ;   出力: A = セグメントパターン
1A79                             ;   破壊: なし (HL, BC は内部で退避・復元)
1A79                             ; ---------------------------------------------------------------
1A79                NIBBLE_TO_SEG:      
1A79   E5                     PUSH   h   
1A7A   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
1A7B   6F                     MOV   l,a   
1A7C   26 00                  MVI   h,0   
1A7E   01 86 1A               LXI   b,seg_table   
1A81   09                     DAD   b   ; HL = seg_table + nibble
1A82   7E                     MOV   a,m   
1A83   C1                     POP   b   ; BC を復元
1A84   E1                     POP   h   
1A85   C9                     RET      
1A86                             ; 
1A86                             ; ---------------------------------------------------------------
1A86                             ; 7 セグメントパターンテーブル
1A86                             ; 
1A86                             ;   bit 0 = a (上)
1A86                             ;   bit 1 = b (右上)
1A86                             ;   bit 2 = c (右下)
1A86                             ;   bit 3 = d (下)
1A86                             ;   bit 4 = e (左下)
1A86                             ;   bit 5 = f (左上)
1A86                             ;   bit 6 = g (中)
1A86                             ; 
1A86                             ;       aaa
1A86                             ;      f   b
1A86                             ;       ggg
1A86                             ;      e   c
1A86                             ;       ddd
1A86                             ; ---------------------------------------------------------------
1A86                SEG_TABLE:      
1A86   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
1A87   06                     DB   06h   ; 1
1A88   5B                     DB   5Bh   ; 2
1A89   4F                     DB   4Fh   ; 3
1A8A   66                     DB   66h   ; 4
1A8B   6D                     DB   6Dh   ; 5
1A8C   7D                     DB   7Dh   ; 6
1A8D   27                     DB   27h   ; 7  (ND8080 ROM パターン)
1A8E   7F                     DB   7Fh   ; 8
1A8F   6F                     DB   6Fh   ; 9
1A90   77                     DB   77h   ; A
1A91   7C                     DB   7Ch   ; b
1A92   39                     DB   39h   ; C
1A93   5E                     DB   5Eh   ; d
1A94   79                     DB   79h   ; E
1A95   71                     DB   71h   ; F
1A96                             ; 
1A96                             ; ===============================================================
1A96                             ; OP_RETURN (B): フレーム種別に応じて復帰
1A96                             ; 
1A96                             ; frame_sp == 0 → トップレベル: 表示して停止
1A96                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
1A96                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
1A96                             ; FRAME_KIND_ITERATE/LOOP → ブロック内: advance_iteration
1A96                             ; ===============================================================
1A96                DO_OP_RETURN:      
1A96   CD C0 10               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
1A99   32 E9 1A               STA   return_reg_a   
1A9C                             ; 
1A9C                             ; フレームスタックが空ならトップレベル
1A9C   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1A9F   B7                     ORA   a   
1AA0   CA D5 1A               JZ   do_op_return_top   
1AA3                             ; 
1AA3                             ; フレーム種別を確認
1AA3   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1AA6   11 05 00               LXI   d,FRAME_OFF_KIND   
1AA9   19                     DAD   d   
1AAA   7E                     MOV   a,m   ; A = kind
1AAB   FE 00                  CPI   FRAME_KIND_CALL   
1AAD   CA B8 1A               JZ   return_call   
1AB0   FE 05                  CPI   FRAME_KIND_NEW   
1AB2   CA CF 1A               JZ   return_new   
1AB5                             ; ITERATE / LOOP → advance_iteration
1AB5   C3 EA 1A               JMP   advance_iteration   
1AB8                             ; 
1AB8                RETURN_CALL:      
1AB8                             ; R[a] の値を R[0] にコピー
1AB8   3A E9 1A               LDA   return_reg_a   
1ABB   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1ABE   E5                     PUSH   h   
1ABF   3E 00                  MVI   a,0   
1AC1   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1AC4   EB                     XCHG      ; DE = R[0] (コピー先)
1AC5   E1                     POP   h   ; HL = R[a] (コピー元)
1AC6   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
1AC9   CD FF 16               CALL   pop_frame   
1ACC   C3 8B 1B               JMP   vm_loop   
1ACF                             ; 
1ACF                RETURN_NEW:      
1ACF                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
1ACF   CD FF 16               CALL   pop_frame   
1AD2   C3 8B 1B               JMP   vm_loop   
1AD5                             ; 
1AD5                DO_OP_RETURN_TOP:      
1AD5   3A E9 1A               LDA   return_reg_a   
1AD8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1ADB   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1ADE   CD 4E 1A               CALL   display_hex16   
1AE1   3E 02                  MVI   a,VM_FINISHED   
1AE3   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1AE6   C3 79 1B               JMP   vm_halt   
1AE9                             ; 
1AE9   00           RETURN_REG_A:   DB   0   
1AEA                             ; 
1AEA                             ; ===============================================================
1AEA                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
1AEA                             ; 
1AEA                             ; ITERATE (times): index++ して limit と比較。超えたら pop_frame。
1AEA                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
1AEA                             ; ===============================================================
1AEA                ADVANCE_ITERATION:      
1AEA                             ; フレーム種別を確認
1AEA   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1AED   11 05 00               LXI   d,FRAME_OFF_KIND   
1AF0   19                     DAD   d   
1AF1   7E                     MOV   a,m   ; A = kind
1AF2   FE 04                  CPI   FRAME_KIND_LOOP   
1AF4   CA 48 1B               JZ   adv_reenter   ; loop → 常に再実行
1AF7   32 57 1B               STA   adv_kind   ; kind を退避 (ITERATE or EACH)
1AFA                             ; 
1AFA                             ; --- ITERATE / EACH 共通: index インクリメント + limit チェック ---
1AFA   CD 9D 16               CALL   cur_frame_addr   
1AFD   11 06 00               LXI   d,FRAME_OFF_INDEX   
1B00   19                     DAD   d   
1B01   4E                     MOV   c,m   ; C = index_lo
1B02   23                     INX   h   
1B03   46                     MOV   b,m   ; B = index_hi
1B04   03                     INX   b   ; BC = index + 1
1B05                             ; 書き戻す
1B05   70                     MOV   m,b   ; index_hi
1B06   2B                     DCX   h   
1B07   71                     MOV   m,c   ; index_lo
1B08                             ; 
1B08                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
1B08   23                     INX   h   ; → &index_hi
1B09   23                     INX   h   ; → &limit_lo
1B0A   5E                     MOV   e,m   ; E = limit_lo
1B0B   23                     INX   h   ; → &limit_hi
1B0C   56                     MOV   d,m   ; D = limit_hi
1B0D                             ; 
1B0D                             ; BC = new index, DE = limit
1B0D                             ; index > limit なら反復終了 (DE - BC でボロー発生)
1B0D   7B                     MOV   a,e   
1B0E   91                     SUB   c   
1B0F   7A                     MOV   a,d   
1B10   98                     SBB   b   
1B11   DA 51 1B               JC   adv_done   ; index > limit → 反復終了
1B14                             ; 
1B14                             ; kind で R[1] の設定を分岐
1B14   3A 57 1B               LDA   adv_kind   
1B17   FE 02                  CPI   FRAME_KIND_EACH   
1B19   CA 27 1B               JZ   adv_each_load   
1B1C                             ; 
1B1C                             ; --- ITERATE (times): R[1] = index ---
1B1C   3E 01                  MVI   a,1   
1B1E   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
1B21   CD 10 10               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
1B24   C3 48 1B               JMP   adv_reenter   
1B27                             ; 
1B27                             ; --- EACH: R[1] = array[index] ---
1B27                ADV_EACH_LOAD:      
1B27                             ; BC = index を退避 (cur_frame_addr が BC を破壊するため)
1B27   C5                     PUSH   b   
1B28                             ; フレーム +11 からコレクションスロット番号を読む
1B28   CD 9D 16               CALL   cur_frame_addr   
1B2B   11 0B 00               LXI   d,11   
1B2E   19                     DAD   d   
1B2F   7E                     MOV   a,m   ; A = col_slot
1B30   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス
1B33   23                     INX   h   ; skip type
1B34   23                     INX   h   ; skip count → data
1B35   C1                     POP   b   ; BC = index (復帰)
1B36                             ; data + index * 4 (C = index_lo, 配列は最大 8 要素)
1B36   79                     MOV   a,c   
1B37   87                     ADD   a   ; ×2
1B38   87                     ADD   a   ; ×4
1B39   5F                     MOV   e,a   
1B3A   16 00                  MVI   d,0   
1B3C   19                     DAD   d   ; HL = &data[index*4] (source)
1B3D   E5                     PUSH   h   
1B3E   3E 01                  MVI   a,1   
1B40   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (dest)
1B43   EB                     XCHG      ; DE = R[1]
1B44   E1                     POP   h   ; HL = source
1B45   CD 25 10               CALL   copy_slot   ; R[1] = array[index]
1B48                             ; 
1B48                ADV_REENTER:      
1B48                             ; PC = 0 で再実行
1B48   21 00 00               LXI   h,0   
1B4B   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1B4E   C3 8B 1B               JMP   vm_loop   
1B51                             ; 
1B51                ADV_DONE:      
1B51                             ; 反復完了 → フレームを破棄して親に戻る
1B51   CD FF 16               CALL   pop_frame   
1B54   C3 8B 1B               JMP   vm_loop   
1B57                             ; 
1B57   00           ADV_KIND:   DB   0   
1B58                             ; 
1B58                             ; ===============================================================
1B58                             ; OP_STOP (Z): VM 停止
1B58                             ; ===============================================================
1B58                DO_OP_STOP:      
1B58   3E 02                  MVI   a,VM_FINISHED   
1B5A   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1B5D                             ; R[1] の値を 7 セグに表示
1B5D   3E 01                  MVI   a,1   
1B5F   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1B62   CD 32 10               CALL   slot_to_value   ; HL = R[1] の値先頭
1B65   CD 4E 1A               CALL   display_hex16   
1B68   C3 79 1B               JMP   vm_halt   
1B6B                             ; 
1B6B                             ; ===============================================================
1B6B                             ; エラー停止
1B6B                             ; 
1B6B                             ; 未対応のオペコードを踏んだとき。
1B6B                             ; 現在のオペコードをエラーコードとして保存する。
1B6B                             ; ===============================================================
1B6B                VM_ERROR:      
1B6B   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1B6E   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
1B71   3E 03                  MVI   a,VM_ERROR   
1B73   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1B76   C3 79 1B               JMP   vm_halt   
1B79                             ; 
1B79                             ; ===============================================================
1B79                             ; 停止 — ND80Z モニタのリモートモードへ復帰
1B79                             ; 
1B79                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
1B79                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
1B79                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
1B79                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
1B79                             ; これにより自動的にリモートモードへ復帰する。
1B79                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
1B79                             ; ===============================================================
1B79                VM_HALT:      
1B79                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
1B79                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
1B79                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
1B79   06 04                  MVI   b,4   
1B7B                VM_HALT_OUTER:      
1B7B   11 00 00               LXI   d,0   
1B7E                VM_HALT_INNER:      
1B7E   1B                     DCX   d   
1B7F   7A                     MOV   a,d   
1B80   B3                     ORA   e   
1B81   C2 7E 1B               JNZ   vm_halt_inner   
1B84   05                     DCR   b   
1B85   C2 7B 1B               JNZ   vm_halt_outer   
1B88   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
1B8B                             ; 
1B8B                             ; ===============================================================
1B8B                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
1B8B                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
1B8B                             ; ===============================================================
1B8B                             ; 
1B8B                             ; ===============================================================
1B8B                             ; メインループ (fetch-decode-execute)
1B8B                             ; ===============================================================
1B8B                VM_LOOP:      
1B8B                             ; --- 実行状態の確認 ---
1B8B   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
1B8E   FE 01                  CPI   VM_RUNNING   
1B90   C2 79 1B               JNZ   vm_halt   
1B93                             ; 
1B93                             ; --- PC がバイトコード長を超えていないか ---
1B93   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
1B96   EB                     XCHG      ; DE = PC
1B97   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
1B9A                             ; HL = bytecode_len, DE = PC
1B9A                             ; PC >= bytecode_len ならエラー
1B9A   7B                     MOV   a,e   
1B9B   95                     SUB   l   
1B9C   7A                     MOV   a,d   
1B9D   9C                     SBB   h   ; DE - HL (PC - len)
1B9E   D2 03 00               JNC   vm_error   ; PC >= len → エラー
1BA1                             ; 
1BA1                             ; --- オペコードフェッチ ---
1BA1   CD C0 10               CALL   fetch_byte   ; A = opcode
1BA4   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1BA7                             ; 
1BA7                             ; --- ステップカウント ---
1BA7   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1BAA   23                     INX   h   
1BAB   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1BAE                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
1BAE   7C                     MOV   a,h   
1BAF   B5                     ORA   l   
1BB0   C2 BA 1B               JNZ   vm_dispatch   
1BB3   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1BB6   23                     INX   h   
1BB7   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1BBA                             ; 
1BBA                             ; --- ディスパッチ ---
1BBA                VM_DISPATCH:      
1BBA   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1BBD                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
1BBD   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
1BBE   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
1BC1   5F                     MOV   e,a   
1BC2   16 00                  MVI   d,0   ; DE = opcode * 2
1BC4   21 DC 1B               LXI   h,dispatch_table   
1BC7   19                     DAD   d   ; HL = &dispatch_table[opcode]
1BC8                             ; テーブル上限チェック
1BC8   11 B0 1C               LXI   d,dispatch_table_end   
1BCB   7B                     MOV   a,e   
1BCC   95                     SUB   l   
1BCD   7A                     MOV   a,d   
1BCE   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
1BCF   DA 03 00               JC   vm_error   ; テーブル範囲外
1BD2                             ; アドレスを読んでジャンプ
1BD2   5E                     MOV   e,m   ; E = 下位バイト
1BD3   23                     INX   h   
1BD4   56                     MOV   d,m   ; D = 上位バイト
1BD5   EB                     XCHG      ; HL = ハンドラアドレス
1BD6                             ; 0000h ならエラー (未実装マーカー)
1BD6   7C                     MOV   a,h   
1BD7   B5                     ORA   l   
1BD8   CA 03 00               JZ   vm_error   
1BDB   E9                     PCHL      ; ハンドラへジャンプ
1BDC                             ; 
1BDC                             ; ===============================================================
1BDC                             ; ディスパッチテーブル
1BDC                             ; 
1BDC                             ; オペコード番号順に 2 バイトのアドレスを並べる。
1BDC                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
1BDC                             ; ===============================================================
1BDC                DISPATCH_TABLE:      
1BDC   DE 10                  DW   do_op_nop   ; 00 OP_NOP
1BDE   E1 10                  DW   do_op_move   ; 01 OP_MOVE
1BE0   00 00                  DW   0000h   ; 02 OP_LOADL
1BE2   F7 10                  DW   do_op_loadi   ; 03 OP_LOADI
1BE4   0C 11                  DW   do_op_loadineg   ; 04 OP_LOADINEG
1BE6   23 11                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
1BE8   33 11                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
1BEA   38 11                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
1BEC   3D 11                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
1BEE   42 11                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
1BF0   47 11                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
1BF2   4C 11                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
1BF4   51 11                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
1BF6   56 11                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
1BF8   66 11                  DW   do_op_loadi16   ; 0E OP_LOADI16
1BFA   00 00                  DW   0000h   ; 0F OP_LOADI32
1BFC   00 00                  DW   0000h   ; 10 OP_LOADSYM
1BFE   7F 11                  DW   do_op_loadnil   ; 11 OP_LOADNIL
1C00   69 17                  DW   do_op_loadself   ; 12 OP_LOADSELF
1C02   8D 11                  DW   do_op_loadt   ; 13 OP_LOADT
1C04   9B 11                  DW   do_op_loadf   ; 14 OP_LOADF
1C06   CA 13                  DW   do_op_getgv   ; 15 OP_GETGV
1C08   0C 14                  DW   do_op_setgv   ; 16 OP_SETGV
1C0A   00 00                  DW   0000h   ; 17 OP_GETSV
1C0C   00 00                  DW   0000h   ; 18 OP_SETSV
1C0E   CA 13                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
1C10   0C 14                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
1C12   CA 13                  DW   do_op_getgv   ; 1B OP_GETCV (= OP_GETGV)
1C14   0C 14                  DW   do_op_setgv   ; 1C OP_SETCV (= OP_SETGV)
1C16   F2 19                  DW   do_op_getconst   ; 1D OP_GETCONST
1C18   0C 14                  DW   do_op_setgv   ; 1E OP_SETCONST (= OP_SETGV)
1C1A   00 00                  DW   0000h   ; 1F OP_GETMCNST
1C1C   00 00                  DW   0000h   ; 20 OP_SETMCNST
1C1E   00 19                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
1C20   2C 19                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
1C22   DA 1F                  DW   do_op_getidx   ; 23 OP_GETIDX
1C24   81 20                  DW   do_op_setidx   ; 24 OP_SETIDX
1C26   83 13                  DW   do_op_jmp   ; 25 OP_JMP
1C28   8C 13                  DW   do_op_jmpif   ; 26 OP_JMPIF
1C2A   AB 13                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
1C2C   00 00                  DW   0000h   ; 28 OP_JMPNIL
1C2E   83 13                  DW   do_op_jmp   ; 29 OP_JMPUW (= OP_JMP)
1C30   00 00                  DW   0000h   ; 2A OP_EXCEPT
1C32   00 00                  DW   0000h   ; 2B OP_RESCUE
1C34   00 00                  DW   0000h   ; 2C OP_RAISEIF
1C36   6D 14                  DW   do_op_ssend   ; 2D OP_SSEND
1C38   B6 17                  DW   do_op_ssendb   ; 2E OP_SSENDB
1C3A   8E 14                  DW   do_op_send   ; 2F OP_SEND
1C3C   DC 17                  DW   do_op_sendb   ; 30 OP_SENDB
1C3E   00 00                  DW   0000h   ; 31 OP_CALL
1C40   00 00                  DW   0000h   ; 32 OP_SUPER
1C42   00 00                  DW   0000h   ; 33 OP_ARGARY
1C44   AA 17                  DW   do_op_enter   ; 34 OP_ENTER
1C46   00 00                  DW   0000h   ; 35 OP_KEY_P
1C48   00 00                  DW   0000h   ; 36 OP_KEYEND
1C4A   00 00                  DW   0000h   ; 37 OP_KARG
1C4C   96 1A                  DW   do_op_return   ; 38 OP_RETURN
1C4E   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
1C50   B1 18                  DW   do_op_break   ; 3A OP_BREAK
1C52   00 00                  DW   0000h   ; 3B OP_BLKPUSH
1C54   A9 11                  DW   do_op_add   ; 3C OP_ADD
1C56   EB 11                  DW   do_op_addi   ; 3D OP_ADDI
1C58   D3 11                  DW   do_op_sub   ; 3E OP_SUB
1C5A   05 12                  DW   do_op_subi   ; 3F OP_SUBI
1C5C   1F 12                  DW   do_op_mul   ; 40 OP_MUL
1C5E   43 12                  DW   do_op_div   ; 41 OP_DIV
1C60   22 13                  DW   do_op_eq   ; 42 OP_EQ
1C62   4C 13                  DW   do_op_lt   ; 43 OP_LT
1C64   56 13                  DW   do_op_le   ; 44 OP_LE
1C66   63 13                  DW   do_op_gt   ; 45 OP_GT
1C68   70 13                  DW   do_op_ge   ; 46 OP_GE
1C6A   37 21                  DW   do_op_array   ; 47 OP_ARRAY
1C6C   B1 23                  DW   do_op_array2   ; 48 OP_ARRAY2
1C6E   00 00                  DW   0000h   ; 49 OP_ARYCAT
1C70   B3 21                  DW   do_op_arypush   ; 4A OP_ARYPUSH
1C72   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
1C74   00 00                  DW   0000h   ; 4C OP_AREF
1C76   00 00                  DW   0000h   ; 4D OP_ASET
1C78   00 00                  DW   0000h   ; 4E OP_APOST
1C7A   00 00                  DW   0000h   ; 4F OP_INTERN
1C7C   00 00                  DW   0000h   ; 50 OP_SYMBOL
1C7E   38 1D                  DW   do_op_string   ; 51 OP_STRING
1C80   2B 22                  DW   do_op_strcat   ; 52 OP_STRCAT
1C82   C3 23                  DW   do_op_hash   ; 53 OP_HASH
1C84   00 00                  DW   0000h   ; 54 OP_HASHADD
1C86   00 00                  DW   0000h   ; 55 OP_HASHCAT
1C88   00 00                  DW   0000h   ; 56 OP_LAMBDA
1C8A   7D 17                  DW   do_op_block   ; 57 OP_BLOCK
1C8C   6A 19                  DW   do_op_method   ; 58 OP_METHOD
1C8E   00 00                  DW   0000h   ; 59 OP_RANGE_INC
1C90   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
1C92   00 00                  DW   0000h   ; 5B OP_OCLASS
1C94   F2 19                  DW   do_op_class   ; 5C OP_CLASS
1C96   00 00                  DW   0000h   ; 5D OP_MODULE
1C98   24 1A                  DW   do_op_exec   ; 5E OP_EXEC
1C9A   8B 19                  DW   do_op_def   ; 5F OP_DEF
1C9C   00 00                  DW   0000h   ; 60 OP_ALIAS
1C9E   00 00                  DW   0000h   ; 61 OP_UNDEF
1CA0   00 00                  DW   0000h   ; 62 OP_SCLASS
1CA2   58 19                  DW   do_op_tclass   ; 63 OP_TCLASS
1CA4   00 00                  DW   0000h   ; 64 OP_DEBUG
1CA6   00 00                  DW   0000h   ; 65 OP_ERR
1CA8   00 00                  DW   0000h   ; 66 OP_EXT1
1CAA   00 00                  DW   0000h   ; 67 OP_EXT2
1CAC   00 00                  DW   0000h   ; 68 OP_EXT3
1CAE   58 1B                  DW   do_op_stop   ; 69 OP_STOP
1CB0                DISPATCH_TABLE_END:      
1CB0                             ; 
1CB0                             ; ===============================================================
1CB0                             ; clear_pages — B ページ (256 バイト × B) をゼロクリア
1CB0                             ; 
1CB0                             ; 入力: HL = 先頭アドレス, B = ページ数
1CB0                             ; 破壊: A, B, C, HL
1CB0                             ; ===============================================================
1CB0                CLEAR_PAGES:      
1CB0   0E 00                  MVI   c,0   ; 256 回
1CB2                CLEAR_PAGES_BYTE:      
1CB2   36 00                  MVI   m,0   
1CB4   23                     INX   h   
1CB5   0D                     DCR   c   
1CB6   C2 B2 1C               JNZ   clear_pages_byte   
1CB9   05                     DCR   b   
1CBA   C2 B0 1C               JNZ   clear_pages   
1CBD   C9                     RET      
1CBE                             ; 
1CBE                             ; ===============================================================
1CBE                             ; 初期化 (起動時 1 回だけ)
1CBE                             ; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
1CBE                             ; ===============================================================
1CBE                VM_START:      
1CBE                             ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
1CBE   21 00 80               LXI   h,VM_STATE_BASE   
1CC1   06 01                  MVI   b,1   
1CC3   CD B0 1C               CALL   clear_pages   
1CC6                             ; 
1CC6                             ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
1CC6   21 00 81               LXI   h,REG_FILE_BASE   
1CC9   06 01                  MVI   b,1   
1CCB   CD B0 1C               CALL   clear_pages   
1CCE                             ; 
1CCE                             ; メソッド表をゼロクリア (256 バイト = 1 ページ)
1CCE   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1CD1   06 01                  MVI   b,1   
1CD3   CD B0 1C               CALL   clear_pages   
1CD6                             ; 
1CD6                             ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
1CD6   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1CD9   06 04                  MVI   b,4   
1CDB   CD B0 1C               CALL   clear_pages   
1CDE                             ; 
1CDE                             ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
1CDE   21 C0 96               LXI   h,COLLECTION_POOL_BASE   
1CE1   06 09                  MVI   b,9   
1CE3   CD B0 1C               CALL   clear_pages   
1CE6                             ; 
1CE6                             ; IREP 0 のバイトコード長を VM 状態に設定
1CE6                             ; IREP テーブルの先頭エントリから読む
1CE6   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
1CE9   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1CEC   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
1CEF   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1CF2                             ; 
1CF2                             ; レジスタベースを初期化 (REG_FILE_BASE)
1CF2   21 00 81               LXI   h,REG_FILE_BASE   
1CF5   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
1CF8                             ; 
1CF8                             ; バイトコードベースを IREP 0 から読んで設定
1CF8   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
1CFB   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1CFE   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
1D01   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1D04                             ; 
1D04                             ; シンボルテーブルベースを IREP 0 から読んで設定
1D04   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
1D07   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1D0A   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
1D0D   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1D10                             ; 
1D10                             ; 定数プールベースを IREP 0 から読んで設定
1D10   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
1D13   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1D16   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
1D19   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1D1C                             ; 
1D1C                             ; フレーム SP = 0 (ゼロクリア済み)
1D1C                             ; PC = 0 (ゼロクリア済み)
1D1C                             ; 
1D1C                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
1D1C                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
1D1C   3A FE 82               LDA   INIT_METHOD_ID_STORE   
1D1F   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
1D22                             ; 
1D22                             ; R[0] = self (TT_OBJECT, 値 = 0)
1D22   21 00 81               LXI   h,REG_FILE_BASE   
1D25   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1D27   23                     INX   h   
1D28   36 00                  MVI   m,0   ; +1: 予約
1D2A   23                     INX   h   
1D2B   36 00                  MVI   m,0   ; +2: val_lo
1D2D   23                     INX   h   
1D2E   36 00                  MVI   m,0   ; +3: val_hi
1D30                             ; 
1D30                             ; 実行状態を RUNNING に設定
1D30   3E 01                  MVI   a,VM_RUNNING   
1D32   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1D35                             ; 
1D35                             ; メインループへ
1D35   C3 8B 1B               JMP   vm_loop   
1D38                             ; 
1D38                             ; ===============================================================
1D38                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
1D38                             ; 
1D38                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
1D38                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
1D38                             ; ===============================================================
1D38                DO_OP_STRING:      
1D38   CD C0 10               CALL   fetch_byte   ; A = a
1D3B   32 95 1D               STA   ops_reg_a   
1D3E   CD C0 10               CALL   fetch_byte   ; A = b (プールインデックス)
1D41                             ; pool_base + b * 4 を計算
1D41   87                     ADD   a   ; b * 2
1D42   87                     ADD   a   ; b * 4
1D43   5F                     MOV   e,a   
1D44   16 00                  MVI   d,0   
1D46   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
1D49   19                     DAD   d   ; HL = &Pool[b]
1D4A                             ; Pool[b] の val (文字列データアドレス) を取得
1D4A   23                     INX   h   ; +1: 予約
1D4B   23                     INX   h   ; +2: val_lo
1D4C   5E                     MOV   e,m   
1D4D   23                     INX   h   ; +3: val_hi
1D4E   56                     MOV   d,m   ; DE = 文字列データアドレス
1D4F                             ; DE → 長さバイト + ASCII データ
1D4F   1A                     LDAX   d   ; A = 文字列長
1D50   32 96 1D               STA   ops_str_len   
1D53   13                     INX   d   ; DE → 最初のバイト
1D54   D5                     PUSH   d   ; 文字列データソース退避
1D55                             ; 
1D55                             ; コレクションスロットを確保
1D55   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
1D58   32 97 1D               STA   ops_slot_num   
1D5B                             ; 
1D5B                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
1D5B   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
1D5D   23                     INX   h   
1D5E   3A 96 1D               LDA   ops_str_len   
1D61   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
1D63   DA 68 1D               JC   ops_len_ok   
1D66   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
1D68                OPS_LEN_OK:      
1D68   77                     MOV   m,a   ; +1: count
1D69   32 96 1D               STA   ops_str_len   ; 切り詰め後の長さ
1D6C   23                     INX   h   ; HL → データ領域先頭
1D6D                             ; 
1D6D                             ; 文字列データをコピー
1D6D   D1                     POP   d   ; DE = ソースデータ
1D6E   3A 96 1D               LDA   ops_str_len   
1D71   B7                     ORA   a   
1D72   CA 7E 1D               JZ   ops_set_reg   ; 空文字列
1D75   4F                     MOV   c,a   
1D76                OPS_STR_COPY:      
1D76   1A                     LDAX   d   
1D77   77                     MOV   m,a   
1D78   23                     INX   h   
1D79   13                     INX   d   
1D7A   0D                     DCR   c   
1D7B   C2 76 1D               JNZ   ops_str_copy   
1D7E                             ; 
1D7E                OPS_SET_REG:      
1D7E                             ; R[a] = TT_STRING, val_lo = slot+1
1D7E   3A 95 1D               LDA   ops_reg_a   
1D81   CD 00 10               CALL   get_reg_addr   ; HL = &R[a]
1D84   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
1D86   23                     INX   h   
1D87   36 00                  MVI   m,0   ; +1: 予約
1D89   23                     INX   h   
1D8A   3A 97 1D               LDA   ops_slot_num   
1D8D   3C                     INR   a   ; slot + 1
1D8E   77                     MOV   m,a   ; +2: val_lo
1D8F   23                     INX   h   
1D90   36 00                  MVI   m,0   ; +3: val_hi
1D92   C3 8B 1B               JMP   vm_loop   
1D95                             ; 
1D95   00           OPS_REG_A:   DB   0   
1D96   00           OPS_STR_LEN:   DB   0   
1D97   00           OPS_SLOT_NUM:   DB   0   
1D98                             ; 
1D98                             ; ===============================================================
1D98                             ; send_display — display(value): 7 セグに hex 表示
1D98                             ; 
1D98                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
1D98                             ; R[a] に nil を返す。
1D98                             ; ===============================================================
1D98                SEND_DISPLAY:      
1D98   3A 55 16               LDA   send_reg_a   
1D9B   3C                     INR   a   
1D9C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1D9F   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1DA2   CD 4E 1A               CALL   display_hex16   ; 7 セグに書く
1DA5                             ; return nil
1DA5   3A 55 16               LDA   send_reg_a   
1DA8   CD 00 10               CALL   get_reg_addr   
1DAB   3E 01                  MVI   a,TT_NIL   
1DAD   CD 1A 10               CALL   set_slot_special   
1DB0   C3 8B 1B               JMP   vm_loop   
1DB3                             ; 
1DB3                             ; ===============================================================
1DB3                             ; send_getkey — getkey / getkey(timeout)
1DB3                             ; 
1DB3                             ; getkey (引数なし): KEYIN1 でブロッキング入力
1DB3                             ;   ROM なし → -1
1DB3                             ;   キー押下 → キーコード (0x00-0x17)
1DB3                             ; 
1DB3                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
1DB3                             ;   最大 n 回スキャン、キー押下 → キーコード
1DB3                             ;   タイムアウト / ROM なし → nil
1DB3                             ; 
1DB3                             ; キーコード割り当て (KEYIN1/KEY 共通):
1DB3                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
1DB3                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
1DB3                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
1DB3                             ;                                           0x17: LOAD
1DB3                             ; ===============================================================
1DB3                SEND_GETKEY:      
1DB3                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
1DB3   3A 56 16               LDA   send_argc   
1DB6   B7                     ORA   a   
1DB7   C2 32 25               JNZ   send_getkey_timeout   
1DBA                             ; 
1DBA                             ; --- ブロッキング版 (引数なし) ---
1DBA   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
1DBD   B7                     ORA   a   
1DBE   CA DE 1D               JZ   getkey_no_key   ; ROM なし → -1
1DC1                             ; 
1DC1                             ; キー入力をポーリングしながら LFSR を回す。
1DC1                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
1DC1                             ; 乱数の種が毎回異なる。
1DC1                GETKEY_POLL:      
1DC1   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
1DC4   FE FF                  CPI   0FFh   
1DC6   C2 CF 1D               JNZ   getkey_got_key   
1DC9   CD 4E 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
1DCC   C3 C1 1D               JMP   getkey_poll   
1DCF                             ; 
1DCF                GETKEY_GOT_KEY:      
1DCF                             ; キーコードを R[a] に返す
1DCF   4F                     MOV   c,a   
1DD0   06 00                  MVI   b,0   
1DD2   3A 55 16               LDA   send_reg_a   
1DD5   CD 00 10               CALL   get_reg_addr   
1DD8   CD 10 10               CALL   set_slot_int16   
1DDB   C3 8B 1B               JMP   vm_loop   
1DDE                             ; 
1DDE                GETKEY_NO_KEY:      
1DDE   3A 55 16               LDA   send_reg_a   
1DE1   CD 00 10               CALL   get_reg_addr   
1DE4   06 FF                  MVI   b,0FFh   
1DE6   0E FF                  MVI   c,0FFh   ; -1
1DE8   CD 10 10               CALL   set_slot_int16   
1DEB   C3 8B 1B               JMP   vm_loop   
1DEE                             ; 
1DEE                             ; ===============================================================
1DEE                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
1DEE                             ; 
1DEE                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
1DEE                             ; E レジスタにメソッド ID が入っている。
1DEE                             ; ===============================================================
1DEE                SEND_BUILTIN_EXT:      
1DEE   7B                     MOV   a,e   
1DEF   FE 1F                  CPI   METHOD_PUTS   
1DF1   CA 15 1E               JZ   send_puts   
1DF4   FE 20                  CPI   METHOD_SETSEG   
1DF6   CA B9 1E               JZ   send_setseg   
1DF9   FE 21                  CPI   METHOD_RAND   
1DFB   CA 73 1F               JZ   send_rand   
1DFE   FE 12                  CPI   METHOD_LENGTH   
1E00   CA A7 22               JZ   send_length   
1E03   FE 14                  CPI   METHOD_CONCAT   
1E05   CA C0 22               JZ   send_concat   
1E08   FE 16                  CPI   METHOD_PUSH   
1E0A   CA 7E 23               JZ   concat_array   ; push は concat_array と同じ
1E0D   FE 22                  CPI   METHOD_SLICE   
1E0F   CA 7B 25               JZ   send_slice   
1E12   C3 03 00               JMP   vm_error   ; 未対応メソッド
1E15                             ; 
1E15                             ; ===============================================================
1E15                             ; send_puts — puts(value): 文字列を 7 セグに表示
1E15                             ; 
1E15                             ; R[a+1] が TT_STRING の場合:
1E15                             ;   文字列データのアドレスから長さとバイト列を読み、
1E15                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
1E15                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
1E15                             ; 
1E15                             ; R[a+1] が TT_INTEGER の場合:
1E15                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
1E15                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
1E15                             ; 
1E15                             ; 使い方:
1E15                             ;   puts "HELLO"          # 文字列を表示
1E15                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
1E15                             ; ===============================================================
1E15                SEND_PUTS:      
1E15   3A 55 16               LDA   send_reg_a   
1E18   3C                     INR   a   
1E19   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1E1C   7E                     MOV   a,m   ; A = 型タグ
1E1D   FE 07                  CPI   TT_STRING   
1E1F   CA 59 1E               JZ   puts_string   
1E22                             ; TT_INTEGER: 従来のパック ASCII 処理
1E22   FE 04                  CPI   TT_INTEGER   
1E24   C2 03 00               JNZ   vm_error   
1E27                             ; 
1E27                             ; --- 整数パス (2 文字スクロール表示) ---
1E27   3A 55 16               LDA   send_reg_a   
1E2A   3C                     INR   a   
1E2B   CD 00 10               CALL   get_reg_addr   
1E2E   CD 32 10               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
1E31   4E                     MOV   c,m   ; C = val_lo (右の文字)
1E32   23                     INX   h   
1E33   46                     MOV   b,m   ; B = val_hi (左の文字)
1E34   C5                     PUSH   b   
1E35                             ; 
1E35                             ; 表示バッファを左に 2 桁スクロール
1E35   21 FA FF               LXI   h,DISPLAY_BASE + 2   
1E38   11 F8 FF               LXI   d,DISPLAY_BASE   
1E3B   06 06                  MVI   b,6   
1E3D                PUTS_SCROLL:      
1E3D   7E                     MOV   a,m   
1E3E   12                     STAX   d   
1E3F   23                     INX   h   
1E40   13                     INX   d   
1E41   05                     DCR   b   
1E42   C2 3D 1E               JNZ   puts_scroll   
1E45                             ; 
1E45   C1                     POP   b   
1E46   C5                     PUSH   b   
1E47   78                     MOV   a,b   
1E48   CD F2 1E               CALL   ascii_to_seg   
1E4B   32 FE FF               STA   DISPLAY_BASE + 6   
1E4E                             ; 
1E4E   C1                     POP   b   
1E4F   79                     MOV   a,c   
1E50   CD F2 1E               CALL   ascii_to_seg   
1E53   32 FF FF               STA   DISPLAY_BASE + 7   
1E56   C3 A6 1E               JMP   puts_ret_nil   
1E59                             ; 
1E59                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
1E59                PUTS_STRING:      
1E59   3A 55 16               LDA   send_reg_a   
1E5C   3C                     INR   a   
1E5D   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1E60   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロットアドレス
1E63                             ; 
1E63                             ; +1: count (文字列長)
1E63   23                     INX   h   
1E64   7E                     MOV   a,m   ; A = 文字列長
1E65   B7                     ORA   a   
1E66   CA A6 1E               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
1E69   FE 09                  CPI   9   
1E6B   DA 70 1E               JC   sp_len_ok   
1E6E   3E 08                  MVI   a,8   ; 最大 8 文字
1E70                SP_LEN_OK:      
1E70   32 B4 1E               STA   sp_count   
1E73   23                     INX   h   ; HL → データ領域先頭
1E74   22 B5 1E               SHLD   sp_src   ; 文字列ソースポインタ退避
1E77                             ; 
1E77                             ; 表示バッファ全体をクリア
1E77   21 F8 FF               LXI   h,DISPLAY_BASE   
1E7A   0E 08                  MVI   c,DISPLAY_SIZE   
1E7C                PUTS_STR_CLEAR:      
1E7C   36 00                  MVI   m,0   
1E7E   23                     INX   h   
1E7F   0D                     DCR   c   
1E80   C2 7C 1E               JNZ   puts_str_clear   
1E83                             ; 
1E83                             ; 文字列の各バイトを変換して表示
1E83   21 F8 FF               LXI   h,DISPLAY_BASE   
1E86   22 B7 1E               SHLD   sp_dst   ; 表示書き込みポインタ
1E89                PUTS_STR_LOOP:      
1E89   2A B5 1E               LHLD   sp_src   
1E8C   7E                     MOV   a,m   ; A = ASCII コード
1E8D   23                     INX   h   
1E8E   22 B5 1E               SHLD   sp_src   
1E91   CD F2 1E               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
1E94   2A B7 1E               LHLD   sp_dst   
1E97   77                     MOV   m,a   
1E98   23                     INX   h   
1E99   22 B7 1E               SHLD   sp_dst   
1E9C   3A B4 1E               LDA   sp_count   
1E9F   3D                     DCR   a   
1EA0   32 B4 1E               STA   sp_count   
1EA3   C2 89 1E               JNZ   puts_str_loop   
1EA6                             ; 
1EA6                PUTS_RET_NIL:      
1EA6   3A 55 16               LDA   send_reg_a   
1EA9   CD 00 10               CALL   get_reg_addr   
1EAC   3E 01                  MVI   a,TT_NIL   
1EAE   CD 1A 10               CALL   set_slot_special   
1EB1   C3 8B 1B               JMP   vm_loop   
1EB4                             ; 
1EB4   00           SP_COUNT:   DB   0   
1EB5   00 00        SP_SRC:   DW   0   
1EB7   00 00        SP_DST:   DW   0   
1EB9                             ; 
1EB9                             ; ===============================================================
1EB9                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
1EB9                             ; 
1EB9                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
1EB9                             ; ===============================================================
1EB9                SEND_SETSEG:      
1EB9                             ; 桁位置を取得
1EB9   3A 55 16               LDA   send_reg_a   
1EBC   3C                     INR   a   
1EBD   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1EC0   CD 32 10               CALL   slot_to_value   
1EC3   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
1EC4   FE 08                  CPI   DISPLAY_SIZE   
1EC6   D2 03 00               JNC   vm_error   ; 桁位置 >= 8 → エラー
1EC9   32 F1 1E               STA   ss_pos   
1ECC                             ; 
1ECC                             ; パターンを取得
1ECC   3A 55 16               LDA   send_reg_a   
1ECF   3C                     INR   a   
1ED0   3C                     INR   a   
1ED1   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
1ED4   CD 32 10               CALL   slot_to_value   
1ED7   46                     MOV   b,m   ; B = パターン (val_lo)
1ED8                             ; 
1ED8                             ; DISPLAY_BASE + pos にパターンを書く
1ED8   3A F1 1E               LDA   ss_pos   
1EDB   6F                     MOV   l,a   
1EDC   26 00                  MVI   h,0   
1EDE   11 F8 FF               LXI   d,DISPLAY_BASE   
1EE1   19                     DAD   d   ; HL = DISPLAY_BASE + pos
1EE2   70                     MOV   m,b   
1EE3                             ; 
1EE3                             ; R[a] に nil を返す
1EE3   3A 55 16               LDA   send_reg_a   
1EE6   CD 00 10               CALL   get_reg_addr   
1EE9   3E 01                  MVI   a,TT_NIL   
1EEB   CD 1A 10               CALL   set_slot_special   
1EEE   C3 8B 1B               JMP   vm_loop   
1EF1                             ; 
1EF1   00           SS_POS:   DB   0   
1EF2                             ; 
1EF2                             ; ===============================================================
1EF2                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
1EF2                             ; 
1EF2                             ;   入力: A = ASCII コード
1EF2                             ;   出力: A = セグメントパターン
1EF2                             ;   破壊: HL, BC
1EF2                             ; 
1EF2                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
1EF2                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
1EF2                             ; 範囲外はブランク (0x00) を返す。
1EF2                             ; ===============================================================
1EF2                ASCII_TO_SEG:      
1EF2   FE 60                  CPI   60h   
1EF4   DA F9 1E               JC   ats_no_fold   
1EF7   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
1EF9                ATS_NO_FOLD:      
1EF9   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
1EFB   DA 0C 1F               JC   ats_blank   ; 元が < 0x20 → ブランク
1EFE   FE 40                  CPI   40h   
1F00   D2 0C 1F               JNC   ats_blank   ; >= 64 → ブランク
1F03                             ; テーブル参照
1F03   6F                     MOV   l,a   
1F04   26 00                  MVI   h,0   
1F06   01 0E 1F               LXI   b,ascii_seg_table   
1F09   09                     DAD   b   ; HL = ascii_seg_table + index
1F0A   7E                     MOV   a,m   
1F0B   C9                     RET      
1F0C                ATS_BLANK:      
1F0C   AF                     XRA   a   ; A = 0 (ブランク)
1F0D   C9                     RET      
1F0E                             ; 
1F0E                             ; ===============================================================
1F0E                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
1F0E                             ; 
1F0E                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
1F0E                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
1F0E                             ; 
1F0E                             ; セグメント配置:
1F0E                             ;     aaa        bit 0 = a (上)
1F0E                             ;    f   b       bit 1 = b (右上)
1F0E                             ;     ggg        bit 2 = c (右下)
1F0E                             ;    e   c       bit 3 = d (下)
1F0E                             ;     ddd        bit 4 = e (左下)
1F0E                             ;                bit 5 = f (左上)
1F0E                             ;                bit 6 = g (中)
1F0E                             ; 
1F0E                             ; 表現できない文字は 0x00 (消灯)。
1F0E                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
1F0E                             ; ===============================================================
1F0E                ASCII_SEG_TABLE:      
1F0E                             ; 0x20-0x2F: 記号
1F0E   00                     DB   00h   ; 0x20 " " (スペース)
1F0F   06                     DB   06h   ; 0x21 "!" (bc)
1F10   22                     DB   22h   ; 0x22 """ (bf)
1F11   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
1F12   6D                     DB   6Dh   ; 0x24 "$" (= S)
1F13   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
1F14   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
1F15   02                     DB   02h   ; 0x27 "'" (b)
1F16   39                     DB   39h   ; 0x28 "(" (= C)
1F17   0F                     DB   0Fh   ; 0x29 ")" (abcd)
1F18   49                     DB   49h   ; 0x2A "*" (adg = 三)
1F19   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
1F1A   04                     DB   04h   ; 0x2C "," (c)
1F1B   40                     DB   40h   ; 0x2D "-" (g)
1F1C   08                     DB   08h   ; 0x2E "." (d)
1F1D   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
1F1E                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
1F1E   5C                     DB   5Ch   ; 0x30 "0"
1F1F   06                     DB   06h   ; 0x31 "1"
1F20   5B                     DB   5Bh   ; 0x32 "2"
1F21   4F                     DB   4Fh   ; 0x33 "3"
1F22   66                     DB   66h   ; 0x34 "4"
1F23   6D                     DB   6Dh   ; 0x35 "5"
1F24   7D                     DB   7Dh   ; 0x36 "6"
1F25   27                     DB   27h   ; 0x37 "7"
1F26   7F                     DB   7Fh   ; 0x38 "8"
1F27   6F                     DB   6Fh   ; 0x39 "9"
1F28                             ; 0x3A-0x40: 記号
1F28   09                     DB   09h   ; 0x3A ":" (ad)
1F29   00                     DB   00h   ; 0x3B ";"
1F2A   00                     DB   00h   ; 0x3C "<"
1F2B   48                     DB   48h   ; 0x3D "=" (dg)
1F2C   00                     DB   00h   ; 0x3E ">"
1F2D   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
1F2E   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
1F2F                             ; 0x41-0x5A: 英字
1F2F   77                     DB   77h   ; 0x41 "A" (abcefg)
1F30   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
1F31   39                     DB   39h   ; 0x43 "C" (adef)
1F32   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
1F33   79                     DB   79h   ; 0x45 "E" (adefg)
1F34   71                     DB   71h   ; 0x46 "F" (aefg)
1F35   3D                     DB   3Dh   ; 0x47 "G" (acdef)
1F36   76                     DB   76h   ; 0x48 "H" (bcefg)
1F37   06                     DB   06h   ; 0x49 "I" (bc)
1F38   1E                     DB   1Eh   ; 0x4A "J" (bcde)
1F39   74                     DB   74h   ; 0x4B "K" (cefg = h)
1F3A   38                     DB   38h   ; 0x4C "L" (def)
1F3B   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
1F3C   54                     DB   54h   ; 0x4E "N" (ceg = n)
1F3D   5C                     DB   5Ch   ; 0x4F "O" (= 0)
1F3E   73                     DB   73h   ; 0x50 "P" (abefg)
1F3F   67                     DB   67h   ; 0x51 "Q" (abcfg)
1F40   50                     DB   50h   ; 0x52 "R" (eg = r)
1F41   6D                     DB   6Dh   ; 0x53 "S" (= 5)
1F42   78                     DB   78h   ; 0x54 "T" (defg = t)
1F43   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
1F44   3E                     DB   3Eh   ; 0x56 "V" (= U)
1F45   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
1F46   76                     DB   76h   ; 0x58 "X" (bcefg = H)
1F47   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
1F48   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
1F49                             ; 0x5B-0x5F: 記号
1F49   39                     DB   39h   ; 0x5B "[" (= C)
1F4A   00                     DB   00h   ; 0x5C "\"
1F4B   0F                     DB   0Fh   ; 0x5D "]" (= ))
1F4C   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
1F4D   08                     DB   08h   ; 0x5F "_" (d)
1F4E                             ; 
1F4E                             ; ===============================================================
1F4E                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
1F4E                             ; 
1F4E                             ;   入力: なし
1F4E                             ;   出力: HL = 新しい乱数値
1F4E                             ;   破壊: A, HL
1F4E                             ; 
1F4E                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
1F4E                             ; 周期: 65535
1F4E                             ; ===============================================================
1F4E                LFSR_NEXT:      
1F4E   2A 71 1F               LHLD   lfsr_state   
1F51   7D                     MOV   a,l   
1F52   E6 01                  ANI   1   ; LSB チェック
1F54   CA 66 1F               JZ   lfsr_no_tap   
1F57                             ; LSB=1: 右シフト + XOR タップ
1F57   7C                     MOV   a,h   
1F58   B7                     ORA   a   ; CY=0 クリア
1F59   1F                     RAR      
1F5A   67                     MOV   h,a   
1F5B   7D                     MOV   a,l   
1F5C   1F                     RAR      
1F5D   6F                     MOV   l,a   
1F5E   7C                     MOV   a,h   
1F5F   EE B4                  XRI   0B4h   
1F61   67                     MOV   h,a   
1F62   22 71 1F               SHLD   lfsr_state   
1F65   C9                     RET      
1F66                LFSR_NO_TAP:      
1F66                             ; LSB=0: 右シフトのみ
1F66   7C                     MOV   a,h   
1F67   B7                     ORA   a   
1F68   1F                     RAR      
1F69   67                     MOV   h,a   
1F6A   7D                     MOV   a,l   
1F6B   1F                     RAR      
1F6C   6F                     MOV   l,a   
1F6D   22 71 1F               SHLD   lfsr_state   
1F70   C9                     RET      
1F71                             ; 
1F71   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
1F73                             ; 
1F73                             ; ===============================================================
1F73                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
1F73                             ; 
1F73                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
1F73                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
1F73                             ; ===============================================================
1F73                SEND_RAND:      
1F73                             ; R[a+1] から n を取得
1F73   3A 55 16               LDA   send_reg_a   
1F76   3C                     INR   a   
1F77   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1F7A   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1F7D   5E                     MOV   e,m   
1F7E   23                     INX   h   
1F7F   56                     MOV   d,m   ; DE = n
1F80                             ; 
1F80                             ; n == 0 チェック
1F80   7A                     MOV   a,d   
1F81   B3                     ORA   e   
1F82   CA 9D 1F               JZ   rand_zero   
1F85                             ; 
1F85   D5                     PUSH   d   ; n を退避
1F86   CD 4E 1F               CALL   lfsr_next   ; HL = 乱数
1F89   44                     MOV   b,h   
1F8A   4D                     MOV   c,l   ; BC = 乱数 (被除数)
1F8B   D1                     POP   d   ; DE = n (除数)
1F8C   CD A5 12               CALL   udiv16   ; BC=商, HL=剰余
1F8F                             ; 
1F8F                             ; HL (剰余) → BC → R[a]
1F8F   44                     MOV   b,h   
1F90   4D                     MOV   c,l   
1F91   3A 55 16               LDA   send_reg_a   
1F94   CD 00 10               CALL   get_reg_addr   
1F97   CD 10 10               CALL   set_slot_int16   
1F9A   C3 8B 1B               JMP   vm_loop   
1F9D                             ; 
1F9D                RAND_ZERO:      
1F9D   06 00                  MVI   b,0   
1F9F   0E 00                  MVI   c,0   
1FA1   3A 55 16               LDA   send_reg_a   
1FA4   CD 00 10               CALL   get_reg_addr   
1FA7   CD 10 10               CALL   set_slot_int16   
1FAA   C3 8B 1B               JMP   vm_loop   
1FAD                             ; 
1FAD                             ; ===============================================================
1FAD                             ; コレクションプール基盤ルーチン
1FAD                             ; ===============================================================
1FAD                             ; 
1FAD                             ; ---------------------------------------------------------------
1FAD                             ; col_slot_addr — スロット番号からアドレスを計算
1FAD                             ; 
1FAD                             ;   入力: A = スロット番号 (0-based)
1FAD                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
1FAD                             ;   破壊: A, DE
1FAD                             ; ---------------------------------------------------------------
1FAD                COL_SLOT_ADDR:      
1FAD                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
1FAD                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
1FAD   6F                     MOV   l,a   
1FAE   26 00                  MVI   h,0   ; HL = slot_number
1FB0   29                     DAD   h   ; HL = slot_number × 2
1FB1   29                     DAD   h   ; HL = slot_number × 4
1FB2   54                     MOV   d,h   
1FB3   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
1FB4   29                     DAD   h   ; HL = slot_number × 8
1FB5   29                     DAD   h   ; HL = slot_number × 16
1FB6   29                     DAD   h   ; HL = slot_number × 32
1FB7   19                     DAD   d   ; HL = slot_number × 36
1FB8   11 C0 96               LXI   d,COLLECTION_POOL_BASE   
1FBB   19                     DAD   d   
1FBC   C9                     RET      
1FBD                             ; 
1FBD                             ; ---------------------------------------------------------------
1FBD                             ; col_alloc — コレクションスロットを確保
1FBD                             ; 
1FBD                             ;   入力: なし
1FBD                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
1FBD                             ;   破壊: DE
1FBD                             ;   エラー: プール満杯かつ GC で回収不可 → vm_error
1FBD                             ; ---------------------------------------------------------------
1FBD                COL_ALLOC:      
1FBD   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
1FC0   FE 40                  CPI   MAX_COL_SLOTS   
1FC2   D2 28 26               JNC   col_gc_alloc   ; プール満杯 → GC 試行
1FC5   F5                     PUSH   psw   ; スロット番号を退避
1FC6   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス
1FC9                             ; COL_SP++
1FC9   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
1FCC   3C                     INR   a   
1FCD   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
1FD0   F1                     POP   psw   ; A = スロット番号
1FD1   C9                     RET      
1FD2                             ; 
1FD2                             ; ---------------------------------------------------------------
1FD2                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
1FD2                             ; 
1FD2                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
1FD2                             ;   出力: HL = コレクションスロットアドレス
1FD2                             ;   破壊: A, DE
1FD2                             ; ---------------------------------------------------------------
1FD2                COL_FROM_REG:      
1FD2   CD 32 10               CALL   slot_to_value   ; HL = val アドレス
1FD5   7E                     MOV   a,m   ; A = val_lo = slot+1
1FD6   3D                     DCR   a   ; A = slot_number (0-based)
1FD7   C3 AD 1F               JMP   col_slot_addr   
1FDA                             ; 
1FDA                             ; ===============================================================
1FDA                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
1FDA                             ; 
1FDA                             ; R[a] の型で分岐:
1FDA                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
1FDA                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
1FDA                             ; ===============================================================
1FDA                DO_OP_GETIDX:      
1FDA   CD C0 10               CALL   fetch_byte   ; A = a
1FDD   32 7D 20               STA   gidx_reg_a   
1FE0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1FE3   7E                     MOV   a,m   ; A = 型タグ
1FE4   FE 07                  CPI   TT_STRING   
1FE6   CA F6 1F               JZ   gidx_string   
1FE9   FE 08                  CPI   TT_ARRAY   
1FEB   CA 42 20               JZ   gidx_array   
1FEE   FE 09                  CPI   TT_HASH   
1FF0   CA 2F 24               JZ   gidx_hash   
1FF3   C3 03 00               JMP   vm_error   
1FF6                             ; 
1FF6                GIDX_STRING:      
1FF6                             ; R[a] のコレクションスロットを取得
1FF6   3A 7D 20               LDA   gidx_reg_a   
1FF9   CD 00 10               CALL   get_reg_addr   
1FFC   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
1FFF   23                     INX   h   ; +1: count
2000   46                     MOV   b,m   ; B = 文字列長
2001   23                     INX   h   ; HL → データ領域先頭
2002   22 7E 20               SHLD   gidx_data_addr   
2005                             ; 
2005                             ; R[a+1] からインデックスを取得
2005   3A 7D 20               LDA   gidx_reg_a   
2008   3C                     INR   a   
2009   CD 00 10               CALL   get_reg_addr   
200C   CD 32 10               CALL   slot_to_value   
200F   7E                     MOV   a,m   ; A = index (val_lo)
2010                             ; 範囲チェック: index < 文字列長
2010   B8                     CMP   b   
2011   D2 03 00               JNC   vm_error   ; index >= 長さ → エラー
2014                             ; データ先頭 + index で 1 文字を取得
2014   5F                     MOV   e,a   
2015   16 00                  MVI   d,0   
2017   2A 7E 20               LHLD   gidx_data_addr   
201A   19                     DAD   d   ; HL = &data[index]
201B   4E                     MOV   c,m   ; C = 文字コード
201C                             ; 
201C                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
201C   C5                     PUSH   b   ; C = 文字コード退避
201D   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2020   32 80 20               STA   gidx_new_slot   
2023   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2025   23                     INX   h   
2026   36 01                  MVI   m,1   ; +1: count = 1
2028   23                     INX   h   
2029   C1                     POP   b   
202A   71                     MOV   m,c   ; +2: data[0] = 文字コード
202B                             ; 
202B                             ; R[a] = TT_STRING, val_lo = new_slot+1
202B   3A 7D 20               LDA   gidx_reg_a   
202E   CD 00 10               CALL   get_reg_addr   
2031   36 07                  MVI   m,TT_STRING   
2033   23                     INX   h   
2034   36 00                  MVI   m,0   
2036   23                     INX   h   
2037   3A 80 20               LDA   gidx_new_slot   
203A   3C                     INR   a   
203B   77                     MOV   m,a   
203C   23                     INX   h   
203D   36 00                  MVI   m,0   
203F   C3 8B 1B               JMP   vm_loop   
2042                             ; 
2042                GIDX_ARRAY:      
2042                             ; R[a] のコレクションスロットを取得
2042   3A 7D 20               LDA   gidx_reg_a   
2045   CD 00 10               CALL   get_reg_addr   
2048   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
204B   23                     INX   h   ; +1: count
204C   46                     MOV   b,m   ; B = 要素数
204D   23                     INX   h   ; HL → データ領域先頭
204E   22 7E 20               SHLD   gidx_data_addr   
2051                             ; 
2051                             ; R[a+1] からインデックスを取得
2051   3A 7D 20               LDA   gidx_reg_a   
2054   3C                     INR   a   
2055   CD 00 10               CALL   get_reg_addr   
2058   CD 32 10               CALL   slot_to_value   
205B   7E                     MOV   a,m   ; A = index (val_lo)
205C                             ; 範囲チェック: index < 要素数
205C   B8                     CMP   b   
205D   D2 03 00               JNC   vm_error   
2060                             ; data + index * 4 で要素スロットの先頭を求める
2060   87                     ADD   a   ; ×2
2061   87                     ADD   a   ; ×4
2062   5F                     MOV   e,a   
2063   16 00                  MVI   d,0   
2065   2A 7E 20               LHLD   gidx_data_addr   
2068   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
2069   EB                     XCHG      ; DE = &data[index * 4]
206A                             ; 
206A                             ; R[a] にコピー (4 バイト)
206A   3A 7D 20               LDA   gidx_reg_a   
206D   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
2070   0E 04                  MVI   c,SLOT_BYTES   
2072                GIDX_ARY_COPY:      
2072   1A                     LDAX   d   
2073   77                     MOV   m,a   
2074   23                     INX   h   
2075   13                     INX   d   
2076   0D                     DCR   c   
2077   C2 72 20               JNZ   gidx_ary_copy   
207A   C3 8B 1B               JMP   vm_loop   
207D                             ; 
207D   00           GIDX_REG_A:   DB   0   
207E   00 00        GIDX_DATA_ADDR:   DW   0   
2080   00           GIDX_NEW_SLOT:   DB   0   
2081                             ; 
2081                             ; ===============================================================
2081                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
2081                             ; 
2081                             ; R[a] の型で分岐:
2081                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
2081                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
2081                             ; ===============================================================
2081                DO_OP_SETIDX:      
2081   CD C0 10               CALL   fetch_byte   ; A = a
2084   32 34 21               STA   sidx_reg_a   
2087   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
208A   7E                     MOV   a,m   ; A = 型タグ
208B   FE 07                  CPI   TT_STRING   
208D   CA 9D 20               JZ   sidx_string   
2090   FE 08                  CPI   TT_ARRAY   
2092   CA F7 20               JZ   sidx_array   
2095   FE 09                  CPI   TT_HASH   
2097   CA 97 24               JZ   sidx_hash   
209A   C3 03 00               JMP   vm_error   
209D                             ; 
209D                SIDX_STRING:      
209D                             ; R[a] のコレクションスロットを取得
209D   3A 34 21               LDA   sidx_reg_a   
20A0   CD 00 10               CALL   get_reg_addr   
20A3   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
20A6   23                     INX   h   ; +1: count
20A7   46                     MOV   b,m   ; B = 文字列長
20A8   23                     INX   h   ; HL → データ領域先頭
20A9   22 35 21               SHLD   sidx_data_addr   
20AC                             ; 
20AC                             ; R[a+1] からインデックスを取得
20AC   3A 34 21               LDA   sidx_reg_a   
20AF   3C                     INR   a   
20B0   CD 00 10               CALL   get_reg_addr   
20B3   CD 32 10               CALL   slot_to_value   
20B6   7E                     MOV   a,m   ; A = index
20B7   B8                     CMP   b   
20B8   D2 03 00               JNC   vm_error   ; index >= 長さ
20BB                             ; 
20BB                             ; data[index] に R[a+2] の文字を書き込む
20BB   5F                     MOV   e,a   
20BC   16 00                  MVI   d,0   
20BE   2A 35 21               LHLD   sidx_data_addr   
20C1   19                     DAD   d   ; HL = &data[index]
20C2                             ; 
20C2                             ; R[a+2] から文字コードを取得
20C2   3A 34 21               LDA   sidx_reg_a   
20C5   3C                     INR   a   
20C6   3C                     INR   a   
20C7   CD 00 10               CALL   get_reg_addr   
20CA                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
20CA   7E                     MOV   a,m   ; 型タグ
20CB   FE 07                  CPI   TT_STRING   
20CD   CA D7 20               JZ   sidx_str_char   
20D0                             ; TT_INTEGER: val_lo を文字コードとして使う
20D0   CD 32 10               CALL   slot_to_value   
20D3   7E                     MOV   a,m   
20D4   C3 DD 20               JMP   sidx_write_char   
20D7                SIDX_STR_CHAR:      
20D7                             ; TT_STRING: コレクションスロットの先頭文字
20D7   CD D2 1F               CALL   col_from_reg   
20DA   23                     INX   h   ; +1: count
20DB   23                     INX   h   ; +2: data[0]
20DC   7E                     MOV   a,m   
20DD                SIDX_WRITE_CHAR:      
20DD   2A 35 21               LHLD   sidx_data_addr   
20E0   5F                     MOV   e,a   ; E = 文字コード
20E1   3A 34 21               LDA   sidx_reg_a   
20E4   3C                     INR   a   
20E5   CD 00 10               CALL   get_reg_addr   
20E8   CD 32 10               CALL   slot_to_value   
20EB   7E                     MOV   a,m   ; A = index
20EC   4F                     MOV   c,a   
20ED   06 00                  MVI   b,0   
20EF   2A 35 21               LHLD   sidx_data_addr   
20F2   09                     DAD   b   ; HL = &data[index]
20F3   73                     MOV   m,e   ; 書き込み
20F4   C3 8B 1B               JMP   vm_loop   
20F7                             ; 
20F7                SIDX_ARRAY:      
20F7                             ; R[a] のコレクションスロットを取得
20F7   3A 34 21               LDA   sidx_reg_a   
20FA   CD 00 10               CALL   get_reg_addr   
20FD   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
2100   23                     INX   h   ; +1: count
2101   46                     MOV   b,m   ; B = 要素数
2102   23                     INX   h   ; HL → データ領域先頭
2103   22 35 21               SHLD   sidx_data_addr   
2106                             ; 
2106                             ; R[a+1] からインデックスを取得
2106   3A 34 21               LDA   sidx_reg_a   
2109   3C                     INR   a   
210A   CD 00 10               CALL   get_reg_addr   
210D   CD 32 10               CALL   slot_to_value   
2110   7E                     MOV   a,m   ; A = index
2111   B8                     CMP   b   
2112   D2 03 00               JNC   vm_error   
2115                             ; 
2115                             ; data[index * 4] に R[a+2] をコピー
2115   87                     ADD   a   ; ×2
2116   87                     ADD   a   ; ×4
2117   5F                     MOV   e,a   
2118   16 00                  MVI   d,0   
211A   2A 35 21               LHLD   sidx_data_addr   
211D   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
211E   EB                     XCHG      ; DE = コピー先
211F                             ; 
211F                             ; R[a+2] を取得 (コピー元)
211F   3A 34 21               LDA   sidx_reg_a   
2122   3C                     INR   a   
2123   3C                     INR   a   
2124   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
2127   0E 04                  MVI   c,SLOT_BYTES   
2129                SIDX_ARY_COPY:      
2129   7E                     MOV   a,m   
212A   12                     STAX   d   
212B   23                     INX   h   
212C   13                     INX   d   
212D   0D                     DCR   c   
212E   C2 29 21               JNZ   sidx_ary_copy   
2131   C3 8B 1B               JMP   vm_loop   
2134                             ; 
2134   00           SIDX_REG_A:   DB   0   
2135   00 00        SIDX_DATA_ADDR:   DW   0   
2137                             ; 
2137                             ; ===============================================================
2137                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
2137                             ; 
2137                             ; b 個のレジスタからコレクションプールに配列を構築する。
2137                             ; ===============================================================
2137                DO_OP_ARRAY:      
2137   CD C0 10               CALL   fetch_byte   ; A = a
213A   32 AE 21               STA   oary_reg_a   
213D   32 AF 21               STA   oary_src_reg   ; BB 形式: ソース = a
2140   CD C0 10               CALL   fetch_byte   ; A = b (要素数)
2143                OA2_JOIN:      ; OP_ARRAY2 からの合流点
2143   32 B0 21               STA   oary_count   
2146   B7                     ORA   a   
2147   CA A0 21               JZ   oary_empty   ; 空配列
214A                             ; 
214A                             ; 要素数チェック
214A   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
214C   D2 03 00               JNC   vm_error   ; 要素数 > 7
214F                             ; 
214F                             ; コレクションスロットを確保
214F   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2152   32 B1 21               STA   oary_slot_num   
2155   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
2157   23                     INX   h   
2158   3A B0 21               LDA   oary_count   
215B   77                     MOV   m,a   ; +1: count
215C   23                     INX   h   ; HL → データ領域先頭
215D   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
215E                             ; 
215E                             ; ソースレジスタから b 個のスロットをコピー
215E   3A AF 21               LDA   oary_src_reg   
2161   47                     MOV   b,a   ; B = 現在のレジスタ番号
2162   3A B0 21               LDA   oary_count   
2165   4F                     MOV   c,a   ; C = 残り要素数
2166                OARY_COPY_LOOP:      
2166   3E 04                  MVI   a,SLOT_BYTES   
2168   32 B2 21               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
216B   C5                     PUSH   b   
216C   D5                     PUSH   d   
216D   78                     MOV   a,b   
216E   CD 00 10               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
2171   D1                     POP   d   
2172                OARY_COPY_ELEM:      
2172   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
2173   23                     INX   h   
2174   78                     MOV   a,b   
2175   12                     STAX   d   
2176   13                     INX   d   
2177   E5                     PUSH   h   
2178   21 B2 21               LXI   h,oary_elem_cnt   
217B   35                     DCR   m   
217C   E1                     POP   h   
217D   C2 72 21               JNZ   oary_copy_elem   
2180   C1                     POP   b   
2181   04                     INR   b   ; 次のレジスタ
2182   0D                     DCR   c   
2183   CA 89 21               JZ   oary_done   
2186   C3 66 21               JMP   oary_copy_loop   
2189                             ; 
2189                OARY_DONE:      
2189                             ; R[a] = TT_ARRAY, val_lo = slot+1
2189   3A AE 21               LDA   oary_reg_a   
218C   CD 00 10               CALL   get_reg_addr   
218F   36 08                  MVI   m,TT_ARRAY   
2191   23                     INX   h   
2192   36 00                  MVI   m,0   
2194   23                     INX   h   
2195   3A B1 21               LDA   oary_slot_num   
2198   3C                     INR   a   
2199   77                     MOV   m,a   
219A   23                     INX   h   
219B   36 00                  MVI   m,0   
219D   C3 8B 1B               JMP   vm_loop   
21A0                             ; 
21A0                OARY_EMPTY:      
21A0                             ; 空配列: スロット確保して count=0
21A0   CD BD 1F               CALL   col_alloc   
21A3   32 B1 21               STA   oary_slot_num   
21A6   36 02                  MVI   m,COL_TYPE_ARRAY   
21A8   23                     INX   h   
21A9   36 00                  MVI   m,0   ; count = 0
21AB   C3 89 21               JMP   oary_done   
21AE                             ; 
21AE   00           OARY_REG_A:   DB   0   
21AF   00           OARY_SRC_REG:   DB   0   
21B0   00           OARY_COUNT:   DB   0   
21B1   00           OARY_SLOT_NUM:   DB   0   
21B2   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
21B3                             ; 
21B3                             ; ===============================================================
21B3                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
21B3                             ; 
21B3                             ; R[a] の配列の末尾に要素を追加する。
21B3                             ; ===============================================================
21B3                DO_OP_ARYPUSH:      
21B3   CD C0 10               CALL   fetch_byte   ; A = a
21B6   32 27 22               STA   apush_reg_a   
21B9   CD C0 10               CALL   fetch_byte   ; A = b (追加する要素数)
21BC   32 28 22               STA   apush_add_count   
21BF                             ; 
21BF                             ; R[a] のコレクションスロットを取得
21BF   3A 27 22               LDA   apush_reg_a   
21C2   CD 00 10               CALL   get_reg_addr   
21C5   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
21C8   23                     INX   h   ; +1: count
21C9   7E                     MOV   a,m   ; A = 現在の要素数
21CA   32 29 22               STA   apush_cur_count   
21CD                             ; 容量チェック: count + add_count <= MAX
21CD   3A 28 22               LDA   apush_add_count   
21D0   47                     MOV   b,a   
21D1   3A 29 22               LDA   apush_cur_count   
21D4   80                     ADD   b   
21D5   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
21D7   D2 03 00               JNC   vm_error   ; オーバーフロー
21DA                             ; 
21DA                             ; 書き込み先: data + count * 4
21DA   3A 29 22               LDA   apush_cur_count   
21DD   87                     ADD   a   ; ×2
21DE   87                     ADD   a   ; ×4
21DF   5F                     MOV   e,a   
21E0   16 00                  MVI   d,0   
21E2   23                     INX   h   ; HL → データ領域先頭
21E3   19                     DAD   d   ; HL = 書き込み位置
21E4   EB                     XCHG      ; DE = 書き込み位置
21E5                             ; 
21E5                             ; R[a+1] から b 個のスロットをコピー
21E5   3A 27 22               LDA   apush_reg_a   
21E8   3C                     INR   a   
21E9   47                     MOV   b,a   ; B = 現在のレジスタ番号
21EA   3A 28 22               LDA   apush_add_count   
21ED   4F                     MOV   c,a   ; C = 残り要素数
21EE                APUSH_LOOP:      
21EE   3E 04                  MVI   a,SLOT_BYTES   
21F0   32 2A 22               STA   apush_byte_cnt   ; 毎回初期化
21F3   C5                     PUSH   b   
21F4   D5                     PUSH   d   
21F5   78                     MOV   a,b   
21F6   CD 00 10               CALL   get_reg_addr   ; HL = R[reg]
21F9   D1                     POP   d   
21FA                APUSH_COPY:      
21FA   46                     MOV   b,m   
21FB   78                     MOV   a,b   
21FC   12                     STAX   d   
21FD   23                     INX   h   
21FE   13                     INX   d   
21FF   E5                     PUSH   h   
2200   21 2A 22               LXI   h,apush_byte_cnt   
2203   35                     DCR   m   
2204   E1                     POP   h   
2205   C2 FA 21               JNZ   apush_copy   
2208   C1                     POP   b   
2209   04                     INR   b   
220A   0D                     DCR   c   
220B   CA 11 22               JZ   apush_done   
220E   C3 EE 21               JMP   apush_loop   
2211                             ; 
2211                APUSH_DONE:      
2211                             ; count を更新
2211   3A 27 22               LDA   apush_reg_a   
2214   CD 00 10               CALL   get_reg_addr   
2217   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
221A   23                     INX   h   ; +1: count
221B   3A 29 22               LDA   apush_cur_count   
221E   47                     MOV   b,a   
221F   3A 28 22               LDA   apush_add_count   
2222   80                     ADD   b   
2223   77                     MOV   m,a   ; count = old + added
2224   C3 8B 1B               JMP   vm_loop   
2227                             ; 
2227   00           APUSH_REG_A:   DB   0   
2228   00           APUSH_ADD_COUNT:   DB   0   
2229   00           APUSH_CUR_COUNT:   DB   0   
222A   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
222B                             ; 
222B                             ; ===============================================================
222B                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
222B                             ; 
222B                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
222B                             ; ===============================================================
222B                DO_OP_STRCAT:      
222B   CD C0 10               CALL   fetch_byte   ; A = a
222E   32 A1 22               STA   scat_reg_a   
2231                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
2231                             ; 
2231                             ; R[a+1] のコレクションスロット (ソース)
2231   3C                     INR   a   
2232   CD 00 10               CALL   get_reg_addr   
2235   CD D2 1F               CALL   col_from_reg   ; HL = ソーススロット
2238   23                     INX   h   ; +1: count
2239   7E                     MOV   a,m   ; A = ソース文字列長
223A   32 A2 22               STA   scat_src_len   
223D   23                     INX   h   ; HL → データ先頭
223E   22 A5 22               SHLD   scat_src_data   
2241                             ; 
2241                             ; R[a] のコレクションスロット (デスト)
2241   3A A1 22               LDA   scat_reg_a   
2244   CD 00 10               CALL   get_reg_addr   
2247   CD D2 1F               CALL   col_from_reg   ; HL = デストスロット
224A   23                     INX   h   ; +1: count
224B   7E                     MOV   a,m   ; A = デスト文字列長
224C   32 A3 22               STA   scat_dst_len   
224F                             ; 
224F                             ; 合計長チェック
224F   3A A2 22               LDA   scat_src_len   
2252   47                     MOV   b,a   
2253   3A A3 22               LDA   scat_dst_len   
2256   80                     ADD   b   
2257   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2259   DA 71 22               JC   scat_len_ok   
225C                             ; 切り詰め: 追記できる分だけ
225C   3E 22                  MVI   a,COL_MAX_STRING_LEN   
225E   47                     MOV   b,a   
225F   3A A3 22               LDA   scat_dst_len   
2262   90                     SUB   b   ; この結果は負 (使わない)
2263   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2265   47                     MOV   b,a   
2266   3A A3 22               LDA   scat_dst_len   
2269   4F                     MOV   c,a   
226A   78                     MOV   a,b   
226B   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
226C   32 A2 22               STA   scat_src_len   
226F                             ; 合計を MAX に
226F   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2271                SCAT_LEN_OK:      
2271   32 A4 22               STA   scat_total_len   
2274                             ; 
2274                             ; デスト count を更新
2274   3A A1 22               LDA   scat_reg_a   
2277   CD 00 10               CALL   get_reg_addr   
227A   CD D2 1F               CALL   col_from_reg   
227D   23                     INX   h   
227E   3A A4 22               LDA   scat_total_len   
2281   77                     MOV   m,a   ; count = 合計長
2282   23                     INX   h   ; HL → データ先頭
2283                             ; 
2283                             ; デストデータ末尾 = data + dst_len
2283   3A A3 22               LDA   scat_dst_len   
2286   5F                     MOV   e,a   
2287   16 00                  MVI   d,0   
2289   19                     DAD   d   ; HL = 書き込み位置
228A                             ; 
228A                             ; ソースデータをコピー
228A   EB                     XCHG      ; DE = 書き込み位置
228B   2A A5 22               LHLD   scat_src_data   ; HL = ソースデータ
228E   3A A2 22               LDA   scat_src_len   
2291   B7                     ORA   a   
2292   CA 9E 22               JZ   scat_done   
2295   4F                     MOV   c,a   
2296                SCAT_COPY:      
2296   7E                     MOV   a,m   
2297   12                     STAX   d   
2298   23                     INX   h   
2299   13                     INX   d   
229A   0D                     DCR   c   
229B   C2 96 22               JNZ   scat_copy   
229E                             ; 
229E                SCAT_DONE:      
229E   C3 8B 1B               JMP   vm_loop   
22A1                             ; 
22A1   00           SCAT_REG_A:   DB   0   
22A2   00           SCAT_SRC_LEN:   DB   0   
22A3   00           SCAT_DST_LEN:   DB   0   
22A4   00           SCAT_TOTAL_LEN:   DB   0   
22A5   00 00        SCAT_SRC_DATA:   DW   0   
22A7                             ; 
22A7                             ; ===============================================================
22A7                             ; send_length — length / size: 文字列長・配列長を返す
22A7                             ; 
22A7                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
22A7                             ; ===============================================================
22A7                SEND_LENGTH:      
22A7   3A 55 16               LDA   send_reg_a   
22AA   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
22AD   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
22B0   23                     INX   h   ; +1: count
22B1   4E                     MOV   c,m   ; C = count
22B2   06 00                  MVI   b,0   ; BC = count (16-bit)
22B4   3A 55 16               LDA   send_reg_a   
22B7   CD 00 10               CALL   get_reg_addr   
22BA   CD 10 10               CALL   set_slot_int16   ; R[a] = count
22BD   C3 8B 1B               JMP   vm_loop   
22C0                             ; 
22C0                             ; ===============================================================
22C0                             ; send_concat — << (文字列追記 / 配列追加)
22C0                             ; 
22C0                             ; R[a] の型で分岐:
22C0                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
22C0                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
22C0                             ; ===============================================================
22C0                SEND_CONCAT:      
22C0   3A 55 16               LDA   send_reg_a   
22C3   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
22C6   7E                     MOV   a,m   ; A = 型タグ
22C7   FE 07                  CPI   TT_STRING   
22C9   CA D4 22               JZ   concat_string   
22CC   FE 08                  CPI   TT_ARRAY   
22CE   CA 7E 23               JZ   concat_array   
22D1   C3 03 00               JMP   vm_error   
22D4                             ; 
22D4                CONCAT_STRING:      
22D4                             ; R[a+1] の型を確認
22D4   3A 55 16               LDA   send_reg_a   
22D7   3C                     INR   a   
22D8   CD 00 10               CALL   get_reg_addr   
22DB   7E                     MOV   a,m   ; A = R[a+1] の型タグ
22DC   FE 07                  CPI   TT_STRING   
22DE   CA E9 22               JZ   concat_str_str   
22E1   FE 04                  CPI   TT_INTEGER   
22E3   CA 59 23               JZ   concat_str_int   
22E6   C3 03 00               JMP   vm_error   
22E9                             ; 
22E9                CONCAT_STR_STR:      
22E9                             ; R[a+1] のコレクションスロット (ソース)
22E9   3A 55 16               LDA   send_reg_a   
22EC   3C                     INR   a   
22ED   CD 00 10               CALL   get_reg_addr   
22F0   CD D2 1F               CALL   col_from_reg   ; HL = ソーススロット
22F3   23                     INX   h   ; +1: count
22F4   7E                     MOV   a,m   ; A = ソース文字列長
22F5   32 20 80               STA   cc_src_len   
22F8   23                     INX   h   ; HL → データ先頭
22F9   22 23 80               SHLD   cc_src_data   
22FC                             ; 
22FC                             ; R[a] のコレクションスロット (デスト)
22FC   3A 55 16               LDA   send_reg_a   
22FF   CD 00 10               CALL   get_reg_addr   
2302   CD D2 1F               CALL   col_from_reg   ; HL = デストスロット
2305   23                     INX   h   ; +1: count
2306   7E                     MOV   a,m   
2307   32 21 80               STA   cc_dst_len   
230A                             ; 
230A                             ; コピー可能バイト数を計算
230A   3A 20 80               LDA   cc_src_len   
230D   47                     MOV   b,a   
230E   3A 21 80               LDA   cc_dst_len   
2311   80                     ADD   b   
2312   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2314   DA 29 23               JC   cc_str_len_ok   
2317                             ; 切り詰め
2317   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2319   47                     MOV   b,a   
231A   3A 21 80               LDA   cc_dst_len   
231D   4F                     MOV   c,a   
231E   78                     MOV   a,b   
231F   91                     SUB   c   
2320   32 20 80               STA   cc_src_len   
2323   3A 21 80               LDA   cc_dst_len   
2326   87                     ADD   a   ; ここでは使わない — 合計は MAX
2327   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2329                CC_STR_LEN_OK:      
2329   32 22 80               STA   cc_total_len   
232C                             ; 
232C                             ; count を更新
232C   3A 55 16               LDA   send_reg_a   
232F   CD 00 10               CALL   get_reg_addr   
2332   CD D2 1F               CALL   col_from_reg   
2335   23                     INX   h   
2336   3A 22 80               LDA   cc_total_len   
2339   77                     MOV   m,a   
233A   23                     INX   h   ; HL → データ先頭
233B                             ; 
233B                             ; 書き込み位置 = data + dst_len
233B   3A 21 80               LDA   cc_dst_len   
233E   5F                     MOV   e,a   
233F   16 00                  MVI   d,0   
2341   19                     DAD   d   
2342                             ; 
2342                             ; コピー
2342   EB                     XCHG      
2343   2A 23 80               LHLD   cc_src_data   
2346   3A 20 80               LDA   cc_src_len   
2349   B7                     ORA   a   
234A   CA 56 23               JZ   cc_str_done   
234D   4F                     MOV   c,a   
234E                CC_STR_COPY:      
234E   7E                     MOV   a,m   
234F   12                     STAX   d   
2350   23                     INX   h   
2351   13                     INX   d   
2352   0D                     DCR   c   
2353   C2 4E 23               JNZ   cc_str_copy   
2356                CC_STR_DONE:      
2356                             ; R[a] をそのまま返す (破壊的操作)
2356   C3 8B 1B               JMP   vm_loop   
2359                             ; 
2359                CONCAT_STR_INT:      
2359                             ; R[a+1] の val_lo を 1 バイトとして追記
2359   3A 55 16               LDA   send_reg_a   
235C   3C                     INR   a   
235D   CD 00 10               CALL   get_reg_addr   
2360   CD 32 10               CALL   slot_to_value   
2363   4E                     MOV   c,m   ; C = 文字コード (val_lo)
2364                             ; 
2364                             ; R[a] のコレクションスロット
2364   3A 55 16               LDA   send_reg_a   
2367   CD 00 10               CALL   get_reg_addr   
236A   CD D2 1F               CALL   col_from_reg   ; HL = デストスロット
236D   23                     INX   h   ; +1: count
236E   7E                     MOV   a,m   
236F   FE 22                  CPI   COL_MAX_STRING_LEN   
2371   D2 8B 1B               JNC   vm_loop   ; 満杯なら何もしない
2374   34                     INR   m   ; count++
2375   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
2376   23                     INX   h   ; HL → データ先頭
2377   16 00                  MVI   d,0   
2379   19                     DAD   d   ; HL = &data[old_count]
237A   71                     MOV   m,c   ; 書き込み
237B   C3 8B 1B               JMP   vm_loop   
237E                             ; 
237E                CONCAT_ARRAY:      
237E                             ; R[a] のコレクションスロット
237E   3A 55 16               LDA   send_reg_a   
2381   CD 00 10               CALL   get_reg_addr   
2384   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
2387   23                     INX   h   ; +1: count
2388   7E                     MOV   a,m   
2389   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
238B   D2 03 00               JNC   vm_error   ; 満杯
238E   32 25 80               STA   cc_ary_count   
2391   34                     INR   m   ; count++
2392                             ; 
2392                             ; 書き込み位置: data + count * 4
2392   23                     INX   h   ; HL → データ先頭
2393   3A 25 80               LDA   cc_ary_count   
2396   87                     ADD   a   ; ×2
2397   87                     ADD   a   ; ×4
2398   5F                     MOV   e,a   
2399   16 00                  MVI   d,0   
239B   19                     DAD   d   ; HL = 書き込み位置
239C   EB                     XCHG      ; DE = 書き込み位置
239D                             ; 
239D                             ; R[a+1] をコピー
239D   3A 55 16               LDA   send_reg_a   
23A0   3C                     INR   a   
23A1   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
23A4   0E 04                  MVI   c,SLOT_BYTES   
23A6                CC_ARY_COPY:      
23A6   7E                     MOV   a,m   
23A7   12                     STAX   d   
23A8   23                     INX   h   
23A9   13                     INX   d   
23AA   0D                     DCR   c   
23AB   C2 A6 23               JNZ   cc_ary_copy   
23AE   C3 8B 1B               JMP   vm_loop   
23B1                             ; 
23B1                             ; --- concat 一時変数 ---
23B1                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
23B1                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
23B1                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
23B1                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
23B1                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
23B1                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
23B1                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
23B1                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
23B1                             ; 
23B1                             ; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
23B1                             ; 
23B1                             ; Hash スロット形式 (コレクションプール 36B スロット内):
23B1                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
23B1                             ;   +1: count (1B)  ペア数 (最大 4)
23B1                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
23B1                             ; 
23B1                             ; キー検索は線形 4 バイト比較。
23B1                             ; 
23B1                             ; ===============================================================
23B1                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
23B1                             ; 
23B1                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
23B1                             ; ===============================================================
23B1                DO_OP_ARRAY2:      
23B1   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
23B4   32 AE 21               STA   oary_reg_a   
23B7   CD C0 10               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
23BA   32 AF 21               STA   oary_src_reg   
23BD   CD C0 10               CALL   fetch_byte   ; A = c (要素数)
23C0   C3 43 21               JMP   oa2_join   
23C3                             ; 
23C3                             ; ===============================================================
23C3                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
23C3                             ; 
23C3                             ;   a = 書き込み先レジスタ
23C3                             ;   b = ペア数 (0 = 空 Hash)
23C3                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
23C3                             ; ===============================================================
23C3                DO_OP_HASH:      
23C3   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
23C6   32 2B 24               STA   hash_reg_a   
23C9   CD C0 10               CALL   fetch_byte   ; A = b (ペア数)
23CC   32 2C 24               STA   hash_count   
23CF                             ; 
23CF                             ; コレクションスロット確保
23CF   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
23D2   32 2D 24               STA   hash_slot_num   
23D5                             ; 
23D5                             ; ヘッダ書き込み
23D5   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
23D7   23                     INX   h   
23D8   3A 2C 24               LDA   hash_count   
23DB   77                     MOV   m,a   ; +1: count
23DC   23                     INX   h   ; HL → データ領域先頭
23DD                             ; 
23DD                             ; ペアがなければ結果書き込みへ
23DD   3A 2C 24               LDA   hash_count   
23E0   B7                     ORA   a   
23E1   CA 14 24               JZ   hash_write_result   
23E4                             ; 
23E4                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
23E4   3A 2B 24               LDA   hash_reg_a   
23E7   32 2E 24               STA   hash_src_reg   
23EA                             ; 
23EA                HASH_COPY_PAIR:      
23EA                             ; HL = コレクションプール内の書き込み位置
23EA                             ; key (4B) をコピー: R[src] → [HL]
23EA   E5                     PUSH   h   ; 書き込み先を退避
23EB   3A 2E 24               LDA   hash_src_reg   
23EE   CD 00 10               CALL   get_reg_addr   ; HL = R[src]
23F1   D1                     POP   d   ; DE = 書き込み先
23F2   CD 25 10               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
23F5                             ; DE = value 書き込み位置
23F5                             ; 
23F5                             ; value (4B) をコピー: R[src+1] → [DE]
23F5   D5                     PUSH   d   ; value 書き込み先を退避
23F6   3A 2E 24               LDA   hash_src_reg   
23F9   3C                     INR   a   
23FA   CD 00 10               CALL   get_reg_addr   ; HL = R[src+1]
23FD   D1                     POP   d   ; DE = value 書き込み先
23FE   CD 25 10               CALL   copy_slot   ; 4B コピー
2401                             ; DE = 次ペアの先頭
2401                             ; 
2401                             ; ソースレジスタを +2
2401   3A 2E 24               LDA   hash_src_reg   
2404   C6 02                  ADI   2   
2406   32 2E 24               STA   hash_src_reg   
2409                             ; 
2409                             ; HL = 次の書き込み位置 (DE から)
2409   EB                     XCHG      
240A                             ; 
240A                             ; ペアカウンタ
240A   3A 2C 24               LDA   hash_count   
240D   3D                     DCR   a   
240E   32 2C 24               STA   hash_count   
2411   C2 EA 23               JNZ   hash_copy_pair   
2414                             ; 
2414                HASH_WRITE_RESULT:      
2414                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
2414   3A 2B 24               LDA   hash_reg_a   
2417   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
241A   36 09                  MVI   m,TT_HASH   ; +0: type
241C   23                     INX   h   
241D   36 00                  MVI   m,0   ; +1: reserved
241F   23                     INX   h   
2420   3A 2D 24               LDA   hash_slot_num   
2423   3C                     INR   a   ; slot + 1
2424   77                     MOV   m,a   ; +2: val_lo
2425   23                     INX   h   
2426   36 00                  MVI   m,0   ; +3: val_hi
2428   C3 8B 1B               JMP   vm_loop   
242B                             ; 
242B                             ; --- do_op_hash データ ---
242B   00           HASH_REG_A:   DB   0   
242C   00           HASH_COUNT:   DB   0   
242D   00           HASH_SLOT_NUM:   DB   0   
242E   00           HASH_SRC_REG:   DB   0   
242F                             ; 
242F                             ; ===============================================================
242F                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
242F                             ; 
242F                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
242F                             ;   キーが見つからなければ R[a] = nil
242F                             ; ===============================================================
242F                GIDX_HASH:      
242F                             ; コレクションスロットを取得
242F   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
2432   23                     INX   h   ; +1: count
2433   7E                     MOV   a,m   ; A = ペア数
2434   23                     INX   h   ; HL → データ領域
2435   B7                     ORA   a   
2436   CA 82 24               JZ   ghash_not_found   ; 空 Hash
2439                             ; 
2439   32 96 24               STA   ghash_loop_cnt   
243C   22 90 24               SHLD   ghash_data_ptr   
243F                             ; 
243F                             ; 検索キー R[a+1] のアドレスを取得
243F   3A 7D 20               LDA   gidx_reg_a   
2442   3C                     INR   a   
2443   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2446   22 92 24               SHLD   ghash_key_ptr   
2449                             ; 
2449                             ; 検索ループ
2449   2A 90 24               LHLD   ghash_data_ptr   
244C                GHASH_SEARCH:      
244C   22 94 24               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
244F                             ; 
244F                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
244F   E5                     PUSH   h   
2450   2A 92 24               LHLD   ghash_key_ptr   
2453   EB                     XCHG      ; DE = 検索キー
2454   E1                     POP   h   ; HL = hash ペアのキー
2455                             ; 
2455   0E 04                  MVI   c,SLOT_BYTES   
2457                GHASH_CMP:      
2457   1A                     LDAX   d   
2458   BE                     CMP   m   
2459   C2 71 24               JNZ   ghash_next   
245C   23                     INX   h   
245D   13                     INX   d   
245E   0D                     DCR   c   
245F   C2 57 24               JNZ   ghash_cmp   
2462                             ; 
2462                             ; 一致! HL = value 位置 (キー直後)
2462                             ; value (4B) を R[a] にコピー
2462   E5                     PUSH   h   ; value ソース
2463   3A 7D 20               LDA   gidx_reg_a   
2466   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2469   EB                     XCHG      ; DE = R[a] (コピー先)
246A   E1                     POP   h   ; HL = value (コピー元)
246B   CD 25 10               CALL   copy_slot   
246E   C3 8B 1B               JMP   vm_loop   
2471                             ; 
2471                GHASH_NEXT:      
2471                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
2471   2A 94 24               LHLD   ghash_cur_ptr   
2474   11 08 00               LXI   d,HASH_PAIR_BYTES   
2477   19                     DAD   d   
2478   3A 96 24               LDA   ghash_loop_cnt   
247B   3D                     DCR   a   
247C   32 96 24               STA   ghash_loop_cnt   
247F   C2 4C 24               JNZ   ghash_search   
2482                             ; 
2482                GHASH_NOT_FOUND:      
2482                             ; R[a] = nil
2482   3A 7D 20               LDA   gidx_reg_a   
2485   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2488   3E 01                  MVI   a,TT_NIL   
248A   CD 1A 10               CALL   set_slot_special   
248D   C3 8B 1B               JMP   vm_loop   
2490                             ; 
2490                             ; --- gidx_hash データ ---
2490   00 00        GHASH_DATA_PTR:   DW   0   
2492   00 00        GHASH_KEY_PTR:   DW   0   
2494   00 00        GHASH_CUR_PTR:   DW   0   
2496   00           GHASH_LOOP_CNT:   DB   0   
2497                             ; 
2497                             ; ===============================================================
2497                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
2497                             ; 
2497                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
2497                             ;   既存キー → 値を上書き
2497                             ;   新規キー → count < MAX なら末尾に追加
2497                             ; ===============================================================
2497                SIDX_HASH:      
2497                             ; コレクションスロットを取得
2497   CD D2 1F               CALL   col_from_reg   ; HL = コレクションスロット
249A   22 26 25               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
249D   23                     INX   h   ; +1: count
249E   7E                     MOV   a,m   
249F   32 30 25               STA   shash_pair_cnt   ; 元のペア数
24A2   23                     INX   h   ; HL → データ領域
24A3   22 28 25               SHLD   shash_data_ptr   
24A6                             ; 
24A6                             ; R[a+1] キーのアドレス
24A6   3A 34 21               LDA   sidx_reg_a   
24A9   3C                     INR   a   
24AA   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
24AD   22 2A 25               SHLD   shash_key_ptr   
24B0                             ; 
24B0                             ; R[a+2] 値のアドレス
24B0   3A 34 21               LDA   sidx_reg_a   
24B3   C6 02                  ADI   2   
24B5   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
24B8   22 2C 25               SHLD   shash_val_ptr   
24BB                             ; 
24BB                             ; 既存キーを検索
24BB   3A 30 25               LDA   shash_pair_cnt   
24BE   B7                     ORA   a   
24BF   CA F9 24               JZ   shash_append   ; 空 Hash → 追加
24C2                             ; 
24C2   32 31 25               STA   shash_loop_cnt   
24C5   2A 28 25               LHLD   shash_data_ptr   
24C8                             ; 
24C8                SHASH_SEARCH:      
24C8   22 2E 25               SHLD   shash_cur_ptr   
24CB                             ; 
24CB   E5                     PUSH   h   
24CC   2A 2A 25               LHLD   shash_key_ptr   
24CF   EB                     XCHG      ; DE = 検索キー
24D0   E1                     POP   h   ; HL = hash ペアのキー
24D1                             ; 
24D1   0E 04                  MVI   c,SLOT_BYTES   
24D3                SHASH_CMP:      
24D3   1A                     LDAX   d   
24D4   BE                     CMP   m   
24D5   C2 E8 24               JNZ   shash_snext   
24D8   23                     INX   h   
24D9   13                     INX   d   
24DA   0D                     DCR   c   
24DB   C2 D3 24               JNZ   shash_cmp   
24DE                             ; 
24DE                             ; 一致! HL = value 位置
24DE                             ; R[a+2] を value にコピー
24DE   EB                     XCHG      ; DE = hash value 位置
24DF   2A 2C 25               LHLD   shash_val_ptr   ; HL = R[a+2]
24E2   CD 25 10               CALL   copy_slot   
24E5   C3 8B 1B               JMP   vm_loop   
24E8                             ; 
24E8                SHASH_SNEXT:      
24E8   2A 2E 25               LHLD   shash_cur_ptr   
24EB   11 08 00               LXI   d,HASH_PAIR_BYTES   
24EE   19                     DAD   d   
24EF   3A 31 25               LDA   shash_loop_cnt   
24F2   3D                     DCR   a   
24F3   32 31 25               STA   shash_loop_cnt   
24F6   C2 C8 24               JNZ   shash_search   
24F9                             ; 
24F9                             ; 見つからなかった → 末尾に追加
24F9                             ; 
24F9                SHASH_APPEND:      
24F9                             ; 容量チェック
24F9   3A 30 25               LDA   shash_pair_cnt   
24FC   FE 04                  CPI   COL_MAX_HASH_PAIRS   
24FE   D2 03 00               JNC   vm_error   ; Hash 満杯
2501                             ; 
2501                             ; count++ を書き込み
2501   3C                     INR   a   
2502   F5                     PUSH   psw   
2503   2A 26 25               LHLD   shash_col_ptr   
2506   23                     INX   h   ; +1: count フィールド
2507   77                     MOV   m,a   
2508   F1                     POP   psw   
2509                             ; 
2509                             ; 追加位置 = data + old_count * 8
2509   3A 30 25               LDA   shash_pair_cnt   ; old count
250C   87                     ADD   a   ; ×2
250D   87                     ADD   a   ; ×4
250E   87                     ADD   a   ; ×8
250F   5F                     MOV   e,a   
2510   16 00                  MVI   d,0   
2512   2A 28 25               LHLD   shash_data_ptr   
2515   19                     DAD   d   ; HL = 追加位置
2516                             ; 
2516                             ; key をコピー (R[a+1] → [HL])
2516   EB                     XCHG      ; DE = 追加位置
2517   2A 2A 25               LHLD   shash_key_ptr   ; HL = R[a+1]
251A   CD 25 10               CALL   copy_slot   ; key 4B、DE は value 位置に進む
251D                             ; 
251D                             ; value をコピー (R[a+2] → [DE])
251D   2A 2C 25               LHLD   shash_val_ptr   ; HL = R[a+2]
2520                             ; DE は既に value 位置
2520   CD 25 10               CALL   copy_slot   
2523   C3 8B 1B               JMP   vm_loop   
2526                             ; 
2526                             ; --- sidx_hash データ ---
2526   00 00        SHASH_COL_PTR:   DW   0   
2528   00 00        SHASH_DATA_PTR:   DW   0   
252A   00 00        SHASH_KEY_PTR:   DW   0   
252C   00 00        SHASH_VAL_PTR:   DW   0   
252E   00 00        SHASH_CUR_PTR:   DW   0   
2530   00           SHASH_PAIR_CNT:   DB   0   
2531   00           SHASH_LOOP_CNT:   DB   0   
2532                             ; 
2532                             ; ===============================================================
2532                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
2532                             ; 
2532                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
2532                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
2532                             ; ROM がなければ即 nil。
2532                             ; 
2532                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
2532                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
2532                             ; ===============================================================
2532                SEND_GETKEY_TIMEOUT:      
2532                             ; R[a+1] からタイムアウト回数を読む
2532   3A 55 16               LDA   send_reg_a   
2535   C6 01                  ADI   1   
2537   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
253A   23                     INX   h   
253B   23                     INX   h   ; +2: val_lo
253C   4E                     MOV   c,m   
253D   23                     INX   h   ; +3: val_hi
253E   46                     MOV   b,m   ; BC = タイムアウト回数
253F                             ; 
253F                             ; ROM チェック
253F   3A 47 06               LDA   KEY_ADDR   
2542   B7                     ORA   a   
2543   CA 6D 25               JZ   getkey_timeout_nil   ; ROM なし → nil
2546                             ; 
2546                GETKEY_POLL_LOOP:      
2546   78                     MOV   a,b   
2547   B1                     ORA   c   
2548   CA 6D 25               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
254B                             ; 
254B   C5                     PUSH   b   ; カウンタ退避
254C   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
254F   C1                     POP   b   ; カウンタ復帰
2550   FE FF                  CPI   0FFh   
2552   C2 5E 25               JNZ   getkey_timeout_got   ; キー押下!
2555                             ; 
2555   C5                     PUSH   b   ; カウンタ退避
2556   CD 4E 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
2559   C1                     POP   b   
255A   0B                     DCX   b   ; カウンタ--
255B   C3 46 25               JMP   getkey_poll_loop   
255E                             ; 
255E                GETKEY_TIMEOUT_GOT:      
255E                             ; A = キーコード (0x00-0x17)
255E   4F                     MOV   c,a   
255F   06 00                  MVI   b,0   
2561   3A 55 16               LDA   send_reg_a   
2564   CD 00 10               CALL   get_reg_addr   
2567   CD 10 10               CALL   set_slot_int16   
256A   C3 8B 1B               JMP   vm_loop   
256D                             ; 
256D                GETKEY_TIMEOUT_NIL:      
256D   3A 55 16               LDA   send_reg_a   
2570   CD 00 10               CALL   get_reg_addr   
2573   3E 01                  MVI   a,TT_NIL   
2575   CD 1A 10               CALL   set_slot_special   
2578   C3 8B 1B               JMP   vm_loop   
257B                             ; 
257B                             ; ===============================================================
257B                             ; send_slice — [](offset, length): 文字列スライス
257B                             ; 
257B                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
257B                             ; 
257B                             ;   入力: send_reg_a = a, send_argc = 2
257B                             ;         R[a] = TT_STRING (対象文字列)
257B                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
257B                             ;         R[a+2] = length (TT_INTEGER)
257B                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
257B                             ;         offset >= 文字列長 → 空文字列
257B                             ;         length は利用可能バイト数にクランプ
257B                             ; ===============================================================
257B                SEND_SLICE:      
257B                             ; R[a] が TT_STRING か確認
257B   3A 55 16               LDA   send_reg_a   
257E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2581   7E                     MOV   a,m   ; A = 型タグ
2582   FE 07                  CPI   TT_STRING   
2584   C2 03 00               JNZ   vm_error   
2587                             ; 
2587                             ; ソース文字列のコレクションスロットを取得
2587   3A 55 16               LDA   send_reg_a   
258A   CD 00 10               CALL   get_reg_addr   
258D   CD D2 1F               CALL   col_from_reg   ; HL = collection slot
2590   23                     INX   h   ; +1: count
2591   7E                     MOV   a,m   
2592   32 22 26               STA   slice_src_count   
2595   23                     INX   h   ; HL → data
2596   22 23 26               SHLD   slice_src_data   
2599                             ; 
2599                             ; R[a+1] から offset を取得
2599   3A 55 16               LDA   send_reg_a   
259C   C6 01                  ADI   1   
259E   CD 00 10               CALL   get_reg_addr   
25A1   CD 32 10               CALL   slot_to_value   
25A4   7E                     MOV   a,m   ; A = offset (val_lo)
25A5   32 25 26               STA   slice_offset   
25A8                             ; 
25A8                             ; R[a+2] から length を取得
25A8   3A 55 16               LDA   send_reg_a   
25AB   C6 02                  ADI   2   
25AD   CD 00 10               CALL   get_reg_addr   
25B0   CD 32 10               CALL   slot_to_value   
25B3   7E                     MOV   a,m   ; A = length (val_lo)
25B4   32 26 26               STA   slice_length   
25B7                             ; 
25B7                             ; offset >= src_count → 空文字列
25B7   3A 25 26               LDA   slice_offset   
25BA   47                     MOV   b,a   ; B = offset
25BB   3A 22 26               LDA   slice_src_count   ; A = src_count
25BE   B8                     CMP   b   
25BF   DA 14 26               JC   slice_empty   ; src_count < offset
25C2   CA 14 26               JZ   slice_empty   ; src_count == offset
25C5                             ; 
25C5                             ; available = src_count - offset
25C5   90                     SUB   b   ; A = available
25C6   47                     MOV   b,a   ; B = available
25C7   3A 26 26               LDA   slice_length   
25CA   B8                     CMP   b   
25CB   DA CF 25               JC   slice_len_ok   ; length < available → そのまま
25CE   78                     MOV   a,b   ; clamp: length = available
25CF                SLICE_LEN_OK:      
25CF   32 26 26               STA   slice_length   ; 実際のコピー長
25D2                             ; 
25D2                             ; 新しいコレクションスロットを確保
25D2   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
25D5   32 27 26               STA   slice_new_slot   
25D8   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
25DA   23                     INX   h   
25DB   3A 26 26               LDA   slice_length   
25DE   77                     MOV   m,a   ; +1: count = コピー長
25DF   23                     INX   h   ; HL → new data area
25E0                             ; 
25E0                             ; ソースデータ先頭 + offset
25E0   E5                     PUSH   h   ; dest を退避
25E1   2A 23 26               LHLD   slice_src_data   
25E4   3A 25 26               LDA   slice_offset   
25E7   5F                     MOV   e,a   
25E8   16 00                  MVI   d,0   
25EA   19                     DAD   d   ; HL = src_data + offset
25EB   EB                     XCHG      ; DE = src + offset
25EC   E1                     POP   h   ; HL = dest
25ED                             ; 
25ED                             ; バイトコピー
25ED   3A 26 26               LDA   slice_length   
25F0   B7                     ORA   a   
25F1   CA FD 25               JZ   slice_done   
25F4   4F                     MOV   c,a   
25F5                SLICE_COPY:      
25F5   1A                     LDAX   d   
25F6   77                     MOV   m,a   
25F7   23                     INX   h   
25F8   13                     INX   d   
25F9   0D                     DCR   c   
25FA   C2 F5 25               JNZ   slice_copy   
25FD                             ; 
25FD                SLICE_DONE:      
25FD                             ; R[a] = TT_STRING, val_lo = new_slot + 1
25FD   3A 55 16               LDA   send_reg_a   
2600   CD 00 10               CALL   get_reg_addr   
2603   36 07                  MVI   m,TT_STRING   ; +0: type
2605   23                     INX   h   
2606   36 00                  MVI   m,0   ; +1: reserved
2608   23                     INX   h   
2609   3A 27 26               LDA   slice_new_slot   
260C   3C                     INR   a   ; slot + 1
260D   77                     MOV   m,a   ; +2: val_lo
260E   23                     INX   h   
260F   36 00                  MVI   m,0   ; +3: val_hi
2611   C3 8B 1B               JMP   vm_loop   
2614                             ; 
2614                SLICE_EMPTY:      
2614                             ; 空文字列を返す
2614   CD BD 1F               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2617   32 27 26               STA   slice_new_slot   
261A   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
261C   23                     INX   h   
261D   36 00                  MVI   m,0   ; +1: count = 0
261F   C3 FD 25               JMP   slice_done   
2622                             ; 
2622                             ; --- send_slice データ ---
2622   00           SLICE_SRC_COUNT:   DB   0   
2623   00 00        SLICE_SRC_DATA:   DW   0   
2625   00           SLICE_OFFSET:   DB   0   
2626   00           SLICE_LENGTH:   DB   0   
2627   00           SLICE_NEW_SLOT:   DB   0   
2628                             ; 
2628                             ; ===============================================================
2628                             ; col_gc_alloc — 到達性を辿る回収つきのスロット確保
2628                             ; 
2628                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
2628                             ; 
2628                             ; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
2628                             ; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
2628                             ; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
2628                             ; 
2628                             ; ルート:
2628                             ;   レジスタファイル    MAX_REGS 個の値スロット
2628                             ;   グローバル変数      MAX_GLOBALS 個の値スロット
2628                             ;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
2628                             ; 
2628                             ; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
2628                             ; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
2628                             ; 起動時にゼロクリアされていて型 0 なので素通りする。
2628                             ; 
2628                             ; 伝播:
2628                             ;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
2628                             ;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
2628                             ; 
2628                             ;   出力: A = スロット番号, HL = スロットアドレス
2628                             ;   エラー: 全スロット生きている → vm_error
2628                             ; ===============================================================
2628                COL_GC_ALLOC:      
2628                             ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
2628   AF                     XRA   a   
2629   21 91 27               LXI   h,gc_bitmap   
262C   0E 10                  MVI   c,16   
262E                GC_CLEAR_BM:      
262E   77                     MOV   m,a   
262F   23                     INX   h   
2630   0D                     DCR   c   
2631   C2 2E 26               JNZ   gc_clear_bm   
2634                             ; 
2634                             ; --- ルート: レジスタファイル ---
2634                             ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
2634   21 00 81               LXI   h,REG_FILE_BASE   
2637   06 40                  MVI   b,MAX_REGS   
2639                GC_ROOT_REG:      
2639   CD 16 27               CALL   gc_mark_value   
263C   23                     INX   h   
263D   23                     INX   h   
263E   23                     INX   h   
263F   23                     INX   h   
2640   05                     DCR   b   
2641   C2 39 26               JNZ   gc_root_reg   
2644                             ; 
2644                             ; --- ルート: グローバル変数 ---
2644   21 00 90               LXI   h,GLOBALS_BASE   
2647   06 40                  MVI   b,MAX_GLOBALS   
2649                GC_ROOT_GLOBAL:      
2649   CD 16 27               CALL   gc_mark_value   
264C   23                     INX   h   
264D   23                     INX   h   
264E   23                     INX   h   
264F   23                     INX   h   
2650   05                     DCR   b   
2651   C2 49 26               JNZ   gc_root_global   
2654                             ; 
2654                             ; --- ルート: オブジェクトのインスタンス変数 ---
2654   21 C4 92               LXI   h,OBJECT_POOL_BASE + OBJECT_HEADER_SIZE   
2657   06 20                  MVI   b,MAX_OBJECTS   
2659                GC_ROOT_OBJ:      
2659   C5                     PUSH   b   
265A   E5                     PUSH   h   
265B   06 07                  MVI   b,MAX_IVARS   
265D                GC_ROOT_IVAR:      
265D   CD 16 27               CALL   gc_mark_value   
2660   23                     INX   h   
2661   23                     INX   h   
2662   23                     INX   h   
2663   23                     INX   h   
2664   05                     DCR   b   
2665   C2 5D 26               JNZ   gc_root_ivar   
2668   E1                     POP   h   
2669   11 20 00               LXI   d,OBJECT_SLOT_SIZE   
266C   19                     DAD   d   ; 次のオブジェクトの ivar 先頭
266D   C1                     POP   b   
266E   05                     DCR   b   
266F   C2 59 26               JNZ   gc_root_obj   
2672                             ; 
2672                             ; --- 到達性を伝播する ---
2672   CD 8F 26               CALL   gc_propagate   
2675                             ; 
2675                             ; --- 印の付かなかったスロットを探す ---
2675                             ; B をカウンタに使う (gc_check_bit は B を壊さない)
2675   06 00                  MVI   b,0   
2677                GC_FIND_FREE:      
2677   78                     MOV   a,b   ; A = 検査対象スロット番号
2678   CD 6C 27               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
267B   CA 88 26               JZ   gc_found_free   
267E   04                     INR   b   
267F   78                     MOV   a,b   
2680   FE 40                  CPI   MAX_COL_SLOTS   
2682   DA 77 26               JC   gc_find_free   
2685   C3 03 00               JMP   vm_error   ; 全スロット使用中
2688                             ; 
2688                GC_FOUND_FREE:      
2688   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
2689   F5                     PUSH   psw   ; スロット番号を退避
268A   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス
268D   F1                     POP   psw   ; A = スロット番号を復帰
268E   C9                     RET      
268F                             ; 
268F                             ; ---------------------------------------------------------------
268F                             ; gc_propagate — 印が増えなくなるまで中身を辿る
268F                             ; 
268F                             ; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
268F                             ; 1 周で 1 つも走査しなければ終わり。
268F                             ; ---------------------------------------------------------------
268F                GC_PROPAGATE:      
268F   AF                     XRA   a   
2690   32 A1 27               STA   gc_changed   
2693   06 00                  MVI   b,0   ; B = スロット番号
2695                GC_PROP_SLOT:      
2695   78                     MOV   a,b   
2696   CD 6C 27               CALL   gc_check_bit   ; 印が無ければ飛ばす
2699   CA B2 26               JZ   gc_prop_next   
269C   78                     MOV   a,b   
269D   CD 85 27               CALL   gc_check_scanned   ; 走査済みなら飛ばす
26A0   C2 B2 26               JNZ   gc_prop_next   
26A3   78                     MOV   a,b   
26A4   CD 78 27               CALL   gc_set_scanned   
26A7   3E 01                  MVI   a,1   
26A9   32 A1 27               STA   gc_changed   
26AC   78                     MOV   a,b   
26AD   C5                     PUSH   b   
26AE   CD C1 26               CALL   gc_scan_slot   
26B1   C1                     POP   b   
26B2                GC_PROP_NEXT:      
26B2   04                     INR   b   
26B3   78                     MOV   a,b   
26B4   FE 40                  CPI   MAX_COL_SLOTS   
26B6   DA 95 26               JC   gc_prop_slot   
26B9   3A A1 27               LDA   gc_changed   
26BC   B7                     ORA   a   
26BD   C2 8F 26               JNZ   gc_propagate   ; 印が増えたのでもう 1 周
26C0   C9                     RET      
26C1                             ; 
26C1                             ; ---------------------------------------------------------------
26C1                             ; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
26C1                             ; 
26C1                             ; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
26C1                             ; 読むと、前に入っていた文字列のバイトが型タグに見える。
26C1                             ; 
26C1                             ; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
26C1                             ; でも隣のスロットまで歩かないようにする。
26C1                             ; ---------------------------------------------------------------
26C1                GC_SCAN_SLOT:      
26C1   C5                     PUSH   b   
26C2   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス (A は残る)
26C5   7E                     MOV   a,m   ; +0: 型
26C6   23                     INX   h   
26C7   46                     MOV   b,m   ; +1: 要素数 / 組の数
26C8   23                     INX   h   ; HL = データ先頭
26C9   FE 02                  CPI   COL_TYPE_ARRAY   
26CB   CA D6 26               JZ   gc_scan_array   
26CE   FE 03                  CPI   COL_TYPE_HASH   
26D0   CA F3 26               JZ   gc_scan_hash   
26D3   C3 14 27               JMP   gc_scan_done   ; 文字列と空きは辿らない
26D6                GC_SCAN_ARRAY:      
26D6   78                     MOV   a,b   
26D7   B7                     ORA   a   
26D8   CA 14 27               JZ   gc_scan_done   ; 要素数 0
26DB                             ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
26DB                             ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
26DB   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
26DD   DA E5 26               JC   gc_scan_aloop   ; 容量未満
26E0   CA E5 26               JZ   gc_scan_aloop   ; ちょうど容量
26E3   06 08                  MVI   b,COL_MAX_ARRAY_ELEMS   
26E5                GC_SCAN_ALOOP:      
26E5   CD 16 27               CALL   gc_mark_value   
26E8   23                     INX   h   
26E9   23                     INX   h   
26EA   23                     INX   h   
26EB   23                     INX   h   
26EC   05                     DCR   b   
26ED   C2 E5 26               JNZ   gc_scan_aloop   
26F0   C3 14 27               JMP   gc_scan_done   
26F3                GC_SCAN_HASH:      
26F3   78                     MOV   a,b   
26F4   B7                     ORA   a   
26F5   CA 14 27               JZ   gc_scan_done   ; 組の数 0
26F8   FE 04                  CPI   COL_MAX_HASH_PAIRS   
26FA   DA 02 27               JC   gc_scan_hloop   
26FD   CA 02 27               JZ   gc_scan_hloop   
2700   06 04                  MVI   b,COL_MAX_HASH_PAIRS   
2702                GC_SCAN_HLOOP:      
2702   CD 16 27               CALL   gc_mark_value   ; 鍵
2705   23                     INX   h   
2706   23                     INX   h   
2707   23                     INX   h   
2708   23                     INX   h   
2709   CD 16 27               CALL   gc_mark_value   ; 値
270C   23                     INX   h   
270D   23                     INX   h   
270E   23                     INX   h   
270F   23                     INX   h   
2710   05                     DCR   b   
2711   C2 02 27               JNZ   gc_scan_hloop   
2714                GC_SCAN_DONE:      
2714   C1                     POP   b   
2715   C9                     RET      
2716                             ; 
2716                             ; ---------------------------------------------------------------
2716                             ; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
2716                             ; 
2716                             ; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
2716                             ; なのでここでは何もしない (中身はルート走査で辿る)。
2716                             ; 
2716                             ; **値は スロット + 1。** 0 は「無し」。
2716                             ; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
2716                             ; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
2716                             ; 
2716                             ;   HL / DE / BC は保たれる
2716                             ; ---------------------------------------------------------------
2716                GC_MARK_VALUE:      
2716   E5                     PUSH   h   
2717   D5                     PUSH   d   
2718   C5                     PUSH   b   
2719   7E                     MOV   a,m   ; A = 型タグ
271A   FE 07                  CPI   TT_STRING   
271C   CA 2C 27               JZ   gc_mv_ref   
271F   FE 08                  CPI   TT_ARRAY   
2721   CA 2C 27               JZ   gc_mv_ref   
2724   FE 09                  CPI   TT_HASH   
2726   CA 2C 27               JZ   gc_mv_ref   
2729   C3 43 27               JMP   gc_mv_done   
272C                GC_MV_REF:      
272C   23                     INX   h   
272D   23                     INX   h   
272E   23                     INX   h   
272F   7E                     MOV   a,m   ; +3: val_hi
2730   B7                     ORA   a   
2731   C2 43 27               JNZ   gc_mv_done   ; 上位が 0 でなければスロット番号ではない
2734   2B                     DCX   h   
2735   7E                     MOV   a,m   ; +2: val_lo = スロット + 1
2736   B7                     ORA   a   
2737   CA 43 27               JZ   gc_mv_done   ; 0 = 無し
273A   3D                     DCR   a   ; A = スロット番号
273B   FE 40                  CPI   MAX_COL_SLOTS   
273D   D2 43 27               JNC   gc_mv_done   ; 範囲外
2740   CD 5F 27               CALL   gc_set_bit   
2743                GC_MV_DONE:      
2743   C1                     POP   b   
2744   D1                     POP   d   
2745   E1                     POP   h   
2746   C9                     RET      
2747                             ; 
2747                             ; ---------------------------------------------------------------
2747                             ; ビットの出し入れ
2747                             ; 
2747                             ; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
2747                             ; 直して食い違うのを避けるため。
2747                             ; 
2747                             ; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
2747                             ;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
2747                             ; ---------------------------------------------------------------
2747                GC_BIT_PTR:      
2747   4F                     MOV   c,a   ; C = スロット番号
2748   0F                     RRC      
2749   0F                     RRC      
274A   0F                     RRC      
274B   E6 07                  ANI   07h   ; A = バイト位置 (slot >> 3)
274D   6F                     MOV   l,a   
274E   26 00                  MVI   h,0   
2750   19                     DAD   d   ; HL = 先頭 + バイト位置
2751   E5                     PUSH   h   
2752   79                     MOV   a,c   
2753   E6 07                  ANI   07h   ; ビット位置 (slot & 7)
2755   6F                     MOV   l,a   
2756   26 00                  MVI   h,0   
2758   11 A2 27               LXI   d,gc_bit_table   
275B   19                     DAD   d   
275C   7E                     MOV   a,m   ; A = ビットマスク
275D   E1                     POP   h   ; HL = ビットマップのバイト
275E   C9                     RET      
275F                             ; 
275F                             ; --- gc_set_bit: A = slot (0-63) の印を立てる ---
275F                GC_SET_BIT:      
275F   E5                     PUSH   h   
2760   D5                     PUSH   d   
2761   11 91 27               LXI   d,gc_bitmap   
2764   CD 47 27               CALL   gc_bit_ptr   
2767   B6                     ORA   m   
2768   77                     MOV   m,a   
2769   D1                     POP   d   
276A   E1                     POP   h   
276B   C9                     RET      
276C                             ; 
276C                             ; --- gc_check_bit: A = slot の印を検査 ---
276C                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
276C                GC_CHECK_BIT:      
276C   E5                     PUSH   h   
276D   D5                     PUSH   d   
276E   11 91 27               LXI   d,gc_bitmap   
2771   CD 47 27               CALL   gc_bit_ptr   
2774   A6                     ANA   m   ; Z=1 ならビットクリア
2775   D1                     POP   d   ; POP はフラグを変えない
2776   E1                     POP   h   
2777   C9                     RET      
2778                             ; 
2778                             ; --- gc_set_scanned: A = slot を走査済みにする ---
2778                GC_SET_SCANNED:      
2778   E5                     PUSH   h   
2779   D5                     PUSH   d   
277A   11 99 27               LXI   d,gc_scanned   
277D   CD 47 27               CALL   gc_bit_ptr   
2780   B6                     ORA   m   
2781   77                     MOV   m,a   
2782   D1                     POP   d   
2783   E1                     POP   h   
2784   C9                     RET      
2785                             ; 
2785                             ; --- gc_check_scanned: A = slot が走査済みか ---
2785                             ; 戻り: Z=1 → まだ、Z=0 → 済み
2785                GC_CHECK_SCANNED:      
2785   E5                     PUSH   h   
2786   D5                     PUSH   d   
2787   11 99 27               LXI   d,gc_scanned   
278A   CD 47 27               CALL   gc_bit_ptr   
278D   A6                     ANA   m   
278E   D1                     POP   d   
278F   E1                     POP   h   
2790   C9                     RET      
2791                             ; 
2791                             ; --- GC データ ---
2791                             ; 
2791                             ; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
2791                             ; 回している
2791   00 00 00 00 00 00 00 00 GC_BITMAP:   DB   0,0,0,0,0,0,0,0   
2799   00 00 00 00 00 00 00 00 GC_SCANNED:   DB   0,0,0,0,0,0,0,0   
27A1   00           GC_CHANGED:   DB   0   
27A2   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
27AA                             ; 
27AA                             ; ===============================================================
27AA                             ; sendb_each — Array#each: 配列要素を反復
27AA                             ; 
27AA                             ;   R[a] = TT_ARRAY (レシーバ)
27AA                             ;   R[a+argc+1] = TT_PROC (ブロック)
27AA                             ;   各反復で R[1] = array[index]
27AA                             ; 
27AA                             ; FRAME_KIND_EACH フレームを使い、フレーム +11 (reserved) に
27AA                             ; コレクションスロット番号を格納する。
27AA                             ; ===============================================================
27AA                SENDB_EACH:      
27AA                             ; R[a] が TT_ARRAY か確認
27AA   3A AB 18               LDA   sendb_reg_a   
27AD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
27B0   7E                     MOV   a,m   
27B1   FE 08                  CPI   TT_ARRAY   
27B3   C2 03 00               JNZ   vm_error   
27B6                             ; 
27B6                             ; コレクションスロット番号を取得
27B6   3A AB 18               LDA   sendb_reg_a   
27B9   CD 00 10               CALL   get_reg_addr   
27BC   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
27BF   7E                     MOV   a,m   ; val_lo = slot + 1
27C0   3D                     DCR   a   ; slot number (0-based)
27C1   32 36 28               STA   each_col_slot   
27C4                             ; 
27C4                             ; 要素数を読む
27C4   3A 36 28               LDA   each_col_slot   
27C7   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス
27CA   23                     INX   h   ; +1: count
27CB   7E                     MOV   a,m   
27CC   32 37 28               STA   each_count   
27CF   B7                     ORA   a   
27D0   CA 8B 1B               JZ   vm_loop   ; 空配列 → ブロック実行しない
27D3                             ; 
27D3                             ; ブロック (TT_PROC) の情報を読む
27D3   3A AD 18               LDA   sendb_argc   
27D6   3C                     INR   a   ; argc + 1
27D7   47                     MOV   b,a   
27D8   3A AB 18               LDA   sendb_reg_a   
27DB   80                     ADD   b   ; A = a + argc + 1
27DC   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1]
27DF   CD 32 10               CALL   slot_to_value   
27E2   7E                     MOV   a,m   ; irep 番号
27E3   32 AF 18               STA   sendb_block_irep   
27E6   23                     INX   h   
27E7   7E                     MOV   a,m   ; outer
27E8   32 B0 18               STA   sendb_block_outer   
27EB                             ; 
27EB                             ; push_frame(a, FRAME_KIND_EACH, outer)
27EB   3A AB 18               LDA   sendb_reg_a   
27EE   06 02                  MVI   b,FRAME_KIND_EACH   
27F0   3A B0 18               LDA   sendb_block_outer   
27F3   4F                     MOV   c,a   
27F4   3A AB 18               LDA   sendb_reg_a   
27F7   CD A4 16               CALL   push_frame   
27FA                             ; 
27FA                             ; フレームに limit = count - 1 を設定
27FA   CD 9D 16               CALL   cur_frame_addr   
27FD   11 08 00               LXI   d,FRAME_OFF_LIMIT   
2800   19                     DAD   d   
2801   3A 37 28               LDA   each_count   
2804   3D                     DCR   a   ; limit = count - 1
2805   77                     MOV   m,a   ; limit_lo
2806   23                     INX   h   
2807   36 00                  MVI   m,0   ; limit_hi
2809                             ; 
2809                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
2809   CD 9D 16               CALL   cur_frame_addr   
280C   11 0B 00               LXI   d,11   
280F   19                     DAD   d   
2810   3A 36 28               LDA   each_col_slot   
2813   77                     MOV   m,a   
2814                             ; 
2814                             ; R[1] = array[0] (最初の要素)
2814   3A 36 28               LDA   each_col_slot   
2817   CD AD 1F               CALL   col_slot_addr   ; HL = スロットアドレス
281A   23                     INX   h   ; skip type
281B   23                     INX   h   ; skip count → data[0]
281C                             ; data[0] を R[1] にコピー (4 バイト)
281C   E5                     PUSH   h   ; source 退避
281D   3E 01                  MVI   a,1   
281F   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2822   EB                     XCHG      ; DE = R[1] (dest)
2823   E1                     POP   h   ; HL = data[0] (source)
2824   CD 25 10               CALL   copy_slot   
2827                             ; 
2827                             ; 子 irep に切り替え
2827   3A AF 18               LDA   sendb_block_irep   
282A   CD 29 17               CALL   switch_irep   
282D                             ; 
282D                             ; PC = 0
282D   21 00 00               LXI   h,0   
2830   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
2833   C3 8B 1B               JMP   vm_loop   
2836                             ; 
2836                             ; --- sendb_each データ ---
2836   00           EACH_COL_SLOT:   DB   0   
2837   00           EACH_COUNT:   DB   0   
2838                             ; 
2838                          END      


