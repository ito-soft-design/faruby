1621   3A 4D 17               LDA   send_reg_a   
1624   3C                     INR   a   
1625   3C                     INR   a   
1626   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
1629   CD 25 10               CALL   copy_slot   ; DE へ 4 バイト
