AF7E   5F                     MOV   e,a   
AF7F   16 00                  MVI   d,0   
AF81   19                     DAD   d   
AF82                             ; コピー
AF82   EB                     XCHG      
AF83   2A F4 AF               LHLD   cc_src_data   
AF86   3A F1 AF               LDA   cc_src_len   
AF89   B7                     ORA   a   
AF8A   CA 96 AF               JZ   cc_str_done   
AF8D   4F                     MOV   c,a   
AF8E                CC_STR_COPY:      
AF8E   7E                     MOV   a,m   
AF8F   12                     STAX   d   
AF90   23                     INX   h   
AF91   13                     INX   d   
AF92   0D                     DCR   c   
AF93   C2 8E AF               JNZ   cc_str_copy   
AF96                CC_STR_DONE:      
AF96                             ; R[a] をそのまま返す (破壊的操作)
AF96   C3 4F 8F               JMP   vm_loop   
AF99                CONCAT_STR_INT:      
AF99                             ; R[a+1] の val_lo を 1 バイトとして追記
AF99   3A 58 8A               LDA   send_reg_a   
AF9C   3C                     INR   a   
AF9D   CD 03 84               CALL   get_reg_addr   
AFA0   CD 35 84               CALL   slot_to_value   
AFA3   4E                     MOV   c,m   ; C = 文字コード (val_lo)
AFA4                             ; R[a] のコレクションスロット
AFA4   3A 58 8A               LDA   send_reg_a   
AFA7   CD 03 84               CALL   get_reg_addr   
AFAA   CD 12 AC               CALL   col_from_reg   ; HL = デストスロット
AFAD   23                     INX   h   ; +1: count
AFAE   7E                     MOV   a,m   
AFAF   FE 1E                  CPI   COL_MAX_STRING_LEN   
AFB1   D2 4F 8F               JNC   vm_loop   ; 満杯なら何もしない
AFB4   34                     INR   m   ; count++
AFB5   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
AFB6   23                     INX   h   ; HL → データ先頭
AFB7   16 00                  MVI   d,0   
AFB9   19                     DAD   d   ; HL = &data[old_count]
AFBA   71                     MOV   m,c   ; 書き込み
AFBB   C3 4F 8F               JMP   vm_loop   
AFBE                CONCAT_ARRAY:      
AFBE                             ; R[a] のコレクションスロット
AFBE   3A 58 8A               LDA   send_reg_a   
AFC1   CD 03 84               CALL   get_reg_addr   
AFC4   CD 12 AC               CALL   col_from_reg   ; HL = コレクションスロット
AFC7   23                     INX   h   ; +1: count
AFC8   7E                     MOV   a,m   
AFC9   FE 07                  CPI   COL_MAX_ARRAY_ELEMS   
AFCB   D2 03 00               JNC   vm_error   ; 満杯
AFCE   32 F6 AF               STA   cc_ary_count   
AFD1   34                     INR   m   ; count++
AFD2                             ; 書き込み位置: data + count * 4
AFD2   23                     INX   h   ; HL → データ先頭
AFD3   3A F6 AF               LDA   cc_ary_count   
AFD6   87                     ADD   a   ; ×2
AFD7   87                     ADD   a   ; ×4
AFD8   5F                     MOV   e,a   
AFD9   16 00                  MVI   d,0   
AFDB   19                     DAD   d   ; HL = 書き込み位置
AFDC   EB                     XCHG      ; DE = 書き込み位置
AFDD                             ; R[a+1] をコピー
AFDD   3A 58 8A               LDA   send_reg_a   
AFE0   3C                     INR   a   
AFE1   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
AFE4   0E 04                  MVI   c,SLOT_BYTES   
AFE6                CC_ARY_COPY:      
AFE6   7E                     MOV   a,m   
AFE7   12                     STAX   d   
AFE8   23                     INX   h   
AFE9   13                     INX   d   
AFEA   0D                     DCR   c   
AFEB   C2 E6 AF               JNZ   cc_ary_copy   
AFEE   C3 4F 8F               JMP   vm_loop   
AFF1   00           CC_SRC_LEN:   DB   0   
AFF2   00           CC_DST_LEN:   DB   0   
AFF3   00           CC_TOTAL_LEN:   DB   0   
AFF4   00 00        CC_SRC_DATA:   DW   0   
AFF6   00           CC_ARY_COUNT:   DB   0   
AFF7                             ; ===============================================================
AFF7                             ; send_push — push: 配列に要素を追加 (send_concat の配列パスと同じ)
AFF7                             ; ===============================================================
AFF7                SEND_PUSH:      
AFF7   C3 BE AF               JMP   concat_array   
AFFA                             ; vm_hash.a80 — Hash (連想配列) ハンドラ
AFFA                             ; 
AFFA                             ; メインコード領域 (0x8400-0xAFFF) に空きがないため、
AFFA                             ; コレクションプール末尾の後 (0xB500) にオーバーフロー配置する。
AFFA                             ; 
AFFA                             ; Hash スロット形式 (コレクションプール 32B スロット内):
AFFA                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
AFFA                             ;   +1: count (1B)  ペア数 (最大 3)
AFFA                             ;   +2: data  (30B) key(4B)+value(4B) × 3 = 24B 使用
AFFA                             ; 
AFFA                             ; キー検索は線形 4 バイト比較。
AFFA                             ; 
AFFA                             ; do_op_array2 もメインコード領域から溢れたためここに配置。
B500                          .ORG   0B500h   
B500                             ; ===============================================================
B500                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
B500                             ; 
B500                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
B500                             ; ===============================================================
B500                DO_OP_ARRAY2:      
B500   CD C3 84               CALL   fetch_byte   ; A = a (書き込み先)
B503   32 EE AD               STA   oary_reg_a   
B506   CD C3 84               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
B509   32 EF AD               STA   oary_src_reg   
B50C   CD C3 84               CALL   fetch_byte   ; A = c (要素数)
B50F   C3 83 AD               JMP   oa2_join   
B512                             ; ===============================================================
B512                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
B512                             ; 
B512                             ;   a = 書き込み先レジスタ
B512                             ;   b = ペア数 (0 = 空 Hash)
B512                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
B512                             ; ===============================================================
B512                DO_OP_HASH:      
B512   CD C3 84               CALL   fetch_byte   ; A = a (書き込み先)
B515   32 7A B5               STA   hash_reg_a   
B518   CD C3 84               CALL   fetch_byte   ; A = b (ペア数)
B51B   32 7B B5               STA   hash_count   
B51E                             ; コレクションスロット確保
B51E   CD FD AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B521   32 7C B5               STA   hash_slot_num   
B524                             ; ヘッダ書き込み
B524   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
B526   23                     INX   h   
B527   3A 7B B5               LDA   hash_count   
B52A   77                     MOV   m,a   ; +1: count
B52B   23                     INX   h   ; HL → データ領域先頭
B52C                             ; ペアがなければ結果書き込みへ
B52C   3A 7B B5               LDA   hash_count   
B52F   B7                     ORA   a   
B530   CA 63 B5               JZ   hash_write_result   
B533                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
B533   3A 7A B5               LDA   hash_reg_a   
B536   32 7D B5               STA   hash_src_reg   
B539                HASH_COPY_PAIR:      
B539                             ; HL = コレクションプール内の書き込み位置
B539                             ; key (4B) をコピー: R[src] → [HL]
B539   E5                     PUSH   h   ; 書き込み先を退避
B53A   3A 7D B5               LDA   hash_src_reg   
B53D   CD 03 84               CALL   get_reg_addr   ; HL = R[src]
B540   D1                     POP   d   ; DE = 書き込み先
B541   CD 28 84               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
B544                             ; DE = value 書き込み位置
B544                             ; value (4B) をコピー: R[src+1] → [DE]
B544   D5                     PUSH   d   ; value 書き込み先を退避
B545   3A 7D B5               LDA   hash_src_reg   
B548   3C                     INR   a   
B549   CD 03 84               CALL   get_reg_addr   ; HL = R[src+1]
B54C   D1                     POP   d   ; DE = value 書き込み先
B54D   CD 28 84               CALL   copy_slot   ; 4B コピー
B550                             ; DE = 次ペアの先頭
B550                             ; ソースレジスタを +2
B550   3A 7D B5               LDA   hash_src_reg   
B553   C6 02                  ADI   2   
B555   32 7D B5               STA   hash_src_reg   
B558                             ; HL = 次の書き込み位置 (DE から)
B558   EB                     XCHG      
B559                             ; ペアカウンタ
B559   3A 7B B5               LDA   hash_count   
B55C   3D                     DCR   a   
B55D   32 7B B5               STA   hash_count   
B560   C2 39 B5               JNZ   hash_copy_pair   
B563                HASH_WRITE_RESULT:      
B563                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
B563   3A 7A B5               LDA   hash_reg_a   
B566   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B569   36 09                  MVI   m,TT_HASH   ; +0: type
B56B   23                     INX   h   
B56C   36 00                  MVI   m,0   ; +1: reserved
B56E   23                     INX   h   
B56F   3A 7C B5               LDA   hash_slot_num   
B572   3C                     INR   a   ; slot + 1
B573   77                     MOV   m,a   ; +2: val_lo
B574   23                     INX   h   
B575   36 00                  MVI   m,0   ; +3: val_hi
B577   C3 4F 8F               JMP   vm_loop   
B57A                             ; --- do_op_hash データ ---
B57A   00           HASH_REG_A:   DB   0   
B57B   00           HASH_COUNT:   DB   0   
B57C   00           HASH_SLOT_NUM:   DB   0   
B57D   00           HASH_SRC_REG:   DB   0   
B57E                             ; ===============================================================
B57E                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
B57E                             ; 
B57E                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
B57E                             ;   キーが見つからなければ R[a] = nil
B57E                             ; ===============================================================
B57E                GIDX_HASH:      
B57E                             ; コレクションスロットを取得
B57E   CD 12 AC               CALL   col_from_reg   ; HL = コレクションスロット
B581   23                     INX   h   ; +1: count
B582   7E                     MOV   a,m   ; A = ペア数
B583   23                     INX   h   ; HL → データ領域
B584   B7                     ORA   a   
B585   CA D1 B5               JZ   ghash_not_found   ; 空 Hash
B588   32 E5 B5               STA   ghash_loop_cnt   
B58B   22 DF B5               SHLD   ghash_data_ptr   
B58E                             ; 検索キー R[a+1] のアドレスを取得
B58E   3A BD AC               LDA   gidx_reg_a   
B591   3C                     INR   a   
B592   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B595   22 E1 B5               SHLD   ghash_key_ptr   
B598                             ; 検索ループ
B598   2A DF B5               LHLD   ghash_data_ptr   
B59B                GHASH_SEARCH:      
B59B   22 E3 B5               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
B59E                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
B59E   E5                     PUSH   h   
B59F   2A E1 B5               LHLD   ghash_key_ptr   
B5A2   EB                     XCHG      ; DE = 検索キー
B5A3   E1                     POP   h   ; HL = hash ペアのキー
B5A4   0E 04                  MVI   c,SLOT_BYTES   
B5A6                GHASH_CMP:      
B5A6   1A                     LDAX   d   
B5A7   BE                     CMP   m   
B5A8   C2 C0 B5               JNZ   ghash_next   
B5AB   23                     INX   h   
B5AC   13                     INX   d   
B5AD   0D                     DCR   c   
B5AE   C2 A6 B5               JNZ   ghash_cmp   
B5B1                             ; 一致! HL = value 位置 (キー直後)
B5B1                             ; value (4B) を R[a] にコピー
B5B1   E5                     PUSH   h   ; value ソース
B5B2   3A BD AC               LDA   gidx_reg_a   
B5B5   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B5B8   EB                     XCHG      ; DE = R[a] (コピー先)
B5B9   E1                     POP   h   ; HL = value (コピー元)
B5BA   CD 28 84               CALL   copy_slot   
B5BD   C3 4F 8F               JMP   vm_loop   
B5C0                GHASH_NEXT:      
B5C0                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
B5C0   2A E3 B5               LHLD   ghash_cur_ptr   
B5C3   11 08 00               LXI   d,HASH_PAIR_BYTES   
B5C6   19                     DAD   d   
B5C7   3A E5 B5               LDA   ghash_loop_cnt   
B5CA   3D                     DCR   a   
B5CB   32 E5 B5               STA   ghash_loop_cnt   
B5CE   C2 9B B5               JNZ   ghash_search   
B5D1                GHASH_NOT_FOUND:      
B5D1                             ; R[a] = nil
B5D1   3A BD AC               LDA   gidx_reg_a   
B5D4   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B5D7   3E 01                  MVI   a,TT_NIL   
B5D9   CD 1D 84               CALL   set_slot_special   
B5DC   C3 4F 8F               JMP   vm_loop   
B5DF                             ; --- gidx_hash データ ---
B5DF   00 00        GHASH_DATA_PTR:   DW   0   
B5E1   00 00        GHASH_KEY_PTR:   DW   0   
B5E3   00 00        GHASH_CUR_PTR:   DW   0   
B5E5   00           GHASH_LOOP_CNT:   DB   0   
B5E6                             ; ===============================================================
B5E6                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
B5E6                             ; 
B5E6                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
B5E6                             ;   既存キー → 値を上書き
B5E6                             ;   新規キー → count < MAX なら末尾に追加
B5E6                             ; ===============================================================
B5E6                SIDX_HASH:      
B5E6                             ; コレクションスロットを取得
B5E6   CD 12 AC               CALL   col_from_reg   ; HL = コレクションスロット
B5E9   22 75 B6               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
B5EC   23                     INX   h   ; +1: count
B5ED   7E                     MOV   a,m   
B5EE   32 7F B6               STA   shash_pair_cnt   ; 元のペア数
B5F1   23                     INX   h   ; HL → データ領域
B5F2   22 77 B6               SHLD   shash_data_ptr   
B5F5                             ; R[a+1] キーのアドレス
B5F5   3A 74 AD               LDA   sidx_reg_a   
B5F8   3C                     INR   a   
B5F9   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B5FC   22 79 B6               SHLD   shash_key_ptr   
B5FF                             ; R[a+2] 値のアドレス
B5FF   3A 74 AD               LDA   sidx_reg_a   
B602   C6 02                  ADI   2   
B604   CD 03 84               CALL   get_reg_addr   ; HL = R[a+2]
B607   22 7B B6               SHLD   shash_val_ptr   
B60A                             ; 既存キーを検索
B60A   3A 7F B6               LDA   shash_pair_cnt   
B60D   B7                     ORA   a   
B60E   CA 48 B6               JZ   shash_append   ; 空 Hash → 追加
B611   32 80 B6               STA   shash_loop_cnt   
B614   2A 77 B6               LHLD   shash_data_ptr   
B617                SHASH_SEARCH:      
B617   22 7D B6               SHLD   shash_cur_ptr   
B61A   E5                     PUSH   h   
B61B   2A 79 B6               LHLD   shash_key_ptr   
B61E   EB                     XCHG      ; DE = 検索キー
B61F   E1                     POP   h   ; HL = hash ペアのキー
B620   0E 04                  MVI   c,SLOT_BYTES   
B622                SHASH_CMP:      
B622   1A                     LDAX   d   
B623   BE                     CMP   m   
B624   C2 37 B6               JNZ   shash_snext   
B627   23                     INX   h   
B628   13                     INX   d   
B629   0D                     DCR   c   
B62A   C2 22 B6               JNZ   shash_cmp   
B62D                             ; 一致! HL = value 位置
B62D                             ; R[a+2] を value にコピー
B62D   EB                     XCHG      ; DE = hash value 位置
B62E   2A 7B B6               LHLD   shash_val_ptr   ; HL = R[a+2]
B631   CD 28 84               CALL   copy_slot   
B634   C3 4F 8F               JMP   vm_loop   
B637                SHASH_SNEXT:      
B637   2A 7D B6               LHLD   shash_cur_ptr   
B63A   11 08 00               LXI   d,HASH_PAIR_BYTES   
B63D   19                     DAD   d   
B63E   3A 80 B6               LDA   shash_loop_cnt   
B641   3D                     DCR   a   
B642   32 80 B6               STA   shash_loop_cnt   
B645   C2 17 B6               JNZ   shash_search   
B648                             ; 見つからなかった → 末尾に追加
B648                SHASH_APPEND:      
B648                             ; 容量チェック
B648   3A 7F B6               LDA   shash_pair_cnt   
B64B   FE 03                  CPI   COL_MAX_HASH_PAIRS   
B64D   D2 03 00               JNC   vm_error   ; Hash 満杯
B650                             ; count++ を書き込み
B650   3C                     INR   a   
B651   F5                     PUSH   psw   
B652   2A 75 B6               LHLD   shash_col_ptr   
B655   23                     INX   h   ; +1: count フィールド
B656   77                     MOV   m,a   
B657   F1                     POP   psw   
B658                             ; 追加位置 = data + old_count * 8
B658   3A 7F B6               LDA   shash_pair_cnt   ; old count
B65B   87                     ADD   a   ; ×2
B65C   87                     ADD   a   ; ×4
B65D   87                     ADD   a   ; ×8
B65E   5F                     MOV   e,a   
B65F   16 00                  MVI   d,0   
B661   2A 77 B6               LHLD   shash_data_ptr   
B664   19                     DAD   d   ; HL = 追加位置
B665                             ; key をコピー (R[a+1] → [HL])
B665   EB                     XCHG      ; DE = 追加位置
B666   2A 79 B6               LHLD   shash_key_ptr   ; HL = R[a+1]
B669   CD 28 84               CALL   copy_slot   ; key 4B、DE は value 位置に進む
B66C                             ; value をコピー (R[a+2] → [DE])
B66C   2A 7B B6               LHLD   shash_val_ptr   ; HL = R[a+2]
B66F                             ; DE は既に value 位置
B66F   CD 28 84               CALL   copy_slot   
B672   C3 4F 8F               JMP   vm_loop   
B675                             ; --- sidx_hash データ ---
B675   00 00        SHASH_COL_PTR:   DW   0   
B677   00 00        SHASH_DATA_PTR:   DW   0   
B679   00 00        SHASH_KEY_PTR:   DW   0   
B67B   00 00        SHASH_VAL_PTR:   DW   0   
B67D   00 00        SHASH_CUR_PTR:   DW   0   
B67F   00           SHASH_PAIR_CNT:   DB   0   
B680   00           SHASH_LOOP_CNT:   DB   0   
B681                             ; ===============================================================
B681                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
B681                             ; 
B681                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
B681                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
B681                             ; ROM がなければ即 nil。
B681                             ; 
B681                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
B681                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
B681                             ; ===============================================================
B681                SEND_GETKEY_TIMEOUT:      
B681                             ; R[a+1] からタイムアウト回数を読む
B681   3A 58 8A               LDA   send_reg_a   
B684   C6 01                  ADI   1   
B686   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B689   23                     INX   h   
B68A   23                     INX   h   ; +2: val_lo
B68B   4E                     MOV   c,m   
B68C   23                     INX   h   ; +3: val_hi
B68D   46                     MOV   b,m   ; BC = タイムアウト回数
B68E                             ; ROM チェック
B68E   3A 47 06               LDA   KEY_ADDR   
B691   B7                     ORA   a   
B692   CA B7 B6               JZ   getkey_timeout_nil   ; ROM なし → nil
B695                GETKEY_POLL_LOOP:      
B695   78                     MOV   a,b   
B696   B1                     ORA   c   
B697   CA B7 B6               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
B69A   C5                     PUSH   b   ; カウンタ退避
B69B   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
B69E   C1                     POP   b   ; カウンタ復帰
B69F   FE FF                  CPI   0FFh   
B6A1   C2 A8 B6               JNZ   getkey_timeout_got   ; キー押下!
B6A4   0B                     DCX   b   ; カウンタ--
B6A5   C3 95 B6               JMP   getkey_poll_loop   
B6A8                GETKEY_TIMEOUT_GOT:      
B6A8                             ; A = キーコード (0x00-0x17)
B6A8   4F                     MOV   c,a   
B6A9   06 00                  MVI   b,0   
B6AB   3A 58 8A               LDA   send_reg_a   
B6AE   CD 03 84               CALL   get_reg_addr   
B6B1   CD 13 84               CALL   set_slot_int16   
B6B4   C3 4F 8F               JMP   vm_loop   
B6B7                GETKEY_TIMEOUT_NIL:      
B6B7   3A 58 8A               LDA   send_reg_a   
B6BA   CD 03 84               CALL   get_reg_addr   
B6BD   3E 01                  MVI   a,TT_NIL   
B6BF   CD 1D 84               CALL   set_slot_special   
B6C2   C3 4F 8F               JMP   vm_loop   
B6C5                             ; ===============================================================
B6C5                             ; send_slice — [](offset, length): 文字列スライス
B6C5                             ; 
B6C5                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
B6C5                             ; 
B6C5                             ;   入力: send_reg_a = a, send_argc = 2
B6C5                             ;         R[a] = TT_STRING (対象文字列)
B6C5                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
B6C5                             ;         R[a+2] = length (TT_INTEGER)
B6C5                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
B6C5                             ;         offset >= 文字列長 → 空文字列
B6C5                             ;         length は利用可能バイト数にクランプ
B6C5                             ; ===============================================================
B6C5                SEND_SLICE:      
B6C5                             ; R[a] が TT_STRING か確認
B6C5   3A 58 8A               LDA   send_reg_a   
B6C8   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B6CB   7E                     MOV   a,m   ; A = 型タグ
B6CC   FE 07                  CPI   TT_STRING   
B6CE   C2 03 00               JNZ   vm_error   
B6D1                             ; ソース文字列のコレクションスロットを取得
B6D1   3A 58 8A               LDA   send_reg_a   
B6D4   CD 03 84               CALL   get_reg_addr   
B6D7   CD 12 AC               CALL   col_from_reg   ; HL = collection slot
B6DA   23                     INX   h   ; +1: count
B6DB   7E                     MOV   a,m   
B6DC   32 6C B7               STA   slice_src_count   
B6DF   23                     INX   h   ; HL → data
B6E0   22 6D B7               SHLD   slice_src_data   
B6E3                             ; R[a+1] から offset を取得
B6E3   3A 58 8A               LDA   send_reg_a   
B6E6   C6 01                  ADI   1   
B6E8   CD 03 84               CALL   get_reg_addr   
B6EB   CD 35 84               CALL   slot_to_value   
B6EE   7E                     MOV   a,m   ; A = offset (val_lo)
B6EF   32 6F B7               STA   slice_offset   
B6F2                             ; R[a+2] から length を取得
B6F2   3A 58 8A               LDA   send_reg_a   
B6F5   C6 02                  ADI   2   
B6F7   CD 03 84               CALL   get_reg_addr   
B6FA   CD 35 84               CALL   slot_to_value   
B6FD   7E                     MOV   a,m   ; A = length (val_lo)
B6FE   32 70 B7               STA   slice_length   
B701                             ; offset >= src_count → 空文字列
B701   3A 6F B7               LDA   slice_offset   
B704   47                     MOV   b,a   ; B = offset
B705   3A 6C B7               LDA   slice_src_count   ; A = src_count
B708   B8                     CMP   b   
B709   DA 5E B7               JC   slice_empty   ; src_count < offset
B70C   CA 5E B7               JZ   slice_empty   ; src_count == offset
B70F                             ; available = src_count - offset
B70F   90                     SUB   b   ; A = available
B710   47                     MOV   b,a   ; B = available
B711   3A 70 B7               LDA   slice_length   
B714   B8                     CMP   b   
B715   DA 19 B7               JC   slice_len_ok   ; length < available → そのまま
B718   78                     MOV   a,b   ; clamp: length = available
B719                SLICE_LEN_OK:      
B719   32 70 B7               STA   slice_length   ; 実際のコピー長
B71C                             ; 新しいコレクションスロットを確保
B71C   CD FD AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B71F   32 71 B7               STA   slice_new_slot   
B722   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
B724   23                     INX   h   
B725   3A 70 B7               LDA   slice_length   
B728   77                     MOV   m,a   ; +1: count = コピー長
B729   23                     INX   h   ; HL → new data area
B72A                             ; ソースデータ先頭 + offset
B72A   E5                     PUSH   h   ; dest を退避
B72B   2A 6D B7               LHLD   slice_src_data   
B72E   3A 6F B7               LDA   slice_offset   
B731   5F                     MOV   e,a   
B732   16 00                  MVI   d,0   
B734   19                     DAD   d   ; HL = src_data + offset
B735   EB                     XCHG      ; DE = src + offset
B736   E1                     POP   h   ; HL = dest
B737                             ; バイトコピー
B737   3A 70 B7               LDA   slice_length   
B73A   B7                     ORA   a   
B73B   CA 47 B7               JZ   slice_done   
B73E   4F                     MOV   c,a   
B73F                SLICE_COPY:      
B73F   1A                     LDAX   d   
B740   77                     MOV   m,a   
B741   23                     INX   h   
B742   13                     INX   d   
B743   0D                     DCR   c   
B744   C2 3F B7               JNZ   slice_copy   
B747                SLICE_DONE:      
B747                             ; R[a] = TT_STRING, val_lo = new_slot + 1
B747   3A 58 8A               LDA   send_reg_a   
B74A   CD 03 84               CALL   get_reg_addr   
B74D   36 07                  MVI   m,TT_STRING   ; +0: type
B74F   23                     INX   h   
B750   36 00                  MVI   m,0   ; +1: reserved
B752   23                     INX   h   
B753   3A 71 B7               LDA   slice_new_slot   
B756   3C                     INR   a   ; slot + 1
B757   77                     MOV   m,a   ; +2: val_lo
B758   23                     INX   h   
B759   36 00                  MVI   m,0   ; +3: val_hi
B75B   C3 4F 8F               JMP   vm_loop   
B75E                SLICE_EMPTY:      
B75E                             ; 空文字列を返す
B75E   CD FD AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B761   32 71 B7               STA   slice_new_slot   
B764   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
B766   23                     INX   h   
B767   36 00                  MVI   m,0   ; +1: count = 0
B769   C3 47 B7               JMP   slice_done   
B76C                             ; --- send_slice データ ---
B76C   00           SLICE_SRC_COUNT:   DB   0   
B76D   00 00        SLICE_SRC_DATA:   DW   0   
B76F   00           SLICE_OFFSET:   DB   0   
B770   00           SLICE_LENGTH:   DB   0   
B771   00           SLICE_NEW_SLOT:   DB   0   
B772                             ; ===============================================================
B772                             ; col_gc_alloc — 簡易 GC 付きコレクションスロット確保
B772                             ; 
B772                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
B772                             ; レジスタファイル全体とグローバル変数をスキャンして参照ビットマップを構築し、
B772                             ; 未参照のスロットを見つけて再利用する。
B772                             ; 
B772                             ; スキャン対象:
B772                             ;   - レジスタファイル (64 スロット): TT_STRING / TT_ARRAY / TT_HASH
B772                             ;   - グローバル変数 (64 スロット): 同上
B772                             ; 
B772                             ; 注意: 配列要素・Hash 値からの間接参照はスキャンしない (保守的)。
B772                             ;       配列/Hash 自体が参照されていればそのスロットは保持される。
B772                             ; 
B772                             ;   出力: A = スロット番号, HL = スロットアドレス
B772                             ;   エラー: 全スロット使用中 → vm_error
B772                             ; ===============================================================
B772                COL_GC_ALLOC:      
B772                             ; 1. ビットマップクリア (16 スロット = 2 バイト)
B772   AF                     XRA   a   
B773   32 36 B8               STA   gc_bitmap   
B776   32 37 B8               STA   gc_bitmap + 1   
B779                             ; 2. レジスタファイル全体をスキャン (64 スロット × 4B)
B779   21 00 81               LXI   h,REG_FILE_BASE   
B77C   06 40                  MVI   b,MAX_REGS   
B77E                GC_SCAN_REGS:      
B77E   7E                     MOV   a,m   ; A = 型タグ
B77F   FE 07                  CPI   TT_STRING   
B781   CA CD B7               JZ   gc_mark_reg   
B784   FE 08                  CPI   TT_ARRAY   
B786   CA CD B7               JZ   gc_mark_reg   
B789   FE 09                  CPI   TT_HASH   
B78B   CA CD B7               JZ   gc_mark_reg   
B78E                GC_NEXT_REG:      
B78E   23                     INX   h   
B78F   23                     INX   h   
B790   23                     INX   h   
B791   23                     INX   h   ; HL += SLOT_BYTES
B792   05                     DCR   b   
B793   C2 7E B7               JNZ   gc_scan_regs   
B796                             ; 3. グローバル変数をスキャン (64 スロット × 4B)
B796   21 00 B0               LXI   h,GLOBALS_BASE   
B799   06 40                  MVI   b,MAX_REGS   ; MAX_GLOBALS = MAX_REGS = 64
B79B                GC_SCAN_GLOBALS:      
B79B   7E                     MOV   a,m   
B79C   FE 07                  CPI   TT_STRING   
B79E   CA E4 B7               JZ   gc_mark_global   
B7A1   FE 08                  CPI   TT_ARRAY   
B7A3   CA E4 B7               JZ   gc_mark_global   
B7A6   FE 09                  CPI   TT_HASH   
B7A8   CA E4 B7               JZ   gc_mark_global   
B7AB                GC_NEXT_GLOBAL:      
B7AB   23                     INX   h   
B7AC   23                     INX   h   
B7AD   23                     INX   h   
B7AE   23                     INX   h   
B7AF   05                     DCR   b   
B7B0   C2 9B B7               JNZ   gc_scan_globals   
B7B3                             ; 4. 空きスロットを探す (B をカウンタに使う。gc_check_bit は B を破壊しない)
B7B3   06 00                  MVI   b,0   
B7B5                GC_FIND_FREE:      
B7B5   78                     MOV   a,b   ; A = 検査対象スロット番号
B7B6   CD 19 B8               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
B7B9   CA C6 B7               JZ   gc_found_free   
B7BC   04                     INR   b   
B7BD   78                     MOV   a,b   
B7BE   FE 10                  CPI   MAX_COL_SLOTS   
B7C0   DA B5 B7               JC   gc_find_free   
B7C3   C3 03 00               JMP   vm_error   ; 全スロット使用中
B7C6                GC_FOUND_FREE:      
B7C6   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
B7C7   F5                     PUSH   psw   ; スロット番号を退避 (col_slot_addr が A を破壊する)
B7C8   CD F0 AB               CALL   col_slot_addr   ; HL = スロットアドレス
B7CB   F1                     POP   psw   ; A = スロット番号を復帰
B7CC   C9                     RET      
B7CD                             ; --- gc_mark_reg: レジスタの val_lo からスロットを参照マーク ---
B7CD                GC_MARK_REG:      
B7CD   E5                     PUSH   h   
B7CE   C5                     PUSH   b   
B7CF   23                     INX   h   
B7D0   23                     INX   h   ; +2: val_lo
B7D1   7E                     MOV   a,m   ; A = slot + 1
B7D2   B7                     ORA   a   
B7D3   CA DF B7               JZ   gc_mark_reg_done   ; val_lo = 0 → 無効
B7D6   3D                     DCR   a   ; A = slot number
B7D7   FE 10                  CPI   MAX_COL_SLOTS   
B7D9   D2 DF B7               JNC   gc_mark_reg_done   ; 範囲外
B7DC   CD FB B7               CALL   gc_set_bit   
B7DF                GC_MARK_REG_DONE:      
B7DF   C1                     POP   b   
B7E0   E1                     POP   h   
B7E1   C3 8E B7               JMP   gc_next_reg   
B7E4                             ; --- gc_mark_global: グローバルの val_lo からスロットを参照マーク ---
B7E4                GC_MARK_GLOBAL:      
B7E4   E5                     PUSH   h   
B7E5   C5                     PUSH   b   
B7E6   23                     INX   h   
B7E7   23                     INX   h   
B7E8   7E                     MOV   a,m   
B7E9   B7                     ORA   a   
B7EA   CA F6 B7               JZ   gc_mark_gl_done   
B7ED   3D                     DCR   a   
B7EE   FE 10                  CPI   MAX_COL_SLOTS   
B7F0   D2 F6 B7               JNC   gc_mark_gl_done   
B7F3   CD FB B7               CALL   gc_set_bit   
B7F6                GC_MARK_GL_DONE:      
B7F6   C1                     POP   b   
B7F7   E1                     POP   h   
B7F8   C3 AB B7               JMP   gc_next_global   
B7FB                             ; --- gc_set_bit: A = slot (0-15) のビットを gc_bitmap に立てる ---
B7FB                GC_SET_BIT:      
B7FB   E5                     PUSH   h   
B7FC   D5                     PUSH   d   
B7FD   4F                     MOV   c,a   ; C = slot
B7FE   E6 08                  ANI   08h   ; slot >= 8?
B800   21 36 B8               LXI   h,gc_bitmap   
B803   CA 07 B8               JZ   gsb_lo   
B806   23                     INX   h   ; gc_bitmap + 1
B807                GSB_LO:      
B807   79                     MOV   a,c   
B808   E6 07                  ANI   07h   ; bit position (0-7)
B80A   5F                     MOV   e,a   
B80B   16 00                  MVI   d,0   
B80D   E5                     PUSH   h   ; ビットマップバイトアドレス退避
B80E   21 38 B8               LXI   h,gc_bit_table   
B811   19                     DAD   d   
B812   7E                     MOV   a,m   ; A = ビットマスク
B813   E1                     POP   h   ; HL = ビットマップバイト
B814   B6                     ORA   m   ; ビットを立てる
B815   77                     MOV   m,a   
B816   D1                     POP   d   
B817   E1                     POP   h   
B818   C9                     RET      
B819                             ; --- gc_check_bit: A = slot (0-15) のビットを検査 ---
B819                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
B819                GC_CHECK_BIT:      
B819   E5                     PUSH   h   
B81A   D5                     PUSH   d   
B81B   4F                     MOV   c,a   
B81C   E6 08                  ANI   08h   
B81E   21 36 B8               LXI   h,gc_bitmap   
B821   CA 25 B8               JZ   gcb_lo   
B824   23                     INX   h   
B825                GCB_LO:      
B825   79                     MOV   a,c   
B826   E6 07                  ANI   07h   
B828   5F                     MOV   e,a   
B829   16 00                  MVI   d,0   
B82B   E5                     PUSH   h   
B82C   21 38 B8               LXI   h,gc_bit_table   
B82F   19                     DAD   d   
B830   7E                     MOV   a,m   ; A = ビットマスク
B831   E1                     POP   h   
B832   A6                     ANA   m   ; テスト (Z=1 ならビットクリア)
B833   D1                     POP   d   
B834   E1                     POP   h   
B835   C9                     RET      
B836                             ; --- GC データ ---
B836   00 00        GC_BITMAP:   DB   0,0   
B838   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
B840                          END      


