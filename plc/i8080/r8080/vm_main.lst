AF28   3A 58 8A               LDA   send_reg_a   
AF2B   3C                     INR   a   
AF2C   CD 03 84               CALL   get_reg_addr   
AF2F   CD 11 AC               CALL   col_from_reg   ; HL = ソーススロット
AF32   23                     INX   h   ; +1: count
AF33   7E                     MOV   a,m   ; A = ソース文字列長
AF34   32 20 80               STA   cc_src_len   
AF37   23                     INX   h   ; HL → データ先頭
AF38   22 23 80               SHLD   cc_src_data   
AF3B                             ; R[a] のコレクションスロット (デスト)
AF3B   3A 58 8A               LDA   send_reg_a   
AF3E   CD 03 84               CALL   get_reg_addr   
AF41   CD 11 AC               CALL   col_from_reg   ; HL = デストスロット
AF44   23                     INX   h   ; +1: count
AF45   7E                     MOV   a,m   
AF46   32 21 80               STA   cc_dst_len   
AF49                             ; コピー可能バイト数を計算
AF49   3A 20 80               LDA   cc_src_len   
AF4C   47                     MOV   b,a   
AF4D   3A 21 80               LDA   cc_dst_len   
AF50   80                     ADD   b   
AF51   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
AF53   DA 68 AF               JC   cc_str_len_ok   
AF56                             ; 切り詰め
AF56   3E 22                  MVI   a,COL_MAX_STRING_LEN   
AF58   47                     MOV   b,a   
AF59   3A 21 80               LDA   cc_dst_len   
AF5C   4F                     MOV   c,a   
AF5D   78                     MOV   a,b   
AF5E   91                     SUB   c   
AF5F   32 20 80               STA   cc_src_len   
AF62   3A 21 80               LDA   cc_dst_len   
AF65   87                     ADD   a   ; ここでは使わない — 合計は MAX
AF66   3E 22                  MVI   a,COL_MAX_STRING_LEN   
AF68                CC_STR_LEN_OK:      
AF68   32 22 80               STA   cc_total_len   
AF6B                             ; count を更新
AF6B   3A 58 8A               LDA   send_reg_a   
AF6E   CD 03 84               CALL   get_reg_addr   
AF71   CD 11 AC               CALL   col_from_reg   
AF74   23                     INX   h   
AF75   3A 22 80               LDA   cc_total_len   
AF78   77                     MOV   m,a   
AF79   23                     INX   h   ; HL → データ先頭
AF7A                             ; 書き込み位置 = data + dst_len
AF7A   3A 21 80               LDA   cc_dst_len   
AF7D   5F                     MOV   e,a   
AF7E   16 00                  MVI   d,0   
AF80   19                     DAD   d   
AF81                             ; コピー
AF81   EB                     XCHG      
AF82   2A 23 80               LHLD   cc_src_data   
AF85   3A 20 80               LDA   cc_src_len   
AF88   B7                     ORA   a   
AF89   CA 95 AF               JZ   cc_str_done   
AF8C   4F                     MOV   c,a   
AF8D                CC_STR_COPY:      
AF8D   7E                     MOV   a,m   
AF8E   12                     STAX   d   
AF8F   23                     INX   h   
AF90   13                     INX   d   
AF91   0D                     DCR   c   
AF92   C2 8D AF               JNZ   cc_str_copy   
AF95                CC_STR_DONE:      
AF95                             ; R[a] をそのまま返す (破壊的操作)
AF95   C3 89 8F               JMP   vm_loop   
AF98                CONCAT_STR_INT:      
AF98                             ; R[a+1] の val_lo を 1 バイトとして追記
AF98   3A 58 8A               LDA   send_reg_a   
AF9B   3C                     INR   a   
AF9C   CD 03 84               CALL   get_reg_addr   
AF9F   CD 35 84               CALL   slot_to_value   
AFA2   4E                     MOV   c,m   ; C = 文字コード (val_lo)
AFA3                             ; R[a] のコレクションスロット
AFA3   3A 58 8A               LDA   send_reg_a   
AFA6   CD 03 84               CALL   get_reg_addr   
AFA9   CD 11 AC               CALL   col_from_reg   ; HL = デストスロット
AFAC   23                     INX   h   ; +1: count
AFAD   7E                     MOV   a,m   
AFAE   FE 22                  CPI   COL_MAX_STRING_LEN   
AFB0   D2 89 8F               JNC   vm_loop   ; 満杯なら何もしない
AFB3   34                     INR   m   ; count++
AFB4   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
AFB5   23                     INX   h   ; HL → データ先頭
AFB6   16 00                  MVI   d,0   
AFB8   19                     DAD   d   ; HL = &data[old_count]
AFB9   71                     MOV   m,c   ; 書き込み
AFBA   C3 89 8F               JMP   vm_loop   
AFBD                CONCAT_ARRAY:      
AFBD                             ; R[a] のコレクションスロット
AFBD   3A 58 8A               LDA   send_reg_a   
AFC0   CD 03 84               CALL   get_reg_addr   
AFC3   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
AFC6   23                     INX   h   ; +1: count
AFC7   7E                     MOV   a,m   
AFC8   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
AFCA   D2 03 00               JNC   vm_error   ; 満杯
AFCD   32 25 80               STA   cc_ary_count   
AFD0   34                     INR   m   ; count++
AFD1                             ; 書き込み位置: data + count * 4
AFD1   23                     INX   h   ; HL → データ先頭
AFD2   3A 25 80               LDA   cc_ary_count   
AFD5   87                     ADD   a   ; ×2
AFD6   87                     ADD   a   ; ×4
AFD7   5F                     MOV   e,a   
AFD8   16 00                  MVI   d,0   
AFDA   19                     DAD   d   ; HL = 書き込み位置
AFDB   EB                     XCHG      ; DE = 書き込み位置
AFDC                             ; R[a+1] をコピー
AFDC   3A 58 8A               LDA   send_reg_a   
AFDF   3C                     INR   a   
AFE0   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
AFE3   0E 04                  MVI   c,SLOT_BYTES   
AFE5                CC_ARY_COPY:      
AFE5   7E                     MOV   a,m   
AFE6   12                     STAX   d   
AFE7   23                     INX   h   
AFE8   13                     INX   d   
AFE9   0D                     DCR   c   
AFEA   C2 E5 AF               JNZ   cc_ary_copy   
AFED   C3 89 8F               JMP   vm_loop   
AFF0                             ; --- concat 一時変数 ---
AFF0                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
AFF0                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
AFF0                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
AFF0                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
AFF0                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
AFF0                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
AFF0                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
AFF0                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
AFF0                             ; vm_hash.a80 — Hash (連想配列) ハンドラ
AFF0                             ; 
AFF0                             ; メインコード領域 (0x8400-0xAFFF) に空きがないため、
AFF0                             ; コレクションプール末尾の後 (0xB520) にオーバーフロー配置する。
AFF0                             ; 
AFF0                             ; Hash スロット形式 (コレクションプール 36B スロット内):
AFF0                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
AFF0                             ;   +1: count (1B)  ペア数 (最大 4)
AFF0                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
AFF0                             ; 
AFF0                             ; キー検索は線形 4 バイト比較。
AFF0                             ; 
AFF0                             ; do_op_array2 もメインコード領域から溢れたためここに配置。
B520                          .ORG   0B520h   
B520                             ; ===============================================================
B520                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
B520                             ; 
B520                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
B520                             ; ===============================================================
B520                DO_OP_ARRAY2:      
B520   CD C3 84               CALL   fetch_byte   ; A = a (書き込み先)
B523   32 ED AD               STA   oary_reg_a   
B526   CD C3 84               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
B529   32 EE AD               STA   oary_src_reg   
B52C   CD C3 84               CALL   fetch_byte   ; A = c (要素数)
B52F   C3 82 AD               JMP   oa2_join   
B532                             ; ===============================================================
B532                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
B532                             ; 
B532                             ;   a = 書き込み先レジスタ
B532                             ;   b = ペア数 (0 = 空 Hash)
B532                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
B532                             ; ===============================================================
B532                DO_OP_HASH:      
B532   CD C3 84               CALL   fetch_byte   ; A = a (書き込み先)
B535   32 9A B5               STA   hash_reg_a   
B538   CD C3 84               CALL   fetch_byte   ; A = b (ペア数)
B53B   32 9B B5               STA   hash_count   
B53E                             ; コレクションスロット確保
B53E   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B541   32 9C B5               STA   hash_slot_num   
B544                             ; ヘッダ書き込み
B544   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
B546   23                     INX   h   
B547   3A 9B B5               LDA   hash_count   
B54A   77                     MOV   m,a   ; +1: count
B54B   23                     INX   h   ; HL → データ領域先頭
B54C                             ; ペアがなければ結果書き込みへ
B54C   3A 9B B5               LDA   hash_count   
B54F   B7                     ORA   a   
B550   CA 83 B5               JZ   hash_write_result   
B553                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
B553   3A 9A B5               LDA   hash_reg_a   
B556   32 9D B5               STA   hash_src_reg   
B559                HASH_COPY_PAIR:      
B559                             ; HL = コレクションプール内の書き込み位置
B559                             ; key (4B) をコピー: R[src] → [HL]
B559   E5                     PUSH   h   ; 書き込み先を退避
B55A   3A 9D B5               LDA   hash_src_reg   
B55D   CD 03 84               CALL   get_reg_addr   ; HL = R[src]
B560   D1                     POP   d   ; DE = 書き込み先
B561   CD 28 84               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
B564                             ; DE = value 書き込み位置
B564                             ; value (4B) をコピー: R[src+1] → [DE]
B564   D5                     PUSH   d   ; value 書き込み先を退避
B565   3A 9D B5               LDA   hash_src_reg   
B568   3C                     INR   a   
B569   CD 03 84               CALL   get_reg_addr   ; HL = R[src+1]
B56C   D1                     POP   d   ; DE = value 書き込み先
B56D   CD 28 84               CALL   copy_slot   ; 4B コピー
B570                             ; DE = 次ペアの先頭
B570                             ; ソースレジスタを +2
B570   3A 9D B5               LDA   hash_src_reg   
B573   C6 02                  ADI   2   
B575   32 9D B5               STA   hash_src_reg   
B578                             ; HL = 次の書き込み位置 (DE から)
B578   EB                     XCHG      
B579                             ; ペアカウンタ
B579   3A 9B B5               LDA   hash_count   
B57C   3D                     DCR   a   
B57D   32 9B B5               STA   hash_count   
B580   C2 59 B5               JNZ   hash_copy_pair   
B583                HASH_WRITE_RESULT:      
B583                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
B583   3A 9A B5               LDA   hash_reg_a   
B586   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B589   36 09                  MVI   m,TT_HASH   ; +0: type
B58B   23                     INX   h   
B58C   36 00                  MVI   m,0   ; +1: reserved
B58E   23                     INX   h   
B58F   3A 9C B5               LDA   hash_slot_num   
B592   3C                     INR   a   ; slot + 1
B593   77                     MOV   m,a   ; +2: val_lo
B594   23                     INX   h   
B595   36 00                  MVI   m,0   ; +3: val_hi
B597   C3 89 8F               JMP   vm_loop   
B59A                             ; --- do_op_hash データ ---
B59A   00           HASH_REG_A:   DB   0   
B59B   00           HASH_COUNT:   DB   0   
B59C   00           HASH_SLOT_NUM:   DB   0   
B59D   00           HASH_SRC_REG:   DB   0   
B59E                             ; ===============================================================
B59E                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
B59E                             ; 
B59E                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
B59E                             ;   キーが見つからなければ R[a] = nil
B59E                             ; ===============================================================
B59E                GIDX_HASH:      
B59E                             ; コレクションスロットを取得
B59E   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
B5A1   23                     INX   h   ; +1: count
B5A2   7E                     MOV   a,m   ; A = ペア数
B5A3   23                     INX   h   ; HL → データ領域
B5A4   B7                     ORA   a   
B5A5   CA F1 B5               JZ   ghash_not_found   ; 空 Hash
B5A8   32 05 B6               STA   ghash_loop_cnt   
B5AB   22 FF B5               SHLD   ghash_data_ptr   
B5AE                             ; 検索キー R[a+1] のアドレスを取得
B5AE   3A BC AC               LDA   gidx_reg_a   
B5B1   3C                     INR   a   
B5B2   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B5B5   22 01 B6               SHLD   ghash_key_ptr   
B5B8                             ; 検索ループ
B5B8   2A FF B5               LHLD   ghash_data_ptr   
B5BB                GHASH_SEARCH:      
B5BB   22 03 B6               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
B5BE                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
B5BE   E5                     PUSH   h   
B5BF   2A 01 B6               LHLD   ghash_key_ptr   
B5C2   EB                     XCHG      ; DE = 検索キー
B5C3   E1                     POP   h   ; HL = hash ペアのキー
B5C4   0E 04                  MVI   c,SLOT_BYTES   
B5C6                GHASH_CMP:      
B5C6   1A                     LDAX   d   
B5C7   BE                     CMP   m   
B5C8   C2 E0 B5               JNZ   ghash_next   
B5CB   23                     INX   h   
B5CC   13                     INX   d   
B5CD   0D                     DCR   c   
B5CE   C2 C6 B5               JNZ   ghash_cmp   
B5D1                             ; 一致! HL = value 位置 (キー直後)
B5D1                             ; value (4B) を R[a] にコピー
B5D1   E5                     PUSH   h   ; value ソース
B5D2   3A BC AC               LDA   gidx_reg_a   
B5D5   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B5D8   EB                     XCHG      ; DE = R[a] (コピー先)
B5D9   E1                     POP   h   ; HL = value (コピー元)
B5DA   CD 28 84               CALL   copy_slot   
B5DD   C3 89 8F               JMP   vm_loop   
B5E0                GHASH_NEXT:      
B5E0                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
B5E0   2A 03 B6               LHLD   ghash_cur_ptr   
B5E3   11 08 00               LXI   d,HASH_PAIR_BYTES   
B5E6   19                     DAD   d   
B5E7   3A 05 B6               LDA   ghash_loop_cnt   
B5EA   3D                     DCR   a   
B5EB   32 05 B6               STA   ghash_loop_cnt   
B5EE   C2 BB B5               JNZ   ghash_search   
B5F1                GHASH_NOT_FOUND:      
B5F1                             ; R[a] = nil
B5F1   3A BC AC               LDA   gidx_reg_a   
B5F4   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B5F7   3E 01                  MVI   a,TT_NIL   
B5F9   CD 1D 84               CALL   set_slot_special   
B5FC   C3 89 8F               JMP   vm_loop   
B5FF                             ; --- gidx_hash データ ---
B5FF   00 00        GHASH_DATA_PTR:   DW   0   
B601   00 00        GHASH_KEY_PTR:   DW   0   
B603   00 00        GHASH_CUR_PTR:   DW   0   
B605   00           GHASH_LOOP_CNT:   DB   0   
B606                             ; ===============================================================
B606                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
B606                             ; 
B606                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
B606                             ;   既存キー → 値を上書き
B606                             ;   新規キー → count < MAX なら末尾に追加
B606                             ; ===============================================================
B606                SIDX_HASH:      
B606                             ; コレクションスロットを取得
B606   CD 11 AC               CALL   col_from_reg   ; HL = コレクションスロット
B609   22 95 B6               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
B60C   23                     INX   h   ; +1: count
B60D   7E                     MOV   a,m   
B60E   32 9F B6               STA   shash_pair_cnt   ; 元のペア数
B611   23                     INX   h   ; HL → データ領域
B612   22 97 B6               SHLD   shash_data_ptr   
B615                             ; R[a+1] キーのアドレス
B615   3A 73 AD               LDA   sidx_reg_a   
B618   3C                     INR   a   
B619   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B61C   22 99 B6               SHLD   shash_key_ptr   
B61F                             ; R[a+2] 値のアドレス
B61F   3A 73 AD               LDA   sidx_reg_a   
B622   C6 02                  ADI   2   
B624   CD 03 84               CALL   get_reg_addr   ; HL = R[a+2]
B627   22 9B B6               SHLD   shash_val_ptr   
B62A                             ; 既存キーを検索
B62A   3A 9F B6               LDA   shash_pair_cnt   
B62D   B7                     ORA   a   
B62E   CA 68 B6               JZ   shash_append   ; 空 Hash → 追加
B631   32 A0 B6               STA   shash_loop_cnt   
B634   2A 97 B6               LHLD   shash_data_ptr   
B637                SHASH_SEARCH:      
B637   22 9D B6               SHLD   shash_cur_ptr   
B63A   E5                     PUSH   h   
B63B   2A 99 B6               LHLD   shash_key_ptr   
B63E   EB                     XCHG      ; DE = 検索キー
B63F   E1                     POP   h   ; HL = hash ペアのキー
B640   0E 04                  MVI   c,SLOT_BYTES   
B642                SHASH_CMP:      
B642   1A                     LDAX   d   
B643   BE                     CMP   m   
B644   C2 57 B6               JNZ   shash_snext   
B647   23                     INX   h   
B648   13                     INX   d   
B649   0D                     DCR   c   
B64A   C2 42 B6               JNZ   shash_cmp   
B64D                             ; 一致! HL = value 位置
B64D                             ; R[a+2] を value にコピー
B64D   EB                     XCHG      ; DE = hash value 位置
B64E   2A 9B B6               LHLD   shash_val_ptr   ; HL = R[a+2]
B651   CD 28 84               CALL   copy_slot   
B654   C3 89 8F               JMP   vm_loop   
B657                SHASH_SNEXT:      
B657   2A 9D B6               LHLD   shash_cur_ptr   
B65A   11 08 00               LXI   d,HASH_PAIR_BYTES   
B65D   19                     DAD   d   
B65E   3A A0 B6               LDA   shash_loop_cnt   
B661   3D                     DCR   a   
B662   32 A0 B6               STA   shash_loop_cnt   
B665   C2 37 B6               JNZ   shash_search   
B668                             ; 見つからなかった → 末尾に追加
B668                SHASH_APPEND:      
B668                             ; 容量チェック
B668   3A 9F B6               LDA   shash_pair_cnt   
B66B   FE 04                  CPI   COL_MAX_HASH_PAIRS   
B66D   D2 03 00               JNC   vm_error   ; Hash 満杯
B670                             ; count++ を書き込み
B670   3C                     INR   a   
B671   F5                     PUSH   psw   
B672   2A 95 B6               LHLD   shash_col_ptr   
B675   23                     INX   h   ; +1: count フィールド
B676   77                     MOV   m,a   
B677   F1                     POP   psw   
B678                             ; 追加位置 = data + old_count * 8
B678   3A 9F B6               LDA   shash_pair_cnt   ; old count
B67B   87                     ADD   a   ; ×2
B67C   87                     ADD   a   ; ×4
B67D   87                     ADD   a   ; ×8
B67E   5F                     MOV   e,a   
B67F   16 00                  MVI   d,0   
B681   2A 97 B6               LHLD   shash_data_ptr   
B684   19                     DAD   d   ; HL = 追加位置
B685                             ; key をコピー (R[a+1] → [HL])
B685   EB                     XCHG      ; DE = 追加位置
B686   2A 99 B6               LHLD   shash_key_ptr   ; HL = R[a+1]
B689   CD 28 84               CALL   copy_slot   ; key 4B、DE は value 位置に進む
B68C                             ; value をコピー (R[a+2] → [DE])
B68C   2A 9B B6               LHLD   shash_val_ptr   ; HL = R[a+2]
B68F                             ; DE は既に value 位置
B68F   CD 28 84               CALL   copy_slot   
B692   C3 89 8F               JMP   vm_loop   
B695                             ; --- sidx_hash データ ---
B695   00 00        SHASH_COL_PTR:   DW   0   
B697   00 00        SHASH_DATA_PTR:   DW   0   
B699   00 00        SHASH_KEY_PTR:   DW   0   
B69B   00 00        SHASH_VAL_PTR:   DW   0   
B69D   00 00        SHASH_CUR_PTR:   DW   0   
B69F   00           SHASH_PAIR_CNT:   DB   0   
B6A0   00           SHASH_LOOP_CNT:   DB   0   
B6A1                             ; ===============================================================
B6A1                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
B6A1                             ; 
B6A1                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
B6A1                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
B6A1                             ; ROM がなければ即 nil。
B6A1                             ; 
B6A1                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
B6A1                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
B6A1                             ; ===============================================================
B6A1                SEND_GETKEY_TIMEOUT:      
B6A1                             ; R[a+1] からタイムアウト回数を読む
B6A1   3A 58 8A               LDA   send_reg_a   
B6A4   C6 01                  ADI   1   
B6A6   CD 03 84               CALL   get_reg_addr   ; HL = R[a+1]
B6A9   23                     INX   h   
B6AA   23                     INX   h   ; +2: val_lo
B6AB   4E                     MOV   c,m   
B6AC   23                     INX   h   ; +3: val_hi
B6AD   46                     MOV   b,m   ; BC = タイムアウト回数
B6AE                             ; ROM チェック
B6AE   3A 47 06               LDA   KEY_ADDR   
B6B1   B7                     ORA   a   
B6B2   CA DC B6               JZ   getkey_timeout_nil   ; ROM なし → nil
B6B5                GETKEY_POLL_LOOP:      
B6B5   78                     MOV   a,b   
B6B6   B1                     ORA   c   
B6B7   CA DC B6               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
B6BA   C5                     PUSH   b   ; カウンタ退避
B6BB   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
B6BE   C1                     POP   b   ; カウンタ復帰
B6BF   FE FF                  CPI   0FFh   
B6C1   C2 CD B6               JNZ   getkey_timeout_got   ; キー押下!
B6C4   C5                     PUSH   b   ; カウンタ退避
B6C5   CD 8D AB               CALL   lfsr_next   ; 待機中に LFSR を進める
B6C8   C1                     POP   b   
B6C9   0B                     DCX   b   ; カウンタ--
B6CA   C3 B5 B6               JMP   getkey_poll_loop   
B6CD                GETKEY_TIMEOUT_GOT:      
B6CD                             ; A = キーコード (0x00-0x17)
B6CD   4F                     MOV   c,a   
B6CE   06 00                  MVI   b,0   
B6D0   3A 58 8A               LDA   send_reg_a   
B6D3   CD 03 84               CALL   get_reg_addr   
B6D6   CD 13 84               CALL   set_slot_int16   
B6D9   C3 89 8F               JMP   vm_loop   
B6DC                GETKEY_TIMEOUT_NIL:      
B6DC   3A 58 8A               LDA   send_reg_a   
B6DF   CD 03 84               CALL   get_reg_addr   
B6E2   3E 01                  MVI   a,TT_NIL   
B6E4   CD 1D 84               CALL   set_slot_special   
B6E7   C3 89 8F               JMP   vm_loop   
B6EA                             ; ===============================================================
B6EA                             ; send_slice — [](offset, length): 文字列スライス
B6EA                             ; 
B6EA                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
B6EA                             ; 
B6EA                             ;   入力: send_reg_a = a, send_argc = 2
B6EA                             ;         R[a] = TT_STRING (対象文字列)
B6EA                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
B6EA                             ;         R[a+2] = length (TT_INTEGER)
B6EA                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
B6EA                             ;         offset >= 文字列長 → 空文字列
B6EA                             ;         length は利用可能バイト数にクランプ
B6EA                             ; ===============================================================
B6EA                SEND_SLICE:      
B6EA                             ; R[a] が TT_STRING か確認
B6EA   3A 58 8A               LDA   send_reg_a   
B6ED   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B6F0   7E                     MOV   a,m   ; A = 型タグ
B6F1   FE 07                  CPI   TT_STRING   
B6F3   C2 03 00               JNZ   vm_error   
B6F6                             ; ソース文字列のコレクションスロットを取得
B6F6   3A 58 8A               LDA   send_reg_a   
B6F9   CD 03 84               CALL   get_reg_addr   
B6FC   CD 11 AC               CALL   col_from_reg   ; HL = collection slot
B6FF   23                     INX   h   ; +1: count
B700   7E                     MOV   a,m   
B701   32 91 B7               STA   slice_src_count   
B704   23                     INX   h   ; HL → data
B705   22 92 B7               SHLD   slice_src_data   
B708                             ; R[a+1] から offset を取得
B708   3A 58 8A               LDA   send_reg_a   
B70B   C6 01                  ADI   1   
B70D   CD 03 84               CALL   get_reg_addr   
B710   CD 35 84               CALL   slot_to_value   
B713   7E                     MOV   a,m   ; A = offset (val_lo)
B714   32 94 B7               STA   slice_offset   
B717                             ; R[a+2] から length を取得
B717   3A 58 8A               LDA   send_reg_a   
B71A   C6 02                  ADI   2   
B71C   CD 03 84               CALL   get_reg_addr   
B71F   CD 35 84               CALL   slot_to_value   
B722   7E                     MOV   a,m   ; A = length (val_lo)
B723   32 95 B7               STA   slice_length   
B726                             ; offset >= src_count → 空文字列
B726   3A 94 B7               LDA   slice_offset   
B729   47                     MOV   b,a   ; B = offset
B72A   3A 91 B7               LDA   slice_src_count   ; A = src_count
B72D   B8                     CMP   b   
B72E   DA 83 B7               JC   slice_empty   ; src_count < offset
B731   CA 83 B7               JZ   slice_empty   ; src_count == offset
B734                             ; available = src_count - offset
B734   90                     SUB   b   ; A = available
B735   47                     MOV   b,a   ; B = available
B736   3A 95 B7               LDA   slice_length   
B739   B8                     CMP   b   
B73A   DA 3E B7               JC   slice_len_ok   ; length < available → そのまま
B73D   78                     MOV   a,b   ; clamp: length = available
B73E                SLICE_LEN_OK:      
B73E   32 95 B7               STA   slice_length   ; 実際のコピー長
B741                             ; 新しいコレクションスロットを確保
B741   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B744   32 96 B7               STA   slice_new_slot   
B747   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
B749   23                     INX   h   
B74A   3A 95 B7               LDA   slice_length   
B74D   77                     MOV   m,a   ; +1: count = コピー長
B74E   23                     INX   h   ; HL → new data area
B74F                             ; ソースデータ先頭 + offset
B74F   E5                     PUSH   h   ; dest を退避
B750   2A 92 B7               LHLD   slice_src_data   
B753   3A 94 B7               LDA   slice_offset   
B756   5F                     MOV   e,a   
B757   16 00                  MVI   d,0   
B759   19                     DAD   d   ; HL = src_data + offset
B75A   EB                     XCHG      ; DE = src + offset
B75B   E1                     POP   h   ; HL = dest
B75C                             ; バイトコピー
B75C   3A 95 B7               LDA   slice_length   
B75F   B7                     ORA   a   
B760   CA 6C B7               JZ   slice_done   
B763   4F                     MOV   c,a   
B764                SLICE_COPY:      
B764   1A                     LDAX   d   
B765   77                     MOV   m,a   
B766   23                     INX   h   
B767   13                     INX   d   
B768   0D                     DCR   c   
B769   C2 64 B7               JNZ   slice_copy   
B76C                SLICE_DONE:      
B76C                             ; R[a] = TT_STRING, val_lo = new_slot + 1
B76C   3A 58 8A               LDA   send_reg_a   
B76F   CD 03 84               CALL   get_reg_addr   
B772   36 07                  MVI   m,TT_STRING   ; +0: type
B774   23                     INX   h   
B775   36 00                  MVI   m,0   ; +1: reserved
B777   23                     INX   h   
B778   3A 96 B7               LDA   slice_new_slot   
B77B   3C                     INR   a   ; slot + 1
B77C   77                     MOV   m,a   ; +2: val_lo
B77D   23                     INX   h   
B77E   36 00                  MVI   m,0   ; +3: val_hi
B780   C3 89 8F               JMP   vm_loop   
B783                SLICE_EMPTY:      
B783                             ; 空文字列を返す
B783   CD FC AB               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
B786   32 96 B7               STA   slice_new_slot   
B789   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
B78B   23                     INX   h   
B78C   36 00                  MVI   m,0   ; +1: count = 0
B78E   C3 6C B7               JMP   slice_done   
B791                             ; --- send_slice データ ---
B791   00           SLICE_SRC_COUNT:   DB   0   
B792   00 00        SLICE_SRC_DATA:   DW   0   
B794   00           SLICE_OFFSET:   DB   0   
B795   00           SLICE_LENGTH:   DB   0   
B796   00           SLICE_NEW_SLOT:   DB   0   
B797                             ; ===============================================================
B797                             ; col_gc_alloc — 簡易 GC 付きコレクションスロット確保
B797                             ; 
B797                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
B797                             ; レジスタファイル全体とグローバル変数をスキャンして参照ビットマップを構築し、
B797                             ; 未参照のスロットを見つけて再利用する。
B797                             ; 
B797                             ; スキャン対象:
B797                             ;   - レジスタファイル (64 スロット): TT_STRING / TT_ARRAY / TT_HASH
B797                             ;   - グローバル変数 (64 スロット): 同上
B797                             ; 
B797                             ; 注意: 配列要素・Hash 値からの間接参照はスキャンしない (保守的)。
B797                             ;       配列/Hash 自体が参照されていればそのスロットは保持される。
B797                             ; 
B797                             ;   出力: A = スロット番号, HL = スロットアドレス
B797                             ;   エラー: 全スロット使用中 → vm_error
B797                             ; ===============================================================
B797                COL_GC_ALLOC:      
B797                             ; 1. ビットマップクリア (16 スロット = 2 バイト)
B797   AF                     XRA   a   
B798   32 5B B8               STA   gc_bitmap   
B79B   32 5C B8               STA   gc_bitmap + 1   
B79E                             ; 2. レジスタファイル全体をスキャン (64 スロット × 4B)
B79E   21 00 81               LXI   h,REG_FILE_BASE   
B7A1   06 40                  MVI   b,MAX_REGS   
B7A3                GC_SCAN_REGS:      
B7A3   7E                     MOV   a,m   ; A = 型タグ
B7A4   FE 07                  CPI   TT_STRING   
B7A6   CA F2 B7               JZ   gc_mark_reg   
B7A9   FE 08                  CPI   TT_ARRAY   
B7AB   CA F2 B7               JZ   gc_mark_reg   
B7AE   FE 09                  CPI   TT_HASH   
B7B0   CA F2 B7               JZ   gc_mark_reg   
B7B3                GC_NEXT_REG:      
B7B3   23                     INX   h   
B7B4   23                     INX   h   
B7B5   23                     INX   h   
B7B6   23                     INX   h   ; HL += SLOT_BYTES
B7B7   05                     DCR   b   
B7B8   C2 A3 B7               JNZ   gc_scan_regs   
B7BB                             ; 3. グローバル変数をスキャン (64 スロット × 4B)
B7BB   21 00 B0               LXI   h,GLOBALS_BASE   
B7BE   06 40                  MVI   b,MAX_REGS   ; MAX_GLOBALS = MAX_REGS = 64
B7C0                GC_SCAN_GLOBALS:      
B7C0   7E                     MOV   a,m   
B7C1   FE 07                  CPI   TT_STRING   
B7C3   CA 09 B8               JZ   gc_mark_global   
B7C6   FE 08                  CPI   TT_ARRAY   
B7C8   CA 09 B8               JZ   gc_mark_global   
B7CB   FE 09                  CPI   TT_HASH   
B7CD   CA 09 B8               JZ   gc_mark_global   
B7D0                GC_NEXT_GLOBAL:      
B7D0   23                     INX   h   
B7D1   23                     INX   h   
B7D2   23                     INX   h   
B7D3   23                     INX   h   
B7D4   05                     DCR   b   
B7D5   C2 C0 B7               JNZ   gc_scan_globals   
B7D8                             ; 4. 空きスロットを探す (B をカウンタに使う。gc_check_bit は B を破壊しない)
B7D8   06 00                  MVI   b,0   
B7DA                GC_FIND_FREE:      
B7DA   78                     MOV   a,b   ; A = 検査対象スロット番号
B7DB   CD 3E B8               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
B7DE   CA EB B7               JZ   gc_found_free   
B7E1   04                     INR   b   
B7E2   78                     MOV   a,b   
B7E3   FE 10                  CPI   MAX_COL_SLOTS   
B7E5   DA DA B7               JC   gc_find_free   
B7E8   C3 03 00               JMP   vm_error   ; 全スロット使用中
B7EB                GC_FOUND_FREE:      
B7EB   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
B7EC   F5                     PUSH   psw   ; スロット番号を退避 (col_slot_addr が A を破壊する)
B7ED   CD EC AB               CALL   col_slot_addr   ; HL = スロットアドレス
B7F0   F1                     POP   psw   ; A = スロット番号を復帰
B7F1   C9                     RET      
B7F2                             ; --- gc_mark_reg: レジスタの val_lo からスロットを参照マーク ---
B7F2                GC_MARK_REG:      
B7F2   E5                     PUSH   h   
B7F3   C5                     PUSH   b   
B7F4   23                     INX   h   
B7F5   23                     INX   h   ; +2: val_lo
B7F6   7E                     MOV   a,m   ; A = slot + 1
B7F7   B7                     ORA   a   
B7F8   CA 04 B8               JZ   gc_mark_reg_done   ; val_lo = 0 → 無効
B7FB   3D                     DCR   a   ; A = slot number
B7FC   FE 10                  CPI   MAX_COL_SLOTS   
B7FE   D2 04 B8               JNC   gc_mark_reg_done   ; 範囲外
B801   CD 20 B8               CALL   gc_set_bit   
B804                GC_MARK_REG_DONE:      
B804   C1                     POP   b   
B805   E1                     POP   h   
B806   C3 B3 B7               JMP   gc_next_reg   
B809                             ; --- gc_mark_global: グローバルの val_lo からスロットを参照マーク ---
B809                GC_MARK_GLOBAL:      
B809   E5                     PUSH   h   
B80A   C5                     PUSH   b   
B80B   23                     INX   h   
B80C   23                     INX   h   
B80D   7E                     MOV   a,m   
B80E   B7                     ORA   a   
B80F   CA 1B B8               JZ   gc_mark_gl_done   
B812   3D                     DCR   a   
B813   FE 10                  CPI   MAX_COL_SLOTS   
B815   D2 1B B8               JNC   gc_mark_gl_done   
B818   CD 20 B8               CALL   gc_set_bit   
B81B                GC_MARK_GL_DONE:      
B81B   C1                     POP   b   
B81C   E1                     POP   h   
B81D   C3 D0 B7               JMP   gc_next_global   
B820                             ; --- gc_set_bit: A = slot (0-15) のビットを gc_bitmap に立てる ---
B820                GC_SET_BIT:      
B820   E5                     PUSH   h   
B821   D5                     PUSH   d   
B822   4F                     MOV   c,a   ; C = slot
B823   E6 08                  ANI   08h   ; slot >= 8?
B825   21 5B B8               LXI   h,gc_bitmap   
B828   CA 2C B8               JZ   gsb_lo   
B82B   23                     INX   h   ; gc_bitmap + 1
B82C                GSB_LO:      
B82C   79                     MOV   a,c   
B82D   E6 07                  ANI   07h   ; bit position (0-7)
B82F   5F                     MOV   e,a   
B830   16 00                  MVI   d,0   
B832   E5                     PUSH   h   ; ビットマップバイトアドレス退避
B833   21 5D B8               LXI   h,gc_bit_table   
B836   19                     DAD   d   
B837   7E                     MOV   a,m   ; A = ビットマスク
B838   E1                     POP   h   ; HL = ビットマップバイト
B839   B6                     ORA   m   ; ビットを立てる
B83A   77                     MOV   m,a   
B83B   D1                     POP   d   
B83C   E1                     POP   h   
B83D   C9                     RET      
B83E                             ; --- gc_check_bit: A = slot (0-15) のビットを検査 ---
B83E                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
B83E                GC_CHECK_BIT:      
B83E   E5                     PUSH   h   
B83F   D5                     PUSH   d   
B840   4F                     MOV   c,a   
B841   E6 08                  ANI   08h   
B843   21 5B B8               LXI   h,gc_bitmap   
B846   CA 4A B8               JZ   gcb_lo   
B849   23                     INX   h   
B84A                GCB_LO:      
B84A   79                     MOV   a,c   
B84B   E6 07                  ANI   07h   
B84D   5F                     MOV   e,a   
B84E   16 00                  MVI   d,0   
B850   E5                     PUSH   h   
B851   21 5D B8               LXI   h,gc_bit_table   
B854   19                     DAD   d   
B855   7E                     MOV   a,m   ; A = ビットマスク
B856   E1                     POP   h   
B857   A6                     ANA   m   ; テスト (Z=1 ならビットクリア)
B858   D1                     POP   d   
B859   E1                     POP   h   
B85A   C9                     RET      
B85B                             ; --- GC データ ---
B85B   00 00        GC_BITMAP:   DB   0,0   
B85D   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
B865                             ; ===============================================================
B865                             ; sendb_each — Array#each: 配列要素を反復
B865                             ; 
B865                             ;   R[a] = TT_ARRAY (レシーバ)
B865                             ;   R[a+argc+1] = TT_PROC (ブロック)
B865                             ;   各反復で R[1] = array[index]
B865                             ; 
B865                             ; FRAME_KIND_EACH フレームを使い、フレーム +11 (reserved) に
B865                             ; コレクションスロット番号を格納する。
B865                             ; ===============================================================
B865                SENDB_EACH:      
B865                             ; R[a] が TT_ARRAY か確認
B865   3A AE 8C               LDA   sendb_reg_a   
B868   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
B86B   7E                     MOV   a,m   
B86C   FE 08                  CPI   TT_ARRAY   
B86E   C2 03 00               JNZ   vm_error   
B871                             ; コレクションスロット番号を取得
B871   3A AE 8C               LDA   sendb_reg_a   
B874   CD 03 84               CALL   get_reg_addr   
B877   CD 35 84               CALL   slot_to_value   ; HL = 値先頭
B87A   7E                     MOV   a,m   ; val_lo = slot + 1
B87B   3D                     DCR   a   ; slot number (0-based)
B87C   32 F1 B8               STA   each_col_slot   
B87F                             ; 要素数を読む
B87F   3A F1 B8               LDA   each_col_slot   
B882   CD EC AB               CALL   col_slot_addr   ; HL = スロットアドレス
B885   23                     INX   h   ; +1: count
B886   7E                     MOV   a,m   
B887   32 F2 B8               STA   each_count   
B88A   B7                     ORA   a   
B88B   CA 89 8F               JZ   vm_loop   ; 空配列 → ブロック実行しない
B88E                             ; ブロック (TT_PROC) の情報を読む
B88E   3A B0 8C               LDA   sendb_argc   
B891   3C                     INR   a   ; argc + 1
B892   47                     MOV   b,a   
B893   3A AE 8C               LDA   sendb_reg_a   
B896   80                     ADD   b   ; A = a + argc + 1
B897   CD 03 84               CALL   get_reg_addr   ; HL = R[a+argc+1]
B89A   CD 35 84               CALL   slot_to_value   
B89D   7E                     MOV   a,m   ; irep 番号
B89E   32 B2 8C               STA   sendb_block_irep   
B8A1   23                     INX   h   
B8A2   7E                     MOV   a,m   ; outer
B8A3   32 B3 8C               STA   sendb_block_outer   
B8A6                             ; push_frame(a, FRAME_KIND_EACH, outer)
B8A6   3A AE 8C               LDA   sendb_reg_a   
B8A9   06 02                  MVI   b,FRAME_KIND_EACH   
B8AB   3A B3 8C               LDA   sendb_block_outer   
B8AE   4F                     MOV   c,a   
B8AF   3A AE 8C               LDA   sendb_reg_a   
B8B2   CD A7 8A               CALL   push_frame   
B8B5                             ; フレームに limit = count - 1 を設定
B8B5   CD A0 8A               CALL   cur_frame_addr   
B8B8   11 08 00               LXI   d,FRAME_OFF_LIMIT   
B8BB   19                     DAD   d   
B8BC   3A F2 B8               LDA   each_count   
B8BF   3D                     DCR   a   ; limit = count - 1
B8C0   77                     MOV   m,a   ; limit_lo
B8C1   23                     INX   h   
B8C2   36 00                  MVI   m,0   ; limit_hi
B8C4                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
B8C4   CD A0 8A               CALL   cur_frame_addr   
B8C7   11 0B 00               LXI   d,11   
B8CA   19                     DAD   d   
B8CB   3A F1 B8               LDA   each_col_slot   
B8CE   77                     MOV   m,a   
B8CF                             ; R[1] = array[0] (最初の要素)
B8CF   3A F1 B8               LDA   each_col_slot   
B8D2   CD EC AB               CALL   col_slot_addr   ; HL = スロットアドレス
B8D5   23                     INX   h   ; skip type
B8D6   23                     INX   h   ; skip count → data[0]
B8D7                             ; data[0] を R[1] にコピー (4 バイト)
B8D7   E5                     PUSH   h   ; source 退避
B8D8   3E 01                  MVI   a,1   
B8DA   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
B8DD   EB                     XCHG      ; DE = R[1] (dest)
B8DE   E1                     POP   h   ; HL = data[0] (source)
B8DF   CD 28 84               CALL   copy_slot   
B8E2                             ; 子 irep に切り替え
B8E2   3A B2 8C               LDA   sendb_block_irep   
B8E5   CD 2C 8B               CALL   switch_irep   
B8E8                             ; PC = 0
B8E8   21 00 00               LXI   h,0   
B8EB   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
B8EE   C3 89 8F               JMP   vm_loop   
B8F1                             ; --- sendb_each データ ---
B8F1   00           EACH_COL_SLOT:   DB   0   
B8F2   00           EACH_COUNT:   DB   0   
B8F3                          END      


