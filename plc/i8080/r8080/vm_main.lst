2492   7E                     MOV   a,m   
2493   12                     STAX   d   
2494   23                     INX   h   
2495   13                     INX   d   
2496   0D                     DCR   c   
2497   C2 92 24               JNZ   scat_copy   
249A                             ; 
249A                SCAT_DONE:      
249A   C3 78 1D               JMP   vm_loop   
249D                             ; 
249D   00           SCAT_REG_A:   DB   0   
249E   00           SCAT_SRC_LEN:   DB   0   
249F   00           SCAT_DST_LEN:   DB   0   
24A0   00           SCAT_TOTAL_LEN:   DB   0   
24A1   00 00        SCAT_SRC_DATA:   DW   0   
