0000                             ; vm_main.a80 — faRuby i8080 VM エントリポイント
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (32KB RAM: 0x8000-0xFFFF) を想定。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; --- メモリマップ ---
0000                VM_CODE_ORG:   EQU   8400h   
0000                BYTECODE_BASE:   EQU   9000h   
0000                BYTECODE_SIZE:   EQU   1000h   
0000                POOL_BASE:   EQU   0A000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                             ; --- バリュースロット ---
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; --- VM 状態領域のオフセット ---
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                             ; --- IREP テーブルエントリ ---
0000                IREP_ENTRY_BYTES:   EQU   08h   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; --- VM 実行状態 ---
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   0B000h   
0000                             ; --- Phase 1 オペコード ---
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
8400                          .ORG   08400h   
8400                             ; ===============================================================
8400                             ; リセットベクタ
8400                             ; ===============================================================
8400   C3 84 89               JMP   vm_start   
8403                             ; ===============================================================
8403                             ; サブルーチン群 (.include で取り込む)
8403                             ; ===============================================================
8403                             ; vm_util.a80 — ユーティリティサブルーチン
8403                             ; 
8403                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
8403                             ; 他のすべてのモジュールがここに依存します。
8403                             ; 
8403                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
8403                             ;   +0: 型タグ (1B)
8403                             ;   +1: 予約   (1B, 常に 0)
8403                             ;   +2: val_lo (1B)
8403                             ;   +3: val_hi (1B)
8403                             ; ---------------------------------------------------------------
8403                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
8403                             ; 
8403                             ;   入力: A = レジスタ番号 (0-63)
8403                             ;   出力: HL = スロット先頭アドレス
8403                             ;   破壊: A
8403                             ; 
8403                             ; REG_FILE_BASE = 0x8100 (下位バイト 0x00) なので、
8403                             ; レジスタ番号 × 4 がそのまま L になり、H は固定。
8403                             ; ---------------------------------------------------------------
8403                GET_REG_ADDR:      
8403   87                     ADD   a   ; ×2
8404   87                     ADD   a   ; ×4
8405   6F                     MOV   l,a   
8406   26 81                  MVI   h,REG_FILE_BASE_HI   
8408   C9                     RET      
8409                             ; ---------------------------------------------------------------
8409                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
8409                             ; 
8409                             ;   入力: A = レジスタ番号 a
8409                             ;   出力: HL = R[a+1] のスロット先頭アドレス
8409                             ;   破壊: A
8409                             ; ---------------------------------------------------------------
8409                GET_REG_ADDR_NEXT:      
8409   3C                     INR   a   
840A   C3 03 84               JMP   get_reg_addr   
840D                             ; ---------------------------------------------------------------
840D                             ; set_slot_int16 — スロットに 16 ビット整数を書く
840D                             ; 
840D                             ;   入力: HL = スロット先頭アドレス
840D                             ;          B  = val_hi (上位バイト)
840D                             ;          C  = val_lo (下位バイト)
840D                             ;   出力: なし
840D                             ;   破壊: HL
840D                             ; ---------------------------------------------------------------
840D                SET_SLOT_INT16:      
840D   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
840F   23                     INX   h   
8410   36 00                  MVI   m,0   ; +1: 予約
8412   23                     INX   h   
8413   71                     MOV   m,c   ; +2: val_lo
8414   23                     INX   h   
8415   70                     MOV   m,b   ; +3: val_hi
8416   C9                     RET      
8417                             ; ---------------------------------------------------------------
8417                             ; set_slot_special — 値を持たない型をスロットに書く
8417                             ; 
8417                             ;   入力: HL = スロット先頭アドレス
8417                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
8417                             ;   出力: なし
8417                             ;   破壊: A, HL
8417                             ; ---------------------------------------------------------------
8417                SET_SLOT_SPECIAL:      
8417   77                     MOV   m,a   ; +0: 型タグ
8418   23                     INX   h   
8419   36 00                  MVI   m,0   ; +1: 予約
841B   23                     INX   h   
841C   36 00                  MVI   m,0   ; +2: val_lo = 0
841E   23                     INX   h   
841F   36 00                  MVI   m,0   ; +3: val_hi = 0
8421   C9                     RET      
8422                             ; ---------------------------------------------------------------
8422                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
8422                             ; 
8422                             ;   入力: HL = コピー元先頭
8422                             ;         DE = コピー先先頭
8422                             ;   出力: なし
8422                             ;   破壊: A, C, HL, DE
8422                             ; ---------------------------------------------------------------
8422                COPY_SLOT:      
8422   0E 04                  MVI   c,SLOT_BYTES   
8424                COPY_SLOT_LOOP:      
8424   7E                     MOV   a,m   
8425   12                     STAX   d   
8426   23                     INX   h   
8427   13                     INX   d   
8428   0D                     DCR   c   
8429   C2 24 84               JNZ   copy_slot_loop   
842C   C9                     RET      
842D                             ; ---------------------------------------------------------------
842D                             ; get_slot_type — スロットの型タグを読む
842D                             ; 
842D                             ;   入力: HL = スロット先頭アドレス
842D                             ;   出力: A = 型タグ
842D                             ;   破壊: なし (HL 保存)
842D                             ; ---------------------------------------------------------------
842D                GET_SLOT_TYPE:      
842D   7E                     MOV   a,m   
842E   C9                     RET      
842F                             ; ---------------------------------------------------------------
842F                             ; slot_to_value — スロット先頭から値の先頭へ進める
842F                             ; 
842F                             ;   入力: HL = スロット先頭アドレス
842F                             ;   出力: HL = 値の先頭 (スロット +2)
842F                             ;   破壊: なし
842F                             ; ---------------------------------------------------------------
842F                SLOT_TO_VALUE:      
842F   23                     INX   h   
8430   23                     INX   h   
8431   C9                     RET      
8432                             ; ---------------------------------------------------------------
8432                             ; add_value16 — 16 ビット加算 (val1 += val2)
8432                             ; 
8432                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
8432                             ;         DE = 値 2 の先頭
8432                             ;   出力: 結果を HL の元の位置に上書き
8432                             ;   破壊: A, HL, DE
8432                             ; 
8432                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
8432                             ; ---------------------------------------------------------------
8432                ADD_VALUE16:      
8432   1A                     LDAX   d   ; A = val2[lo]
8433   86                     ADD   m   ; A += val1[lo]
8434   77                     MOV   m,a   ; val1[lo] = result
8435   23                     INX   h   
8436   13                     INX   d   
8437   1A                     LDAX   d   ; A = val2[hi]
8438   8E                     ADC   m   ; A += val1[hi] + CY
8439   77                     MOV   m,a   
843A   C9                     RET      
843B                             ; ---------------------------------------------------------------
843B                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
843B                             ; 
843B                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
843B                             ;         DE = 値 2 の先頭
843B                             ;   出力: 結果を HL の元の位置に上書き
843B                             ;   破壊: A, HL, DE
843B                             ; 
843B                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
843B                             ; ---------------------------------------------------------------
843B                SUB_VALUE16:      
843B   7E                     MOV   a,m   ; A = val1[lo]
843C   EB                     XCHG      ; HL=val2, DE=val1
843D   96                     SUB   m   ; A -= val2[lo]
843E   EB                     XCHG      ; HL=val1, DE=val2
843F   77                     MOV   m,a   ; val1[lo] = result
8440   23                     INX   h   
8441   13                     INX   d   
8442   7E                     MOV   a,m   ; A = val1[hi]
8443   EB                     XCHG      
8444   9E                     SBB   m   ; A -= val2[hi] - CY
8445   EB                     XCHG      
8446   77                     MOV   m,a   
8447   C9                     RET      
8448                             ; ---------------------------------------------------------------
8448                             ; cmp_value16 — 16 ビット符号付き比較
8448                             ; 
8448                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
8448                             ;         DE = 値 2 の先頭 (byte0 の位置)
8448                             ;   出力: A = 比較結果
8448                             ;           00h → val1 == val2
8448                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
8448                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
8448                             ;   破壊: A, B, HL, DE
8448                             ; 
8448                             ; 手順:
8448                             ;   1. 上位バイト (byte1) の符号ビットを比べる
8448                             ;   2. 符号が違えば、負の方が小さい
8448                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
8448                             ; ---------------------------------------------------------------
8448                CMP_VALUE16:      
8448                             ; byte1 (上位) の位置を求める
8448   23                     INX   h   ; HL = val1+1 (hi)
8449   13                     INX   d   ; DE = val2+1 (hi)
844A                             ; 符号ビットを比べる
844A   7E                     MOV   a,m   ; A = val1[hi]
844B   47                     MOV   b,a   ; B = val1[hi] (退避)
844C   1A                     LDAX   d   ; A = val2[hi]
844D   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
844E   F2 5A 84               JP   cmp16_same_sign   
8451                             ; 符号が違う: val1 が負なら val1 < val2
8451   78                     MOV   a,b   ; A = val1[hi]
8452   E6 80                  ANI   80h   ; bit7 を取り出す
8454   C2 6E 84               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
8457   C3 71 84               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
845A                CMP16_SAME_SIGN:      
845A                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
845A   1A                     LDAX   d   
845B   BE                     CMP   m   ; val2[hi] - val1[hi]
845C   DA 71 84               JC   cmp16_ret_pos   
845F   C2 6E 84               JNZ   cmp16_ret_neg   
8462   2B                     DCX   h   
8463   1B                     DCX   d   
8464   1A                     LDAX   d   
8465   BE                     CMP   m   ; val2[lo] - val1[lo]
8466   DA 71 84               JC   cmp16_ret_pos   
8469   C2 6E 84               JNZ   cmp16_ret_neg   
846C                             ; すべて等しい
846C   AF                     XRA   a   ; A = 00h
846D   C9                     RET      
846E                CMP16_RET_NEG:      
846E   3E FF                  MVI   a,0FFh   ; val1 < val2
8470   C9                     RET      
8471                CMP16_RET_POS:      
8471   3E 01                  MVI   a,01h   ; val1 > val2
8473   C9                     RET      
8474                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
8474                             ; 
8474                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
8474                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
8474                             ; ---------------------------------------------------------------
8474                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
8474                             ; 
8474                             ;   入力: なし
8474                             ;   出力: A = 読んだバイト
8474                             ;   破壊: HL, DE
8474                             ; 
8474                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
8474                             ; BYTECODE_BASE + PC で求めます。
8474                             ; ---------------------------------------------------------------
8474                FETCH_BYTE:      
8474   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
8477   11 00 90               LXI   d,BYTECODE_BASE   
847A   19                     DAD   d   ; HL = 絶対アドレス
847B   7E                     MOV   a,m   ; A = bytecode[PC]
847C                             ; PC をインクリメント
847C   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
847F   23                     INX   h   
8480   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8483   C9                     RET      
8484                             ; ---------------------------------------------------------------
8484                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
8484                             ; 
8484                             ;   入力: なし
8484                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
8484                             ;   破壊: A, B, DE
8484                             ; 
8484                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
8484                             ; 1 バイト目が上位、2 バイト目が下位。
8484                             ; ---------------------------------------------------------------
8484                FETCH_U16BE:      
8484   CD 74 84               CALL   fetch_byte   ; A = 上位バイト
8487   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
8488   CD 74 84               CALL   fetch_byte   ; A = 下位バイト
848B   6F                     MOV   l,a   
848C   60                     MOV   h,b   
848D   C9                     RET      
848E                             ; ---------------------------------------------------------------
848E                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
848E                             ; 
848E                             ;   入力: なし
848E                             ;   出力: HL = 読んだ符号付き 16 ビット値
848E                             ;   破壊: A, DE
848E                             ; 
848E                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
848E                             ; ---------------------------------------------------------------
848E                FETCH_S16BE:      
848E   C3 84 84               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
8491                             ; vm_load.a80 — ロード命令
8491                             ; 
8491                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
8491                             ; 
8491                             ; Phase 2: 16 ビットスロット (4 バイト)
8491                             ;   set_slot_int16: B=val_hi, C=val_lo
8491                             ; ---------------------------------------------------------------
8491                             ; OP_NOP (Z): 何もしない
8491                             ; ---------------------------------------------------------------
8491                DO_OP_NOP:      
8491   C3 B0 89               JMP   vm_loop   
8494                             ; ---------------------------------------------------------------
8494                             ; OP_MOVE (BB): R[a] = R[b]
8494                             ; ---------------------------------------------------------------
8494                DO_OP_MOVE:      
8494   CD 74 84               CALL   fetch_byte   ; A = a (コピー先)
8497   F5                     PUSH   psw   
8498   CD 74 84               CALL   fetch_byte   ; A = b (コピー元)
849B   CD 03 84               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
849E   EB                     XCHG      ; DE = R[b]
849F   F1                     POP   psw   ; A = a
84A0   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84A3   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
84A4   CD 22 84               CALL   copy_slot   
84A7   C3 B0 89               JMP   vm_loop   
84AA                             ; ---------------------------------------------------------------
84AA                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
84AA                             ; ---------------------------------------------------------------
84AA                DO_OP_LOADI:      
84AA   CD 74 84               CALL   fetch_byte   ; A = a
84AD   F5                     PUSH   psw   
84AE   CD 74 84               CALL   fetch_byte   ; A = b (値)
84B1   4F                     MOV   c,a   ; C = val_lo
84B2   F1                     POP   psw   ; A = a
84B3   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84B6   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
84B7   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
84B9   CD 0D 84               CALL   set_slot_int16   
84BC   C3 B0 89               JMP   vm_loop   
84BF                             ; ---------------------------------------------------------------
84BF                             ; OP_LOADINEG (BB): R[a] = -b
84BF                             ; ---------------------------------------------------------------
84BF                DO_OP_LOADINEG:      
84BF   CD 74 84               CALL   fetch_byte   ; A = a
84C2   F5                     PUSH   psw   
84C3   CD 74 84               CALL   fetch_byte   ; A = b
84C6                             ; -b を計算 (0 - b)
84C6   4F                     MOV   c,a   ; C = b (退避)
84C7   AF                     XRA   a   ; A = 0
84C8   91                     SUB   c   ; A = -b
84C9   4F                     MOV   c,a   ; C = val_lo (-b)
84CA   F1                     POP   psw   ; A = a
84CB   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84CE   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
84D0   CD 0D 84               CALL   set_slot_int16   
84D3   C3 B0 89               JMP   vm_loop   
84D6                             ; ---------------------------------------------------------------
84D6                             ; OP_LOADI__1 (B): R[a] = -1
84D6                             ; ---------------------------------------------------------------
84D6                DO_OP_LOADI__1:      
84D6   CD 74 84               CALL   fetch_byte   ; A = a
84D9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
84DC   0E FF                  MVI   c,0FFh   ; val_lo = FFh
84DE   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
84E0   CD 0D 84               CALL   set_slot_int16   
84E3   C3 B0 89               JMP   vm_loop   
84E6                             ; ---------------------------------------------------------------
84E6                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
84E6                             ; ---------------------------------------------------------------
84E6                DO_OP_LOADI_0:      
84E6   0E 00                  MVI   c,0   
84E8   C3 0B 85               JMP   loadi_small   
84EB                DO_OP_LOADI_1:      
84EB   0E 01                  MVI   c,1   
84ED   C3 0B 85               JMP   loadi_small   
84F0                DO_OP_LOADI_2:      
84F0   0E 02                  MVI   c,2   
84F2   C3 0B 85               JMP   loadi_small   
84F5                DO_OP_LOADI_3:      
84F5   0E 03                  MVI   c,3   
84F7   C3 0B 85               JMP   loadi_small   
84FA                DO_OP_LOADI_4:      
84FA   0E 04                  MVI   c,4   
84FC   C3 0B 85               JMP   loadi_small   
84FF                DO_OP_LOADI_5:      
84FF   0E 05                  MVI   c,5   
8501   C3 0B 85               JMP   loadi_small   
8504                DO_OP_LOADI_6:      
8504   0E 06                  MVI   c,6   
8506   C3 0B 85               JMP   loadi_small   
8509                DO_OP_LOADI_7:      
8509   0E 07                  MVI   c,7   
850B                LOADI_SMALL:      
850B                             ; C = 即値 (0-7)
850B   CD 74 84               CALL   fetch_byte   ; A = a
850E   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8511   06 00                  MVI   b,0   ; val_hi = 0 (正)
8513   CD 0D 84               CALL   set_slot_int16   
8516   C3 B0 89               JMP   vm_loop   
8519                             ; ---------------------------------------------------------------
8519                             ; OP_LOADI16 (BS): R[a] = signed16(b)
8519                             ; 
8519                             ; b は符号付き 16 ビット (ビッグエンディアン)。
8519                             ; 16 ビットスロットではそのままネイティブサイズ。
8519                             ; 符号拡張は不要。
8519                             ; ---------------------------------------------------------------
8519                DO_OP_LOADI16:      
8519   CD 74 84               CALL   fetch_byte   ; A = a
851C   F5                     PUSH   psw   
851D   CD 8E 84               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
8520   4D                     MOV   c,l   ; C = val_lo
8521   44                     MOV   b,h   ; B = val_hi
8522   F1                     POP   psw   ; A = a
8523   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8526                             ; 型タグと値を書く
8526   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
8528   23                     INX   h   
8529   36 00                  MVI   m,0   ; +1: 予約
852B   23                     INX   h   
852C   71                     MOV   m,c   ; +2: val_lo
852D   23                     INX   h   
852E   70                     MOV   m,b   ; +3: val_hi
852F   C3 B0 89               JMP   vm_loop   
8532                             ; ---------------------------------------------------------------
8532                             ; OP_LOADNIL (B): R[a] = nil
8532                             ; ---------------------------------------------------------------
8532                DO_OP_LOADNIL:      
8532   CD 74 84               CALL   fetch_byte   ; A = a
8535   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8538   3E 01                  MVI   a,TT_NIL   
853A   CD 17 84               CALL   set_slot_special   
853D   C3 B0 89               JMP   vm_loop   
8540                             ; ---------------------------------------------------------------
8540                             ; OP_LOADT (B): R[a] = true
8540                             ; ---------------------------------------------------------------
8540                DO_OP_LOADT:      
8540   CD 74 84               CALL   fetch_byte   ; A = a
8543   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8546   3E 03                  MVI   a,TT_TRUE   
8548   CD 17 84               CALL   set_slot_special   
854B   C3 B0 89               JMP   vm_loop   
854E                             ; ---------------------------------------------------------------
854E                             ; OP_LOADF (B): R[a] = false
854E                             ; ---------------------------------------------------------------
854E                DO_OP_LOADF:      
854E   CD 74 84               CALL   fetch_byte   ; A = a
8551   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8554   3E 02                  MVI   a,TT_FALSE   
8556   CD 17 84               CALL   set_slot_special   
8559   C3 B0 89               JMP   vm_loop   
855C                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
855C                             ; 
855C                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
855C                             ; ---------------------------------------------------------------
855C                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
855C                             ; 
855C                             ; Phase 2 は整数のみ。型タグの検査は省略し、TT_INTEGER として扱う。
855C                             ; ---------------------------------------------------------------
855C                DO_OP_ADD:      
855C   CD 74 84               CALL   fetch_byte   ; A = a
855F   F5                     PUSH   psw   ; a を退避
8560                             ; R[a+1] のスロットアドレスを求める
8560   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
8563   CD 2F 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
8566   EB                     XCHG      ; DE = R[a+1] の値先頭
8567   F1                     POP   psw   ; A = a
8568                             ; R[a] のスロットアドレスを求める
8568   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
856B   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
856E                             ; 16 ビット加算: val[a] += val[a+1]
856E   CD 32 84               CALL   add_value16   
8571   C3 B0 89               JMP   vm_loop   
8574                             ; ---------------------------------------------------------------
8574                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
8574                             ; ---------------------------------------------------------------
8574                DO_OP_SUB:      
8574   CD 74 84               CALL   fetch_byte   ; A = a
8577   F5                     PUSH   psw   
8578   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
857B   CD 2F 84               CALL   slot_to_value   
857E   EB                     XCHG      ; DE = R[a+1] の値先頭
857F   F1                     POP   psw   ; A = a
8580   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8583   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8586   CD 3B 84               CALL   sub_value16   
8589   C3 B0 89               JMP   vm_loop   
858C                             ; ---------------------------------------------------------------
858C                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
858C                             ; 
858C                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
858C                             ; ---------------------------------------------------------------
858C                DO_OP_ADDI:      
858C   CD 74 84               CALL   fetch_byte   ; A = a
858F   F5                     PUSH   psw   
8590   CD 74 84               CALL   fetch_byte   ; A = b (即値)
8593   4F                     MOV   c,a   ; C = b
8594   F1                     POP   psw   ; A = a
8595   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8598   CD 2F 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
859B   7E                     MOV   a,m   ; val_lo
859C   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
859D   77                     MOV   m,a   
859E   23                     INX   h   
859F   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
85A0   CE 00                  ACI   0   ; val_hi + CY
85A2   77                     MOV   m,a   
85A3   C3 B0 89               JMP   vm_loop   
85A6                             ; ---------------------------------------------------------------
85A6                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
85A6                             ; ---------------------------------------------------------------
85A6                DO_OP_SUBI:      
85A6   CD 74 84               CALL   fetch_byte   ; A = a
85A9   F5                     PUSH   psw   
85AA   CD 74 84               CALL   fetch_byte   ; A = b (即値)
85AD   4F                     MOV   c,a   ; C = b
85AE   F1                     POP   psw   ; A = a
85AF   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85B2   CD 2F 84               CALL   slot_to_value   ; HL = 値の先頭 (+2)
85B5   7E                     MOV   a,m   ; val_lo
85B6   91                     SUB   c   ; val_lo - b (CY = 借り)
85B7   77                     MOV   m,a   
85B8   23                     INX   h   
85B9   7E                     MOV   a,m   ; val_hi
85BA   DE 00                  SBI   0   ; val_hi - CY
85BC   77                     MOV   m,a   
85BD   C3 B0 89               JMP   vm_loop   
85C0                             ; ---------------------------------------------------------------
85C0                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
85C0                             ; 
85C0                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
85C0                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
85C0                             ; ---------------------------------------------------------------
85C0                DO_OP_MUL:      
85C0   CD 74 84               CALL   fetch_byte   ; A = a
85C3   F5                     PUSH   psw   
85C4   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85C7   CD 2F 84               CALL   slot_to_value   ; HL = R[a+1] の値先頭
85CA   5E                     MOV   e,m   ; E = val2_lo
85CB   23                     INX   h   
85CC   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
85CD   F1                     POP   psw   ; A = a
85CE   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
85D1   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
85D4   E5                     PUSH   h   ; 書き戻し先を退避
85D5   4E                     MOV   c,m   
85D6   23                     INX   h   
85D7   46                     MOV   b,m   ; BC = 被乗数
85D8   CD 0F 86               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
85DB   D1                     POP   d   ; DE = 書き戻し先
85DC   7D                     MOV   a,l   
85DD   12                     STAX   d   
85DE   13                     INX   d   
85DF   7C                     MOV   a,h   
85E0   12                     STAX   d   
85E1   C3 B0 89               JMP   vm_loop   
85E4                             ; ---------------------------------------------------------------
85E4                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
85E4                             ; 
85E4                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
85E4                             ; 除数 0 はエラー停止。
85E4                             ; ---------------------------------------------------------------
85E4                DO_OP_DIV:      
85E4   CD 74 84               CALL   fetch_byte   ; A = a
85E7   F5                     PUSH   psw   
85E8   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
85EB   CD 2F 84               CALL   slot_to_value   
85EE   5E                     MOV   e,m   
85EF   23                     INX   h   
85F0   56                     MOV   d,m   ; DE = 除数
85F1                             ; ゼロ除算チェック
85F1   7A                     MOV   a,d   
85F2   B3                     ORA   e   
85F3   C2 FA 85               JNZ   do_div_nonzero   
85F6   F1                     POP   psw   
85F7   C3 03 00               JMP   vm_error   
85FA                DO_DIV_NONZERO:      
85FA   F1                     POP   psw   ; A = a
85FB   CD 03 84               CALL   get_reg_addr   
85FE   CD 2F 84               CALL   slot_to_value   
8601   E5                     PUSH   h   ; 書き戻し先を退避
8602   4E                     MOV   c,m   
8603   23                     INX   h   
8604   46                     MOV   b,m   ; BC = 被除数
8605   CD 21 86               CALL   sdiv16   ; BC = 商
8608   E1                     POP   h   ; HL = 書き戻し先
8609   71                     MOV   m,c   
860A   23                     INX   h   
860B   70                     MOV   m,b   
860C   C3 B0 89               JMP   vm_loop   
860F                             ; ---------------------------------------------------------------
860F                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
860F                             ; 
860F                             ;   入力: BC = 被乗数, DE = 乗数
860F                             ;   出力: HL = 積の下位 16 ビット
860F                             ;   破壊: A, DE
860F                             ; ---------------------------------------------------------------
860F                UMUL16:      
860F   21 00 00               LXI   h,0   ; 積 = 0
8612   3E 10                  MVI   a,16   ; ビットカウンタ
8614                UMUL16_LOOP:      
8614   29                     DAD   h   ; 積 <<= 1
8615   EB                     XCHG      ; HL ↔ DE
8616   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
8617   EB                     XCHG      ; HL ↔ DE
8618   D2 1C 86               JNC   umul16_noadd   
861B   09                     DAD   b   ; 積 += 被乗数
861C                UMUL16_NOADD:      
861C   3D                     DCR   a   
861D   C2 14 86               JNZ   umul16_loop   
8620   C9                     RET      
8621                             ; ---------------------------------------------------------------
8621                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
8621                             ; 
8621                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
8621                             ;   出力: BC = 商
8621                             ;   破壊: A, DE, HL
8621                             ; 
8621                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
8621                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
8621                             ; ---------------------------------------------------------------
8621                SDIV16:      
8621   78                     MOV   a,b   
8622   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
8623   F5                     PUSH   psw   ; 符号情報を退避
8624                             ; 被除数を正にする
8624   78                     MOV   a,b   
8625   E6 80                  ANI   80h   
8627   CA 2D 86               JZ   sdiv16_chk_div   
862A   CD 7D 86               CALL   neg_bc   
862D                SDIV16_CHK_DIV:      
862D                             ; 除数を正にする
862D   7A                     MOV   a,d   
862E   E6 80                  ANI   80h   
8630   CA 36 86               JZ   sdiv16_do   
8633   CD 85 86               CALL   neg_de   
8636                SDIV16_DO:      
8636   CD 46 86               CALL   udiv16   ; BC = |商|, HL = |剰余|
8639   F1                     POP   psw   
863A   E6 80                  ANI   80h   
863C   C8                     RZ      ; 同符号 → 正の商をそのまま返す
863D                             ; 異符号: 剰余があれば floor 調整
863D   7C                     MOV   a,h   
863E   B5                     ORA   l   
863F   CA 43 86               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
8642   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
8643                SDIV16_NEG:      
8643   C3 7D 86               JMP   neg_bc   
8646                             ; ---------------------------------------------------------------
8646                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
8646                             ; 
8646                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
8646                             ;   出力: BC = 商, HL = 剰余
8646                             ;   破壊: A
8646                             ; 
8646                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
8646                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
8646                             ; ---------------------------------------------------------------
8646                UDIV16:      
8646   21 00 00               LXI   h,0   ; 剰余 = 0
8649   3E 10                  MVI   a,16   
864B   32 7C 86               STA   udiv_cnt   
864E                UDIV16_LOOP:      
864E                             ; BC を 1 ビット左シフト (MSB → CY)
864E   79                     MOV   a,c   
864F   87                     ADD   a   ; C <<= 1, bit7 → CY
8650   4F                     MOV   c,a   
8651   78                     MOV   a,b   
8652   8F                     ADC   a   ; B <<= 1 + CY from C
8653   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
8654                             ; CY を剰余 (HL) にシフトイン
8654   7D                     MOV   a,l   
8655   17                     RAL      
8656   6F                     MOV   l,a   
8657   7C                     MOV   a,h   
8658   17                     RAL      
8659   67                     MOV   h,a   
865A                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
865A   DA 6A 86               JC   udiv16_sub   
865D                             ; 剰余 (HL) と 除数 (DE) を比較
865D   7C                     MOV   a,h   
865E   BA                     CMP   d   
865F   DA 71 86               JC   udiv16_nosub   ; H < D → HL < DE
8662   C2 6A 86               JNZ   udiv16_sub   ; H > D → HL > DE
8665   7D                     MOV   a,l   
8666   BB                     CMP   e   
8667   DA 71 86               JC   udiv16_nosub   ; L < E → HL < DE
866A                UDIV16_SUB:      
866A                             ; 剰余 ≧ 除数: 減算して商ビット = 1
866A   7D                     MOV   a,l   
866B   93                     SUB   e   
866C   6F                     MOV   l,a   
866D   7C                     MOV   a,h   
866E   9A                     SBB   d   
866F   67                     MOV   h,a   
8670   0C                     INR   c   ; 商の bit0 を立てる
8671                UDIV16_NOSUB:      
8671   3A 7C 86               LDA   udiv_cnt   ; LDA は CY に影響しない
8674   3D                     DCR   a   ; DCR は CY に影響しない
8675   32 7C 86               STA   udiv_cnt   
8678   C2 4E 86               JNZ   udiv16_loop   
867B   C9                     RET      
867C                UDIV_CNT:      
867C   00                     DB   0   
867D                             ; ---------------------------------------------------------------
867D                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
867D                             ; ---------------------------------------------------------------
867D                NEG_BC:      
867D   79                     MOV   a,c   
867E   2F                     CMA      
867F   4F                     MOV   c,a   
8680   78                     MOV   a,b   
8681   2F                     CMA      
8682   47                     MOV   b,a   
8683   03                     INX   b   
8684   C9                     RET      
8685                NEG_DE:      
8685   7B                     MOV   a,e   
8686   2F                     CMA      
8687   5F                     MOV   e,a   
8688   7A                     MOV   a,d   
8689   2F                     CMA      
868A   57                     MOV   d,a   
868B   13                     INX   d   
868C   C9                     RET      
868D                             ; vm_compare.a80 — 比較命令
868D                             ; 
868D                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
868D                             ; 
868D                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
868D                             ; Phase 2 は整数のみ。
868D                             ; 
868D                             ; cmp_value16 は結果を A で返す:
868D                             ;   A = 00h → 等しい
868D                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
868D                             ;   A = 01h → val1 > val2
868D                             ; 
868D                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
868D                             ; ---------------------------------------------------------------
868D                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
868D                             ; 
868D                             ;   出力: A = 比較結果 (00h/FFh/01h)
868D                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
868D                             ;   破壊: A, B, HL, DE
868D                             ; ---------------------------------------------------------------
868D                CMP_REG_PAIR:      
868D   CD 74 84               CALL   fetch_byte   
8690   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
8693                             ; R[a+1] の値先頭
8693   CD 09 84               CALL   get_reg_addr_next   
8696   CD 2F 84               CALL   slot_to_value   
8699   EB                     XCHG      ; DE = R[a+1] 値先頭
869A                             ; R[a] の値先頭
869A   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
869D   CD 03 84               CALL   get_reg_addr   
86A0   CD 2F 84               CALL   slot_to_value   ; HL = R[a] 値先頭
86A3   CD 48 84               CALL   cmp_value16   ; A = 結果
86A6   C9                     RET      
86A7                             ; ---------------------------------------------------------------
86A7                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
86A7                             ; 
86A7                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
86A7                             ; ---------------------------------------------------------------
86A7                CMP_SET_TRUE:      
86A7   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86AA   CD 03 84               CALL   get_reg_addr   
86AD   3E 03                  MVI   a,TT_TRUE   
86AF   CD 17 84               CALL   set_slot_special   
86B2   C3 B0 89               JMP   vm_loop   
86B5                CMP_SET_FALSE:      
86B5   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86B8   CD 03 84               CALL   get_reg_addr   
86BB   3E 02                  MVI   a,TT_FALSE   
86BD   CD 17 84               CALL   set_slot_special   
86C0   C3 B0 89               JMP   vm_loop   
86C3                             ; ---------------------------------------------------------------
86C3                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
86C3                             ; 
86C3                             ; 型タグと値の両方が一致したときだけ true。
86C3                             ; ---------------------------------------------------------------
86C3                DO_OP_EQ:      
86C3   CD 74 84               CALL   fetch_byte   
86C6   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
86C9                             ; R[a] と R[a+1] のスロットアドレスを求める
86C9   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
86CC   E5                     PUSH   h   ; R[a] を退避
86CD   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
86D0   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
86D3   D1                     POP   d   ; DE = R[a]
86D4                             ; HL = R[a+1], DE = R[a]
86D4                             ; 型タグを比べる
86D4   46                     MOV   b,m   ; B = R[a+1].type
86D5   1A                     LDAX   d   ; A = R[a].type
86D6   B8                     CMP   b   
86D7   C2 B5 86               JNZ   cmp_set_false   ; 型が違えば false
86DA                             ; 型が同じ → 値を 2 バイト比べる
86DA   23                     INX   h   
86DB   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
86DC   13                     INX   d   
86DD   13                     INX   d   ; DE = R[a] + 2 (値先頭)
86DE   1A                     LDAX   d   ; A = R[a].val_lo
86DF   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
86E0   C2 B5 86               JNZ   cmp_set_false   
86E3   23                     INX   h   
86E4   13                     INX   d   
86E5   1A                     LDAX   d   ; A = R[a].val_hi
86E6   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
86E7   C2 B5 86               JNZ   cmp_set_false   
86EA   C3 A7 86               JMP   cmp_set_true   ; すべて一致
86ED                             ; ---------------------------------------------------------------
86ED                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
86ED                             ; ---------------------------------------------------------------
86ED                DO_OP_LT:      
86ED   CD 8D 86               CALL   cmp_reg_pair   ; A = 結果
86F0   B7                     ORA   a   
86F1   FA A7 86               JM   cmp_set_true   ; A = FFh → val1 < val2
86F4   C3 B5 86               JMP   cmp_set_false   
86F7                             ; ---------------------------------------------------------------
86F7                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
86F7                             ; ---------------------------------------------------------------
86F7                DO_OP_LE:      
86F7   CD 8D 86               CALL   cmp_reg_pair   
86FA   B7                     ORA   a   
86FB   FA A7 86               JM   cmp_set_true   ; val1 < val2
86FE   CA A7 86               JZ   cmp_set_true   ; val1 == val2
8701   C3 B5 86               JMP   cmp_set_false   
8704                             ; ---------------------------------------------------------------
8704                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
8704                             ; ---------------------------------------------------------------
8704                DO_OP_GT:      
8704   CD 8D 86               CALL   cmp_reg_pair   
8707   B7                     ORA   a   
8708   CA B5 86               JZ   cmp_set_false   ; val1 == val2
870B   F2 A7 86               JP   cmp_set_true   ; A = 01h → val1 > val2
870E   C3 B5 86               JMP   cmp_set_false   ; A = FFh → val1 < val2
8711                             ; ---------------------------------------------------------------
8711                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
8711                             ; ---------------------------------------------------------------
8711                DO_OP_GE:      
8711   CD 8D 86               CALL   cmp_reg_pair   
8714   B7                     ORA   a   
8715   FA B5 86               JM   cmp_set_false   ; val1 < val2
8718   C3 A7 86               JMP   cmp_set_true   ; val1 >= val2
871B                             ; vm_jump.a80 — ジャンプ命令
871B                             ; 
871B                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
871B                             ; 
871B                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
871B                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
871B                             ; ---------------------------------------------------------------
871B                             ; apply_jump — PC に符号付きオフセットを加える
871B                             ; 
871B                             ;   入力: HL = 符号付き 16 ビットオフセット
871B                             ;   出力: なし (PC が更新される)
871B                             ;   破壊: A, HL, DE
871B                             ; ---------------------------------------------------------------
871B                APPLY_JUMP:      
871B   EB                     XCHG      ; DE = オフセット
871C   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
871F   19                     DAD   d   ; HL = PC + オフセット
8720   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
8723   C9                     RET      
8724                             ; ---------------------------------------------------------------
8724                             ; OP_JMP (S): PC += signed16(a)
8724                             ; ---------------------------------------------------------------
8724                DO_OP_JMP:      
8724   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
8727   CD 1B 87               CALL   apply_jump   
872A   C3 B0 89               JMP   vm_loop   
872D                             ; ---------------------------------------------------------------
872D                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
872D                             ; 
872D                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
872D                             ; ---------------------------------------------------------------
872D                DO_OP_JMPIF:      
872D   CD 74 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8730   F5                     PUSH   psw   
8731   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
8734   E5                     PUSH   h   ; オフセットを退避
8735   D1                     POP   d   ; DE = オフセット
8736   F1                     POP   psw   ; A = a
8737   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
873A   CD 2D 84               CALL   get_slot_type   ; A = 型タグ
873D   FE 03                  CPI   TT_FALSY_MAX + 1   
873F   DA 49 87               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
8742                             ; 真 → ジャンプする
8742   EB                     XCHG      ; HL = オフセット (DE にあった)
8743   CD 1B 87               CALL   apply_jump   
8746   C3 B0 89               JMP   vm_loop   
8749                JMPIF_SKIP:      
8749   C3 B0 89               JMP   vm_loop   
874C                             ; ---------------------------------------------------------------
874C                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
874C                             ; ---------------------------------------------------------------
874C                DO_OP_JMPNOT:      
874C   CD 74 84               CALL   fetch_byte   ; A = a
874F   F5                     PUSH   psw   
8750   CD 8E 84               CALL   fetch_s16be   ; HL = オフセット
8753   E5                     PUSH   h   
8754   D1                     POP   d   ; DE = オフセット
8755   F1                     POP   psw   ; A = a
8756   CD 03 84               CALL   get_reg_addr   ; HL = R[a] スロット先頭
8759   CD 2D 84               CALL   get_slot_type   ; A = 型タグ
875C   FE 03                  CPI   TT_FALSY_MAX + 1   
875E   D2 68 87               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
8761                             ; 偽 → ジャンプする
8761   EB                     XCHG      ; HL = オフセット
8762   CD 1B 87               CALL   apply_jump   
8765   C3 B0 89               JMP   vm_loop   
8768                JMPNOT_SKIP:      
8768   C3 B0 89               JMP   vm_loop   
876B                             ; vm_globals.a80 — グローバル変数アクセス (16 ビット整数)
876B                             ; 
876B                             ; OP_GETGV, OP_SETGV
876B                             ; 
876B                             ; シンボルテーブル (SYM_TABLE_BASE, 0x8300):
876B                             ;   エントリ i (2 バイト): グローバルスロットのアドレス (LE)
876B                             ;     0x0000 = 未対応のシンボル (メソッド名等)
876B                             ; 
876B                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
876B                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
876B                             ; ---------------------------------------------------------------
876B                             ; OP_GETGV (BB): R[a] = global[symbols[b]]
876B                             ; ---------------------------------------------------------------
876B                DO_OP_GETGV:      
876B   CD 74 84               CALL   fetch_byte   ; A = a (レジスタ番号)
876E   F5                     PUSH   psw   
876F   CD 74 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
8772                             ; シンボルテーブルからグローバルスロットのアドレスを取得
8772                             ; SYM_TABLE_BASE + b * 2
8772   87                     ADD   a   ; A = b * 2
8773   5F                     MOV   e,a   
8774   16 00                  MVI   d,0   
8776   21 00 83               LXI   h,SYM_TABLE_BASE   
8779   19                     DAD   d   ; HL = &sym_table[b]
877A   5E                     MOV   e,m   
877B   23                     INX   h   
877C   56                     MOV   d,m   ; DE = グローバルスロットアドレス
877D                             ; アドレスが 0 なら未対応シンボル
877D   7A                     MOV   a,d   
877E   B3                     ORA   e   
877F   C2 86 87               JNZ   getgv_ok   
8782   F1                     POP   psw   
8783   C3 03 00               JMP   vm_error   
8786                GETGV_OK:      
8786   F1                     POP   psw   ; A = a
8787   D5                     PUSH   d   ; グローバルアドレスを退避
8788   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
878B   EB                     XCHG      ; DE = R[a]
878C   E1                     POP   h   ; HL = グローバルスロット (コピー元)
878D   CD 22 84               CALL   copy_slot   ; [HL] → [DE]
8790   C3 B0 89               JMP   vm_loop   
8793                             ; ---------------------------------------------------------------
8793                             ; OP_SETGV (BB): global[symbols[b]] = R[a]
8793                             ; ---------------------------------------------------------------
8793                DO_OP_SETGV:      
8793   CD 74 84               CALL   fetch_byte   ; A = a (レジスタ番号)
8796   F5                     PUSH   psw   
8797   CD 74 84               CALL   fetch_byte   ; A = b (シンボルインデックス)
879A   87                     ADD   a   
879B   5F                     MOV   e,a   
879C   16 00                  MVI   d,0   
879E   21 00 83               LXI   h,SYM_TABLE_BASE   
87A1   19                     DAD   d   ; HL = &sym_table[b]
87A2   5E                     MOV   e,m   
87A3   23                     INX   h   
87A4   56                     MOV   d,m   ; DE = グローバルスロットアドレス
87A5   7A                     MOV   a,d   
87A6   B3                     ORA   e   
87A7   C2 AE 87               JNZ   setgv_ok   
87AA   F1                     POP   psw   
87AB   C3 03 00               JMP   vm_error   
87AE                SETGV_OK:      
87AE   F1                     POP   psw   ; A = a
87AF   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー元)
87B2                             ; copy_slot: [HL] → [DE]
87B2   CD 22 84               CALL   copy_slot   
87B5   C3 B0 89               JMP   vm_loop   
87B8                             ; vm_send.a80 — メソッド呼び出し (組み込みメソッド限定)
87B8                             ; 
87B8                             ; OP_SEND, OP_SSEND
87B8                             ; 
87B8                             ; 組み込みメソッドのみサポート。ユーザ定義メソッドは未対応。
87B8                             ; シンボルテーブルの値が 0x0001-0x00FF の場合メソッド ID として扱う:
87B8                             ;   1 = !=  (不等号)
87B8                             ;   2 = !   (論理否定)
87B8                             ;   3 = %   (剰余, Ruby floor modulo)
87B8                             ;   4 = abs (絶対値)
87B8                             ; ---------------------------------------------------------------
87B8                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
87B8                             ; 
87B8                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
87B8                             ; ---------------------------------------------------------------
87B8                DO_OP_SSEND:      
87B8   CD 74 84               CALL   fetch_byte   ; A = a
87BB   F5                     PUSH   psw   
87BC   CD 03 84               CALL   get_reg_addr   ; HL = R[a] (コピー先)
87BF   EB                     XCHG      ; DE = R[a]
87C0   AF                     XRA   a   ; A = 0
87C1   CD 03 84               CALL   get_reg_addr   ; HL = R[0] (self)
87C4   CD 22 84               CALL   copy_slot   ; R[a] = R[0]
87C7   F1                     POP   psw   ; A = a
87C8   32 BB 88               STA   send_reg_a   
87CB   CD 74 84               CALL   fetch_byte   ; A = b (シンボル)
87CE   F5                     PUSH   psw   
87CF   CD 74 84               CALL   fetch_byte   ; A = c (argc)
87D2   32 BC 88               STA   send_argc   
87D5   F1                     POP   psw   ; A = b
87D6   C3 EA 87               JMP   send_dispatch   
87D9                             ; ---------------------------------------------------------------
87D9                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
87D9                             ; ---------------------------------------------------------------
87D9                DO_OP_SEND:      
87D9   CD 74 84               CALL   fetch_byte   ; A = a
87DC   32 BB 88               STA   send_reg_a   
87DF   CD 74 84               CALL   fetch_byte   ; A = b (シンボル)
87E2   F5                     PUSH   psw   
87E3   CD 74 84               CALL   fetch_byte   ; A = c (argc)
87E6   32 BC 88               STA   send_argc   
87E9   F1                     POP   psw   ; A = b
87EA                SEND_DISPATCH:      
87EA                             ; シンボルテーブルからメソッド ID を取得
87EA   87                     ADD   a   ; b * 2
87EB   5F                     MOV   e,a   
87EC   16 00                  MVI   d,0   
87EE   21 00 83               LXI   h,SYM_TABLE_BASE   
87F1   19                     DAD   d   
87F2   5E                     MOV   e,m   
87F3   23                     INX   h   
87F4   56                     MOV   d,m   ; DE = エントリ値
87F5                             ; D != 0 ならグローバルアドレス → メソッドではない
87F5   7A                     MOV   a,d   
87F6   B7                     ORA   a   
87F7   C2 03 00               JNZ   vm_error   
87FA                             ; E = メソッド ID (0 = 未対応)
87FA   7B                     MOV   a,e   
87FB   B7                     ORA   a   
87FC   CA 03 00               JZ   vm_error   
87FF                             ; メソッドディスパッチ
87FF   FE 01                  CPI   1   
8801   CA 16 88               JZ   send_ne   ; != (不等号)
8804   FE 02                  CPI   2   
8806   CA 4B 88               JZ   send_not   ; !  (論理否定)
8809   FE 03                  CPI   3   
880B   CA 73 88               JZ   send_mod   ; %  (剰余)
880E   FE 04                  CPI   4   
8810   CA 9E 88               JZ   send_abs   ; abs (絶対値)
8813   C3 03 00               JMP   vm_error   ; 未対応メソッド
8816                             ; ---------------------------------------------------------------
8816                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
8816                             ; 
8816                             ; スロット全体 (4 バイト) をバイト比較する。
8816                             ; 型タグも含めて比較するので異なる型は常に true。
8816                             ; ---------------------------------------------------------------
8816                SEND_NE:      
8816   3A BB 88               LDA   send_reg_a   
8819   F5                     PUSH   psw   
881A   CD 09 84               CALL   get_reg_addr_next   ; HL = R[a+1]
881D   EB                     XCHG      ; DE = R[a+1]
881E   F1                     POP   psw   
881F   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8822   0E 04                  MVI   c,SLOT_BYTES   
8824                SEND_NE_CMP:      
8824   1A                     LDAX   d   
8825   BE                     CMP   m   
8826   C2 3D 88               JNZ   send_ne_diff   
8829   23                     INX   h   
882A   13                     INX   d   
882B   0D                     DCR   c   
882C   C2 24 88               JNZ   send_ne_cmp   
882F                             ; 全バイト一致 → 等しい → false
882F   3A BB 88               LDA   send_reg_a   
8832   CD 03 84               CALL   get_reg_addr   
8835   3E 02                  MVI   a,TT_FALSE   
8837   CD 17 84               CALL   set_slot_special   
883A   C3 B0 89               JMP   vm_loop   
883D                SEND_NE_DIFF:      
883D   3A BB 88               LDA   send_reg_a   
8840   CD 03 84               CALL   get_reg_addr   
8843   3E 03                  MVI   a,TT_TRUE   
8845   CD 17 84               CALL   set_slot_special   
8848   C3 B0 89               JMP   vm_loop   
884B                             ; ---------------------------------------------------------------
884B                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
884B                             ; 
884B                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
884B                             ; ---------------------------------------------------------------
884B                SEND_NOT:      
884B   3A BB 88               LDA   send_reg_a   
884E   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8851   7E                     MOV   a,m   ; A = 型タグ
8852   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
8854   DA 65 88               JC   send_not_falsy   
8857                             ; 真だった → false
8857   3A BB 88               LDA   send_reg_a   
885A   CD 03 84               CALL   get_reg_addr   
885D   3E 02                  MVI   a,TT_FALSE   
885F   CD 17 84               CALL   set_slot_special   
8862   C3 B0 89               JMP   vm_loop   
8865                SEND_NOT_FALSY:      
8865                             ; 偽だった → true
8865   3A BB 88               LDA   send_reg_a   
8868   CD 03 84               CALL   get_reg_addr   
886B   3E 03                  MVI   a,TT_TRUE   
886D   CD 17 84               CALL   set_slot_special   
8870   C3 B0 89               JMP   vm_loop   
8873                             ; ---------------------------------------------------------------
8873                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
8873                             ; ---------------------------------------------------------------
8873                SEND_MOD:      
8873   3A BB 88               LDA   send_reg_a   
8876   F5                     PUSH   psw   
8877   CD 09 84               CALL   get_reg_addr_next   
887A   CD 2F 84               CALL   slot_to_value   
887D   5E                     MOV   e,m   
887E   23                     INX   h   
887F   56                     MOV   d,m   ; DE = 除数
8880   7A                     MOV   a,d   
8881   B3                     ORA   e   
8882   C2 89 88               JNZ   send_mod_ok   
8885   F1                     POP   psw   
8886   C3 03 00               JMP   vm_error   ; ゼロ除算
8889                SEND_MOD_OK:      
8889   F1                     POP   psw   
888A   CD 03 84               CALL   get_reg_addr   
888D   CD 2F 84               CALL   slot_to_value   
8890   E5                     PUSH   h   ; 書き戻し先
8891   4E                     MOV   c,m   
8892   23                     INX   h   
8893   46                     MOV   b,m   ; BC = 被除数
8894   CD BD 88               CALL   smod16   ; BC = 剰余 (除数と同符号)
8897   E1                     POP   h   
8898   71                     MOV   m,c   
8899   23                     INX   h   
889A   70                     MOV   m,b   
889B   C3 B0 89               JMP   vm_loop   
889E                             ; ---------------------------------------------------------------
889E                             ; abs (絶対値): R[a] = |R[a]|
889E                             ; ---------------------------------------------------------------
889E                SEND_ABS:      
889E   3A BB 88               LDA   send_reg_a   
88A1   CD 03 84               CALL   get_reg_addr   
88A4   CD 2F 84               CALL   slot_to_value   ; HL = 値の先頭
88A7   23                     INX   h   ; HL → val_hi
88A8   7E                     MOV   a,m   
88A9   E6 80                  ANI   80h   
88AB   CA B0 89               JZ   vm_loop   ; 正ならそのまま
88AE   2B                     DCX   h   ; HL → val_lo
88AF   4E                     MOV   c,m   
88B0   23                     INX   h   
88B1   46                     MOV   b,m   ; BC = 値
88B2   CD 7D 86               CALL   neg_bc   
88B5   70                     MOV   m,b   ; val_hi
88B6   2B                     DCX   h   
88B7   71                     MOV   m,c   ; val_lo
88B8   C3 B0 89               JMP   vm_loop   
88BB                             ; --- 一時変数 ---
88BB                SEND_REG_A:      
88BB   00                     DB   0   
88BC                SEND_ARGC:      
88BC   00                     DB   0   
88BD                             ; ---------------------------------------------------------------
88BD                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
88BD                             ; 
88BD                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
88BD                             ;   出力: BC = 剰余 (除数と同符号)
88BD                             ;   破壊: A, DE, HL
88BD                             ; 
88BD                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
88BD                             ; ---------------------------------------------------------------
88BD                SMOD16:      
88BD                             ; 除数の符号を保存
88BD   7A                     MOV   a,d   
88BE   F5                     PUSH   psw   
88BF                             ; 符号の差を保存 (bit7: 異符号なら 1)
88BF   78                     MOV   a,b   
88C0   AA                     XRA   d   
88C1   F5                     PUSH   psw   
88C2                             ; 被除数を正にする
88C2   78                     MOV   a,b   
88C3   E6 80                  ANI   80h   
88C5   CA CB 88               JZ   smod_chk_div   
88C8   CD 7D 86               CALL   neg_bc   
88CB                SMOD_CHK_DIV:      
88CB   7A                     MOV   a,d   
88CC   E6 80                  ANI   80h   
88CE   CA D4 88               JZ   smod_do   
88D1   CD 85 86               CALL   neg_de   
88D4                SMOD_DO:      
88D4   D5                     PUSH   d   ; |除数| を退避
88D5   CD 46 86               CALL   udiv16   ; BC = 商, HL = 剰余
88D8   44                     MOV   b,h   
88D9   4D                     MOV   c,l   ; BC = |剰余|
88DA   78                     MOV   a,b   
88DB   B1                     ORA   c   
88DC   D1                     POP   d   ; DE = |除数|
88DD   F1                     POP   psw   ; 符号差 (bit7)
88DE   CA F3 88               JZ   smod_zero   ; 剰余 = 0
88E1   E6 80                  ANI   80h   
88E3   CA EC 88               JZ   smod_sign   ; 同符号 → 大きさはそのまま
88E6                             ; 異符号: 大きさ = |除数| - |剰余|
88E6   7B                     MOV   a,e   
88E7   91                     SUB   c   
88E8   4F                     MOV   c,a   
88E9   7A                     MOV   a,d   
88EA   98                     SBB   b   
88EB   47                     MOV   b,a   
88EC                SMOD_SIGN:      
88EC   F1                     POP   psw   ; 除数の符号 (bit7)
88ED   E6 80                  ANI   80h   
88EF   C8                     RZ      ; 除数が正 → 正の剰余
88F0   C3 7D 86               JMP   neg_bc   ; 除数が負 → 負にする
88F3                SMOD_ZERO:      
88F3   F1                     POP   psw   ; 除数の符号を捨てる
88F4   C9                     RET      
88F5                             ; vm_display.a80 — 7 セグメント表示
88F5                             ; 
88F5                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
88F5                             ; 上位 4 桁はブランク（消灯）にする。
88F5                             ; セグメントパターンは seg_table にまとめる。
88F5                             ; ---------------------------------------------------------------
88F5                             ; display_hex16 — 16 ビット値を 7 セグに表示
88F5                             ; 
88F5                             ;   入力: HL = 値の先頭 (val_lo の位置)
88F5                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
88F5                             ;   破壊: A, B, C, HL, DE
88F5                             ; 
88F5                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
88F5                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
88F5                             ; ---------------------------------------------------------------
88F5                DISPLAY_HEX16:      
88F5   E5                     PUSH   h   ; 値のアドレスを退避
88F6                             ; 上位 4 桁をブランク (消灯) にする
88F6   11 F8 FF               LXI   d,DISPLAY_BASE   
88F9   AF                     XRA   a   ; A = 0 (全セグメント消灯)
88FA   12                     STAX   d   
88FB   13                     INX   d   
88FC   12                     STAX   d   
88FD   13                     INX   d   
88FE   12                     STAX   d   
88FF   13                     INX   d   
8900   12                     STAX   d   
8901   13                     INX   d   ; DE = DISPLAY_BASE + 4
8902                             ; 値の byte1 (val_hi) から表示
8902   E1                     POP   h   ; HL = val_lo
8903   23                     INX   h   ; HL = val_hi
8904   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
8906                DISPLAY_BYTE_LOOP:      
8906                             ; 上位ニブル
8906   7E                     MOV   a,m   
8907   0F                     RRC      
8908   0F                     RRC      
8909   0F                     RRC      
890A   0F                     RRC      
890B   E6 0F                  ANI   0Fh   
890D   CD 20 89               CALL   nibble_to_seg   
8910   12                     STAX   d   
8911   13                     INX   d   
8912                             ; 下位ニブル
8912   7E                     MOV   a,m   
8913   E6 0F                  ANI   0Fh   
8915   CD 20 89               CALL   nibble_to_seg   
8918   12                     STAX   d   
8919   13                     INX   d   
891A                             ; 次のバイト (val_hi → val_lo)
891A   2B                     DCX   h   
891B   0D                     DCR   c   
891C   C2 06 89               JNZ   display_byte_loop   
891F   C9                     RET      
8920                             ; ---------------------------------------------------------------
8920                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
8920                             ; 
8920                             ;   入力: A = 0-F
8920                             ;   出力: A = セグメントパターン
8920                             ;   破壊: なし (HL, BC は内部で退避・復元)
8920                             ; ---------------------------------------------------------------
8920                NIBBLE_TO_SEG:      
8920   E5                     PUSH   h   
8921   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
8922   6F                     MOV   l,a   
8923   26 00                  MVI   h,0   
8925   01 2D 89               LXI   b,seg_table   
8928   09                     DAD   b   ; HL = seg_table + nibble
8929   7E                     MOV   a,m   
892A   C1                     POP   b   ; BC を復元
892B   E1                     POP   h   
892C   C9                     RET      
892D                             ; ---------------------------------------------------------------
892D                             ; 7 セグメントパターンテーブル
892D                             ; 
892D                             ;   bit 0 = a (上)
892D                             ;   bit 1 = b (右上)
892D                             ;   bit 2 = c (右下)
892D                             ;   bit 3 = d (下)
892D                             ;   bit 4 = e (左下)
892D                             ;   bit 5 = f (左上)
892D                             ;   bit 6 = g (中)
892D                             ; 
892D                             ;       aaa
892D                             ;      f   b
892D                             ;       ggg
892D                             ;      e   c
892D                             ;       ddd
892D                             ; ---------------------------------------------------------------
892D                SEG_TABLE:      
892D   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
892E   06                     DB   06h   ; 1
892F   5B                     DB   5Bh   ; 2
8930   4F                     DB   4Fh   ; 3
8931   66                     DB   66h   ; 4
8932   6D                     DB   6Dh   ; 5
8933   7D                     DB   7Dh   ; 6
8934   27                     DB   27h   ; 7  (ND8080 ROM パターン)
8935   7F                     DB   7Fh   ; 8
8936   6F                     DB   6Fh   ; 9
8937   77                     DB   77h   ; A
8938   7C                     DB   7Ch   ; b
8939   39                     DB   39h   ; C
893A   5E                     DB   5Eh   ; d
893B   79                     DB   79h   ; E
893C   71                     DB   71h   ; F
893D                             ; ===============================================================
893D                             ; OP_RETURN (B): トップレベルでは VM 停止
893D                             ; 
893D                             ; Phase 1 ではメソッド呼び出しが無いため、常にトップレベル。
893D                             ; R[a] の値を 7 セグに表示して停止する。
893D                             ; ===============================================================
893D                DO_OP_RETURN:      
893D   CD 74 84               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
8940   CD 03 84               CALL   get_reg_addr   ; HL = R[a]
8943   CD 2F 84               CALL   slot_to_value   ; HL = R[a] の値先頭
8946   CD F5 88               CALL   display_hex16   
8949   3E 02                  MVI   a,VM_FINISHED   
894B   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
894E   C3 72 89               JMP   vm_halt   
8951                             ; ===============================================================
8951                             ; OP_STOP (Z): VM 停止
8951                             ; ===============================================================
8951                DO_OP_STOP:      
8951   3E 02                  MVI   a,VM_FINISHED   
8953   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
8956                             ; R[1] の値を 7 セグに表示
8956   3E 01                  MVI   a,1   
8958   CD 03 84               CALL   get_reg_addr   ; HL = R[1]
895B   CD 2F 84               CALL   slot_to_value   ; HL = R[1] の値先頭
895E   CD F5 88               CALL   display_hex16   
8961   C3 72 89               JMP   vm_halt   
8964                             ; ===============================================================
8964                             ; エラー停止
8964                             ; 
8964                             ; 未対応のオペコードを踏んだとき。
8964                             ; 現在のオペコードをエラーコードとして保存する。
8964                             ; ===============================================================
8964                VM_ERROR:      
8964   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
8967   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
896A   3E 03                  MVI   a,VM_ERROR   
896C   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
896F   C3 72 89               JMP   vm_halt   
8972                             ; ===============================================================
8972                             ; 停止 — ND80Z モニタのリモートモードへ復帰
8972                             ; 
8972                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
8972                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
8972                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
8972                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
8972                             ; これにより自動的にリモートモードへ復帰する。
8972                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
8972                             ; ===============================================================
8972                VM_HALT:      
8972                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
8972                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
8972                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
8972   06 04                  MVI   b,4   
8974                VM_HALT_OUTER:      
8974   11 00 00               LXI   d,0   
8977                VM_HALT_INNER:      
8977   1B                     DCX   d   
8978   7A                     MOV   a,d   
8979   B3                     ORA   e   
897A   C2 77 89               JNZ   vm_halt_inner   
897D   05                     DCR   b   
897E   C2 74 89               JNZ   vm_halt_outer   
8981   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
8984                             ; ===============================================================
8984                             ; 初期化
8984                             ; ===============================================================
8984                VM_START:      
8984                             ; スタックポインタを設定
8984   31 00 FE               LXI   sp,STACK_TOP + 1   
8987                             ; VM 状態領域をゼロクリア (256 バイト)
8987   21 00 80               LXI   h,VM_STATE_BASE   
898A   0E 00                  MVI   c,0   ; 256 回 (0 は 256 として扱う)
898C                VM_CLEAR_STATE:      
898C   36 00                  MVI   m,0   
898E   23                     INX   h   
898F   0D                     DCR   c   
8990   C2 8C 89               JNZ   vm_clear_state   
8993                             ; レジスタファイルをゼロクリア (256 バイト)
8993   21 00 81               LXI   h,REG_FILE_BASE   
8996   0E 00                  MVI   c,0   
8998                VM_CLEAR_REGS:      
8998   36 00                  MVI   m,0   
899A   23                     INX   h   
899B   0D                     DCR   c   
899C   C2 98 89               JNZ   vm_clear_regs   
899F                             ; IREP 0 のバイトコード長を VM 状態に設定
899F                             ; IREP テーブルの先頭エントリから読む
899F   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
89A2   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
89A5   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
89A8   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
89AB                             ; PC = 0 (ゼロクリア済み)
89AB                             ; 実行状態を RUNNING に設定
89AB   3E 01                  MVI   a,VM_RUNNING   
89AD   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
89B0                             ; メインループへ
89B0                             ; fall through
89B0                             ; ===============================================================
89B0                             ; メインループ (fetch-decode-execute)
89B0                             ; ===============================================================
89B0                VM_LOOP:      
89B0                             ; --- 実行状態の確認 ---
89B0   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
89B3   FE 01                  CPI   VM_RUNNING   
89B5   C2 72 89               JNZ   vm_halt   
89B8                             ; --- PC がバイトコード長を超えていないか ---
89B8   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
89BB   EB                     XCHG      ; DE = PC
89BC   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
89BF                             ; HL = bytecode_len, DE = PC
89BF                             ; PC >= bytecode_len ならエラー
89BF   7B                     MOV   a,e   
89C0   95                     SUB   l   
89C1   7A                     MOV   a,d   
89C2   9C                     SBB   h   ; DE - HL (PC - len)
89C3   D2 03 00               JNC   vm_error   ; PC >= len → エラー
89C6                             ; --- オペコードフェッチ ---
89C6   CD 74 84               CALL   fetch_byte   ; A = opcode
89C9   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
89CC                             ; --- ステップカウント ---
89CC   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
89CF   23                     INX   h   
89D0   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
89D3                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
89D3   7C                     MOV   a,h   
89D4   B5                     ORA   l   
89D5   C2 DF 89               JNZ   vm_dispatch   
89D8   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
89DB   23                     INX   h   
89DC   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
89DF                             ; --- ディスパッチ ---
89DF                VM_DISPATCH:      
89DF   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
89E2                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
89E2   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
89E3   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
89E6   5F                     MOV   e,a   
89E7   16 00                  MVI   d,0   ; DE = opcode * 2
89E9   21 01 8A               LXI   h,dispatch_table   
89EC   19                     DAD   d   ; HL = &dispatch_table[opcode]
89ED                             ; テーブル上限チェック
89ED   11 D5 8A               LXI   d,dispatch_table_end   
89F0   7B                     MOV   a,e   
89F1   95                     SUB   l   
89F2   7A                     MOV   a,d   
89F3   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
89F4   DA 03 00               JC   vm_error   ; テーブル範囲外
89F7                             ; アドレスを読んでジャンプ
89F7   5E                     MOV   e,m   ; E = 下位バイト
89F8   23                     INX   h   
89F9   56                     MOV   d,m   ; D = 上位バイト
89FA   EB                     XCHG      ; HL = ハンドラアドレス
89FB                             ; 0000h ならエラー (未実装マーカー)
89FB   7C                     MOV   a,h   
89FC   B5                     ORA   l   
89FD   CA 03 00               JZ   vm_error   
8A00   E9                     PCHL      ; ハンドラへジャンプ
8A01                             ; ===============================================================
