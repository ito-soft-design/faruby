AE17   D2 03 00               JNC   vm_error   ; オーバーフロー
AE1A                             ; 書き込み先: data + count * 4
AE1A   3A 69 AE               LDA   apush_cur_count   
AE1D   87                     ADD   a   ; ×2
AE1E   87                     ADD   a   ; ×4
AE1F   5F                     MOV   e,a   
AE20   16 00                  MVI   d,0   
AE22   23                     INX   h   ; HL → データ領域先頭
AE23   19                     DAD   d   ; HL = 書き込み位置
AE24   EB                     XCHG      ; DE = 書き込み位置
AE25                             ; R[a+1] から b 個のスロットをコピー
AE25   3A 67 AE               LDA   apush_reg_a   
AE28   3C                     INR   a   
AE29   47                     MOV   b,a   ; B = 現在のレジスタ番号
AE2A   3A 68 AE               LDA   apush_add_count   
AE2D   4F                     MOV   c,a   ; C = 残り要素数
AE2E                APUSH_LOOP:      
AE2E   3E 04                  MVI   a,SLOT_BYTES   
