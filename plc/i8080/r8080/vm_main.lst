24A3                             ; ===============================================================
24A3                             ; send_length — length / size: 文字列長・配列長を返す
24A3                             ; 
24A3                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
24A3                             ; ===============================================================
24A3                SEND_LENGTH:      
24A3   3A 4D 17               LDA   send_reg_a   
24A6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
24A9   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
24AC   23                     INX   h   ; +1: count
24AD   4E                     MOV   c,m   ; C = count
24AE   06 00                  MVI   b,0   ; BC = count (16-bit)
24B0   3A 4D 17               LDA   send_reg_a   
24B3   CD 00 10               CALL   get_reg_addr   
24B6   CD 10 10               CALL   set_slot_int16   ; R[a] = count
24B9   C3 78 1D               JMP   vm_loop   
24BC                             ; 
24BC                             ; ===============================================================
24BC                             ; send_concat — << (文字列追記 / 配列追加)
24BC                             ; 
24BC                             ; R[a] の型で分岐:
24BC                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
24BC                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
24BC                             ; ===============================================================
24BC                SEND_CONCAT:      
24BC   3A 4D 17               LDA   send_reg_a   
24BF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
24C2   7E                     MOV   a,m   ; A = 型タグ
24C3   FE 07                  CPI   TT_STRING   
24C5   CA D0 24               JZ   concat_string   
24C8   FE 08                  CPI   TT_ARRAY   
24CA   CA 7A 25               JZ   concat_array   
24CD   C3 58 1D               JMP   vm_fail   
24D0                             ; 
24D0                CONCAT_STRING:      
24D0                             ; R[a+1] の型を確認
24D0   3A 4D 17               LDA   send_reg_a   
24D3   3C                     INR   a   
24D4   CD 00 10               CALL   get_reg_addr   
24D7   7E                     MOV   a,m   ; A = R[a+1] の型タグ
24D8   FE 07                  CPI   TT_STRING   
24DA   CA E5 24               JZ   concat_str_str   
24DD   FE 04                  CPI   TT_INTEGER   
24DF   CA 55 25               JZ   concat_str_int   
24E2   C3 58 1D               JMP   vm_fail   
24E5                             ; 
24E5                CONCAT_STR_STR:      
24E5                             ; R[a+1] のコレクションスロット (ソース)
24E5   3A 4D 17               LDA   send_reg_a   
24E8   3C                     INR   a   
24E9   CD 00 10               CALL   get_reg_addr   
24EC   CD CE 21               CALL   col_from_reg   ; HL = ソーススロット
24EF   23                     INX   h   ; +1: count
24F0   7E                     MOV   a,m   ; A = ソース文字列長
24F1   32 20 80               STA   cc_src_len   
24F4   23                     INX   h   ; HL → データ先頭
24F5   22 23 80               SHLD   cc_src_data   
24F8                             ; 
24F8                             ; R[a] のコレクションスロット (デスト)
24F8   3A 4D 17               LDA   send_reg_a   
24FB   CD 00 10               CALL   get_reg_addr   
24FE   CD CE 21               CALL   col_from_reg   ; HL = デストスロット
2501   23                     INX   h   ; +1: count
2502   7E                     MOV   a,m   
2503   32 21 80               STA   cc_dst_len   
2506                             ; 
2506                             ; コピー可能バイト数を計算
2506   3A 20 80               LDA   cc_src_len   
2509   47                     MOV   b,a   
250A   3A 21 80               LDA   cc_dst_len   
250D   80                     ADD   b   
250E   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
2510   DA 25 25               JC   cc_str_len_ok   
2513                             ; 切り詰め
2513   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2515   47                     MOV   b,a   
2516   3A 21 80               LDA   cc_dst_len   
2519   4F                     MOV   c,a   
251A   78                     MOV   a,b   
251B   91                     SUB   c   
251C   32 20 80               STA   cc_src_len   
251F   3A 21 80               LDA   cc_dst_len   
2522   87                     ADD   a   ; ここでは使わない — 合計は MAX
2523   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2525                CC_STR_LEN_OK:      
2525   32 22 80               STA   cc_total_len   
2528                             ; 
2528                             ; count を更新
2528   3A 4D 17               LDA   send_reg_a   
252B   CD 00 10               CALL   get_reg_addr   
252E   CD CE 21               CALL   col_from_reg   
2531   23                     INX   h   
2532   3A 22 80               LDA   cc_total_len   
2535   77                     MOV   m,a   
2536   23                     INX   h   ; HL → データ先頭
2537                             ; 
2537                             ; 書き込み位置 = data + dst_len
2537   3A 21 80               LDA   cc_dst_len   
253A   5F                     MOV   e,a   
253B   16 00                  MVI   d,0   
253D   19                     DAD   d   
253E                             ; 
253E                             ; コピー
253E   EB                     XCHG      
253F   2A 23 80               LHLD   cc_src_data   
2542   3A 20 80               LDA   cc_src_len   
2545   B7                     ORA   a   
2546   CA 52 25               JZ   cc_str_done   
2549   4F                     MOV   c,a   
254A                CC_STR_COPY:      
254A   7E                     MOV   a,m   
254B   12                     STAX   d   
254C   23                     INX   h   
254D   13                     INX   d   
254E   0D                     DCR   c   
254F   C2 4A 25               JNZ   cc_str_copy   
2552                CC_STR_DONE:      
2552                             ; R[a] をそのまま返す (破壊的操作)
2552   C3 78 1D               JMP   vm_loop   
2555                             ; 
2555                CONCAT_STR_INT:      
2555                             ; R[a+1] の val_lo を 1 バイトとして追記
2555   3A 4D 17               LDA   send_reg_a   
2558   3C                     INR   a   
2559   CD 00 10               CALL   get_reg_addr   
255C   CD 32 10               CALL   slot_to_value   
255F   4E                     MOV   c,m   ; C = 文字コード (val_lo)
2560                             ; 
2560                             ; R[a] のコレクションスロット
2560   3A 4D 17               LDA   send_reg_a   
2563   CD 00 10               CALL   get_reg_addr   
2566   CD CE 21               CALL   col_from_reg   ; HL = デストスロット
2569   23                     INX   h   ; +1: count
256A   7E                     MOV   a,m   
256B   FE 22                  CPI   COL_MAX_STRING_LEN   
256D   D2 78 1D               JNC   vm_loop   ; 満杯なら何もしない
2570   34                     INR   m   ; count++
2571   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
2572   23                     INX   h   ; HL → データ先頭
2573   16 00                  MVI   d,0   
2575   19                     DAD   d   ; HL = &data[old_count]
2576   71                     MOV   m,c   ; 書き込み
2577   C3 78 1D               JMP   vm_loop   
257A                             ; 
257A                CONCAT_ARRAY:      
257A                             ; R[a] のコレクションスロット
257A   3A 4D 17               LDA   send_reg_a   
257D   CD 00 10               CALL   get_reg_addr   
2580   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
2583   23                     INX   h   ; +1: count
2584   7E                     MOV   a,m   
2585   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
2587   D2 58 1D               JNC   vm_fail   ; 満杯
258A   32 25 80               STA   cc_ary_count   
258D   34                     INR   m   ; count++
258E                             ; 
258E                             ; 書き込み位置: data + count * 4
258E   23                     INX   h   ; HL → データ先頭
258F   3A 25 80               LDA   cc_ary_count   
2592   87                     ADD   a   ; ×2
2593   87                     ADD   a   ; ×4
2594   5F                     MOV   e,a   
2595   16 00                  MVI   d,0   
2597   19                     DAD   d   ; HL = 書き込み位置
2598   EB                     XCHG      ; DE = 書き込み位置
2599                             ; 
2599                             ; R[a+1] をコピー
2599   3A 4D 17               LDA   send_reg_a   
259C   3C                     INR   a   
259D   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
25A0   0E 04                  MVI   c,SLOT_BYTES   
25A2                CC_ARY_COPY:      
25A2   7E                     MOV   a,m   
25A3   12                     STAX   d   
25A4   23                     INX   h   
25A5   13                     INX   d   
25A6   0D                     DCR   c   
25A7   C2 A2 25               JNZ   cc_ary_copy   
25AA   C3 78 1D               JMP   vm_loop   
25AD                             ; 
25AD                             ; --- concat 一時変数 ---
25AD                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
25AD                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
25AD                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
25AD                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
25AD                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
25AD                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
25AD                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
25AD                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
25AD                             ; 
25AD                             ; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
25AD                             ; 
25AD                             ; Hash スロット形式 (コレクションプール 36B スロット内):
25AD                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
25AD                             ;   +1: count (1B)  ペア数 (最大 4)
25AD                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
25AD                             ; 
25AD                             ; キー検索は線形 4 バイト比較。
25AD                             ; 
25AD                             ; ===============================================================
25AD                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
25AD                             ; 
25AD                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
25AD                             ; ===============================================================
25AD                DO_OP_ARRAY2:      
25AD   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
25B0   32 AA 23               STA   oary_reg_a   
25B3   CD C0 10               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
25B6   32 AB 23               STA   oary_src_reg   
25B9   CD C0 10               CALL   fetch_byte   ; A = c (要素数)
25BC   C3 3F 23               JMP   oa2_join   
25BF                             ; 
25BF                             ; ===============================================================
25BF                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
25BF                             ; 
25BF                             ;   a = 書き込み先レジスタ
25BF                             ;   b = ペア数 (0 = 空 Hash)
25BF                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
25BF                             ; ===============================================================
25BF                DO_OP_HASH:      
25BF   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
25C2   32 27 26               STA   hash_reg_a   
25C5   CD C0 10               CALL   fetch_byte   ; A = b (ペア数)
25C8   32 28 26               STA   hash_count   
25CB                             ; 
25CB                             ; コレクションスロット確保
25CB   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
25CE   32 29 26               STA   hash_slot_num   
25D1                             ; 
25D1                             ; ヘッダ書き込み
25D1   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
25D3   23                     INX   h   
25D4   3A 28 26               LDA   hash_count   
25D7   77                     MOV   m,a   ; +1: count
25D8   23                     INX   h   ; HL → データ領域先頭
25D9                             ; 
25D9                             ; ペアがなければ結果書き込みへ
25D9   3A 28 26               LDA   hash_count   
25DC   B7                     ORA   a   
25DD   CA 10 26               JZ   hash_write_result   
25E0                             ; 
25E0                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
25E0   3A 27 26               LDA   hash_reg_a   
25E3   32 2A 26               STA   hash_src_reg   
25E6                             ; 
25E6                HASH_COPY_PAIR:      
25E6                             ; HL = コレクションプール内の書き込み位置
25E6                             ; key (4B) をコピー: R[src] → [HL]
25E6   E5                     PUSH   h   ; 書き込み先を退避
25E7   3A 2A 26               LDA   hash_src_reg   
25EA   CD 00 10               CALL   get_reg_addr   ; HL = R[src]
25ED   D1                     POP   d   ; DE = 書き込み先
25EE   CD 25 10               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
25F1                             ; DE = value 書き込み位置
25F1                             ; 
25F1                             ; value (4B) をコピー: R[src+1] → [DE]
25F1   D5                     PUSH   d   ; value 書き込み先を退避
25F2   3A 2A 26               LDA   hash_src_reg   
25F5   3C                     INR   a   
25F6   CD 00 10               CALL   get_reg_addr   ; HL = R[src+1]
25F9   D1                     POP   d   ; DE = value 書き込み先
25FA   CD 25 10               CALL   copy_slot   ; 4B コピー
25FD                             ; DE = 次ペアの先頭
25FD                             ; 
25FD                             ; ソースレジスタを +2
25FD   3A 2A 26               LDA   hash_src_reg   
2600   C6 02                  ADI   2   
2602   32 2A 26               STA   hash_src_reg   
2605                             ; 
2605                             ; HL = 次の書き込み位置 (DE から)
2605   EB                     XCHG      
2606                             ; 
2606                             ; ペアカウンタ
2606   3A 28 26               LDA   hash_count   
2609   3D                     DCR   a   
260A   32 28 26               STA   hash_count   
260D   C2 E6 25               JNZ   hash_copy_pair   
2610                             ; 
2610                HASH_WRITE_RESULT:      
2610                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
2610   3A 27 26               LDA   hash_reg_a   
2613   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2616   36 09                  MVI   m,TT_HASH   ; +0: type
2618   23                     INX   h   
2619   36 00                  MVI   m,0   ; +1: reserved
261B   23                     INX   h   
261C   3A 29 26               LDA   hash_slot_num   
261F   3C                     INR   a   ; slot + 1
2620   77                     MOV   m,a   ; +2: val_lo
2621   23                     INX   h   
2622   36 00                  MVI   m,0   ; +3: val_hi
2624   C3 78 1D               JMP   vm_loop   
2627                             ; 
2627                             ; --- do_op_hash データ ---
2627   00           HASH_REG_A:   DB   0   
2628   00           HASH_COUNT:   DB   0   
2629   00           HASH_SLOT_NUM:   DB   0   
262A   00           HASH_SRC_REG:   DB   0   
262B                             ; 
262B                             ; ===============================================================
262B                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
262B                             ; 
262B                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
262B                             ;   キーが見つからなければ R[a] = nil
262B                             ; ===============================================================
262B                GIDX_HASH:      
262B                             ; コレクションスロットを取得
262B   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
262E   23                     INX   h   ; +1: count
262F   7E                     MOV   a,m   ; A = ペア数
2630   23                     INX   h   ; HL → データ領域
2631   B7                     ORA   a   
2632   CA 7E 26               JZ   ghash_not_found   ; 空 Hash
2635                             ; 
2635   32 92 26               STA   ghash_loop_cnt   
2638   22 8C 26               SHLD   ghash_data_ptr   
263B                             ; 
263B                             ; 検索キー R[a+1] のアドレスを取得
263B   3A 79 22               LDA   gidx_reg_a   
263E   3C                     INR   a   
263F   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2642   22 8E 26               SHLD   ghash_key_ptr   
2645                             ; 
2645                             ; 検索ループ
2645   2A 8C 26               LHLD   ghash_data_ptr   
2648                GHASH_SEARCH:      
2648   22 90 26               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
264B                             ; 
264B                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
264B   E5                     PUSH   h   
264C   2A 8E 26               LHLD   ghash_key_ptr   
264F   EB                     XCHG      ; DE = 検索キー
2650   E1                     POP   h   ; HL = hash ペアのキー
2651                             ; 
2651   0E 04                  MVI   c,SLOT_BYTES   
2653                GHASH_CMP:      
2653   1A                     LDAX   d   
2654   BE                     CMP   m   
2655   C2 6D 26               JNZ   ghash_next   
2658   23                     INX   h   
2659   13                     INX   d   
265A   0D                     DCR   c   
265B   C2 53 26               JNZ   ghash_cmp   
265E                             ; 
265E                             ; 一致! HL = value 位置 (キー直後)
265E                             ; value (4B) を R[a] にコピー
265E   E5                     PUSH   h   ; value ソース
265F   3A 79 22               LDA   gidx_reg_a   
2662   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2665   EB                     XCHG      ; DE = R[a] (コピー先)
2666   E1                     POP   h   ; HL = value (コピー元)
2667   CD 25 10               CALL   copy_slot   
266A   C3 78 1D               JMP   vm_loop   
266D                             ; 
266D                GHASH_NEXT:      
266D                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
266D   2A 90 26               LHLD   ghash_cur_ptr   
2670   11 08 00               LXI   d,HASH_PAIR_BYTES   
2673   19                     DAD   d   
2674   3A 92 26               LDA   ghash_loop_cnt   
2677   3D                     DCR   a   
2678   32 92 26               STA   ghash_loop_cnt   
267B   C2 48 26               JNZ   ghash_search   
267E                             ; 
267E                GHASH_NOT_FOUND:      
267E                             ; R[a] = nil
267E   3A 79 22               LDA   gidx_reg_a   
2681   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2684   3E 01                  MVI   a,TT_NIL   
2686   CD 1A 10               CALL   set_slot_special   
2689   C3 78 1D               JMP   vm_loop   
268C                             ; 
268C                             ; --- gidx_hash データ ---
268C   00 00        GHASH_DATA_PTR:   DW   0   
268E   00 00        GHASH_KEY_PTR:   DW   0   
2690   00 00        GHASH_CUR_PTR:   DW   0   
2692   00           GHASH_LOOP_CNT:   DB   0   
2693                             ; 
2693                             ; ===============================================================
2693                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
2693                             ; 
2693                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
2693                             ;   既存キー → 値を上書き
2693                             ;   新規キー → count < MAX なら末尾に追加
2693                             ; ===============================================================
2693                SIDX_HASH:      
2693                             ; コレクションスロットを取得
2693   CD CE 21               CALL   col_from_reg   ; HL = コレクションスロット
2696   22 22 27               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
2699   23                     INX   h   ; +1: count
269A   7E                     MOV   a,m   
269B   32 2C 27               STA   shash_pair_cnt   ; 元のペア数
269E   23                     INX   h   ; HL → データ領域
269F   22 24 27               SHLD   shash_data_ptr   
26A2                             ; 
26A2                             ; R[a+1] キーのアドレス
26A2   3A 30 23               LDA   sidx_reg_a   
26A5   3C                     INR   a   
26A6   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
26A9   22 26 27               SHLD   shash_key_ptr   
26AC                             ; 
26AC                             ; R[a+2] 値のアドレス
26AC   3A 30 23               LDA   sidx_reg_a   
26AF   C6 02                  ADI   2   
26B1   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
26B4   22 28 27               SHLD   shash_val_ptr   
26B7                             ; 
26B7                             ; 既存キーを検索
26B7   3A 2C 27               LDA   shash_pair_cnt   
26BA   B7                     ORA   a   
26BB   CA F5 26               JZ   shash_append   ; 空 Hash → 追加
26BE                             ; 
26BE   32 2D 27               STA   shash_loop_cnt   
26C1   2A 24 27               LHLD   shash_data_ptr   
26C4                             ; 
26C4                SHASH_SEARCH:      
26C4   22 2A 27               SHLD   shash_cur_ptr   
26C7                             ; 
26C7   E5                     PUSH   h   
26C8   2A 26 27               LHLD   shash_key_ptr   
26CB   EB                     XCHG      ; DE = 検索キー
26CC   E1                     POP   h   ; HL = hash ペアのキー
26CD                             ; 
26CD   0E 04                  MVI   c,SLOT_BYTES   
26CF                SHASH_CMP:      
26CF   1A                     LDAX   d   
26D0   BE                     CMP   m   
26D1   C2 E4 26               JNZ   shash_snext   
26D4   23                     INX   h   
26D5   13                     INX   d   
26D6   0D                     DCR   c   
26D7   C2 CF 26               JNZ   shash_cmp   
26DA                             ; 
26DA                             ; 一致! HL = value 位置
26DA                             ; R[a+2] を value にコピー
26DA   EB                     XCHG      ; DE = hash value 位置
26DB   2A 28 27               LHLD   shash_val_ptr   ; HL = R[a+2]
26DE   CD 25 10               CALL   copy_slot   
26E1   C3 78 1D               JMP   vm_loop   
26E4                             ; 
26E4                SHASH_SNEXT:      
26E4   2A 2A 27               LHLD   shash_cur_ptr   
26E7   11 08 00               LXI   d,HASH_PAIR_BYTES   
26EA   19                     DAD   d   
26EB   3A 2D 27               LDA   shash_loop_cnt   
26EE   3D                     DCR   a   
26EF   32 2D 27               STA   shash_loop_cnt   
26F2   C2 C4 26               JNZ   shash_search   
26F5                             ; 
26F5                             ; 見つからなかった → 末尾に追加
26F5                             ; 
26F5                SHASH_APPEND:      
26F5                             ; 容量チェック
26F5   3A 2C 27               LDA   shash_pair_cnt   
26F8   FE 04                  CPI   COL_MAX_HASH_PAIRS   
26FA   D2 58 1D               JNC   vm_fail   ; Hash 満杯
26FD                             ; 
26FD                             ; count++ を書き込み
26FD   3C                     INR   a   
26FE   F5                     PUSH   psw   
26FF   2A 22 27               LHLD   shash_col_ptr   
2702   23                     INX   h   ; +1: count フィールド
2703   77                     MOV   m,a   
2704   F1                     POP   psw   
2705                             ; 
2705                             ; 追加位置 = data + old_count * 8
2705   3A 2C 27               LDA   shash_pair_cnt   ; old count
2708   87                     ADD   a   ; ×2
2709   87                     ADD   a   ; ×4
270A   87                     ADD   a   ; ×8
270B   5F                     MOV   e,a   
270C   16 00                  MVI   d,0   
270E   2A 24 27               LHLD   shash_data_ptr   
2711   19                     DAD   d   ; HL = 追加位置
2712                             ; 
2712                             ; key をコピー (R[a+1] → [HL])
2712   EB                     XCHG      ; DE = 追加位置
2713   2A 26 27               LHLD   shash_key_ptr   ; HL = R[a+1]
2716   CD 25 10               CALL   copy_slot   ; key 4B、DE は value 位置に進む
2719                             ; 
2719                             ; value をコピー (R[a+2] → [DE])
2719   2A 28 27               LHLD   shash_val_ptr   ; HL = R[a+2]
271C                             ; DE は既に value 位置
271C   CD 25 10               CALL   copy_slot   
271F   C3 78 1D               JMP   vm_loop   
2722                             ; 
2722                             ; --- sidx_hash データ ---
2722   00 00        SHASH_COL_PTR:   DW   0   
2724   00 00        SHASH_DATA_PTR:   DW   0   
2726   00 00        SHASH_KEY_PTR:   DW   0   
2728   00 00        SHASH_VAL_PTR:   DW   0   
272A   00 00        SHASH_CUR_PTR:   DW   0   
272C   00           SHASH_PAIR_CNT:   DB   0   
272D   00           SHASH_LOOP_CNT:   DB   0   
272E                             ; 
272E                             ; ===============================================================
272E                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
272E                             ; 
272E                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
272E                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
272E                             ; ROM がなければ即 nil。
272E                             ; 
272E                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
272E                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
272E                             ; ===============================================================
272E                SEND_GETKEY_TIMEOUT:      
272E                             ; R[a+1] からタイムアウト回数を読む
272E   3A 4D 17               LDA   send_reg_a   
2731   C6 01                  ADI   1   
2733   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2736   23                     INX   h   
2737   23                     INX   h   ; +2: val_lo
2738   4E                     MOV   c,m   
2739   23                     INX   h   ; +3: val_hi
273A   46                     MOV   b,m   ; BC = タイムアウト回数
273B                             ; 
273B                             ; ROM チェック
273B   3A 47 06               LDA   KEY_ADDR   
273E   B7                     ORA   a   
273F   CA 69 27               JZ   getkey_timeout_nil   ; ROM なし → nil
2742                             ; 
2742                GETKEY_POLL_LOOP:      
2742   78                     MOV   a,b   
2743   B1                     ORA   c   
2744   CA 69 27               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
2747                             ; 
2747   C5                     PUSH   b   ; カウンタ退避
2748   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
274B   C1                     POP   b   ; カウンタ復帰
274C   FE FF                  CPI   0FFh   
274E   C2 5A 27               JNZ   getkey_timeout_got   ; キー押下!
2751                             ; 
2751   C5                     PUSH   b   ; カウンタ退避
2752   CD 4A 21               CALL   lfsr_next   ; 待機中に LFSR を進める
2755   C1                     POP   b   
2756   0B                     DCX   b   ; カウンタ--
2757   C3 42 27               JMP   getkey_poll_loop   
275A                             ; 
275A                GETKEY_TIMEOUT_GOT:      
275A                             ; A = キーコード (0x00-0x17)
275A   4F                     MOV   c,a   
275B   06 00                  MVI   b,0   
275D   3A 4D 17               LDA   send_reg_a   
2760   CD 00 10               CALL   get_reg_addr   
2763   CD 10 10               CALL   set_slot_int16   
2766   C3 78 1D               JMP   vm_loop   
2769                             ; 
2769                GETKEY_TIMEOUT_NIL:      
2769   3A 4D 17               LDA   send_reg_a   
276C   CD 00 10               CALL   get_reg_addr   
276F   3E 01                  MVI   a,TT_NIL   
2771   CD 1A 10               CALL   set_slot_special   
2774   C3 78 1D               JMP   vm_loop   
2777                             ; 
2777                             ; ===============================================================
2777                             ; send_slice — [](offset, length): 文字列スライス
2777                             ; 
2777                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
2777                             ; 
2777                             ;   入力: send_reg_a = a, send_argc = 2
2777                             ;         R[a] = TT_STRING (対象文字列)
2777                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
2777                             ;         R[a+2] = length (TT_INTEGER)
2777                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
2777                             ;         offset >= 文字列長 → 空文字列
2777                             ;         length は利用可能バイト数にクランプ
2777                             ; ===============================================================
2777                SEND_SLICE:      
2777                             ; R[a] が TT_STRING か確認
2777   3A 4D 17               LDA   send_reg_a   
277A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
277D   7E                     MOV   a,m   ; A = 型タグ
277E   FE 07                  CPI   TT_STRING   
2780   C2 58 1D               JNZ   vm_fail   
2783                             ; 
2783                             ; ソース文字列のコレクションスロットを取得
2783   3A 4D 17               LDA   send_reg_a   
2786   CD 00 10               CALL   get_reg_addr   
2789   CD CE 21               CALL   col_from_reg   ; HL = collection slot
278C   23                     INX   h   ; +1: count
278D   7E                     MOV   a,m   
278E   32 1E 28               STA   slice_src_count   
2791   23                     INX   h   ; HL → data
2792   22 1F 28               SHLD   slice_src_data   
2795                             ; 
2795                             ; R[a+1] から offset を取得
2795   3A 4D 17               LDA   send_reg_a   
2798   C6 01                  ADI   1   
279A   CD 00 10               CALL   get_reg_addr   
279D   CD 32 10               CALL   slot_to_value   
27A0   7E                     MOV   a,m   ; A = offset (val_lo)
27A1   32 21 28               STA   slice_offset   
27A4                             ; 
27A4                             ; R[a+2] から length を取得
27A4   3A 4D 17               LDA   send_reg_a   
27A7   C6 02                  ADI   2   
27A9   CD 00 10               CALL   get_reg_addr   
27AC   CD 32 10               CALL   slot_to_value   
27AF   7E                     MOV   a,m   ; A = length (val_lo)
27B0   32 22 28               STA   slice_length   
27B3                             ; 
27B3                             ; offset >= src_count → 空文字列
27B3   3A 21 28               LDA   slice_offset   
27B6   47                     MOV   b,a   ; B = offset
27B7   3A 1E 28               LDA   slice_src_count   ; A = src_count
27BA   B8                     CMP   b   
27BB   DA 10 28               JC   slice_empty   ; src_count < offset
27BE   CA 10 28               JZ   slice_empty   ; src_count == offset
27C1                             ; 
27C1                             ; available = src_count - offset
27C1   90                     SUB   b   ; A = available
27C2   47                     MOV   b,a   ; B = available
27C3   3A 22 28               LDA   slice_length   
27C6   B8                     CMP   b   
27C7   DA CB 27               JC   slice_len_ok   ; length < available → そのまま
27CA   78                     MOV   a,b   ; clamp: length = available
27CB                SLICE_LEN_OK:      
27CB   32 22 28               STA   slice_length   ; 実際のコピー長
27CE                             ; 
27CE                             ; 新しいコレクションスロットを確保
27CE   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
27D1   32 23 28               STA   slice_new_slot   
27D4   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
27D6   23                     INX   h   
27D7   3A 22 28               LDA   slice_length   
27DA   77                     MOV   m,a   ; +1: count = コピー長
27DB   23                     INX   h   ; HL → new data area
27DC                             ; 
27DC                             ; ソースデータ先頭 + offset
27DC   E5                     PUSH   h   ; dest を退避
27DD   2A 1F 28               LHLD   slice_src_data   
27E0   3A 21 28               LDA   slice_offset   
27E3   5F                     MOV   e,a   
27E4   16 00                  MVI   d,0   
27E6   19                     DAD   d   ; HL = src_data + offset
27E7   EB                     XCHG      ; DE = src + offset
27E8   E1                     POP   h   ; HL = dest
27E9                             ; 
27E9                             ; バイトコピー
27E9   3A 22 28               LDA   slice_length   
27EC   B7                     ORA   a   
27ED   CA F9 27               JZ   slice_done   
27F0   4F                     MOV   c,a   
27F1                SLICE_COPY:      
27F1   1A                     LDAX   d   
27F2   77                     MOV   m,a   
27F3   23                     INX   h   
27F4   13                     INX   d   
27F5   0D                     DCR   c   
27F6   C2 F1 27               JNZ   slice_copy   
27F9                             ; 
27F9                SLICE_DONE:      
27F9                             ; R[a] = TT_STRING, val_lo = new_slot + 1
27F9   3A 4D 17               LDA   send_reg_a   
27FC   CD 00 10               CALL   get_reg_addr   
27FF   36 07                  MVI   m,TT_STRING   ; +0: type
2801   23                     INX   h   
2802   36 00                  MVI   m,0   ; +1: reserved
2804   23                     INX   h   
2805   3A 23 28               LDA   slice_new_slot   
2808   3C                     INR   a   ; slot + 1
2809   77                     MOV   m,a   ; +2: val_lo
280A   23                     INX   h   
280B   36 00                  MVI   m,0   ; +3: val_hi
280D   C3 78 1D               JMP   vm_loop   
2810                             ; 
2810                SLICE_EMPTY:      
2810                             ; 空文字列を返す
2810   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2813   32 23 28               STA   slice_new_slot   
2816   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
2818   23                     INX   h   
2819   36 00                  MVI   m,0   ; +1: count = 0
281B   C3 F9 27               JMP   slice_done   
281E                             ; 
281E                             ; --- send_slice データ ---
281E   00           SLICE_SRC_COUNT:   DB   0   
281F   00 00        SLICE_SRC_DATA:   DW   0   
2821   00           SLICE_OFFSET:   DB   0   
2822   00           SLICE_LENGTH:   DB   0   
2823   00           SLICE_NEW_SLOT:   DB   0   
2824                             ; 
2824                             ; ===============================================================
2824                             ; col_gc_alloc — 到達性を辿る回収つきのスロット確保
2824                             ; 
2824                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
2824                             ; 
2824                             ; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
2824                             ; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
2824                             ; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
2824                             ; 
2824                             ; ルート:
2824                             ;   レジスタファイル    MAX_REGS 個の値スロット
2824                             ;   グローバル変数      MAX_GLOBALS 個の値スロット
2824                             ;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
2824                             ; 
2824                             ; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
2824                             ; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
2824                             ; 起動時にゼロクリアされていて型 0 なので素通りする。
2824                             ; 
2824                             ; 伝播:
2824                             ;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
2824                             ;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
2824                             ; 
2824                             ;   出力: A = スロット番号, HL = スロットアドレス
2824                             ;   エラー: 全スロット生きている → vm_fail
2824                             ; ===============================================================
2824                COL_GC_ALLOC:      
2824                             ; **前の走査で作った印がまだ使えるなら、走査せずに空きを配る。**
2824                             ; 
2824                             ; 走査 1 回は実機で 51 ms。印を捨てると確保のたびに払うことになり、
2824                             ; 文字列を 9 個作る描画 1 回で 460 ms になっていた。印は走査のあと
2824                             ; 「空き表」として使い回す — 配った枠には印を立てるので二度は出ない。
2824                             ; 
2824                             ; **走査のあとに死んだものは次の走査まで空かない。** 安全側に外すだけで、
2824                             ; 生きているものを配ることはない。
2824   3A CF 29               LDA   gc_have_free   
2827   B7                     ORA   a   
2828   CA 37 28               JZ   col_gc_sweep   
282B   CD A0 28               CALL   gc_scan_free   
282E   FE FF                  CPI   0FFh   
2830   C2 95 28               JNZ   gc_found_free   ; A = 空きスロット番号
2833                             ; 印が古くて空きが無い。捨てて走査からやり直す
2833   AF                     XRA   a   
2834   32 CF 29               STA   gc_have_free   
2837                             ; 
2837                COL_GC_SWEEP:      
2837                             ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
2837   AF                     XRA   a   
2838   21 BE 29               LXI   h,gc_bitmap   
283B   0E 10                  MVI   c,16   
283D                GC_CLEAR_BM:      
283D   77                     MOV   m,a   
283E   23                     INX   h   
283F   0D                     DCR   c   
2840   C2 3D 28               JNZ   gc_clear_bm   
2843                             ; 
2843                             ; --- ルート: レジスタファイル ---
2843                             ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
2843   21 00 81               LXI   h,REG_FILE_BASE   
2846   06 40                  MVI   b,MAX_REGS   
2848                GC_ROOT_REG:      
2848   CD 43 29               CALL   gc_mark_value   
284B   23                     INX   h   
284C   23                     INX   h   
284D   23                     INX   h   
284E   23                     INX   h   
284F   05                     DCR   b   
2850   C2 48 28               JNZ   gc_root_reg   
2853                             ; 
2853                             ; --- ルート: グローバル変数 ---
2853   21 00 90               LXI   h,GLOBALS_BASE   
2856   06 40                  MVI   b,MAX_GLOBALS   
2858                GC_ROOT_GLOBAL:      
2858   CD 43 29               CALL   gc_mark_value   
285B   23                     INX   h   
285C   23                     INX   h   
285D   23                     INX   h   
285E   23                     INX   h   
285F   05                     DCR   b   
2860   C2 58 28               JNZ   gc_root_global   
2863                             ; 
2863                             ; --- ルート: オブジェクトのインスタンス変数 ---
2863   21 C4 92               LXI   h,OBJECT_POOL_BASE + OBJECT_HEADER_SIZE   
2866   06 20                  MVI   b,MAX_OBJECTS   
2868                GC_ROOT_OBJ:      
2868   C5                     PUSH   b   
2869   E5                     PUSH   h   
286A   06 07                  MVI   b,MAX_IVARS   
286C                GC_ROOT_IVAR:      
286C   CD 43 29               CALL   gc_mark_value   
286F   23                     INX   h   
2870   23                     INX   h   
2871   23                     INX   h   
2872   23                     INX   h   
2873   05                     DCR   b   
2874   C2 6C 28               JNZ   gc_root_ivar   
2877   E1                     POP   h   
2878   11 20 00               LXI   d,OBJECT_SLOT_SIZE   
287B   19                     DAD   d   ; 次のオブジェクトの ivar 先頭
287C   C1                     POP   b   
287D   05                     DCR   b   
287E   C2 68 28               JNZ   gc_root_obj   
2881                             ; 
2881                             ; --- 到達性を伝播する ---
2881   CD BC 28               CALL   gc_propagate   
2884                             ; 
2884                             ; **ここから印は空き表になる。** 次の確保はこれを見るだけで済む
2884   3E 01                  MVI   a,1   
2886   32 CF 29               STA   gc_have_free   
2889   AF                     XRA   a   
288A   32 D0 29               STA   gc_free_next   ; しおりを先頭へ
288D                             ; 
288D                             ; --- 印の付かなかったスロットを探す ---
288D                             ; **走査した直後なのでここで無ければ本当に満杯。**
288D   CD A0 28               CALL   gc_scan_free   
2890   FE FF                  CPI   0FFh   
2892   CA 58 1D               JZ   vm_fail   ; 全スロット使用中
2895                             ; 
2895                GC_FOUND_FREE:      
2895                             ; A = 空きスロット番号
2895   F5                     PUSH   psw   
2896   CD 8C 29               CALL   gc_set_bit   ; **配ったら印を立てる。** 二度配らないため
2899   F1                     POP   psw   
289A   F5                     PUSH   psw   ; スロット番号を退避
289B   CD A9 21               CALL   col_slot_addr   ; HL = スロットアドレス
289E   F1                     POP   psw   ; A = スロット番号を復帰
289F   C9                     RET      
28A0                             ; 
28A0                             ; ---------------------------------------------------------------
28A0                             ; gc_scan_free — 印の付いていないスロットを探す
28A0                             ; 
28A0                             ;   出力: A = スロット番号 / 0FFh = 空き無し
28A0                             ;   破壊: B
28A0                             ; 
28A0                             ; B をカウンタに使う (gc_check_bit は B を壊さない)。
28A0                             ; 
28A0                             ; **しおりから探す。** 配る順は増える一方で、配った枠には印を立てるので、
28A0                             ; しおりより前はすべて印が付いている (生きているか、配ったか)。0 から
28A0                             ; 舐め直すと 64 枠ぶんの検査が確保のたびに乗る。
28A0                             ; ---------------------------------------------------------------
28A0                GC_SCAN_FREE:      
28A0   3A D0 29               LDA   gc_free_next   
28A3   47                     MOV   b,a   
28A4                GC_SF_LOOP:      
28A4   78                     MOV   a,b   ; A = 検査対象スロット番号
28A5   CD 99 29               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
28A8   CA B5 28               JZ   gc_sf_hit   
28AB   04                     INR   b   
28AC   78                     MOV   a,b   
28AD   FE 40                  CPI   MAX_COL_SLOTS   
28AF   DA A4 28               JC   gc_sf_loop   
28B2   3E FF                  MVI   a,0FFh   
28B4   C9                     RET      
28B5                GC_SF_HIT:      
28B5                             ; しおりを次へ。**この枠はすぐ印が立つ**ので飛ばして構わない
28B5   78                     MOV   a,b   
28B6   3C                     INR   a   
28B7   32 D0 29               STA   gc_free_next   
28BA   78                     MOV   a,b   
28BB   C9                     RET      
28BC                             ; 
28BC                             ; ---------------------------------------------------------------
28BC                             ; gc_propagate — 印が増えなくなるまで中身を辿る
28BC                             ; 
28BC                             ; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
28BC                             ; 1 周で 1 つも走査しなければ終わり。
28BC                             ; ---------------------------------------------------------------
28BC                GC_PROPAGATE:      
28BC   AF                     XRA   a   
28BD   32 CE 29               STA   gc_changed   
28C0   06 00                  MVI   b,0   ; B = スロット番号
28C2                GC_PROP_SLOT:      
28C2   78                     MOV   a,b   
28C3   CD 99 29               CALL   gc_check_bit   ; 印が無ければ飛ばす
28C6   CA DF 28               JZ   gc_prop_next   
28C9   78                     MOV   a,b   
28CA   CD B2 29               CALL   gc_check_scanned   ; 走査済みなら飛ばす
28CD   C2 DF 28               JNZ   gc_prop_next   
28D0   78                     MOV   a,b   
28D1   CD A5 29               CALL   gc_set_scanned   
28D4   3E 01                  MVI   a,1   
28D6   32 CE 29               STA   gc_changed   
28D9   78                     MOV   a,b   
28DA   C5                     PUSH   b   
28DB   CD EE 28               CALL   gc_scan_slot   
28DE   C1                     POP   b   
28DF                GC_PROP_NEXT:      
28DF   04                     INR   b   
28E0   78                     MOV   a,b   
28E1   FE 40                  CPI   MAX_COL_SLOTS   
28E3   DA C2 28               JC   gc_prop_slot   
28E6   3A CE 29               LDA   gc_changed   
28E9   B7                     ORA   a   
28EA   C2 BC 28               JNZ   gc_propagate   ; 印が増えたのでもう 1 周
28ED   C9                     RET      
28EE                             ; 
28EE                             ; ---------------------------------------------------------------
28EE                             ; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
28EE                             ; 
28EE                             ; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
28EE                             ; 読むと、前に入っていた文字列のバイトが型タグに見える。
28EE                             ; 
28EE                             ; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
28EE                             ; でも隣のスロットまで歩かないようにする。
28EE                             ; ---------------------------------------------------------------
28EE                GC_SCAN_SLOT:      
28EE   C5                     PUSH   b   
28EF   CD A9 21               CALL   col_slot_addr   ; HL = スロットアドレス (A は残る)
28F2   7E                     MOV   a,m   ; +0: 型
28F3   23                     INX   h   
28F4   46                     MOV   b,m   ; +1: 要素数 / 組の数
28F5   23                     INX   h   ; HL = データ先頭
28F6   FE 02                  CPI   COL_TYPE_ARRAY   
28F8   CA 03 29               JZ   gc_scan_array   
28FB   FE 03                  CPI   COL_TYPE_HASH   
28FD   CA 20 29               JZ   gc_scan_hash   
2900   C3 41 29               JMP   gc_scan_done   ; 文字列と空きは辿らない
2903                GC_SCAN_ARRAY:      
2903   78                     MOV   a,b   
2904   B7                     ORA   a   
2905   CA 41 29               JZ   gc_scan_done   ; 要素数 0
2908                             ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
2908                             ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
2908   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
290A   DA 12 29               JC   gc_scan_aloop   ; 容量未満
290D   CA 12 29               JZ   gc_scan_aloop   ; ちょうど容量
2910   06 08                  MVI   b,COL_MAX_ARRAY_ELEMS   
2912                GC_SCAN_ALOOP:      
2912   CD 43 29               CALL   gc_mark_value   
2915   23                     INX   h   
2916   23                     INX   h   
2917   23                     INX   h   
2918   23                     INX   h   
2919   05                     DCR   b   
291A   C2 12 29               JNZ   gc_scan_aloop   
291D   C3 41 29               JMP   gc_scan_done   
2920                GC_SCAN_HASH:      
2920   78                     MOV   a,b   
2921   B7                     ORA   a   
2922   CA 41 29               JZ   gc_scan_done   ; 組の数 0
2925   FE 04                  CPI   COL_MAX_HASH_PAIRS   
2927   DA 2F 29               JC   gc_scan_hloop   
292A   CA 2F 29               JZ   gc_scan_hloop   
292D   06 04                  MVI   b,COL_MAX_HASH_PAIRS   
292F                GC_SCAN_HLOOP:      
292F   CD 43 29               CALL   gc_mark_value   ; 鍵
2932   23                     INX   h   
2933   23                     INX   h   
2934   23                     INX   h   
2935   23                     INX   h   
2936   CD 43 29               CALL   gc_mark_value   ; 値
2939   23                     INX   h   
293A   23                     INX   h   
293B   23                     INX   h   
293C   23                     INX   h   
293D   05                     DCR   b   
293E   C2 2F 29               JNZ   gc_scan_hloop   
2941                GC_SCAN_DONE:      
2941   C1                     POP   b   
2942   C9                     RET      
2943                             ; 
2943                             ; ---------------------------------------------------------------
2943                             ; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
2943                             ; 
2943                             ; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
2943                             ; なのでここでは何もしない (中身はルート走査で辿る)。
2943                             ; 
2943                             ; **値は スロット + 1。** 0 は「無し」。
2943                             ; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
2943                             ; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
2943                             ; 
2943                             ;   HL / DE / BC は保たれる
2943                             ; ---------------------------------------------------------------
2943                GC_MARK_VALUE:      
2943   E5                     PUSH   h   
2944   D5                     PUSH   d   
2945   C5                     PUSH   b   
2946   7E                     MOV   a,m   ; A = 型タグ
2947   FE 07                  CPI   TT_STRING   
2949   CA 59 29               JZ   gc_mv_ref   
294C   FE 08                  CPI   TT_ARRAY   
294E   CA 59 29               JZ   gc_mv_ref   
2951   FE 09                  CPI   TT_HASH   
2953   CA 59 29               JZ   gc_mv_ref   
2956   C3 70 29               JMP   gc_mv_done   
2959                GC_MV_REF:      
2959   23                     INX   h   
295A   23                     INX   h   
295B   23                     INX   h   
295C   7E                     MOV   a,m   ; +3: val_hi
295D   B7                     ORA   a   
295E   C2 70 29               JNZ   gc_mv_done   ; 上位が 0 でなければスロット番号ではない
2961   2B                     DCX   h   
2962   7E                     MOV   a,m   ; +2: val_lo = スロット + 1
2963   B7                     ORA   a   
2964   CA 70 29               JZ   gc_mv_done   ; 0 = 無し
2967   3D                     DCR   a   ; A = スロット番号
2968   FE 40                  CPI   MAX_COL_SLOTS   
296A   D2 70 29               JNC   gc_mv_done   ; 範囲外
296D   CD 8C 29               CALL   gc_set_bit   
2970                GC_MV_DONE:      
2970   C1                     POP   b   
2971   D1                     POP   d   
2972   E1                     POP   h   
2973   C9                     RET      
2974                             ; 
2974                             ; ---------------------------------------------------------------
2974                             ; ビットの出し入れ
2974                             ; 
2974                             ; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
2974                             ; 直して食い違うのを避けるため。
2974                             ; 
2974                             ; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
2974                             ;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
2974                             ; ---------------------------------------------------------------
2974                GC_BIT_PTR:      
2974   4F                     MOV   c,a   ; C = スロット番号
2975   0F                     RRC      
2976   0F                     RRC      
2977   0F                     RRC      
2978   E6 07                  ANI   07h   ; A = バイト位置 (slot >> 3)
297A   6F                     MOV   l,a   
297B   26 00                  MVI   h,0   
297D   19                     DAD   d   ; HL = 先頭 + バイト位置
297E   E5                     PUSH   h   
297F   79                     MOV   a,c   
2980   E6 07                  ANI   07h   ; ビット位置 (slot & 7)
2982   6F                     MOV   l,a   
2983   26 00                  MVI   h,0   
2985   11 D1 29               LXI   d,gc_bit_table   
2988   19                     DAD   d   
2989   7E                     MOV   a,m   ; A = ビットマスク
298A   E1                     POP   h   ; HL = ビットマップのバイト
298B   C9                     RET      
298C                             ; 
298C                             ; --- gc_set_bit: A = slot (0-63) の印を立てる ---
298C                GC_SET_BIT:      
298C   E5                     PUSH   h   
298D   D5                     PUSH   d   
298E   11 BE 29               LXI   d,gc_bitmap   
2991   CD 74 29               CALL   gc_bit_ptr   
2994   B6                     ORA   m   
2995   77                     MOV   m,a   
2996   D1                     POP   d   
2997   E1                     POP   h   
2998   C9                     RET      
2999                             ; 
2999                             ; --- gc_check_bit: A = slot の印を検査 ---
2999                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
2999                GC_CHECK_BIT:      
2999   E5                     PUSH   h   
299A   D5                     PUSH   d   
299B   11 BE 29               LXI   d,gc_bitmap   
299E   CD 74 29               CALL   gc_bit_ptr   
29A1   A6                     ANA   m   ; Z=1 ならビットクリア
29A2   D1                     POP   d   ; POP はフラグを変えない
29A3   E1                     POP   h   
29A4   C9                     RET      
29A5                             ; 
29A5                             ; --- gc_set_scanned: A = slot を走査済みにする ---
29A5                GC_SET_SCANNED:      
29A5   E5                     PUSH   h   
29A6   D5                     PUSH   d   
29A7   11 C6 29               LXI   d,gc_scanned   
29AA   CD 74 29               CALL   gc_bit_ptr   
29AD   B6                     ORA   m   
29AE   77                     MOV   m,a   
29AF   D1                     POP   d   
29B0   E1                     POP   h   
29B1   C9                     RET      
29B2                             ; 
29B2                             ; --- gc_check_scanned: A = slot が走査済みか ---
29B2                             ; 戻り: Z=1 → まだ、Z=0 → 済み
29B2                GC_CHECK_SCANNED:      
29B2   E5                     PUSH   h   
29B3   D5                     PUSH   d   
29B4   11 C6 29               LXI   d,gc_scanned   
29B7   CD 74 29               CALL   gc_bit_ptr   
29BA   A6                     ANA   m   
29BB   D1                     POP   d   
29BC   E1                     POP   h   
29BD   C9                     RET      
29BE                             ; 
29BE                             ; --- GC データ ---
29BE                             ; 
29BE                             ; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
29BE                             ; 回している
29BE   00 00 00 00 00 00 00 00 GC_BITMAP:   DB   0,0,0,0,0,0,0,0   
29C6   00 00 00 00 00 00 00 00 GC_SCANNED:   DB   0,0,0,0,0,0,0,0   
29CE   00           GC_CHANGED:   DB   0   
29CF                             ; 
29CF                             ; **印を空き表として使い回せるか。** 0 = 走査が要る
29CF   00           GC_HAVE_FREE:   DB   0   
29D0                             ; 
29D0                             ; **空きを探し始める位置。** これより前はすべて印が付いている
29D0   00           GC_FREE_NEXT:   DB   0   
29D1   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
29D9                             ; 
29D9                             ; ===============================================================
29D9                             ; sendb_each — Array#each / Hash#each
29D9                             ; 
29D9                             ;   R[a] = TT_ARRAY か TT_HASH (レシーバ)
29D9                             ;   R[a+argc+1] = TT_PROC (ブロック)
29D9                             ;   配列: 各反復で R[1] = array[index]
29D9                             ;   ハッシュ: 各反復で R[1] = 鍵, R[2] = 値
29D9                             ; 
29D9                             ; FRAME_KIND_EACH / FRAME_KIND_HASH_EACH を使い、フレーム +11
29D9                             ; (reserved) にコレクションスロット番号を格納する。
29D9                             ; 
29D9                             ; **見出しの +1 (count) はどちらも「反復の回数」です。** 配列なら要素数、
29D9                             ; ハッシュならペア数なので、上限の出し方を分ける必要がありません。
29D9                             ; 違うのはブロックへ渡す値だけで、そこは each_block_args に出しています。
29D9                             ; ===============================================================
29D9                SENDB_EACH:      
29D9                             ; each はレシーバの型でフレーム種別を決める
29D9                             ; (述語は sendb_pred が種別を書いてから合流する)
29D9   3A CD 19               LDA   sendb_reg_a   
29DC   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
29DF   7E                     MOV   a,m   
29E0   FE 08                  CPI   TT_ARRAY   
29E2   CA EF 29               JZ   each_kind_array   
29E5   FE 09                  CPI   TT_HASH   
29E7   C2 58 1D               JNZ   vm_fail   
29EA   3E 03                  MVI   a,FRAME_KIND_HASH_EACH   
29EC   C3 F1 29               JMP   each_kind_set   
29EF                EACH_KIND_ARRAY:      
29EF   3E 02                  MVI   a,FRAME_KIND_EACH   
29F1                EACH_KIND_SET:      
29F1   32 54 2C               STA   each_arg_kind   
29F4                             ; 
29F4                SENDB_EACH_JOIN:      
29F4                             ; レシーバが配列かハッシュであること (述語もここを通る)
29F4   3A CD 19               LDA   sendb_reg_a   
29F7   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
29FA   7E                     MOV   a,m   
29FB   FE 08                  CPI   TT_ARRAY   
29FD   CA 05 2A               JZ   each_recv_ok   
2A00   FE 09                  CPI   TT_HASH   
2A02   C2 58 1D               JNZ   vm_fail   
2A05                EACH_RECV_OK:      
2A05                             ; 
2A05                             ; コレクションスロット番号を取得 (配列・ハッシュとも val_lo = slot + 1)
2A05   3A CD 19               LDA   sendb_reg_a   
2A08   CD 00 10               CALL   get_reg_addr   
2A0B   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
2A0E   7E                     MOV   a,m   ; val_lo = slot + 1
2A0F   3D                     DCR   a   ; slot number (0-based)
2A10   32 52 2C               STA   each_col_slot   
2A13                             ; 
2A13                             ; 反復の回数を読む (配列なら要素数、ハッシュならペア数)
2A13   3A 52 2C               LDA   each_col_slot   
2A16   CD A9 21               CALL   col_slot_addr   ; HL = スロットアドレス
2A19   23                     INX   h   ; +1: count
2A1A   7E                     MOV   a,m   
2A1B   32 53 2C               STA   each_count   
2A1E   B7                     ORA   a   
2A1F   CA 8D 2A               JZ   each_empty   ; 空 → ブロック実行しない
2A22                             ; 
2A22                             ; ブロック (TT_PROC) の情報を読む
2A22                             ; 
2A22                             ; **ブロック無しの述語は R[a+1] を見ない。** 恒等ブロックは最後の
2A22                             ; irep で、中身は `OP_RETURN R[1]` の 2 バイトだけ。ホストが
2A22                             ; ブロック無しの述語を見つけたときだけ足す
2A22   3A B4 2A               LDA   pred_identity   
2A25   B7                     ORA   a   
2A26   C2 44 2A               JNZ   each_block_identity   
2A29   3A CF 19               LDA   sendb_argc   
2A2C   3C                     INR   a   ; argc + 1
2A2D   47                     MOV   b,a   
2A2E   3A CD 19               LDA   sendb_reg_a   
2A31   80                     ADD   b   ; A = a + argc + 1
2A32   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1]
2A35   CD 32 10               CALL   slot_to_value   
2A38   7E                     MOV   a,m   ; irep 番号
2A39   32 D1 19               STA   sendb_block_irep   
2A3C   23                     INX   h   
2A3D   7E                     MOV   a,m   ; outer
2A3E   32 D2 19               STA   sendb_block_outer   
2A41   C3 4F 2A               JMP   each_block_ready   
2A44                EACH_BLOCK_IDENTITY:      
2A44   3A FF 82               LDA   IDENTITY_IREP_STORE   
2A47   32 D1 19               STA   sendb_block_irep   
2A4A   3E FF                  MVI   a,FRAME_NONE   
2A4C   32 D2 19               STA   sendb_block_outer   
2A4F                EACH_BLOCK_READY:      
2A4F                             ; 
2A4F                             ; push_frame(a, kind, outer)
2A4F   3A 54 2C               LDA   each_arg_kind   
2A52   47                     MOV   b,a   
2A53   3A D2 19               LDA   sendb_block_outer   
2A56   4F                     MOV   c,a   
2A57   3A CD 19               LDA   sendb_reg_a   
2A5A   CD 9C 17               CALL   push_frame   
2A5D                             ; 
2A5D                             ; フレームに limit = count - 1 を設定
2A5D   CD 95 17               CALL   cur_frame_addr   
2A60   11 08 00               LXI   d,FRAME_OFF_LIMIT   
2A63   19                     DAD   d   
2A64   3A 53 2C               LDA   each_count   
2A67   3D                     DCR   a   ; limit = count - 1
2A68   77                     MOV   m,a   ; limit_lo
2A69   23                     INX   h   
2A6A   36 00                  MVI   m,0   ; limit_hi
2A6C                             ; 
2A6C                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
2A6C   CD 95 17               CALL   cur_frame_addr   
2A6F   11 0B 00               LXI   d,11   
2A72   19                     DAD   d   
2A73   3A 52 2C               LDA   each_col_slot   
2A76   77                     MOV   m,a   
2A77                             ; 
2A77                             ; 最初の回のブロック引数 (index = 0)
2A77   AF                     XRA   a   
2A78   32 55 2C               STA   each_index   
2A7B   CD FE 2B               CALL   each_block_args   
2A7E                             ; 
2A7E                             ; 子 irep に切り替え
2A7E   3A D1 19               LDA   sendb_block_irep   
2A81   CD 21 18               CALL   switch_irep   
2A84                             ; 
2A84                             ; PC = 0
2A84   21 00 00               LXI   h,0   
2A87   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
2A8A   C3 78 1D               JMP   vm_loop   
2A8D                             ; 
2A8D                             ; ===============================================================
2A8D                             ; each_empty — 1 回も回らないとき
2A8D                             ; 
2A8D                             ; each はレシーバがそのまま呼び出しの値になるので何もしません。
2A8D                             ; **述語だけは答えを書きます** (空の any? は false、all? と none? は true)。
2A8D                             ; フレームを積まないので、ここで決まります。
2A8D                             ; ===============================================================
2A8D                EACH_EMPTY:      
2A8D   3A 54 2C               LDA   each_arg_kind   
2A90   FE 06                  CPI   FRAME_KIND_ANY   
2A92   DA 78 1D               JC   vm_loop   ; 述語ではない → レシーバのまま
2A95   FE 06                  CPI   FRAME_KIND_ANY   
2A97   CA 9F 2A               JZ   each_empty_false   ; any? → false
2A9A   3E 03                  MVI   a,TT_TRUE   ; all? / none? → true
2A9C   C3 A1 2A               JMP   each_empty_write   
2A9F                EACH_EMPTY_FALSE:      
2A9F   3E 02                  MVI   a,TT_FALSE   
2AA1                EACH_EMPTY_WRITE:      
2AA1   32 B3 2A               STA   each_empty_tag   
2AA4   3A CD 19               LDA   sendb_reg_a   
2AA7   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (呼び出しの値になる場所)
2AAA   3A B3 2A               LDA   each_empty_tag   
2AAD   CD 1A 10               CALL   set_slot_special   
2AB0   C3 78 1D               JMP   vm_loop   
2AB3                             ; 
2AB3   00           EACH_EMPTY_TAG:   DB   0   
2AB4                             ; 
2AB4                             ; **ブロックが恒等か。** 0 = R[a+argc+1] のブロックを使う
2AB4   00           PRED_IDENTITY:   DB   0   
2AB5                             ; 
2AB5                             ; ===============================================================
2AB5                             ; send_pred — ブロック無しの述語 (a.any? / a.all? / a.none?)
2AB5                             ; 
2AB5                             ; **`a.all?` は `a.all? 00bbIHx4fCB4IA==` と同じです。** 中身をそのまま返す
2AB5                             ; ブロックを渡したものとして each の道に入れるので、反復もフレームも
2AB5                             ; 判定もブロック付きと同じ経路を通ります。規則を書き直しません。
2AB5                             ; 
2AB5                             ; **ハッシュは反復しません。** Ruby はブロック無しのとき [鍵, 値] の
2AB5                             ; 配列を見るので、中身がどうであれ常に真です。鍵をそのまま渡すと
2AB5                             ; `00bbbmlsID0+IDE=.all?` が偽になってしまいます。組の数だけで決まります。
2AB5                             ; ===============================================================
2AB5                SEND_PRED_ANY:      
2AB5   3E 06                  MVI   a,FRAME_KIND_ANY   
2AB7   C3 C1 2A               JMP   send_pred   
2ABA                SEND_PRED_ALL:      
2ABA   3E 07                  MVI   a,FRAME_KIND_ALL   
2ABC   C3 C1 2A               JMP   send_pred   
2ABF                SEND_PRED_NONE:      
2ABF   3E 08                  MVI   a,FRAME_KIND_NONE   
2AC1                SEND_PRED:      
2AC1   32 54 2C               STA   each_arg_kind   
2AC4                             ; ブロック付きと同じ変数へ移して合流する
2AC4   3A 4D 17               LDA   send_reg_a   
2AC7   32 CD 19               STA   sendb_reg_a   
2ACA   AF                     XRA   a   
2ACB   32 CF 19               STA   sendb_argc   ; 述語は引数を取らない
2ACE                             ; レシーバがハッシュなら反復しない
2ACE   3A 4D 17               LDA   send_reg_a   
2AD1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2AD4   7E                     MOV   a,m   
2AD5   FE 09                  CPI   TT_HASH   
2AD7   CA E2 2A               JZ   send_pred_hash   
2ADA   3E 01                  MVI   a,1   
2ADC   32 B4 2A               STA   pred_identity   
2ADF   C3 F4 29               JMP   sendb_each_join   
2AE2                             ; 
2AE2                             ; --- ハッシュ。組の数だけで決まる ---
2AE2                SEND_PRED_HASH:      
2AE2   3A 4D 17               LDA   send_reg_a   
2AE5   CD 00 10               CALL   get_reg_addr   
2AE8   CD CE 21               CALL   col_from_reg   ; HL = 鍵の配列のスロット
2AEB   23                     INX   h   ; +1: 組の数
2AEC   7E                     MOV   a,m   
2AED   B7                     ORA   a   ; Z=1 なら空
2AEE   06 03                  MVI   b,TT_TRUE   
2AF0   CA 00 2B               JZ   send_pred_hash_empty   
2AF3                             ; 空でない: any? と all? は true、none? は false
2AF3   3A 54 2C               LDA   each_arg_kind   
2AF6   FE 08                  CPI   FRAME_KIND_NONE   
2AF8   C2 0A 2B               JNZ   send_pred_hash_write   
2AFB   06 02                  MVI   b,TT_FALSE   
2AFD   C3 0A 2B               JMP   send_pred_hash_write   
2B00                SEND_PRED_HASH_EMPTY:      
2B00                             ; 空: any? は false、all? と none? は true
2B00   3A 54 2C               LDA   each_arg_kind   
2B03   FE 06                  CPI   FRAME_KIND_ANY   
2B05   C2 0A 2B               JNZ   send_pred_hash_write   
2B08   06 02                  MVI   b,TT_FALSE   
2B0A                SEND_PRED_HASH_WRITE:      
2B0A   3A 4D 17               LDA   send_reg_a   
2B0D   CD 00 10               CALL   get_reg_addr   
2B10   78                     MOV   a,b   
2B11   CD 1A 10               CALL   set_slot_special   
2B14   C3 78 1D               JMP   vm_loop   
2B17                             ; 
2B17                             ; ===============================================================
2B17                             ; sendb_array_new — Array.new(n) 00bbIHxpfCA=
2B17                             ; 
2B17                             ; **先に配列を確保して R[a] に置く。** 窓をずらすと R[0] が配列になり、
2B17                             ; 反復の間ずっとそこから書き込む先を引ける。尽きればそれが呼び出しの値。
2B17                             ; 
2B17                             ; 渡すのは添字 (times と同じ)。ブロックの値は advance_iteration が
2B17                             ; その回の要素へ書く。**先に nil で埋めておく** — break で途中で抜けても、
2B17                             ; 書いていない要素を値スロットとして読まれないようにするため。
2B17                             ; ===============================================================
2B17                SENDB_ARRAY_NEW:      
2B17                             ; レシーバが Array であること
2B17   3A CD 19               LDA   sendb_reg_a   
2B1A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2B1D   7E                     MOV   a,m   
2B1E   FE 0E                  CPI   TT_BUILTIN_CLASS   
2B20   C2 58 1D               JNZ   vm_fail   
2B23   3A CD 19               LDA   sendb_reg_a   
2B26   CD 00 10               CALL   get_reg_addr   
2B29   CD 32 10               CALL   slot_to_value   
2B2C   7E                     MOV   a,m   
2B2D   FE 01                  CPI   BUILTIN_CLASS_ARRAY   
2B2F   C2 58 1D               JNZ   vm_fail   
2B32                             ; 
2B32                             ; 大きさは R[a+1]
2B32   3A CD 19               LDA   sendb_reg_a   
2B35   3C                     INR   a   
2B36   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2B39   7E                     MOV   a,m   
2B3A   FE 04                  CPI   TT_INTEGER   
2B3C   C2 58 1D               JNZ   vm_fail   
2B3F   23                     INX   h   
2B40   23                     INX   h   ; +2: val_lo
2B41   4E                     MOV   c,m   
2B42   23                     INX   h   
2B43   7E                     MOV   a,m   ; 上位バイト
2B44   B7                     ORA   a   
2B45   C2 58 1D               JNZ   vm_fail   ; 負か大きすぎる
2B48   79                     MOV   a,c   
2B49   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2B4B   D2 58 1D               JNC   vm_fail   
2B4E   32 F9 2B               STA   san_count   
2B51                             ; 
2B51                             ; スロットを確保して nil で埋める
2B51   CD B9 21               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2B54   32 FA 2B               STA   san_slot   
2B57   36 02                  MVI   m,COL_TYPE_ARRAY   
2B59   23                     INX   h   
2B5A   3A F9 2B               LDA   san_count   
2B5D   77                     MOV   m,a   ; +1: count
2B5E   23                     INX   h   ; HL → データ領域
2B5F   22 FC 2B               SHLD   san_data   
2B62   3A F9 2B               LDA   san_count   
2B65   B7                     ORA   a   
2B66   CA 85 2B               JZ   san_no_fill   
2B69   32 FB 2B               STA   san_left   
2B6C                SAN_FILL_LOOP:      
2B6C   2A FC 2B               LHLD   san_data   
2B6F   36 01                  MVI   m,TT_NIL   
2B71   23                     INX   h   
2B72   36 00                  MVI   m,0   
2B74   23                     INX   h   
2B75   36 00                  MVI   m,0   
2B77   23                     INX   h   
2B78   36 00                  MVI   m,0   
2B7A   23                     INX   h   
2B7B   22 FC 2B               SHLD   san_data   
2B7E   21 FB 2B               LXI   h,san_left   
2B81   35                     DCR   m   
2B82   C2 6C 2B               JNZ   san_fill_loop   
2B85                             ; 
2B85                SAN_NO_FILL:      
2B85                             ; R[a] = TT_ARRAY, val_lo = slot+1。**これが呼び出しの値になる**
2B85   3A CD 19               LDA   sendb_reg_a   
2B88   CD 00 10               CALL   get_reg_addr   
2B8B   36 08                  MVI   m,TT_ARRAY   
2B8D   23                     INX   h   
2B8E   36 00                  MVI   m,0   
2B90   23                     INX   h   
2B91   3A FA 2B               LDA   san_slot   
2B94   3C                     INR   a   
2B95   77                     MOV   m,a   
2B96   23                     INX   h   
2B97   36 00                  MVI   m,0   
2B99                             ; 
2B99                             ; 0 個ならブロックを 1 回も回さない (配列はもう R[a] にある)
2B99   3A F9 2B               LDA   san_count   
2B9C   B7                     ORA   a   
2B9D   CA 78 1D               JZ   vm_loop   
2BA0                             ; 
2BA0                             ; ブロック (TT_PROC) の情報を読む
2BA0   3A CF 19               LDA   sendb_argc   
2BA3   3C                     INR   a   
2BA4   47                     MOV   b,a   
2BA5   3A CD 19               LDA   sendb_reg_a   
2BA8   80                     ADD   b   ; A = a + argc + 1
2BA9   CD 00 10               CALL   get_reg_addr   
2BAC   CD 32 10               CALL   slot_to_value   
2BAF   7E                     MOV   a,m   
2BB0   32 D1 19               STA   sendb_block_irep   
2BB3   23                     INX   h   
2BB4   7E                     MOV   a,m   
2BB5   32 D2 19               STA   sendb_block_outer   
2BB8                             ; 
2BB8                             ; push_frame(a, FRAME_KIND_ARRAY_FILL, outer)
2BB8   06 09                  MVI   b,FRAME_KIND_ARRAY_FILL   
2BBA   3A D2 19               LDA   sendb_block_outer   
2BBD   4F                     MOV   c,a   
2BBE   3A CD 19               LDA   sendb_reg_a   
2BC1   CD 9C 17               CALL   push_frame   
2BC4                             ; 
2BC4                             ; limit = count - 1
2BC4   CD 95 17               CALL   cur_frame_addr   
2BC7   11 08 00               LXI   d,FRAME_OFF_LIMIT   
2BCA   19                     DAD   d   
2BCB   3A F9 2B               LDA   san_count   
2BCE   3D                     DCR   a   
2BCF   77                     MOV   m,a   
2BD0   23                     INX   h   
2BD1   36 00                  MVI   m,0   
2BD3                             ; 
2BD3                             ; フレーム +11 にコレクションスロット番号 (書き込む先を引くのに使う)
2BD3   CD 95 17               CALL   cur_frame_addr   
2BD6   11 0B 00               LXI   d,11   
2BD9   19                     DAD   d   
2BDA   3A FA 2B               LDA   san_slot   
2BDD   77                     MOV   m,a   
2BDE                             ; 
2BDE                             ; ブロック引数 R[1] = 0 (添字)
2BDE   3E 01                  MVI   a,1   
2BE0   CD 00 10               CALL   get_reg_addr   
2BE3   06 00                  MVI   b,0   
2BE5   0E 00                  MVI   c,0   
2BE7   CD 10 10               CALL   set_slot_int16   
2BEA                             ; 
2BEA                             ; 子 irep に切り替えて PC = 0
2BEA   3A D1 19               LDA   sendb_block_irep   
2BED   CD 21 18               CALL   switch_irep   
2BF0   21 00 00               LXI   h,0   
2BF3   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
2BF6   C3 78 1D               JMP   vm_loop   
2BF9                             ; 
2BF9   00           SAN_COUNT:   DB   0   
2BFA   00           SAN_SLOT:   DB   0   
2BFB   00           SAN_LEFT:   DB   0   
2BFC   00 00        SAN_DATA:   DW   0   
2BFE                             ; 
2BFE                             ; ===============================================================
2BFE                             ; each_block_args — 反復のその回の値をブロックの引数へ
2BFE                             ; 
2BFE                             ;   入力: each_arg_kind / each_col_slot / each_index
2BFE                             ;   出力: R[1] (配列なら要素、ハッシュなら鍵)
2BFE                             ;         ハッシュなら R[2] にも値
2BFE                             ; 
2BFE                             ; **sendb_each と advance_iteration の両方から呼びます。** 最初の回と
2BFE                             ; 2 回目以降で同じ場所の出し方をするためで、以前は 1 回目を sendb_each に
2BFE                             ; 書き写していました。
2BFE                             ; 
2BFE                             ; **添字は下位バイトだけ見ます。** 配列は 8 要素、ハッシュは 4 ペアまでで、
2BFE                             ; 上限がバイトに収まります。
2BFE                             ; ===============================================================
2BFE                EACH_BLOCK_ARGS:      
2BFE   3A 52 2C               LDA   each_col_slot   
2C01   CD A9 21               CALL   col_slot_addr   ; HL = スロットアドレス
2C04   7E                     MOV   a,m   ; +0: 見出しの種別 (COL_TYPE_*)
2C05   32 58 2C               STA   eba_col_type   
2C08   23                     INX   h   ; skip type
2C09   23                     INX   h   ; skip count → data
2C0A                             ; **渡す値はスロットの見出しで決めます。** フレームの種別ではありません —
2C0A                             ; 述語は配列とハッシュで種別を分けていないためです
2C0A   3A 58 2C               LDA   eba_col_type   
2C0D   FE 03                  CPI   COL_TYPE_HASH   
2C0F   CA 27 2C               JZ   eba_hash   
2C12                             ; 
2C12                             ; --- 配列: data + index * 4 ---
2C12   3A 55 2C               LDA   each_index   
2C15   87                     ADD   a   ; ×2
2C16   87                     ADD   a   ; ×4
2C17   5F                     MOV   e,a   
2C18   16 00                  MVI   d,0   
2C1A   19                     DAD   d   ; HL = &data[index*4]
2C1B   E5                     PUSH   h   
2C1C   3E 01                  MVI   a,1   
2C1E   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2C21   EB                     XCHG      ; DE = R[1] (コピー先)
2C22   E1                     POP   h   ; HL = コピー元
2C23   CD 25 10               CALL   copy_slot   ; R[1] = array[index]
2C26   C9                     RET      
2C27                             ; 
2C27                             ; --- ハッシュ: data + index * 8 が鍵、その +4 が値 ---
2C27                EBA_HASH:      
2C27   3A 55 2C               LDA   each_index   
2C2A   87                     ADD   a   ; ×2
2C2B   87                     ADD   a   ; ×4
2C2C   87                     ADD   a   ; ×8
2C2D   5F                     MOV   e,a   
2C2E   16 00                  MVI   d,0   
2C30   19                     DAD   d   ; HL = &pair
2C31   22 56 2C               SHLD   eba_pair   ; copy_slot が HL を進めるので退避
2C34   E5                     PUSH   h   
2C35   3E 01                  MVI   a,1   
2C37   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2C3A   EB                     XCHG      ; DE = R[1]
2C3B   E1                     POP   h   ; HL = &鍵
2C3C   CD 25 10               CALL   copy_slot   ; R[1] = 鍵
2C3F   2A 56 2C               LHLD   eba_pair   
2C42   11 04 00               LXI   d,4   
2C45   19                     DAD   d   ; HL = &値
2C46   E5                     PUSH   h   
2C47   3E 02                  MVI   a,2   
2C49   CD 00 10               CALL   get_reg_addr   ; HL = R[2]
2C4C   EB                     XCHG      ; DE = R[2]
2C4D   E1                     POP   h   ; HL = &値
2C4E   CD 25 10               CALL   copy_slot   ; R[2] = 値
2C51   C9                     RET      
2C52                             ; 
2C52                             ; --- sendb_each データ ---
2C52   00           EACH_COL_SLOT:   DB   0   
2C53   00           EACH_COUNT:   DB   0   
2C54   00           EACH_ARG_KIND:   DB   0   
2C55   00           EACH_INDEX:   DB   0   
2C56   00 00        EBA_PAIR:   DW   0   
2C58   00           EBA_COL_TYPE:   DB   0   
2C59                             ; 
2C59                          END      


