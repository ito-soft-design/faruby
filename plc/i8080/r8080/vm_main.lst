0000                             ; vm_main.a80 — faRuby i8080 VM
0000                             ; 
0000                             ; mruby バイトコードを実行する VM の本体。
0000                             ; ND8080 ボード (拡張 RAM 搭載: 0x0000-0xFFFF) を想定。
0000                             ; 
0000                             ; 0x8400: 起動スタブ (SP 設定 + バンク切り替え + JMP vm_start)
0000                             ; 0x1000: VM 本体コード (拡張 RAM 領域)
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行する。
0000                             ; hex ロードは拡張 RAM モード (ポート 9C bit3=1) のまま行われるため、
0000                             ; 0x1000-0x7FFF のデータは直接拡張 RAM に書き込まれる。
0000                             ; 
0000                             ; asm80 -m I8080 vm_main.a80
0000                             ; 
0000                             ; vm_constants.a80 — 自動生成 (i8080_constants_gen.rb)
0000                             ; このファイルは手で書き換えないでください
0000                             ; 
0000                             ; --- メモリマップ ---
0000                             ; 
0000                VM_CODE_ORG:   EQU   1000h   
0000                VM_ENTRY_POINT:   EQU   8400h   ; 起動スタブ (通常 RAM)
0000                BYTECODE_BASE:   EQU   5000h   
0000                BYTECODE_SIZE:   EQU   2000h   
0000                POOL_BASE:   EQU   7000h   
0000                IREP_TABLE_BASE:   EQU   8200h   
0000                VM_STATE_BASE:   EQU   8000h   
0000                REG_FILE_BASE:   EQU   8100h   
0000                REG_FILE_BASE_HI:   EQU   81h   ; REG_FILE_BASE の上位バイト
0000                MAX_REGS:   EQU   40h   
0000                STACK_TOP:   EQU   0FDFFh   
0000                DISPLAY_BASE:   EQU   0FFF8h   
0000                DISPLAY_SIZE:   EQU   08h   
0000                INIT_METHOD_ID_STORE:   EQU   82FEh   ; initialize の method_id 格納アドレス
0000                             ; 
0000                             ; --- バリュースロット ---
0000                             ; 
0000                SLOT_BYTES:   EQU   04h   ; 1 スロットのバイト数
0000                SLOT_TYPE_OFFSET:   EQU   00h   ; 型タグのバイトオフセット
0000                SLOT_VALUE_OFFSET:   EQU   02h   ; 値のバイトオフセット
0000                             ; 
0000                             ; --- VM 状態領域のオフセット ---
0000                             ; 
0000                OFF_PC:   EQU   00h   ; 2B
0000                OFF_STATUS:   EQU   02h   ; 2B
0000                OFF_ERROR:   EQU   04h   ; 2B
0000                OFF_STEP_COUNT:   EQU   06h   ; 4B
0000                OFF_CURRENT_OPCODE:   EQU   0Ah   ; 1B
0000                OFF_OPERAND_A:   EQU   0Bh   ; 1B
0000                OFF_OPERAND_B:   EQU   0Ch   ; 1B
0000                OFF_OPERAND_C:   EQU   0Dh   ; 1B
0000                OFF_BYTECODE_LEN:   EQU   0Eh   ; 2B
0000                OFF_NREGS:   EQU   10h   ; 1B
0000                OFF_CUR_IREP:   EQU   11h   ; 1B
0000                OFF_NUM_IREPS:   EQU   12h   ; 1B
0000                OFF_REG_BASE:   EQU   14h   ; 2B  レジスタウィンドウのベースアドレス
0000                OFF_BC_BASE:   EQU   16h   ; 2B  現在の IREP のバイトコード先頭
0000                OFF_FRAME_SP:   EQU   18h   ; 1B  フレームスタックポインタ
0000                OFF_SYM_BASE:   EQU   19h   ; 2B  現在の IREP のシンボルテーブルアドレス
0000                OFF_OBJ_SP:   EQU   1Bh   ; 1B  次の空きオブジェクトスロット
0000                OFF_INIT_METHOD_ID:   EQU   1Ch   ; 1B  initialize のメソッド ID
0000                OFF_POOL_BASE:   EQU   1Dh   ; 2B  現在の IREP の定数プール先頭
0000                OFF_COL_SP:   EQU   1Fh   ; 1B  次の空きコレクションスロット
0000                             ; 
0000                             ; --- IREP テーブルエントリ ---
0000                             ; 
0000                IREP_ENTRY_BYTES:   EQU   0Ah   
0000                IREP_OFF_BYTECODE:   EQU   00h   ; 2B
0000                IREP_OFF_BYTECODE_LEN:   EQU   02h   ; 2B
0000                IREP_OFF_POOL:   EQU   04h   ; 2B
0000                IREP_OFF_NREGS:   EQU   06h   ; 1B
0000                IREP_OFF_SUBTREE_SIZE:   EQU   07h   ; 1B  DFS 前順サブツリーサイズ
0000                IREP_OFF_SYM_TABLE:   EQU   08h   ; 2B  シンボルテーブル先頭アドレス
0000                             ; 
0000                             ; --- 型タグ ---
0000                             ; TT_FALSY_MAX 以下が偽 (nil, false)
0000                             ; 
0000                TT_EMPTY:   EQU   00h   
0000                TT_NIL:   EQU   01h   
0000                TT_FALSE:   EQU   02h   
0000                TT_TRUE:   EQU   03h   
0000                TT_INTEGER:   EQU   04h   
0000                TT_STRING:   EQU   07h   
0000                TT_ARRAY:   EQU   08h   
0000                TT_HASH:   EQU   09h   
0000                TT_OBJECT:   EQU   0Ah   
0000                TT_PROC:   EQU   0Ch   
0000                TT_CLASS:   EQU   0Dh   
0000                TT_FALSY_MAX:   EQU   02h   
0000                             ; 
0000                             ; --- VM 実行状態 ---
0000                             ; 
0000                VM_STOPPED:   EQU   00h   
0000                VM_RUNNING:   EQU   01h   
0000                VM_FINISHED:   EQU   02h   
0000                VM_ERROR:   EQU   03h   
0000                             ; 
0000                             ; --- シンボルテーブル / グローバル変数 ---
0000                             ; 
0000                SYM_TABLE_BASE:   EQU   8300h   
0000                GLOBALS_BASE:   EQU   9000h   
0000                MAX_GLOBALS:   EQU   40h   ; グローバル変数の数
0000                             ; 
0000                             ; シンボル種別コード (上位バイト)
0000                SYM_KIND_USER_METHOD:   EQU   01h   ; ユーザー定義メソッド
0000                SYM_KIND_CLASS:   EQU   02h   ; クラス名
0000                SYM_KIND_IVAR:   EQU   03h   ; インスタンス変数
0000                             ; 
0000                             ; --- フレームスタック ---
0000                             ; 
0000                FRAME_STACK_BASE:   EQU   9100h   
0000                FRAME_BYTES:   EQU   0Ch   ; 12 バイト/フレーム
0000                MAX_FRAMES:   EQU   10h   
0000                             ; 
0000                             ; フレームフィールドのバイトオフセット
0000                FRAME_OFF_RETURN_PC:   EQU   00h   ; 2B
0000                FRAME_OFF_RETURN_IREP:   EQU   02h   ; 1B
0000                FRAME_OFF_RETURN_REG_BASE:   EQU   03h   ; 2B
0000                FRAME_OFF_KIND:   EQU   05h   ; 1B
0000                FRAME_OFF_INDEX:   EQU   06h   ; 2B
0000                FRAME_OFF_LIMIT:   EQU   08h   ; 2B
0000                FRAME_OFF_OUTER:   EQU   0Ah   ; 1B
0000                             ; 
0000                             ; フレーム種別
0000                FRAME_KIND_CALL:   EQU   00h   
0000                FRAME_KIND_ITERATE:   EQU   01h   ; times / upto
0000                FRAME_KIND_EACH:   EQU   02h   ; each (配列要素反復)
0000                FRAME_KIND_HASH_EACH:   EQU   03h   ; each (ハッシュの鍵と値)
0000                FRAME_KIND_LOOP:   EQU   04h   ; loop (無限)
0000                FRAME_KIND_NEW:   EQU   05h   ; Class#new → initialize
0000                FRAME_KIND_ANY:   EQU   06h   ; any?
0000                FRAME_KIND_ALL:   EQU   07h   ; all?
0000                FRAME_KIND_NONE:   EQU   08h   ; none?
0000                             ; 
0000                             ; 外側フレームなし (トップレベル)
0000                FRAME_NONE:   EQU   0FFh   
0000                             ; 
0000                             ; --- メソッド表 ---
0000                             ; 
0000                METHOD_TABLE_BASE:   EQU   91C0h   
0000                MAX_CLASSES:   EQU   08h   
0000                MAX_METHODS_PER_CLASS:   EQU   20h   
0000                METHOD_TABLE_SIZE:   EQU   0100h   
0000                CLASS_MAIN:   EQU   00h   
0000                METHOD_NEW:   EQU   1Ch   ; Class#new
0000                METHOD_DISPLAY:   EQU   1Dh   ; display(value)
0000                METHOD_GETKEY:   EQU   1Eh   ; getkey
0000                METHOD_PUTS:   EQU   1Fh   ; puts(value): ASCII 2 文字表示
0000                METHOD_SETSEG:   EQU   20h   ; setseg(pos, pattern)
0000                METHOD_RAND:   EQU   21h   ; rand(n)
0000                METHOD_SLICE:   EQU   22h   ; [](offset, length) 文字列スライス
0000                METHOD_LENGTH:   EQU   12h   ; length / size
0000                METHOD_CONCAT:   EQU   14h   ; << (文字列追記/配列追加)
0000                METHOD_EACH:   EQU   15h   ; each (配列要素反復)
0000                METHOD_PUSH:   EQU   16h   ; push (配列追加)
0000                METHOD_ANY_P:   EQU   23h   ; any?
0000                METHOD_ALL_P:   EQU   24h   ; all?
0000                METHOD_NONE_P:   EQU   25h   ; none?
0000                KEYIN1_ADDR:   EQU   0616h   ; ND80Z モニタキー入力 (ブロッキング)
0000                KEY_ADDR:   EQU   0647h   ; ND80Z キー 1 回スキャン (ノンブロッキング)
0000                             ; 
0000                             ; バンク切り替え (ND8080 拡張 RAM)
0000                PORT_9C:   EQU   9Ch   ; I/O ポート 9C
0000                PORT_9C_BANK_BIT:   EQU   08h   ; bit3: ROM/RAM 切替
0000                CLONE_BUF:   EQU   0EF00h   ; ROM クローン用バッファ
0000                             ; 
0000                             ; --- オブジェクトプール ---
0000                             ; 
0000                OBJECT_POOL_BASE:   EQU   92C0h   
0000                MAX_OBJECTS:   EQU   20h   
0000                OBJECT_SLOT_SIZE:   EQU   20h   ; 32B/スロット
0000                OBJECT_HEADER_SIZE:   EQU   04h   
0000                MAX_IVARS:   EQU   07h   
0000                             ; 
0000                             ; --- コレクションプール (文字列・配列) ---
0000                             ; 
0000                COLLECTION_POOL_BASE:   EQU   96C0h   
0000                MAX_COL_SLOTS:   EQU   40h   
0000                COL_SLOT_SIZE:   EQU   24h   ; 36B/スロット
0000                COL_HEADER_SIZE:   EQU   02h   ; +0: type, +1: count
0000                COL_DATA_SIZE:   EQU   22h   ; データ領域 (34B)
0000                COL_MAX_STRING_LEN:   EQU   22h   
0000                COL_MAX_ARRAY_ELEMS:   EQU   08h   
0000                COL_TYPE_FREE:   EQU   00h   
0000                COL_TYPE_STRING:   EQU   01h   
0000                COL_TYPE_ARRAY:   EQU   02h   
0000                COL_TYPE_HASH:   EQU   03h   
0000                HASH_PAIR_BYTES:   EQU   08h   ; 8B/ペア (key+value)
0000                COL_MAX_HASH_PAIRS:   EQU   04h   ; 最大4ペア
0000                             ; 
0000                             ; --- Phase 1 オペコード ---
0000                             ; 
0000                OP_NOP:   EQU   00h   
0000                OP_MOVE:   EQU   01h   
0000                OP_LOADI:   EQU   03h   
0000                OP_LOADINEG:   EQU   04h   
0000                OP_LOADI__1:   EQU   05h   
0000                OP_LOADI_0:   EQU   06h   
0000                OP_LOADI_1:   EQU   07h   
0000                OP_LOADI_2:   EQU   08h   
0000                OP_LOADI_3:   EQU   09h   
0000                OP_LOADI_4:   EQU   0Ah   
0000                OP_LOADI_5:   EQU   0Bh   
0000                OP_LOADI_6:   EQU   0Ch   
0000                OP_LOADI_7:   EQU   0Dh   
0000                OP_LOADI16:   EQU   0Eh   
0000                OP_LOADNIL:   EQU   11h   
0000                OP_LOADT:   EQU   13h   
0000                OP_LOADF:   EQU   14h   
0000                OP_ADD:   EQU   3Ch   
0000                OP_SUB:   EQU   3Eh   
0000                OP_EQ:    EQU   42h   
0000                OP_LT:    EQU   43h   
0000                OP_LE:    EQU   44h   
0000                OP_GT:    EQU   45h   
0000                OP_GE:    EQU   46h   
0000                OP_JMP:   EQU   25h   
0000                OP_JMPIF:   EQU   26h   
0000                OP_JMPNOT:   EQU   27h   
0000                OP_STOP:   EQU   69h   
0000                             ; 
0000                             ; --- 命令形式ごとのオペランドバイト数 ---
0000                             ; 命令長 = 1 (オペコード) + オペランドバイト数
0000                             ; 
0000                FMT_Z:    EQU   00h   ; Z 形式のオペランドバイト数
0000                FMT_B:    EQU   01h   ; B 形式のオペランドバイト数
0000                FMT_BB:   EQU   02h   ; BB 形式のオペランドバイト数
0000                FMT_BBB:   EQU   03h   ; BBB 形式のオペランドバイト数
0000                FMT_S:    EQU   02h   ; S 形式のオペランドバイト数
0000                FMT_BS:   EQU   03h   ; BS 形式のオペランドバイト数
0000                FMT_BSS:   EQU   05h   ; BSS 形式のオペランドバイト数
0000                FMT_W:    EQU   03h   ; W 形式のオペランドバイト数
0000                             ; 
0000                             ; 
0000                             ; ===============================================================
0000                             ; 起動スタブ (通常 RAM 0x8400)
0000                             ; 
0000                             ; 1. SP 設定
0000                             ; 2. 拡張 RAM バンク切り替え (OUT PORT_9C, F8h)
0000                             ; 3. vm_start へジャンプ
0000                             ; 
0000                             ; bank_init が事前に ROM → 拡張 RAM クローンを実行済み。
0000                             ; hex ロードは拡張 RAM モードのまま行われるため、
0000                             ; VM コード・バイトコード・プールは直接拡張 RAM に書き込まれる。
0000                             ; ===============================================================
8400                          .ORG   08400h   
8400                             ; 
8400                STARTUP_STUB:      
8400   31 00 FE               LXI   sp,STACK_TOP + 1   
8403   3E F8                  MVI   a,0F8h   
8405   D3 9C                  OUT   PORT_9C   
8407   C3 4E 1D               JMP   vm_start   
840A                             ; 
840A                             ; ===============================================================
840A                             ; VM 本体コード (拡張 RAM 0x1000-)
840A                             ; ===============================================================
1000                          .ORG   01000h   
1000                             ; 
1000                             ; ===============================================================
1000                             ; サブルーチン群 (.include で取り込む)
1000                             ; ===============================================================
1000                             ; vm_util.a80 — ユーティリティサブルーチン
1000                             ; 
1000                             ; レジスタスロットのアドレス計算、値の読み書き、スロットの複写。
1000                             ; 他のすべてのモジュールがここに依存します。
1000                             ; 
1000                             ; Phase 2: 16 ビットバリュースロット (4 バイト/スロット)
1000                             ;   +0: 型タグ (1B)
1000                             ;   +1: 予約   (1B, 常に 0)
1000                             ;   +2: val_lo (1B)
1000                             ;   +3: val_hi (1B)
1000                             ; 
1000                             ; ---------------------------------------------------------------
1000                             ; get_reg_addr — レジスタ番号 → スロット先頭アドレス
1000                             ; 
1000                             ;   入力: A = レジスタ番号 (0-63)
1000                             ;   出力: HL = スロット先頭アドレス
1000                             ;   破壊: A
1000                             ; 
1000                             ; OFF_REG_BASE からレジスタウィンドウのベースアドレスを読み、
1000                             ; レジスタ番号 × 4 を加算する。ブロック内ではベースが移動する。
1000                             ; DE は破壊しない (呼び出し元がポインタを DE に持つことがある)。
1000                             ; ---------------------------------------------------------------
1000                GET_REG_ADDR:      
1000   87                     ADD   a   ; ×2
1001   87                     ADD   a   ; ×4 (オフセット、A に残る)
1002   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   ; HL = 動的ベース (A 不変)
1005   85                     ADD   l   ; A = base_lo + offset
1006   6F                     MOV   l,a   
1007   3E 00                  MVI   a,0   ; MVI はフラグに影響しない
1009   8C                     ADC   h   ; A = base_hi + CY
100A   67                     MOV   h,a   
100B   C9                     RET      
100C                             ; 
100C                             ; ---------------------------------------------------------------
100C                             ; get_reg_addr_next — R[a+1] のスロット先頭アドレス
100C                             ; 
100C                             ;   入力: A = レジスタ番号 a
100C                             ;   出力: HL = R[a+1] のスロット先頭アドレス
100C                             ;   破壊: A
100C                             ; ---------------------------------------------------------------
100C                GET_REG_ADDR_NEXT:      
100C   3C                     INR   a   
100D   C3 00 10               JMP   get_reg_addr   
1010                             ; 
1010                             ; ---------------------------------------------------------------
1010                             ; set_slot_int16 — スロットに 16 ビット整数を書く
1010                             ; 
1010                             ;   入力: HL = スロット先頭アドレス
1010                             ;          B  = val_hi (上位バイト)
1010                             ;          C  = val_lo (下位バイト)
1010                             ;   出力: なし
1010                             ;   破壊: HL
1010                             ; ---------------------------------------------------------------
1010                SET_SLOT_INT16:      
1010   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1012   23                     INX   h   
1013   36 00                  MVI   m,0   ; +1: 予約
1015   23                     INX   h   
1016   71                     MOV   m,c   ; +2: val_lo
1017   23                     INX   h   
1018   70                     MOV   m,b   ; +3: val_hi
1019   C9                     RET      
101A                             ; 
101A                             ; ---------------------------------------------------------------
101A                             ; set_slot_special — 値を持たない型をスロットに書く
101A                             ; 
101A                             ;   入力: HL = スロット先頭アドレス
101A                             ;          A  = 型タグ (TT_NIL, TT_TRUE, TT_FALSE)
101A                             ;   出力: なし
101A                             ;   破壊: A, HL
101A                             ; ---------------------------------------------------------------
101A                SET_SLOT_SPECIAL:      
101A   77                     MOV   m,a   ; +0: 型タグ
101B   23                     INX   h   
101C   36 00                  MVI   m,0   ; +1: 予約
101E   23                     INX   h   
101F   36 00                  MVI   m,0   ; +2: val_lo = 0
1021   23                     INX   h   
1022   36 00                  MVI   m,0   ; +3: val_hi = 0
1024   C9                     RET      
1025                             ; 
1025                             ; ---------------------------------------------------------------
1025                             ; copy_slot — スロットを丸ごと複写 (4 バイト)
1025                             ; 
1025                             ;   入力: HL = コピー元先頭
1025                             ;         DE = コピー先先頭
1025                             ;   出力: なし
1025                             ;   破壊: A, C, HL, DE
1025                             ; ---------------------------------------------------------------
1025                COPY_SLOT:      
1025   0E 04                  MVI   c,SLOT_BYTES   
1027                COPY_SLOT_LOOP:      
1027   7E                     MOV   a,m   
1028   12                     STAX   d   
1029   23                     INX   h   
102A   13                     INX   d   
102B   0D                     DCR   c   
102C   C2 27 10               JNZ   copy_slot_loop   
102F   C9                     RET      
1030                             ; 
1030                             ; ---------------------------------------------------------------
1030                             ; get_slot_type — スロットの型タグを読む
1030                             ; 
1030                             ;   入力: HL = スロット先頭アドレス
1030                             ;   出力: A = 型タグ
1030                             ;   破壊: なし (HL 保存)
1030                             ; ---------------------------------------------------------------
1030                GET_SLOT_TYPE:      
1030   7E                     MOV   a,m   
1031   C9                     RET      
1032                             ; 
1032                             ; ---------------------------------------------------------------
1032                             ; slot_to_value — スロット先頭から値の先頭へ進める
1032                             ; 
1032                             ;   入力: HL = スロット先頭アドレス
1032                             ;   出力: HL = 値の先頭 (スロット +2)
1032                             ;   破壊: なし
1032                             ; ---------------------------------------------------------------
1032                SLOT_TO_VALUE:      
1032   23                     INX   h   
1033   23                     INX   h   
1034   C9                     RET      
1035                             ; 
1035                             ; ---------------------------------------------------------------
1035                             ; add_value16 — 16 ビット加算 (val1 += val2)
1035                             ; 
1035                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
1035                             ;         DE = 値 2 の先頭
1035                             ;   出力: 結果を HL の元の位置に上書き
1035                             ;   破壊: A, HL, DE
1035                             ; 
1035                             ; INX/XCHG はフラグを変えないので桁上げが正しく伝搬する。
1035                             ; ---------------------------------------------------------------
1035                ADD_VALUE16:      
1035   1A                     LDAX   d   ; A = val2[lo]
1036   86                     ADD   m   ; A += val1[lo]
1037   77                     MOV   m,a   ; val1[lo] = result
1038   23                     INX   h   
1039   13                     INX   d   
103A   1A                     LDAX   d   ; A = val2[hi]
103B   8E                     ADC   m   ; A += val1[hi] + CY
103C   77                     MOV   m,a   
103D   C9                     RET      
103E                             ; 
103E                             ; ---------------------------------------------------------------
103E                             ; sub_value16 — 16 ビット減算 (val1 -= val2)
103E                             ; 
103E                             ;   入力: HL = 値 1 の先頭 (結果をここに上書き)
103E                             ;         DE = 値 2 の先頭
103E                             ;   出力: 結果を HL の元の位置に上書き
103E                             ;   破壊: A, HL, DE
103E                             ; 
103E                             ; XCHG はフラグを変えないので借りが正しく伝搬する。
103E                             ; ---------------------------------------------------------------
103E                SUB_VALUE16:      
103E   7E                     MOV   a,m   ; A = val1[lo]
103F   EB                     XCHG      ; HL=val2, DE=val1
1040   96                     SUB   m   ; A -= val2[lo]
1041   EB                     XCHG      ; HL=val1, DE=val2
1042   77                     MOV   m,a   ; val1[lo] = result
1043   23                     INX   h   
1044   13                     INX   d   
1045   7E                     MOV   a,m   ; A = val1[hi]
1046   EB                     XCHG      
1047   9E                     SBB   m   ; A -= val2[hi] - CY
1048   EB                     XCHG      
1049   77                     MOV   m,a   
104A   C9                     RET      
104B                             ; 
104B                             ; ---------------------------------------------------------------
104B                             ; cmp_value16 — 16 ビット符号付き比較
104B                             ; 
104B                             ;   入力: HL = 値 1 の先頭 (byte0 の位置)
104B                             ;         DE = 値 2 の先頭 (byte0 の位置)
104B                             ;   出力: A = 比較結果
104B                             ;           00h → val1 == val2
104B                             ;           FFh → val1 < val2  (ORA A で S フラグが立つ → JM)
104B                             ;           01h → val1 > val2  (ORA A で S が立たない → JP)
104B                             ;   破壊: A, B, HL, DE
104B                             ; 
104B                             ; 手順:
104B                             ;   1. 上位バイト (byte1) の符号ビットを比べる
104B                             ;   2. 符号が違えば、負の方が小さい
104B                             ;   3. 符号が同じなら上位 → 下位の順に符号なし比較
104B                             ; ---------------------------------------------------------------
104B                CMP_VALUE16:      
104B                             ; byte1 (上位) の位置を求める
104B   23                     INX   h   ; HL = val1+1 (hi)
104C   13                     INX   d   ; DE = val2+1 (hi)
104D                             ; 符号ビットを比べる
104D   7E                     MOV   a,m   ; A = val1[hi]
104E   47                     MOV   b,a   ; B = val1[hi] (退避)
104F   1A                     LDAX   d   ; A = val2[hi]
1050   A8                     XRA   b   ; 符号ビットが違えば bit7 = 1
1051   F2 5D 10               JP   cmp16_same_sign   
1054                             ; 符号が違う: val1 が負なら val1 < val2
1054   78                     MOV   a,b   ; A = val1[hi]
1055   E6 80                  ANI   80h   ; bit7 を取り出す
1057   C2 71 10               JNZ   cmp16_ret_neg   ; val1 が負 → val1 < val2
105A   C3 74 10               JMP   cmp16_ret_pos   ; val1 が正 → val1 > val2
105D                CMP16_SAME_SIGN:      
105D                             ; 符号が同じ: 上位 → 下位の順に符号なし比較
105D   1A                     LDAX   d   
105E   BE                     CMP   m   ; val2[hi] - val1[hi]
105F   DA 74 10               JC   cmp16_ret_pos   
1062   C2 71 10               JNZ   cmp16_ret_neg   
1065   2B                     DCX   h   
1066   1B                     DCX   d   
1067   1A                     LDAX   d   
1068   BE                     CMP   m   ; val2[lo] - val1[lo]
1069   DA 74 10               JC   cmp16_ret_pos   
106C   C2 71 10               JNZ   cmp16_ret_neg   
106F                             ; すべて等しい
106F   AF                     XRA   a   ; A = 00h
1070   C9                     RET      
1071                CMP16_RET_NEG:      
1071   3E FF                  MVI   a,0FFh   ; val1 < val2
1073   C9                     RET      
1074                CMP16_RET_POS:      
1074   3E 01                  MVI   a,01h   ; val1 > val2
1076   C9                     RET      
1077                             ; 
1077                             ; ---------------------------------------------------------------
1077                             ; calc_child_irep — 子 irep 番号を算出
1077                             ; 
1077                             ;   入力: A = 子インデックス (オペランド b)
1077                             ;   出力: A = irep 番号
1077                             ;   破壊: B, C, DE, HL
1077                             ; 
1077                             ; pos = cur_irep + 1 から開始し、b 個のサブツリーを
1077                             ; subtree_size で飛ばして目的の子 irep 番号を求める。
1077                             ; OP_BLOCK, OP_METHOD, OP_EXEC の共通サブルーチン。
1077                             ; レジスタのみ使用 (メモリ変数なし): B=残りカウント, C=pos。
1077                             ; ---------------------------------------------------------------
1077                CALC_CHILD_IREP:      
1077   47                     MOV   b,a   ; B = スキップ回数
1078   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
107B   3C                     INR   a   ; A = cur_irep + 1
107C   4F                     MOV   c,a   ; C = pos
107D   78                     MOV   a,b   
107E   B7                     ORA   a   
107F   CA 99 10               JZ   cci_done   ; b == 0 → C をそのまま返す
1082                             ; 
1082                CCI_LOOP:      
1082                             ; HL = IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE + pos * 10
1082   79                     MOV   a,c   ; A = pos
1083   57                     MOV   d,a   ; D = pos (退避)
1084   87                     ADD   a   ; ×2
1085   5F                     MOV   e,a   ; E = ×2
1086   7A                     MOV   a,d   
1087   87                     ADD   a   ; ×2
1088   87                     ADD   a   ; ×4
1089   87                     ADD   a   ; ×8
108A   83                     ADD   e   ; ×10
108B   5F                     MOV   e,a   
108C   16 00                  MVI   d,0   
108E   21 07 82               LXI   h,IREP_TABLE_BASE + IREP_OFF_SUBTREE_SIZE   
1091   19                     DAD   d   ; HL = &subtree_size[pos]
1092                             ; 
1092                             ; pos += subtree_size
1092   79                     MOV   a,c   
1093   86                     ADD   m   ; A = pos + subtree_size
1094   4F                     MOV   c,a   ; C = 新しい pos
1095                             ; 
1095   05                     DCR   b   
1096   C2 82 10               JNZ   cci_loop   
1099                             ; 
1099                CCI_DONE:      
1099   79                     MOV   a,c   ; A = 最終的な pos
109A   C9                     RET      
109B                             ; 
109B                             ; ---------------------------------------------------------------
109B                             ; class_of_reg — レジスタスロットからクラス番号を求める
109B                             ; 
109B                             ;   入力: HL = スロットアドレス
109B                             ;   出力: A = class_number
109B                             ;   破壊: B, DE, HL
109B                             ; 
109B                             ; - TT_CLASS  → val_lo (クラス自身の番号)
109B                             ; - TT_OBJECT, val_lo=0 → 0 (main)
109B                             ; - TT_OBJECT, val_lo>0 → OBJECT_POOL_BASE + (val-1)*32 のヘッダから読む
109B                             ; - その他 → 0 (main)
109B                             ; ---------------------------------------------------------------
109B                CLASS_OF_REG:      
109B   7E                     MOV   a,m   ; A = 型タグ
109C   FE 0D                  CPI   TT_CLASS   
109E   CA A8 10               JZ   cor_class   
10A1   FE 0A                  CPI   TT_OBJECT   
10A3   CA AC 10               JZ   cor_object   
10A6                             ; その他 → main (class 0)
10A6   AF                     XRA   a   
10A7   C9                     RET      
10A8                COR_CLASS:      
10A8                             ; val_lo = class_number
10A8   23                     INX   h   
10A9   23                     INX   h   
10AA   7E                     MOV   a,m   ; A = val_lo = class_number
10AB   C9                     RET      
10AC                COR_OBJECT:      
10AC                             ; val_lo = slot+1 (0=main)
10AC   23                     INX   h   
10AD   23                     INX   h   
10AE   7E                     MOV   a,m   ; A = val_lo
10AF   B7                     ORA   a   
10B0   C8                     RZ      ; val_lo==0 → main (A=0)
10B1                             ; slot = val_lo - 1, ヘッダアドレス = OBJECT_POOL_BASE + slot * 32
10B1   3D                     DCR   a   ; A = slot
10B2                             ; × 32 = 5 回の add a
10B2   87                     ADD   a   ; ×2
10B3   87                     ADD   a   ; ×4
10B4   87                     ADD   a   ; ×8
10B5   87                     ADD   a   ; ×16
10B6   87                     ADD   a   ; ×32
10B7   5F                     MOV   e,a   
10B8   16 00                  MVI   d,0   
10BA   21 C0 92               LXI   h,OBJECT_POOL_BASE   
10BD   19                     DAD   d   ; HL = スロット先頭
10BE   7E                     MOV   a,m   ; A = class_number (ヘッダ +0)
10BF   C9                     RET      
10C0                             ; vm_fetch.a80 — バイトコードフェッチ + オペランドデコード
10C0                             ; 
10C0                             ; PC (VM 状態内のオフセット) から 1 バイトずつ読み、PC を進めます。
10C0                             ; マルチバイトオペランド (S 形式) はビッグエンディアンです。
10C0                             ; 
10C0                             ; ---------------------------------------------------------------
10C0                             ; fetch_byte — バイトコードから 1 バイト読み、PC を進める
10C0                             ; 
10C0                             ;   入力: なし
10C0                             ;   出力: A = 読んだバイト
10C0                             ;   破壊: HL, DE
10C0                             ; 
10C0                             ; PC はバイトコード領域内のオフセット。絶対アドレスは
10C0                             ; OFF_BC_BASE + PC で求めます。ブロック内ではバイトコードベースが
10C0                             ; 子 irep の先頭に変わります。
10C0                             ; ---------------------------------------------------------------
10C0                FETCH_BYTE:      
10C0   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = PC (オフセット)
10C3   EB                     XCHG      ; DE = PC
10C4   2A 16 80               LHLD   VM_STATE_BASE + OFF_BC_BASE   ; HL = 動的バイトコードベース
10C7   19                     DAD   d   ; HL = 絶対アドレス
10C8   7E                     MOV   a,m   ; A = bytecode[PC]
10C9                             ; PC をインクリメント
10C9   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
10CC   23                     INX   h   
10CD   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
10D0   C9                     RET      
10D1                             ; 
10D1                             ; ---------------------------------------------------------------
10D1                             ; fetch_u16be — ビッグエンディアン 16 ビットを読む
10D1                             ; 
10D1                             ;   入力: なし
10D1                             ;   出力: HL = 読んだ 16 ビット値 (H=上位, L=下位)
10D1                             ;   破壊: A, B, DE
10D1                             ; 
10D1                             ; mruby は S 形式のオペランドをビッグエンディアンで格納する。
10D1                             ; 1 バイト目が上位、2 バイト目が下位。
10D1                             ; ---------------------------------------------------------------
10D1                FETCH_U16BE:      
10D1   CD C0 10               CALL   fetch_byte   ; A = 上位バイト
10D4   47                     MOV   b,a   ; B に退避 (fetch_byte は HL を壊す)
10D5   CD C0 10               CALL   fetch_byte   ; A = 下位バイト
10D8   6F                     MOV   l,a   
10D9   60                     MOV   h,b   
10DA   C9                     RET      
10DB                             ; 
10DB                             ; ---------------------------------------------------------------
10DB                             ; fetch_s16be — ビッグエンディアン符号付き 16 ビットを読む
10DB                             ; 
10DB                             ;   入力: なし
10DB                             ;   出力: HL = 読んだ符号付き 16 ビット値
10DB                             ;   破壊: A, DE
10DB                             ; 
10DB                             ; 内部表現はそのまま 16 ビット。符号は呼び出し側が解釈する。
10DB                             ; ---------------------------------------------------------------
10DB                FETCH_S16BE:      
10DB   C3 D1 10               JMP   fetch_u16be   ; 表現は同じ。解釈が違うだけ
10DE                             ; vm_load.a80 — ロード命令
10DE                             ; 
10DE                             ; LOADI*, LOADNIL, LOADT, LOADF, MOVE
10DE                             ; 
10DE                             ; Phase 2: 16 ビットスロット (4 バイト)
10DE                             ;   set_slot_int16: B=val_hi, C=val_lo
10DE                             ; 
10DE                             ; ---------------------------------------------------------------
10DE                             ; OP_NOP (Z): 何もしない
10DE                             ; ---------------------------------------------------------------
10DE                DO_OP_NOP:      
10DE   C3 1B 1C               JMP   vm_loop   
10E1                             ; 
10E1                             ; ---------------------------------------------------------------
10E1                             ; OP_MOVE (BB): R[a] = R[b]
10E1                             ; ---------------------------------------------------------------
10E1                DO_OP_MOVE:      
10E1   CD C0 10               CALL   fetch_byte   ; A = a (コピー先)
10E4   F5                     PUSH   psw   
10E5   CD C0 10               CALL   fetch_byte   ; A = b (コピー元)
10E8   CD 00 10               CALL   get_reg_addr   ; HL = R[b] のスロット先頭
10EB   EB                     XCHG      ; DE = R[b]
10EC   F1                     POP   psw   ; A = a
10ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
10F0   EB                     XCHG      ; DE = R[a] (コピー先), HL = R[b] (コピー元)
10F1   CD 25 10               CALL   copy_slot   
10F4   C3 1B 1C               JMP   vm_loop   
10F7                             ; 
10F7                             ; ---------------------------------------------------------------
10F7                             ; OP_LOADI (BB): R[a] = b (符号なし 8 ビット)
10F7                             ; ---------------------------------------------------------------
10F7                DO_OP_LOADI:      
10F7   CD C0 10               CALL   fetch_byte   ; A = a
10FA   F5                     PUSH   psw   
10FB   CD C0 10               CALL   fetch_byte   ; A = b (値)
10FE   4F                     MOV   c,a   ; C = val_lo
10FF   F1                     POP   psw   ; A = a
1100   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1103   79                     MOV   a,c   ; 退避していた値を C に戻す (既に C にある)
1104   06 00                  MVI   b,0   ; B = val_hi (正なので 0)
1106   CD 10 10               CALL   set_slot_int16   
1109   C3 1B 1C               JMP   vm_loop   
110C                             ; 
110C                             ; ---------------------------------------------------------------
110C                             ; OP_LOADINEG (BB): R[a] = -b
110C                             ; ---------------------------------------------------------------
110C                DO_OP_LOADINEG:      
110C   CD C0 10               CALL   fetch_byte   ; A = a
110F   F5                     PUSH   psw   
1110   CD C0 10               CALL   fetch_byte   ; A = b
1113                             ; -b を計算 (0 - b)
1113   4F                     MOV   c,a   ; C = b (退避)
1114   AF                     XRA   a   ; A = 0
1115   91                     SUB   c   ; A = -b
1116   4F                     MOV   c,a   ; C = val_lo (-b)
1117   F1                     POP   psw   ; A = a
1118   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
111B   06 FF                  MVI   b,0FFh   ; B = val_hi (負なので FF)
111D   CD 10 10               CALL   set_slot_int16   
1120   C3 1B 1C               JMP   vm_loop   
1123                             ; 
1123                             ; ---------------------------------------------------------------
1123                             ; OP_LOADI__1 (B): R[a] = -1
1123                             ; ---------------------------------------------------------------
1123                DO_OP_LOADI__1:      
1123   CD C0 10               CALL   fetch_byte   ; A = a
1126   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1129   0E FF                  MVI   c,0FFh   ; val_lo = FFh
112B   06 FF                  MVI   b,0FFh   ; val_hi = FFh (-1 = 0xFFFF)
112D   CD 10 10               CALL   set_slot_int16   
1130   C3 1B 1C               JMP   vm_loop   
1133                             ; 
1133                             ; ---------------------------------------------------------------
1133                             ; OP_LOADI_0 ～ OP_LOADI_7 (B): R[a] = 0..7
1133                             ; ---------------------------------------------------------------
1133                DO_OP_LOADI_0:      
1133   0E 00                  MVI   c,0   
1135   C3 58 11               JMP   loadi_small   
1138                DO_OP_LOADI_1:      
1138   0E 01                  MVI   c,1   
113A   C3 58 11               JMP   loadi_small   
113D                DO_OP_LOADI_2:      
113D   0E 02                  MVI   c,2   
113F   C3 58 11               JMP   loadi_small   
1142                DO_OP_LOADI_3:      
1142   0E 03                  MVI   c,3   
1144   C3 58 11               JMP   loadi_small   
1147                DO_OP_LOADI_4:      
1147   0E 04                  MVI   c,4   
1149   C3 58 11               JMP   loadi_small   
114C                DO_OP_LOADI_5:      
114C   0E 05                  MVI   c,5   
114E   C3 58 11               JMP   loadi_small   
1151                DO_OP_LOADI_6:      
1151   0E 06                  MVI   c,6   
1153   C3 58 11               JMP   loadi_small   
1156                DO_OP_LOADI_7:      
1156   0E 07                  MVI   c,7   
1158                LOADI_SMALL:      
1158                             ; C = 即値 (0-7)
1158   CD C0 10               CALL   fetch_byte   ; A = a
115B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
115E   06 00                  MVI   b,0   ; val_hi = 0 (正)
1160   CD 10 10               CALL   set_slot_int16   
1163   C3 1B 1C               JMP   vm_loop   
1166                             ; 
1166                             ; ---------------------------------------------------------------
1166                             ; OP_LOADI16 (BS): R[a] = signed16(b)
1166                             ; 
1166                             ; b は符号付き 16 ビット (ビッグエンディアン)。
1166                             ; 16 ビットスロットではそのままネイティブサイズ。
1166                             ; 符号拡張は不要。
1166                             ; ---------------------------------------------------------------
1166                DO_OP_LOADI16:      
1166   CD C0 10               CALL   fetch_byte   ; A = a
1169   F5                     PUSH   psw   
116A   CD DB 10               CALL   fetch_s16be   ; HL = signed16 値 (H=上位, L=下位)
116D   4D                     MOV   c,l   ; C = val_lo
116E   44                     MOV   b,h   ; B = val_hi
116F   F1                     POP   psw   ; A = a
1170   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1173                             ; 型タグと値を書く
1173   36 04                  MVI   m,TT_INTEGER   ; +0: 型タグ
1175   23                     INX   h   
1176   36 00                  MVI   m,0   ; +1: 予約
1178   23                     INX   h   
1179   71                     MOV   m,c   ; +2: val_lo
117A   23                     INX   h   
117B   70                     MOV   m,b   ; +3: val_hi
117C   C3 1B 1C               JMP   vm_loop   
117F                             ; 
117F                             ; ---------------------------------------------------------------
117F                             ; OP_LOADNIL (B): R[a] = nil
117F                             ; ---------------------------------------------------------------
117F                DO_OP_LOADNIL:      
117F   CD C0 10               CALL   fetch_byte   ; A = a
1182   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1185   3E 01                  MVI   a,TT_NIL   
1187   CD 1A 10               CALL   set_slot_special   
118A   C3 1B 1C               JMP   vm_loop   
118D                             ; 
118D                             ; ---------------------------------------------------------------
118D                             ; OP_LOADT (B): R[a] = true
118D                             ; ---------------------------------------------------------------
118D                DO_OP_LOADT:      
118D   CD C0 10               CALL   fetch_byte   ; A = a
1190   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1193   3E 03                  MVI   a,TT_TRUE   
1195   CD 1A 10               CALL   set_slot_special   
1198   C3 1B 1C               JMP   vm_loop   
119B                             ; 
119B                             ; ---------------------------------------------------------------
119B                             ; OP_LOADF (B): R[a] = false
119B                             ; ---------------------------------------------------------------
119B                DO_OP_LOADF:      
119B   CD C0 10               CALL   fetch_byte   ; A = a
119E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11A1   3E 02                  MVI   a,TT_FALSE   
11A3   CD 1A 10               CALL   set_slot_special   
11A6   C3 1B 1C               JMP   vm_loop   
11A9                             ; vm_arith.a80 — 算術命令 (16 ビット整数)
11A9                             ; 
11A9                             ; OP_ADD, OP_ADDI, OP_SUB, OP_SUBI, OP_MUL, OP_DIV
11A9                             ; 
11A9                             ; ---------------------------------------------------------------
11A9                             ; OP_ADD (B): R[a] = R[a] + R[a+1]
11A9                             ; 
11A9                             ; R[a] の型で分岐:
11A9                             ;   TT_INTEGER: 16 ビット加算
11A9                             ;   TT_STRING:  文字列連結 (STRCAT と同じ)
11A9                             ; ---------------------------------------------------------------
11A9                DO_OP_ADD:      
11A9   CD C0 10               CALL   fetch_byte   ; A = a
11AC   F5                     PUSH   psw   
11AD   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11B0   7E                     MOV   a,m   ; A = 型タグ
11B1   FE 07                  CPI   TT_STRING   
11B3   CA CC 11               JZ   add_string   
11B6                             ; --- 整数パス ---
11B6   F1                     POP   psw   ; A = a
11B7   F5                     PUSH   psw   
11B8                             ; R[a+1] のスロットアドレスを求める
11B8   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11BB   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
11BE   EB                     XCHG      ; DE = R[a+1] の値先頭
11BF   F1                     POP   psw   ; A = a
11C0                             ; R[a] のスロットアドレスを求める
11C0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11C3   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11C6                             ; 16 ビット加算: val[a] += val[a+1]
11C6   CD 35 10               CALL   add_value16   
11C9   C3 1B 1C               JMP   vm_loop   
11CC                             ; --- 文字列パス ---
11CC                ADD_STRING:      
11CC   F1                     POP   psw   ; A = a
11CD   32 31 23               STA   scat_reg_a   
11D0   C3 C1 22               JMP   strcat_body   ; do_op_strcat の本体を再利用
11D3                             ; 
11D3                             ; ---------------------------------------------------------------
11D3                             ; OP_SUB (B): R[a] = R[a] - R[a+1]
11D3                             ; ---------------------------------------------------------------
11D3                DO_OP_SUB:      
11D3   CD C0 10               CALL   fetch_byte   ; A = a
11D6   F5                     PUSH   psw   
11D7   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
11DA   CD 32 10               CALL   slot_to_value   
11DD   EB                     XCHG      ; DE = R[a+1] の値先頭
11DE   F1                     POP   psw   ; A = a
11DF   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11E2   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
11E5   CD 3E 10               CALL   sub_value16   
11E8   C3 1B 1C               JMP   vm_loop   
11EB                             ; 
11EB                             ; ---------------------------------------------------------------
11EB                             ; OP_ADDI (BB): R[a] = R[a] + b (b は符号なし即値 0-255)
11EB                             ; 
11EB                             ; MOV / INX はフラグを変えないので桁上げが正しく伝搬する。
11EB                             ; ---------------------------------------------------------------
11EB                DO_OP_ADDI:      
11EB   CD C0 10               CALL   fetch_byte   ; A = a
11EE   F5                     PUSH   psw   
11EF   CD C0 10               CALL   fetch_byte   ; A = b (即値)
11F2   4F                     MOV   c,a   ; C = b
11F3   F1                     POP   psw   ; A = a
11F4   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
11F7   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
11FA   7E                     MOV   a,m   ; val_lo
11FB   81                     ADD   c   ; val_lo + b (CY = 桁上げ)
11FC   77                     MOV   m,a   
11FD   23                     INX   h   
11FE   7E                     MOV   a,m   ; val_hi (MOV はフラグを変えない)
11FF   CE 00                  ACI   0   ; val_hi + CY
1201   77                     MOV   m,a   
1202   C3 1B 1C               JMP   vm_loop   
1205                             ; 
1205                             ; ---------------------------------------------------------------
1205                             ; OP_SUBI (BB): R[a] = R[a] - b (b は符号なし即値 0-255)
1205                             ; ---------------------------------------------------------------
1205                DO_OP_SUBI:      
1205   CD C0 10               CALL   fetch_byte   ; A = a
1208   F5                     PUSH   psw   
1209   CD C0 10               CALL   fetch_byte   ; A = b (即値)
120C   4F                     MOV   c,a   ; C = b
120D   F1                     POP   psw   ; A = a
120E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1211   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭 (+2)
1214   7E                     MOV   a,m   ; val_lo
1215   91                     SUB   c   ; val_lo - b (CY = 借り)
1216   77                     MOV   m,a   
1217   23                     INX   h   
1218   7E                     MOV   a,m   ; val_hi
1219   DE 00                  SBI   0   ; val_hi - CY
121B   77                     MOV   m,a   
121C   C3 1B 1C               JMP   vm_loop   
121F                             ; 
121F                             ; ---------------------------------------------------------------
121F                             ; OP_MUL (B): R[a] = R[a] * R[a+1]
121F                             ; 
121F                             ; 16 ビット整数の乗算。下位 16 ビットのみ保持。
121F                             ; 符号付き・符号なしとも下位 16 ビットは同一なので符号処理は不要。
121F                             ; ---------------------------------------------------------------
121F                DO_OP_MUL:      
121F   CD C0 10               CALL   fetch_byte   ; A = a
1222   F5                     PUSH   psw   
1223   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1226   CD 32 10               CALL   slot_to_value   ; HL = R[a+1] の値先頭
1229   5E                     MOV   e,m   ; E = val2_lo
122A   23                     INX   h   
122B   56                     MOV   d,m   ; D = val2_hi → DE = 乗数
122C   F1                     POP   psw   ; A = a
122D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1230   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1233   E5                     PUSH   h   ; 書き戻し先を退避
1234   4E                     MOV   c,m   
1235   23                     INX   h   
1236   46                     MOV   b,m   ; BC = 被乗数
1237   CD 6E 12               CALL   umul16   ; HL = BC × DE (下位 16 ビット)
123A   D1                     POP   d   ; DE = 書き戻し先
123B   7D                     MOV   a,l   
123C   12                     STAX   d   
123D   13                     INX   d   
123E   7C                     MOV   a,h   
123F   12                     STAX   d   
1240   C3 1B 1C               JMP   vm_loop   
1243                             ; 
1243                             ; ---------------------------------------------------------------
1243                             ; OP_DIV (B): R[a] = R[a] / R[a+1]
1243                             ; 
1243                             ; 16 ビット符号付き整数の除算 (Ruby 互換の floor 除算)。
1243                             ; 除数 0 はエラー停止。
1243                             ; ---------------------------------------------------------------
1243                DO_OP_DIV:      
1243   CD C0 10               CALL   fetch_byte   ; A = a
1246   F5                     PUSH   psw   
1247   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
124A   CD 32 10               CALL   slot_to_value   
124D   5E                     MOV   e,m   
124E   23                     INX   h   
124F   56                     MOV   d,m   ; DE = 除数
1250                             ; ゼロ除算チェック
1250   7A                     MOV   a,d   
1251   B3                     ORA   e   
1252   C2 59 12               JNZ   do_div_nonzero   
1255   F1                     POP   psw   
1256   C3 03 00               JMP   vm_error   
1259                DO_DIV_NONZERO:      
1259   F1                     POP   psw   ; A = a
125A   CD 00 10               CALL   get_reg_addr   
125D   CD 32 10               CALL   slot_to_value   
1260   E5                     PUSH   h   ; 書き戻し先を退避
1261   4E                     MOV   c,m   
1262   23                     INX   h   
1263   46                     MOV   b,m   ; BC = 被除数
1264   CD 80 12               CALL   sdiv16   ; BC = 商
1267   E1                     POP   h   ; HL = 書き戻し先
1268   71                     MOV   m,c   
1269   23                     INX   h   
126A   70                     MOV   m,b   
126B   C3 1B 1C               JMP   vm_loop   
126E                             ; 
126E                             ; ---------------------------------------------------------------
126E                             ; umul16 — 16 ビット符号なし乗算 (shift-and-add)
126E                             ; 
126E                             ;   入力: BC = 被乗数, DE = 乗数
126E                             ;   出力: HL = 積の下位 16 ビット
126E                             ;   破壊: A, DE
126E                             ; ---------------------------------------------------------------
126E                UMUL16:      
126E   21 00 00               LXI   h,0   ; 積 = 0
1271   3E 10                  MVI   a,16   ; ビットカウンタ
1273                UMUL16_LOOP:      
1273   29                     DAD   h   ; 積 <<= 1
1274   EB                     XCHG      ; HL ↔ DE
1275   29                     DAD   h   ; 乗数 <<= 1, bit15 → CY
1276   EB                     XCHG      ; HL ↔ DE
1277   D2 7B 12               JNC   umul16_noadd   
127A   09                     DAD   b   ; 積 += 被乗数
127B                UMUL16_NOADD:      
127B   3D                     DCR   a   
127C   C2 73 12               JNZ   umul16_loop   
127F   C9                     RET      
1280                             ; 
1280                             ; ---------------------------------------------------------------
1280                             ; sdiv16 — 16 ビット符号付き除算 (floor 除算, Ruby 互換)
1280                             ; 
1280                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1280                             ;   出力: BC = 商
1280                             ;   破壊: A, DE, HL
1280                             ; 
1280                             ; 符号を記録 → 絶対値 → 符号なし除算 → 符号復元。
1280                             ; 異符号で剰余 ≠ 0 なら商を 1 減らす (floor)。
1280                             ; ---------------------------------------------------------------
1280                SDIV16:      
1280   78                     MOV   a,b   
1281   AA                     XRA   d   ; bit7 = 商の符号 (異符号なら負)
1282   F5                     PUSH   psw   ; 符号情報を退避
1283                             ; 被除数を正にする
1283   78                     MOV   a,b   
1284   E6 80                  ANI   80h   
1286   CA 8C 12               JZ   sdiv16_chk_div   
1289   CD DC 12               CALL   neg_bc   
128C                SDIV16_CHK_DIV:      
128C                             ; 除数を正にする
128C   7A                     MOV   a,d   
128D   E6 80                  ANI   80h   
128F   CA 95 12               JZ   sdiv16_do   
1292   CD E4 12               CALL   neg_de   
1295                SDIV16_DO:      
1295   CD A5 12               CALL   udiv16   ; BC = |商|, HL = |剰余|
1298   F1                     POP   psw   
1299   E6 80                  ANI   80h   
129B   C8                     RZ      ; 同符号 → 正の商をそのまま返す
129C                             ; 異符号: 剰余があれば floor 調整
129C   7C                     MOV   a,h   
129D   B5                     ORA   l   
129E   CA A2 12               JZ   sdiv16_neg   ; 剰余 = 0 → 単純に符号反転
12A1   03                     INX   b   ; 剰余 ≠ 0 → 商 +1 してから反転 (floor)
12A2                SDIV16_NEG:      
12A2   C3 DC 12               JMP   neg_bc   
12A5                             ; 
12A5                             ; ---------------------------------------------------------------
12A5                             ; udiv16 — 16 ビット符号なし除算 (2 進長除算)
12A5                             ; 
12A5                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
12A5                             ;   出力: BC = 商, HL = 剰余
12A5                             ;   破壊: A
12A5                             ; 
12A5                             ; 被除数の MSB から 1 ビットずつ剰余にシフトし、
12A5                             ; 剰余 ≧ 除数なら減算して商ビットを立てる。
12A5                             ; ---------------------------------------------------------------
12A5                UDIV16:      
12A5   21 00 00               LXI   h,0   ; 剰余 = 0
12A8   3E 10                  MVI   a,16   
12AA   32 DB 12               STA   udiv_cnt   
12AD                UDIV16_LOOP:      
12AD                             ; BC を 1 ビット左シフト (MSB → CY)
12AD   79                     MOV   a,c   
12AE   87                     ADD   a   ; C <<= 1, bit7 → CY
12AF   4F                     MOV   c,a   
12B0   78                     MOV   a,b   
12B1   8F                     ADC   a   ; B <<= 1 + CY from C
12B2   47                     MOV   b,a   ; CY = 元の BC bit15 (被除数ビット)
12B3                             ; CY を剰余 (HL) にシフトイン
12B3   7D                     MOV   a,l   
12B4   17                     RAL      
12B5   6F                     MOV   l,a   
12B6   7C                     MOV   a,h   
12B7   17                     RAL      
12B8   67                     MOV   h,a   
12B9                             ; CY=1 なら剰余がオーバーフロー → 確実に除数以上
12B9   DA C9 12               JC   udiv16_sub   
12BC                             ; 剰余 (HL) と 除数 (DE) を比較
12BC   7C                     MOV   a,h   
12BD   BA                     CMP   d   
12BE   DA D0 12               JC   udiv16_nosub   ; H < D → HL < DE
12C1   C2 C9 12               JNZ   udiv16_sub   ; H > D → HL > DE
12C4   7D                     MOV   a,l   
12C5   BB                     CMP   e   
12C6   DA D0 12               JC   udiv16_nosub   ; L < E → HL < DE
12C9                UDIV16_SUB:      
12C9                             ; 剰余 ≧ 除数: 減算して商ビット = 1
12C9   7D                     MOV   a,l   
12CA   93                     SUB   e   
12CB   6F                     MOV   l,a   
12CC   7C                     MOV   a,h   
12CD   9A                     SBB   d   
12CE   67                     MOV   h,a   
12CF   0C                     INR   c   ; 商の bit0 を立てる
12D0                UDIV16_NOSUB:      
12D0   3A DB 12               LDA   udiv_cnt   ; LDA は CY に影響しない
12D3   3D                     DCR   a   ; DCR は CY に影響しない
12D4   32 DB 12               STA   udiv_cnt   
12D7   C2 AD 12               JNZ   udiv16_loop   
12DA   C9                     RET      
12DB                             ; 
12DB                UDIV_CNT:      
12DB   00                     DB   0   
12DC                             ; 
12DC                             ; ---------------------------------------------------------------
12DC                             ; neg_bc / neg_de — 16 ビット 2 の補数 (符号反転)
12DC                             ; ---------------------------------------------------------------
12DC                NEG_BC:      
12DC   79                     MOV   a,c   
12DD   2F                     CMA      
12DE   4F                     MOV   c,a   
12DF   78                     MOV   a,b   
12E0   2F                     CMA      
12E1   47                     MOV   b,a   
12E2   03                     INX   b   
12E3   C9                     RET      
12E4                             ; 
12E4                NEG_DE:      
12E4   7B                     MOV   a,e   
12E5   2F                     CMA      
12E6   5F                     MOV   e,a   
12E7   7A                     MOV   a,d   
12E8   2F                     CMA      
12E9   57                     MOV   d,a   
12EA   13                     INX   d   
12EB   C9                     RET      
12EC                             ; vm_compare.a80 — 比較命令
12EC                             ; 
12EC                             ; OP_EQ, OP_LT, OP_LE, OP_GT, OP_GE
12EC                             ; 
12EC                             ; 結果は R[a] に true (TT_TRUE) または false (TT_FALSE) を書く。
12EC                             ; Phase 2 は整数のみ。
12EC                             ; 
12EC                             ; cmp_value16 は結果を A で返す:
12EC                             ;   A = 00h → 等しい
12EC                             ;   A = FFh → val1 < val2 (bit7 がセットされるので JM で拾える)
12EC                             ;   A = 01h → val1 > val2
12EC                             ; 
12EC                             ; OFF_OPERAND_A にレジスタ番号を保存し、結果書き込み時に再取得する。
12EC                             ; 
12EC                             ; ---------------------------------------------------------------
12EC                             ; cmp_reg_pair — R[a] と R[a+1] の値を比較する (共通前処理)
12EC                             ; 
12EC                             ;   出力: A = 比較結果 (00h/FFh/01h)
12EC                             ;         OFF_OPERAND_A にレジスタ番号 a が入っている
12EC                             ;   破壊: A, B, HL, DE
12EC                             ; ---------------------------------------------------------------
12EC                CMP_REG_PAIR:      
12EC   CD C0 10               CALL   fetch_byte   
12EF   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
12F2                             ; R[a+1] の値先頭
12F2   CD 0C 10               CALL   get_reg_addr_next   
12F5   CD 32 10               CALL   slot_to_value   
12F8   EB                     XCHG      ; DE = R[a+1] 値先頭
12F9                             ; R[a] の値先頭
12F9   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
12FC   CD 00 10               CALL   get_reg_addr   
12FF   CD 32 10               CALL   slot_to_value   ; HL = R[a] 値先頭
1302   CD 4B 10               CALL   cmp_value16   ; A = 結果
1305   C9                     RET      
1306                             ; 
1306                             ; ---------------------------------------------------------------
1306                             ; cmp_set_true / cmp_set_false — 結果をスロットに書いてループへ戻る
1306                             ; 
1306                             ; OFF_OPERAND_A から R[a] のアドレスを再計算する。
1306                             ; ---------------------------------------------------------------
1306                CMP_SET_TRUE:      
1306   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1309   CD 00 10               CALL   get_reg_addr   
130C   3E 03                  MVI   a,TT_TRUE   
130E   CD 1A 10               CALL   set_slot_special   
1311   C3 1B 1C               JMP   vm_loop   
1314                CMP_SET_FALSE:      
1314   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
1317   CD 00 10               CALL   get_reg_addr   
131A   3E 02                  MVI   a,TT_FALSE   
131C   CD 1A 10               CALL   set_slot_special   
131F   C3 1B 1C               JMP   vm_loop   
1322                             ; 
1322                             ; ---------------------------------------------------------------
1322                             ; OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
1322                             ; 
1322                             ; 型タグと値の両方が一致したときだけ true。
1322                             ; ---------------------------------------------------------------
1322                DO_OP_EQ:      
1322   CD C0 10               CALL   fetch_byte   
1325   32 0B 80               STA   VM_STATE_BASE + OFF_OPERAND_A   
1328                             ; R[a] と R[a+1] のスロットアドレスを求める
1328   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
132B   E5                     PUSH   h   ; R[a] を退避
132C   3A 0B 80               LDA   VM_STATE_BASE + OFF_OPERAND_A   
132F   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
1332   D1                     POP   d   ; DE = R[a]
1333                             ; HL = R[a+1], DE = R[a]
1333                             ; 型タグを比べる
1333   46                     MOV   b,m   ; B = R[a+1].type
1334   1A                     LDAX   d   ; A = R[a].type
1335   B8                     CMP   b   
1336   C2 14 13               JNZ   cmp_set_false   ; 型が違えば false
1339                             ; 型が同じ → 値を 2 バイト比べる
1339   23                     INX   h   
133A   23                     INX   h   ; HL = R[a+1] + 2 (値先頭)
133B   13                     INX   d   
133C   13                     INX   d   ; DE = R[a] + 2 (値先頭)
133D   1A                     LDAX   d   ; A = R[a].val_lo
133E   BE                     CMP   m   ; R[a].val_lo - R[a+1].val_lo
133F   C2 14 13               JNZ   cmp_set_false   
1342   23                     INX   h   
1343   13                     INX   d   
1344   1A                     LDAX   d   ; A = R[a].val_hi
1345   BE                     CMP   m   ; R[a].val_hi - R[a+1].val_hi
1346   C2 14 13               JNZ   cmp_set_false   
1349   C3 06 13               JMP   cmp_set_true   ; すべて一致
134C                             ; 
134C                             ; ---------------------------------------------------------------
134C                             ; OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
134C                             ; ---------------------------------------------------------------
134C                DO_OP_LT:      
134C   CD EC 12               CALL   cmp_reg_pair   ; A = 結果
134F   B7                     ORA   a   
1350   FA 06 13               JM   cmp_set_true   ; A = FFh → val1 < val2
1353   C3 14 13               JMP   cmp_set_false   
1356                             ; 
1356                             ; ---------------------------------------------------------------
1356                             ; OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
1356                             ; ---------------------------------------------------------------
1356                DO_OP_LE:      
1356   CD EC 12               CALL   cmp_reg_pair   
1359   B7                     ORA   a   
135A   FA 06 13               JM   cmp_set_true   ; val1 < val2
135D   CA 06 13               JZ   cmp_set_true   ; val1 == val2
1360   C3 14 13               JMP   cmp_set_false   
1363                             ; 
1363                             ; ---------------------------------------------------------------
1363                             ; OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
1363                             ; ---------------------------------------------------------------
1363                DO_OP_GT:      
1363   CD EC 12               CALL   cmp_reg_pair   
1366   B7                     ORA   a   
1367   CA 14 13               JZ   cmp_set_false   ; val1 == val2
136A   F2 06 13               JP   cmp_set_true   ; A = 01h → val1 > val2
136D   C3 14 13               JMP   cmp_set_false   ; A = FFh → val1 < val2
1370                             ; 
1370                             ; ---------------------------------------------------------------
1370                             ; OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
1370                             ; ---------------------------------------------------------------
1370                DO_OP_GE:      
1370   CD EC 12               CALL   cmp_reg_pair   
1373   B7                     ORA   a   
1374   FA 14 13               JM   cmp_set_false   ; val1 < val2
1377   C3 06 13               JMP   cmp_set_true   ; val1 >= val2
137A                             ; vm_jump.a80 — ジャンプ命令
137A                             ; 
137A                             ; OP_JMP, OP_JMPIF, OP_JMPNOT
137A                             ; 
137A                             ; オフセットは命令読み取り後の PC (= 次の命令の先頭) からの相対値。
137A                             ; mruby のバイトコードは符号付き 16 ビット、ビッグエンディアン。
137A                             ; 
137A                             ; ---------------------------------------------------------------
137A                             ; apply_jump — PC に符号付きオフセットを加える
137A                             ; 
137A                             ;   入力: HL = 符号付き 16 ビットオフセット
137A                             ;   出力: なし (PC が更新される)
137A                             ;   破壊: A, HL, DE
137A                             ; ---------------------------------------------------------------
137A                APPLY_JUMP:      
137A   EB                     XCHG      ; DE = オフセット
137B   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   ; HL = 現在の PC
137E   19                     DAD   d   ; HL = PC + オフセット
137F   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1382   C9                     RET      
1383                             ; 
1383                             ; ---------------------------------------------------------------
1383                             ; OP_JMP (S): PC += signed16(a)
1383                             ; ---------------------------------------------------------------
1383                DO_OP_JMP:      
1383   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1386   CD 7A 13               CALL   apply_jump   
1389   C3 1B 1C               JMP   vm_loop   
138C                             ; 
138C                             ; ---------------------------------------------------------------
138C                             ; OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
138C                             ; 
138C                             ; Ruby で偽なのは nil と false だけ。型タグが TT_FALSY_MAX 以下なら偽。
138C                             ; ---------------------------------------------------------------
138C                DO_OP_JMPIF:      
138C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
138F   F5                     PUSH   psw   
1390   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
1393   E5                     PUSH   h   ; オフセットを退避
1394   D1                     POP   d   ; DE = オフセット
1395   F1                     POP   psw   ; A = a
1396   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
1399   CD 30 10               CALL   get_slot_type   ; A = 型タグ
139C   FE 03                  CPI   TT_FALSY_MAX + 1   
139E   DA A8 13               JC   jmpif_skip   ; 型タグ <= TT_FALSY_MAX → 偽 → ジャンプしない
13A1                             ; 真 → ジャンプする
13A1   EB                     XCHG      ; HL = オフセット (DE にあった)
13A2   CD 7A 13               CALL   apply_jump   
13A5   C3 1B 1C               JMP   vm_loop   
13A8                JMPIF_SKIP:      
13A8   C3 1B 1C               JMP   vm_loop   
13AB                             ; 
13AB                             ; ---------------------------------------------------------------
13AB                             ; OP_JMPNOT (BS): if R[a] が偽 then PC += signed16(b)
13AB                             ; ---------------------------------------------------------------
13AB                DO_OP_JMPNOT:      
13AB   CD C0 10               CALL   fetch_byte   ; A = a
13AE   F5                     PUSH   psw   
13AF   CD DB 10               CALL   fetch_s16be   ; HL = オフセット
13B2   E5                     PUSH   h   
13B3   D1                     POP   d   ; DE = オフセット
13B4   F1                     POP   psw   ; A = a
13B5   CD 00 10               CALL   get_reg_addr   ; HL = R[a] スロット先頭
13B8   CD 30 10               CALL   get_slot_type   ; A = 型タグ
13BB   FE 03                  CPI   TT_FALSY_MAX + 1   
13BD   D2 C7 13               JNC   jmpnot_skip   ; 型タグ > TT_FALSY_MAX → 真 → ジャンプしない
13C0                             ; 偽 → ジャンプする
13C0   EB                     XCHG      ; HL = オフセット
13C1   CD 7A 13               CALL   apply_jump   
13C4   C3 1B 1C               JMP   vm_loop   
13C7                JMPNOT_SKIP:      
13C7   C3 1B 1C               JMP   vm_loop   
13CA                             ; vm_globals.a80 — グローバル変数・インスタンス変数アクセス
13CA                             ; 
13CA                             ; OP_GETGV, OP_SETGV, OP_GETIV, OP_SETIV
13CA                             ; 
13CA                             ; シンボルテーブル (SYM_TABLE_BASE) の 2 バイトエントリ (D,E) で振り分ける:
13CA                             ;   D >= 0x80      : グローバル変数アドレス (DE = アドレス)
13CA                             ;   D == 0x03      : インスタンス変数 (E = ivar_index)
13CA                             ;   D == 0, E == 0 : 未対応シンボル → エラー
13CA                             ; 
13CA                             ; グローバルスロット (GLOBALS_BASE, 0xB000):
13CA                             ;   レジスタと同じ 4 バイト形式 (型タグ + 予約 + val_lo + val_hi)
13CA                             ; 
13CA                             ; ---------------------------------------------------------------
13CA                             ; OP_GETGV / OP_GETIV (BB): R[a] = global[symbols[b]]
13CA                             ; ---------------------------------------------------------------
13CA                DO_OP_GETGV:      
13CA   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
13CD   F5                     PUSH   psw   
13CE   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
13D1                             ; シンボルテーブルからエントリを取得
13D1   87                     ADD   a   ; A = b * 2
13D2   5F                     MOV   e,a   
13D3   16 00                  MVI   d,0   
13D5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
13D8   19                     DAD   d   ; HL = &sym_table[b]
13D9   5E                     MOV   e,m   
13DA   23                     INX   h   
13DB   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
13DC                             ; 
13DC                             ; D == SYM_KIND_IVAR → インスタンス変数
13DC   7A                     MOV   a,d   
13DD   FE 03                  CPI   SYM_KIND_IVAR   
13DF   CA F8 13               JZ   getiv_handler   
13E2                             ; 
13E2                             ; アドレスが 0 なら未対応シンボル
13E2   7A                     MOV   a,d   
13E3   B3                     ORA   e   
13E4   C2 EB 13               JNZ   getgv_ok   
13E7   F1                     POP   psw   
13E8   C3 03 00               JMP   vm_error   
13EB                GETGV_OK:      
13EB   F1                     POP   psw   ; A = a
13EC   D5                     PUSH   d   ; グローバルアドレスを退避
13ED   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
13F0   EB                     XCHG      ; DE = R[a]
13F1   E1                     POP   h   ; HL = グローバルスロット (コピー元)
13F2   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
13F5   C3 1B 1C               JMP   vm_loop   
13F8                             ; 
13F8                             ; --- IVAR GET ---
13F8                             ; E = ivar_index, スタックに a が積まれている
13F8                GETIV_HANDLER:      
13F8   7B                     MOV   a,e   
13F9   32 6C 14               STA   gv_ivar_idx   
13FC   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
13FF   F1                     POP   psw   ; A = a
1400   E5                     PUSH   h   ; IVAR アドレスを退避
1401   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1404   EB                     XCHG      ; DE = R[a]
1405   E1                     POP   h   ; HL = IVAR スロット (コピー元)
1406   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1409   C3 1B 1C               JMP   vm_loop   
140C                             ; 
140C                             ; ---------------------------------------------------------------
140C                             ; OP_SETGV / OP_SETIV (BB): global[symbols[b]] = R[a]
140C                             ; ---------------------------------------------------------------
140C                DO_OP_SETGV:      
140C   CD C0 10               CALL   fetch_byte   ; A = a (レジスタ番号)
140F   F5                     PUSH   psw   
1410   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1413   87                     ADD   a   
1414   5F                     MOV   e,a   
1415   16 00                  MVI   d,0   
1417   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
141A   19                     DAD   d   ; HL = &sym_table[b]
141B   5E                     MOV   e,m   
141C   23                     INX   h   
141D   56                     MOV   d,m   ; DE = エントリ値
141E                             ; 
141E                             ; D == SYM_KIND_IVAR → インスタンス変数
141E   7A                     MOV   a,d   
141F   FE 03                  CPI   SYM_KIND_IVAR   
1421   CA 37 14               JZ   setiv_handler   
1424                             ; 
1424   7A                     MOV   a,d   
1425   B3                     ORA   e   
1426   C2 2D 14               JNZ   setgv_ok   
1429   F1                     POP   psw   
142A   C3 03 00               JMP   vm_error   
142D                SETGV_OK:      
142D   F1                     POP   psw   ; A = a
142E   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1431                             ; copy_slot: [HL] → [DE]
1431   CD 25 10               CALL   copy_slot   
1434   C3 1B 1C               JMP   vm_loop   
1437                             ; 
1437                             ; --- IVAR SET ---
1437                             ; E = ivar_index, スタックに a が積まれている
1437                SETIV_HANDLER:      
1437   7B                     MOV   a,e   
1438   32 6C 14               STA   gv_ivar_idx   
143B   CD 49 14               CALL   calc_ivar_addr   ; HL = IVAR スロットアドレス
143E   EB                     XCHG      ; DE = IVAR スロット (コピー先)
143F   F1                     POP   psw   ; A = a
1440   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1443   CD 25 10               CALL   copy_slot   ; [HL] → [DE]
1446   C3 1B 1C               JMP   vm_loop   
1449                             ; 
1449                             ; ---------------------------------------------------------------
1449                             ; calc_ivar_addr — R[0] (self) から IVAR スロットアドレスを算出
1449                             ; 
1449                             ;   入力: gv_ivar_idx = ivar_index
1449                             ;   出力: HL = OBJECT_POOL_BASE + (val_lo-1)*32 + 4 + ivar_index*4
1449                             ;   破壊: A, B, DE
1449                             ; 
1449                             ; R[0].val_lo = slot+1 (TT_OBJECT)
1449                             ; ---------------------------------------------------------------
1449                CALC_IVAR_ADDR:      
1449                             ; R[0] の val_lo を読む
1449   3E 00                  MVI   a,0   
144B   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
144E   23                     INX   h   
144F   23                     INX   h   
1450   7E                     MOV   a,m   ; A = val_lo (slot+1)
1451   3D                     DCR   a   ; A = slot
1452                             ; slot * 32
1452   87                     ADD   a   ; ×2
1453   87                     ADD   a   ; ×4
1454   87                     ADD   a   ; ×8
1455   87                     ADD   a   ; ×16
1456   87                     ADD   a   ; ×32
1457   5F                     MOV   e,a   
1458   16 00                  MVI   d,0   
145A   21 C0 92               LXI   h,OBJECT_POOL_BASE   
145D   19                     DAD   d   ; HL = スロット先頭
145E                             ; + OBJECT_HEADER_SIZE (4)
145E   11 04 00               LXI   d,OBJECT_HEADER_SIZE   
1461   19                     DAD   d   
1462                             ; + ivar_index * 4
1462   3A 6C 14               LDA   gv_ivar_idx   
1465   87                     ADD   a   ; ×2
1466   87                     ADD   a   ; ×4
1467   5F                     MOV   e,a   
1468   16 00                  MVI   d,0   
146A   19                     DAD   d   ; HL = IVAR スロットアドレス
146B   C9                     RET      
146C                             ; 
146C   00           GV_IVAR_IDX:   DB   0   
146D                             ; vm_send.a80 — メソッド呼び出し
146D                             ; 
146D                             ; OP_SEND, OP_SSEND
146D                             ; 
146D                             ; シンボルテーブルの 2 バイトエントリで振り分ける:
146D                             ;   D=0x00, E=1-31 : 組み込みメソッド
146D                             ;   D=0x01, E=id   : ユーザー定義メソッド
146D                             ;   D>=0x80         : グローバルアドレス (メソッドではない → エラー)
146D                             ; 
146D                             ; ---------------------------------------------------------------
146D                             ; OP_SSEND (BBB): self をレシーバに置いて SEND
146D                             ; 
146D                             ; R[a] = R[0] (self) を設定してから OP_SEND と同じ処理を行う。
146D                             ; ---------------------------------------------------------------
146D                DO_OP_SSEND:      
146D   CD C0 10               CALL   fetch_byte   ; A = a
1470   F5                     PUSH   psw   
1471   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
1474   EB                     XCHG      ; DE = R[a]
1475   AF                     XRA   a   ; A = 0
1476   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (self)
1479   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
147C   F1                     POP   psw   ; A = a
147D   32 55 16               STA   send_reg_a   
1480   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1483   F5                     PUSH   psw   
1484   CD C0 10               CALL   fetch_byte   ; A = c (argc)
1487   32 56 16               STA   send_argc   
148A   F1                     POP   psw   ; A = b
148B   C3 9F 14               JMP   send_dispatch   
148E                             ; 
148E                             ; ---------------------------------------------------------------
148E                             ; OP_SEND (BBB): R[a] = R[a].method(R[a+1], ...)
148E                             ; ---------------------------------------------------------------
148E                DO_OP_SEND:      
148E   CD C0 10               CALL   fetch_byte   ; A = a
1491   32 55 16               STA   send_reg_a   
1494   CD C0 10               CALL   fetch_byte   ; A = b (シンボル)
1497   F5                     PUSH   psw   
1498   CD C0 10               CALL   fetch_byte   ; A = c (argc)
149B   32 56 16               STA   send_argc   
149E   F1                     POP   psw   ; A = b
149F                             ; 
149F                SEND_DISPATCH:      
149F                             ; シンボルテーブルからメソッド ID を取得
149F   87                     ADD   a   ; b * 2
14A0   5F                     MOV   e,a   
14A1   16 00                  MVI   d,0   
14A3   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
14A6   19                     DAD   d   
14A7   5E                     MOV   e,m   
14A8   23                     INX   h   
14A9   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=id)
14AA                             ; 
14AA                             ; D で振り分け
14AA   7A                     MOV   a,d   
14AB   B7                     ORA   a   
14AC   CA B7 14               JZ   send_builtin   ; D=0x00 → 組み込みメソッド
14AF   FE 01                  CPI   SYM_KIND_USER_METHOD   
14B1   CA E2 14               JZ   send_user_method   ; D=0x01 → ユーザー定義メソッド
14B4                             ; D >= 0x80 or other → エラー
14B4   C3 03 00               JMP   vm_error   
14B7                             ; 
14B7                SEND_BUILTIN:      
14B7                             ; E = メソッド ID (0 = 未対応)
14B7   7B                     MOV   a,e   
14B8   B7                     ORA   a   
14B9   CA 03 00               JZ   vm_error   
14BC                             ; 組み込みメソッドディスパッチ
14BC   FE 01                  CPI   1   
14BE   CA B0 15               JZ   send_ne   ; != (不等号)
14C1   FE 02                  CPI   2   
14C3   CA E5 15               JZ   send_not   ; !  (論理否定)
14C6   FE 03                  CPI   3   
14C8   CA 0D 16               JZ   send_mod   ; %  (剰余)
14CB   FE 04                  CPI   4   
14CD   CA 38 16               JZ   send_abs   ; abs (絶対値)
14D0   FE 1C                  CPI   METHOD_NEW   
14D2   CA 25 15               JZ   send_new   ; Class#new
14D5   FE 1D                  CPI   METHOD_DISPLAY   
14D7   CA 28 1E               JZ   send_display   ; display(value)
14DA   FE 1E                  CPI   METHOD_GETKEY   
14DC   CA 43 1E               JZ   send_getkey   ; getkey
14DF   C3 7E 1E               JMP   send_builtin_ext   ; 拡張ビルトイン (0xA800+ 領域)
14E2                             ; 
14E2                             ; ---------------------------------------------------------------
14E2                             ; send_user_method — ユーザー定義メソッド呼び出し
14E2                             ; 
14E2                             ; E = method_id。メソッド表から irep 番号を引き、
14E2                             ; push_frame + switch_irep で呼び出す。
14E2                             ; ---------------------------------------------------------------
14E2                SEND_USER_METHOD:      
14E2                             ; method_id を退避
14E2   7B                     MOV   a,e   
14E3   32 23 15               STA   sum_method_id   
14E6                             ; 
14E6                             ; R[a] から class_number を取得
14E6   3A 55 16               LDA   send_reg_a   
14E9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
14EC   CD 9B 10               CALL   class_of_reg   ; A = class_number
14EF                             ; 
14EF                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
14EF   87                     ADD   a   ; ×2
14F0   87                     ADD   a   ; ×4
14F1   87                     ADD   a   ; ×8
14F2   87                     ADD   a   ; ×16
14F3   87                     ADD   a   ; ×32
14F4   5F                     MOV   e,a   
14F5   16 00                  MVI   d,0   
14F7   21 C0 91               LXI   h,METHOD_TABLE_BASE   
14FA   19                     DAD   d   
14FB   3A 23 15               LDA   sum_method_id   
14FE   5F                     MOV   e,a   
14FF   16 00                  MVI   d,0   
1501   19                     DAD   d   ; HL = メソッド表エントリ
1502   7E                     MOV   a,m   ; A = irep 番号
1503   B7                     ORA   a   
1504   CA 03 00               JZ   vm_error   ; 0 = 未定義
1507   32 24 15               STA   sum_irep   
150A                             ; 
150A                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
150A   3A 55 16               LDA   send_reg_a   
150D   06 00                  MVI   b,FRAME_KIND_CALL   
150F   0E FF                  MVI   c,FRAME_NONE   
1511   CD A4 16               CALL   push_frame   
1514                             ; 
1514                             ; 子 irep に切り替え
1514   3A 24 15               LDA   sum_irep   
1517   CD 29 17               CALL   switch_irep   
151A                             ; 
151A                             ; PC = 0
151A   21 00 00               LXI   h,0   
151D   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1520   C3 1B 1C               JMP   vm_loop   
1523                             ; 
1523   00           SUM_METHOD_ID:   DB   0   
1524   00           SUM_IREP:   DB   0   
1525                             ; 
1525                             ; ---------------------------------------------------------------
1525                             ; send_new — Class#new (オブジェクト生成)
1525                             ; 
1525                             ; 1. オブジェクトプールにスロットを確保
1525                             ; 2. R[a] を TT_OBJECT に設定 (val_lo = slot+1)
1525                             ; 3. initialize メソッドがあれば呼び出す
1525                             ; ---------------------------------------------------------------
1525                SEND_NEW:      
1525                             ; OBJ_SP < MAX_OBJECTS を確認
1525   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1528   FE 20                  CPI   MAX_OBJECTS   
152A   D2 03 00               JNC   vm_error   ; オブジェクトプール満杯
152D                             ; 
152D                             ; R[a] (TT_CLASS) から class_number を取得
152D   32 AC 15               STA   sn_slot   ; OBJ_SP = slot 番号
1530   3A 55 16               LDA   send_reg_a   
1533   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1536   CD 32 10               CALL   slot_to_value   
1539   7E                     MOV   a,m   ; A = class_number
153A   32 AD 15               STA   sn_class_num   
153D                             ; 
153D                             ; オブジェクトプールにヘッダを書く
153D                             ; OBJECT_POOL_BASE + slot * 32
153D   3A AC 15               LDA   sn_slot   
1540   87                     ADD   a   ; ×2
1541   87                     ADD   a   ; ×4
1542   87                     ADD   a   ; ×8
1543   87                     ADD   a   ; ×16
1544   87                     ADD   a   ; ×32
1545   5F                     MOV   e,a   
1546   16 00                  MVI   d,0   
1548   21 C0 92               LXI   h,OBJECT_POOL_BASE   
154B   19                     DAD   d   ; HL = スロット先頭
154C   3A AD 15               LDA   sn_class_num   
154F   77                     MOV   m,a   ; +0: class_number
1550                             ; 
1550                             ; R[a] = TT_OBJECT, val_lo = slot+1
1550   3A 55 16               LDA   send_reg_a   
1553   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1556   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1558   23                     INX   h   
1559   36 00                  MVI   m,0   ; +1: 予約
155B   23                     INX   h   
155C   3A AC 15               LDA   sn_slot   
155F   3C                     INR   a   ; slot + 1
1560   77                     MOV   m,a   ; +2: val_lo
1561   23                     INX   h   
1562   36 00                  MVI   m,0   ; +3: val_hi = 0
1564                             ; 
1564                             ; OBJ_SP++
1564   3A 1B 80               LDA   VM_STATE_BASE + OFF_OBJ_SP   
1567   3C                     INR   a   
1568   32 1B 80               STA   VM_STATE_BASE + OFF_OBJ_SP   
156B                             ; 
156B                             ; initialize メソッドがあれば呼び出す
156B   3A 1C 80               LDA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
156E   B7                     ORA   a   
156F   CA 1B 1C               JZ   vm_loop   ; INIT_METHOD_ID=0 → initialize なし
1572                             ; 
1572                             ; method_table[class * 32 + init_id] を引く
1572   32 AE 15               STA   sn_init_id   
1575   3A AD 15               LDA   sn_class_num   
1578   87                     ADD   a   
1579   87                     ADD   a   
157A   87                     ADD   a   
157B   87                     ADD   a   
157C   87                     ADD   a   ; class * 32
157D   5F                     MOV   e,a   
157E   16 00                  MVI   d,0   
1580   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1583   19                     DAD   d   
1584   3A AE 15               LDA   sn_init_id   
1587   5F                     MOV   e,a   
1588   16 00                  MVI   d,0   
158A   19                     DAD   d   ; HL = メソッド表エントリ
158B   7E                     MOV   a,m   ; A = irep 番号
158C   B7                     ORA   a   
158D   CA 1B 1C               JZ   vm_loop   ; 未定義 → 呼ばない
1590   32 AF 15               STA   sn_init_irep   
1593                             ; 
1593                             ; push_frame(a, FRAME_KIND_NEW, FRAME_NONE)
1593   3A 55 16               LDA   send_reg_a   
1596   06 05                  MVI   b,FRAME_KIND_NEW   
1598   0E FF                  MVI   c,FRAME_NONE   
159A   CD A4 16               CALL   push_frame   
159D                             ; 
159D                             ; 子 irep に切り替え
159D   3A AF 15               LDA   sn_init_irep   
15A0   CD 29 17               CALL   switch_irep   
15A3                             ; 
15A3                             ; PC = 0
15A3   21 00 00               LXI   h,0   
15A6   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
15A9   C3 1B 1C               JMP   vm_loop   
15AC                             ; 
15AC   00           SN_SLOT:   DB   0   
15AD   00           SN_CLASS_NUM:   DB   0   
15AE   00           SN_INIT_ID:   DB   0   
15AF   00           SN_INIT_IREP:   DB   0   
15B0                             ; 
15B0                             ; ---------------------------------------------------------------
15B0                             ; != (不等号): R[a] = (R[a] != R[a+1]) ? true : false
15B0                             ; 
15B0                             ; スロット全体 (4 バイト) をバイト比較する。
15B0                             ; 型タグも含めて比較するので異なる型は常に true。
15B0                             ; ---------------------------------------------------------------
15B0                SEND_NE:      
15B0   3A 55 16               LDA   send_reg_a   
15B3   F5                     PUSH   psw   
15B4   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
15B7   EB                     XCHG      ; DE = R[a+1]
15B8   F1                     POP   psw   
15B9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15BC   0E 04                  MVI   c,SLOT_BYTES   
15BE                SEND_NE_CMP:      
15BE   1A                     LDAX   d   
15BF   BE                     CMP   m   
15C0   C2 D7 15               JNZ   send_ne_diff   
15C3   23                     INX   h   
15C4   13                     INX   d   
15C5   0D                     DCR   c   
15C6   C2 BE 15               JNZ   send_ne_cmp   
15C9                             ; 全バイト一致 → 等しい → false
15C9   3A 55 16               LDA   send_reg_a   
15CC   CD 00 10               CALL   get_reg_addr   
15CF   3E 02                  MVI   a,TT_FALSE   
15D1   CD 1A 10               CALL   set_slot_special   
15D4   C3 1B 1C               JMP   vm_loop   
15D7                SEND_NE_DIFF:      
15D7   3A 55 16               LDA   send_reg_a   
15DA   CD 00 10               CALL   get_reg_addr   
15DD   3E 03                  MVI   a,TT_TRUE   
15DF   CD 1A 10               CALL   set_slot_special   
15E2   C3 1B 1C               JMP   vm_loop   
15E5                             ; 
15E5                             ; ---------------------------------------------------------------
15E5                             ; ! (論理否定): R[a] = falsy(R[a]) ? true : false
15E5                             ; 
15E5                             ; TT_FALSY_MAX (02h) 以下が偽 (TT_EMPTY, TT_NIL, TT_FALSE)。
15E5                             ; ---------------------------------------------------------------
15E5                SEND_NOT:      
15E5   3A 55 16               LDA   send_reg_a   
15E8   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
15EB   7E                     MOV   a,m   ; A = 型タグ
15EC   FE 03                  CPI   TT_FALSY_MAX + 1   ; A < 3 なら偽
15EE   DA FF 15               JC   send_not_falsy   
15F1                             ; 真だった → false
15F1   3A 55 16               LDA   send_reg_a   
15F4   CD 00 10               CALL   get_reg_addr   
15F7   3E 02                  MVI   a,TT_FALSE   
15F9   CD 1A 10               CALL   set_slot_special   
15FC   C3 1B 1C               JMP   vm_loop   
15FF                SEND_NOT_FALSY:      
15FF                             ; 偽だった → true
15FF   3A 55 16               LDA   send_reg_a   
1602   CD 00 10               CALL   get_reg_addr   
1605   3E 03                  MVI   a,TT_TRUE   
1607   CD 1A 10               CALL   set_slot_special   
160A   C3 1B 1C               JMP   vm_loop   
160D                             ; 
160D                             ; ---------------------------------------------------------------
160D                             ; % (剰余, Ruby floor modulo): R[a] = R[a] % R[a+1]
160D                             ; ---------------------------------------------------------------
160D                SEND_MOD:      
160D   3A 55 16               LDA   send_reg_a   
1610   F5                     PUSH   psw   
1611   CD 0C 10               CALL   get_reg_addr_next   
1614   CD 32 10               CALL   slot_to_value   
1617   5E                     MOV   e,m   
1618   23                     INX   h   
1619   56                     MOV   d,m   ; DE = 除数
161A   7A                     MOV   a,d   
161B   B3                     ORA   e   
161C   C2 23 16               JNZ   send_mod_ok   
161F   F1                     POP   psw   
1620   C3 03 00               JMP   vm_error   ; ゼロ除算
1623                SEND_MOD_OK:      
1623   F1                     POP   psw   
1624   CD 00 10               CALL   get_reg_addr   
1627   CD 32 10               CALL   slot_to_value   
162A   E5                     PUSH   h   ; 書き戻し先
162B   4E                     MOV   c,m   
162C   23                     INX   h   
162D   46                     MOV   b,m   ; BC = 被除数
162E   CD 57 16               CALL   smod16   ; BC = 剰余 (除数と同符号)
1631   E1                     POP   h   
1632   71                     MOV   m,c   
1633   23                     INX   h   
1634   70                     MOV   m,b   
1635   C3 1B 1C               JMP   vm_loop   
1638                             ; 
1638                             ; ---------------------------------------------------------------
1638                             ; abs (絶対値): R[a] = |R[a]|
1638                             ; ---------------------------------------------------------------
1638                SEND_ABS:      
1638   3A 55 16               LDA   send_reg_a   
163B   CD 00 10               CALL   get_reg_addr   
163E   CD 32 10               CALL   slot_to_value   ; HL = 値の先頭
1641   23                     INX   h   ; HL → val_hi
1642   7E                     MOV   a,m   
1643   E6 80                  ANI   80h   
1645   CA 1B 1C               JZ   vm_loop   ; 正ならそのまま
1648   2B                     DCX   h   ; HL → val_lo
1649   4E                     MOV   c,m   
164A   23                     INX   h   
164B   46                     MOV   b,m   ; BC = 値
164C   CD DC 12               CALL   neg_bc   
164F   70                     MOV   m,b   ; val_hi
1650   2B                     DCX   h   
1651   71                     MOV   m,c   ; val_lo
1652   C3 1B 1C               JMP   vm_loop   
1655                             ; 
1655                             ; --- 一時変数 ---
1655                SEND_REG_A:      
1655   00                     DB   0   
1656                SEND_ARGC:      
1656   00                     DB   0   
1657                             ; 
1657                             ; ---------------------------------------------------------------
1657                             ; smod16 — 16 ビット符号付き剰余 (Ruby floor modulo)
1657                             ; 
1657                             ;   入力: BC = 被除数, DE = 除数 (≠ 0)
1657                             ;   出力: BC = 剰余 (除数と同符号)
1657                             ;   破壊: A, DE, HL
1657                             ; 
1657                             ; |被除数| mod |除数| を求めたあと、符号と floor 調整を行う。
1657                             ; ---------------------------------------------------------------
1657                SMOD16:      
1657                             ; 除数の符号を保存
1657   7A                     MOV   a,d   
1658   F5                     PUSH   psw   
1659                             ; 符号の差を保存 (bit7: 異符号なら 1)
1659   78                     MOV   a,b   
165A   AA                     XRA   d   
165B   F5                     PUSH   psw   
165C                             ; 被除数を正にする
165C   78                     MOV   a,b   
165D   E6 80                  ANI   80h   
165F   CA 65 16               JZ   smod_chk_div   
1662   CD DC 12               CALL   neg_bc   
1665                SMOD_CHK_DIV:      
1665   7A                     MOV   a,d   
1666   E6 80                  ANI   80h   
1668   CA 6E 16               JZ   smod_do   
166B   CD E4 12               CALL   neg_de   
166E                SMOD_DO:      
166E   D5                     PUSH   d   ; |除数| を退避
166F   CD A5 12               CALL   udiv16   ; BC = 商, HL = 剰余
1672   44                     MOV   b,h   
1673   4D                     MOV   c,l   ; BC = |剰余|
1674   78                     MOV   a,b   
1675   B1                     ORA   c   
1676   D1                     POP   d   ; DE = |除数|
1677   F1                     POP   psw   ; 符号差 (bit7)
1678   CA 8D 16               JZ   smod_zero   ; 剰余 = 0
167B   E6 80                  ANI   80h   
167D   CA 86 16               JZ   smod_sign   ; 同符号 → 大きさはそのまま
1680                             ; 異符号: 大きさ = |除数| - |剰余|
1680   7B                     MOV   a,e   
1681   91                     SUB   c   
1682   4F                     MOV   c,a   
1683   7A                     MOV   a,d   
1684   98                     SBB   b   
1685   47                     MOV   b,a   
1686                SMOD_SIGN:      
1686   F1                     POP   psw   ; 除数の符号 (bit7)
1687   E6 80                  ANI   80h   
1689   C8                     RZ      ; 除数が正 → 正の剰余
168A   C3 DC 12               JMP   neg_bc   ; 除数が負 → 負にする
168D                SMOD_ZERO:      
168D   F1                     POP   psw   ; 除数の符号を捨てる
168E   C9                     RET      
168F                             ; vm_frame.a80 — フレームスタック管理
168F                             ; 
168F                             ; ブロック呼び出し (times, loop) のフレームを管理するサブルーチン群。
168F                             ; 
168F                             ;   push_frame   : 現在の状態をフレームに保存して frame_sp++
168F                             ;   pop_frame    : frame_sp-- して保存した状態を復帰
168F                             ;   switch_irep  : IREP テーブルから BC_BASE, BC_LEN, NREGS をロード
168F                             ;   get_frame_addr : フレーム番号 → メモリアドレス
168F                             ;   cur_frame_addr : 現在のフレーム (frame_sp - 1) のアドレス
168F                             ; 
168F                             ; ---------------------------------------------------------------
168F                             ; get_frame_addr — フレーム番号 → アドレス
168F                             ; 
168F                             ;   入力: A = フレーム番号 (0-7)
168F                             ;   出力: HL = FRAME_STACK_BASE + A * 12
168F                             ;   破壊: A, B, DE
168F                             ; ---------------------------------------------------------------
168F                GET_FRAME_ADDR:      
168F   4F                     MOV   c,a   ; C = 元の値 (退避)
1690   87                     ADD   a   ; ×2
1691   47                     MOV   b,a   ; B = ×2
1692   87                     ADD   a   ; ×4
1693   80                     ADD   b   ; ×4 + ×2 = ×6
1694   87                     ADD   a   ; ×12
1695   5F                     MOV   e,a   
1696   16 00                  MVI   d,0   ; DE = frame * 12
1698   21 00 91               LXI   h,FRAME_STACK_BASE   
169B   19                     DAD   d   ; HL = FRAME_STACK_BASE + frame * 12
169C   C9                     RET      
169D                             ; 
169D                             ; ---------------------------------------------------------------
169D                             ; cur_frame_addr — 現在のフレーム (frame_sp - 1) のアドレス
169D                             ; 
169D                             ;   入力: なし
169D                             ;   出力: HL = 現在のフレームのアドレス
169D                             ;   破壊: A, B, C, DE
169D                             ; ---------------------------------------------------------------
169D                CUR_FRAME_ADDR:      
169D   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16A0   3D                     DCR   a   
16A1   C3 8F 16               JMP   get_frame_addr   
16A4                             ; 
16A4                             ; ---------------------------------------------------------------
16A4                             ; push_frame — 現在の状態をフレームに保存
16A4                             ; 
16A4                             ;   入力: A = レシーバのレジスタ番号 (reg_base の shift に使う)
16A4                             ;          B = フレーム種別 (FRAME_KIND_*)
16A4                             ;          C = 外側フレーム番号 (FRAME_NONE = トップレベル)
16A4                             ;   出力: なし
16A4                             ;   破壊: A, B, C, HL, DE
16A4                             ; 
16A4                             ; frame_sp のスロットに保存して frame_sp++。
16A4                             ; reg_base を A*4 だけ進める (レジスタウィンドウのシフト)。
16A4                             ; ---------------------------------------------------------------
16A4                PUSH_FRAME:      
16A4                             ; パラメータを退避
16A4   32 FC 16               STA   pf_shift_reg   
16A7   78                     MOV   a,b   
16A8   32 FD 16               STA   pf_kind   
16AB   79                     MOV   a,c   
16AC   32 FE 16               STA   pf_outer   
16AF                             ; 
16AF                             ; HL = frame[frame_sp]
16AF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16B2   CD 8F 16               CALL   get_frame_addr   
16B5                             ; 
16B5                             ; +0,+1: return_pc
16B5   3A 00 80               LDA   VM_STATE_BASE + OFF_PC   
16B8   77                     MOV   m,a   
16B9   23                     INX   h   
16BA   3A 01 80               LDA   VM_STATE_BASE + OFF_PC + 1   
16BD   77                     MOV   m,a   
16BE   23                     INX   h   
16BF                             ; 
16BF                             ; +2: return_irep
16BF   3A 11 80               LDA   VM_STATE_BASE + OFF_CUR_IREP   
16C2   77                     MOV   m,a   
16C3   23                     INX   h   
16C4                             ; 
16C4                             ; +3,+4: return_reg_base
16C4   3A 14 80               LDA   VM_STATE_BASE + OFF_REG_BASE   
16C7   77                     MOV   m,a   
16C8   23                     INX   h   
16C9   3A 15 80               LDA   VM_STATE_BASE + OFF_REG_BASE + 1   
16CC   77                     MOV   m,a   
16CD   23                     INX   h   
16CE                             ; 
16CE                             ; +5: kind
16CE   3A FD 16               LDA   pf_kind   
16D1   77                     MOV   m,a   
16D2   23                     INX   h   
16D3                             ; 
16D3                             ; +6,+7: index = 0
16D3   36 00                  MVI   m,0   
16D5   23                     INX   h   
16D6   36 00                  MVI   m,0   
16D8   23                     INX   h   
16D9                             ; 
16D9                             ; +8,+9: limit = 0
16D9   36 00                  MVI   m,0   
16DB   23                     INX   h   
16DC   36 00                  MVI   m,0   
16DE   23                     INX   h   
16DF                             ; 
16DF                             ; +10: outer
16DF   3A FE 16               LDA   pf_outer   
16E2   77                     MOV   m,a   
16E3                             ; 
16E3                             ; reg_base += shift_reg * 4
16E3   3A FC 16               LDA   pf_shift_reg   
16E6   87                     ADD   a   ; ×2
16E7   87                     ADD   a   ; ×4
16E8   2A 14 80               LHLD   VM_STATE_BASE + OFF_REG_BASE   
16EB   85                     ADD   l   
16EC   6F                     MOV   l,a   
16ED   3E 00                  MVI   a,0   
16EF   8C                     ADC   h   
16F0   67                     MOV   h,a   
16F1   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
16F4                             ; 
16F4                             ; frame_sp++
16F4   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
16F7   3C                     INR   a   
16F8   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
16FB   C9                     RET      
16FC                             ; 
16FC                             ; push_frame の一時変数
16FC   00           PF_SHIFT_REG:   DB   0   
16FD   00           PF_KIND:   DB   0   
16FE   00           PF_OUTER:   DB   0   
16FF                             ; 
16FF                             ; ---------------------------------------------------------------
16FF                             ; pop_frame — frame_sp-- して保存した状態を復帰
16FF                             ; 
16FF                             ;   入力: なし
16FF                             ;   出力: なし
16FF                             ;   破壊: A, B, C, HL, DE
16FF                             ; 
16FF                             ; PC, reg_base を復帰し、return_irep で switch_irep を呼ぶ。
16FF                             ; ---------------------------------------------------------------
16FF                POP_FRAME:      
16FF                             ; frame_sp--
16FF   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1702   3D                     DCR   a   
1703   32 18 80               STA   VM_STATE_BASE + OFF_FRAME_SP   
1706                             ; 
1706                             ; HL = frame[frame_sp] (decremented value)
1706   CD 8F 16               CALL   get_frame_addr   
1709                             ; 
1709                             ; +0,+1: restore return_pc
1709   7E                     MOV   a,m   
170A   32 00 80               STA   VM_STATE_BASE + OFF_PC   
170D   23                     INX   h   
170E   7E                     MOV   a,m   
170F   32 01 80               STA   VM_STATE_BASE + OFF_PC + 1   
1712   23                     INX   h   
1713                             ; 
1713                             ; +2: return_irep → switch_irep 用に退避
1713   7E                     MOV   a,m   
1714   32 28 17               STA   popf_ret_irep   
1717   23                     INX   h   
1718                             ; 
1718                             ; +3,+4: restore return_reg_base
1718   7E                     MOV   a,m   
1719   32 14 80               STA   VM_STATE_BASE + OFF_REG_BASE   
171C   23                     INX   h   
171D   7E                     MOV   a,m   
171E   32 15 80               STA   VM_STATE_BASE + OFF_REG_BASE + 1   
1721                             ; 
1721                             ; switch_irep で BC_BASE, BC_LEN, NREGS を復帰
1721   3A 28 17               LDA   popf_ret_irep   
1724   CD 29 17               CALL   switch_irep   
1727   C9                     RET      
1728                             ; 
1728   00           POPF_RET_IREP:   DB   0   
1729                             ; 
1729                             ; ---------------------------------------------------------------
1729                             ; switch_irep — IREP テーブルから実行情報をロード
1729                             ; 
1729                             ;   入力: A = IREP 番号
1729                             ;   出力: なし
1729                             ;   破壊: A, B, C, HL, DE
1729                             ; 
1729                             ; CUR_IREP, BC_BASE, BC_LEN, NREGS を IREP テーブルから設定する。
1729                             ; ---------------------------------------------------------------
1729                SWITCH_IREP:      
1729   32 11 80               STA   VM_STATE_BASE + OFF_CUR_IREP   
172C                             ; 
172C                             ; IREP テーブルエントリのアドレス: IREP_TABLE_BASE + A * 10
172C                             ; A * 10 = A * 8 + A * 2
172C   4F                     MOV   c,a   ; C = A (退避)
172D   87                     ADD   a   ; ×2
172E   47                     MOV   b,a   ; B = A*2
172F   79                     MOV   a,c   
1730   87                     ADD   a   ; ×2
1731   87                     ADD   a   ; ×4
1732   87                     ADD   a   ; ×8
1733   80                     ADD   b   ; A*8 + A*2 = A*10
1734   5F                     MOV   e,a   
1735   16 00                  MVI   d,0   
1737   21 00 82               LXI   h,IREP_TABLE_BASE   
173A   19                     DAD   d   ; HL = エントリアドレス
173B                             ; 
173B                             ; +0,+1: bytecode base → BC_BASE
173B   7E                     MOV   a,m   
173C   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
173F   23                     INX   h   
1740   7E                     MOV   a,m   
1741   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1744   23                     INX   h   
1745                             ; 
1745                             ; +2,+3: bytecode len → BC_LEN
1745   7E                     MOV   a,m   
1746   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1749   23                     INX   h   
174A   7E                     MOV   a,m   
174B   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
174E   23                     INX   h   
174F                             ; 
174F                             ; +4,+5: pool base → POOL_BASE
174F   7E                     MOV   a,m   
1750   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1753   23                     INX   h   
1754   7E                     MOV   a,m   
1755   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1758   23                     INX   h   
1759                             ; 
1759                             ; +6: nregs
1759   7E                     MOV   a,m   
175A   32 10 80               STA   VM_STATE_BASE + OFF_NREGS   
175D                             ; 
175D                             ; +7: subtree_size (スキップ)
175D   23                     INX   h   
175E                             ; 
175E                             ; +8,+9: sym_table_base → SYM_BASE
175E   23                     INX   h   
175F   7E                     MOV   a,m   
1760   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1763   23                     INX   h   
1764   7E                     MOV   a,m   
1765   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1768                             ; 
1768   C9                     RET      
1769                             ; vm_block.a80 — ブロック関連オペコード
1769                             ; 
1769                             ; OP_LOADSELF, OP_BLOCK, OP_ENTER, OP_SENDB, OP_SSENDB, OP_BREAK
1769                             ; 
1769                             ; ---------------------------------------------------------------
1769                             ; OP_LOADSELF (B): R[a] = self (TT_OBJECT, 値 = 0)
1769                             ; ---------------------------------------------------------------
1769                DO_OP_LOADSELF:      
1769   CD C0 10               CALL   fetch_byte   ; A = a
176C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
176F   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1771   23                     INX   h   
1772   36 00                  MVI   m,0   ; +1: 予約
1774   23                     INX   h   
1775   36 00                  MVI   m,0   ; +2: val_lo = 0
1777   23                     INX   h   
1778   36 00                  MVI   m,0   ; +3: val_hi = 0
177A   C3 1B 1C               JMP   vm_loop   
177D                             ; 
177D                             ; ---------------------------------------------------------------
177D                             ; OP_BLOCK (BB): R[a] = Proc(irep=child_irep(b), outer=frame_sp)
177D                             ; 
177D                             ; ブロックを TT_PROC としてレジスタに格納する。
177D                             ;   値の下位バイト = 子 irep 番号
177D                             ;   値の上位バイト = 外側フレーム番号 (現在の frame_sp)
177D                             ; ---------------------------------------------------------------
177D                DO_OP_BLOCK:      
177D   CD C0 10               CALL   fetch_byte   ; A = a
1780   32 A9 17               STA   blk_reg_a   
1783   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1786                             ; 
1786                             ; 子 irep 番号を算出 (共通サブルーチン)
1786   CD 77 10               CALL   calc_child_irep   ; A = child irep 番号
1789                             ; 
1789                             ; R[a] に TT_PROC を書く
1789   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
178A   3A A9 17               LDA   blk_reg_a   
178D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1790   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
1792   23                     INX   h   
1793   36 00                  MVI   m,0   ; +1: 予約
1795   23                     INX   h   
1796   71                     MOV   m,c   ; +2: val_lo = irep 番号
1797   23                     INX   h   
1798                             ; val_hi = 外側フレーム番号
1798                             ; frame_sp == 0 (トップレベル) → FRAME_NONE
1798                             ; frame_sp >  0 (ブロック内)   → frame_sp - 1 (現在のフレーム)
1798   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
179B   B7                     ORA   a   
179C   C2 A4 17               JNZ   block_in_frame   
179F   3E FF                  MVI   a,FRAME_NONE   ; トップレベル
17A1   C3 A5 17               JMP   block_set_outer   
17A4                BLOCK_IN_FRAME:      
17A4   3D                     DCR   a   ; frame_sp - 1 = 現在のフレーム
17A5                BLOCK_SET_OUTER:      
17A5   77                     MOV   m,a   ; +3: val_hi = outer frame
17A6   C3 1B 1C               JMP   vm_loop   
17A9                             ; 
17A9   00           BLK_REG_A:   DB   0   
17AA                             ; 
17AA                             ; ---------------------------------------------------------------
17AA                             ; OP_ENTER (W): 引数の仕様を読み飛ばす (3 バイト)
17AA                             ; 
17AA                             ; faRuby では引数の型検査をしないため、オペランドを消費するだけ。
17AA                             ; ---------------------------------------------------------------
17AA                DO_OP_ENTER:      
17AA   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 1)
17AD   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 2)
17B0   CD C0 10               CALL   fetch_byte   ; 読み飛ばし (byte 3)
17B3   C3 1B 1C               JMP   vm_loop   
17B6                             ; 
17B6                             ; ---------------------------------------------------------------
17B6                             ; OP_SSENDB (BBB): R[a] = R[0] (self) を設定してから OP_SENDB へ
17B6                             ; 
17B6                             ; OP_SSEND と同様、R[0] (self) を R[a] にコピーしてから
17B6                             ; ブロック付きメソッド呼び出しを行う。
17B6                             ; ---------------------------------------------------------------
17B6                DO_OP_SSENDB:      
17B6                             ; オペランドをプリフェッチ
17B6   CD C0 10               CALL   fetch_byte   ; A = a
17B9   32 CC 18               STA   sendb_reg_a   
17BC   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17BF   32 CD 18               STA   sendb_sym_b   
17C2   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17C5   32 CE 18               STA   sendb_argc   
17C8                             ; 
17C8                             ; R[0] → R[a] コピー (self を設定)
17C8   3E 00                  MVI   a,0   
17CA   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
17CD   E5                     PUSH   h   ; R[0] アドレス退避
17CE   3A CC 18               LDA   sendb_reg_a   
17D1   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
17D4   EB                     XCHG      ; DE = R[a]
17D5   E1                     POP   h   ; HL = R[0]
17D6   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
17D9                             ; 
17D9   C3 EE 17               JMP   sendb_dispatch   
17DC                             ; 
17DC                             ; ---------------------------------------------------------------
17DC                             ; OP_SENDB (BBB): ブロック付きメソッド呼び出し
17DC                             ; 
17DC                             ; R[a+argc+1] にブロック (TT_PROC) があることを期待する。
17DC                             ; シンボルテーブルからメソッド ID を取得し、振り分ける。
17DC                             ; ---------------------------------------------------------------
17DC                DO_OP_SENDB:      
17DC   CD C0 10               CALL   fetch_byte   ; A = a
17DF   32 CC 18               STA   sendb_reg_a   
17E2   CD C0 10               CALL   fetch_byte   ; A = b (シンボル番号)
17E5   32 CD 18               STA   sendb_sym_b   
17E8   CD C0 10               CALL   fetch_byte   ; A = c (argc)
17EB   32 CE 18               STA   sendb_argc   
17EE                             ; 
17EE                SENDB_DISPATCH:      
17EE                             ; シンボルテーブルからメソッド ID を取得
17EE   3A CD 18               LDA   sendb_sym_b   
17F1   87                     ADD   a   ; ×2
17F2   5F                     MOV   e,a   
17F3   16 00                  MVI   d,0   
17F5   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
17F8   19                     DAD   d   ; HL = sym_table[b]
17F9   7E                     MOV   a,m   ; メソッド ID (下位)
17FA   32 CF 18               STA   sendb_method_id   
17FD                             ; 
17FD                             ; メソッド ID で振り分け
17FD   3A CF 18               LDA   sendb_method_id   
1800   FE 0B                  CPI   11   ; METHOD_TIMES
1802   CA 33 18               JZ   sendb_times   
1805   FE 15                  CPI   METHOD_EACH   
1807   CA 3A 28               JZ   sendb_each   
180A   FE 1B                  CPI   27   ; METHOD_LOOP
180C   CA 96 18               JZ   sendb_loop   
180F                             ; any? / all? / none? は each と同じ反復。フレームの種別だけが違う
180F   FE 23                  CPI   METHOD_ANY_P   
1811   CA 21 18               JZ   sendb_any   
1814   FE 24                  CPI   METHOD_ALL_P   
1816   CA 26 18               JZ   sendb_all   
1819   FE 25                  CPI   METHOD_NONE_P   
181B   CA 2B 18               JZ   sendb_none   
181E                             ; 未対応のブロックメソッド
181E   C3 03 00               JMP   vm_error   
1821                             ; 
1821                             ; --- any? / all? / none? ---
1821                             ; 
1821                             ; **渡す値は each と同じ**なので sendb_each に合流します。種別が持つのは
1821                             ; 「ブロックの値をどう使うか」だけで、配列かハッシュかはスロットの
1821                             ; 見出しの種別 (COL_TYPE_*) で決まります。
1821                SENDB_ANY:      
1821   3E 06                  MVI   a,FRAME_KIND_ANY   
1823   C3 2D 18               JMP   sendb_pred   
1826                SENDB_ALL:      
1826   3E 07                  MVI   a,FRAME_KIND_ALL   
1828   C3 2D 18               JMP   sendb_pred   
182B                SENDB_NONE:      
182B   3E 08                  MVI   a,FRAME_KIND_NONE   
182D                SENDB_PRED:      
182D   32 56 29               STA   each_arg_kind   
1830   C3 55 28               JMP   sendb_each_join   
1833                             ; 
1833                             ; --- times ---
1833                SENDB_TIMES:      
1833                             ; R[a] がレシーバ (整数)。limit = R[a] の値 - 1
1833   3A CC 18               LDA   sendb_reg_a   
1836   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1839   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
183C   4E                     MOV   c,m   ; C = val_lo
183D   23                     INX   h   
183E   46                     MOV   b,m   ; B = val_hi  → BC = レシーバの値
183F                             ; 
183F                             ; 0.times → ブロックを実行しない (R[a] はそのまま)
183F   78                     MOV   a,b   
1840   B1                     ORA   c   
1841   CA 1B 1C               JZ   vm_loop   ; receiver == 0 → スキップ
1844                             ; 
1844                             ; limit = BC - 1
1844   0B                     DCX   b   ; BC = limit
1845                             ; 
1845                             ; push_frame: A=レジスタ番号, B=kind, C=outer
1845                             ; ブロックの位置: R[a + argc + 1]
1845   3A CC 18               LDA   sendb_reg_a   
1848   C5                     PUSH   b   ; limit を退避
1849                             ; ブロック (TT_PROC) の情報を読む
1849   3A CE 18               LDA   sendb_argc   
184C   3C                     INR   a   ; argc + 1
184D   47                     MOV   b,a   
184E   3A CC 18               LDA   sendb_reg_a   
1851   80                     ADD   b   ; A = a + argc + 1
1852   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
1855   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1858   7E                     MOV   a,m   ; A = irep 番号
1859   32 D0 18               STA   sendb_block_irep   
185C   23                     INX   h   
185D   7E                     MOV   a,m   ; A = outer frame (val_hi)
185E   32 D1 18               STA   sendb_block_outer   
1861                             ; 
1861                             ; push_frame(a, FRAME_KIND_ITERATE, outer)
1861   3A CC 18               LDA   sendb_reg_a   
1864   06 01                  MVI   b,FRAME_KIND_ITERATE   
1866   3A D1 18               LDA   sendb_block_outer   
1869   4F                     MOV   c,a   
186A   3A CC 18               LDA   sendb_reg_a   
186D   CD A4 16               CALL   push_frame   
1870                             ; 
1870                             ; フレームに limit を設定
1870                             ; cur_frame_addr は BC を破壊するので、先に呼ぶ
1870   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム (BC 破壊)
1873   11 08 00               LXI   d,FRAME_OFF_LIMIT   
1876   19                     DAD   d   ; HL = &limit
1877   C1                     POP   b   ; BC = limit (ここで復帰)
1878   71                     MOV   m,c   ; limit_lo
1879   23                     INX   h   
187A   70                     MOV   m,b   ; limit_hi
187B                             ; 
187B                             ; ブロック引数 R[1] = 0 (初期カウンタ)
187B                             ; R[1] は新しい reg_base から見た R[1]
187B   3E 01                  MVI   a,1   
187D   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1880   06 00                  MVI   b,0   
1882   0E 00                  MVI   c,0   
1884   CD 10 10               CALL   set_slot_int16   ; R[1] = 0
1887                             ; 
1887                             ; 子 irep に切り替え
1887   3A D0 18               LDA   sendb_block_irep   
188A   CD 29 17               CALL   switch_irep   
188D                             ; 
188D                             ; PC = 0
188D   21 00 00               LXI   h,0   
1890   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1893   C3 1B 1C               JMP   vm_loop   
1896                             ; 
1896                             ; --- loop ---
1896                SENDB_LOOP:      
1896                             ; ブロックの位置: R[a + argc + 1]
1896   3A CE 18               LDA   sendb_argc   
1899   3C                     INR   a   
189A   47                     MOV   b,a   
189B   3A CC 18               LDA   sendb_reg_a   
189E   80                     ADD   b   ; A = a + argc + 1
189F   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1] (ブロック)
18A2   CD 32 10               CALL   slot_to_value   
18A5   7E                     MOV   a,m   ; irep 番号
18A6   32 D0 18               STA   sendb_block_irep   
18A9   23                     INX   h   
18AA   7E                     MOV   a,m   ; outer
18AB   32 D1 18               STA   sendb_block_outer   
18AE                             ; 
18AE                             ; push_frame(a, FRAME_KIND_LOOP, outer)
18AE   3A CC 18               LDA   sendb_reg_a   
18B1   06 04                  MVI   b,FRAME_KIND_LOOP   
18B3   3A D1 18               LDA   sendb_block_outer   
18B6   4F                     MOV   c,a   
18B7   3A CC 18               LDA   sendb_reg_a   
18BA   CD A4 16               CALL   push_frame   
18BD                             ; 
18BD                             ; 子 irep に切り替え
18BD   3A D0 18               LDA   sendb_block_irep   
18C0   CD 29 17               CALL   switch_irep   
18C3                             ; 
18C3                             ; PC = 0
18C3   21 00 00               LXI   h,0   
18C6   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
18C9   C3 1B 1C               JMP   vm_loop   
18CC                             ; 
18CC                             ; OP_SENDB の一時変数
18CC   00           SENDB_REG_A:   DB   0   
18CD   00           SENDB_SYM_B:   DB   0   
18CE   00           SENDB_ARGC:   DB   0   
18CF   00           SENDB_METHOD_ID:   DB   0   
18D0   00           SENDB_BLOCK_IREP:   DB   0   
18D1   00           SENDB_BLOCK_OUTER:   DB   0   
18D2                             ; 
18D2                             ; ---------------------------------------------------------------
18D2                             ; OP_BREAK (B): ブロックから脱出
18D2                             ; 
18D2                             ; R[a] の値を R[0] にコピーして pop_frame。
18D2                             ; ---------------------------------------------------------------
18D2                DO_OP_BREAK:      
18D2   CD C0 10               CALL   fetch_byte   ; A = a
18D5                             ; R[a] → R[0] コピー
18D5   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
18D8   E5                     PUSH   h   ; R[a] アドレス退避
18D9   3E 00                  MVI   a,0   
18DB   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
18DE   EB                     XCHG      ; DE = R[0]
18DF   E1                     POP   h   ; HL = R[a]
18E0   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
18E3                             ; 
18E3   CD FF 16               CALL   pop_frame   
18E6   C3 1B 1C               JMP   vm_loop   
18E9                             ; vm_upvar.a80 — 外側スコープの変数アクセス
18E9                             ; 
18E9                             ; OP_GETUPVAR, OP_SETUPVAR
18E9                             ; 
18E9                             ; ブロック内から外側のローカル変数にアクセスする。
18E9                             ; outer フレーム chain を level 段辿って reg_base を求める。
18E9                             ; 
18E9                             ; ---------------------------------------------------------------
18E9                             ; upvar_base — 外側スコープのレジスタベースアドレスを求める
18E9                             ; 
18E9                             ;   入力: A = level (何段外側か)
18E9                             ;   出力: HL = 外側スコープの reg_base アドレス
18E9                             ;   破壊: A, B, C, DE
18E9                             ; 
18E9                             ; outer chain を level 段辿る。FRAME_NONE に達したら
18E9                             ; REG_FILE_BASE (トップレベル) を返す。
18E9                             ; ---------------------------------------------------------------
18E9                UPVAR_BASE:      
18E9   47                     MOV   b,a   ; B = level (残り段数)
18EA                             ; まず現在のフレームの outer を読む
18EA   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
18ED   3D                     DCR   a   ; 現在のフレーム = frame_sp - 1
18EE   32 20 19               STA   upvar_frame   
18F1                             ; 
18F1                             ; level == 0 なら outer chain を辿らずに
18F1                             ; 現在のフレームの return_reg_base をそのまま返す
18F1   78                     MOV   a,b   
18F2   B7                     ORA   a   
18F3   CA 0D 19               JZ   upvar_found   
18F6                             ; 
18F6                UPVAR_LOOP:      
18F6                             ; outer フレーム番号を読む
18F6   3A 20 19               LDA   upvar_frame   
18F9   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
18FC   11 0A 00               LXI   d,FRAME_OFF_OUTER   
18FF   19                     DAD   d   
1900   7E                     MOV   a,m   ; A = outer frame 番号
1901                             ; 
1901   FE FF                  CPI   FRAME_NONE   
1903   CA 1C 19               JZ   upvar_toplevel   ; トップレベルに達した
1906                             ; 
1906   32 20 19               STA   upvar_frame   ; 次のフレーム
1909                             ; 
1909   05                     DCR   b   
190A   C2 F6 18               JNZ   upvar_loop   ; まだ辿る段がある
190D                             ; 
190D                             ; level 回辿り終わった — upvar_frame の reg_base を返す
190D                UPVAR_FOUND:      
190D   3A 20 19               LDA   upvar_frame   
1910   CD 8F 16               CALL   get_frame_addr   ; HL = フレームアドレス
1913   11 03 00               LXI   d,FRAME_OFF_RETURN_REG_BASE   
1916   19                     DAD   d   
1917   5E                     MOV   e,m   
1918   23                     INX   h   
1919   56                     MOV   d,m   ; DE = return_reg_base
191A   EB                     XCHG      ; HL = return_reg_base
191B   C9                     RET      
191C                             ; 
191C                UPVAR_TOPLEVEL:      
191C   21 00 81               LXI   h,REG_FILE_BASE   
191F   C9                     RET      
1920                             ; 
1920   00           UPVAR_FRAME:   DB   0   
1921                             ; 
1921                             ; ---------------------------------------------------------------
1921                             ; OP_GETUPVAR (BBB): R[a] = upvar[level].R[b]
1921                             ; 
1921                             ;   a = コピー先レジスタ
1921                             ;   b = 外側スコープのレジスタ番号
1921                             ;   c = level (何段外側か)
1921                             ; ---------------------------------------------------------------
1921                DO_OP_GETUPVAR:      
1921   CD C0 10               CALL   fetch_byte   ; A = a
1924   32 77 19               STA   upvar_reg_a   
1927   CD C0 10               CALL   fetch_byte   ; A = b (外側のレジスタ番号)
192A   32 78 19               STA   upvar_reg_b   
192D   CD C0 10               CALL   fetch_byte   ; A = c (level)
1930                             ; 
1930                             ; 外側の reg_base を求める
1930   CD E9 18               CALL   upvar_base   ; HL = 外側の reg_base
1933                             ; 
1933                             ; 外側の R[b] のアドレス = base + b * 4
1933   3A 78 19               LDA   upvar_reg_b   
1936   87                     ADD   a   ; ×2
1937   87                     ADD   a   ; ×4
1938   85                     ADD   l   
1939   6F                     MOV   l,a   
193A   3E 00                  MVI   a,0   
193C   8C                     ADC   h   
193D   67                     MOV   h,a   ; HL = 外側の R[b]
193E                             ; 
193E                             ; R[a] にコピー
193E   E5                     PUSH   h   ; コピー元退避
193F   3A 77 19               LDA   upvar_reg_a   
1942   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1945   EB                     XCHG      ; DE = R[a] (コピー先)
1946   E1                     POP   h   ; HL = 外側の R[b] (コピー元)
1947   CD 25 10               CALL   copy_slot   
194A   C3 1B 1C               JMP   vm_loop   
194D                             ; 
194D                             ; ---------------------------------------------------------------
194D                             ; OP_SETUPVAR (BBB): upvar[level].R[b] = R[a]
194D                             ; 
194D                             ;   a = コピー元レジスタ
194D                             ;   b = 外側スコープのレジスタ番号
194D                             ;   c = level (何段外側か)
194D                             ; ---------------------------------------------------------------
194D                DO_OP_SETUPVAR:      
194D   CD C0 10               CALL   fetch_byte   ; A = a
1950   32 77 19               STA   upvar_reg_a   
1953   CD C0 10               CALL   fetch_byte   ; A = b
1956   32 78 19               STA   upvar_reg_b   
1959   CD C0 10               CALL   fetch_byte   ; A = c (level)
195C                             ; 
195C                             ; 外側の reg_base を求める
195C   CD E9 18               CALL   upvar_base   ; HL = 外側の reg_base
195F                             ; 
195F                             ; 外側の R[b] のアドレス = base + b * 4
195F   3A 78 19               LDA   upvar_reg_b   
1962   87                     ADD   a   
1963   87                     ADD   a   
1964   85                     ADD   l   
1965   6F                     MOV   l,a   
1966   3E 00                  MVI   a,0   
1968   8C                     ADC   h   
1969   67                     MOV   h,a   ; HL = 外側の R[b]
196A   EB                     XCHG      ; DE = 外側の R[b] (コピー先)
196B                             ; 
196B                             ; R[a] からコピー
196B   3A 77 19               LDA   upvar_reg_a   
196E   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー元)
1971   CD 25 10               CALL   copy_slot   
1974   C3 1B 1C               JMP   vm_loop   
1977                             ; 
1977   00           UPVAR_REG_A:   DB   0   
1978   00           UPVAR_REG_B:   DB   0   
1979                             ; vm_class.a80 — クラス・メソッド定義オペコード
1979                             ; 
1979                             ; OP_TCLASS, OP_METHOD, OP_DEF, OP_CLASS, OP_GETCONST, OP_EXEC
1979                             ; 
1979                             ; ---------------------------------------------------------------
1979                             ; OP_TCLASS (B): R[a] = R[0] (self をコピー)
1979                             ; 
1979                             ; 定義先クラスを返す。トップレベルでは main (TT_OBJECT, 値=0)、
1979                             ; クラス本体内ではそのクラス (TT_CLASS)。
1979                             ; ---------------------------------------------------------------
1979                DO_OP_TCLASS:      
1979   CD C0 10               CALL   fetch_byte   ; A = a
197C   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
197F   EB                     XCHG      ; DE = R[a] (コピー先)
1980   3E 00                  MVI   a,0   
1982   CD 00 10               CALL   get_reg_addr   ; HL = R[0] (コピー元)
1985   CD 25 10               CALL   copy_slot   ; R[a] = R[0]
1988   C3 1B 1C               JMP   vm_loop   
198B                             ; 
198B                             ; ---------------------------------------------------------------
198B                             ; OP_METHOD (BB): R[a] = Proc(irep=child_irep(b), outer=FRAME_NONE)
198B                             ; 
198B                             ; OP_BLOCK と同様だが、outer は常に FRAME_NONE (メソッドはクロージャ
198B                             ; ではないため、外側フレームへの参照を持たない)。
198B                             ; ---------------------------------------------------------------
198B                DO_OP_METHOD:      
198B   CD C0 10               CALL   fetch_byte   ; A = a
198E   32 AB 19               STA   meth_reg_a   
1991   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1994   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1997   4F                     MOV   c,a   ; C = irep 番号 (val_lo)
1998                             ; 
1998   3A AB 19               LDA   meth_reg_a   
199B   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
199E   36 0C                  MVI   m,TT_PROC   ; +0: 型タグ
19A0   23                     INX   h   
19A1   36 00                  MVI   m,0   ; +1: 予約
19A3   23                     INX   h   
19A4   71                     MOV   m,c   ; +2: val_lo = irep 番号
19A5   23                     INX   h   
19A6   36 FF                  MVI   m,FRAME_NONE   ; +3: val_hi = FRAME_NONE (メソッド)
19A8   C3 1B 1C               JMP   vm_loop   
19AB                             ; 
19AB   00           METH_REG_A:   DB   0   
19AC                             ; 
19AC                             ; ---------------------------------------------------------------
19AC                             ; OP_DEF (BB): メソッド表に登録
19AC                             ; 
19AC                             ; R[a] = 定義先 (TT_CLASS or TT_OBJECT)
19AC                             ; R[a+1] = Proc (TT_PROC, val_lo = irep 番号)
19AC                             ; シンボル b の種別: SYM_KIND_USER_METHOD (D=0x01), E=method_id
19AC                             ; 
19AC                             ; method_table[class_number * 32 + method_id] = irep 番号
19AC                             ; ---------------------------------------------------------------
19AC                DO_OP_DEF:      
19AC   CD C0 10               CALL   fetch_byte   ; A = a
19AF   32 10 1A               STA   def_reg_a   
19B2   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
19B5                             ; 
19B5                             ; シンボルテーブルから method_id を取得
19B5   87                     ADD   a   ; ×2
19B6   5F                     MOV   e,a   
19B7   16 00                  MVI   d,0   
19B9   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
19BC   19                     DAD   d   ; HL = &sym_table[b]
19BD   5E                     MOV   e,m   ; E = method_id (下位)
19BE   23                     INX   h   
19BF   56                     MOV   d,m   ; D = 種別 (上位、SYM_KIND_USER_METHOD のはず)
19C0                             ; 種別チェックは省略 (バイトコードツールが保証)
19C0                             ; 
19C0                             ; method_id を退避
19C0   7B                     MOV   a,e   
19C1   32 11 1A               STA   def_method_id   
19C4                             ; 
19C4                             ; R[a] から class_number を取得
19C4   3A 10 1A               LDA   def_reg_a   
19C7   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19CA   CD 9B 10               CALL   class_of_reg   ; A = class_number
19CD                             ; 
19CD                             ; メソッド表アドレス: METHOD_TABLE_BASE + class * 32 + method_id
19CD                             ; A * 32
19CD   87                     ADD   a   ; ×2
19CE   87                     ADD   a   ; ×4
19CF   87                     ADD   a   ; ×8
19D0   87                     ADD   a   ; ×16
19D1   87                     ADD   a   ; ×32
19D2   5F                     MOV   e,a   
19D3   16 00                  MVI   d,0   
19D5   21 C0 91               LXI   h,METHOD_TABLE_BASE   
19D8   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32
19D9   3A 11 1A               LDA   def_method_id   
19DC   5F                     MOV   e,a   
19DD   16 00                  MVI   d,0   
19DF   19                     DAD   d   ; HL = METHOD_TABLE_BASE + class * 32 + method_id
19E0                             ; 
19E0                             ; R[a+1].val_lo = irep 番号
19E0   3A 10 1A               LDA   def_reg_a   
19E3   CD 0C 10               CALL   get_reg_addr_next   ; HL = R[a+1]
19E6   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
19E9   7E                     MOV   a,m   ; A = val_lo = irep 番号
19EA                             ; 
19EA                             ; メソッド表に書く (HL は R[a+1] の値を指しているので、再計算)
19EA   32 12 1A               STA   def_irep_num   
19ED   3A 10 1A               LDA   def_reg_a   
19F0   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
19F3   CD 9B 10               CALL   class_of_reg   ; A = class_number
19F6   87                     ADD   a   
19F7   87                     ADD   a   
19F8   87                     ADD   a   
19F9   87                     ADD   a   
19FA   87                     ADD   a   ; A = class * 32
19FB   5F                     MOV   e,a   
19FC   16 00                  MVI   d,0   
19FE   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1A01   19                     DAD   d   
1A02   3A 11 1A               LDA   def_method_id   
1A05   5F                     MOV   e,a   
1A06   16 00                  MVI   d,0   
1A08   19                     DAD   d   ; HL = メソッド表エントリ
1A09   3A 12 1A               LDA   def_irep_num   
1A0C   77                     MOV   m,a   ; method_table[...] = irep 番号
1A0D   C3 1B 1C               JMP   vm_loop   
1A10                             ; 
1A10   00           DEF_REG_A:   DB   0   
1A11   00           DEF_METHOD_ID:   DB   0   
1A12   00           DEF_IREP_NUM:   DB   0   
1A13                             ; 
1A13                             ; ---------------------------------------------------------------
1A13                             ; OP_CLASS (BB) / OP_GETCONST (BB): R[a] = TT_CLASS(class_number)
1A13                             ; 
1A13                             ; シンボル b の種別: SYM_KIND_CLASS (D=0x02), E=class_number
1A13                             ; ---------------------------------------------------------------
1A13                DO_OP_CLASS:      
1A13                             ; **クラス名と利用者の定数が同じ命令で来ます。** `Counter.new` の `Counter` も
1A13                             ; `LIMIT` も OP_GETCONST なので、シンボルテーブルの種別で分けます。
1A13                             ; ホスト側は `OP_CLASS` に出てきた名前だけをクラスとして登録するので、
1A13                             ; 残りは定数です (tools/i8080_bytecode_hex.rb)。
1A13                             ; 
1A13                             ; 定数はグローバル変数と同じ 4 バイトのスロットに置いてあるので、
1A13                             ; **写しは do_op_getgv の続き (getgv_ok) に合流させます。** 同じ並びを
1A13                             ; 2 か所に書くと、片方だけ直して食い違います。
1A13                DO_OP_GETCONST:      
1A13   CD C0 10               CALL   fetch_byte   ; A = a
1A16   F5                     PUSH   psw   
1A17   CD C0 10               CALL   fetch_byte   ; A = b (シンボルインデックス)
1A1A                             ; 
1A1A                             ; シンボルテーブルのエントリを取る
1A1A   87                     ADD   a   ; ×2
1A1B   5F                     MOV   e,a   
1A1C   16 00                  MVI   d,0   
1A1E   2A 19 80               LHLD   VM_STATE_BASE + OFF_SYM_BASE   
1A21   19                     DAD   d   ; HL = &sym_table[b]
1A22   5E                     MOV   e,m   
1A23   23                     INX   h   
1A24   56                     MOV   d,m   ; DE = エントリ値 (D=種別, E=値)
1A25                             ; 
1A25   7A                     MOV   a,d   
1A26   FE 02                  CPI   SYM_KIND_CLASS   
1A28   CA 34 1A               JZ   getconst_class   
1A2B                             ; 
1A2B                             ; 利用者の定数。DE がグローバルスロットのアドレス
1A2B   7A                     MOV   a,d   
1A2C   B3                     ORA   e   
1A2D   C2 EB 13               JNZ   getgv_ok   ; do_op_getgv の続きへ (a はスタックにある)
1A30   F1                     POP   psw   
1A31   C3 03 00               JMP   vm_error   ; クラスでも定数でもない
1A34                             ; 
1A34                GETCONST_CLASS:      
1A34   F1                     POP   psw   ; A = a
1A35   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1A38   36 0D                  MVI   m,TT_CLASS   ; +0: 型タグ
1A3A   23                     INX   h   
1A3B   36 00                  MVI   m,0   ; +1: 予約
1A3D   23                     INX   h   
1A3E   73                     MOV   m,e   ; +2: val_lo = class_number
1A3F   23                     INX   h   
1A40   36 00                  MVI   m,0   ; +3: val_hi = 0
1A42   C3 1B 1C               JMP   vm_loop   
1A45                             ; 
1A45                             ; ---------------------------------------------------------------
1A45                             ; OP_EXEC (BB): クラス本体を実行
1A45                             ; 
1A45                             ; push_frame して子 irep に切り替える。
1A45                             ; reg_base が a*4 ずれるので、新フレームの R[0] = 旧フレームの R[a]。
1A45                             ; これにより、クラス本体内の R[0] (self) がクラスオブジェクトになる。
1A45                             ; ---------------------------------------------------------------
1A45                DO_OP_EXEC:      
1A45   CD C0 10               CALL   fetch_byte   ; A = a
1A48   32 6D 1A               STA   exec_reg_a   
1A4B   CD C0 10               CALL   fetch_byte   ; A = b (子 irep インデックス)
1A4E   CD 77 10               CALL   calc_child_irep   ; A = irep 番号
1A51   32 6E 1A               STA   exec_irep   
1A54                             ; 
1A54                             ; push_frame(a, FRAME_KIND_CALL, FRAME_NONE)
1A54   3A 6D 1A               LDA   exec_reg_a   
1A57   06 00                  MVI   b,FRAME_KIND_CALL   
1A59   0E FF                  MVI   c,FRAME_NONE   
1A5B   CD A4 16               CALL   push_frame   
1A5E                             ; 
1A5E                             ; 子 irep に切り替え
1A5E   3A 6E 1A               LDA   exec_irep   
1A61   CD 29 17               CALL   switch_irep   
1A64                             ; 
1A64                             ; PC = 0
1A64   21 00 00               LXI   h,0   
1A67   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1A6A   C3 1B 1C               JMP   vm_loop   
1A6D                             ; 
1A6D   00           EXEC_REG_A:   DB   0   
1A6E   00           EXEC_IREP:   DB   0   
1A6F                             ; vm_display.a80 — 7 セグメント表示
1A6F                             ; 
1A6F                             ; 16 ビット整数値を 8 桁の 16 進数に変換し、7 セグ表示バッファに書く。
1A6F                             ; 上位 4 桁はブランク（消灯）にする。
1A6F                             ; セグメントパターンは seg_table にまとめる。
1A6F                             ; 
1A6F                             ; ---------------------------------------------------------------
1A6F                             ; display_hex16 — 16 ビット値を 7 セグに表示
1A6F                             ; 
1A6F                             ;   入力: HL = 値の先頭 (val_lo の位置)
1A6F                             ;   出力: DISPLAY_BASE に 8 桁のセグメントパターン
1A6F                             ;   破壊: A, B, C, HL, DE
1A6F                             ; 
1A6F                             ; 8 桁表示: 上位 4 桁はブランク (消灯), 下位 4 桁が値。
1A6F                             ; val_hi の上位ニブルが桁 4、val_lo の下位ニブルが桁 7。
1A6F                             ; ---------------------------------------------------------------
1A6F                DISPLAY_HEX16:      
1A6F   E5                     PUSH   h   ; 値のアドレスを退避
1A70                             ; 上位 4 桁をブランク (消灯) にする
1A70   11 F8 FF               LXI   d,DISPLAY_BASE   
1A73   AF                     XRA   a   ; A = 0 (全セグメント消灯)
1A74   12                     STAX   d   
1A75   13                     INX   d   
1A76   12                     STAX   d   
1A77   13                     INX   d   
1A78   12                     STAX   d   
1A79   13                     INX   d   
1A7A   12                     STAX   d   
1A7B   13                     INX   d   ; DE = DISPLAY_BASE + 4
1A7C                             ; 値の byte1 (val_hi) から表示
1A7C   E1                     POP   h   ; HL = val_lo
1A7D   23                     INX   h   ; HL = val_hi
1A7E   0E 02                  MVI   c,2   ; 2 バイト (= 4 ニブル)
1A80                DISPLAY_BYTE_LOOP:      
1A80                             ; 上位ニブル
1A80   7E                     MOV   a,m   
1A81   0F                     RRC      
1A82   0F                     RRC      
1A83   0F                     RRC      
1A84   0F                     RRC      
1A85   E6 0F                  ANI   0Fh   
1A87   CD 9A 1A               CALL   nibble_to_seg   
1A8A   12                     STAX   d   
1A8B   13                     INX   d   
1A8C                             ; 下位ニブル
1A8C   7E                     MOV   a,m   
1A8D   E6 0F                  ANI   0Fh   
1A8F   CD 9A 1A               CALL   nibble_to_seg   
1A92   12                     STAX   d   
1A93   13                     INX   d   
1A94                             ; 次のバイト (val_hi → val_lo)
1A94   2B                     DCX   h   
1A95   0D                     DCR   c   
1A96   C2 80 1A               JNZ   display_byte_loop   
1A99   C9                     RET      
1A9A                             ; 
1A9A                             ; ---------------------------------------------------------------
1A9A                             ; nibble_to_seg — 4 ビット値を 7 セグパターンに変換
1A9A                             ; 
1A9A                             ;   入力: A = 0-F
1A9A                             ;   出力: A = セグメントパターン
1A9A                             ;   破壊: なし (HL, BC は内部で退避・復元)
1A9A                             ; ---------------------------------------------------------------
1A9A                NIBBLE_TO_SEG:      
1A9A   E5                     PUSH   h   
1A9B   C5                     PUSH   b   ; BC を退避 (C = ループカウンタ)
1A9C   6F                     MOV   l,a   
1A9D   26 00                  MVI   h,0   
1A9F   01 A7 1A               LXI   b,seg_table   
1AA2   09                     DAD   b   ; HL = seg_table + nibble
1AA3   7E                     MOV   a,m   
1AA4   C1                     POP   b   ; BC を復元
1AA5   E1                     POP   h   
1AA6   C9                     RET      
1AA7                             ; 
1AA7                             ; ---------------------------------------------------------------
1AA7                             ; 7 セグメントパターンテーブル
1AA7                             ; 
1AA7                             ;   bit 0 = a (上)
1AA7                             ;   bit 1 = b (右上)
1AA7                             ;   bit 2 = c (右下)
1AA7                             ;   bit 3 = d (下)
1AA7                             ;   bit 4 = e (左下)
1AA7                             ;   bit 5 = f (左上)
1AA7                             ;   bit 6 = g (中)
1AA7                             ; 
1AA7                             ;       aaa
1AA7                             ;      f   b
1AA7                             ;       ggg
1AA7                             ;      e   c
1AA7                             ;       ddd
1AA7                             ; ---------------------------------------------------------------
1AA7                SEG_TABLE:      
1AA7   5C                     DB   5Ch   ; 0  (ND8080 ROM パターン)
1AA8   06                     DB   06h   ; 1
1AA9   5B                     DB   5Bh   ; 2
1AAA   4F                     DB   4Fh   ; 3
1AAB   66                     DB   66h   ; 4
1AAC   6D                     DB   6Dh   ; 5
1AAD   7D                     DB   7Dh   ; 6
1AAE   27                     DB   27h   ; 7  (ND8080 ROM パターン)
1AAF   7F                     DB   7Fh   ; 8
1AB0   6F                     DB   6Fh   ; 9
1AB1   77                     DB   77h   ; A
1AB2   7C                     DB   7Ch   ; b
1AB3   39                     DB   39h   ; C
1AB4   5E                     DB   5Eh   ; d
1AB5   79                     DB   79h   ; E
1AB6   71                     DB   71h   ; F
1AB7                             ; 
1AB7                             ; ===============================================================
1AB7                             ; OP_RETURN (B): フレーム種別に応じて復帰
1AB7                             ; 
1AB7                             ; frame_sp == 0 → トップレベル: 表示して停止
1AB7                             ; FRAME_KIND_CALL → メソッド復帰: R[a] を R[0] にコピー、pop_frame
1AB7                             ; FRAME_KIND_NEW  → new 復帰: pop_frame のみ (R[a] をコピーしない)
1AB7                             ; それ以外 (反復のフレーム) → ブロック内: advance_iteration
1AB7                             ; ===============================================================
1AB7                DO_OP_RETURN:      
1AB7   CD C0 10               CALL   fetch_byte   ; A = a (戻り値のレジスタ)
1ABA   32 0A 1B               STA   return_reg_a   
1ABD                             ; 
1ABD                             ; フレームスタックが空ならトップレベル
1ABD   3A 18 80               LDA   VM_STATE_BASE + OFF_FRAME_SP   
1AC0   B7                     ORA   a   
1AC1   CA F6 1A               JZ   do_op_return_top   
1AC4                             ; 
1AC4                             ; フレーム種別を確認
1AC4   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1AC7   11 05 00               LXI   d,FRAME_OFF_KIND   
1ACA   19                     DAD   d   
1ACB   7E                     MOV   a,m   ; A = kind
1ACC   FE 00                  CPI   FRAME_KIND_CALL   
1ACE   CA D9 1A               JZ   return_call   
1AD1   FE 05                  CPI   FRAME_KIND_NEW   
1AD3   CA F0 1A               JZ   return_new   
1AD6                             ; 反復のフレーム (ITERATE / EACH / HASH_EACH / LOOP)
1AD6   C3 0B 1B               JMP   advance_iteration   
1AD9                             ; 
1AD9                RETURN_CALL:      
1AD9                             ; R[a] の値を R[0] にコピー
1AD9   3A 0A 1B               LDA   return_reg_a   
1ADC   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1ADF   E5                     PUSH   h   
1AE0   3E 00                  MVI   a,0   
1AE2   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1AE5   EB                     XCHG      ; DE = R[0] (コピー先)
1AE6   E1                     POP   h   ; HL = R[a] (コピー元)
1AE7   CD 25 10               CALL   copy_slot   ; R[0] = R[a]
1AEA   CD FF 16               CALL   pop_frame   
1AED   C3 1B 1C               JMP   vm_loop   
1AF0                             ; 
1AF0                RETURN_NEW:      
1AF0                             ; FRAME_KIND_NEW: 戻り値をコピーしない (R[a] のオブジェクトを保持)
1AF0   CD FF 16               CALL   pop_frame   
1AF3   C3 1B 1C               JMP   vm_loop   
1AF6                             ; 
1AF6                DO_OP_RETURN_TOP:      
1AF6   3A 0A 1B               LDA   return_reg_a   
1AF9   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1AFC   CD 32 10               CALL   slot_to_value   ; HL = R[a] の値先頭
1AFF   CD 6F 1A               CALL   display_hex16   
1B02   3E 02                  MVI   a,VM_FINISHED   
1B04   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1B07   C3 09 1C               JMP   vm_halt   
1B0A                             ; 
1B0A   00           RETURN_REG_A:   DB   0   
1B0B                             ; 
1B0B                             ; ===============================================================
1B0B                             ; advance_iteration — ブロックの 1 反復が終わった後の処理
1B0B                             ; 
1B0B                             ; ITERATE (times / upto): index++ して limit と比較。超えたら pop_frame。
1B0B                             ; EACH / HASH_EACH: 同じ数え方で、ブロックに渡す値だけが違う。
1B0B                             ; LOOP: 常に PC=0 で再実行 (無限ループ)。
1B0B                             ; ===============================================================
1B0B                ADVANCE_ITERATION:      
1B0B                             ; フレーム種別を確認
1B0B   CD 9D 16               CALL   cur_frame_addr   ; HL = 現在のフレーム
1B0E   11 05 00               LXI   d,FRAME_OFF_KIND   
1B11   19                     DAD   d   
1B12   7E                     MOV   a,m   ; A = kind
1B13   FE 04                  CPI   FRAME_KIND_LOOP   
1B15   CA 67 1B               JZ   adv_reenter   ; loop → 常に再実行
1B18   32 79 1B               STA   adv_kind   ; kind を退避
1B1B                             ; 
1B1B                             ; **述語はここでブロックの値を見る。** 打ち切るなら R[0] に答えが入る
1B1B   CD 7A 1B               CALL   predicate_decision   
1B1E   B7                     ORA   a   
1B1F   C2 73 1B               JNZ   adv_stopped   
1B22                             ; 
1B22                             ; --- 反復に共通: index インクリメント + limit チェック ---
1B22   CD 9D 16               CALL   cur_frame_addr   
1B25   11 06 00               LXI   d,FRAME_OFF_INDEX   
1B28   19                     DAD   d   
1B29   4E                     MOV   c,m   ; C = index_lo
1B2A   23                     INX   h   
1B2B   46                     MOV   b,m   ; B = index_hi
1B2C   03                     INX   b   ; BC = index + 1
1B2D                             ; 書き戻す
1B2D   70                     MOV   m,b   ; index_hi
1B2E   2B                     DCX   h   
1B2F   71                     MOV   m,c   ; index_lo
1B30                             ; 
1B30                             ; limit を読む (index の直後、HL=&index_lo → +2 で &limit_lo)
1B30   23                     INX   h   ; → &index_hi
1B31   23                     INX   h   ; → &limit_lo
1B32   5E                     MOV   e,m   ; E = limit_lo
1B33   23                     INX   h   ; → &limit_hi
1B34   56                     MOV   d,m   ; D = limit_hi
1B35                             ; 
1B35                             ; BC = new index, DE = limit
1B35                             ; index > limit なら反復終了 (DE - BC でボロー発生)
1B35   7B                     MOV   a,e   
1B36   91                     SUB   c   
1B37   7A                     MOV   a,d   
1B38   98                     SBB   b   
1B39   DA 70 1B               JC   adv_done   ; index > limit → 反復終了
1B3C                             ; 
1B3C                             ; kind で R[1] の設定を分岐
1B3C                             ; ITERATE (times / upto) だけが添字。残りはコレクションの反復
1B3C   3A 79 1B               LDA   adv_kind   
1B3F   FE 01                  CPI   FRAME_KIND_ITERATE   
1B41   C2 4F 1B               JNZ   adv_each_load   
1B44                             ; 
1B44                             ; --- ITERATE (times): R[1] = index ---
1B44   3E 01                  MVI   a,1   
1B46   CD 00 10               CALL   get_reg_addr   ; HL = R[1] (BC は保存される)
1B49   CD 10 10               CALL   set_slot_int16   ; R[1] = index (ブロック引数 |i|)
1B4C   C3 67 1B               JMP   adv_reenter   
1B4F                             ; 
1B4F                             ; --- EACH / HASH_EACH: ブロックの引数を入れ直す ---
1B4F                             ; 
1B4F                             ; **値の出し方は sendb_each と同じものを呼びます。** 配列なら要素、
1B4F                             ; ハッシュなら鍵と値で、分けているのは each_block_args の中だけです。
1B4F                ADV_EACH_LOAD:      
1B4F                             ; BC = index のうち下位バイトだけ使う (配列 8 要素・ハッシュ 4 ペアまで)
1B4F   79                     MOV   a,c   
1B50   32 57 29               STA   each_index   
1B53   3A 79 1B               LDA   adv_kind   
1B56   32 56 29               STA   each_arg_kind   
1B59                             ; フレーム +11 からコレクションスロット番号を読む
1B59   CD 9D 16               CALL   cur_frame_addr   ; BC を破壊するが、添字は退避済み
1B5C   11 0B 00               LXI   d,11   
1B5F   19                     DAD   d   
1B60   7E                     MOV   a,m   ; A = col_slot
1B61   32 54 29               STA   each_col_slot   
1B64   CD 00 29               CALL   each_block_args   
1B67                             ; 
1B67                ADV_REENTER:      
1B67                             ; PC = 0 で再実行
1B67   21 00 00               LXI   h,0   
1B6A   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
1B6D   C3 1B 1C               JMP   vm_loop   
1B70                             ; 
1B70                ADV_DONE:      
1B70                             ; 反復完了 → フレームを破棄して親に戻る
1B70                             ; **述語だけは R[0] を答えに書き換える** (止まったときの逆)
1B70   CD C4 1B               CALL   predicate_exhausted   
1B73                ADV_STOPPED:      
1B73                             ; 打ち切り。R[0] には predicate_decision が答えを書いてある
1B73   CD FF 16               CALL   pop_frame   
1B76   C3 1B 1C               JMP   vm_loop   
1B79                             ; 
1B79   00           ADV_KIND:   DB   0   
1B7A                             ; 
1B7A                             ; ===============================================================
1B7A                             ; predicate_decision — ブロックの値を見て打ち切るか決める
1B7A                             ; 
1B7A                             ;   入力: adv_kind (フレーム種別) / return_reg_a (ブロックの戻り値)
1B7A                             ;   出力: A = 1 なら打ち切った (R[0] に答えを書いた)、0 なら続ける
1B7A                             ; 
1B7A                             ; **R[0] を潰してよい。** もう要素を取り出さないので、レシーバの場所が
1B7A                             ; そのまま答えの置き場になる (呼んだ側の R[a] と同じ場所)。
1B7A                             ; 
1B7A                             ;   any?  真で止まって true、尽きたら false
1B7A                             ;   all?  偽で止まって false、尽きたら true
1B7A                             ;   none? 真で止まって false、尽きたら true
1B7A                             ; ===============================================================
1B7A                PREDICATE_DECISION:      
1B7A   3A 79 1B               LDA   adv_kind   
1B7D   FE 06                  CPI   FRAME_KIND_ANY   
1B7F   DA C1 1B               JC   pd_continue   ; ANY 未満 → 述語ではない
1B82                             ; 
1B82                             ; ブロックの戻り値の型タグ。TT_FALSE 以下が偽 (nil / false)
1B82   3A 0A 1B               LDA   return_reg_a   
1B85   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
1B88   7E                     MOV   a,m   ; A = 型タグ
1B89   FE 03                  CPI   TT_FALSE + 1   
1B8B   DA 9E 1B               JC   pd_falsy   
1B8E                             ; 
1B8E                             ; --- 真だった ---
1B8E   3A 79 1B               LDA   adv_kind   
1B91   FE 07                  CPI   FRAME_KIND_ALL   
1B93   CA C1 1B               JZ   pd_continue   ; all? は真では止まらない
1B96   FE 06                  CPI   FRAME_KIND_ANY   
1B98   CA A9 1B               JZ   pd_stop_true   ; any? → true
1B9B   C3 AE 1B               JMP   pd_stop_false   ; none? → false
1B9E                             ; 
1B9E                             ; --- 偽だった ---
1B9E                PD_FALSY:      
1B9E   3A 79 1B               LDA   adv_kind   
1BA1   FE 07                  CPI   FRAME_KIND_ALL   
1BA3   C2 C1 1B               JNZ   pd_continue   ; any? / none? は偽では止まらない
1BA6   C3 AE 1B               JMP   pd_stop_false   ; all? → false
1BA9                             ; 
1BA9                PD_STOP_TRUE:      
1BA9   3E 03                  MVI   a,TT_TRUE   
1BAB   C3 B0 1B               JMP   pd_write   
1BAE                PD_STOP_FALSE:      
1BAE   3E 02                  MVI   a,TT_FALSE   
1BB0                PD_WRITE:      
1BB0   32 C3 1B               STA   pd_tag   
1BB3   3E 00                  MVI   a,0   
1BB5   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1BB8   3A C3 1B               LDA   pd_tag   
1BBB   CD 1A 10               CALL   set_slot_special   
1BBE   3E 01                  MVI   a,1   ; 打ち切った
1BC0   C9                     RET      
1BC1                             ; 
1BC1                PD_CONTINUE:      
1BC1   AF                     XRA   a   
1BC2   C9                     RET      
1BC3                             ; 
1BC3   00           PD_TAG:   DB   0   
1BC4                             ; 
1BC4                             ; ===============================================================
1BC4                             ; predicate_exhausted — 最後まで打ち切られなかったときの答え
1BC4                             ; 
1BC4                             ; **止まったときの逆**です。any? は false、all? と none? は true。
1BC4                             ; 述語でなければ何もしません (R[0] のレシーバがそのまま値になる)。
1BC4                             ; ===============================================================
1BC4                PREDICATE_EXHAUSTED:      
1BC4   3A 79 1B               LDA   adv_kind   
1BC7   FE 06                  CPI   FRAME_KIND_ANY   
1BC9   DA E6 1B               JC   pe_ret   ; 述語ではない
1BCC   FE 06                  CPI   FRAME_KIND_ANY   
1BCE   CA D6 1B               JZ   pe_false   ; any? → 尽きたら false
1BD1   3E 03                  MVI   a,TT_TRUE   ; all? / none? → 尽きたら true
1BD3   C3 D8 1B               JMP   pe_write   
1BD6                PE_FALSE:      
1BD6   3E 02                  MVI   a,TT_FALSE   
1BD8                PE_WRITE:      
1BD8   32 E7 1B               STA   pe_tag   
1BDB   3E 00                  MVI   a,0   
1BDD   CD 00 10               CALL   get_reg_addr   ; HL = R[0]
1BE0   3A E7 1B               LDA   pe_tag   
1BE3   CD 1A 10               CALL   set_slot_special   
1BE6                PE_RET:      
1BE6   C9                     RET      
1BE7                             ; 
1BE7   00           PE_TAG:   DB   0   
1BE8                             ; 
1BE8                             ; ===============================================================
1BE8                             ; OP_STOP (Z): VM 停止
1BE8                             ; ===============================================================
1BE8                DO_OP_STOP:      
1BE8   3E 02                  MVI   a,VM_FINISHED   
1BEA   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1BED                             ; R[1] の値を 7 セグに表示
1BED   3E 01                  MVI   a,1   
1BEF   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
1BF2   CD 32 10               CALL   slot_to_value   ; HL = R[1] の値先頭
1BF5   CD 6F 1A               CALL   display_hex16   
1BF8   C3 09 1C               JMP   vm_halt   
1BFB                             ; 
1BFB                             ; ===============================================================
1BFB                             ; エラー停止
1BFB                             ; 
1BFB                             ; 未対応のオペコードを踏んだとき。
1BFB                             ; 現在のオペコードをエラーコードとして保存する。
1BFB                             ; ===============================================================
1BFB                VM_ERROR:      
1BFB   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1BFE   32 04 80               STA   VM_STATE_BASE + OFF_ERROR   
1C01   3E 03                  MVI   a,VM_ERROR   
1C03   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1C06   C3 09 1C               JMP   vm_halt   
1C09                             ; 
1C09                             ; ===============================================================
1C09                             ; 停止 — ND80Z モニタのリモートモードへ復帰
1C09                             ; 
1C09                             ; HLT だとリモートモードに戻るために手動リセット + [*(I/O)][8] が
1C09                             ; 必要になる。代わりに N80MON2D ジャンプテーブルの REMOTE エントリ
1C09                             ; (0821h) にジャンプする。REMOTE ルーチンは REMOTEMK=FFh を設定し、
1C09                             ; RST5/RST6 をリモート用ハンドラに差し替えてから START2 に入る。
1C09                             ; これにより自動的にリモートモードへ復帰する。
1C09                             ; エミュレータでは ROM 領域へのジャンプを検出して停止する。
1C09                             ; ===============================================================
1C09                VM_HALT:      
1C09                             ; LED 表示を約 3 秒間見せてからリモートモードへ復帰する。
1C09                             ; 外側ループ B=12, 内側ループ DE=0 (65536 回)
1C09                             ; 1 回 ≈ 24 クロック, 2.048 MHz → 約 0.77 秒/周 × 4 ≈ 3 秒
1C09   06 04                  MVI   b,4   
1C0B                VM_HALT_OUTER:      
1C0B   11 00 00               LXI   d,0   
1C0E                VM_HALT_INNER:      
1C0E   1B                     DCX   d   
1C0F   7A                     MOV   a,d   
1C10   B3                     ORA   e   
1C11   C2 0E 1C               JNZ   vm_halt_inner   
1C14   05                     DCR   b   
1C15   C2 0B 1C               JNZ   vm_halt_outer   
1C18   C3 21 08               JMP   00821h   ; N80MON2D REMOTE: リモートモード再入口
1C1B                             ; 
1C1B                             ; ===============================================================
1C1B                             ; 初期化 (vm_start) はディスパッチテーブル後の空き領域に配置
1C1B                             ; (0xA800+ エリア。起動時 1 回だけ呼ばれるためパフォーマンス影響なし)
1C1B                             ; ===============================================================
1C1B                             ; 
1C1B                             ; ===============================================================
1C1B                             ; メインループ (fetch-decode-execute)
1C1B                             ; ===============================================================
1C1B                VM_LOOP:      
1C1B                             ; --- 実行状態の確認 ---
1C1B   3A 02 80               LDA   VM_STATE_BASE + OFF_STATUS   
1C1E   FE 01                  CPI   VM_RUNNING   
1C20   C2 09 1C               JNZ   vm_halt   
1C23                             ; 
1C23                             ; --- PC がバイトコード長を超えていないか ---
1C23   2A 00 80               LHLD   VM_STATE_BASE + OFF_PC   
1C26   EB                     XCHG      ; DE = PC
1C27   2A 0E 80               LHLD   VM_STATE_BASE + OFF_BYTECODE_LEN   
1C2A                             ; HL = bytecode_len, DE = PC
1C2A                             ; PC >= bytecode_len ならエラー
1C2A   7B                     MOV   a,e   
1C2B   95                     SUB   l   
1C2C   7A                     MOV   a,d   
1C2D   9C                     SBB   h   ; DE - HL (PC - len)
1C2E   D2 03 00               JNC   vm_error   ; PC >= len → エラー
1C31                             ; 
1C31                             ; --- オペコードフェッチ ---
1C31   CD C0 10               CALL   fetch_byte   ; A = opcode
1C34   32 0A 80               STA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1C37                             ; 
1C37                             ; --- ステップカウント ---
1C37   2A 06 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1C3A   23                     INX   h   
1C3B   22 06 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT   
1C3E                             ; 上位 16 ビットの桁上げ (HL が 0 に戻ったとき)
1C3E   7C                     MOV   a,h   
1C3F   B5                     ORA   l   
1C40   C2 4A 1C               JNZ   vm_dispatch   
1C43   2A 08 80               LHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1C46   23                     INX   h   
1C47   22 08 80               SHLD   VM_STATE_BASE + OFF_STEP_COUNT + 2   
1C4A                             ; 
1C4A                             ; --- ディスパッチ ---
1C4A                VM_DISPATCH:      
1C4A   3A 0A 80               LDA   VM_STATE_BASE + OFF_CURRENT_OPCODE   
1C4D                             ; オペコード × 2 でジャンプテーブルのオフセットを求める
1C4D   87                     ADD   a   ; A = opcode * 2 (テーブルエントリは 2 バイト)
1C4E   DA 03 00               JC   vm_error   ; オーバーフロー → 未対応
1C51   5F                     MOV   e,a   
1C52   16 00                  MVI   d,0   ; DE = opcode * 2
1C54   21 6C 1C               LXI   h,dispatch_table   
1C57   19                     DAD   d   ; HL = &dispatch_table[opcode]
1C58                             ; テーブル上限チェック
1C58   11 40 1D               LXI   d,dispatch_table_end   
1C5B   7B                     MOV   a,e   
1C5C   95                     SUB   l   
1C5D   7A                     MOV   a,d   
1C5E   9C                     SBB   h   ; DE - HL → dispatch_table_end - 現在位置
1C5F   DA 03 00               JC   vm_error   ; テーブル範囲外
1C62                             ; アドレスを読んでジャンプ
1C62   5E                     MOV   e,m   ; E = 下位バイト
1C63   23                     INX   h   
1C64   56                     MOV   d,m   ; D = 上位バイト
1C65   EB                     XCHG      ; HL = ハンドラアドレス
1C66                             ; 0000h ならエラー (未実装マーカー)
1C66   7C                     MOV   a,h   
1C67   B5                     ORA   l   
1C68   CA 03 00               JZ   vm_error   
1C6B   E9                     PCHL      ; ハンドラへジャンプ
1C6C                             ; 
1C6C                             ; ===============================================================
1C6C                             ; ディスパッチテーブル
1C6C                             ; 
1C6C                             ; オペコード番号順に 2 バイトのアドレスを並べる。
1C6C                             ; 未実装のオペコードは 0000h (vm_error で捕捉)。
1C6C                             ; ===============================================================
1C6C                DISPATCH_TABLE:      
1C6C   DE 10                  DW   do_op_nop   ; 00 OP_NOP
1C6E   E1 10                  DW   do_op_move   ; 01 OP_MOVE
1C70   00 00                  DW   0000h   ; 02 OP_LOADL
1C72   F7 10                  DW   do_op_loadi   ; 03 OP_LOADI
1C74   0C 11                  DW   do_op_loadineg   ; 04 OP_LOADINEG
1C76   23 11                  DW   do_op_loadi__1   ; 05 OP_LOADI__1
1C78   33 11                  DW   do_op_loadi_0   ; 06 OP_LOADI_0
1C7A   38 11                  DW   do_op_loadi_1   ; 07 OP_LOADI_1
1C7C   3D 11                  DW   do_op_loadi_2   ; 08 OP_LOADI_2
1C7E   42 11                  DW   do_op_loadi_3   ; 09 OP_LOADI_3
1C80   47 11                  DW   do_op_loadi_4   ; 0A OP_LOADI_4
1C82   4C 11                  DW   do_op_loadi_5   ; 0B OP_LOADI_5
1C84   51 11                  DW   do_op_loadi_6   ; 0C OP_LOADI_6
1C86   56 11                  DW   do_op_loadi_7   ; 0D OP_LOADI_7
1C88   66 11                  DW   do_op_loadi16   ; 0E OP_LOADI16
1C8A   00 00                  DW   0000h   ; 0F OP_LOADI32
1C8C   00 00                  DW   0000h   ; 10 OP_LOADSYM
1C8E   7F 11                  DW   do_op_loadnil   ; 11 OP_LOADNIL
1C90   69 17                  DW   do_op_loadself   ; 12 OP_LOADSELF
1C92   8D 11                  DW   do_op_loadt   ; 13 OP_LOADT
1C94   9B 11                  DW   do_op_loadf   ; 14 OP_LOADF
1C96   CA 13                  DW   do_op_getgv   ; 15 OP_GETGV
1C98   0C 14                  DW   do_op_setgv   ; 16 OP_SETGV
1C9A   00 00                  DW   0000h   ; 17 OP_GETSV
1C9C   00 00                  DW   0000h   ; 18 OP_SETSV
1C9E   CA 13                  DW   do_op_getgv   ; 19 OP_GETIV (= OP_GETGV)
1CA0   0C 14                  DW   do_op_setgv   ; 1A OP_SETIV (= OP_SETGV)
1CA2   CA 13                  DW   do_op_getgv   ; 1B OP_GETCV (= OP_GETGV)
1CA4   0C 14                  DW   do_op_setgv   ; 1C OP_SETCV (= OP_SETGV)
1CA6   13 1A                  DW   do_op_getconst   ; 1D OP_GETCONST
1CA8   0C 14                  DW   do_op_setgv   ; 1E OP_SETCONST (= OP_SETGV)
1CAA   00 00                  DW   0000h   ; 1F OP_GETMCNST
1CAC   00 00                  DW   0000h   ; 20 OP_SETMCNST
1CAE   21 19                  DW   do_op_getupvar   ; 21 OP_GETUPVAR
1CB0   4D 19                  DW   do_op_setupvar   ; 22 OP_SETUPVAR
1CB2   6A 20                  DW   do_op_getidx   ; 23 OP_GETIDX
1CB4   11 21                  DW   do_op_setidx   ; 24 OP_SETIDX
1CB6   83 13                  DW   do_op_jmp   ; 25 OP_JMP
1CB8   8C 13                  DW   do_op_jmpif   ; 26 OP_JMPIF
1CBA   AB 13                  DW   do_op_jmpnot   ; 27 OP_JMPNOT
1CBC   00 00                  DW   0000h   ; 28 OP_JMPNIL
1CBE   83 13                  DW   do_op_jmp   ; 29 OP_JMPUW (= OP_JMP)
1CC0   00 00                  DW   0000h   ; 2A OP_EXCEPT
1CC2   00 00                  DW   0000h   ; 2B OP_RESCUE
1CC4   00 00                  DW   0000h   ; 2C OP_RAISEIF
1CC6   6D 14                  DW   do_op_ssend   ; 2D OP_SSEND
1CC8   B6 17                  DW   do_op_ssendb   ; 2E OP_SSENDB
1CCA   8E 14                  DW   do_op_send   ; 2F OP_SEND
1CCC   DC 17                  DW   do_op_sendb   ; 30 OP_SENDB
1CCE   00 00                  DW   0000h   ; 31 OP_CALL
1CD0   00 00                  DW   0000h   ; 32 OP_SUPER
1CD2   00 00                  DW   0000h   ; 33 OP_ARGARY
1CD4   AA 17                  DW   do_op_enter   ; 34 OP_ENTER
1CD6   00 00                  DW   0000h   ; 35 OP_KEY_P
1CD8   00 00                  DW   0000h   ; 36 OP_KEYEND
1CDA   00 00                  DW   0000h   ; 37 OP_KARG
1CDC   B7 1A                  DW   do_op_return   ; 38 OP_RETURN
1CDE   00 00                  DW   0000h   ; 39 OP_RETURN_BLK
1CE0   D2 18                  DW   do_op_break   ; 3A OP_BREAK
1CE2   00 00                  DW   0000h   ; 3B OP_BLKPUSH
1CE4   A9 11                  DW   do_op_add   ; 3C OP_ADD
1CE6   EB 11                  DW   do_op_addi   ; 3D OP_ADDI
1CE8   D3 11                  DW   do_op_sub   ; 3E OP_SUB
1CEA   05 12                  DW   do_op_subi   ; 3F OP_SUBI
1CEC   1F 12                  DW   do_op_mul   ; 40 OP_MUL
1CEE   43 12                  DW   do_op_div   ; 41 OP_DIV
1CF0   22 13                  DW   do_op_eq   ; 42 OP_EQ
1CF2   4C 13                  DW   do_op_lt   ; 43 OP_LT
1CF4   56 13                  DW   do_op_le   ; 44 OP_LE
1CF6   63 13                  DW   do_op_gt   ; 45 OP_GT
1CF8   70 13                  DW   do_op_ge   ; 46 OP_GE
1CFA   C7 21                  DW   do_op_array   ; 47 OP_ARRAY
1CFC   41 24                  DW   do_op_array2   ; 48 OP_ARRAY2
1CFE   00 00                  DW   0000h   ; 49 OP_ARYCAT
1D00   43 22                  DW   do_op_arypush   ; 4A OP_ARYPUSH
1D02   00 00                  DW   0000h   ; 4B OP_ARYSPLAT
1D04   00 00                  DW   0000h   ; 4C OP_AREF
1D06   00 00                  DW   0000h   ; 4D OP_ASET
1D08   00 00                  DW   0000h   ; 4E OP_APOST
1D0A   00 00                  DW   0000h   ; 4F OP_INTERN
1D0C   00 00                  DW   0000h   ; 50 OP_SYMBOL
1D0E   C8 1D                  DW   do_op_string   ; 51 OP_STRING
1D10   BB 22                  DW   do_op_strcat   ; 52 OP_STRCAT
1D12   53 24                  DW   do_op_hash   ; 53 OP_HASH
1D14   00 00                  DW   0000h   ; 54 OP_HASHADD
1D16   00 00                  DW   0000h   ; 55 OP_HASHCAT
1D18   00 00                  DW   0000h   ; 56 OP_LAMBDA
1D1A   7D 17                  DW   do_op_block   ; 57 OP_BLOCK
1D1C   8B 19                  DW   do_op_method   ; 58 OP_METHOD
1D1E   00 00                  DW   0000h   ; 59 OP_RANGE_INC
1D20   00 00                  DW   0000h   ; 5A OP_RANGE_EXC
1D22   00 00                  DW   0000h   ; 5B OP_OCLASS
1D24   13 1A                  DW   do_op_class   ; 5C OP_CLASS
1D26   00 00                  DW   0000h   ; 5D OP_MODULE
1D28   45 1A                  DW   do_op_exec   ; 5E OP_EXEC
1D2A   AC 19                  DW   do_op_def   ; 5F OP_DEF
1D2C   00 00                  DW   0000h   ; 60 OP_ALIAS
1D2E   00 00                  DW   0000h   ; 61 OP_UNDEF
1D30   00 00                  DW   0000h   ; 62 OP_SCLASS
1D32   79 19                  DW   do_op_tclass   ; 63 OP_TCLASS
1D34   00 00                  DW   0000h   ; 64 OP_DEBUG
1D36   00 00                  DW   0000h   ; 65 OP_ERR
1D38   00 00                  DW   0000h   ; 66 OP_EXT1
1D3A   00 00                  DW   0000h   ; 67 OP_EXT2
1D3C   00 00                  DW   0000h   ; 68 OP_EXT3
1D3E   E8 1B                  DW   do_op_stop   ; 69 OP_STOP
1D40                DISPATCH_TABLE_END:      
1D40                             ; 
1D40                             ; ===============================================================
1D40                             ; clear_pages — B ページ (256 バイト × B) をゼロクリア
1D40                             ; 
1D40                             ; 入力: HL = 先頭アドレス, B = ページ数
1D40                             ; 破壊: A, B, C, HL
1D40                             ; ===============================================================
1D40                CLEAR_PAGES:      
1D40   0E 00                  MVI   c,0   ; 256 回
1D42                CLEAR_PAGES_BYTE:      
1D42   36 00                  MVI   m,0   
1D44   23                     INX   h   
1D45   0D                     DCR   c   
1D46   C2 42 1D               JNZ   clear_pages_byte   
1D49   05                     DCR   b   
1D4A   C2 40 1D               JNZ   clear_pages   
1D4D   C9                     RET      
1D4E                             ; 
1D4E                             ; ===============================================================
1D4E                             ; 初期化 (起動時 1 回だけ)
1D4E                             ; SP とバンク切り替えは起動スタブ (0x8400) で設定済み。
1D4E                             ; ===============================================================
1D4E                VM_START:      
1D4E                             ; VM 状態領域をゼロクリア (256 バイト = 1 ページ)
1D4E   21 00 80               LXI   h,VM_STATE_BASE   
1D51   06 01                  MVI   b,1   
1D53   CD 40 1D               CALL   clear_pages   
1D56                             ; 
1D56                             ; レジスタファイルをゼロクリア (256 バイト = 1 ページ)
1D56   21 00 81               LXI   h,REG_FILE_BASE   
1D59   06 01                  MVI   b,1   
1D5B   CD 40 1D               CALL   clear_pages   
1D5E                             ; 
1D5E                             ; メソッド表をゼロクリア (256 バイト = 1 ページ)
1D5E   21 C0 91               LXI   h,METHOD_TABLE_BASE   
1D61   06 01                  MVI   b,1   
1D63   CD 40 1D               CALL   clear_pages   
1D66                             ; 
1D66                             ; オブジェクトプールをゼロクリア (1024 バイト = 4 ページ)
1D66   21 C0 92               LXI   h,OBJECT_POOL_BASE   
1D69   06 04                  MVI   b,4   
1D6B   CD 40 1D               CALL   clear_pages   
1D6E                             ; 
1D6E                             ; コレクションプールをゼロクリア (2304 バイト = 9 ページ)
1D6E   21 C0 96               LXI   h,COLLECTION_POOL_BASE   
1D71   06 09                  MVI   b,9   
1D73   CD 40 1D               CALL   clear_pages   
1D76                             ; 
1D76                             ; IREP 0 のバイトコード長を VM 状態に設定
1D76                             ; IREP テーブルの先頭エントリから読む
1D76   3A 02 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN   
1D79   32 0E 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN   
1D7C   3A 03 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE_LEN + 1   
1D7F   32 0F 80               STA   VM_STATE_BASE + OFF_BYTECODE_LEN + 1   
1D82                             ; 
1D82                             ; レジスタベースを初期化 (REG_FILE_BASE)
1D82   21 00 81               LXI   h,REG_FILE_BASE   
1D85   22 14 80               SHLD   VM_STATE_BASE + OFF_REG_BASE   
1D88                             ; 
1D88                             ; バイトコードベースを IREP 0 から読んで設定
1D88   3A 00 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE   
1D8B   32 16 80               STA   VM_STATE_BASE + OFF_BC_BASE   
1D8E   3A 01 82               LDA   IREP_TABLE_BASE + IREP_OFF_BYTECODE + 1   
1D91   32 17 80               STA   VM_STATE_BASE + OFF_BC_BASE + 1   
1D94                             ; 
1D94                             ; シンボルテーブルベースを IREP 0 から読んで設定
1D94   3A 08 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE   
1D97   32 19 80               STA   VM_STATE_BASE + OFF_SYM_BASE   
1D9A   3A 09 82               LDA   IREP_TABLE_BASE + IREP_OFF_SYM_TABLE + 1   
1D9D   32 1A 80               STA   VM_STATE_BASE + OFF_SYM_BASE + 1   
1DA0                             ; 
1DA0                             ; 定数プールベースを IREP 0 から読んで設定
1DA0   3A 04 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL   
1DA3   32 1D 80               STA   VM_STATE_BASE + OFF_POOL_BASE   
1DA6   3A 05 82               LDA   IREP_TABLE_BASE + IREP_OFF_POOL + 1   
1DA9   32 1E 80               STA   VM_STATE_BASE + OFF_POOL_BASE + 1   
1DAC                             ; 
1DAC                             ; フレーム SP = 0 (ゼロクリア済み)
1DAC                             ; PC = 0 (ゼロクリア済み)
1DAC                             ; 
1DAC                             ; INIT_METHOD_ID を INIT_METHOD_ID_STORE から読み込む
1DAC                             ; (VM 状態クリアで消されないよう、IREP テーブルページに配置されている)
1DAC   3A FE 82               LDA   INIT_METHOD_ID_STORE   
1DAF   32 1C 80               STA   VM_STATE_BASE + OFF_INIT_METHOD_ID   
1DB2                             ; 
1DB2                             ; R[0] = self (TT_OBJECT, 値 = 0)
1DB2   21 00 81               LXI   h,REG_FILE_BASE   
1DB5   36 0A                  MVI   m,TT_OBJECT   ; +0: 型タグ
1DB7   23                     INX   h   
1DB8   36 00                  MVI   m,0   ; +1: 予約
1DBA   23                     INX   h   
1DBB   36 00                  MVI   m,0   ; +2: val_lo
1DBD   23                     INX   h   
1DBE   36 00                  MVI   m,0   ; +3: val_hi
1DC0                             ; 
1DC0                             ; 実行状態を RUNNING に設定
1DC0   3E 01                  MVI   a,VM_RUNNING   
1DC2   32 02 80               STA   VM_STATE_BASE + OFF_STATUS   
1DC5                             ; 
1DC5                             ; メインループへ
1DC5   C3 1B 1C               JMP   vm_loop   
1DC8                             ; 
1DC8                             ; ===============================================================
1DC8                             ; OP_STRING (BB): R[a] = 文字列リテラル (コレクションプールにコピー)
1DC8                             ; 
1DC8                             ; Pool[b] は TT_STRING + 文字列データアドレスの 4 バイトスロット。
1DC8                             ; 文字列データをコレクションプールにコピーし、R[a] にスロット番号を設定。
1DC8                             ; ===============================================================
1DC8                DO_OP_STRING:      
1DC8   CD C0 10               CALL   fetch_byte   ; A = a
1DCB   32 25 1E               STA   ops_reg_a   
1DCE   CD C0 10               CALL   fetch_byte   ; A = b (プールインデックス)
1DD1                             ; pool_base + b * 4 を計算
1DD1   87                     ADD   a   ; b * 2
1DD2   87                     ADD   a   ; b * 4
1DD3   5F                     MOV   e,a   
1DD4   16 00                  MVI   d,0   
1DD6   2A 1D 80               LHLD   VM_STATE_BASE + OFF_POOL_BASE   
1DD9   19                     DAD   d   ; HL = &Pool[b]
1DDA                             ; Pool[b] の val (文字列データアドレス) を取得
1DDA   23                     INX   h   ; +1: 予約
1DDB   23                     INX   h   ; +2: val_lo
1DDC   5E                     MOV   e,m   
1DDD   23                     INX   h   ; +3: val_hi
1DDE   56                     MOV   d,m   ; DE = 文字列データアドレス
1DDF                             ; DE → 長さバイト + ASCII データ
1DDF   1A                     LDAX   d   ; A = 文字列長
1DE0   32 26 1E               STA   ops_str_len   
1DE3   13                     INX   d   ; DE → 最初のバイト
1DE4   D5                     PUSH   d   ; 文字列データソース退避
1DE5                             ; 
1DE5                             ; コレクションスロットを確保
1DE5   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
1DE8   32 27 1E               STA   ops_slot_num   
1DEB                             ; 
1DEB                             ; スロットヘッダ: type=COL_TYPE_STRING, count=文字列長
1DEB   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
1DED   23                     INX   h   
1DEE   3A 26 1E               LDA   ops_str_len   
1DF1   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
1DF3   DA F8 1D               JC   ops_len_ok   
1DF6   3E 22                  MVI   a,COL_MAX_STRING_LEN   ; 最大 30 文字に切り詰め
1DF8                OPS_LEN_OK:      
1DF8   77                     MOV   m,a   ; +1: count
1DF9   32 26 1E               STA   ops_str_len   ; 切り詰め後の長さ
1DFC   23                     INX   h   ; HL → データ領域先頭
1DFD                             ; 
1DFD                             ; 文字列データをコピー
1DFD   D1                     POP   d   ; DE = ソースデータ
1DFE   3A 26 1E               LDA   ops_str_len   
1E01   B7                     ORA   a   
1E02   CA 0E 1E               JZ   ops_set_reg   ; 空文字列
1E05   4F                     MOV   c,a   
1E06                OPS_STR_COPY:      
1E06   1A                     LDAX   d   
1E07   77                     MOV   m,a   
1E08   23                     INX   h   
1E09   13                     INX   d   
1E0A   0D                     DCR   c   
1E0B   C2 06 1E               JNZ   ops_str_copy   
1E0E                             ; 
1E0E                OPS_SET_REG:      
1E0E                             ; R[a] = TT_STRING, val_lo = slot+1
1E0E   3A 25 1E               LDA   ops_reg_a   
1E11   CD 00 10               CALL   get_reg_addr   ; HL = &R[a]
1E14   36 07                  MVI   m,TT_STRING   ; +0: 型タグ
1E16   23                     INX   h   
1E17   36 00                  MVI   m,0   ; +1: 予約
1E19   23                     INX   h   
1E1A   3A 27 1E               LDA   ops_slot_num   
1E1D   3C                     INR   a   ; slot + 1
1E1E   77                     MOV   m,a   ; +2: val_lo
1E1F   23                     INX   h   
1E20   36 00                  MVI   m,0   ; +3: val_hi
1E22   C3 1B 1C               JMP   vm_loop   
1E25                             ; 
1E25   00           OPS_REG_A:   DB   0   
1E26   00           OPS_STR_LEN:   DB   0   
1E27   00           OPS_SLOT_NUM:   DB   0   
1E28                             ; 
1E28                             ; ===============================================================
1E28                             ; send_display — display(value): 7 セグに hex 表示
1E28                             ; 
1E28                             ; R[a+1] の 16 ビット値を display_hex16 で DISPLAY_BASE に書く。
1E28                             ; R[a] に nil を返す。
1E28                             ; ===============================================================
1E28                SEND_DISPLAY:      
1E28   3A 55 16               LDA   send_reg_a   
1E2B   3C                     INR   a   
1E2C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1E2F   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
1E32   CD 6F 1A               CALL   display_hex16   ; 7 セグに書く
1E35                             ; return nil
1E35   3A 55 16               LDA   send_reg_a   
1E38   CD 00 10               CALL   get_reg_addr   
1E3B   3E 01                  MVI   a,TT_NIL   
1E3D   CD 1A 10               CALL   set_slot_special   
1E40   C3 1B 1C               JMP   vm_loop   
1E43                             ; 
1E43                             ; ===============================================================
1E43                             ; send_getkey — getkey / getkey(timeout)
1E43                             ; 
1E43                             ; getkey (引数なし): KEYIN1 でブロッキング入力
1E43                             ;   ROM なし → -1
1E43                             ;   キー押下 → キーコード (0x00-0x17)
1E43                             ; 
1E43                             ; getkey(n) (引数あり): KEY でノンブロッキングポーリング
1E43                             ;   最大 n 回スキャン、キー押下 → キーコード
1E43                             ;   タイムアウト / ROM なし → nil
1E43                             ; 
1E43                             ; キーコード割り当て (KEYIN1/KEY 共通):
1E43                             ;   0x00-0x09: 0-9          0x10: RUN      0x14: RD INC
1E43                             ;   0x0A-0x0F: A-F          0x11: RET      0x15: WR INC
1E43                             ;   0x12: ADRS SET          0x13: RD DEC   0x16: STORE
1E43                             ;                                           0x17: LOAD
1E43                             ; ===============================================================
1E43                SEND_GETKEY:      
1E43                             ; 引数ありならタイムアウト版へ (オーバーフロー領域)
1E43   3A 56 16               LDA   send_argc   
1E46   B7                     ORA   a   
1E47   C2 C2 25               JNZ   send_getkey_timeout   
1E4A                             ; 
1E4A                             ; --- ブロッキング版 (引数なし) ---
1E4A   3A 16 06               LDA   KEYIN1_ADDR   ; ROM 先頭バイト
1E4D   B7                     ORA   a   
1E4E   CA 6E 1E               JZ   getkey_no_key   ; ROM なし → -1
1E51                             ; 
1E51                             ; キー入力をポーリングしながら LFSR を回す。
1E51                             ; ユーザーがキーを押すタイミングで LFSR 状態が変わるため、
1E51                             ; 乱数の種が毎回異なる。
1E51                GETKEY_POLL:      
1E51   CD 47 06               CALL   KEY_ADDR   ; A = キーコード (0xFF = なし)
1E54   FE FF                  CPI   0FFh   
1E56   C2 5F 1E               JNZ   getkey_got_key   
1E59   CD DE 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
1E5C   C3 51 1E               JMP   getkey_poll   
1E5F                             ; 
1E5F                GETKEY_GOT_KEY:      
1E5F                             ; キーコードを R[a] に返す
1E5F   4F                     MOV   c,a   
1E60   06 00                  MVI   b,0   
1E62   3A 55 16               LDA   send_reg_a   
1E65   CD 00 10               CALL   get_reg_addr   
1E68   CD 10 10               CALL   set_slot_int16   
1E6B   C3 1B 1C               JMP   vm_loop   
1E6E                             ; 
1E6E                GETKEY_NO_KEY:      
1E6E   3A 55 16               LDA   send_reg_a   
1E71   CD 00 10               CALL   get_reg_addr   
1E74   06 FF                  MVI   b,0FFh   
1E76   0E FF                  MVI   c,0FFh   ; -1
1E78   CD 10 10               CALL   set_slot_int16   
1E7B   C3 1B 1C               JMP   vm_loop   
1E7E                             ; 
1E7E                             ; ===============================================================
1E7E                             ; send_builtin_ext — 拡張ビルトインメソッドディスパッチ
1E7E                             ; 
1E7E                             ; vm_send.a80 のメインディスパッチに入りきらないメソッドをここで振り分ける。
1E7E                             ; E レジスタにメソッド ID が入っている。
1E7E                             ; ===============================================================
1E7E                SEND_BUILTIN_EXT:      
1E7E   7B                     MOV   a,e   
1E7F   FE 1F                  CPI   METHOD_PUTS   
1E81   CA A5 1E               JZ   send_puts   
1E84   FE 20                  CPI   METHOD_SETSEG   
1E86   CA 49 1F               JZ   send_setseg   
1E89   FE 21                  CPI   METHOD_RAND   
1E8B   CA 03 20               JZ   send_rand   
1E8E   FE 12                  CPI   METHOD_LENGTH   
1E90   CA 37 23               JZ   send_length   
1E93   FE 14                  CPI   METHOD_CONCAT   
1E95   CA 50 23               JZ   send_concat   
1E98   FE 16                  CPI   METHOD_PUSH   
1E9A   CA 0E 24               JZ   concat_array   ; push は concat_array と同じ
1E9D   FE 22                  CPI   METHOD_SLICE   
1E9F   CA 0B 26               JZ   send_slice   
1EA2   C3 03 00               JMP   vm_error   ; 未対応メソッド
1EA5                             ; 
1EA5                             ; ===============================================================
1EA5                             ; send_puts — puts(value): 文字列を 7 セグに表示
1EA5                             ; 
1EA5                             ; R[a+1] が TT_STRING の場合:
1EA5                             ;   文字列データのアドレスから長さとバイト列を読み、
1EA5                             ;   各 ASCII コードを 7 セグパターンに変換して表示する。
1EA5                             ;   8 桁全体をクリアしてから左詰めで書く (最大 8 文字)。
1EA5                             ; 
1EA5                             ; R[a+1] が TT_INTEGER の場合:
1EA5                             ;   16 ビット値を高位・低位バイトに分け、2 文字として表示。
1EA5                             ;   表示バッファは左に 2 桁スクロールする (従来互換)。
1EA5                             ; 
1EA5                             ; 使い方:
1EA5                             ;   puts "HELLO"          # 文字列を表示
1EA5                             ;   puts(0x4849)          # "HI" を表示 (整数パック)
1EA5                             ; ===============================================================
1EA5                SEND_PUTS:      
1EA5   3A 55 16               LDA   send_reg_a   
1EA8   3C                     INR   a   
1EA9   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1EAC   7E                     MOV   a,m   ; A = 型タグ
1EAD   FE 07                  CPI   TT_STRING   
1EAF   CA E9 1E               JZ   puts_string   
1EB2                             ; TT_INTEGER: 従来のパック ASCII 処理
1EB2   FE 04                  CPI   TT_INTEGER   
1EB4   C2 03 00               JNZ   vm_error   
1EB7                             ; 
1EB7                             ; --- 整数パス (2 文字スクロール表示) ---
1EB7   3A 55 16               LDA   send_reg_a   
1EBA   3C                     INR   a   
1EBB   CD 00 10               CALL   get_reg_addr   
1EBE   CD 32 10               CALL   slot_to_value   ; HL = 値先頭 (val_lo)
1EC1   4E                     MOV   c,m   ; C = val_lo (右の文字)
1EC2   23                     INX   h   
1EC3   46                     MOV   b,m   ; B = val_hi (左の文字)
1EC4   C5                     PUSH   b   
1EC5                             ; 
1EC5                             ; 表示バッファを左に 2 桁スクロール
1EC5   21 FA FF               LXI   h,DISPLAY_BASE + 2   
1EC8   11 F8 FF               LXI   d,DISPLAY_BASE   
1ECB   06 06                  MVI   b,6   
1ECD                PUTS_SCROLL:      
1ECD   7E                     MOV   a,m   
1ECE   12                     STAX   d   
1ECF   23                     INX   h   
1ED0   13                     INX   d   
1ED1   05                     DCR   b   
1ED2   C2 CD 1E               JNZ   puts_scroll   
1ED5                             ; 
1ED5   C1                     POP   b   
1ED6   C5                     PUSH   b   
1ED7   78                     MOV   a,b   
1ED8   CD 82 1F               CALL   ascii_to_seg   
1EDB   32 FE FF               STA   DISPLAY_BASE + 6   
1EDE                             ; 
1EDE   C1                     POP   b   
1EDF   79                     MOV   a,c   
1EE0   CD 82 1F               CALL   ascii_to_seg   
1EE3   32 FF FF               STA   DISPLAY_BASE + 7   
1EE6   C3 36 1F               JMP   puts_ret_nil   
1EE9                             ; 
1EE9                             ; --- 文字列パス (全桁クリア + 左詰め表示) ---
1EE9                PUTS_STRING:      
1EE9   3A 55 16               LDA   send_reg_a   
1EEC   3C                     INR   a   
1EED   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1EF0   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロットアドレス
1EF3                             ; 
1EF3                             ; +1: count (文字列長)
1EF3   23                     INX   h   
1EF4   7E                     MOV   a,m   ; A = 文字列長
1EF5   B7                     ORA   a   
1EF6   CA 36 1F               JZ   puts_ret_nil   ; 空文字列 → nil を返すだけ
1EF9   FE 09                  CPI   9   
1EFB   DA 00 1F               JC   sp_len_ok   
1EFE   3E 08                  MVI   a,8   ; 最大 8 文字
1F00                SP_LEN_OK:      
1F00   32 44 1F               STA   sp_count   
1F03   23                     INX   h   ; HL → データ領域先頭
1F04   22 45 1F               SHLD   sp_src   ; 文字列ソースポインタ退避
1F07                             ; 
1F07                             ; 表示バッファ全体をクリア
1F07   21 F8 FF               LXI   h,DISPLAY_BASE   
1F0A   0E 08                  MVI   c,DISPLAY_SIZE   
1F0C                PUTS_STR_CLEAR:      
1F0C   36 00                  MVI   m,0   
1F0E   23                     INX   h   
1F0F   0D                     DCR   c   
1F10   C2 0C 1F               JNZ   puts_str_clear   
1F13                             ; 
1F13                             ; 文字列の各バイトを変換して表示
1F13   21 F8 FF               LXI   h,DISPLAY_BASE   
1F16   22 47 1F               SHLD   sp_dst   ; 表示書き込みポインタ
1F19                PUTS_STR_LOOP:      
1F19   2A 45 1F               LHLD   sp_src   
1F1C   7E                     MOV   a,m   ; A = ASCII コード
1F1D   23                     INX   h   
1F1E   22 45 1F               SHLD   sp_src   
1F21   CD 82 1F               CALL   ascii_to_seg   ; A = セグメントパターン (HL, BC 破壊)
1F24   2A 47 1F               LHLD   sp_dst   
1F27   77                     MOV   m,a   
1F28   23                     INX   h   
1F29   22 47 1F               SHLD   sp_dst   
1F2C   3A 44 1F               LDA   sp_count   
1F2F   3D                     DCR   a   
1F30   32 44 1F               STA   sp_count   
1F33   C2 19 1F               JNZ   puts_str_loop   
1F36                             ; 
1F36                PUTS_RET_NIL:      
1F36   3A 55 16               LDA   send_reg_a   
1F39   CD 00 10               CALL   get_reg_addr   
1F3C   3E 01                  MVI   a,TT_NIL   
1F3E   CD 1A 10               CALL   set_slot_special   
1F41   C3 1B 1C               JMP   vm_loop   
1F44                             ; 
1F44   00           SP_COUNT:   DB   0   
1F45   00 00        SP_SRC:   DW   0   
1F47   00 00        SP_DST:   DW   0   
1F49                             ; 
1F49                             ; ===============================================================
1F49                             ; send_setseg — setseg(pos, pattern): 7 セグに任意パターンを設定
1F49                             ; 
1F49                             ; R[a+1] = 桁位置 (0-7), R[a+2] = 生セグメントパターン (0x00-0x7F)
1F49                             ; ===============================================================
1F49                SEND_SETSEG:      
1F49                             ; 桁位置を取得
1F49   3A 55 16               LDA   send_reg_a   
1F4C   3C                     INR   a   
1F4D   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
1F50   CD 32 10               CALL   slot_to_value   
1F53   7E                     MOV   a,m   ; A = 桁位置 (val_lo)
1F54   FE 08                  CPI   DISPLAY_SIZE   
1F56   D2 03 00               JNC   vm_error   ; 桁位置 >= 8 → エラー
1F59   32 81 1F               STA   ss_pos   
1F5C                             ; 
1F5C                             ; パターンを取得
1F5C   3A 55 16               LDA   send_reg_a   
1F5F   3C                     INR   a   
1F60   3C                     INR   a   
1F61   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
1F64   CD 32 10               CALL   slot_to_value   
1F67   46                     MOV   b,m   ; B = パターン (val_lo)
1F68                             ; 
1F68                             ; DISPLAY_BASE + pos にパターンを書く
1F68   3A 81 1F               LDA   ss_pos   
1F6B   6F                     MOV   l,a   
1F6C   26 00                  MVI   h,0   
1F6E   11 F8 FF               LXI   d,DISPLAY_BASE   
1F71   19                     DAD   d   ; HL = DISPLAY_BASE + pos
1F72   70                     MOV   m,b   
1F73                             ; 
1F73                             ; R[a] に nil を返す
1F73   3A 55 16               LDA   send_reg_a   
1F76   CD 00 10               CALL   get_reg_addr   
1F79   3E 01                  MVI   a,TT_NIL   
1F7B   CD 1A 10               CALL   set_slot_special   
1F7E   C3 1B 1C               JMP   vm_loop   
1F81                             ; 
1F81   00           SS_POS:   DB   0   
1F82                             ; 
1F82                             ; ===============================================================
1F82                             ; ascii_to_seg — ASCII コードを 7 セグパターンに変換
1F82                             ; 
1F82                             ;   入力: A = ASCII コード
1F82                             ;   出力: A = セグメントパターン
1F82                             ;   破壊: HL, BC
1F82                             ; 
1F82                             ; 0x60-0x7F (小文字) は 0x20 を引いて大文字に折り畳む。
1F82                             ; 0x20-0x5F は 64 エントリのテーブルで変換する。
1F82                             ; 範囲外はブランク (0x00) を返す。
1F82                             ; ===============================================================
1F82                ASCII_TO_SEG:      
1F82   FE 60                  CPI   60h   
1F84   DA 89 1F               JC   ats_no_fold   
1F87   D6 20                  SUI   20h   ; 小文字 → 大文字 (0x60-0x7F → 0x40-0x5F)
1F89                ATS_NO_FOLD:      
1F89   D6 20                  SUI   20h   ; 0x20-0x5F → 0x00-0x3F
1F8B   DA 9C 1F               JC   ats_blank   ; 元が < 0x20 → ブランク
1F8E   FE 40                  CPI   40h   
1F90   D2 9C 1F               JNC   ats_blank   ; >= 64 → ブランク
1F93                             ; テーブル参照
1F93   6F                     MOV   l,a   
1F94   26 00                  MVI   h,0   
1F96   01 9E 1F               LXI   b,ascii_seg_table   
1F99   09                     DAD   b   ; HL = ascii_seg_table + index
1F9A   7E                     MOV   a,m   
1F9B   C9                     RET      
1F9C                ATS_BLANK:      
1F9C   AF                     XRA   a   ; A = 0 (ブランク)
1F9D   C9                     RET      
1F9E                             ; 
1F9E                             ; ===============================================================
1F9E                             ; ASCII → 7 セグパターン変換テーブル (64 エントリ)
1F9E                             ; 
1F9E                             ; ASCII 0x20 (" ") から 0x5F ("_") まで。
1F9E                             ; 小文字 0x60-0x7F は -0x20 で大文字に折り畳んで参照する。
1F9E                             ; 
1F9E                             ; セグメント配置:
1F9E                             ;     aaa        bit 0 = a (上)
1F9E                             ;    f   b       bit 1 = b (右上)
1F9E                             ;     ggg        bit 2 = c (右下)
1F9E                             ;    e   c       bit 3 = d (下)
1F9E                             ;     ddd        bit 4 = e (左下)
1F9E                             ;                bit 5 = f (左上)
1F9E                             ;                bit 6 = g (中)
1F9E                             ; 
1F9E                             ; 表現できない文字は 0x00 (消灯)。
1F9E                             ; 数字 0-9 は既存の seg_table (ND8080 ROM パターン) と同一。
1F9E                             ; ===============================================================
1F9E                ASCII_SEG_TABLE:      
1F9E                             ; 0x20-0x2F: 記号
1F9E   00                     DB   00h   ; 0x20 " " (スペース)
1F9F   06                     DB   06h   ; 0x21 "!" (bc)
1FA0   22                     DB   22h   ; 0x22 """ (bf)
1FA1   63                     DB   63h   ; 0x23 "#" (abfg = 上の丸 °)
1FA2   6D                     DB   6Dh   ; 0x24 "$" (= S)
1FA3   58                     DB   58h   ; 0x25 "%" (deg = 小文字 c)
1FA4   4C                     DB   4Ch   ; 0x26 "&" (cdg = 反転 c)
1FA5   02                     DB   02h   ; 0x27 "'" (b)
1FA6   39                     DB   39h   ; 0x28 "(" (= C)
1FA7   0F                     DB   0Fh   ; 0x29 ")" (abcd)
1FA8   49                     DB   49h   ; 0x2A "*" (adg = 三)
1FA9   41                     DB   41h   ; 0x2B "+" (ag = 三の下なし)
1FAA   04                     DB   04h   ; 0x2C "," (c)
1FAB   40                     DB   40h   ; 0x2D "-" (g)
1FAC   08                     DB   08h   ; 0x2E "." (d)
1FAD   61                     DB   61h   ; 0x2F "/" (afg = 上の c)
1FAE                             ; 0x30-0x39: 数字 (ND8080 ROM パターン)
1FAE   5C                     DB   5Ch   ; 0x30 "0"
1FAF   06                     DB   06h   ; 0x31 "1"
1FB0   5B                     DB   5Bh   ; 0x32 "2"
1FB1   4F                     DB   4Fh   ; 0x33 "3"
1FB2   66                     DB   66h   ; 0x34 "4"
1FB3   6D                     DB   6Dh   ; 0x35 "5"
1FB4   7D                     DB   7Dh   ; 0x36 "6"
1FB5   27                     DB   27h   ; 0x37 "7"
1FB6   7F                     DB   7Fh   ; 0x38 "8"
1FB7   6F                     DB   6Fh   ; 0x39 "9"
1FB8                             ; 0x3A-0x40: 記号
1FB8   09                     DB   09h   ; 0x3A ":" (ad)
1FB9   00                     DB   00h   ; 0x3B ";"
1FBA   00                     DB   00h   ; 0x3C "<"
1FBB   48                     DB   48h   ; 0x3D "=" (dg)
1FBC   00                     DB   00h   ; 0x3E ">"
1FBD   23                     DB   23h   ; 0x3F "?" (abf = 上コの字)
1FBE   5C                     DB   5Ch   ; 0x40 "@" (cdeg = 下の丸)
1FBF                             ; 0x41-0x5A: 英字
1FBF   77                     DB   77h   ; 0x41 "A" (abcefg)
1FC0   7C                     DB   7Ch   ; 0x42 "B" (cdefg = b)
1FC1   39                     DB   39h   ; 0x43 "C" (adef)
1FC2   5E                     DB   5Eh   ; 0x44 "D" (bcdeg = d)
1FC3   79                     DB   79h   ; 0x45 "E" (adefg)
1FC4   71                     DB   71h   ; 0x46 "F" (aefg)
1FC5   3D                     DB   3Dh   ; 0x47 "G" (acdef)
1FC6   76                     DB   76h   ; 0x48 "H" (bcefg)
1FC7   06                     DB   06h   ; 0x49 "I" (bc)
1FC8   1E                     DB   1Eh   ; 0x4A "J" (bcde)
1FC9   74                     DB   74h   ; 0x4B "K" (cefg = h)
1FCA   38                     DB   38h   ; 0x4C "L" (def)
1FCB   55                     DB   55h   ; 0x4D "M" (aceg = n + ~)
1FCC   54                     DB   54h   ; 0x4E "N" (ceg = n)
1FCD   5C                     DB   5Ch   ; 0x4F "O" (= 0)
1FCE   73                     DB   73h   ; 0x50 "P" (abefg)
1FCF   67                     DB   67h   ; 0x51 "Q" (abcfg)
1FD0   50                     DB   50h   ; 0x52 "R" (eg = r)
1FD1   6D                     DB   6Dh   ; 0x53 "S" (= 5)
1FD2   78                     DB   78h   ; 0x54 "T" (defg = t)
1FD3   1C                     DB   1Ch   ; 0x55 "U" (cde = 小文字 u)
1FD4   3E                     DB   3Eh   ; 0x56 "V" (= U)
1FD5   7E                     DB   7Eh   ; 0x57 "W" (bcdefg = 逆 A)
1FD6   76                     DB   76h   ; 0x58 "X" (bcefg = H)
1FD7   6E                     DB   6Eh   ; 0x59 "Y" (bcdfg)
1FD8   5B                     DB   5Bh   ; 0x5A "Z" (= 2)
1FD9                             ; 0x5B-0x5F: 記号
1FD9   39                     DB   39h   ; 0x5B "[" (= C)
1FDA   00                     DB   00h   ; 0x5C "\"
1FDB   0F                     DB   0Fh   ; 0x5D "]" (= ))
1FDC   01                     DB   01h   ; 0x5E "^" (a = 上一本, ~ もここに折畳)
1FDD   08                     DB   08h   ; 0x5F "_" (d)
1FDE                             ; 
1FDE                             ; ===============================================================
1FDE                             ; lfsr_next — 16-bit Galois LFSR 擬似乱数生成
1FDE                             ; 
1FDE                             ;   入力: なし
1FDE                             ;   出力: HL = 新しい乱数値
1FDE                             ;   破壊: A, HL
1FDE                             ; 
1FDE                             ; 多項式: x^16 + x^14 + x^13 + x^11 + 1 (タップ = 0xB400)
1FDE                             ; 周期: 65535
1FDE                             ; ===============================================================
1FDE                LFSR_NEXT:      
1FDE   2A 01 20               LHLD   lfsr_state   
1FE1   7D                     MOV   a,l   
1FE2   E6 01                  ANI   1   ; LSB チェック
1FE4   CA F6 1F               JZ   lfsr_no_tap   
1FE7                             ; LSB=1: 右シフト + XOR タップ
1FE7   7C                     MOV   a,h   
1FE8   B7                     ORA   a   ; CY=0 クリア
1FE9   1F                     RAR      
1FEA   67                     MOV   h,a   
1FEB   7D                     MOV   a,l   
1FEC   1F                     RAR      
1FED   6F                     MOV   l,a   
1FEE   7C                     MOV   a,h   
1FEF   EE B4                  XRI   0B4h   
1FF1   67                     MOV   h,a   
1FF2   22 01 20               SHLD   lfsr_state   
1FF5   C9                     RET      
1FF6                LFSR_NO_TAP:      
1FF6                             ; LSB=0: 右シフトのみ
1FF6   7C                     MOV   a,h   
1FF7   B7                     ORA   a   
1FF8   1F                     RAR      
1FF9   67                     MOV   h,a   
1FFA   7D                     MOV   a,l   
1FFB   1F                     RAR      
1FFC   6F                     MOV   l,a   
1FFD   22 01 20               SHLD   lfsr_state   
2000   C9                     RET      
2001                             ; 
2001   E1 AC        LFSR_STATE:   DW   0ACE1h   ; 初期シード (0 以外)
2003                             ; 
2003                             ; ===============================================================
2003                             ; send_rand — rand(n): 0〜n-1 の擬似乱数を返す
2003                             ; 
2003                             ; R[a+1] = n (上限)。n == 0 なら 0 を返す。
2003                             ; lfsr_next で 16-bit 乱数を取得し、udiv16 で n の剰余を求める。
2003                             ; ===============================================================
2003                SEND_RAND:      
2003                             ; R[a+1] から n を取得
2003   3A 55 16               LDA   send_reg_a   
2006   3C                     INR   a   
2007   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
200A   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
200D   5E                     MOV   e,m   
200E   23                     INX   h   
200F   56                     MOV   d,m   ; DE = n
2010                             ; 
2010                             ; n == 0 チェック
2010   7A                     MOV   a,d   
2011   B3                     ORA   e   
2012   CA 2D 20               JZ   rand_zero   
2015                             ; 
2015   D5                     PUSH   d   ; n を退避
2016   CD DE 1F               CALL   lfsr_next   ; HL = 乱数
2019   44                     MOV   b,h   
201A   4D                     MOV   c,l   ; BC = 乱数 (被除数)
201B   D1                     POP   d   ; DE = n (除数)
201C   CD A5 12               CALL   udiv16   ; BC=商, HL=剰余
201F                             ; 
201F                             ; HL (剰余) → BC → R[a]
201F   44                     MOV   b,h   
2020   4D                     MOV   c,l   
2021   3A 55 16               LDA   send_reg_a   
2024   CD 00 10               CALL   get_reg_addr   
2027   CD 10 10               CALL   set_slot_int16   
202A   C3 1B 1C               JMP   vm_loop   
202D                             ; 
202D                RAND_ZERO:      
202D   06 00                  MVI   b,0   
202F   0E 00                  MVI   c,0   
2031   3A 55 16               LDA   send_reg_a   
2034   CD 00 10               CALL   get_reg_addr   
2037   CD 10 10               CALL   set_slot_int16   
203A   C3 1B 1C               JMP   vm_loop   
203D                             ; 
203D                             ; ===============================================================
203D                             ; コレクションプール基盤ルーチン
203D                             ; ===============================================================
203D                             ; 
203D                             ; ---------------------------------------------------------------
203D                             ; col_slot_addr — スロット番号からアドレスを計算
203D                             ; 
203D                             ;   入力: A = スロット番号 (0-based)
203D                             ;   出力: HL = COLLECTION_POOL_BASE + slot * 36
203D                             ;   破壊: A, DE
203D                             ; ---------------------------------------------------------------
203D                COL_SLOT_ADDR:      
203D                             ; slot_number * 36 = slot_number * 32 + slot_number * 4
203D                             ; 最大 15*36=540 で 8 ビットに収まらないため 16 ビット (HL) で乗算
203D   6F                     MOV   l,a   
203E   26 00                  MVI   h,0   ; HL = slot_number
2040   29                     DAD   h   ; HL = slot_number × 2
2041   29                     DAD   h   ; HL = slot_number × 4
2042   54                     MOV   d,h   
2043   5D                     MOV   e,l   ; DE = slot_number × 4 (退避)
2044   29                     DAD   h   ; HL = slot_number × 8
2045   29                     DAD   h   ; HL = slot_number × 16
2046   29                     DAD   h   ; HL = slot_number × 32
2047   19                     DAD   d   ; HL = slot_number × 36
2048   11 C0 96               LXI   d,COLLECTION_POOL_BASE   
204B   19                     DAD   d   
204C   C9                     RET      
204D                             ; 
204D                             ; ---------------------------------------------------------------
204D                             ; col_alloc — コレクションスロットを確保
204D                             ; 
204D                             ;   入力: なし
204D                             ;   出力: A = スロット番号 (0-based), HL = スロットアドレス
204D                             ;   破壊: DE
204D                             ;   エラー: プール満杯かつ GC で回収不可 → vm_error
204D                             ; ---------------------------------------------------------------
204D                COL_ALLOC:      
204D   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
2050   FE 40                  CPI   MAX_COL_SLOTS   
2052   D2 B8 26               JNC   col_gc_alloc   ; プール満杯 → GC 試行
2055   F5                     PUSH   psw   ; スロット番号を退避
2056   CD 3D 20               CALL   col_slot_addr   ; HL = スロットアドレス
2059                             ; COL_SP++
2059   3A 1F 80               LDA   VM_STATE_BASE + OFF_COL_SP   
205C   3C                     INR   a   
205D   32 1F 80               STA   VM_STATE_BASE + OFF_COL_SP   
2060   F1                     POP   psw   ; A = スロット番号
2061   C9                     RET      
2062                             ; 
2062                             ; ---------------------------------------------------------------
2062                             ; col_from_reg — レジスタの val_lo からコレクションスロットアドレスを取得
2062                             ; 
2062                             ;   入力: HL = R[x] のスロットアドレス (get_reg_addr の結果)
2062                             ;   出力: HL = コレクションスロットアドレス
2062                             ;   破壊: A, DE
2062                             ; ---------------------------------------------------------------
2062                COL_FROM_REG:      
2062   CD 32 10               CALL   slot_to_value   ; HL = val アドレス
2065   7E                     MOV   a,m   ; A = val_lo = slot+1
2066   3D                     DCR   a   ; A = slot_number (0-based)
2067   C3 3D 20               JMP   col_slot_addr   
206A                             ; 
206A                             ; ===============================================================
206A                             ; do_op_getidx — OP_GETIDX (B): R[a] = R[a][R[a+1]]
206A                             ; 
206A                             ; R[a] の型で分岐:
206A                             ;   TT_STRING: 1 文字を新しい文字列スロットとして返す
206A                             ;   TT_ARRAY:  要素スロット (4B) を R[a] にコピー
206A                             ; ===============================================================
206A                DO_OP_GETIDX:      
206A   CD C0 10               CALL   fetch_byte   ; A = a
206D   32 0D 21               STA   gidx_reg_a   
2070   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2073   7E                     MOV   a,m   ; A = 型タグ
2074   FE 07                  CPI   TT_STRING   
2076   CA 86 20               JZ   gidx_string   
2079   FE 08                  CPI   TT_ARRAY   
207B   CA D2 20               JZ   gidx_array   
207E   FE 09                  CPI   TT_HASH   
2080   CA BF 24               JZ   gidx_hash   
2083   C3 03 00               JMP   vm_error   
2086                             ; 
2086                GIDX_STRING:      
2086                             ; R[a] のコレクションスロットを取得
2086   3A 0D 21               LDA   gidx_reg_a   
2089   CD 00 10               CALL   get_reg_addr   
208C   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
208F   23                     INX   h   ; +1: count
2090   46                     MOV   b,m   ; B = 文字列長
2091   23                     INX   h   ; HL → データ領域先頭
2092   22 0E 21               SHLD   gidx_data_addr   
2095                             ; 
2095                             ; R[a+1] からインデックスを取得
2095   3A 0D 21               LDA   gidx_reg_a   
2098   3C                     INR   a   
2099   CD 00 10               CALL   get_reg_addr   
209C   CD 32 10               CALL   slot_to_value   
209F   7E                     MOV   a,m   ; A = index (val_lo)
20A0                             ; 範囲チェック: index < 文字列長
20A0   B8                     CMP   b   
20A1   D2 03 00               JNC   vm_error   ; index >= 長さ → エラー
20A4                             ; データ先頭 + index で 1 文字を取得
20A4   5F                     MOV   e,a   
20A5   16 00                  MVI   d,0   
20A7   2A 0E 21               LHLD   gidx_data_addr   
20AA   19                     DAD   d   ; HL = &data[index]
20AB   4E                     MOV   c,m   ; C = 文字コード
20AC                             ; 
20AC                             ; 新しいコレクションスロットを確保して 1 文字の文字列を作る
20AC   C5                     PUSH   b   ; C = 文字コード退避
20AD   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
20B0   32 10 21               STA   gidx_new_slot   
20B3   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
20B5   23                     INX   h   
20B6   36 01                  MVI   m,1   ; +1: count = 1
20B8   23                     INX   h   
20B9   C1                     POP   b   
20BA   71                     MOV   m,c   ; +2: data[0] = 文字コード
20BB                             ; 
20BB                             ; R[a] = TT_STRING, val_lo = new_slot+1
20BB   3A 0D 21               LDA   gidx_reg_a   
20BE   CD 00 10               CALL   get_reg_addr   
20C1   36 07                  MVI   m,TT_STRING   
20C3   23                     INX   h   
20C4   36 00                  MVI   m,0   
20C6   23                     INX   h   
20C7   3A 10 21               LDA   gidx_new_slot   
20CA   3C                     INR   a   
20CB   77                     MOV   m,a   
20CC   23                     INX   h   
20CD   36 00                  MVI   m,0   
20CF   C3 1B 1C               JMP   vm_loop   
20D2                             ; 
20D2                GIDX_ARRAY:      
20D2                             ; R[a] のコレクションスロットを取得
20D2   3A 0D 21               LDA   gidx_reg_a   
20D5   CD 00 10               CALL   get_reg_addr   
20D8   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
20DB   23                     INX   h   ; +1: count
20DC   46                     MOV   b,m   ; B = 要素数
20DD   23                     INX   h   ; HL → データ領域先頭
20DE   22 0E 21               SHLD   gidx_data_addr   
20E1                             ; 
20E1                             ; R[a+1] からインデックスを取得
20E1   3A 0D 21               LDA   gidx_reg_a   
20E4   3C                     INR   a   
20E5   CD 00 10               CALL   get_reg_addr   
20E8   CD 32 10               CALL   slot_to_value   
20EB   7E                     MOV   a,m   ; A = index (val_lo)
20EC                             ; 範囲チェック: index < 要素数
20EC   B8                     CMP   b   
20ED   D2 03 00               JNC   vm_error   
20F0                             ; data + index * 4 で要素スロットの先頭を求める
20F0   87                     ADD   a   ; ×2
20F1   87                     ADD   a   ; ×4
20F2   5F                     MOV   e,a   
20F3   16 00                  MVI   d,0   
20F5   2A 0E 21               LHLD   gidx_data_addr   
20F8   19                     DAD   d   ; HL = &data[index * 4] (コピー元)
20F9   EB                     XCHG      ; DE = &data[index * 4]
20FA                             ; 
20FA                             ; R[a] にコピー (4 バイト)
20FA   3A 0D 21               LDA   gidx_reg_a   
20FD   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (コピー先)
2100   0E 04                  MVI   c,SLOT_BYTES   
2102                GIDX_ARY_COPY:      
2102   1A                     LDAX   d   
2103   77                     MOV   m,a   
2104   23                     INX   h   
2105   13                     INX   d   
2106   0D                     DCR   c   
2107   C2 02 21               JNZ   gidx_ary_copy   
210A   C3 1B 1C               JMP   vm_loop   
210D                             ; 
210D   00           GIDX_REG_A:   DB   0   
210E   00 00        GIDX_DATA_ADDR:   DW   0   
2110   00           GIDX_NEW_SLOT:   DB   0   
2111                             ; 
2111                             ; ===============================================================
2111                             ; do_op_setidx — OP_SETIDX (B): R[a][R[a+1]] = R[a+2]
2111                             ; 
2111                             ; R[a] の型で分岐:
2111                             ;   TT_STRING: インデックス位置に 1 文字を書き込む
2111                             ;   TT_ARRAY:  インデックス位置にスロットをコピー
2111                             ; ===============================================================
2111                DO_OP_SETIDX:      
2111   CD C0 10               CALL   fetch_byte   ; A = a
2114   32 C4 21               STA   sidx_reg_a   
2117   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
211A   7E                     MOV   a,m   ; A = 型タグ
211B   FE 07                  CPI   TT_STRING   
211D   CA 2D 21               JZ   sidx_string   
2120   FE 08                  CPI   TT_ARRAY   
2122   CA 87 21               JZ   sidx_array   
2125   FE 09                  CPI   TT_HASH   
2127   CA 27 25               JZ   sidx_hash   
212A   C3 03 00               JMP   vm_error   
212D                             ; 
212D                SIDX_STRING:      
212D                             ; R[a] のコレクションスロットを取得
212D   3A C4 21               LDA   sidx_reg_a   
2130   CD 00 10               CALL   get_reg_addr   
2133   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
2136   23                     INX   h   ; +1: count
2137   46                     MOV   b,m   ; B = 文字列長
2138   23                     INX   h   ; HL → データ領域先頭
2139   22 C5 21               SHLD   sidx_data_addr   
213C                             ; 
213C                             ; R[a+1] からインデックスを取得
213C   3A C4 21               LDA   sidx_reg_a   
213F   3C                     INR   a   
2140   CD 00 10               CALL   get_reg_addr   
2143   CD 32 10               CALL   slot_to_value   
2146   7E                     MOV   a,m   ; A = index
2147   B8                     CMP   b   
2148   D2 03 00               JNC   vm_error   ; index >= 長さ
214B                             ; 
214B                             ; data[index] に R[a+2] の文字を書き込む
214B   5F                     MOV   e,a   
214C   16 00                  MVI   d,0   
214E   2A C5 21               LHLD   sidx_data_addr   
2151   19                     DAD   d   ; HL = &data[index]
2152                             ; 
2152                             ; R[a+2] から文字コードを取得
2152   3A C4 21               LDA   sidx_reg_a   
2155   3C                     INR   a   
2156   3C                     INR   a   
2157   CD 00 10               CALL   get_reg_addr   
215A                             ; R[a+2] が TT_STRING なら先頭文字、TT_INTEGER なら val_lo
215A   7E                     MOV   a,m   ; 型タグ
215B   FE 07                  CPI   TT_STRING   
215D   CA 67 21               JZ   sidx_str_char   
2160                             ; TT_INTEGER: val_lo を文字コードとして使う
2160   CD 32 10               CALL   slot_to_value   
2163   7E                     MOV   a,m   
2164   C3 6D 21               JMP   sidx_write_char   
2167                SIDX_STR_CHAR:      
2167                             ; TT_STRING: コレクションスロットの先頭文字
2167   CD 62 20               CALL   col_from_reg   
216A   23                     INX   h   ; +1: count
216B   23                     INX   h   ; +2: data[0]
216C   7E                     MOV   a,m   
216D                SIDX_WRITE_CHAR:      
216D   2A C5 21               LHLD   sidx_data_addr   
2170   5F                     MOV   e,a   ; E = 文字コード
2171   3A C4 21               LDA   sidx_reg_a   
2174   3C                     INR   a   
2175   CD 00 10               CALL   get_reg_addr   
2178   CD 32 10               CALL   slot_to_value   
217B   7E                     MOV   a,m   ; A = index
217C   4F                     MOV   c,a   
217D   06 00                  MVI   b,0   
217F   2A C5 21               LHLD   sidx_data_addr   
2182   09                     DAD   b   ; HL = &data[index]
2183   73                     MOV   m,e   ; 書き込み
2184   C3 1B 1C               JMP   vm_loop   
2187                             ; 
2187                SIDX_ARRAY:      
2187                             ; R[a] のコレクションスロットを取得
2187   3A C4 21               LDA   sidx_reg_a   
218A   CD 00 10               CALL   get_reg_addr   
218D   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
2190   23                     INX   h   ; +1: count
2191   46                     MOV   b,m   ; B = 要素数
2192   23                     INX   h   ; HL → データ領域先頭
2193   22 C5 21               SHLD   sidx_data_addr   
2196                             ; 
2196                             ; R[a+1] からインデックスを取得
2196   3A C4 21               LDA   sidx_reg_a   
2199   3C                     INR   a   
219A   CD 00 10               CALL   get_reg_addr   
219D   CD 32 10               CALL   slot_to_value   
21A0   7E                     MOV   a,m   ; A = index
21A1   B8                     CMP   b   
21A2   D2 03 00               JNC   vm_error   
21A5                             ; 
21A5                             ; data[index * 4] に R[a+2] をコピー
21A5   87                     ADD   a   ; ×2
21A6   87                     ADD   a   ; ×4
21A7   5F                     MOV   e,a   
21A8   16 00                  MVI   d,0   
21AA   2A C5 21               LHLD   sidx_data_addr   
21AD   19                     DAD   d   ; HL = &data[index * 4] (コピー先)
21AE   EB                     XCHG      ; DE = コピー先
21AF                             ; 
21AF                             ; R[a+2] を取得 (コピー元)
21AF   3A C4 21               LDA   sidx_reg_a   
21B2   3C                     INR   a   
21B3   3C                     INR   a   
21B4   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
21B7   0E 04                  MVI   c,SLOT_BYTES   
21B9                SIDX_ARY_COPY:      
21B9   7E                     MOV   a,m   
21BA   12                     STAX   d   
21BB   23                     INX   h   
21BC   13                     INX   d   
21BD   0D                     DCR   c   
21BE   C2 B9 21               JNZ   sidx_ary_copy   
21C1   C3 1B 1C               JMP   vm_loop   
21C4                             ; 
21C4   00           SIDX_REG_A:   DB   0   
21C5   00 00        SIDX_DATA_ADDR:   DW   0   
21C7                             ; 
21C7                             ; ===============================================================
21C7                             ; do_op_array — OP_ARRAY (BB): R[a] = [R[a], R[a+1], ..., R[a+b-1]]
21C7                             ; 
21C7                             ; b 個のレジスタからコレクションプールに配列を構築する。
21C7                             ; ===============================================================
21C7                DO_OP_ARRAY:      
21C7   CD C0 10               CALL   fetch_byte   ; A = a
21CA   32 3E 22               STA   oary_reg_a   
21CD   32 3F 22               STA   oary_src_reg   ; BB 形式: ソース = a
21D0   CD C0 10               CALL   fetch_byte   ; A = b (要素数)
21D3                OA2_JOIN:      ; OP_ARRAY2 からの合流点
21D3   32 40 22               STA   oary_count   
21D6   B7                     ORA   a   
21D7   CA 30 22               JZ   oary_empty   ; 空配列
21DA                             ; 
21DA                             ; 要素数チェック
21DA   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
21DC   D2 03 00               JNC   vm_error   ; 要素数 > 7
21DF                             ; 
21DF                             ; コレクションスロットを確保
21DF   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
21E2   32 41 22               STA   oary_slot_num   
21E5   36 02                  MVI   m,COL_TYPE_ARRAY   ; +0: type
21E7   23                     INX   h   
21E8   3A 40 22               LDA   oary_count   
21EB   77                     MOV   m,a   ; +1: count
21EC   23                     INX   h   ; HL → データ領域先頭
21ED   EB                     XCHG      ; DE = データ領域先頭 (コピー先)
21EE                             ; 
21EE                             ; ソースレジスタから b 個のスロットをコピー
21EE   3A 3F 22               LDA   oary_src_reg   
21F1   47                     MOV   b,a   ; B = 現在のレジスタ番号
21F2   3A 40 22               LDA   oary_count   
21F5   4F                     MOV   c,a   ; C = 残り要素数
21F6                OARY_COPY_LOOP:      
21F6   3E 04                  MVI   a,SLOT_BYTES   
21F8   32 42 22               STA   oary_elem_cnt   ; 毎回初期化 (2 回目以降のため)
21FB   C5                     PUSH   b   
21FC   D5                     PUSH   d   
21FD   78                     MOV   a,b   
21FE   CD 00 10               CALL   get_reg_addr   ; HL = R[reg] (コピー元)
2201   D1                     POP   d   
2202                OARY_COPY_ELEM:      
2202   46                     MOV   b,m   ; SLOT_BYTES 分のコピー (HL → DE)
2203   23                     INX   h   
2204   78                     MOV   a,b   
2205   12                     STAX   d   
2206   13                     INX   d   
2207   E5                     PUSH   h   
2208   21 42 22               LXI   h,oary_elem_cnt   
220B   35                     DCR   m   
220C   E1                     POP   h   
220D   C2 02 22               JNZ   oary_copy_elem   
2210   C1                     POP   b   
2211   04                     INR   b   ; 次のレジスタ
2212   0D                     DCR   c   
2213   CA 19 22               JZ   oary_done   
2216   C3 F6 21               JMP   oary_copy_loop   
2219                             ; 
2219                OARY_DONE:      
2219                             ; R[a] = TT_ARRAY, val_lo = slot+1
2219   3A 3E 22               LDA   oary_reg_a   
221C   CD 00 10               CALL   get_reg_addr   
221F   36 08                  MVI   m,TT_ARRAY   
2221   23                     INX   h   
2222   36 00                  MVI   m,0   
2224   23                     INX   h   
2225   3A 41 22               LDA   oary_slot_num   
2228   3C                     INR   a   
2229   77                     MOV   m,a   
222A   23                     INX   h   
222B   36 00                  MVI   m,0   
222D   C3 1B 1C               JMP   vm_loop   
2230                             ; 
2230                OARY_EMPTY:      
2230                             ; 空配列: スロット確保して count=0
2230   CD 4D 20               CALL   col_alloc   
2233   32 41 22               STA   oary_slot_num   
2236   36 02                  MVI   m,COL_TYPE_ARRAY   
2238   23                     INX   h   
2239   36 00                  MVI   m,0   ; count = 0
223B   C3 19 22               JMP   oary_done   
223E                             ; 
223E   00           OARY_REG_A:   DB   0   
223F   00           OARY_SRC_REG:   DB   0   
2240   00           OARY_COUNT:   DB   0   
2241   00           OARY_SLOT_NUM:   DB   0   
2242   04           OARY_ELEM_CNT:   DB   SLOT_BYTES   
2243                             ; 
2243                             ; ===============================================================
2243                             ; do_op_arypush — OP_ARYPUSH (BB): R[a].push(R[a+1], ..., R[a+b-1])
2243                             ; 
2243                             ; R[a] の配列の末尾に要素を追加する。
2243                             ; ===============================================================
2243                DO_OP_ARYPUSH:      
2243   CD C0 10               CALL   fetch_byte   ; A = a
2246   32 B7 22               STA   apush_reg_a   
2249   CD C0 10               CALL   fetch_byte   ; A = b (追加する要素数)
224C   32 B8 22               STA   apush_add_count   
224F                             ; 
224F                             ; R[a] のコレクションスロットを取得
224F   3A B7 22               LDA   apush_reg_a   
2252   CD 00 10               CALL   get_reg_addr   
2255   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
2258   23                     INX   h   ; +1: count
2259   7E                     MOV   a,m   ; A = 現在の要素数
225A   32 B9 22               STA   apush_cur_count   
225D                             ; 容量チェック: count + add_count <= MAX
225D   3A B8 22               LDA   apush_add_count   
2260   47                     MOV   b,a   
2261   3A B9 22               LDA   apush_cur_count   
2264   80                     ADD   b   
2265   FE 09                  CPI   COL_MAX_ARRAY_ELEMS + 1   
2267   D2 03 00               JNC   vm_error   ; オーバーフロー
226A                             ; 
226A                             ; 書き込み先: data + count * 4
226A   3A B9 22               LDA   apush_cur_count   
226D   87                     ADD   a   ; ×2
226E   87                     ADD   a   ; ×4
226F   5F                     MOV   e,a   
2270   16 00                  MVI   d,0   
2272   23                     INX   h   ; HL → データ領域先頭
2273   19                     DAD   d   ; HL = 書き込み位置
2274   EB                     XCHG      ; DE = 書き込み位置
2275                             ; 
2275                             ; R[a+1] から b 個のスロットをコピー
2275   3A B7 22               LDA   apush_reg_a   
2278   3C                     INR   a   
2279   47                     MOV   b,a   ; B = 現在のレジスタ番号
227A   3A B8 22               LDA   apush_add_count   
227D   4F                     MOV   c,a   ; C = 残り要素数
227E                APUSH_LOOP:      
227E   3E 04                  MVI   a,SLOT_BYTES   
2280   32 BA 22               STA   apush_byte_cnt   ; 毎回初期化
2283   C5                     PUSH   b   
2284   D5                     PUSH   d   
2285   78                     MOV   a,b   
2286   CD 00 10               CALL   get_reg_addr   ; HL = R[reg]
2289   D1                     POP   d   
228A                APUSH_COPY:      
228A   46                     MOV   b,m   
228B   78                     MOV   a,b   
228C   12                     STAX   d   
228D   23                     INX   h   
228E   13                     INX   d   
228F   E5                     PUSH   h   
2290   21 BA 22               LXI   h,apush_byte_cnt   
2293   35                     DCR   m   
2294   E1                     POP   h   
2295   C2 8A 22               JNZ   apush_copy   
2298   C1                     POP   b   
2299   04                     INR   b   
229A   0D                     DCR   c   
229B   CA A1 22               JZ   apush_done   
229E   C3 7E 22               JMP   apush_loop   
22A1                             ; 
22A1                APUSH_DONE:      
22A1                             ; count を更新
22A1   3A B7 22               LDA   apush_reg_a   
22A4   CD 00 10               CALL   get_reg_addr   
22A7   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
22AA   23                     INX   h   ; +1: count
22AB   3A B9 22               LDA   apush_cur_count   
22AE   47                     MOV   b,a   
22AF   3A B8 22               LDA   apush_add_count   
22B2   80                     ADD   b   
22B3   77                     MOV   m,a   ; count = old + added
22B4   C3 1B 1C               JMP   vm_loop   
22B7                             ; 
22B7   00           APUSH_REG_A:   DB   0   
22B8   00           APUSH_ADD_COUNT:   DB   0   
22B9   00           APUSH_CUR_COUNT:   DB   0   
22BA   04           APUSH_BYTE_CNT:   DB   SLOT_BYTES   
22BB                             ; 
22BB                             ; ===============================================================
22BB                             ; do_op_strcat — OP_STRCAT (B): R[a] = R[a] + R[a+1] (文字列連結)
22BB                             ; 
22BB                             ; R[a] の文字列の末尾に R[a+1] の文字列を追記する。
22BB                             ; ===============================================================
22BB                DO_OP_STRCAT:      
22BB   CD C0 10               CALL   fetch_byte   ; A = a
22BE   32 31 23               STA   scat_reg_a   
22C1                STRCAT_BODY:      ; OP_ADD 文字列パスからも使う (A = a)
22C1                             ; 
22C1                             ; R[a+1] のコレクションスロット (ソース)
22C1   3C                     INR   a   
22C2   CD 00 10               CALL   get_reg_addr   
22C5   CD 62 20               CALL   col_from_reg   ; HL = ソーススロット
22C8   23                     INX   h   ; +1: count
22C9   7E                     MOV   a,m   ; A = ソース文字列長
22CA   32 32 23               STA   scat_src_len   
22CD   23                     INX   h   ; HL → データ先頭
22CE   22 35 23               SHLD   scat_src_data   
22D1                             ; 
22D1                             ; R[a] のコレクションスロット (デスト)
22D1   3A 31 23               LDA   scat_reg_a   
22D4   CD 00 10               CALL   get_reg_addr   
22D7   CD 62 20               CALL   col_from_reg   ; HL = デストスロット
22DA   23                     INX   h   ; +1: count
22DB   7E                     MOV   a,m   ; A = デスト文字列長
22DC   32 33 23               STA   scat_dst_len   
22DF                             ; 
22DF                             ; 合計長チェック
22DF   3A 32 23               LDA   scat_src_len   
22E2   47                     MOV   b,a   
22E3   3A 33 23               LDA   scat_dst_len   
22E6   80                     ADD   b   
22E7   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
22E9   DA 01 23               JC   scat_len_ok   
22EC                             ; 切り詰め: 追記できる分だけ
22EC   3E 22                  MVI   a,COL_MAX_STRING_LEN   
22EE   47                     MOV   b,a   
22EF   3A 33 23               LDA   scat_dst_len   
22F2   90                     SUB   b   ; この結果は負 (使わない)
22F3   3E 22                  MVI   a,COL_MAX_STRING_LEN   
22F5   47                     MOV   b,a   
22F6   3A 33 23               LDA   scat_dst_len   
22F9   4F                     MOV   c,a   
22FA   78                     MOV   a,b   
22FB   91                     SUB   c   ; A = MAX - dst_len = コピー可能バイト数
22FC   32 32 23               STA   scat_src_len   
22FF                             ; 合計を MAX に
22FF   3E 22                  MVI   a,COL_MAX_STRING_LEN   
2301                SCAT_LEN_OK:      
2301   32 34 23               STA   scat_total_len   
2304                             ; 
2304                             ; デスト count を更新
2304   3A 31 23               LDA   scat_reg_a   
2307   CD 00 10               CALL   get_reg_addr   
230A   CD 62 20               CALL   col_from_reg   
230D   23                     INX   h   
230E   3A 34 23               LDA   scat_total_len   
2311   77                     MOV   m,a   ; count = 合計長
2312   23                     INX   h   ; HL → データ先頭
2313                             ; 
2313                             ; デストデータ末尾 = data + dst_len
2313   3A 33 23               LDA   scat_dst_len   
2316   5F                     MOV   e,a   
2317   16 00                  MVI   d,0   
2319   19                     DAD   d   ; HL = 書き込み位置
231A                             ; 
231A                             ; ソースデータをコピー
231A   EB                     XCHG      ; DE = 書き込み位置
231B   2A 35 23               LHLD   scat_src_data   ; HL = ソースデータ
231E   3A 32 23               LDA   scat_src_len   
2321   B7                     ORA   a   
2322   CA 2E 23               JZ   scat_done   
2325   4F                     MOV   c,a   
2326                SCAT_COPY:      
2326   7E                     MOV   a,m   
2327   12                     STAX   d   
2328   23                     INX   h   
2329   13                     INX   d   
232A   0D                     DCR   c   
232B   C2 26 23               JNZ   scat_copy   
232E                             ; 
232E                SCAT_DONE:      
232E   C3 1B 1C               JMP   vm_loop   
2331                             ; 
2331   00           SCAT_REG_A:   DB   0   
2332   00           SCAT_SRC_LEN:   DB   0   
2333   00           SCAT_DST_LEN:   DB   0   
2334   00           SCAT_TOTAL_LEN:   DB   0   
2335   00 00        SCAT_SRC_DATA:   DW   0   
2337                             ; 
2337                             ; ===============================================================
2337                             ; send_length — length / size: 文字列長・配列長を返す
2337                             ; 
2337                             ; R[a] のコレクションスロットの count を TT_INTEGER として返す。
2337                             ; ===============================================================
2337                SEND_LENGTH:      
2337   3A 55 16               LDA   send_reg_a   
233A   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
233D   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
2340   23                     INX   h   ; +1: count
2341   4E                     MOV   c,m   ; C = count
2342   06 00                  MVI   b,0   ; BC = count (16-bit)
2344   3A 55 16               LDA   send_reg_a   
2347   CD 00 10               CALL   get_reg_addr   
234A   CD 10 10               CALL   set_slot_int16   ; R[a] = count
234D   C3 1B 1C               JMP   vm_loop   
2350                             ; 
2350                             ; ===============================================================
2350                             ; send_concat — << (文字列追記 / 配列追加)
2350                             ; 
2350                             ; R[a] の型で分岐:
2350                             ;   TT_STRING: R[a+1] の文字列を R[a] に追記
2350                             ;   TT_ARRAY:  R[a+1] のスロットを R[a] の配列末尾に追加
2350                             ; ===============================================================
2350                SEND_CONCAT:      
2350   3A 55 16               LDA   send_reg_a   
2353   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2356   7E                     MOV   a,m   ; A = 型タグ
2357   FE 07                  CPI   TT_STRING   
2359   CA 64 23               JZ   concat_string   
235C   FE 08                  CPI   TT_ARRAY   
235E   CA 0E 24               JZ   concat_array   
2361   C3 03 00               JMP   vm_error   
2364                             ; 
2364                CONCAT_STRING:      
2364                             ; R[a+1] の型を確認
2364   3A 55 16               LDA   send_reg_a   
2367   3C                     INR   a   
2368   CD 00 10               CALL   get_reg_addr   
236B   7E                     MOV   a,m   ; A = R[a+1] の型タグ
236C   FE 07                  CPI   TT_STRING   
236E   CA 79 23               JZ   concat_str_str   
2371   FE 04                  CPI   TT_INTEGER   
2373   CA E9 23               JZ   concat_str_int   
2376   C3 03 00               JMP   vm_error   
2379                             ; 
2379                CONCAT_STR_STR:      
2379                             ; R[a+1] のコレクションスロット (ソース)
2379   3A 55 16               LDA   send_reg_a   
237C   3C                     INR   a   
237D   CD 00 10               CALL   get_reg_addr   
2380   CD 62 20               CALL   col_from_reg   ; HL = ソーススロット
2383   23                     INX   h   ; +1: count
2384   7E                     MOV   a,m   ; A = ソース文字列長
2385   32 20 80               STA   cc_src_len   
2388   23                     INX   h   ; HL → データ先頭
2389   22 23 80               SHLD   cc_src_data   
238C                             ; 
238C                             ; R[a] のコレクションスロット (デスト)
238C   3A 55 16               LDA   send_reg_a   
238F   CD 00 10               CALL   get_reg_addr   
2392   CD 62 20               CALL   col_from_reg   ; HL = デストスロット
2395   23                     INX   h   ; +1: count
2396   7E                     MOV   a,m   
2397   32 21 80               STA   cc_dst_len   
239A                             ; 
239A                             ; コピー可能バイト数を計算
239A   3A 20 80               LDA   cc_src_len   
239D   47                     MOV   b,a   
239E   3A 21 80               LDA   cc_dst_len   
23A1   80                     ADD   b   
23A2   FE 23                  CPI   COL_MAX_STRING_LEN + 1   
23A4   DA B9 23               JC   cc_str_len_ok   
23A7                             ; 切り詰め
23A7   3E 22                  MVI   a,COL_MAX_STRING_LEN   
23A9   47                     MOV   b,a   
23AA   3A 21 80               LDA   cc_dst_len   
23AD   4F                     MOV   c,a   
23AE   78                     MOV   a,b   
23AF   91                     SUB   c   
23B0   32 20 80               STA   cc_src_len   
23B3   3A 21 80               LDA   cc_dst_len   
23B6   87                     ADD   a   ; ここでは使わない — 合計は MAX
23B7   3E 22                  MVI   a,COL_MAX_STRING_LEN   
23B9                CC_STR_LEN_OK:      
23B9   32 22 80               STA   cc_total_len   
23BC                             ; 
23BC                             ; count を更新
23BC   3A 55 16               LDA   send_reg_a   
23BF   CD 00 10               CALL   get_reg_addr   
23C2   CD 62 20               CALL   col_from_reg   
23C5   23                     INX   h   
23C6   3A 22 80               LDA   cc_total_len   
23C9   77                     MOV   m,a   
23CA   23                     INX   h   ; HL → データ先頭
23CB                             ; 
23CB                             ; 書き込み位置 = data + dst_len
23CB   3A 21 80               LDA   cc_dst_len   
23CE   5F                     MOV   e,a   
23CF   16 00                  MVI   d,0   
23D1   19                     DAD   d   
23D2                             ; 
23D2                             ; コピー
23D2   EB                     XCHG      
23D3   2A 23 80               LHLD   cc_src_data   
23D6   3A 20 80               LDA   cc_src_len   
23D9   B7                     ORA   a   
23DA   CA E6 23               JZ   cc_str_done   
23DD   4F                     MOV   c,a   
23DE                CC_STR_COPY:      
23DE   7E                     MOV   a,m   
23DF   12                     STAX   d   
23E0   23                     INX   h   
23E1   13                     INX   d   
23E2   0D                     DCR   c   
23E3   C2 DE 23               JNZ   cc_str_copy   
23E6                CC_STR_DONE:      
23E6                             ; R[a] をそのまま返す (破壊的操作)
23E6   C3 1B 1C               JMP   vm_loop   
23E9                             ; 
23E9                CONCAT_STR_INT:      
23E9                             ; R[a+1] の val_lo を 1 バイトとして追記
23E9   3A 55 16               LDA   send_reg_a   
23EC   3C                     INR   a   
23ED   CD 00 10               CALL   get_reg_addr   
23F0   CD 32 10               CALL   slot_to_value   
23F3   4E                     MOV   c,m   ; C = 文字コード (val_lo)
23F4                             ; 
23F4                             ; R[a] のコレクションスロット
23F4   3A 55 16               LDA   send_reg_a   
23F7   CD 00 10               CALL   get_reg_addr   
23FA   CD 62 20               CALL   col_from_reg   ; HL = デストスロット
23FD   23                     INX   h   ; +1: count
23FE   7E                     MOV   a,m   
23FF   FE 22                  CPI   COL_MAX_STRING_LEN   
2401   D2 1B 1C               JNC   vm_loop   ; 満杯なら何もしない
2404   34                     INR   m   ; count++
2405   5F                     MOV   e,a   ; E = 旧 count (= 書き込みオフセット)
2406   23                     INX   h   ; HL → データ先頭
2407   16 00                  MVI   d,0   
2409   19                     DAD   d   ; HL = &data[old_count]
240A   71                     MOV   m,c   ; 書き込み
240B   C3 1B 1C               JMP   vm_loop   
240E                             ; 
240E                CONCAT_ARRAY:      
240E                             ; R[a] のコレクションスロット
240E   3A 55 16               LDA   send_reg_a   
2411   CD 00 10               CALL   get_reg_addr   
2414   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
2417   23                     INX   h   ; +1: count
2418   7E                     MOV   a,m   
2419   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
241B   D2 03 00               JNC   vm_error   ; 満杯
241E   32 25 80               STA   cc_ary_count   
2421   34                     INR   m   ; count++
2422                             ; 
2422                             ; 書き込み位置: data + count * 4
2422   23                     INX   h   ; HL → データ先頭
2423   3A 25 80               LDA   cc_ary_count   
2426   87                     ADD   a   ; ×2
2427   87                     ADD   a   ; ×4
2428   5F                     MOV   e,a   
2429   16 00                  MVI   d,0   
242B   19                     DAD   d   ; HL = 書き込み位置
242C   EB                     XCHG      ; DE = 書き込み位置
242D                             ; 
242D                             ; R[a+1] をコピー
242D   3A 55 16               LDA   send_reg_a   
2430   3C                     INR   a   
2431   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
2434   0E 04                  MVI   c,SLOT_BYTES   
2436                CC_ARY_COPY:      
2436   7E                     MOV   a,m   
2437   12                     STAX   d   
2438   23                     INX   h   
2439   13                     INX   d   
243A   0D                     DCR   c   
243B   C2 36 24               JNZ   cc_ary_copy   
243E   C3 1B 1C               JMP   vm_loop   
2441                             ; 
2441                             ; --- concat 一時変数 ---
2441                             ; メインコード領域 (0xA800-0xAFFF) の末尾がグローバル変数領域 (0xB000)
2441                             ; に侵食するのを防ぐため、VM 状態領域の空きバイトを使う。
2441                             ; OFF_COL_SP (0x1F) の直後、0x20-0x25 を割り当てる。
2441                CC_SRC_LEN:   EQU   VM_STATE_BASE + 20h   ; 1B
2441                CC_DST_LEN:   EQU   VM_STATE_BASE + 21h   ; 1B
2441                CC_TOTAL_LEN:   EQU   VM_STATE_BASE + 22h   ; 1B
2441                CC_SRC_DATA:   EQU   VM_STATE_BASE + 23h   ; 2B (LE)
2441                CC_ARY_COUNT:   EQU   VM_STATE_BASE + 25h   ; 1B
2441                             ; 
2441                             ; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
2441                             ; 
2441                             ; Hash スロット形式 (コレクションプール 36B スロット内):
2441                             ;   +0: type  (1B)  COL_TYPE_HASH = 3
2441                             ;   +1: count (1B)  ペア数 (最大 4)
2441                             ;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
2441                             ; 
2441                             ; キー検索は線形 4 バイト比較。
2441                             ; 
2441                             ; ===============================================================
2441                             ; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
2441                             ; 
2441                             ; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
2441                             ; ===============================================================
2441                DO_OP_ARRAY2:      
2441   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
2444   32 3E 22               STA   oary_reg_a   
2447   CD C0 10               CALL   fetch_byte   ; A = b (ソースレジスタ先頭)
244A   32 3F 22               STA   oary_src_reg   
244D   CD C0 10               CALL   fetch_byte   ; A = c (要素数)
2450   C3 D3 21               JMP   oa2_join   
2453                             ; 
2453                             ; ===============================================================
2453                             ; do_op_hash — OP_HASH (BB): R[a] = 00bbUlthKzFdPT5SW2ErMl0sIC4uLg==
2453                             ; 
2453                             ;   a = 書き込み先レジスタ
2453                             ;   b = ペア数 (0 = 空 Hash)
2453                             ;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
2453                             ; ===============================================================
2453                DO_OP_HASH:      
2453   CD C0 10               CALL   fetch_byte   ; A = a (書き込み先)
2456   32 BB 24               STA   hash_reg_a   
2459   CD C0 10               CALL   fetch_byte   ; A = b (ペア数)
245C   32 BC 24               STA   hash_count   
245F                             ; 
245F                             ; コレクションスロット確保
245F   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2462   32 BD 24               STA   hash_slot_num   
2465                             ; 
2465                             ; ヘッダ書き込み
2465   36 03                  MVI   m,COL_TYPE_HASH   ; +0: type
2467   23                     INX   h   
2468   3A BC 24               LDA   hash_count   
246B   77                     MOV   m,a   ; +1: count
246C   23                     INX   h   ; HL → データ領域先頭
246D                             ; 
246D                             ; ペアがなければ結果書き込みへ
246D   3A BC 24               LDA   hash_count   
2470   B7                     ORA   a   
2471   CA A4 24               JZ   hash_write_result   
2474                             ; 
2474                             ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
2474   3A BB 24               LDA   hash_reg_a   
2477   32 BE 24               STA   hash_src_reg   
247A                             ; 
247A                HASH_COPY_PAIR:      
247A                             ; HL = コレクションプール内の書き込み位置
247A                             ; key (4B) をコピー: R[src] → [HL]
247A   E5                     PUSH   h   ; 書き込み先を退避
247B   3A BE 24               LDA   hash_src_reg   
247E   CD 00 10               CALL   get_reg_addr   ; HL = R[src]
2481   D1                     POP   d   ; DE = 書き込み先
2482   CD 25 10               CALL   copy_slot   ; 4B コピー (HL, DE 共に +4)
2485                             ; DE = value 書き込み位置
2485                             ; 
2485                             ; value (4B) をコピー: R[src+1] → [DE]
2485   D5                     PUSH   d   ; value 書き込み先を退避
2486   3A BE 24               LDA   hash_src_reg   
2489   3C                     INR   a   
248A   CD 00 10               CALL   get_reg_addr   ; HL = R[src+1]
248D   D1                     POP   d   ; DE = value 書き込み先
248E   CD 25 10               CALL   copy_slot   ; 4B コピー
2491                             ; DE = 次ペアの先頭
2491                             ; 
2491                             ; ソースレジスタを +2
2491   3A BE 24               LDA   hash_src_reg   
2494   C6 02                  ADI   2   
2496   32 BE 24               STA   hash_src_reg   
2499                             ; 
2499                             ; HL = 次の書き込み位置 (DE から)
2499   EB                     XCHG      
249A                             ; 
249A                             ; ペアカウンタ
249A   3A BC 24               LDA   hash_count   
249D   3D                     DCR   a   
249E   32 BC 24               STA   hash_count   
24A1   C2 7A 24               JNZ   hash_copy_pair   
24A4                             ; 
24A4                HASH_WRITE_RESULT:      
24A4                             ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
24A4   3A BB 24               LDA   hash_reg_a   
24A7   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
24AA   36 09                  MVI   m,TT_HASH   ; +0: type
24AC   23                     INX   h   
24AD   36 00                  MVI   m,0   ; +1: reserved
24AF   23                     INX   h   
24B0   3A BD 24               LDA   hash_slot_num   
24B3   3C                     INR   a   ; slot + 1
24B4   77                     MOV   m,a   ; +2: val_lo
24B5   23                     INX   h   
24B6   36 00                  MVI   m,0   ; +3: val_hi
24B8   C3 1B 1C               JMP   vm_loop   
24BB                             ; 
24BB                             ; --- do_op_hash データ ---
24BB   00           HASH_REG_A:   DB   0   
24BC   00           HASH_COUNT:   DB   0   
24BD   00           HASH_SLOT_NUM:   DB   0   
24BE   00           HASH_SRC_REG:   DB   0   
24BF                             ; 
24BF                             ; ===============================================================
24BF                             ; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
24BF                             ; 
24BF                             ;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
24BF                             ;   キーが見つからなければ R[a] = nil
24BF                             ; ===============================================================
24BF                GIDX_HASH:      
24BF                             ; コレクションスロットを取得
24BF   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
24C2   23                     INX   h   ; +1: count
24C3   7E                     MOV   a,m   ; A = ペア数
24C4   23                     INX   h   ; HL → データ領域
24C5   B7                     ORA   a   
24C6   CA 12 25               JZ   ghash_not_found   ; 空 Hash
24C9                             ; 
24C9   32 26 25               STA   ghash_loop_cnt   
24CC   22 20 25               SHLD   ghash_data_ptr   
24CF                             ; 
24CF                             ; 検索キー R[a+1] のアドレスを取得
24CF   3A 0D 21               LDA   gidx_reg_a   
24D2   3C                     INR   a   
24D3   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
24D6   22 22 25               SHLD   ghash_key_ptr   
24D9                             ; 
24D9                             ; 検索ループ
24D9   2A 20 25               LHLD   ghash_data_ptr   
24DC                GHASH_SEARCH:      
24DC   22 24 25               SHLD   ghash_cur_ptr   ; 現在のペア先頭を保存
24DF                             ; 
24DF                             ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
24DF   E5                     PUSH   h   
24E0   2A 22 25               LHLD   ghash_key_ptr   
24E3   EB                     XCHG      ; DE = 検索キー
24E4   E1                     POP   h   ; HL = hash ペアのキー
24E5                             ; 
24E5   0E 04                  MVI   c,SLOT_BYTES   
24E7                GHASH_CMP:      
24E7   1A                     LDAX   d   
24E8   BE                     CMP   m   
24E9   C2 01 25               JNZ   ghash_next   
24EC   23                     INX   h   
24ED   13                     INX   d   
24EE   0D                     DCR   c   
24EF   C2 E7 24               JNZ   ghash_cmp   
24F2                             ; 
24F2                             ; 一致! HL = value 位置 (キー直後)
24F2                             ; value (4B) を R[a] にコピー
24F2   E5                     PUSH   h   ; value ソース
24F3   3A 0D 21               LDA   gidx_reg_a   
24F6   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
24F9   EB                     XCHG      ; DE = R[a] (コピー先)
24FA   E1                     POP   h   ; HL = value (コピー元)
24FB   CD 25 10               CALL   copy_slot   
24FE   C3 1B 1C               JMP   vm_loop   
2501                             ; 
2501                GHASH_NEXT:      
2501                             ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
2501   2A 24 25               LHLD   ghash_cur_ptr   
2504   11 08 00               LXI   d,HASH_PAIR_BYTES   
2507   19                     DAD   d   
2508   3A 26 25               LDA   ghash_loop_cnt   
250B   3D                     DCR   a   
250C   32 26 25               STA   ghash_loop_cnt   
250F   C2 DC 24               JNZ   ghash_search   
2512                             ; 
2512                GHASH_NOT_FOUND:      
2512                             ; R[a] = nil
2512   3A 0D 21               LDA   gidx_reg_a   
2515   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2518   3E 01                  MVI   a,TT_NIL   
251A   CD 1A 10               CALL   set_slot_special   
251D   C3 1B 1C               JMP   vm_loop   
2520                             ; 
2520                             ; --- gidx_hash データ ---
2520   00 00        GHASH_DATA_PTR:   DW   0   
2522   00 00        GHASH_KEY_PTR:   DW   0   
2524   00 00        GHASH_CUR_PTR:   DW   0   
2526   00           GHASH_LOOP_CNT:   DB   0   
2527                             ; 
2527                             ; ===============================================================
2527                             ; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
2527                             ; 
2527                             ;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
2527                             ;   既存キー → 値を上書き
2527                             ;   新規キー → count < MAX なら末尾に追加
2527                             ; ===============================================================
2527                SIDX_HASH:      
2527                             ; コレクションスロットを取得
2527   CD 62 20               CALL   col_from_reg   ; HL = コレクションスロット
252A   22 B6 25               SHLD   shash_col_ptr   ; スロット先頭を保存 (count 更新用)
252D   23                     INX   h   ; +1: count
252E   7E                     MOV   a,m   
252F   32 C0 25               STA   shash_pair_cnt   ; 元のペア数
2532   23                     INX   h   ; HL → データ領域
2533   22 B8 25               SHLD   shash_data_ptr   
2536                             ; 
2536                             ; R[a+1] キーのアドレス
2536   3A C4 21               LDA   sidx_reg_a   
2539   3C                     INR   a   
253A   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
253D   22 BA 25               SHLD   shash_key_ptr   
2540                             ; 
2540                             ; R[a+2] 値のアドレス
2540   3A C4 21               LDA   sidx_reg_a   
2543   C6 02                  ADI   2   
2545   CD 00 10               CALL   get_reg_addr   ; HL = R[a+2]
2548   22 BC 25               SHLD   shash_val_ptr   
254B                             ; 
254B                             ; 既存キーを検索
254B   3A C0 25               LDA   shash_pair_cnt   
254E   B7                     ORA   a   
254F   CA 89 25               JZ   shash_append   ; 空 Hash → 追加
2552                             ; 
2552   32 C1 25               STA   shash_loop_cnt   
2555   2A B8 25               LHLD   shash_data_ptr   
2558                             ; 
2558                SHASH_SEARCH:      
2558   22 BE 25               SHLD   shash_cur_ptr   
255B                             ; 
255B   E5                     PUSH   h   
255C   2A BA 25               LHLD   shash_key_ptr   
255F   EB                     XCHG      ; DE = 検索キー
2560   E1                     POP   h   ; HL = hash ペアのキー
2561                             ; 
2561   0E 04                  MVI   c,SLOT_BYTES   
2563                SHASH_CMP:      
2563   1A                     LDAX   d   
2564   BE                     CMP   m   
2565   C2 78 25               JNZ   shash_snext   
2568   23                     INX   h   
2569   13                     INX   d   
256A   0D                     DCR   c   
256B   C2 63 25               JNZ   shash_cmp   
256E                             ; 
256E                             ; 一致! HL = value 位置
256E                             ; R[a+2] を value にコピー
256E   EB                     XCHG      ; DE = hash value 位置
256F   2A BC 25               LHLD   shash_val_ptr   ; HL = R[a+2]
2572   CD 25 10               CALL   copy_slot   
2575   C3 1B 1C               JMP   vm_loop   
2578                             ; 
2578                SHASH_SNEXT:      
2578   2A BE 25               LHLD   shash_cur_ptr   
257B   11 08 00               LXI   d,HASH_PAIR_BYTES   
257E   19                     DAD   d   
257F   3A C1 25               LDA   shash_loop_cnt   
2582   3D                     DCR   a   
2583   32 C1 25               STA   shash_loop_cnt   
2586   C2 58 25               JNZ   shash_search   
2589                             ; 
2589                             ; 見つからなかった → 末尾に追加
2589                             ; 
2589                SHASH_APPEND:      
2589                             ; 容量チェック
2589   3A C0 25               LDA   shash_pair_cnt   
258C   FE 04                  CPI   COL_MAX_HASH_PAIRS   
258E   D2 03 00               JNC   vm_error   ; Hash 満杯
2591                             ; 
2591                             ; count++ を書き込み
2591   3C                     INR   a   
2592   F5                     PUSH   psw   
2593   2A B6 25               LHLD   shash_col_ptr   
2596   23                     INX   h   ; +1: count フィールド
2597   77                     MOV   m,a   
2598   F1                     POP   psw   
2599                             ; 
2599                             ; 追加位置 = data + old_count * 8
2599   3A C0 25               LDA   shash_pair_cnt   ; old count
259C   87                     ADD   a   ; ×2
259D   87                     ADD   a   ; ×4
259E   87                     ADD   a   ; ×8
259F   5F                     MOV   e,a   
25A0   16 00                  MVI   d,0   
25A2   2A B8 25               LHLD   shash_data_ptr   
25A5   19                     DAD   d   ; HL = 追加位置
25A6                             ; 
25A6                             ; key をコピー (R[a+1] → [HL])
25A6   EB                     XCHG      ; DE = 追加位置
25A7   2A BA 25               LHLD   shash_key_ptr   ; HL = R[a+1]
25AA   CD 25 10               CALL   copy_slot   ; key 4B、DE は value 位置に進む
25AD                             ; 
25AD                             ; value をコピー (R[a+2] → [DE])
25AD   2A BC 25               LHLD   shash_val_ptr   ; HL = R[a+2]
25B0                             ; DE は既に value 位置
25B0   CD 25 10               CALL   copy_slot   
25B3   C3 1B 1C               JMP   vm_loop   
25B6                             ; 
25B6                             ; --- sidx_hash データ ---
25B6   00 00        SHASH_COL_PTR:   DW   0   
25B8   00 00        SHASH_DATA_PTR:   DW   0   
25BA   00 00        SHASH_KEY_PTR:   DW   0   
25BC   00 00        SHASH_VAL_PTR:   DW   0   
25BE   00 00        SHASH_CUR_PTR:   DW   0   
25C0   00           SHASH_PAIR_CNT:   DB   0   
25C1   00           SHASH_LOOP_CNT:   DB   0   
25C2                             ; 
25C2                             ; ===============================================================
25C2                             ; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
25C2                             ; 
25C2                             ; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
25C2                             ; n 回スキャンしてもキーが見つからなければ nil を返す。
25C2                             ; ROM がなければ即 nil。
25C2                             ; 
25C2                             ; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
25C2                             ; 出力: R[a] = キーコード (0x00-0x17) or nil
25C2                             ; ===============================================================
25C2                SEND_GETKEY_TIMEOUT:      
25C2                             ; R[a+1] からタイムアウト回数を読む
25C2   3A 55 16               LDA   send_reg_a   
25C5   C6 01                  ADI   1   
25C7   CD 00 10               CALL   get_reg_addr   ; HL = R[a+1]
25CA   23                     INX   h   
25CB   23                     INX   h   ; +2: val_lo
25CC   4E                     MOV   c,m   
25CD   23                     INX   h   ; +3: val_hi
25CE   46                     MOV   b,m   ; BC = タイムアウト回数
25CF                             ; 
25CF                             ; ROM チェック
25CF   3A 47 06               LDA   KEY_ADDR   
25D2   B7                     ORA   a   
25D3   CA FD 25               JZ   getkey_timeout_nil   ; ROM なし → nil
25D6                             ; 
25D6                GETKEY_POLL_LOOP:      
25D6   78                     MOV   a,b   
25D7   B1                     ORA   c   
25D8   CA FD 25               JZ   getkey_timeout_nil   ; カウンタ = 0 → タイムアウト
25DB                             ; 
25DB   C5                     PUSH   b   ; カウンタ退避
25DC   CD 47 06               CALL   KEY_ADDR   ; A = キーコード or 0xFF
25DF   C1                     POP   b   ; カウンタ復帰
25E0   FE FF                  CPI   0FFh   
25E2   C2 EE 25               JNZ   getkey_timeout_got   ; キー押下!
25E5                             ; 
25E5   C5                     PUSH   b   ; カウンタ退避
25E6   CD DE 1F               CALL   lfsr_next   ; 待機中に LFSR を進める
25E9   C1                     POP   b   
25EA   0B                     DCX   b   ; カウンタ--
25EB   C3 D6 25               JMP   getkey_poll_loop   
25EE                             ; 
25EE                GETKEY_TIMEOUT_GOT:      
25EE                             ; A = キーコード (0x00-0x17)
25EE   4F                     MOV   c,a   
25EF   06 00                  MVI   b,0   
25F1   3A 55 16               LDA   send_reg_a   
25F4   CD 00 10               CALL   get_reg_addr   
25F7   CD 10 10               CALL   set_slot_int16   
25FA   C3 1B 1C               JMP   vm_loop   
25FD                             ; 
25FD                GETKEY_TIMEOUT_NIL:      
25FD   3A 55 16               LDA   send_reg_a   
2600   CD 00 10               CALL   get_reg_addr   
2603   3E 01                  MVI   a,TT_NIL   
2605   CD 1A 10               CALL   set_slot_special   
2608   C3 1B 1C               JMP   vm_loop   
260B                             ; 
260B                             ; ===============================================================
260B                             ; send_slice — [](offset, length): 文字列スライス
260B                             ; 
260B                             ; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
260B                             ; 
260B                             ;   入力: send_reg_a = a, send_argc = 2
260B                             ;         R[a] = TT_STRING (対象文字列)
260B                             ;         R[a+1] = offset (TT_INTEGER, 0-based)
260B                             ;         R[a+2] = length (TT_INTEGER)
260B                             ;   出力: R[a] = 新しい部分文字列 (TT_STRING)
260B                             ;         offset >= 文字列長 → 空文字列
260B                             ;         length は利用可能バイト数にクランプ
260B                             ; ===============================================================
260B                SEND_SLICE:      
260B                             ; R[a] が TT_STRING か確認
260B   3A 55 16               LDA   send_reg_a   
260E   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2611   7E                     MOV   a,m   ; A = 型タグ
2612   FE 07                  CPI   TT_STRING   
2614   C2 03 00               JNZ   vm_error   
2617                             ; 
2617                             ; ソース文字列のコレクションスロットを取得
2617   3A 55 16               LDA   send_reg_a   
261A   CD 00 10               CALL   get_reg_addr   
261D   CD 62 20               CALL   col_from_reg   ; HL = collection slot
2620   23                     INX   h   ; +1: count
2621   7E                     MOV   a,m   
2622   32 B2 26               STA   slice_src_count   
2625   23                     INX   h   ; HL → data
2626   22 B3 26               SHLD   slice_src_data   
2629                             ; 
2629                             ; R[a+1] から offset を取得
2629   3A 55 16               LDA   send_reg_a   
262C   C6 01                  ADI   1   
262E   CD 00 10               CALL   get_reg_addr   
2631   CD 32 10               CALL   slot_to_value   
2634   7E                     MOV   a,m   ; A = offset (val_lo)
2635   32 B5 26               STA   slice_offset   
2638                             ; 
2638                             ; R[a+2] から length を取得
2638   3A 55 16               LDA   send_reg_a   
263B   C6 02                  ADI   2   
263D   CD 00 10               CALL   get_reg_addr   
2640   CD 32 10               CALL   slot_to_value   
2643   7E                     MOV   a,m   ; A = length (val_lo)
2644   32 B6 26               STA   slice_length   
2647                             ; 
2647                             ; offset >= src_count → 空文字列
2647   3A B5 26               LDA   slice_offset   
264A   47                     MOV   b,a   ; B = offset
264B   3A B2 26               LDA   slice_src_count   ; A = src_count
264E   B8                     CMP   b   
264F   DA A4 26               JC   slice_empty   ; src_count < offset
2652   CA A4 26               JZ   slice_empty   ; src_count == offset
2655                             ; 
2655                             ; available = src_count - offset
2655   90                     SUB   b   ; A = available
2656   47                     MOV   b,a   ; B = available
2657   3A B6 26               LDA   slice_length   
265A   B8                     CMP   b   
265B   DA 5F 26               JC   slice_len_ok   ; length < available → そのまま
265E   78                     MOV   a,b   ; clamp: length = available
265F                SLICE_LEN_OK:      
265F   32 B6 26               STA   slice_length   ; 実際のコピー長
2662                             ; 
2662                             ; 新しいコレクションスロットを確保
2662   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
2665   32 B7 26               STA   slice_new_slot   
2668   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
266A   23                     INX   h   
266B   3A B6 26               LDA   slice_length   
266E   77                     MOV   m,a   ; +1: count = コピー長
266F   23                     INX   h   ; HL → new data area
2670                             ; 
2670                             ; ソースデータ先頭 + offset
2670   E5                     PUSH   h   ; dest を退避
2671   2A B3 26               LHLD   slice_src_data   
2674   3A B5 26               LDA   slice_offset   
2677   5F                     MOV   e,a   
2678   16 00                  MVI   d,0   
267A   19                     DAD   d   ; HL = src_data + offset
267B   EB                     XCHG      ; DE = src + offset
267C   E1                     POP   h   ; HL = dest
267D                             ; 
267D                             ; バイトコピー
267D   3A B6 26               LDA   slice_length   
2680   B7                     ORA   a   
2681   CA 8D 26               JZ   slice_done   
2684   4F                     MOV   c,a   
2685                SLICE_COPY:      
2685   1A                     LDAX   d   
2686   77                     MOV   m,a   
2687   23                     INX   h   
2688   13                     INX   d   
2689   0D                     DCR   c   
268A   C2 85 26               JNZ   slice_copy   
268D                             ; 
268D                SLICE_DONE:      
268D                             ; R[a] = TT_STRING, val_lo = new_slot + 1
268D   3A 55 16               LDA   send_reg_a   
2690   CD 00 10               CALL   get_reg_addr   
2693   36 07                  MVI   m,TT_STRING   ; +0: type
2695   23                     INX   h   
2696   36 00                  MVI   m,0   ; +1: reserved
2698   23                     INX   h   
2699   3A B7 26               LDA   slice_new_slot   
269C   3C                     INR   a   ; slot + 1
269D   77                     MOV   m,a   ; +2: val_lo
269E   23                     INX   h   
269F   36 00                  MVI   m,0   ; +3: val_hi
26A1   C3 1B 1C               JMP   vm_loop   
26A4                             ; 
26A4                SLICE_EMPTY:      
26A4                             ; 空文字列を返す
26A4   CD 4D 20               CALL   col_alloc   ; A = slot_number, HL = スロットアドレス
26A7   32 B7 26               STA   slice_new_slot   
26AA   36 01                  MVI   m,COL_TYPE_STRING   ; +0: type
26AC   23                     INX   h   
26AD   36 00                  MVI   m,0   ; +1: count = 0
26AF   C3 8D 26               JMP   slice_done   
26B2                             ; 
26B2                             ; --- send_slice データ ---
26B2   00           SLICE_SRC_COUNT:   DB   0   
26B3   00 00        SLICE_SRC_DATA:   DW   0   
26B5   00           SLICE_OFFSET:   DB   0   
26B6   00           SLICE_LENGTH:   DB   0   
26B7   00           SLICE_NEW_SLOT:   DB   0   
26B8                             ; 
26B8                             ; ===============================================================
26B8                             ; col_gc_alloc — 到達性を辿る回収つきのスロット確保
26B8                             ; 
26B8                             ; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
26B8                             ; 
26B8                             ; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
26B8                             ; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
26B8                             ; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
26B8                             ; 
26B8                             ; ルート:
26B8                             ;   レジスタファイル    MAX_REGS 個の値スロット
26B8                             ;   グローバル変数      MAX_GLOBALS 個の値スロット
26B8                             ;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
26B8                             ; 
26B8                             ; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
26B8                             ; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
26B8                             ; 起動時にゼロクリアされていて型 0 なので素通りする。
26B8                             ; 
26B8                             ; 伝播:
26B8                             ;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
26B8                             ;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
26B8                             ; 
26B8                             ;   出力: A = スロット番号, HL = スロットアドレス
26B8                             ;   エラー: 全スロット生きている → vm_error
26B8                             ; ===============================================================
26B8                COL_GC_ALLOC:      
26B8                             ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
26B8   AF                     XRA   a   
26B9   21 21 28               LXI   h,gc_bitmap   
26BC   0E 10                  MVI   c,16   
26BE                GC_CLEAR_BM:      
26BE   77                     MOV   m,a   
26BF   23                     INX   h   
26C0   0D                     DCR   c   
26C1   C2 BE 26               JNZ   gc_clear_bm   
26C4                             ; 
26C4                             ; --- ルート: レジスタファイル ---
26C4                             ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
26C4   21 00 81               LXI   h,REG_FILE_BASE   
26C7   06 40                  MVI   b,MAX_REGS   
26C9                GC_ROOT_REG:      
26C9   CD A6 27               CALL   gc_mark_value   
26CC   23                     INX   h   
26CD   23                     INX   h   
26CE   23                     INX   h   
26CF   23                     INX   h   
26D0   05                     DCR   b   
26D1   C2 C9 26               JNZ   gc_root_reg   
26D4                             ; 
26D4                             ; --- ルート: グローバル変数 ---
26D4   21 00 90               LXI   h,GLOBALS_BASE   
26D7   06 40                  MVI   b,MAX_GLOBALS   
26D9                GC_ROOT_GLOBAL:      
26D9   CD A6 27               CALL   gc_mark_value   
26DC   23                     INX   h   
26DD   23                     INX   h   
26DE   23                     INX   h   
26DF   23                     INX   h   
26E0   05                     DCR   b   
26E1   C2 D9 26               JNZ   gc_root_global   
26E4                             ; 
26E4                             ; --- ルート: オブジェクトのインスタンス変数 ---
26E4   21 C4 92               LXI   h,OBJECT_POOL_BASE + OBJECT_HEADER_SIZE   
26E7   06 20                  MVI   b,MAX_OBJECTS   
26E9                GC_ROOT_OBJ:      
26E9   C5                     PUSH   b   
26EA   E5                     PUSH   h   
26EB   06 07                  MVI   b,MAX_IVARS   
26ED                GC_ROOT_IVAR:      
26ED   CD A6 27               CALL   gc_mark_value   
26F0   23                     INX   h   
26F1   23                     INX   h   
26F2   23                     INX   h   
26F3   23                     INX   h   
26F4   05                     DCR   b   
26F5   C2 ED 26               JNZ   gc_root_ivar   
26F8   E1                     POP   h   
26F9   11 20 00               LXI   d,OBJECT_SLOT_SIZE   
26FC   19                     DAD   d   ; 次のオブジェクトの ivar 先頭
26FD   C1                     POP   b   
26FE   05                     DCR   b   
26FF   C2 E9 26               JNZ   gc_root_obj   
2702                             ; 
2702                             ; --- 到達性を伝播する ---
2702   CD 1F 27               CALL   gc_propagate   
2705                             ; 
2705                             ; --- 印の付かなかったスロットを探す ---
2705                             ; B をカウンタに使う (gc_check_bit は B を壊さない)
2705   06 00                  MVI   b,0   
2707                GC_FIND_FREE:      
2707   78                     MOV   a,b   ; A = 検査対象スロット番号
2708   CD FC 27               CALL   gc_check_bit   ; Z=1: 空き (A は破壊される)
270B   CA 18 27               JZ   gc_found_free   
270E   04                     INR   b   
270F   78                     MOV   a,b   
2710   FE 40                  CPI   MAX_COL_SLOTS   
2712   DA 07 27               JC   gc_find_free   
2715   C3 03 00               JMP   vm_error   ; 全スロット使用中
2718                             ; 
2718                GC_FOUND_FREE:      
2718   78                     MOV   a,b   ; A = 空きスロット番号 (B から復帰)
2719   F5                     PUSH   psw   ; スロット番号を退避
271A   CD 3D 20               CALL   col_slot_addr   ; HL = スロットアドレス
271D   F1                     POP   psw   ; A = スロット番号を復帰
271E   C9                     RET      
271F                             ; 
271F                             ; ---------------------------------------------------------------
271F                             ; gc_propagate — 印が増えなくなるまで中身を辿る
271F                             ; 
271F                             ; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
271F                             ; 1 周で 1 つも走査しなければ終わり。
271F                             ; ---------------------------------------------------------------
271F                GC_PROPAGATE:      
271F   AF                     XRA   a   
2720   32 31 28               STA   gc_changed   
2723   06 00                  MVI   b,0   ; B = スロット番号
2725                GC_PROP_SLOT:      
2725   78                     MOV   a,b   
2726   CD FC 27               CALL   gc_check_bit   ; 印が無ければ飛ばす
2729   CA 42 27               JZ   gc_prop_next   
272C   78                     MOV   a,b   
272D   CD 15 28               CALL   gc_check_scanned   ; 走査済みなら飛ばす
2730   C2 42 27               JNZ   gc_prop_next   
2733   78                     MOV   a,b   
2734   CD 08 28               CALL   gc_set_scanned   
2737   3E 01                  MVI   a,1   
2739   32 31 28               STA   gc_changed   
273C   78                     MOV   a,b   
273D   C5                     PUSH   b   
273E   CD 51 27               CALL   gc_scan_slot   
2741   C1                     POP   b   
2742                GC_PROP_NEXT:      
2742   04                     INR   b   
2743   78                     MOV   a,b   
2744   FE 40                  CPI   MAX_COL_SLOTS   
2746   DA 25 27               JC   gc_prop_slot   
2749   3A 31 28               LDA   gc_changed   
274C   B7                     ORA   a   
274D   C2 1F 27               JNZ   gc_propagate   ; 印が増えたのでもう 1 周
2750   C9                     RET      
2751                             ; 
2751                             ; ---------------------------------------------------------------
2751                             ; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
2751                             ; 
2751                             ; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
2751                             ; 読むと、前に入っていた文字列のバイトが型タグに見える。
2751                             ; 
2751                             ; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
2751                             ; でも隣のスロットまで歩かないようにする。
2751                             ; ---------------------------------------------------------------
2751                GC_SCAN_SLOT:      
2751   C5                     PUSH   b   
2752   CD 3D 20               CALL   col_slot_addr   ; HL = スロットアドレス (A は残る)
2755   7E                     MOV   a,m   ; +0: 型
2756   23                     INX   h   
2757   46                     MOV   b,m   ; +1: 要素数 / 組の数
2758   23                     INX   h   ; HL = データ先頭
2759   FE 02                  CPI   COL_TYPE_ARRAY   
275B   CA 66 27               JZ   gc_scan_array   
275E   FE 03                  CPI   COL_TYPE_HASH   
2760   CA 83 27               JZ   gc_scan_hash   
2763   C3 A4 27               JMP   gc_scan_done   ; 文字列と空きは辿らない
2766                GC_SCAN_ARRAY:      
2766   78                     MOV   a,b   
2767   B7                     ORA   a   
2768   CA A4 27               JZ   gc_scan_done   ; 要素数 0
276B                             ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
276B                             ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
276B   FE 08                  CPI   COL_MAX_ARRAY_ELEMS   
276D   DA 75 27               JC   gc_scan_aloop   ; 容量未満
2770   CA 75 27               JZ   gc_scan_aloop   ; ちょうど容量
2773   06 08                  MVI   b,COL_MAX_ARRAY_ELEMS   
2775                GC_SCAN_ALOOP:      
2775   CD A6 27               CALL   gc_mark_value   
2778   23                     INX   h   
2779   23                     INX   h   
277A   23                     INX   h   
277B   23                     INX   h   
277C   05                     DCR   b   
277D   C2 75 27               JNZ   gc_scan_aloop   
2780   C3 A4 27               JMP   gc_scan_done   
2783                GC_SCAN_HASH:      
2783   78                     MOV   a,b   
2784   B7                     ORA   a   
2785   CA A4 27               JZ   gc_scan_done   ; 組の数 0
2788   FE 04                  CPI   COL_MAX_HASH_PAIRS   
278A   DA 92 27               JC   gc_scan_hloop   
278D   CA 92 27               JZ   gc_scan_hloop   
2790   06 04                  MVI   b,COL_MAX_HASH_PAIRS   
2792                GC_SCAN_HLOOP:      
2792   CD A6 27               CALL   gc_mark_value   ; 鍵
2795   23                     INX   h   
2796   23                     INX   h   
2797   23                     INX   h   
2798   23                     INX   h   
2799   CD A6 27               CALL   gc_mark_value   ; 値
279C   23                     INX   h   
279D   23                     INX   h   
279E   23                     INX   h   
279F   23                     INX   h   
27A0   05                     DCR   b   
27A1   C2 92 27               JNZ   gc_scan_hloop   
27A4                GC_SCAN_DONE:      
27A4   C1                     POP   b   
27A5   C9                     RET      
27A6                             ; 
27A6                             ; ---------------------------------------------------------------
27A6                             ; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
27A6                             ; 
27A6                             ; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
27A6                             ; なのでここでは何もしない (中身はルート走査で辿る)。
27A6                             ; 
27A6                             ; **値は スロット + 1。** 0 は「無し」。
27A6                             ; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
27A6                             ; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
27A6                             ; 
27A6                             ;   HL / DE / BC は保たれる
27A6                             ; ---------------------------------------------------------------
27A6                GC_MARK_VALUE:      
27A6   E5                     PUSH   h   
27A7   D5                     PUSH   d   
27A8   C5                     PUSH   b   
27A9   7E                     MOV   a,m   ; A = 型タグ
27AA   FE 07                  CPI   TT_STRING   
27AC   CA BC 27               JZ   gc_mv_ref   
27AF   FE 08                  CPI   TT_ARRAY   
27B1   CA BC 27               JZ   gc_mv_ref   
27B4   FE 09                  CPI   TT_HASH   
27B6   CA BC 27               JZ   gc_mv_ref   
27B9   C3 D3 27               JMP   gc_mv_done   
27BC                GC_MV_REF:      
27BC   23                     INX   h   
27BD   23                     INX   h   
27BE   23                     INX   h   
27BF   7E                     MOV   a,m   ; +3: val_hi
27C0   B7                     ORA   a   
27C1   C2 D3 27               JNZ   gc_mv_done   ; 上位が 0 でなければスロット番号ではない
27C4   2B                     DCX   h   
27C5   7E                     MOV   a,m   ; +2: val_lo = スロット + 1
27C6   B7                     ORA   a   
27C7   CA D3 27               JZ   gc_mv_done   ; 0 = 無し
27CA   3D                     DCR   a   ; A = スロット番号
27CB   FE 40                  CPI   MAX_COL_SLOTS   
27CD   D2 D3 27               JNC   gc_mv_done   ; 範囲外
27D0   CD EF 27               CALL   gc_set_bit   
27D3                GC_MV_DONE:      
27D3   C1                     POP   b   
27D4   D1                     POP   d   
27D5   E1                     POP   h   
27D6   C9                     RET      
27D7                             ; 
27D7                             ; ---------------------------------------------------------------
27D7                             ; ビットの出し入れ
27D7                             ; 
27D7                             ; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
27D7                             ; 直して食い違うのを避けるため。
27D7                             ; 
27D7                             ; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
27D7                             ;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
27D7                             ; ---------------------------------------------------------------
27D7                GC_BIT_PTR:      
27D7   4F                     MOV   c,a   ; C = スロット番号
27D8   0F                     RRC      
27D9   0F                     RRC      
27DA   0F                     RRC      
27DB   E6 07                  ANI   07h   ; A = バイト位置 (slot >> 3)
27DD   6F                     MOV   l,a   
27DE   26 00                  MVI   h,0   
27E0   19                     DAD   d   ; HL = 先頭 + バイト位置
27E1   E5                     PUSH   h   
27E2   79                     MOV   a,c   
27E3   E6 07                  ANI   07h   ; ビット位置 (slot & 7)
27E5   6F                     MOV   l,a   
27E6   26 00                  MVI   h,0   
27E8   11 32 28               LXI   d,gc_bit_table   
27EB   19                     DAD   d   
27EC   7E                     MOV   a,m   ; A = ビットマスク
27ED   E1                     POP   h   ; HL = ビットマップのバイト
27EE   C9                     RET      
27EF                             ; 
27EF                             ; --- gc_set_bit: A = slot (0-63) の印を立てる ---
27EF                GC_SET_BIT:      
27EF   E5                     PUSH   h   
27F0   D5                     PUSH   d   
27F1   11 21 28               LXI   d,gc_bitmap   
27F4   CD D7 27               CALL   gc_bit_ptr   
27F7   B6                     ORA   m   
27F8   77                     MOV   m,a   
27F9   D1                     POP   d   
27FA   E1                     POP   h   
27FB   C9                     RET      
27FC                             ; 
27FC                             ; --- gc_check_bit: A = slot の印を検査 ---
27FC                             ; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
27FC                GC_CHECK_BIT:      
27FC   E5                     PUSH   h   
27FD   D5                     PUSH   d   
27FE   11 21 28               LXI   d,gc_bitmap   
2801   CD D7 27               CALL   gc_bit_ptr   
2804   A6                     ANA   m   ; Z=1 ならビットクリア
2805   D1                     POP   d   ; POP はフラグを変えない
2806   E1                     POP   h   
2807   C9                     RET      
2808                             ; 
2808                             ; --- gc_set_scanned: A = slot を走査済みにする ---
2808                GC_SET_SCANNED:      
2808   E5                     PUSH   h   
2809   D5                     PUSH   d   
280A   11 29 28               LXI   d,gc_scanned   
280D   CD D7 27               CALL   gc_bit_ptr   
2810   B6                     ORA   m   
2811   77                     MOV   m,a   
2812   D1                     POP   d   
2813   E1                     POP   h   
2814   C9                     RET      
2815                             ; 
2815                             ; --- gc_check_scanned: A = slot が走査済みか ---
2815                             ; 戻り: Z=1 → まだ、Z=0 → 済み
2815                GC_CHECK_SCANNED:      
2815   E5                     PUSH   h   
2816   D5                     PUSH   d   
2817   11 29 28               LXI   d,gc_scanned   
281A   CD D7 27               CALL   gc_bit_ptr   
281D   A6                     ANA   m   
281E   D1                     POP   d   
281F   E1                     POP   h   
2820   C9                     RET      
2821                             ; 
2821                             ; --- GC データ ---
2821                             ; 
2821                             ; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
2821                             ; 回している
2821   00 00 00 00 00 00 00 00 GC_BITMAP:   DB   0,0,0,0,0,0,0,0   
2829   00 00 00 00 00 00 00 00 GC_SCANNED:   DB   0,0,0,0,0,0,0,0   
2831   00           GC_CHANGED:   DB   0   
2832   01 02 04 08 10 20 40 80 GC_BIT_TABLE:   DB   01h,02h,04h,08h,10h,20h,40h,80h   
283A                             ; 
283A                             ; ===============================================================
283A                             ; sendb_each — Array#each / Hash#each
283A                             ; 
283A                             ;   R[a] = TT_ARRAY か TT_HASH (レシーバ)
283A                             ;   R[a+argc+1] = TT_PROC (ブロック)
283A                             ;   配列: 各反復で R[1] = array[index]
283A                             ;   ハッシュ: 各反復で R[1] = 鍵, R[2] = 値
283A                             ; 
283A                             ; FRAME_KIND_EACH / FRAME_KIND_HASH_EACH を使い、フレーム +11
283A                             ; (reserved) にコレクションスロット番号を格納する。
283A                             ; 
283A                             ; **見出しの +1 (count) はどちらも「反復の回数」です。** 配列なら要素数、
283A                             ; ハッシュならペア数なので、上限の出し方を分ける必要がありません。
283A                             ; 違うのはブロックへ渡す値だけで、そこは each_block_args に出しています。
283A                             ; ===============================================================
283A                SENDB_EACH:      
283A                             ; each はレシーバの型でフレーム種別を決める
283A                             ; (述語は sendb_pred が種別を書いてから合流する)
283A   3A CC 18               LDA   sendb_reg_a   
283D   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
2840   7E                     MOV   a,m   
2841   FE 08                  CPI   TT_ARRAY   
2843   CA 50 28               JZ   each_kind_array   
2846   FE 09                  CPI   TT_HASH   
2848   C2 03 00               JNZ   vm_error   
284B   3E 03                  MVI   a,FRAME_KIND_HASH_EACH   
284D   C3 52 28               JMP   each_kind_set   
2850                EACH_KIND_ARRAY:      
2850   3E 02                  MVI   a,FRAME_KIND_EACH   
2852                EACH_KIND_SET:      
2852   32 56 29               STA   each_arg_kind   
2855                             ; 
2855                SENDB_EACH_JOIN:      
2855                             ; レシーバが配列かハッシュであること (述語もここを通る)
2855   3A CC 18               LDA   sendb_reg_a   
2858   CD 00 10               CALL   get_reg_addr   ; HL = R[a]
285B   7E                     MOV   a,m   
285C   FE 08                  CPI   TT_ARRAY   
285E   CA 66 28               JZ   each_recv_ok   
2861   FE 09                  CPI   TT_HASH   
2863   C2 03 00               JNZ   vm_error   
2866                EACH_RECV_OK:      
2866                             ; 
2866                             ; コレクションスロット番号を取得 (配列・ハッシュとも val_lo = slot + 1)
2866   3A CC 18               LDA   sendb_reg_a   
2869   CD 00 10               CALL   get_reg_addr   
286C   CD 32 10               CALL   slot_to_value   ; HL = 値先頭
286F   7E                     MOV   a,m   ; val_lo = slot + 1
2870   3D                     DCR   a   ; slot number (0-based)
2871   32 54 29               STA   each_col_slot   
2874                             ; 
2874                             ; 反復の回数を読む (配列なら要素数、ハッシュならペア数)
2874   3A 54 29               LDA   each_col_slot   
2877   CD 3D 20               CALL   col_slot_addr   ; HL = スロットアドレス
287A   23                     INX   h   ; +1: count
287B   7E                     MOV   a,m   
287C   32 55 29               STA   each_count   
287F   B7                     ORA   a   
2880   CA D9 28               JZ   each_empty   ; 空 → ブロック実行しない
2883                             ; 
2883                             ; ブロック (TT_PROC) の情報を読む
2883   3A CE 18               LDA   sendb_argc   
2886   3C                     INR   a   ; argc + 1
2887   47                     MOV   b,a   
2888   3A CC 18               LDA   sendb_reg_a   
288B   80                     ADD   b   ; A = a + argc + 1
288C   CD 00 10               CALL   get_reg_addr   ; HL = R[a+argc+1]
288F   CD 32 10               CALL   slot_to_value   
2892   7E                     MOV   a,m   ; irep 番号
2893   32 D0 18               STA   sendb_block_irep   
2896   23                     INX   h   
2897   7E                     MOV   a,m   ; outer
2898   32 D1 18               STA   sendb_block_outer   
289B                             ; 
289B                             ; push_frame(a, kind, outer)
289B   3A 56 29               LDA   each_arg_kind   
289E   47                     MOV   b,a   
289F   3A D1 18               LDA   sendb_block_outer   
28A2   4F                     MOV   c,a   
28A3   3A CC 18               LDA   sendb_reg_a   
28A6   CD A4 16               CALL   push_frame   
28A9                             ; 
28A9                             ; フレームに limit = count - 1 を設定
28A9   CD 9D 16               CALL   cur_frame_addr   
28AC   11 08 00               LXI   d,FRAME_OFF_LIMIT   
28AF   19                     DAD   d   
28B0   3A 55 29               LDA   each_count   
28B3   3D                     DCR   a   ; limit = count - 1
28B4   77                     MOV   m,a   ; limit_lo
28B5   23                     INX   h   
28B6   36 00                  MVI   m,0   ; limit_hi
28B8                             ; 
28B8                             ; フレーム +11 (reserved) にコレクションスロット番号を格納
28B8   CD 9D 16               CALL   cur_frame_addr   
28BB   11 0B 00               LXI   d,11   
28BE   19                     DAD   d   
28BF   3A 54 29               LDA   each_col_slot   
28C2   77                     MOV   m,a   
28C3                             ; 
28C3                             ; 最初の回のブロック引数 (index = 0)
28C3   AF                     XRA   a   
28C4   32 57 29               STA   each_index   
28C7   CD 00 29               CALL   each_block_args   
28CA                             ; 
28CA                             ; 子 irep に切り替え
28CA   3A D0 18               LDA   sendb_block_irep   
28CD   CD 29 17               CALL   switch_irep   
28D0                             ; 
28D0                             ; PC = 0
28D0   21 00 00               LXI   h,0   
28D3   22 00 80               SHLD   VM_STATE_BASE + OFF_PC   
28D6   C3 1B 1C               JMP   vm_loop   
28D9                             ; 
28D9                             ; ===============================================================
28D9                             ; each_empty — 1 回も回らないとき
28D9                             ; 
28D9                             ; each はレシーバがそのまま呼び出しの値になるので何もしません。
28D9                             ; **述語だけは答えを書きます** (空の any? は false、all? と none? は true)。
28D9                             ; フレームを積まないので、ここで決まります。
28D9                             ; ===============================================================
28D9                EACH_EMPTY:      
28D9   3A 56 29               LDA   each_arg_kind   
28DC   FE 06                  CPI   FRAME_KIND_ANY   
28DE   DA 1B 1C               JC   vm_loop   ; 述語ではない → レシーバのまま
28E1   FE 06                  CPI   FRAME_KIND_ANY   
28E3   CA EB 28               JZ   each_empty_false   ; any? → false
28E6   3E 03                  MVI   a,TT_TRUE   ; all? / none? → true
28E8   C3 ED 28               JMP   each_empty_write   
28EB                EACH_EMPTY_FALSE:      
28EB   3E 02                  MVI   a,TT_FALSE   
28ED                EACH_EMPTY_WRITE:      
28ED   32 FF 28               STA   each_empty_tag   
28F0   3A CC 18               LDA   sendb_reg_a   
28F3   CD 00 10               CALL   get_reg_addr   ; HL = R[a] (呼び出しの値になる場所)
28F6   3A FF 28               LDA   each_empty_tag   
28F9   CD 1A 10               CALL   set_slot_special   
28FC   C3 1B 1C               JMP   vm_loop   
28FF                             ; 
28FF   00           EACH_EMPTY_TAG:   DB   0   
2900                             ; 
2900                             ; ===============================================================
2900                             ; each_block_args — 反復のその回の値をブロックの引数へ
2900                             ; 
2900                             ;   入力: each_arg_kind / each_col_slot / each_index
2900                             ;   出力: R[1] (配列なら要素、ハッシュなら鍵)
2900                             ;         ハッシュなら R[2] にも値
2900                             ; 
2900                             ; **sendb_each と advance_iteration の両方から呼びます。** 最初の回と
2900                             ; 2 回目以降で同じ場所の出し方をするためで、以前は 1 回目を sendb_each に
2900                             ; 書き写していました。
2900                             ; 
2900                             ; **添字は下位バイトだけ見ます。** 配列は 8 要素、ハッシュは 4 ペアまでで、
2900                             ; 上限がバイトに収まります。
2900                             ; ===============================================================
2900                EACH_BLOCK_ARGS:      
2900   3A 54 29               LDA   each_col_slot   
2903   CD 3D 20               CALL   col_slot_addr   ; HL = スロットアドレス
2906   7E                     MOV   a,m   ; +0: 見出しの種別 (COL_TYPE_*)
2907   32 5A 29               STA   eba_col_type   
290A   23                     INX   h   ; skip type
290B   23                     INX   h   ; skip count → data
290C                             ; **渡す値はスロットの見出しで決めます。** フレームの種別ではありません —
290C                             ; 述語は配列とハッシュで種別を分けていないためです
290C   3A 5A 29               LDA   eba_col_type   
290F   FE 03                  CPI   COL_TYPE_HASH   
2911   CA 29 29               JZ   eba_hash   
2914                             ; 
2914                             ; --- 配列: data + index * 4 ---
2914   3A 57 29               LDA   each_index   
2917   87                     ADD   a   ; ×2
2918   87                     ADD   a   ; ×4
2919   5F                     MOV   e,a   
291A   16 00                  MVI   d,0   
291C   19                     DAD   d   ; HL = &data[index*4]
291D   E5                     PUSH   h   
291E   3E 01                  MVI   a,1   
2920   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
2923   EB                     XCHG      ; DE = R[1] (コピー先)
2924   E1                     POP   h   ; HL = コピー元
2925   CD 25 10               CALL   copy_slot   ; R[1] = array[index]
2928   C9                     RET      
2929                             ; 
2929                             ; --- ハッシュ: data + index * 8 が鍵、その +4 が値 ---
2929                EBA_HASH:      
2929   3A 57 29               LDA   each_index   
292C   87                     ADD   a   ; ×2
292D   87                     ADD   a   ; ×4
292E   87                     ADD   a   ; ×8
292F   5F                     MOV   e,a   
2930   16 00                  MVI   d,0   
2932   19                     DAD   d   ; HL = &pair
2933   22 58 29               SHLD   eba_pair   ; copy_slot が HL を進めるので退避
2936   E5                     PUSH   h   
2937   3E 01                  MVI   a,1   
2939   CD 00 10               CALL   get_reg_addr   ; HL = R[1]
293C   EB                     XCHG      ; DE = R[1]
293D   E1                     POP   h   ; HL = &鍵
293E   CD 25 10               CALL   copy_slot   ; R[1] = 鍵
2941   2A 58 29               LHLD   eba_pair   
2944   11 04 00               LXI   d,4   
2947   19                     DAD   d   ; HL = &値
2948   E5                     PUSH   h   
2949   3E 02                  MVI   a,2   
294B   CD 00 10               CALL   get_reg_addr   ; HL = R[2]
294E   EB                     XCHG      ; DE = R[2]
294F   E1                     POP   h   ; HL = &値
2950   CD 25 10               CALL   copy_slot   ; R[2] = 値
2953   C9                     RET      
2954                             ; 
2954                             ; --- sendb_each データ ---
2954   00           EACH_COL_SLOT:   DB   0   
2955   00           EACH_COUNT:   DB   0   
2956   00           EACH_ARG_KIND:   DB   0   
2957   00           EACH_INDEX:   DB   0   
2958   00 00        EBA_PAIR:   DW   0   
295A   00           EBA_COL_TYPE:   DB   0   
295B                             ; 
295B                          END      


