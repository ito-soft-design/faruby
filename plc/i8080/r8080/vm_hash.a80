; vm_hash.a80 — Hash (連想配列) ハンドラ / GC / コレクション操作
;
; Hash スロット形式 (コレクションプール 36B スロット内):
;   +0: type  (1B)  COL_TYPE_HASH = 3
;   +1: count (1B)  ペア数 (最大 4)
;   +2: data  (34B) key(4B)+value(4B) × 4 = 32B 使用
;
; キー検索は線形 4 バイト比較。

; ===============================================================
; do_op_array2 — OP_ARRAY2 (BBB): R[a] = [R[b], ..., R[b+c-1]]
;
; OP_ARRAY (BB) とソースレジスタが異なるだけ。共通コードに合流。
; ===============================================================
do_op_array2:
  call fetch_byte       ; A = a (書き込み先)
  sta oary_reg_a
  call fetch_byte       ; A = b (ソースレジスタ先頭)
  sta oary_src_reg
  call fetch_byte       ; A = c (要素数)
  jmp oa2_join

; ===============================================================
; do_op_hash — OP_HASH (BB): R[a] = {R[a+1]=>R[a+2], ...}
;
;   a = 書き込み先レジスタ
;   b = ペア数 (0 = 空 Hash)
;   ソース: R[a+1]=key1, R[a+2]=val1, R[a+3]=key2, ...
; ===============================================================
do_op_hash:
  call fetch_byte       ; A = a (書き込み先)
  sta hash_reg_a
  call fetch_byte       ; A = b (ペア数)
  sta hash_count

  ; コレクションスロット確保
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta hash_slot_num

  ; ヘッダ書き込み
  mvi m, COL_TYPE_HASH  ; +0: type
  inx h
  lda hash_count
  mov m, a              ; +1: count
  inx h                 ; HL → データ領域先頭

  ; ペアがなければ結果書き込みへ
  lda hash_count
  ora a
  jz hash_write_result

  ; ソースレジスタ = a (mruby3 は R[a] からペアを読む)
  lda hash_reg_a
  sta hash_src_reg

hash_copy_pair:
  ; HL = コレクションプール内の書き込み位置
  ; key (4B) をコピー: R[src] → [HL]
  push h                ; 書き込み先を退避
  lda hash_src_reg
  call get_reg_addr     ; HL = R[src]
  pop d                 ; DE = 書き込み先
  call copy_slot        ; 4B コピー (HL, DE 共に +4)
  ; DE = value 書き込み位置

  ; value (4B) をコピー: R[src+1] → [DE]
  push d                ; value 書き込み先を退避
  lda hash_src_reg
  inr a
  call get_reg_addr     ; HL = R[src+1]
  pop d                 ; DE = value 書き込み先
  call copy_slot        ; 4B コピー
  ; DE = 次ペアの先頭

  ; ソースレジスタを +2
  lda hash_src_reg
  adi 2
  sta hash_src_reg

  ; HL = 次の書き込み位置 (DE から)
  xchg

  ; ペアカウンタ
  lda hash_count
  dcr a
  sta hash_count
  jnz hash_copy_pair

hash_write_result:
  ; R[hash_reg_a] = TT_HASH, val_lo = slot+1
  lda hash_reg_a
  call get_reg_addr     ; HL = R[a]
  mvi m, TT_HASH        ; +0: type
  inx h
  mvi m, 0              ; +1: reserved
  inx h
  lda hash_slot_num
  inr a                 ; slot + 1
  mov m, a              ; +2: val_lo
  inx h
  mvi m, 0              ; +3: val_hi
  jmp vm_loop

; --- do_op_hash データ ---
hash_reg_a:    db 0
hash_count:    db 0
hash_slot_num: db 0
hash_src_reg:  db 0

; ===============================================================
; gidx_hash — GETIDX の Hash パス: R[a] = R[a][R[a+1]]
;
;   入口: gidx_reg_a 設定済み、HL = R[a] スロットアドレス
;   キーが見つからなければ R[a] = nil
; ===============================================================
gidx_hash:
  ; コレクションスロットを取得
  call col_from_reg     ; HL = コレクションスロット
  inx h                 ; +1: count
  mov a, m              ; A = ペア数
  inx h                 ; HL → データ領域
  ora a
  jz ghash_not_found    ; 空 Hash

  sta ghash_loop_cnt
  shld ghash_data_ptr

  ; 検索キー R[a+1] のアドレスを取得
  lda gidx_reg_a
  inr a
  call get_reg_addr     ; HL = R[a+1]
  shld ghash_key_ptr

  ; 検索ループ
  lhld ghash_data_ptr
ghash_search:
  shld ghash_cur_ptr    ; 現在のペア先頭を保存

  ; 4 バイト比較: [HL] (hash key) vs [ghash_key_ptr] (search key)
  push h
  lhld ghash_key_ptr
  xchg                  ; DE = 検索キー
  pop h                 ; HL = hash ペアのキー

  mvi c, SLOT_BYTES
ghash_cmp:
  ldax d
  cmp m
  jnz ghash_next
  inx h
  inx d
  dcr c
  jnz ghash_cmp

  ; 一致! HL = value 位置 (キー直後)
  ; value (4B) を R[a] にコピー
  push h                ; value ソース
  lda gidx_reg_a
  call get_reg_addr     ; HL = R[a]
  xchg                  ; DE = R[a] (コピー先)
  pop h                 ; HL = value (コピー元)
  call copy_slot
  jmp vm_loop

ghash_next:
  ; 次のペアへ (現在ペア + HASH_PAIR_BYTES)
  lhld ghash_cur_ptr
  lxi d, HASH_PAIR_BYTES
  dad d
  lda ghash_loop_cnt
  dcr a
  sta ghash_loop_cnt
  jnz ghash_search

ghash_not_found:
  ; R[a] = nil
  lda gidx_reg_a
  call get_reg_addr     ; HL = R[a]
  mvi a, TT_NIL
  call set_slot_special
  jmp vm_loop

; --- gidx_hash データ ---
ghash_data_ptr: dw 0
ghash_key_ptr:  dw 0
ghash_cur_ptr:  dw 0
ghash_loop_cnt: db 0

; ===============================================================
; sidx_hash — SETIDX の Hash パス: R[a][R[a+1]] = R[a+2]
;
;   入口: sidx_reg_a 設定済み、HL = R[a] スロットアドレス
;   既存キー → 値を上書き
;   新規キー → count < MAX なら末尾に追加
; ===============================================================
sidx_hash:
  ; コレクションスロットを取得
  call col_from_reg     ; HL = コレクションスロット
  shld shash_col_ptr    ; スロット先頭を保存 (count 更新用)
  inx h                 ; +1: count
  mov a, m
  sta shash_pair_cnt    ; 元のペア数
  inx h                 ; HL → データ領域
  shld shash_data_ptr

  ; R[a+1] キーのアドレス
  lda sidx_reg_a
  inr a
  call get_reg_addr     ; HL = R[a+1]
  shld shash_key_ptr

  ; R[a+2] 値のアドレス
  lda sidx_reg_a
  adi 2
  call get_reg_addr     ; HL = R[a+2]
  shld shash_val_ptr

  ; 既存キーを検索
  lda shash_pair_cnt
  ora a
  jz shash_append       ; 空 Hash → 追加

  sta shash_loop_cnt
  lhld shash_data_ptr

shash_search:
  shld shash_cur_ptr

  push h
  lhld shash_key_ptr
  xchg                  ; DE = 検索キー
  pop h                 ; HL = hash ペアのキー

  mvi c, SLOT_BYTES
shash_cmp:
  ldax d
  cmp m
  jnz shash_snext
  inx h
  inx d
  dcr c
  jnz shash_cmp

  ; 一致! HL = value 位置
  ; R[a+2] を value にコピー
  xchg                  ; DE = hash value 位置
  lhld shash_val_ptr    ; HL = R[a+2]
  call copy_slot
  jmp vm_loop

shash_snext:
  lhld shash_cur_ptr
  lxi d, HASH_PAIR_BYTES
  dad d
  lda shash_loop_cnt
  dcr a
  sta shash_loop_cnt
  jnz shash_search

  ; 見つからなかった → 末尾に追加

shash_append:
  ; 容量チェック
  lda shash_pair_cnt
  cpi COL_MAX_HASH_PAIRS
  jnc vm_fail          ; Hash 満杯

  ; count++ を書き込み
  inr a
  push psw
  lhld shash_col_ptr
  inx h                 ; +1: count フィールド
  mov m, a
  pop psw

  ; 追加位置 = data + old_count * 8
  lda shash_pair_cnt    ; old count
  add a                 ; ×2
  add a                 ; ×4
  add a                 ; ×8
  mov e, a
  mvi d, 0
  lhld shash_data_ptr
  dad d                 ; HL = 追加位置

  ; key をコピー (R[a+1] → [HL])
  xchg                  ; DE = 追加位置
  lhld shash_key_ptr    ; HL = R[a+1]
  call copy_slot        ; key 4B、DE は value 位置に進む

  ; value をコピー (R[a+2] → [DE])
  lhld shash_val_ptr    ; HL = R[a+2]
  ; DE は既に value 位置
  call copy_slot
  jmp vm_loop

; --- sidx_hash データ ---
shash_col_ptr:  dw 0
shash_data_ptr: dw 0
shash_key_ptr:  dw 0
shash_val_ptr:  dw 0
shash_cur_ptr:  dw 0
shash_pair_cnt: db 0
shash_loop_cnt: db 0

; ===============================================================
; send_getkey_timeout — getkey(n): ノンブロッキングタイムアウト付きキー入力
;
; KEY (0x0647) を最大 n 回呼び出し、キーが押されたらキーコードを返す。
; n 回スキャンしてもキーが見つからなければ nil を返す。
; ROM がなければ即 nil。
;
; 入力: send_reg_a = a, R[a+1] = タイムアウト回数 (整数)
; 出力: R[a] = キーコード (0x00-0x17) or nil
; ===============================================================
send_getkey_timeout:
  ; R[a+1] からタイムアウト回数を読む
  lda send_reg_a
  adi 1
  call get_reg_addr     ; HL = R[a+1]
  inx h
  inx h                 ; +2: val_lo
  mov c, m
  inx h                 ; +3: val_hi
  mov b, m              ; BC = タイムアウト回数

  ; ROM チェック
  lda KEY_ADDR
  ora a
  jz getkey_timeout_nil ; ROM なし → nil

getkey_poll_loop:
  mov a, b
  ora c
  jz getkey_timeout_nil ; カウンタ = 0 → タイムアウト

  push b                ; カウンタ退避
  call KEY_ADDR         ; A = キーコード or 0xFF
  pop b                 ; カウンタ復帰
  cpi 0FFh
  jnz getkey_timeout_got ; キー押下!

  push b                ; カウンタ退避
  call lfsr_next        ; 待機中に LFSR を進める
  pop b
  dcx b                 ; カウンタ--
  jmp getkey_poll_loop

getkey_timeout_got:
  ; A = キーコード (0x00-0x17)
  mov c, a
  mvi b, 0
  lda send_reg_a
  call get_reg_addr
  call set_slot_int16
  jmp vm_loop

getkey_timeout_nil:
  lda send_reg_a
  call get_reg_addr
  mvi a, TT_NIL
  call set_slot_special
  jmp vm_loop

; ===============================================================
; send_slice — [](offset, length): 文字列スライス
;
; OP_SEND R[a], "[]", 2 で呼ばれる (argc=2 は OP_GETIDX にならない)。
;
;   入力: send_reg_a = a, send_argc = 2
;         R[a] = TT_STRING (対象文字列)
;         R[a+1] = offset (TT_INTEGER, 0-based)
;         R[a+2] = length (TT_INTEGER)
;   出力: R[a] = 新しい部分文字列 (TT_STRING)
;         offset >= 文字列長 → 空文字列
;         length は利用可能バイト数にクランプ
; ===============================================================
send_slice:
  ; R[a] が TT_STRING か確認
  lda send_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m              ; A = 型タグ
  cpi TT_STRING
  jnz vm_fail

  ; ソース文字列のコレクションスロットを取得
  lda send_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = collection slot
  inx h                 ; +1: count
  mov a, m
  sta slice_src_count
  inx h                 ; HL → data
  shld slice_src_data

  ; R[a+1] から offset を取得
  lda send_reg_a
  adi 1
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = offset (val_lo)
  sta slice_offset

  ; R[a+2] から length を取得
  lda send_reg_a
  adi 2
  call get_reg_addr
  call slot_to_value
  mov a, m              ; A = length (val_lo)
  sta slice_length

  ; offset >= src_count → 空文字列
  lda slice_offset
  mov b, a              ; B = offset
  lda slice_src_count   ; A = src_count
  cmp b
  jc slice_empty        ; src_count < offset
  jz slice_empty        ; src_count == offset

  ; available = src_count - offset
  sub b                 ; A = available
  mov b, a              ; B = available
  lda slice_length
  cmp b
  jc slice_len_ok       ; length < available → そのまま
  mov a, b              ; clamp: length = available
slice_len_ok:
  sta slice_length      ; 実際のコピー長

  ; 新しいコレクションスロットを確保
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta slice_new_slot
  mvi m, COL_TYPE_STRING ; +0: type
  inx h
  lda slice_length
  mov m, a              ; +1: count = コピー長
  inx h                 ; HL → new data area

  ; ソースデータ先頭 + offset
  push h                ; dest を退避
  lhld slice_src_data
  lda slice_offset
  mov e, a
  mvi d, 0
  dad d                 ; HL = src_data + offset
  xchg                  ; DE = src + offset
  pop h                 ; HL = dest

  ; バイトコピー
  lda slice_length
  ora a
  jz slice_done
  mov c, a
slice_copy:
  ldax d
  mov m, a
  inx h
  inx d
  dcr c
  jnz slice_copy

slice_done:
  ; R[a] = TT_STRING, val_lo = new_slot + 1
  lda send_reg_a
  call get_reg_addr
  mvi m, TT_STRING      ; +0: type
  inx h
  mvi m, 0              ; +1: reserved
  inx h
  lda slice_new_slot
  inr a                 ; slot + 1
  mov m, a              ; +2: val_lo
  inx h
  mvi m, 0              ; +3: val_hi
  jmp vm_loop

slice_empty:
  ; 空文字列を返す
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta slice_new_slot
  mvi m, COL_TYPE_STRING ; +0: type
  inx h
  mvi m, 0              ; +1: count = 0
  jmp slice_done

; --- send_slice データ ---
slice_src_count: db 0
slice_src_data:  dw 0
slice_offset:    db 0
slice_length:    db 0
slice_new_slot:  db 0

; ===============================================================
; col_gc_alloc — 到達性を辿る回収つきのスロット確保
;
; col_alloc がプール満杯 (col_sp >= MAX_COL_SLOTS) のとき呼ばれる。
;
; **ルートに印を付けるだけでは足りない。** 配列やハッシュの中が指す
; スロットには印が付かず、`a = ["ab"]` の "ab" が生きたまま配られる。
; PLC 版で同じ判断をして直した (doc/gc.md「ルートだけでは足りない」)。
;
; ルート:
;   レジスタファイル    MAX_REGS 個の値スロット
;   グローバル変数      MAX_GLOBALS 個の値スロット
;   オブジェクトの ivar MAX_OBJECTS × MAX_IVARS 個の値スロット
;
; **オブジェクト自身には印を付けない。** 別のプールに居て回収の対象では
; なく、印が要るのはその中が指す先だけ。使っていないオブジェクトスロットは
; 起動時にゼロクリアされていて型 0 なので素通りする。
;
; 伝播:
;   印が付いていてまだ走査していないスロットの中身を辿り、印が増えなく
;   なるまで繰り返す。**文字列の中身はバイト列なので辿らない。**
;
;   出力: A = スロット番号, HL = スロットアドレス
;   エラー: 全スロット生きている → vm_fail
; ===============================================================
col_gc_alloc:
  ; **前の走査で作った印がまだ使えるなら、走査せずに空きを配る。**
  ;
  ; 走査 1 回は実機で 51 ms。印を捨てると確保のたびに払うことになり、
  ; 文字列を 9 個作る描画 1 回で 460 ms になっていた。印は走査のあと
  ; 「空き表」として使い回す — 配った枠には印を立てるので二度は出ない。
  ;
  ; **走査のあとに死んだものは次の走査まで空かない。** 安全側に外すだけで、
  ; 生きているものを配ることはない。
  lda gc_have_free
  ora a
  jz col_gc_sweep
  call gc_scan_free
  cpi 0FFh
  jnz gc_found_free     ; A = 空きスロット番号
  ; 印が古くて空きが無い。捨てて走査からやり直す
  xra a
  sta gc_have_free

col_gc_sweep:
  ; 印と走査済みを消す (64 スロット = 8 バイト × 2 枚)
  xra a
  lxi h, gc_bitmap
  mvi c, 16
gc_clear_bm:
  mov m, a
  inx h
  dcr c
  jnz gc_clear_bm

  ; --- ルート: レジスタファイル ---
  ; **窓ではなく全部。** 外側のフレームが持っている値も生きている
  lxi h, REG_FILE_BASE
  mvi b, MAX_REGS
gc_root_reg:
  call gc_mark_value
  inx h
  inx h
  inx h
  inx h
  dcr b
  jnz gc_root_reg

  ; --- ルート: グローバル変数 ---
  lxi h, GLOBALS_BASE
  mvi b, MAX_GLOBALS
gc_root_global:
  call gc_mark_value
  inx h
  inx h
  inx h
  inx h
  dcr b
  jnz gc_root_global

  ; --- ルート: オブジェクトのインスタンス変数 ---
  lxi h, OBJECT_POOL_BASE + OBJECT_HEADER_SIZE
  mvi b, MAX_OBJECTS
gc_root_obj:
  push b
  push h
  mvi b, MAX_IVARS
gc_root_ivar:
  call gc_mark_value
  inx h
  inx h
  inx h
  inx h
  dcr b
  jnz gc_root_ivar
  pop h
  lxi d, OBJECT_SLOT_SIZE
  dad d                 ; 次のオブジェクトの ivar 先頭
  pop b
  dcr b
  jnz gc_root_obj

  ; --- 到達性を伝播する ---
  call gc_propagate

  ; **ここから印は空き表になる。** 次の確保はこれを見るだけで済む
  mvi a, 1
  sta gc_have_free
  xra a
  sta gc_free_next      ; しおりを先頭へ

  ; --- 印の付かなかったスロットを探す ---
  ; **走査した直後なのでここで無ければ本当に満杯。**
  call gc_scan_free
  cpi 0FFh
  jz vm_fail           ; 全スロット使用中

gc_found_free:
  ; A = 空きスロット番号
  push psw
  call gc_set_bit       ; **配ったら印を立てる。** 二度配らないため
  pop psw
  push psw              ; スロット番号を退避
  call col_slot_addr    ; HL = スロットアドレス
  pop psw               ; A = スロット番号を復帰
  ret

; ---------------------------------------------------------------
; gc_scan_free — 印の付いていないスロットを探す
;
;   出力: A = スロット番号 / 0FFh = 空き無し
;   破壊: B
;
; B をカウンタに使う (gc_check_bit は B を壊さない)。
;
; **しおりから探す。** 配る順は増える一方で、配った枠には印を立てるので、
; しおりより前はすべて印が付いている (生きているか、配ったか)。0 から
; 舐め直すと 64 枠ぶんの検査が確保のたびに乗る。
; ---------------------------------------------------------------
gc_scan_free:
  lda gc_free_next
  mov b, a
gc_sf_loop:
  mov a, b              ; A = 検査対象スロット番号
  call gc_check_bit     ; Z=1: 空き (A は破壊される)
  jz gc_sf_hit
  inr b
  mov a, b
  cpi MAX_COL_SLOTS
  jc gc_sf_loop
  mvi a, 0FFh
  ret
gc_sf_hit:
  ; しおりを次へ。**この枠はすぐ印が立つ**ので飛ばして構わない
  mov a, b
  inr a
  sta gc_free_next
  mov a, b
  ret

; ---------------------------------------------------------------
; gc_propagate — 印が増えなくなるまで中身を辿る
;
; **印は増える一方なので必ず止まる。** 最悪 MAX_COL_SLOTS 周。
; 1 周で 1 つも走査しなければ終わり。
; ---------------------------------------------------------------
gc_propagate:
  xra a
  sta gc_changed
  mvi b, 0              ; B = スロット番号
gc_prop_slot:
  mov a, b
  call gc_check_bit     ; 印が無ければ飛ばす
  jz gc_prop_next
  mov a, b
  call gc_check_scanned ; 走査済みなら飛ばす
  jnz gc_prop_next
  mov a, b
  call gc_set_scanned
  mvi a, 1
  sta gc_changed
  mov a, b
  push b
  call gc_scan_slot
  pop b
gc_prop_next:
  inr b
  mov a, b
  cpi MAX_COL_SLOTS
  jc gc_prop_slot
  lda gc_changed
  ora a
  jnz gc_propagate      ; 印が増えたのでもう 1 周
  ret

; ---------------------------------------------------------------
; gc_scan_slot — A = スロット番号。中身が指す先に印を付ける
;
; **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットとして
; 読むと、前に入っていた文字列のバイトが型タグに見える。
;
; **要素数は容量で頭を打たせる。** 同じ理由で、見出しのバイトがでたらめ
; でも隣のスロットまで歩かないようにする。
; ---------------------------------------------------------------
gc_scan_slot:
  push b
  call col_slot_addr    ; HL = スロットアドレス (A は残る)
  mov a, m              ; +0: 型
  inx h
  mov b, m              ; +1: 要素数 / 組の数
  inx h                 ; HL = データ先頭
  cpi COL_TYPE_ARRAY
  jz gc_scan_array
  cpi COL_TYPE_HASH
  jz gc_scan_hash
  jmp gc_scan_done      ; 文字列と空きは辿らない
gc_scan_array:
  mov a, b
  ora a
  jz gc_scan_done       ; 要素数 0
  ; **即値に式を書かない。** アセンブラを持たない環境で直すことがあるので、
  ; `+ 1` を足して 1 回で済ませるより、確実に通る形を選ぶ
  cpi COL_MAX_ARRAY_ELEMS
  jc gc_scan_aloop      ; 容量未満
  jz gc_scan_aloop      ; ちょうど容量
  mvi b, COL_MAX_ARRAY_ELEMS
gc_scan_aloop:
  call gc_mark_value
  inx h
  inx h
  inx h
  inx h
  dcr b
  jnz gc_scan_aloop
  jmp gc_scan_done
gc_scan_hash:
  mov a, b
  ora a
  jz gc_scan_done       ; 組の数 0
  cpi COL_MAX_HASH_PAIRS
  jc gc_scan_hloop
  jz gc_scan_hloop
  mvi b, COL_MAX_HASH_PAIRS
gc_scan_hloop:
  call gc_mark_value    ; 鍵
  inx h
  inx h
  inx h
  inx h
  call gc_mark_value    ; 値
  inx h
  inx h
  inx h
  inx h
  dcr b
  jnz gc_scan_hloop
gc_scan_done:
  pop b
  ret

; ---------------------------------------------------------------
; gc_mark_value — HL = 値スロットのアドレス。指す先に印を付ける
;
; 印を持つのは文字列・配列・ハッシュだけ。**オブジェクトは別のプール**
; なのでここでは何もしない (中身はルート走査で辿る)。
;
; **値は スロット + 1。** 0 は「無し」。
; **上位バイトが 0 でないものと範囲外は捨てる。** 古いバイト列が型タグに
; 見えたときに、8 バイトしかないビットマップの外を壊さないため。
;
;   HL / DE / BC は保たれる
; ---------------------------------------------------------------
gc_mark_value:
  push h
  push d
  push b
  mov a, m              ; A = 型タグ
  cpi TT_STRING
  jz gc_mv_ref
  cpi TT_ARRAY
  jz gc_mv_ref
  cpi TT_HASH
  jz gc_mv_ref
  jmp gc_mv_done
gc_mv_ref:
  inx h
  inx h
  inx h
  mov a, m              ; +3: val_hi
  ora a
  jnz gc_mv_done        ; 上位が 0 でなければスロット番号ではない
  dcx h
  mov a, m              ; +2: val_lo = スロット + 1
  ora a
  jz gc_mv_done         ; 0 = 無し
  dcr a                 ; A = スロット番号
  cpi MAX_COL_SLOTS
  jnc gc_mv_done        ; 範囲外
  call gc_set_bit
gc_mv_done:
  pop b
  pop d
  pop h
  ret

; ---------------------------------------------------------------
; ビットの出し入れ
;
; **ビットマップが 2 枚あるので、場所の計算は 1 つにまとめる** — 片方だけ
; 直して食い違うのを避けるため。
;
; gc_bit_ptr: A = スロット番号, DE = ビットマップの先頭
;   → HL = バイトのアドレス, A = マスク (C と DE は壊れる)
; ---------------------------------------------------------------
gc_bit_ptr:
  mov c, a              ; C = スロット番号
  rrc
  rrc
  rrc
  ani 07h               ; A = バイト位置 (slot >> 3)
  mov l, a
  mvi h, 0
  dad d                 ; HL = 先頭 + バイト位置
  push h
  mov a, c
  ani 07h               ; ビット位置 (slot & 7)
  mov l, a
  mvi h, 0
  lxi d, gc_bit_table
  dad d
  mov a, m              ; A = ビットマスク
  pop h                 ; HL = ビットマップのバイト
  ret

; --- gc_set_bit: A = slot (0-63) の印を立てる ---
gc_set_bit:
  push h
  push d
  lxi d, gc_bitmap
  call gc_bit_ptr
  ora m
  mov m, a
  pop d
  pop h
  ret

; --- gc_check_bit: A = slot の印を検査 ---
; 戻り: Z=1 → 空き (ビット = 0), Z=0 → 使用中
gc_check_bit:
  push h
  push d
  lxi d, gc_bitmap
  call gc_bit_ptr
  ana m                 ; Z=1 ならビットクリア
  pop d                 ; POP はフラグを変えない
  pop h
  ret

; --- gc_set_scanned: A = slot を走査済みにする ---
gc_set_scanned:
  push h
  push d
  lxi d, gc_scanned
  call gc_bit_ptr
  ora m
  mov m, a
  pop d
  pop h
  ret

; --- gc_check_scanned: A = slot が走査済みか ---
; 戻り: Z=1 → まだ、Z=0 → 済み
gc_check_scanned:
  push h
  push d
  lxi d, gc_scanned
  call gc_bit_ptr
  ana m
  pop d
  pop h
  ret

; --- GC データ ---
;
; **gc_bitmap と gc_scanned は隣に置くこと。** 消すときに 16 バイトまとめて
; 回している
gc_bitmap:  db 0, 0, 0, 0, 0, 0, 0, 0
gc_scanned: db 0, 0, 0, 0, 0, 0, 0, 0
gc_changed: db 0

; **印を空き表として使い回せるか。** 0 = 走査が要る
gc_have_free: db 0

; **空きを探し始める位置。** これより前はすべて印が付いている
gc_free_next: db 0
gc_bit_table: db 01h, 02h, 04h, 08h, 10h, 20h, 40h, 80h

; ===============================================================
; sendb_each — Array#each / Hash#each
;
;   R[a] = TT_ARRAY か TT_HASH (レシーバ)
;   R[a+argc+1] = TT_PROC (ブロック)
;   配列: 各反復で R[1] = array[index]
;   ハッシュ: 各反復で R[1] = 鍵, R[2] = 値
;
; FRAME_KIND_EACH / FRAME_KIND_HASH_EACH を使い、フレーム +11
; (reserved) にコレクションスロット番号を格納する。
;
; **見出しの +1 (count) はどちらも「反復の回数」です。** 配列なら要素数、
; ハッシュならペア数なので、上限の出し方を分ける必要がありません。
; 違うのはブロックへ渡す値だけで、そこは each_block_args に出しています。
; ===============================================================
sendb_each:
  ; each はレシーバの型でフレーム種別を決める
  ; (述語は sendb_pred が種別を書いてから合流する)
  lda sendb_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m
  cpi TT_ARRAY
  jz each_kind_array
  cpi TT_HASH
  jnz vm_fail
  mvi a, FRAME_KIND_HASH_EACH
  jmp each_kind_set
each_kind_array:
  mvi a, FRAME_KIND_EACH
each_kind_set:
  sta each_arg_kind

sendb_each_join:
  ; レシーバが配列かハッシュであること (述語もここを通る)
  lda sendb_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m
  cpi TT_ARRAY
  jz each_recv_ok
  cpi TT_HASH
  jnz vm_fail
each_recv_ok:

  ; コレクションスロット番号を取得 (配列・ハッシュとも val_lo = slot + 1)
  lda sendb_reg_a
  call get_reg_addr
  call slot_to_value    ; HL = 値先頭
  mov a, m              ; val_lo = slot + 1
  dcr a                 ; slot number (0-based)
  sta each_col_slot

  ; 反復の回数を読む (配列なら要素数、ハッシュならペア数)
  lda each_col_slot
  call col_slot_addr    ; HL = スロットアドレス
  inx h                 ; +1: count
  mov a, m
  sta each_count
  ora a
  jz each_empty         ; 空 → ブロック実行しない

  ; ブロック (TT_PROC) の情報を読む
  ;
  ; **ブロック無しの述語は R[a+1] を見ない。** 恒等ブロックは最後の
  ; irep で、中身は `OP_RETURN R[1]` の 2 バイトだけ。ホストが
  ; ブロック無しの述語を見つけたときだけ足す
  lda pred_identity
  ora a
  jnz each_block_identity
  lda sendb_argc
  inr a                 ; argc + 1
  mov b, a
  lda sendb_reg_a
  add b                 ; A = a + argc + 1
  call get_reg_addr     ; HL = R[a+argc+1]
  call slot_to_value
  mov a, m              ; irep 番号
  sta sendb_block_irep
  inx h
  mov a, m              ; outer
  sta sendb_block_outer
  jmp each_block_ready
each_block_identity:
  lda IDENTITY_IREP_STORE
  sta sendb_block_irep
  mvi a, FRAME_NONE
  sta sendb_block_outer
each_block_ready:

  ; push_frame(a, kind, outer)
  lda each_arg_kind
  mov b, a
  lda sendb_block_outer
  mov c, a
  lda sendb_reg_a
  call push_frame

  ; フレームに limit = count - 1 を設定
  call cur_frame_addr
  lxi d, FRAME_OFF_LIMIT
  dad d
  lda each_count
  dcr a                 ; limit = count - 1
  mov m, a              ; limit_lo
  inx h
  mvi m, 0              ; limit_hi

  ; フレーム +11 (reserved) にコレクションスロット番号を格納
  call cur_frame_addr
  lxi d, 11
  dad d
  lda each_col_slot
  mov m, a

  ; 最初の回のブロック引数 (index = 0)
  xra a
  sta each_index
  call each_block_args

  ; 子 irep に切り替え
  lda sendb_block_irep
  call switch_irep

  ; PC = 0
  lxi h, 0
  shld VM_STATE_BASE + OFF_PC
  jmp vm_loop

; ===============================================================
; each_empty — 1 回も回らないとき
;
; each はレシーバがそのまま呼び出しの値になるので何もしません。
; **述語だけは答えを書きます** (空の any? は false、all? と none? は true)。
; フレームを積まないので、ここで決まります。
; ===============================================================
each_empty:
  lda each_arg_kind
  cpi FRAME_KIND_ANY
  jc vm_loop            ; 述語ではない → レシーバのまま
  cpi FRAME_KIND_ANY
  jz each_empty_false   ; any? → false
  mvi a, TT_TRUE        ; all? / none? → true
  jmp each_empty_write
each_empty_false:
  mvi a, TT_FALSE
each_empty_write:
  sta each_empty_tag
  lda sendb_reg_a
  call get_reg_addr     ; HL = R[a] (呼び出しの値になる場所)
  lda each_empty_tag
  call set_slot_special
  jmp vm_loop

each_empty_tag: db 0

; **ブロックが恒等か。** 0 = R[a+argc+1] のブロックを使う
pred_identity: db 0

; ===============================================================
; send_pred — ブロック無しの述語 (a.any? / a.all? / a.none?)
;
; **`a.all?` は `a.all? { |x| x }` と同じです。** 中身をそのまま返す
; ブロックを渡したものとして each の道に入れるので、反復もフレームも
; 判定もブロック付きと同じ経路を通ります。規則を書き直しません。
;
; **ハッシュは反復しません。** Ruby はブロック無しのとき [鍵, 値] の
; 配列を見るので、中身がどうであれ常に真です。鍵をそのまま渡すと
; `{nil => 1}.all?` が偽になってしまいます。組の数だけで決まります。
; ===============================================================
send_pred_any:
  mvi a, FRAME_KIND_ANY
  jmp send_pred
send_pred_all:
  mvi a, FRAME_KIND_ALL
  jmp send_pred
send_pred_none:
  mvi a, FRAME_KIND_NONE
send_pred:
  sta each_arg_kind
  ; ブロック付きと同じ変数へ移して合流する
  lda send_reg_a
  sta sendb_reg_a
  xra a
  sta sendb_argc        ; 述語は引数を取らない
  ; レシーバがハッシュなら反復しない
  lda send_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m
  cpi TT_HASH
  jz send_pred_hash
  mvi a, 1
  sta pred_identity
  jmp sendb_each_join

; --- ハッシュ。組の数だけで決まる ---
send_pred_hash:
  lda send_reg_a
  call get_reg_addr
  call col_from_reg     ; HL = 鍵の配列のスロット
  inx h                 ; +1: 組の数
  mov a, m
  ora a                 ; Z=1 なら空
  mvi b, TT_TRUE
  jz send_pred_hash_empty
  ; 空でない: any? と all? は true、none? は false
  lda each_arg_kind
  cpi FRAME_KIND_NONE
  jnz send_pred_hash_write
  mvi b, TT_FALSE
  jmp send_pred_hash_write
send_pred_hash_empty:
  ; 空: any? は false、all? と none? は true
  lda each_arg_kind
  cpi FRAME_KIND_ANY
  jnz send_pred_hash_write
  mvi b, TT_FALSE
send_pred_hash_write:
  lda send_reg_a
  call get_reg_addr
  mov a, b
  call set_slot_special
  jmp vm_loop

; ===============================================================
; sendb_array_new — Array.new(n) { |i| }
;
; **先に配列を確保して R[a] に置く。** 窓をずらすと R[0] が配列になり、
; 反復の間ずっとそこから書き込む先を引ける。尽きればそれが呼び出しの値。
;
; 渡すのは添字 (times と同じ)。ブロックの値は advance_iteration が
; その回の要素へ書く。**先に nil で埋めておく** — break で途中で抜けても、
; 書いていない要素を値スロットとして読まれないようにするため。
; ===============================================================
sendb_array_new:
  ; レシーバが Array であること
  lda sendb_reg_a
  call get_reg_addr     ; HL = R[a]
  mov a, m
  cpi TT_BUILTIN_CLASS
  jnz vm_fail
  lda sendb_reg_a
  call get_reg_addr
  call slot_to_value
  mov a, m
  cpi BUILTIN_CLASS_ARRAY
  jnz vm_fail

  ; 大きさは R[a+1]
  lda sendb_reg_a
  inr a
  call get_reg_addr     ; HL = R[a+1]
  mov a, m
  cpi TT_INTEGER
  jnz vm_fail
  inx h
  inx h                 ; +2: val_lo
  mov c, m
  inx h
  mov a, m              ; 上位バイト
  ora a
  jnz vm_fail          ; 負か大きすぎる
  mov a, c
  cpi COL_MAX_ARRAY_ELEMS + 1
  jnc vm_fail
  sta san_count

  ; スロットを確保して nil で埋める
  call col_alloc        ; A = slot_number, HL = スロットアドレス
  sta san_slot
  mvi m, COL_TYPE_ARRAY
  inx h
  lda san_count
  mov m, a              ; +1: count
  inx h                 ; HL → データ領域
  shld san_data
  lda san_count
  ora a
  jz san_no_fill
  sta san_left
san_fill_loop:
  lhld san_data
  mvi m, TT_NIL
  inx h
  mvi m, 0
  inx h
  mvi m, 0
  inx h
  mvi m, 0
  inx h
  shld san_data
  lxi h, san_left
  dcr m
  jnz san_fill_loop

san_no_fill:
  ; R[a] = TT_ARRAY, val_lo = slot+1。**これが呼び出しの値になる**
  lda sendb_reg_a
  call get_reg_addr
  mvi m, TT_ARRAY
  inx h
  mvi m, 0
  inx h
  lda san_slot
  inr a
  mov m, a
  inx h
  mvi m, 0

  ; 0 個ならブロックを 1 回も回さない (配列はもう R[a] にある)
  lda san_count
  ora a
  jz vm_loop

  ; ブロック (TT_PROC) の情報を読む
  lda sendb_argc
  inr a
  mov b, a
  lda sendb_reg_a
  add b                 ; A = a + argc + 1
  call get_reg_addr
  call slot_to_value
  mov a, m
  sta sendb_block_irep
  inx h
  mov a, m
  sta sendb_block_outer

  ; push_frame(a, FRAME_KIND_ARRAY_FILL, outer)
  mvi b, FRAME_KIND_ARRAY_FILL
  lda sendb_block_outer
  mov c, a
  lda sendb_reg_a
  call push_frame

  ; limit = count - 1
  call cur_frame_addr
  lxi d, FRAME_OFF_LIMIT
  dad d
  lda san_count
  dcr a
  mov m, a
  inx h
  mvi m, 0

  ; フレーム +11 にコレクションスロット番号 (書き込む先を引くのに使う)
  call cur_frame_addr
  lxi d, 11
  dad d
  lda san_slot
  mov m, a

  ; ブロック引数 R[1] = 0 (添字)
  mvi a, 1
  call get_reg_addr
  mvi b, 0
  mvi c, 0
  call set_slot_int16

  ; 子 irep に切り替えて PC = 0
  lda sendb_block_irep
  call switch_irep
  lxi h, 0
  shld VM_STATE_BASE + OFF_PC
  jmp vm_loop

san_count: db 0
san_slot:  db 0
san_left:  db 0
san_data:  dw 0

; ===============================================================
; each_block_args — 反復のその回の値をブロックの引数へ
;
;   入力: each_arg_kind / each_col_slot / each_index
;   出力: R[1] (配列なら要素、ハッシュなら鍵)
;         ハッシュなら R[2] にも値
;
; **sendb_each と advance_iteration の両方から呼びます。** 最初の回と
; 2 回目以降で同じ場所の出し方をするためで、以前は 1 回目を sendb_each に
; 書き写していました。
;
; **添字は下位バイトだけ見ます。** 配列は 8 要素、ハッシュは 4 ペアまでで、
; 上限がバイトに収まります。
; ===============================================================
each_block_args:
  lda each_col_slot
  call col_slot_addr    ; HL = スロットアドレス
  mov a, m              ; +0: 見出しの種別 (COL_TYPE_*)
  sta eba_col_type
  inx h                 ; skip type
  inx h                 ; skip count → data
  ; **渡す値はスロットの見出しで決めます。** フレームの種別ではありません —
  ; 述語は配列とハッシュで種別を分けていないためです
  lda eba_col_type
  cpi COL_TYPE_HASH
  jz eba_hash

  ; --- 配列: data + index * 4 ---
  lda each_index
  add a                 ; ×2
  add a                 ; ×4
  mov e, a
  mvi d, 0
  dad d                 ; HL = &data[index*4]
  push h
  mvi a, 1
  call get_reg_addr     ; HL = R[1]
  xchg                  ; DE = R[1] (コピー先)
  pop h                 ; HL = コピー元
  call copy_slot        ; R[1] = array[index]
  ret

  ; --- ハッシュ: data + index * 8 が鍵、その +4 が値 ---
eba_hash:
  lda each_index
  add a                 ; ×2
  add a                 ; ×4
  add a                 ; ×8
  mov e, a
  mvi d, 0
  dad d                 ; HL = &pair
  shld eba_pair         ; copy_slot が HL を進めるので退避
  push h
  mvi a, 1
  call get_reg_addr     ; HL = R[1]
  xchg                  ; DE = R[1]
  pop h                 ; HL = &鍵
  call copy_slot        ; R[1] = 鍵
  lhld eba_pair
  lxi d, 4
  dad d                 ; HL = &値
  push h
  mvi a, 2
  call get_reg_addr     ; HL = R[2]
  xchg                  ; DE = R[2]
  pop h                 ; HL = &値
  call copy_slot        ; R[2] = 値
  ret

; --- sendb_each データ ---
each_col_slot: db 0
each_count:    db 0
each_arg_kind: db 0
each_index:    db 0
eba_pair:      dw 0
eba_col_type:  db 0
