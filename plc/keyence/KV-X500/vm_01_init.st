// =======================================
// faRuby VM - Reset Handler
// =======================================
// 【自動生成】このファイルを直接編集しないでください。
//   生成: tools/kvs_generator.rb  (rake vm_core)
//
// 毎スキャン実行。RESET_REQ = 1 のインスタンスについて
// VM 状態とレジスタファイルを初期化します。
//
// **電源投入後の最初のスキャンでも初期化します。** 詳しくは
// emit_restart_on_power_up を見てください。

// インデックスレジスタの退避
// Z はラダーと共有する資源のため、faRuby の実行前後で
// 内容が変わらないようにする (1スキャンにつき1回)
EM20021 := Z1;
EM20022 := Z2;
EM20023 := Z3;
EM20024 := Z4;
EM20025 := Z5;
EM20026 := Z6;
EM20027 := Z7;
EM20028 := Z8;
EM20029 := Z9;

// インスタンスごとの実行 (ブロック先頭を Z9 に載せる)
// instances = 1
FOR Z9 := 20000 TO 20000 BY 4000 DO

  // === 電源投入後の最初のスキャン ===
  // **実行中のまま切れていたら先頭から走らせ直す。** 継続はしない
  IF CR2008 THEN
    IF EM1:Z9 = 1 THEN
      EM0:Z9 := 0;   // PC = 0
      EM1:Z9 := 0;   // STATUS = stopped
      EM2:Z9 := 0;   // ERROR = none
      EM3.L:Z9 := 0;   // STEP_COUNT = 0

      // 実行中の irep をトップレベル (0番) に戻す
      EM31:Z9 := 0;   // 呼び出しの深さ
      EM39:Z9 := 0;   // 配列プールの空き先頭
      EM32:Z9 := 72;   // レジスタ窓の先頭
      EM30:Z9 := 0;
      // IREP テーブルから実行中の irep の情報を写す
      Z1 := EM38:Z9;
      EM33:Z9 := ZF98304:Z1;
      EM10:Z9 := ZF98305:Z1;
      EM34:Z9 := ZF98306:Z1;
      EM35:Z9 := ZF98307:Z1;
      EM11:Z9 := ZF98308:Z1;

      // レジスタファイルクリア (ブロック先頭 +72 から 80スロット × 4ワード)
      // スロット先頭の型タグも 0 (TT_EMPTY) になる
      FOR Z1 := 72 + Z9 TO 391 + Z9 DO
        EM0:Z1 := 0;
      END_FOR;

      // R[0] はトップレベルの self (main)。**mruby は OP_LOADSELF を書かない**
      Z1 := EM32:Z9 + Z9;
      EM1.L:Z1 := 0;
      EM0:Z1 := 10;

      // 汎用グローバル変数クリア (300スロット × 4ワード)
      FOR Z1 := 616 + Z9 TO 1815 + Z9 DO
        EM0:Z1 := 0;
      END_FOR;

      EM1:Z9 := 1;   // STATUS = running (先頭から)
    END_IF;
    // 電源が切れる前のリセット要求は意味を失っている。
    // **残すと走らせ直した直後に止めてしまう**
    EM13:Z9 := 0;
  END_IF;

  IF EM13:Z9 = 1 THEN

    EM0:Z9 := 0;   // PC = 0
    EM1:Z9 := 0;   // STATUS = stopped
    EM2:Z9 := 0;   // ERROR = none
    EM3.L:Z9 := 0;   // STEP_COUNT = 0

    // 実行中の irep をトップレベル (0番) に戻す
    EM31:Z9 := 0;   // 呼び出しの深さ
    EM39:Z9 := 0;   // 配列プールの空き先頭
    EM32:Z9 := 72;   // レジスタ窓の先頭
    EM30:Z9 := 0;
    // IREP テーブルから実行中の irep の情報を写す
    Z1 := EM38:Z9;
    EM33:Z9 := ZF98304:Z1;
    EM10:Z9 := ZF98305:Z1;
    EM34:Z9 := ZF98306:Z1;
    EM35:Z9 := ZF98307:Z1;
    EM11:Z9 := ZF98308:Z1;

    // レジスタファイルクリア (ブロック先頭 +72 から 80スロット × 4ワード)
    // スロット先頭の型タグも 0 (TT_EMPTY) になる
    FOR Z1 := 72 + Z9 TO 391 + Z9 DO
      EM0:Z1 := 0;
    END_FOR;

    // R[0] はトップレベルの self (main)。**mruby は OP_LOADSELF を書かない**
    Z1 := EM32:Z9 + Z9;
    EM1.L:Z1 := 0;
    EM0:Z1 := 10;

    // 汎用グローバル変数クリア (300スロット × 4ワード)
    FOR Z1 := 616 + Z9 TO 1815 + Z9 DO
      EM0:Z1 := 0;
    END_FOR;

    EM13:Z9 := 0;   // リセット要求クリア

  END_IF;

END_FOR;

// インデックスレジスタの復元
Z1 := EM20021;
Z2 := EM20022;
Z3 := EM20023;
Z4 := EM20024;
Z5 := EM20025;
Z6 := EM20026;
Z7 := EM20027;
Z8 := EM20028;
Z9 := EM20029;
