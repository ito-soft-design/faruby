' =======================================
' faRuby VM - オペコード 0x12 - 0x1C
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   定義: tools/opcode_table.rb
'   生成: tools/kvs_generator.rb  (rake vm_core)
'   編集した場合 test_kvs_generator.rb が失敗します。
'
' ラダーでの置き場所: 内側 FOR の中 (3 番目の群)
' 並び順と役割は vm_02_prologue.kvs の先頭にあります。

' 担当外の番号はここで素通りする。**判定はループの外に置く。**
' 見るのは上限だけ。18 未満は手前の群が実行して
' 65535 で潰しているので、ここには届かない
IF EM54:Z9 <= 28 THEN

  ' 後ろの群がもう一度実行しないように潰す。**本体より先に置く。**
  ' 本体は途中で BREAK することがあり、後ろに置くと通らない
  EM54:Z9 = 65535

  ' BREAK の相手 (1 回だけ回る)。抜けるとこのスクリプトが終わる
  FOR EM20:Z9 = 1 TO 1

    IF EM6:Z9 = 18 THEN
      ' OP_LOADSELF (B): R[a] = self (main)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1.L:Z1 = 0
      EM0:Z1 = 10

    ELSE IF EM6:Z9 = 19 THEN
      ' OP_LOADT (B): R[a] = true
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1.L:Z1 = 1
      EM0:Z1 = 3

    ELSE IF EM6:Z9 = 20 THEN
      ' OP_LOADF (B): R[a] = false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1.L:Z1 = 0
      EM0:Z1 = 2

    ELSE IF EM6:Z9 = 21 THEN
      ' OP_GETGV (BB): R[a] = global[symbols[b]]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' シンボル表参照 (4ワード/エントリ)
      Z3 = EM8:Z9 * 4 + EM35:Z9
      Z4 = Z3 + 1
      Z5 = ZF98304:Z3
      Z6 = ZF98304:Z4
      Z7 = Z3 + 2
      Z8 = ZF98304:Z7
      Z7 = Z3 + 3
      Z1 = ZF98304:Z7   ' シンボル種別
      ' レジスタアドレス
      Z2 = EM7:Z9 * 4 + EM32:Z9 + Z9
      ' 種別で 4 つに分ける。いちばん多い普通のデバイスがここで決まる
      IF Z1 = 0 THEN
        ' デバイスタイプ別読み取り
        ' ワードデバイス (EM, DM, ZF): Z8 (access_type) で幅を選ぶ
        '   2=.L(32bit符号付き)
        '   1=.U(16bit符号なし)
        '   3=.D(32bit符号なし)
        '   4=.F(実数)
        '   それ以外=.S(16bit符号付き/既定)
        ' ビットデバイス (R, MR, B, LR, T, C): ON→true, OFF→false
        '   整数の 1/0 ではなく真偽値。0 は Ruby では真なので、
        '   整数にすると if $MR10 が常に成立してしまう
        IF Z5 = 0 THEN
          IF Z8 = 2 THEN
            EM1.L:Z2 = EM0.L:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 1 THEN
            EM1.L:Z2 = EM0.U:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 3 THEN
            EM1.L:Z2 = EM0.D:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 4 THEN
            EM1.F:Z2 = EM0.F:Z6
            EM0:Z2 = 5
          ELSE
            EM1.L:Z2 = EM0.S:Z6
            EM0:Z2 = 4
          END IF
        ELSE IF Z5 = 1 THEN
          IF Z8 = 2 THEN
            EM1.L:Z2 = DM0.L:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 1 THEN
            EM1.L:Z2 = DM0.U:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 3 THEN
            EM1.L:Z2 = DM0.D:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 4 THEN
            EM1.F:Z2 = DM0.F:Z6
            EM0:Z2 = 5
          ELSE
            EM1.L:Z2 = DM0.S:Z6
            EM0:Z2 = 4
          END IF
        ELSE IF Z5 = 2 THEN
          IF Z8 = 2 THEN
            EM1.L:Z2 = ZF0.L:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 1 THEN
            EM1.L:Z2 = ZF0.U:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 3 THEN
            EM1.L:Z2 = ZF0.D:Z6
            EM0:Z2 = 4
          ELSE IF Z8 = 4 THEN
            EM1.F:Z2 = ZF0.F:Z6
            EM0:Z2 = 5
          ELSE
            EM1.L:Z2 = ZF0.S:Z6
            EM0:Z2 = 4
          END IF
        ELSE IF Z5 = 3 THEN
          IF Z8 = 5 THEN
            IF R0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = R0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = R0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = R0.D:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 4 THEN
              EM1.F:Z2 = R0.F:Z6
              EM0:Z2 = 5
            ELSE
              EM1.L:Z2 = R0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE IF Z5 = 4 THEN
          IF Z8 = 5 THEN
            IF MR0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = MR0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = MR0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = MR0.D:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 4 THEN
              EM1.F:Z2 = MR0.F:Z6
              EM0:Z2 = 5
            ELSE
              EM1.L:Z2 = MR0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE IF Z5 = 5 THEN
          IF Z8 = 5 THEN
            IF B0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = B0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = B0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = B0.D:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 4 THEN
              EM1.F:Z2 = B0.F:Z6
              EM0:Z2 = 5
            ELSE
              EM1.L:Z2 = B0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE IF Z5 = 6 THEN
          IF Z8 = 5 THEN
            IF LR0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = LR0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = LR0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = LR0.D:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 4 THEN
              EM1.F:Z2 = LR0.F:Z6
              EM0:Z2 = 5
            ELSE
              EM1.L:Z2 = LR0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE IF Z5 = 8 THEN
          IF Z8 = 5 THEN
            IF T0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = T0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = T0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = T0.D:Z6
              EM0:Z2 = 4
            ELSE
              EM1.L:Z2 = T0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE IF Z5 = 9 THEN
          IF Z8 = 5 THEN
            IF C0:Z6 THEN
              EM1.L:Z2 = 1
              EM0:Z2 = 3
            ELSE
              EM1.L:Z2 = 0
              EM0:Z2 = 2
            END IF
          ELSE
            IF Z8 = 2 THEN
              EM1.L:Z2 = C0.L:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 1 THEN
              EM1.L:Z2 = C0.U:Z6
              EM0:Z2 = 4
            ELSE IF Z8 = 3 THEN
              EM1.L:Z2 = C0.D:Z6
              EM0:Z2 = 4
            ELSE
              EM1.L:Z2 = C0.S:Z6
              EM0:Z2 = 4
            END IF
          END IF
        ELSE
          EM1:Z9 = 3
          EM2:Z9 = 21
          BREAK
        END IF
      ELSE IF Z1 = 5 THEN
        ' 汎用グローバルは値スロット。型タグごと写す
        Z3 = Z6
        EM1.L:Z2 = EM1.L:Z3
        EM0:Z2 = EM0:Z3
      ELSE IF Z1 = 7 THEN
        ' インスタンス変数はレシーバの中。self のスロットの Z5 番目
        Z3 = 0 + EM32:Z9 + Z9
        Z3 = (EM1:Z3 - 1) * 52 + 2008 + Z9 + 4
        Z3 = Z3 + Z5 * 4
        EM1.L:Z2 = EM1.L:Z3
        EM0:Z2 = EM0:Z3
      ELSE IF Z1 = 1 THEN
        ' デバイス族。読み書きせず参照値を作る ($DM[i] の $DM の部分)
        EM1:Z2 = Z6   ' ベースアドレス
        EM2:Z2 = Z5 + Z8 * 16   ' 種別 + 幅
        EM0:Z2 = 11
      ELSE
        ' 文字列を読めるのは EM / DM / ZF だけ
        ' **この検査は FOR の外に置く。** 中の BREAK は FOR を抜けるだけで
        ' 命令ループから出られず、エラーを書いてもそのまま走り続ける
        IF Z5 > 2 THEN
          EM1:Z9 = 3
          EM2:Z9 = 21
          BREAK
        END IF
        EM44:Z9 = Z8 / 16   ' 桁数 = バイト数
        IF EM44:Z9 = 0 THEN
          ' 桁の無い T は読めない。長さが決まらない
          EM1:Z9 = 3
          EM2:Z9 = 21
          BREAK
        END IF
        IF EM44:Z9 > 96 THEN
          ' 1 スロットに収まらない桁数
          EM1:Z9 = 3
          EM2:Z9 = 10
          BREAK
        END IF
        ' プールの空きスロットを決める
        IF EM39:Z9 >= 32 THEN
          ' 順に渡すぶんは尽きた。回収して空きを探す
          ' --- 回収 (使い切ったときだけ走る) ---
          ' アドレスを載せる Z を 2 本借りる。確保の場所ごとに空きが違う
          EM3677:Z9 = Z6
          EM3678:Z9 = Z7
          ' 印と走査済みを消す
          FOR EM3672:Z9 = 0 TO 31
            Z6 = EM3672:Z9 * 52 + 2008 + Z9
            EM1:Z6 = 0
            EM2:Z6 = 0
          NEXT
          ' ルート。レジスタ全 80 個と汎用グローバル 300 個
          ' **窓ではなく物理的な全レジスタ。** 外側のフレームの値も生きている
          FOR EM3672:Z9 = 0 TO 379
            IF EM3672:Z9 < 80 THEN
              Z7 = EM3672:Z9 * 4 + 72 + Z9
            ELSE
              Z7 = (EM3672:Z9 - 80) * 4 + 808 + Z9
            END IF
            EM3674:Z9 = EM0:Z7
            IF (EM3674:Z9 >= 7) AND (EM3674:Z9 <= 10) THEN
              IF EM3674:Z9 = 9 THEN
                ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
                Z6 = (EM2:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
              ELSE IF EM3674:Z9 = 10 THEN
                ' **値は スロット + 1。** 0 は main でスロットを持たない
                IF EM1:Z7 > 0 THEN
                  Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM1:Z6 = 10
                    EM3676:Z9 = 1
                  END IF
                END IF
              ELSE
                ' 文字列と配列。値がそのままスロット番号
                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = EM3674:Z9
                  EM3676:Z9 = 1
                END IF
              END IF
            END IF
          NEXT
          ' 確保してレジスタへ書くまでのスロット。**まだどこからも届かない**
          ' 1 つの命令で 2 つ取るところ (ハッシュ) で要る。0 なら無し
          IF EM3675:Z9 > 0 THEN
            Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
            IF EM1:Z6 = 0 THEN
              EM1:Z6 = 8
              EM3676:Z9 = 1
            END IF
          END IF
          ' 到達性を伝播する。印の付いたスロットの中身も辿る
          ' **印が増えなくなったら空回りします。** 最悪 32 周
          ' **BREAK は使いません。** 命令ループの BREAK と違って内側の FOR を
          ' 抜けるだけですが、エラーの BREAK と見分けが付かなくなります
          ' ルート走査で印が付いているので 1 周は回す
          EM3676:Z9 = 1
          FOR EM3679:Z9 = 0 TO 31
            IF EM3676:Z9 <> 0 THEN
              EM3676:Z9 = 0
              FOR EM3672:Z9 = 0 TO 31
                Z6 = EM3672:Z9 * 52 + 2008 + Z9
                ' 見出しのアドレスを覚える。印を付けるときに Z6 が壊れる
                EM3680:Z9 = Z6
                EM3674:Z9 = EM1:Z6
                IF EM3674:Z9 <> 0 THEN
                  IF EM2:Z6 = 0 THEN
                    EM2:Z6 = 1
                    ' 文字列の中身はバイト列。辿らない
                    IF EM3674:Z9 <> 7 THEN
                      IF EM3674:Z9 = 10 THEN
                        ' インスタンス変数は容量いっぱい使う
                        EM3682:Z9 = 12
                      ELSE
                        ' 配列は要素数まで
                        EM3682:Z9 = EM0:Z6
                      END IF
                      ' **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットと
                      ' して読むと、前に入っていた文字列のバイト列が型タグに見え、
                      ' プールの外へ印を書きに行くことがある
                      ' 符号なしなので 0 - 1 が 65535 になるのも同じ理由で避ける
                      IF EM3682:Z9 > 0 THEN
                        EM3682:Z9 = EM3682:Z9 - 1
                        ' 要素は値スロットの並び。ルートと同じ手で印を付ける
                        FOR EM3681:Z9 = 0 TO EM3682:Z9
                          Z7 = EM3680:Z9 + 4 + EM3681:Z9 * 4
                          EM3674:Z9 = EM0:Z7
                          IF (EM3674:Z9 >= 7) AND (EM3674:Z9 <= 10) THEN
