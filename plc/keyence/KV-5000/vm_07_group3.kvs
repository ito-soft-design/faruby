                              ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                              ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                              Z6 = (EM1:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = 8
                                EM3676:Z9 = 1
                              END IF
                              Z6 = (EM2:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = 8
                                EM3676:Z9 = 1
                              END IF
                            ELSE IF EM3674:Z9 = 10 THEN
                              ' **値は スロット + 1。** 0 は main でスロットを持たない
                              IF EM1:Z7 > 0 THEN
                                Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                                IF EM1:Z6 = 0 THEN
                                  EM1:Z6 = 10
                                  EM3676:Z9 = 1
                                END IF
                              END IF
                            ELSE
                              ' 文字列と配列。値がそのままスロット番号
                              Z6 = (EM1:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = EM3674:Z9
                                EM3676:Z9 = 1
                              END IF
