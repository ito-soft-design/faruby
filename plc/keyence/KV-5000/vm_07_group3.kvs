    ELSE IF EM6:Z9 = 22 THEN
      ' OP_SETGV (BB): global[symbols[b]] = R[a]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' シンボル表参照 (4ワード/エントリ)
      Z3 = EM8:Z9 * 4 + EM35:Z9
      Z4 = Z3 + 1
      Z5 = ZF98304:Z3
      Z6 = ZF98304:Z4
      Z7 = Z3 + 2
      Z8 = ZF98304:Z7
      Z7 = Z3 + 3
      Z1 = ZF98304:Z7   ' シンボル種別
      ' レジスタアドレス
      Z2 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF Z1 = 5 THEN
        ' 汎用グローバルは値スロット。型タグごと写す
        Z3 = Z6
        EM1.L:Z3 = EM1.L:Z2
        EM0:Z3 = EM0:Z2
      ELSE IF Z1 = 7 THEN
        ' インスタンス変数はレシーバの中。self のスロットの Z5 番目
        Z3 = 0 + EM32:Z9 + Z9
        Z3 = (EM1:Z3 - 1) * 52 + 2008 + Z9 + 4
        Z3 = Z3 + Z5 * 4
        EM1.L:Z3 = EM1.L:Z2
        EM0:Z3 = EM0:Z2
      ELSE IF Z1 = 1 THEN
        ' デバイス族そのものへの代入 ($DM = 1) は意味を持たない
        EM1:Z9 = 3
        EM2:Z9 = 22
        BREAK
      ELSE IF EM0:Z2 = 7 THEN
        ' 文字列を書けるのは EM / DM / ZF だけ
        ' **この検査は FOR の外に置く。** 中の BREAK は FOR を抜けるだけで
        ' 命令ループから出られず、エラーを書いてもそのまま走り続ける
        IF Z5 > 2 THEN
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
        ' 桁数。0 なら終端付き
        Z7 = Z8 / 16
        ' 文字列スロットの見出し
        Z4 = EM1.L:Z2
        Z4 = Z4 * 52 + 2008 + Z9
        EM18.L:Z9 = EM0:Z4   ' バイト数
        ' 書く長さと埋めるバイトを決める
        IF Z7 = 0 THEN
          ' 終端付き。バイト列 + 0
          EM16.L:Z9 = EM18.L:Z9 + 1
          Z8 = 0
        ELSE
          ' 固定長。余りは FARUBY_STR_FILL
          EM16.L:Z9 = Z7
          Z8 = EM41:Z9
        END IF
        ' 中身の長さ。桁からはみ出す分は切り詰める
        IF EM18.L:Z9 > EM16.L:Z9 THEN
          EM18.L:Z9 = EM16.L:Z9
        END IF
        ' ワード数。奇数バイトなら最後のワードの下位バイトは埋めるバイト
        Z2 = EM16.L:Z9 + 1
        Z2 = Z2 / 2
        IF Z2 > 0 THEN
          Z2 = Z2 - 1
          FOR Z3 = 0 TO Z2
            Z1 = Z3 * 2   ' 先頭バイトの位置
            Z7 = Z1 + 1
            IF Z7 < EM18.L:Z9 THEN
              ' 2 バイトとも中身。並びが同じなのでそのまま写す
              Z7 = Z3 + Z4 + 4
              Z7 = EM0:Z7
            ELSE
              ' 末尾の半端なワード。バイトごとに決める
              Z7 = 0
              IF Z1 < EM18.L:Z9 THEN
                Z7 = Z3 + Z4 + 4
                Z7 = EM0:Z7
                ' 上位バイトだけ中身
                Z7 = Z7 / 256
              ELSE
                IF Z1 < EM16.L:Z9 THEN
                  Z7 = Z8
                END IF
              END IF
              Z7 = Z7 * 256
              Z1 = Z1 + 1
              IF Z1 < EM16.L:Z9 THEN
                Z7 = Z7 + Z8
              END IF
            END IF
            ' ワードデバイスへ 1 ワード。種別は FOR に入る前に検査済み
            Z1 = Z3 + Z6
            IF Z5 = 0 THEN
              EM0.U:Z1 = Z7
            ELSE IF Z5 = 1 THEN
              DM0.U:Z1 = Z7
            ELSE
              ZF0.U:Z1 = Z7
            END IF
          NEXT
        END IF
      ELSE IF EM0:Z2 = 8 THEN
        ' **検査はすべて FOR の外に置く。** 中の BREAK は FOR を抜けるだけで
        ' 命令ループから出られず、エラーを書いてもそのまま走り続ける
        ' 個別ビットには書けない。1 要素が何ビットか決まらない
        IF Z8 = 5 THEN
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
        ' 生成コードが知っている種別か。知らない種別は FOR に入る前に弾く
        EM47:Z9 = 0
        IF Z5 = 0 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 1 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 2 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 3 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 4 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 5 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 6 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 8 THEN
          EM47:Z9 = 1
        END IF
        IF Z5 = 9 THEN
          EM47:Z9 = 1
        END IF
        IF EM47:Z9 = 0 THEN
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
        ' 刻み。幅のワード数、ビットデバイスならその 16 倍
        EM45:Z9 = 1
        IF Z8 = 2 THEN
          EM45:Z9 = 2
        END IF
        IF Z8 = 3 THEN
          EM45:Z9 = 2
        END IF
        IF Z8 = 4 THEN
          EM45:Z9 = 2
        END IF
        IF Z5 > 2 THEN
          EM45:Z9 = EM45:Z9 * 16
        END IF
        ' スロットの見出しと書き先の先頭。どちらもループの中で動かさない
        Z4 = EM1.L:Z2
        Z4 = Z4 * 52 + 2008 + Z9
        EM44:Z9 = Z6   ' 書き先の先頭
        EM18.L:Z9 = EM0:Z4   ' 要素数
        ' 数値でない要素があった印。FOR を出てから判定する
        EM43:Z9 = 0
        IF EM18.L:Z9 > 0 THEN
          Z7 = EM18.L:Z9
          Z7 = Z7 - 1
          FOR EM42:Z9 = 0 TO Z7
            Z3 = EM42:Z9 * 4 + Z4 + 4
            EM47:Z9 = 0
            IF (EM0:Z3 >= 4) AND (EM0:Z3 <= 5) THEN
              EM47:Z9 = 1
            END IF
            IF EM47:Z9 = 0 THEN
              EM43:Z9 = 1
            ELSE
              Z6 = EM42:Z9 * EM45:Z9 + EM44:Z9
              ' レジスタの値を書き込み先の幅に合わせて変換する
              ' 使う側の形だけを作る。Infinity や NaN の整数変換は
              ' 浮動小数点フォーマット異常になるため、.F 書き込みでは行わない
              IF Z8 = 4 THEN
                IF EM0:Z3 = 5 THEN
                  EM18.F:Z9 = EM1.F:Z3
                ELSE
                  EM18.F:Z9 = EM1.L:Z3      ' 整数→実数
                END IF
              ELSE
                IF EM0:Z3 = 5 THEN
                  EM16.L:Z9 = EM1.F:Z3      ' 実数→整数 (0方向へ切り捨て)
                ELSE
                  EM16.L:Z9 = EM1.L:Z3
                END IF
              END IF
              ' デバイスタイプ別書き込み
              ' ワードデバイス (EM, DM, ZF): Z8 (access_type) で幅を選ぶ
              '   2=.L(32bit符号付き)
              '   1=.U(16bit符号なし)
              '   3=.D(32bit符号なし)
              '   4=.F(実数)
              '   それ以外=.S(16bit符号付き/既定)
              ' ビットデバイス (R, MR, B, LR, T, C): 非0→ON, 0→OFF
              '   true=1 / false=nil=0 なので値だけで判定できる
              IF Z5 = 0 THEN
                IF Z8 = 2 THEN
                  EM0.L:Z6 = EM16.L:Z9
                ELSE IF Z8 = 1 THEN
                  EM0.U:Z6 = EM16.L:Z9
                ELSE IF Z8 = 3 THEN
                  EM0.D:Z6 = EM16.L:Z9
                ELSE IF Z8 = 4 THEN
                  EM0.F:Z6 = EM18.F:Z9
                ELSE
                  EM0.S:Z6 = EM16.L:Z9
                END IF
              ELSE IF Z5 = 1 THEN
                IF Z8 = 2 THEN
                  DM0.L:Z6 = EM16.L:Z9
                ELSE IF Z8 = 1 THEN
                  DM0.U:Z6 = EM16.L:Z9
                ELSE IF Z8 = 3 THEN
                  DM0.D:Z6 = EM16.L:Z9
                ELSE IF Z8 = 4 THEN
                  DM0.F:Z6 = EM18.F:Z9
                ELSE
                  DM0.S:Z6 = EM16.L:Z9
                END IF
              ELSE IF Z5 = 2 THEN
                IF Z8 = 2 THEN
                  ZF0.L:Z6 = EM16.L:Z9
                ELSE IF Z8 = 1 THEN
                  ZF0.U:Z6 = EM16.L:Z9
                ELSE IF Z8 = 3 THEN
                  ZF0.D:Z6 = EM16.L:Z9
                ELSE IF Z8 = 4 THEN
                  ZF0.F:Z6 = EM18.F:Z9
                ELSE
                  ZF0.S:Z6 = EM16.L:Z9
                END IF
              ELSE IF Z5 = 3 THEN
                IF Z8 = 5 THEN
                  IF EM16.L:Z9 <> 0 THEN
                    R0:Z6 = TRUE
                  ELSE
                    R0:Z6 = FALSE
                  END IF
                ELSE
                  IF Z8 = 2 THEN
                    R0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    R0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    R0.D:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 4 THEN
                    R0.F:Z6 = EM18.F:Z9
                  ELSE
                    R0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE IF Z5 = 4 THEN
                IF Z8 = 5 THEN
                  IF EM16.L:Z9 <> 0 THEN
                    MR0:Z6 = TRUE
                  ELSE
                    MR0:Z6 = FALSE
                  END IF
                ELSE
                  IF Z8 = 2 THEN
                    MR0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    MR0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    MR0.D:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 4 THEN
                    MR0.F:Z6 = EM18.F:Z9
                  ELSE
                    MR0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE IF Z5 = 5 THEN
                IF Z8 = 5 THEN
                  IF EM16.L:Z9 <> 0 THEN
                    B0:Z6 = TRUE
                  ELSE
                    B0:Z6 = FALSE
                  END IF
                ELSE
                  IF Z8 = 2 THEN
                    B0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    B0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    B0.D:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 4 THEN
                    B0.F:Z6 = EM18.F:Z9
                  ELSE
                    B0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE IF Z5 = 6 THEN
                IF Z8 = 5 THEN
                  IF EM16.L:Z9 <> 0 THEN
                    LR0:Z6 = TRUE
                  ELSE
                    LR0:Z6 = FALSE
                  END IF
                ELSE
                  IF Z8 = 2 THEN
                    LR0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    LR0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    LR0.D:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 4 THEN
                    LR0.F:Z6 = EM18.F:Z9
                  ELSE
                    LR0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE IF Z5 = 8 THEN
                IF Z8 = 5 THEN
                  ' 接点は書けない。呼ぶ側が個別ビットを弾いている。ここへは来ない
                ELSE
                  IF Z8 = 2 THEN
                    T0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    T0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    T0.D:Z6 = EM16.L:Z9
                  ELSE
                    T0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE IF Z5 = 9 THEN
                IF Z8 = 5 THEN
                  ' 接点は書けない。呼ぶ側が個別ビットを弾いている。ここへは来ない
                ELSE
                  IF Z8 = 2 THEN
                    C0.L:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 1 THEN
                    C0.U:Z6 = EM16.L:Z9
                  ELSE IF Z8 = 3 THEN
                    C0.D:Z6 = EM16.L:Z9
                  ELSE
                    C0.S:Z6 = EM16.L:Z9
                  END IF
                END IF
              ELSE
                ' 呼ぶ側が種別を確かめている。ここへは来ない
              END IF
            END IF
          NEXT
        END IF
        IF EM43:Z9 = 1 THEN
          ' 数値でない要素があった。入れ子の書き出し方は決めていない
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
      ELSE IF EM0:Z2 = 9 THEN
        ' ハッシュはデバイスへ写せない。鍵の並べ方が決まらない
        EM1:Z9 = 3
        EM2:Z9 = 22
        BREAK
      ELSE
        IF Z8 >= 6 THEN
          ' 文字列の桁 (T) に文字列以外を書こうとした
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
        ' レジスタの値を書き込み先の幅に合わせて変換する
        ' 使う側の形だけを作る。Infinity や NaN の整数変換は
        ' 浮動小数点フォーマット異常になるため、.F 書き込みでは行わない
        IF Z8 = 4 THEN
          IF EM0:Z2 = 5 THEN
            EM18.F:Z9 = EM1.F:Z2
          ELSE
            EM18.F:Z9 = EM1.L:Z2      ' 整数→実数
          END IF
        ELSE
          IF EM0:Z2 = 5 THEN
            EM16.L:Z9 = EM1.F:Z2      ' 実数→整数 (0方向へ切り捨て)
          ELSE
            EM16.L:Z9 = EM1.L:Z2
          END IF
        END IF
        ' デバイスタイプ別書き込み
        ' ワードデバイス (EM, DM, ZF): Z8 (access_type) で幅を選ぶ
        '   2=.L(32bit符号付き)
        '   1=.U(16bit符号なし)
        '   3=.D(32bit符号なし)
        '   4=.F(実数)
        '   それ以外=.S(16bit符号付き/既定)
        ' ビットデバイス (R, MR, B, LR, T, C): 非0→ON, 0→OFF
        '   true=1 / false=nil=0 なので値だけで判定できる
        IF Z5 = 0 THEN
          IF Z8 = 2 THEN
            EM0.L:Z6 = EM16.L:Z9
          ELSE IF Z8 = 1 THEN
            EM0.U:Z6 = EM16.L:Z9
          ELSE IF Z8 = 3 THEN
            EM0.D:Z6 = EM16.L:Z9
          ELSE IF Z8 = 4 THEN
            EM0.F:Z6 = EM18.F:Z9
          ELSE
            EM0.S:Z6 = EM16.L:Z9
          END IF
        ELSE IF Z5 = 1 THEN
          IF Z8 = 2 THEN
            DM0.L:Z6 = EM16.L:Z9
          ELSE IF Z8 = 1 THEN
            DM0.U:Z6 = EM16.L:Z9
          ELSE IF Z8 = 3 THEN
            DM0.D:Z6 = EM16.L:Z9
          ELSE IF Z8 = 4 THEN
            DM0.F:Z6 = EM18.F:Z9
          ELSE
            DM0.S:Z6 = EM16.L:Z9
          END IF
        ELSE IF Z5 = 2 THEN
          IF Z8 = 2 THEN
            ZF0.L:Z6 = EM16.L:Z9
          ELSE IF Z8 = 1 THEN
            ZF0.U:Z6 = EM16.L:Z9
          ELSE IF Z8 = 3 THEN
            ZF0.D:Z6 = EM16.L:Z9
          ELSE IF Z8 = 4 THEN
            ZF0.F:Z6 = EM18.F:Z9
          ELSE
            ZF0.S:Z6 = EM16.L:Z9
          END IF
        ELSE IF Z5 = 3 THEN
          IF Z8 = 5 THEN
            IF EM16.L:Z9 <> 0 THEN
              R0:Z6 = TRUE
            ELSE
              R0:Z6 = FALSE
            END IF
          ELSE
            IF Z8 = 2 THEN
              R0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              R0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              R0.D:Z6 = EM16.L:Z9
            ELSE IF Z8 = 4 THEN
              R0.F:Z6 = EM18.F:Z9
            ELSE
              R0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE IF Z5 = 4 THEN
          IF Z8 = 5 THEN
            IF EM16.L:Z9 <> 0 THEN
              MR0:Z6 = TRUE
            ELSE
              MR0:Z6 = FALSE
            END IF
          ELSE
            IF Z8 = 2 THEN
              MR0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              MR0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              MR0.D:Z6 = EM16.L:Z9
            ELSE IF Z8 = 4 THEN
              MR0.F:Z6 = EM18.F:Z9
            ELSE
              MR0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE IF Z5 = 5 THEN
          IF Z8 = 5 THEN
            IF EM16.L:Z9 <> 0 THEN
              B0:Z6 = TRUE
            ELSE
              B0:Z6 = FALSE
            END IF
          ELSE
            IF Z8 = 2 THEN
              B0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              B0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              B0.D:Z6 = EM16.L:Z9
            ELSE IF Z8 = 4 THEN
              B0.F:Z6 = EM18.F:Z9
            ELSE
              B0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE IF Z5 = 6 THEN
          IF Z8 = 5 THEN
            IF EM16.L:Z9 <> 0 THEN
              LR0:Z6 = TRUE
            ELSE
              LR0:Z6 = FALSE
            END IF
          ELSE
            IF Z8 = 2 THEN
              LR0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              LR0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              LR0.D:Z6 = EM16.L:Z9
            ELSE IF Z8 = 4 THEN
              LR0.F:Z6 = EM18.F:Z9
            ELSE
              LR0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE IF Z5 = 8 THEN
          IF Z8 = 5 THEN
            ' 接点は書けない。タイムアップ・カウントアップで決まる
            EM1:Z9 = 3
            EM2:Z9 = 22
            BREAK
          ELSE
            IF Z8 = 2 THEN
              T0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              T0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              T0.D:Z6 = EM16.L:Z9
            ELSE
              T0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE IF Z5 = 9 THEN
          IF Z8 = 5 THEN
            ' 接点は書けない。タイムアップ・カウントアップで決まる
            EM1:Z9 = 3
            EM2:Z9 = 22
            BREAK
          ELSE
            IF Z8 = 2 THEN
              C0.L:Z6 = EM16.L:Z9
            ELSE IF Z8 = 1 THEN
              C0.U:Z6 = EM16.L:Z9
            ELSE IF Z8 = 3 THEN
              C0.D:Z6 = EM16.L:Z9
            ELSE
              C0.S:Z6 = EM16.L:Z9
            END IF
          END IF
        ELSE
          EM1:Z9 = 3
          EM2:Z9 = 22
          BREAK
        END IF
      END IF

    ELSE
      ' 未知のオペコード: エラー
      EM1:Z9 = 3
      EM2:Z9 = EM6:Z9
      BREAK

    END IF

    ' バイトコード範囲チェック
    IF EM0:Z9 >= EM10:Z9 THEN
      EM1:Z9 = 2
      BREAK
    END IF

  NEXT
END IF
