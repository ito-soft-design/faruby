                      END IF
                    END IF
                  END IF
                END IF
              NEXT
            END IF
          NEXT
          ' 印の付かなかったスロットを探す。32 なら見つからなかった印
          EM3673:Z9 = 32
          FOR EM3672:Z9 = 0 TO 31
            IF EM3673:Z9 >= 32 THEN
              Z6 = EM3672:Z9 * 52 + 2008 + Z9
              IF EM1:Z6 = 0 THEN
                EM3673:Z9 = EM3672:Z9
              END IF
            END IF
          NEXT
          ' 借りた Z を返す
          Z6 = EM3677:Z9
          Z7 = EM3678:Z9
          IF EM3673:Z9 >= 32 THEN
            ' 全スロットが生きている。回収しても足りない
            EM1:Z9 = 3
            EM2:Z9 = 10
            BREAK
          END IF
        ELSE
          ' まだ順に渡せる
          EM3673:Z9 = EM39:Z9
        END IF
        Z3 = EM3673:Z9 * 52 + 2008 + Z9
        EM0:Z3 = EM44:Z9
        ' ワード単位で写す。並びが同じなので詰め替えは要らない
        EM45:Z9 = EM44:Z9 + 1
        EM45:Z9 = EM45:Z9 / 2   ' ワード数
        IF EM45:Z9 > 0 THEN
          EM45:Z9 = EM45:Z9 - 1
          FOR EM42:Z9 = 0 TO EM45:Z9
            Z4 = EM42:Z9 + Z6   ' デバイスの位置
            ' ワードデバイスから 1 ワード。種別は FOR に入る前に検査済み
            IF Z5 = 0 THEN
              Z7 = EM0.U:Z4
            ELSE IF Z5 = 1 THEN
              Z7 = DM0.U:Z4
            ELSE
              Z7 = ZF0.U:Z4
            END IF
            Z4 = EM42:Z9 + Z3 + 4
            EM0:Z4 = Z7
          NEXT
        END IF
        ' 桁が奇数なら最後のワードの下位バイトは桁の外。0 にして中身に混ぜない
        ' 残すと同じ中身どうしの == がワード単位の比較で外れる
        EM45:Z9 = EM44:Z9 / 2
        EM43:Z9 = EM45:Z9 * 2
        IF EM44:Z9 <> EM43:Z9 THEN
          Z4 = EM45:Z9 + Z3 + 4
          Z7 = EM0:Z4
          Z7 = Z7 / 256
          EM0:Z4 = Z7 * 256
        END IF
        EM1.L:Z2 = EM3673:Z9   ' スロット番号
        EM0:Z2 = 7
        ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
        IF EM3673:Z9 = EM39:Z9 THEN
          EM39:Z9 = EM39:Z9 + 1
        END IF
