          IF EM0:Z1 <> 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z2 <> 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          EM1.L:Z1 = EM1.L:Z1 OR EM1.L:Z2
