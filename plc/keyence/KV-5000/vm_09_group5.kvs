        ' ブロックを取らないメソッドにブロックを渡した
        EM1:Z9 = 3
        EM2:Z9 = 3
        BREAK
      END IF
      ' **new だけ引数の数を突き合わせません** (ブロック無しと同じ理由)
      IF Z5 <> 28 THEN
        IF EM9:Z9 <> Z8 THEN
          EM1:Z9 = 3
          EM2:Z9 = 3
          BREAK
        END IF
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      ' メソッド番号の区分ごとにレシーバのタグの範囲を見る (METHOD_RECEIVER_GROUPS)
      ' 3 未満 (!= と !) はどの型でも呼べる
      IF Z5 >= 3 THEN
        IF Z5 <= 17 THEN
          ' 数値 (タグ 4-5)
          IF EM0:Z1 < 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 5 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 19 THEN
          ' 文字列・配列・ハッシュ (タグ 7-9)
          IF EM0:Z1 < 7 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 9 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 20 THEN
          ' 整数・文字列・配列 (タグ 4-8)
          IF EM0:Z1 < 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 8 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 21 THEN
          ' 配列・ハッシュ (タグ 8-9)
          IF EM0:Z1 < 8 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 9 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 22 THEN
          ' 配列 (タグ 8)
          IF EM0:Z1 <> 8 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 25 THEN
          ' ハッシュ (タグ 9)
          IF EM0:Z1 <> 9 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 26 THEN
          ' デバイス参照 (タグ 11)
          IF EM0:Z1 <> 11 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 27 THEN
          ' self (タグ 10)
          IF EM0:Z1 <> 10 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 <= 28 THEN
          ' クラス (タグ 13-14)
          IF EM0:Z1 < 13 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 14 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE
          ' 配列・ハッシュ (タグ 8-9)
          IF EM0:Z1 < 8 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z1 > 9 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        END IF
      END IF
      ' ブロックは引数の後ろ R[a + 引数の数 + 1] にある
      Z3 = (EM7:Z9 + EM9:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z3 <> 12 THEN
        EM1:Z9 = 3
        EM2:Z9 = 9
        BREAK
      END IF
      IF Z5 = 27 THEN
        ' loop は上限が無い。どちらも 0 にしておき、比較は種別で飛ばす
        EM16.L:Z9 = 0
        EM18.L:Z9 = 0
      ELSE IF Z5 = 11 THEN
        ' n.times は 0 から n-1 まで
        EM16.L:Z9 = 0
        EM18.L:Z9 = EM1.L:Z1 - 1
      ELSE IF Z5 = 28 THEN
        IF EM0:Z1 <> 14 THEN
          EM1:Z9 = 3
          EM2:Z9 = 4
          BREAK
        END IF
        IF EM1:Z1 <> 1 THEN
          EM1:Z9 = 3
          EM2:Z9 = 4
          BREAK
        END IF
        ' **鍵は upto と分けます。** 同じ鍵だと「別の枝でアドレスを載せた」
