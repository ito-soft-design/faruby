            ' プールの空きスロットを決める
            IF EM39:Z9 >= 32 THEN
              ' 順に渡すぶんは尽きた。回収して空きを探す
              ' --- 回収 (使い切ったときだけ走る) ---
              ' アドレスを載せる Z を 2 本借りる。確保の場所ごとに空きが違う
              EM3677:Z9 = Z6
              EM3678:Z9 = Z7
              ' 印と走査済みを消す
              FOR EM3672:Z9 = 0 TO 31
                Z6 = EM3672:Z9 * 52 + 2008 + Z9
                EM1:Z6 = 0
                EM2:Z6 = 0
              NEXT
              ' ルート。レジスタ全 80 個と汎用グローバル 300 個
              ' **窓ではなく物理的な全レジスタ。** 外側のフレームの値も生きている
              FOR EM3672:Z9 = 0 TO 379
                IF EM3672:Z9 < 80 THEN
                  Z7 = EM3672:Z9 * 4 + 72 + Z9
                ELSE
                  Z7 = (EM3672:Z9 - 80) * 4 + 808 + Z9
                END IF
                EM3674:Z9 = EM0:Z7
                IF EM3674:Z9 >= 7 THEN
                  IF EM3674:Z9 <= 10 THEN
                    IF EM3674:Z9 = 9 THEN
                      ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                      ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                      Z6 = (EM1:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = 8
                        EM3676:Z9 = 1
                      END IF
                      Z6 = (EM2:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = 8
                        EM3676:Z9 = 1
                      END IF
                    ELSE IF EM3674:Z9 = 10 THEN
                      ' **値は スロット + 1。** 0 は main でスロットを持たない
                      IF EM1:Z7 > 0 THEN
                        Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                        IF EM1:Z6 = 0 THEN
                          EM1:Z6 = 10
                          EM3676:Z9 = 1
                        END IF
                      END IF
                    ELSE
                      ' 文字列と配列。値がそのままスロット番号
                      Z6 = (EM1:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = EM3674:Z9
                        EM3676:Z9 = 1
                      END IF
                    END IF
                  END IF
                END IF
              NEXT
              ' 確保してレジスタへ書くまでのスロット。**まだどこからも届かない**
              ' 1 つの命令で 2 つ取るところ (ハッシュ) で要る。0 なら無し
              IF EM3675:Z9 > 0 THEN
                Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
              END IF
              ' 到達性を伝播する。印の付いたスロットの中身も辿る
              ' **印が増えなくなったら空回りします。** 最悪 32 周
              ' **BREAK は使いません。** 命令ループの BREAK と違って内側の FOR を
              ' 抜けるだけですが、エラーの BREAK と見分けが付かなくなります
              ' ルート走査で印が付いているので 1 周は回す
              EM3676:Z9 = 1
              FOR EM3679:Z9 = 0 TO 31
                IF EM3676:Z9 <> 0 THEN
                  EM3676:Z9 = 0
                  FOR EM3672:Z9 = 0 TO 31
                    Z6 = EM3672:Z9 * 52 + 2008 + Z9
                    ' 見出しのアドレスを覚える。印を付けるときに Z6 が壊れる
                    EM3680:Z9 = Z6
                    EM3674:Z9 = EM1:Z6
                    IF EM3674:Z9 <> 0 THEN
                      IF EM2:Z6 = 0 THEN
                        EM2:Z6 = 1
                        ' 文字列の中身はバイト列。辿らない
                        IF EM3674:Z9 <> 7 THEN
                          IF EM3674:Z9 = 10 THEN
                            ' インスタンス変数は容量いっぱい使う
                            EM3682:Z9 = 12
                          ELSE
                            ' 配列は要素数まで
                            EM3682:Z9 = EM0:Z6
                          END IF
                          ' **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットと
                          ' して読むと、前に入っていた文字列のバイト列が型タグに見え、
                          ' プールの外へ印を書きに行くことがある
                          ' 符号なしなので 0 - 1 が 65535 になるのも同じ理由で避ける
                          IF EM3682:Z9 > 0 THEN
                            EM3682:Z9 = EM3682:Z9 - 1
                            ' 要素は値スロットの並び。ルートと同じ手で印を付ける
                            FOR EM3681:Z9 = 0 TO EM3682:Z9
                              Z7 = EM3680:Z9 + 4 + EM3681:Z9 * 4
                              EM3674:Z9 = EM0:Z7
                              IF EM3674:Z9 >= 7 THEN
                                IF EM3674:Z9 <= 10 THEN
                                  IF EM3674:Z9 = 9 THEN
                                    ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                                    ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                                    Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = 8
                                      EM3676:Z9 = 1
                                    END IF
                                    Z6 = (EM2:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = 8
                                      EM3676:Z9 = 1
                                    END IF
                                  ELSE IF EM3674:Z9 = 10 THEN
                                    ' **値は スロット + 1。** 0 は main でスロットを持たない
                                    IF EM1:Z7 > 0 THEN
                                      Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                                      IF EM1:Z6 = 0 THEN
                                        EM1:Z6 = 10
                                        EM3676:Z9 = 1
                                      END IF
                                    END IF
                                  ELSE
                                    ' 文字列と配列。値がそのままスロット番号
                                    Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = EM3674:Z9
                                      EM3676:Z9 = 1
                                    END IF
                                  END IF
                                END IF
                              END IF
                            NEXT
                          END IF
                        END IF
                      END IF
                    END IF
                  NEXT
                END IF
              NEXT
              ' 印の付かなかったスロットを探す。32 なら見つからなかった印
              EM3673:Z9 = 32
              FOR EM3672:Z9 = 0 TO 31
                IF EM3673:Z9 >= 32 THEN
                  Z6 = EM3672:Z9 * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM3673:Z9 = EM3672:Z9
                  END IF
                END IF
              NEXT
              ' 借りた Z を返す
              Z6 = EM3677:Z9
              Z7 = EM3678:Z9
              IF EM3673:Z9 >= 32 THEN
                ' 全スロットが生きている。回収しても足りない
                EM1:Z9 = 3
                EM2:Z9 = 10
                BREAK
              END IF
            ELSE
              ' まだ順に渡せる
              EM3673:Z9 = EM39:Z9
            END IF
            Z3 = EM3673:Z9 * 52 + 2008 + Z9
            EM0:Z3 = Z8   ' クラス番号
            ' インスタンス変数は未代入 (TT_EMPTY) から始める
            Z4 = Z3 + 4
            Z5 = Z4 + 47
            FOR Z6 = Z4 TO Z5
              EM0:Z6 = 0
            NEXT
            ' **値は スロット + 1。** 0 は main なのでスロット 0 と区別が付かない
            EM1.L:Z1 = EM3673:Z9 + 1   ' スロット番号 + 1
            EM0:Z1 = 10
            ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
            IF EM3673:Z9 = EM39:Z9 THEN
              EM39:Z9 = EM39:Z9 + 1
            END IF
            ' initialize があれば呼ぶ。名前の ID はホストが load で書いている
            IF EM15:Z9 <> 0 THEN
              Z3 = Z8 * 32 + EM15:Z9 + 552 + Z9
              Z5 = EM0:Z3   ' initialize の irep
              IF Z5 <> 0 THEN
                IF EM31:Z9 >= 16 THEN
                  ' 呼び出しが深すぎる。PLC はメモリ固定なので上限で止めるしかない
                  EM1:Z9 = 3
                  EM2:Z9 = 5
                  BREAK
                END IF
                ' 戻り先を積む
                Z3 = EM31:Z9 * 10 + 392 + Z9
                EM0:Z3 = EM0:Z9
                EM1:Z3 = EM30:Z9
                EM2:Z3 = EM32:Z9
                EM4:Z3 = 65535
                EM5:Z3 = 5
                ' レジスタ窓をずらす。呼ばれた側の R[0] が呼んだ側の R[a]
                EM32:Z9 = EM32:Z9 + EM7:Z9 * 4
                EM3:Z3 = EM32:Z9   ' このフレームの窓 (OP_GETUPVAR が見る)
                EM31:Z9 = EM31:Z9 + 1
                EM37:Z9 = EM9:Z9
                EM30:Z9 = Z5
                ' IREP テーブルから実行中の irep の情報を写す
                Z1 = Z5 * 8 + EM38:Z9
                EM33:Z9 = ZF98304:Z1
                EM10:Z9 = ZF98305:Z1
                EM34:Z9 = ZF98306:Z1
                EM35:Z9 = ZF98307:Z1
                EM11:Z9 = ZF98308:Z1
                ' レジスタ窓が領域からはみ出さないこと
                EM16:Z9 = EM32:Z9 + EM11:Z9 * 4
                IF EM16:Z9 > 392 THEN
                  EM1:Z9 = 3
                  EM2:Z9 = 5
                  BREAK
                END IF
                EM0:Z9 = 0
              END IF
            END IF
          END IF
        ELSE
          ' 未対応のメソッド (ブロックを取るメソッドをブロック無しで呼んだ場合も含む)
          EM1:Z9 = 3
          EM2:Z9 = 3
          BREAK
        END IF
      ELSE
        IF Z6 = 0 THEN
          ' 組み込みでもユーザー定義でもない
          EM1:Z9 = 3
          EM2:Z9 = 3
          BREAK
        END IF
        ' 探索の行。レシーバのクラス (main は 0 行目)
        Z7 = 0
        IF EM0:Z1 = 13 THEN
          Z7 = EM1:Z1
        END IF
        IF EM0:Z1 = 10 THEN
          ' オブジェクトは見出しのクラス番号。値は スロット + 1 (0 は main)
          IF EM1:Z1 <> 0 THEN
            Z7 = (EM1:Z1 - 1) * 52 + 2008 + Z9
            Z7 = EM0:Z7
          END IF
        END IF
        Z7 = Z7 * 32
        Z3 = Z7 + Z6 + 552 + Z9
        Z5 = EM0:Z3   ' 本体の irep 番号
        IF Z5 = 0 THEN
          ' まだ def が実行されていない
          EM1:Z9 = 3
          EM2:Z9 = 3
          BREAK
        END IF
        IF EM31:Z9 >= 16 THEN
          ' 呼び出しが深すぎる。PLC はメモリ固定なので上限で止めるしかない
          EM1:Z9 = 3
          EM2:Z9 = 5
          BREAK
        END IF
        ' 戻り先を積む
        Z3 = EM31:Z9 * 10 + 392 + Z9
        EM0:Z3 = EM0:Z9
        EM1:Z3 = EM30:Z9
        EM2:Z3 = EM32:Z9
        EM4:Z3 = 65535
        EM5:Z3 = 0
        ' レジスタ窓をずらす。呼ばれた側の R[0] が呼んだ側の R[a]
        EM32:Z9 = EM32:Z9 + EM7:Z9 * 4
        EM3:Z3 = EM32:Z9   ' このフレームの窓 (OP_GETUPVAR が見る)
        EM31:Z9 = EM31:Z9 + 1
        EM37:Z9 = EM9:Z9
        EM30:Z9 = Z5
        ' IREP テーブルから実行中の irep の情報を写す
        Z1 = Z5 * 8 + EM38:Z9
        EM33:Z9 = ZF98304:Z1
        EM10:Z9 = ZF98305:Z1
        EM34:Z9 = ZF98306:Z1
        EM35:Z9 = ZF98307:Z1
        EM11:Z9 = ZF98308:Z1
        ' レジスタ窓が領域からはみ出さないこと
        EM16:Z9 = EM32:Z9 + EM11:Z9 * 4
        IF EM16:Z9 > 392 THEN
          EM1:Z9 = 3
          EM2:Z9 = 5
          BREAK
        END IF
        EM0:Z9 = 0
      END IF

    ELSE IF EM6:Z9 = 48 THEN
      ' OP_SENDB (BBB): R[a].symbols[b](R[a+1]..) { ブロック }
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM9:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' シンボル表参照 (4ワード/エントリ)
      Z3 = EM8:Z9 * 4 + EM35:Z9
      Z5 = ZF98304:Z3   ' メソッド番号
      Z7 = Z3 + 2
      Z8 = ZF98304:Z7   ' 引数の数
      Z7 = Z3 + 3
      Z4 = ZF98304:Z7   ' シンボル種別
      IF Z4 <> 2 THEN
        EM1:Z9 = 3
        EM2:Z9 = 3
        BREAK
      END IF
      ' ブロックを取るメソッドはレシーバの型で並んでいるため連続していない
      Z6 = 0
      IF Z5 = 11 THEN
        Z6 = 1
      END IF
      IF Z5 = 12 THEN
        Z6 = 1
      END IF
      IF Z5 = 21 THEN
        Z6 = 1
      END IF
      IF Z5 = 27 THEN
        Z6 = 1
      END IF
      IF Z5 = 29 THEN
        Z6 = 1
      END IF
      IF Z5 = 30 THEN
        Z6 = 1
      END IF
      IF Z5 = 31 THEN
        Z6 = 1
      END IF
      IF Z5 = 28 THEN
        Z6 = 1
      END IF
