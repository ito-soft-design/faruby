            END IF
            ' 末尾に足して要素数を 1 増やす
            EM16.L:Z9 = EM18.L:Z9
            Z5 = EM16.L:Z9
            Z5 = Z5 * 4 + Z4 + 4
            EM1.L:Z5 = EM1.L:Z2
            EM0:Z5 = EM0:Z2
            Z6 = EM18.L:Z9
            EM0:Z4 = Z6 + 1
