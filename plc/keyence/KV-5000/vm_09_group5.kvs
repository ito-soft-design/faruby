        Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
        IF EM0:Z2 <> 4 THEN
          EM1:Z9 = 3
          EM2:Z9 = 4
          BREAK
        END IF
        IF EM1.L:Z2 < 0 THEN
          EM1:Z9 = 3
          EM2:Z9 = 4
          BREAK
        END IF
        IF EM1.L:Z2 > 12 THEN
          ' 1 スロットに収まらない大きさ
          EM1:Z9 = 3
          EM2:Z9 = 10
          BREAK
        END IF
        ' **要素数は Z8 に置きます。** Z5 はメソッド番号で、
        ' この後の enter_iteration が種別を決めるのに読みます
        Z8 = EM1.L:Z2   ' 要素数
        ' プールの空きスロットを決める
        IF EM39:Z9 >= 32 THEN
          ' 順に渡すぶんは尽きた。回収して空きを探す
          ' --- 回収 (使い切ったときだけ走る) ---
          ' アドレスを載せる Z を 2 本借りる。確保の場所ごとに空きが違う
          EM3677:Z9 = Z6
          EM3678:Z9 = Z7
          ' 印と走査済みを消す
          FOR EM3672:Z9 = 0 TO 31
            Z6 = EM3672:Z9 * 52 + 2008 + Z9
            EM1:Z6 = 0
            EM2:Z6 = 0
          NEXT
          ' ルート。レジスタ全 80 個と汎用グローバル 300 個
          ' **窓ではなく物理的な全レジスタ。** 外側のフレームの値も生きている
          FOR EM3672:Z9 = 0 TO 379
            IF EM3672:Z9 < 80 THEN
              Z7 = EM3672:Z9 * 4 + 72 + Z9
            ELSE
              Z7 = (EM3672:Z9 - 80) * 4 + 808 + Z9
            END IF
            EM3674:Z9 = EM0:Z7
            IF EM3674:Z9 >= 7 THEN
              IF EM3674:Z9 <= 10 THEN
                IF EM3674:Z9 = 9 THEN
                  ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                  ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                  Z6 = (EM1:Z7) * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM1:Z6 = 8
                    EM3676:Z9 = 1
                  END IF
                  Z6 = (EM2:Z7) * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM1:Z6 = 8
                    EM3676:Z9 = 1
                  END IF
                ELSE IF EM3674:Z9 = 10 THEN
                  ' **値は スロット + 1。** 0 は main でスロットを持たない
                  IF EM1:Z7 > 0 THEN
                    Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                    IF EM1:Z6 = 0 THEN
                      EM1:Z6 = 10
                      EM3676:Z9 = 1
                    END IF
                  END IF
                ELSE
                  ' 文字列と配列。値がそのままスロット番号
                  Z6 = (EM1:Z7) * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM1:Z6 = EM3674:Z9
                    EM3676:Z9 = 1
                  END IF
                END IF
              END IF
            END IF
          NEXT
          ' 確保してレジスタへ書くまでのスロット。**まだどこからも届かない**
          ' 1 つの命令で 2 つ取るところ (ハッシュ) で要る。0 なら無し
          IF EM3675:Z9 > 0 THEN
            Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
            IF EM1:Z6 = 0 THEN
              EM1:Z6 = 8
              EM3676:Z9 = 1
            END IF
          END IF
          ' 到達性を伝播する。印の付いたスロットの中身も辿る
          ' **印が増えなくなったら空回りします。** 最悪 32 周
          ' **BREAK は使いません。** 命令ループの BREAK と違って内側の FOR を
          ' 抜けるだけですが、エラーの BREAK と見分けが付かなくなります
          ' ルート走査で印が付いているので 1 周は回す
          EM3676:Z9 = 1
          FOR EM3679:Z9 = 0 TO 31
            IF EM3676:Z9 <> 0 THEN
              EM3676:Z9 = 0
              FOR EM3672:Z9 = 0 TO 31
                Z6 = EM3672:Z9 * 52 + 2008 + Z9
                ' 見出しのアドレスを覚える。印を付けるときに Z6 が壊れる
                EM3680:Z9 = Z6
                EM3674:Z9 = EM1:Z6
                IF EM3674:Z9 <> 0 THEN
                  IF EM2:Z6 = 0 THEN
                    EM2:Z6 = 1
                    ' 文字列の中身はバイト列。辿らない
                    IF EM3674:Z9 <> 7 THEN
                      IF EM3674:Z9 = 10 THEN
                        ' インスタンス変数は容量いっぱい使う
                        EM3682:Z9 = 12
                      ELSE
                        ' 配列は要素数まで
                        EM3682:Z9 = EM0:Z6
                      END IF
                      ' **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットと
                      ' して読むと、前に入っていた文字列のバイト列が型タグに見え、
                      ' プールの外へ印を書きに行くことがある
                      ' 符号なしなので 0 - 1 が 65535 になるのも同じ理由で避ける
                      IF EM3682:Z9 > 0 THEN
                        EM3682:Z9 = EM3682:Z9 - 1
                        ' 要素は値スロットの並び。ルートと同じ手で印を付ける
                        FOR EM3681:Z9 = 0 TO EM3682:Z9
                          Z7 = EM3680:Z9 + 4 + EM3681:Z9 * 4
                          EM3674:Z9 = EM0:Z7
                          IF EM3674:Z9 >= 7 THEN
                            IF EM3674:Z9 <= 10 THEN
                              IF EM3674:Z9 = 9 THEN
                                ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                                ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                IF EM1:Z6 = 0 THEN
                                  EM1:Z6 = 8
                                  EM3676:Z9 = 1
                                END IF
                                Z6 = (EM2:Z7) * 52 + 2008 + Z9
                                IF EM1:Z6 = 0 THEN
                                  EM1:Z6 = 8
                                  EM3676:Z9 = 1
                                END IF
                              ELSE IF EM3674:Z9 = 10 THEN
                                ' **値は スロット + 1。** 0 は main でスロットを持たない
                                IF EM1:Z7 > 0 THEN
                                  Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                                  IF EM1:Z6 = 0 THEN
                                    EM1:Z6 = 10
                                    EM3676:Z9 = 1
                                  END IF
                                END IF
                              ELSE
                                ' 文字列と配列。値がそのままスロット番号
                                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                IF EM1:Z6 = 0 THEN
                                  EM1:Z6 = EM3674:Z9
                                  EM3676:Z9 = 1
                                END IF
                              END IF
                            END IF
                          END IF
                        NEXT
                      END IF
                    END IF
                  END IF
                END IF
              NEXT
            END IF
          NEXT
          ' 印の付かなかったスロットを探す。32 なら見つからなかった印
          EM3673:Z9 = 32
          FOR EM3672:Z9 = 0 TO 31
            IF EM3673:Z9 >= 32 THEN
              Z6 = EM3672:Z9 * 52 + 2008 + Z9
              IF EM1:Z6 = 0 THEN
                EM3673:Z9 = EM3672:Z9
              END IF
            END IF
          NEXT
          ' 借りた Z を返す
          Z6 = EM3677:Z9
          Z7 = EM3678:Z9
          IF EM3673:Z9 >= 32 THEN
            ' 全スロットが生きている。回収しても足りない
            EM1:Z9 = 3
            EM2:Z9 = 10
            BREAK
          END IF
        ELSE
          ' まだ順に渡せる
          EM3673:Z9 = EM39:Z9
        END IF
        Z4 = EM3673:Z9 * 52 + 2008 + Z9
        EM0:Z4 = Z8
        ' **先に nil で埋めます。** ブロックが途中で break しても、
        ' 書いていない要素を値スロットとして読まれないようにするため
        IF Z8 > 0 THEN
          Z6 = Z8 - 1
          FOR Z7 = 0 TO Z6
            Z1 = Z7 * 4 + Z4 + 4
            EM1.L:Z1 = 0
            EM0:Z1 = 1
          NEXT
        END IF
        ' **R[a] を配列で潰します。** これが呼び出しの値になり、
        ' 反復の間は R[0] として書き込む先を引くのにも使います
        Z3 = EM7:Z9 * 4 + EM32:Z9 + Z9
        EM1.L:Z3 = EM3673:Z9   ' スロット番号
        EM0:Z3 = 8
        ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
        IF EM3673:Z9 = EM39:Z9 THEN
          EM39:Z9 = EM39:Z9 + 1
        END IF
        ' 0 から 要素数-1 まで。0 個なら 1 回も回らない
        EM16.L:Z9 = 0
        EM18.L:Z9 = Z8 - 1
      ELSE IF Z5 = 12 THEN
        ' a.upto(b) は a から b まで
        Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
        IF EM0:Z2 <> 4 THEN
          EM1:Z9 = 3
          EM2:Z9 = 4
          BREAK
        END IF
        EM16.L:Z9 = EM1.L:Z1
        EM18.L:Z9 = EM1.L:Z2
      ELSE
        ' **残りはコレクションの反復です** (each / any? / all? / none?)。
        ' 0 から要素数-1 まで回り、数え方はどれも同じ
        ' ハッシュは組の数。どちらも Z5 (メソッド番号) を壊さない方で読む
        IF EM0:Z1 = 9 THEN
          ' 鍵の配列の見出し。R[a] を書き換える前に読む
          Z4 = EM1:Z1
          Z4 = Z4 * 52 + 2008 + Z9
          EM18.L:Z9 = EM0:Z4   ' 組の数
        ELSE
          ' スロットの見出し。R[a] を書き換える前に読む
          Z4 = EM1.L:Z1
          Z4 = Z4 * 52 + 2008 + Z9
          EM18.L:Z9 = EM0:Z4   ' 要素数
        END IF
        EM16.L:Z9 = 0
        EM18.L:Z9 = EM18.L:Z9 - 1
      END IF
      IF EM16.L:Z9 <= EM18.L:Z9 THEN
        IF EM31:Z9 >= 16 THEN
          ' 呼び出しが深すぎる。PLC はメモリ固定なので上限で止めるしかない
          EM1:Z9 = 3
          EM2:Z9 = 5
          BREAK
        END IF
        ' 戻り先を積む
        Z3 = EM31:Z9 * 10 + 392 + Z9
        EM0:Z3 = EM0:Z9
        EM1:Z3 = EM30:Z9
        EM2:Z3 = EM32:Z9
        EM4:Z3 = 65535
        EM5:Z3 = 1
        ' レジスタ窓をずらす。呼ばれた側の R[0] が呼んだ側の R[a]
        EM32:Z9 = EM32:Z9 + EM7:Z9 * 4
        EM3:Z3 = EM32:Z9   ' このフレームの窓 (OP_GETUPVAR が見る)
        EM31:Z9 = EM31:Z9 + 1
        IF Z5 = 21 THEN
          ' each はブロックに添字ではなく要素を渡す
          ' ハッシュは鍵と値の 2 つを渡すので種別を分ける
          Z4 = 0 + EM32:Z9 + Z9   ' 窓をずらした後の R[0] がレシーバ
          IF EM0:Z4 = 9 THEN
            EM5:Z3 = 3
          ELSE
            EM5:Z3 = 2
          END IF
        END IF
        IF Z5 = 27 THEN
          ' loop は上限が無く、ブロックに渡す値も無い
          EM5:Z3 = 4
        END IF
        ' **述語は渡す値を種別で分けません。** R[0] の型タグで決まるので、
        ' 種別が持つのは「ブロックの値をどう使うか」だけです
        IF Z5 = 29 THEN
          EM5:Z3 = 6
        END IF
        IF Z5 = 30 THEN
          EM5:Z3 = 7
        END IF
        IF Z5 = 31 THEN
          EM5:Z3 = 8
        END IF
        IF Z5 = 28 THEN
          ' Array.new はブロックの値を要素へ書く。渡すのは添字
          EM5:Z3 = 9
        END IF
        ' 窓をずらした後、ブロックは R[引数の数 + 1] にある
        Z2 = (EM9:Z9 + 1) * 4 + EM32:Z9 + Z9
        Z6 = EM1:Z2       ' 本体の irep
        Z7 = EM2:Z2   ' 定義元のフレーム
        ' 反復の状態と定義元をフレームに書く (Z3 は push_frame が指したまま)
        EM4:Z3 = Z7
        EM6.L:Z3 = EM16.L:Z9
        EM8.L:Z3 = EM18.L:Z9
        ' 渡す値と引数の数はどちらもフレームの種別で決まる。まとめて書く
        Z2 = 4 + EM32:Z9 + Z9
        IF EM5:Z3 = 4 THEN
          ' loop はブロックに何も渡さない。**引数の数だけ書く。**
          ' Ruby の loop { |i| } も i は nil で、ここでは未代入のまま
          EM37:Z9 = 0
        ELSE IF EM5:Z3 = 1 THEN
          ' times / upto は添字を渡す
          EM1.L:Z2 = EM16.L:Z9
          EM0:Z2 = 4
          EM37:Z9 = 1
        ELSE IF EM5:Z3 = 9 THEN
          ' **Array.new も添字です。** R[0] が配列なので、下のコレクションの
          ' 枝に落ちると要素を渡してしまいます。種別で見分けます
          ' **旗を立てて 1 つの枝にまとめられません。** Z6 には移り先の irep が
          ' 載っていて、空いている Z が無いためです (3 行なので分けた方が安い)
          EM1.L:Z2 = EM16.L:Z9
          EM0:Z2 = 4
          EM37:Z9 = 1
        ELSE
          ' **残りはコレクションの反復です** (each / any? / all? / none?)。
          ' 渡す値は種別ではなく **R[0] (レシーバ) の型タグ**で決まります。
          ' 述語は配列とハッシュで種別を分けていないためです
          Z4 = 0 + EM32:Z9 + Z9   ' 窓をずらした後の R[0] がレシーバ
          IF EM0:Z4 = 9 THEN
            ' ハッシュは鍵と値を渡す
            Z7 = EM1:Z4   ' スロット番号
            Z7 = Z7 * 52 + 2008 + Z9
            Z5 = EM16.L:Z9
            Z5 = Z5 * 4 + Z7 + 4
            EM1.L:Z2 = EM1.L:Z5
            EM0:Z2 = EM0:Z5
            Z2 = 2 * 4 + EM32:Z9 + Z9   ' R[2] に値
            Z7 = EM2:Z4   ' スロット番号
            Z7 = Z7 * 52 + 2008 + Z9
            Z5 = EM16.L:Z9
            Z5 = Z5 * 4 + Z7 + 4
            EM1.L:Z2 = EM1.L:Z5
            EM0:Z2 = EM0:Z5
            EM37:Z9 = 2
          ELSE
            ' 配列はその位置の要素を渡す
            ' **スロット番号は 2 つ目のスクラッチへ。** 1 つ目には反復の添字が
            ' 載っていて、これから要素の位置を出すのに使う
            Z7 = EM1.L:Z4   ' スロット番号
            Z7 = Z7 * 52 + 2008 + Z9
            Z5 = EM16.L:Z9
            Z5 = Z5 * 4 + Z7 + 4
            EM1.L:Z2 = EM1.L:Z5
            EM0:Z2 = EM0:Z5
            EM37:Z9 = 1
          END IF
        END IF
        EM30:Z9 = Z6
        ' IREP テーブルから実行中の irep の情報を写す
        Z1 = Z6 * 8 + EM38:Z9
        EM33:Z9 = ZF98304:Z1
        EM10:Z9 = ZF98305:Z1
        EM34:Z9 = ZF98306:Z1
        EM35:Z9 = ZF98307:Z1
        EM11:Z9 = ZF98308:Z1
        ' レジスタ窓が領域からはみ出さないこと
        EM16:Z9 = EM32:Z9 + EM11:Z9 * 4
        IF EM16:Z9 > 392 THEN
          EM1:Z9 = 3
          EM2:Z9 = 5
          BREAK
        END IF
        EM0:Z9 = 0
      ELSE
        ' 1 回も回らないとき。each / times / upto はレシーバがそのまま値になる
        ' **述語だけは答えを書きます。** 空の any? は false、all? と none? は
        ' true で、1 回も回らないのでフレームを積まずにここで決まります
        IF Z5 = 29 THEN
          ' any?: 空なら false
          EM1.L:Z1 = 0
          EM0:Z1 = 2
        END IF
        IF Z5 = 30 THEN
          ' all?: 空なら true
          EM1.L:Z1 = 1
          EM0:Z1 = 3
        END IF
        IF Z5 = 31 THEN
          ' none?: 空なら true
          EM1.L:Z1 = 1
          EM0:Z1 = 3
        END IF
      END IF

    ELSE IF EM6:Z9 = 52 THEN
      ' OP_ENTER (W): 引数の数を検査し、残りのレジスタを空にする
      ' 24bit big-endian。16ビットに収まらないため上位バイトと下位2バイトに分ける
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM8:Z9 = Z3 * 256 + Z4   ' aspec の下位2バイト
      ' 必須引数の数 = aspec >> 18。上位バイトを 4 で割った値と同じ
      Z3 = EM7:Z9 / 4
      IF EM7:Z9 <> Z3 * 4 THEN
        ' 必須引数以外の指定 (省略可能・可変長・キーワード) は未対応
        EM1:Z9 = 3
        EM2:Z9 = 6
        BREAK
      END IF
      IF EM8:Z9 <> 0 THEN
        EM1:Z9 = 3
        EM2:Z9 = 6
        BREAK
      END IF
      ' ブロックは引数の数を検査しない。Ruby は足りなければ nil、余れば捨てる
      ' (引数を書かないブロックでも times は 1 個渡す)
      Z4 = 0
      IF EM31:Z9 > 0 THEN
        Z5 = (EM31:Z9 - 1) * 10 + 392 + Z9
        IF EM5:Z5 >= 1 THEN
          Z4 = 1
        END IF
      END IF
      IF Z4 = 0 THEN
        IF EM37:Z9 <> Z3 THEN
          ' 実引数の数が定義と違う
          EM1:Z9 = 3
          EM2:Z9 = 6
          BREAK
        END IF
      END IF
      ' 引数の後ろのレジスタを空にする (未代入のローカル変数は偽になる)
      ' 受け取れなかった引数も空になる (Ruby の nil に相当)
      IF EM37:Z9 < Z3 THEN
        Z3 = EM37:Z9
      END IF
      Z4 = (Z3 + 1) * 4 + EM32:Z9 + Z9
      Z5 = EM11:Z9 * 4 + EM32:Z9 + Z9 - 1
      IF Z4 <= Z5 THEN
        FOR Z6 = Z4 TO Z5
          EM0:Z6 = 0
        NEXT
      END IF

    ELSE IF EM6:Z9 = 56 THEN
      ' OP_RETURN (B): R[b] を返して呼び出し元へ (トップレベルでは VM 停止)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      IF EM31:Z9 = 0 THEN
        ' トップレベルの return は VM 停止
        EM1:Z9 = 2
        BREAK
      ELSE
        Z3 = (EM31:Z9 - 1) * 10 + 392 + Z9
        ' **new は戻り値を写さない。** R[0] に残っているのは確保した
        ' オブジェクトで、それがそのまま Counter.new の値になる
        IF EM5:Z3 = 5 THEN
          EM31:Z9 = EM31:Z9 - 1
          ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
          Z3 = EM31:Z9 * 10 + 392 + Z9
          EM0:Z9 = EM0:Z3
          Z5 = EM1:Z3
          EM32:Z9 = EM2:Z3
          EM30:Z9 = Z5
          ' IREP テーブルから実行中の irep の情報を写す
          Z1 = Z5 * 8 + EM38:Z9
          EM33:Z9 = ZF98304:Z1
          EM10:Z9 = ZF98305:Z1
          EM34:Z9 = ZF98306:Z1
          EM35:Z9 = ZF98307:Z1
          EM11:Z9 = ZF98308:Z1
        ELSE
          IF EM5:Z3 >= 1 THEN
            IF EM5:Z3 = 9 THEN
              Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
              Z4 = 0 + EM32:Z9 + Z9   ' 窓をずらした後の R[0] が配列
              Z2 = EM1.L:Z4 * 52 + 2008 + Z9
              Z2 = EM6.L:Z3 * 4 + Z2 + 4
              EM1.L:Z2 = EM1.L:Z1
              EM0:Z2 = EM0:Z1
            END IF
            EM59:Z9 = 0
            IF EM5:Z3 >= 6 THEN
              ' **鍵と Z の両方を分けます。** 鍵が同じだと「別の枝でアドレスを
              ' 載せた」で生成器が止まり (ふつうの return も同じ場所を使う)、
              ' **Z が同じだと黙って後の方だけが残ります。** 既定は [:reg, :a]
              ' 以外すべて Z2 なので、ここは Z1 を名指しします。Z1 はこの時点で
              ' 命令の取り出しを終えていて空いています (Z3 はフレーム)
              Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
              Z2 = 0 + EM32:Z9 + Z9
              IF EM5:Z3 = 6 THEN
                ' any?: ブロックの値が真なら打ち切って true を返す
                IF EM0:Z1 > 2 THEN
                  EM1.L:Z2 = 1
                  EM0:Z2 = 3
                  EM59:Z9 = 1
                END IF
              END IF
              IF EM5:Z3 = 7 THEN
                ' all?: ブロックの値が偽なら打ち切って false を返す
                IF EM0:Z1 <= 2 THEN
                  EM1.L:Z2 = 0
                  EM0:Z2 = 2
                  EM59:Z9 = 1
                END IF
              END IF
              IF EM5:Z3 = 8 THEN
                ' none?: ブロックの値が真なら打ち切って false を返す
                IF EM0:Z1 > 2 THEN
                  EM1.L:Z2 = 0
                  EM0:Z2 = 2
                  EM59:Z9 = 1
                END IF
              END IF
            END IF
            EM16.L:Z9 = EM6.L:Z3 + 1
            IF EM5:Z3 = 4 THEN
              ' loop は上限が無い。**break でしか終わらない。**
              ' 上限に合わせて必ず次の回へ入れる (添字は数えないので 0 のまま)
              EM16.L:Z9 = EM8.L:Z3
            END IF
            IF EM59:Z9 <> 0 THEN
              ' 述語が答えを出した。残りは見ずに終わらせる
              EM16.L:Z9 = EM8.L:Z3 + 1
            END IF
            IF EM16.L:Z9 <= EM8.L:Z3 THEN
              ' 次の回。PC を 0 に戻し、ブロックの引数を更新するだけ
              ' irep もレジスタ窓もそのまま使い回す
              EM6.L:Z3 = EM16.L:Z9
              Z2 = 4 + EM32:Z9 + Z9
              IF EM5:Z3 = 4 THEN
                ' loop はブロックに何も渡さない。**引数の数だけ書く。**
                ' Ruby の loop { |i| } も i は nil で、ここでは未代入のまま
                EM37:Z9 = 0
              ELSE IF EM5:Z3 = 1 THEN
                ' times / upto は添字を渡す
                EM1.L:Z2 = EM16.L:Z9
                EM0:Z2 = 4
                EM37:Z9 = 1
              ELSE IF EM5:Z3 = 9 THEN
                ' **Array.new も添字です。** R[0] が配列なので、下のコレクションの
                ' 枝に落ちると要素を渡してしまいます。種別で見分けます
                ' **旗を立てて 1 つの枝にまとめられません。** Z6 には移り先の irep が
                ' 載っていて、空いている Z が無いためです (3 行なので分けた方が安い)
                EM1.L:Z2 = EM16.L:Z9
                EM0:Z2 = 4
                EM37:Z9 = 1
              ELSE
                ' **残りはコレクションの反復です** (each / any? / all? / none?)。
                ' 渡す値は種別ではなく **R[0] (レシーバ) の型タグ**で決まります。
                ' 述語は配列とハッシュで種別を分けていないためです
                Z4 = 0 + EM32:Z9 + Z9   ' 窓をずらした後の R[0] がレシーバ
                IF EM0:Z4 = 9 THEN
                  ' ハッシュは鍵と値を渡す
                  Z7 = EM1:Z4   ' スロット番号
                  Z7 = Z7 * 52 + 2008 + Z9
                  Z5 = EM16.L:Z9
                  Z5 = Z5 * 4 + Z7 + 4
                  EM1.L:Z2 = EM1.L:Z5
                  EM0:Z2 = EM0:Z5
                  Z2 = 2 * 4 + EM32:Z9 + Z9   ' R[2] に値
                  Z7 = EM2:Z4   ' スロット番号
                  Z7 = Z7 * 52 + 2008 + Z9
                  Z5 = EM16.L:Z9
                  Z5 = Z5 * 4 + Z7 + 4
                  EM1.L:Z2 = EM1.L:Z5
                  EM0:Z2 = EM0:Z5
                  EM37:Z9 = 2
                ELSE
                  ' 配列はその位置の要素を渡す
                  ' **スロット番号は 2 つ目のスクラッチへ。** 1 つ目には反復の添字が
                  ' 載っていて、これから要素の位置を出すのに使う
                  Z7 = EM1.L:Z4   ' スロット番号
                  Z7 = Z7 * 52 + 2008 + Z9
                  Z5 = EM16.L:Z9
                  Z5 = Z5 * 4 + Z7 + 4
                  EM1.L:Z2 = EM1.L:Z5
                  EM0:Z2 = EM0:Z5
                  EM37:Z9 = 1
                END IF
              END IF
              EM0:Z9 = 0
            ELSE
              ' 反復の終わり。R[0] にはレシーバが残っており、それが呼び出しの値になる
              ' **述語だけは R[0] を答えに書き換えます。** 打ち切ったときは
              ' predicate_decision が書いてあるので、尽きたときだけここで書く
              IF EM59:Z9 = 0 THEN
                IF EM5:Z3 >= 6 THEN
                  Z2 = 0 + EM32:Z9 + Z9
                  IF EM5:Z3 = 6 THEN
                    ' any?: 尽きたら false
                    EM1.L:Z2 = 0
                    EM0:Z2 = 2
                  END IF
                  IF EM5:Z3 = 7 THEN
                    ' all?: 尽きたら true
                    EM1.L:Z2 = 1
                    EM0:Z2 = 3
                  END IF
                  IF EM5:Z3 = 8 THEN
                    ' none?: 尽きたら true
                    EM1.L:Z2 = 1
                    EM0:Z2 = 3
                  END IF
                END IF
              END IF
              EM31:Z9 = EM31:Z9 - 1
              ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
              Z3 = EM31:Z9 * 10 + 392 + Z9
              EM0:Z9 = EM0:Z3
              Z5 = EM1:Z3
              EM32:Z9 = EM2:Z3
              EM30:Z9 = Z5
              ' IREP テーブルから実行中の irep の情報を写す
              Z1 = Z5 * 8 + EM38:Z9
              EM33:Z9 = ZF98304:Z1
              EM10:Z9 = ZF98305:Z1
              EM34:Z9 = ZF98306:Z1
              EM35:Z9 = ZF98307:Z1
              EM11:Z9 = ZF98308:Z1
            END IF
          ELSE
            ' R[a] を R[0] へ写す。R[0] は呼んだ側の R[a] と同じ場所なので
            ' これで戻り値が呼び出し元から見える位置に入る
            Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
            Z2 = 0 + EM32:Z9 + Z9
            EM1.L:Z2 = EM1.L:Z1
            EM0:Z2 = EM0:Z1
            EM31:Z9 = EM31:Z9 - 1
            ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
            Z3 = EM31:Z9 * 10 + 392 + Z9
            EM0:Z9 = EM0:Z3
            Z5 = EM1:Z3
            EM32:Z9 = EM2:Z3
            EM30:Z9 = Z5
            ' IREP テーブルから実行中の irep の情報を写す
            Z1 = Z5 * 8 + EM38:Z9
            EM33:Z9 = ZF98304:Z1
            EM10:Z9 = ZF98305:Z1
            EM34:Z9 = ZF98306:Z1
            EM35:Z9 = ZF98307:Z1
            EM11:Z9 = ZF98308:Z1
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 58 THEN
      ' OP_BREAK (B): 反復を打ち切って R[a] を返す
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      IF EM31:Z9 = 0 THEN
        ' 反復の外での break
        EM1:Z9 = 3
        EM2:Z9 = 9
        BREAK
      END IF
      Z3 = (EM31:Z9 - 1) * 10 + 392 + Z9
      IF EM5:Z3 < 1 THEN
        EM1:Z9 = 3
        EM2:Z9 = 9
        BREAK
      END IF
      ' break の値を R[0] へ。R[0] は呼んだ側の R[a] と同じ場所
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = 0 + EM32:Z9 + Z9
      EM1.L:Z2 = EM1.L:Z1
      EM0:Z2 = EM0:Z1
      EM31:Z9 = EM31:Z9 - 1
      ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
      Z3 = EM31:Z9 * 10 + 392 + Z9
      EM0:Z9 = EM0:Z3
      Z5 = EM1:Z3
      EM32:Z9 = EM2:Z3
      EM30:Z9 = Z5
      ' IREP テーブルから実行中の irep の情報を写す
      Z1 = Z5 * 8 + EM38:Z9
      EM33:Z9 = ZF98304:Z1
      EM10:Z9 = ZF98305:Z1
      EM34:Z9 = ZF98306:Z1
      EM35:Z9 = ZF98307:Z1
      EM11:Z9 = ZF98308:Z1

    ELSE IF EM6:Z9 = 60 THEN
      ' OP_ADD (B): R[a] = R[a] + R[a+1]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          EM1.F:Z1 = EM1.F:Z1 + EM1.F:Z2
          EM0:Z1 = 5
        ELSE
          EM1.F:Z1 = EM1.F:Z1 + EM1.L:Z2
          EM0:Z1 = 5
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          EM1.F:Z1 = EM1.L:Z1 + EM1.F:Z2
          EM0:Z1 = 5
        ELSE
          IF EM0:Z1 = 7 THEN
            ' プールの空きスロットを決める
            IF EM39:Z9 >= 32 THEN
              ' 順に渡すぶんは尽きた。回収して空きを探す
              ' --- 回収 (使い切ったときだけ走る) ---
              ' アドレスを載せる Z を 2 本借りる。確保の場所ごとに空きが違う
              EM3677:Z9 = Z6
              EM3678:Z9 = Z7
              ' 印と走査済みを消す
              FOR EM3672:Z9 = 0 TO 31
                Z6 = EM3672:Z9 * 52 + 2008 + Z9
                EM1:Z6 = 0
                EM2:Z6 = 0
              NEXT
              ' ルート。レジスタ全 80 個と汎用グローバル 300 個
              ' **窓ではなく物理的な全レジスタ。** 外側のフレームの値も生きている
              FOR EM3672:Z9 = 0 TO 379
                IF EM3672:Z9 < 80 THEN
                  Z7 = EM3672:Z9 * 4 + 72 + Z9
                ELSE
                  Z7 = (EM3672:Z9 - 80) * 4 + 808 + Z9
                END IF
                EM3674:Z9 = EM0:Z7
                IF EM3674:Z9 >= 7 THEN
                  IF EM3674:Z9 <= 10 THEN
                    IF EM3674:Z9 = 9 THEN
                      ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                      ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                      Z6 = (EM1:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = 8
                        EM3676:Z9 = 1
                      END IF
                      Z6 = (EM2:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = 8
                        EM3676:Z9 = 1
                      END IF
                    ELSE IF EM3674:Z9 = 10 THEN
                      ' **値は スロット + 1。** 0 は main でスロットを持たない
                      IF EM1:Z7 > 0 THEN
                        Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                        IF EM1:Z6 = 0 THEN
                          EM1:Z6 = 10
                          EM3676:Z9 = 1
                        END IF
                      END IF
                    ELSE
                      ' 文字列と配列。値がそのままスロット番号
                      Z6 = (EM1:Z7) * 52 + 2008 + Z9
                      IF EM1:Z6 = 0 THEN
                        EM1:Z6 = EM3674:Z9
                        EM3676:Z9 = 1
                      END IF
                    END IF
                  END IF
                END IF
              NEXT
              ' 確保してレジスタへ書くまでのスロット。**まだどこからも届かない**
              ' 1 つの命令で 2 つ取るところ (ハッシュ) で要る。0 なら無し
              IF EM3675:Z9 > 0 THEN
                Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
              END IF
              ' 到達性を伝播する。印の付いたスロットの中身も辿る
              ' **印が増えなくなったら空回りします。** 最悪 32 周
              ' **BREAK は使いません。** 命令ループの BREAK と違って内側の FOR を
              ' 抜けるだけですが、エラーの BREAK と見分けが付かなくなります
              ' ルート走査で印が付いているので 1 周は回す
              EM3676:Z9 = 1
              FOR EM3679:Z9 = 0 TO 31
                IF EM3676:Z9 <> 0 THEN
                  EM3676:Z9 = 0
                  FOR EM3672:Z9 = 0 TO 31
                    Z6 = EM3672:Z9 * 52 + 2008 + Z9
                    ' 見出しのアドレスを覚える。印を付けるときに Z6 が壊れる
                    EM3680:Z9 = Z6
                    EM3674:Z9 = EM1:Z6
                    IF EM3674:Z9 <> 0 THEN
                      IF EM2:Z6 = 0 THEN
                        EM2:Z6 = 1
                        ' 文字列の中身はバイト列。辿らない
                        IF EM3674:Z9 <> 7 THEN
                          IF EM3674:Z9 = 10 THEN
                            ' インスタンス変数は容量いっぱい使う
                            EM3682:Z9 = 12
                          ELSE
                            ' 配列は要素数まで
                            EM3682:Z9 = EM0:Z6
                          END IF
                          ' **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットと
                          ' して読むと、前に入っていた文字列のバイト列が型タグに見え、
                          ' プールの外へ印を書きに行くことがある
                          ' 符号なしなので 0 - 1 が 65535 になるのも同じ理由で避ける
                          IF EM3682:Z9 > 0 THEN
                            EM3682:Z9 = EM3682:Z9 - 1
                            ' 要素は値スロットの並び。ルートと同じ手で印を付ける
                            FOR EM3681:Z9 = 0 TO EM3682:Z9
                              Z7 = EM3680:Z9 + 4 + EM3681:Z9 * 4
                              EM3674:Z9 = EM0:Z7
                              IF EM3674:Z9 >= 7 THEN
                                IF EM3674:Z9 <= 10 THEN
                                  IF EM3674:Z9 = 9 THEN
                                    ' 鍵と値で 2 本。**どちらも配列として印を付ける。**
                                    ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                                    Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = 8
                                      EM3676:Z9 = 1
                                    END IF
                                    Z6 = (EM2:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = 8
                                      EM3676:Z9 = 1
                                    END IF
                                  ELSE IF EM3674:Z9 = 10 THEN
                                    ' **値は スロット + 1。** 0 は main でスロットを持たない
                                    IF EM1:Z7 > 0 THEN
                                      Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                                      IF EM1:Z6 = 0 THEN
                                        EM1:Z6 = 10
                                        EM3676:Z9 = 1
                                      END IF
                                    END IF
                                  ELSE
                                    ' 文字列と配列。値がそのままスロット番号
                                    Z6 = (EM1:Z7) * 52 + 2008 + Z9
                                    IF EM1:Z6 = 0 THEN
                                      EM1:Z6 = EM3674:Z9
                                      EM3676:Z9 = 1
                                    END IF
                                  END IF
                                END IF
                              END IF
                            NEXT
                          END IF
                        END IF
                      END IF
                    END IF
                  NEXT
                END IF
              NEXT
              ' 印の付かなかったスロットを探す。32 なら見つからなかった印
              EM3673:Z9 = 32
              FOR EM3672:Z9 = 0 TO 31
                IF EM3673:Z9 >= 32 THEN
                  Z6 = EM3672:Z9 * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM3673:Z9 = EM3672:Z9
                  END IF
                END IF
              NEXT
              ' 借りた Z を返す
              Z6 = EM3677:Z9
              Z7 = EM3678:Z9
              IF EM3673:Z9 >= 32 THEN
                ' 全スロットが生きている。回収しても足りない
                EM1:Z9 = 3
                EM2:Z9 = 10
                BREAK
              END IF
            ELSE
              ' まだ順に渡せる
              EM3673:Z9 = EM39:Z9
            END IF
            Z4 = EM1.L:Z1
            Z4 = Z4 * 52 + 2008 + Z9
            EM16.L:Z9 = EM0:Z4
            Z5 = EM1.L:Z2
            Z5 = Z5 * 52 + 2008 + Z9
            EM18.L:Z9 = EM0:Z5
            ' 1 スロットに収まること
            Z6 = EM16.L:Z9 + EM18.L:Z9
            IF Z6 > 96 THEN
              EM1:Z9 = 3
              EM2:Z9 = 10
              BREAK
            END IF
            ' 新しいスロットへ左側をワード単位で写す。並びが同じなのでそのまま
            Z3 = EM3673:Z9 * 52 + 2008 + Z9
            EM0:Z3 = EM16.L:Z9
            EM45:Z9 = EM16.L:Z9 + 1
            EM45:Z9 = EM45:Z9 / 2
            IF EM45:Z9 > 0 THEN
              EM45:Z9 = EM45:Z9 - 1
              FOR EM42:Z9 = 0 TO EM45:Z9
                Z7 = EM42:Z9 + Z4 + 4
                Z8 = EM42:Z9 + Z3 + 4
                EM0:Z8 = EM0:Z7
              NEXT
            END IF
            ' 右側を継ぎ足す。Z4 を継ぎ足す元にする
            Z4 = Z5
            IF EM18.L:Z9 > 0 THEN
              Z6 = EM18.L:Z9
              Z6 = Z6 - 1
              FOR Z5 = 0 TO Z6
                ' 継ぎ足す元のバイトを 1 つ取り出す
                Z7 = Z5 / 2
                Z8 = Z7 + Z4 + 4
                Z8 = EM0:Z8
                Z7 = Z7 * 2
                IF Z5 = Z7 THEN
                  ' 偶数の位置は上位バイト
                  Z8 = Z8 / 256
                ELSE
                  ' 奇数の位置は下位バイト
                  Z7 = Z8 / 256
                  Z8 = Z8 - Z7 * 256
                END IF
                ' 書き先の位置 (継ぎ足す先の長さ + 何バイト目か)
                EM44:Z9 = EM16.L:Z9 + Z5
                Z7 = EM44:Z9
                Z7 = Z7 / 2
                Z7 = Z7 + Z3 + 4
                EM45:Z9 = EM44:Z9 / 2
                EM45:Z9 = EM45:Z9 * 2
                IF EM44:Z9 = EM45:Z9 THEN
                  ' 偶数。下位バイトは 0 にしておく (次のバイトか詰め物が入る)
                  EM0:Z7 = Z8 * 256
                ELSE
                  ' 奇数。上位バイトを残して下位に入れる
                  EM45:Z9 = EM0:Z7
                  EM45:Z9 = EM45:Z9 / 256
                  EM0:Z7 = EM45:Z9 * 256 + Z8
                END IF
              NEXT
            END IF
            ' 長さを更新する
            EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
            EM0:Z3 = EM16.L:Z9
            EM1.L:Z1 = EM3673:Z9   ' スロット番号
            EM0:Z1 = 7
            ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
            IF EM3673:Z9 = EM39:Z9 THEN
              EM39:Z9 = EM39:Z9 + 1
            END IF
          ELSE
            EM1.L:Z1 = EM1.L:Z1 + EM1.L:Z2
            EM0:Z1 = 4
          END IF
        END IF
      END IF

    ELSE
      ' 未知のオペコード: エラー
      EM1:Z9 = 3
      EM2:Z9 = EM6:Z9
      BREAK

    END IF

    ' バイトコード範囲チェック
    IF EM0:Z9 >= EM10:Z9 THEN
      EM1:Z9 = 2
      BREAK
    END IF

  NEXT
END IF
