          IF EM0:Z1 = 5 THEN
            ' Ruby の round は 0 から遠い方へ丸める (2.5→3, -2.5→-3)
            IF EM1.F:Z1 >= 0 THEN
              EM18.F:Z9 = EM1.F:Z1 + 0.5
            ELSE
              EM18.F:Z9 = EM1.F:Z1 - 0.5
            END IF
            EM16.L:Z9 = EM18.F:Z9
            EM1.L:Z1 = EM16.L:Z9
