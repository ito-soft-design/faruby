          END IF
          EM18.L:Z9 = EM1.L:Z2   ' 桁数
          IF EM18.L:Z9 < 0 THEN
            ' 桁数が負なら向きが逆 (Ruby と同じ)
            EM18.L:Z9 = 0 - EM18.L:Z9
