' =======================================
' faRuby VM - オペコード 0x28 - 0x3C
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   定義: tools/opcode_table.rb
'   生成: tools/kvs_generator.rb  (rake vm_core)
'   編集した場合 test_kvs_generator.rb が失敗します。
'
' ラダーでの置き場所: 内側 FOR の中 (5 番目の群)
' 並び順と役割は vm_02_prologue.kvs の先頭にあります。

' 担当外の番号はここで素通りする。**判定はループの外に置く。**
' 見るのは上限だけ。40 未満は手前の群が実行して
' 65535 で潰しているので、ここには届かない
IF EM54:Z9 <= 60 THEN

  ' 後ろの群がもう一度実行しないように潰す。**本体より先に置く。**
  ' 本体は途中で BREAK することがあり、後ろに置くと通らない
  EM54:Z9 = 65535

  ' BREAK の相手 (1 回だけ回る)。抜けるとこのスクリプトが終わる
  FOR EM20:Z9 = 1 TO 1

    IF EM6:Z9 = 40 THEN
      ' OP_JMPNIL (BS): if R[a] が nil then PC += signed16(b)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 16bit big-endian: hi byte, lo byte
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM8:Z9 = Z3 * 256 + Z4
      IF EM8:Z9 >= 32768 THEN
        EM8:Z9 = EM8:Z9 - 65536
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 1 THEN
        EM0:Z9 = EM0:Z9 + EM8:Z9
      END IF

    ELSE IF EM6:Z9 = 47 THEN
      ' OP_SEND (BBB): R[a] = R[a].symbols[b](R[a+1]..)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM9:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' シンボル表参照 (4ワード/エントリ)
      Z3 = EM8:Z9 * 4 + EM35:Z9
      Z5 = ZF98304:Z3   ' メソッド番号
      Z7 = Z3 + 2
      Z8 = ZF98304:Z7   ' 引数の数
      Z7 = Z3 + 3
      Z4 = ZF98304:Z7   ' シンボル種別
      IF Z4 <> 2 THEN
        ' メソッド名でないシンボルへの呼び出し
        EM1:Z9 = 3
        EM2:Z9 = 3
        BREAK
      END IF
      Z3 = Z3 + 1
      Z6 = ZF98304:Z3   ' ユーザー定義メソッドID
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF Z5 <> 0 THEN
        ' 組み込みメソッド。フレームを積まずその場で計算する
        ' new だけは引数の数を突き合わせない。クラスごとに違うので
        ' initialize の OP_ENTER に任せる
        IF Z5 <> 28 THEN
          IF EM9:Z9 <> Z8 THEN
            ' 引数の数が定義と違う
            ' オペランドは位置引数とキーワード引数の数を4ビットずつ詰めたもの。
            ' 普通の呼び出しでは引数の数と一致し、スプラットやキーワード付きは弾かれる
            EM1:Z9 = 3
            EM2:Z9 = 3
            BREAK
          END IF
        END IF
        Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
        ' メソッド番号の区分ごとにレシーバのタグの範囲を見る (METHOD_RECEIVER_GROUPS)
        ' 3 未満 (!= と !) はどの型でも呼べる
        IF Z5 >= 3 THEN
          IF Z5 <= 17 THEN
            ' 数値 (タグ 4-5)
            IF EM0:Z1 < 4 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 5 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 19 THEN
            ' 文字列・配列・ハッシュ (タグ 7-9)
            IF EM0:Z1 < 7 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 9 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 20 THEN
            ' 整数・文字列・配列 (タグ 4-8)
            IF EM0:Z1 < 4 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 8 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 21 THEN
            ' 配列・ハッシュ (タグ 8-9)
            IF EM0:Z1 < 8 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 9 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 22 THEN
            ' 配列 (タグ 8)
            IF EM0:Z1 <> 8 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 25 THEN
            ' ハッシュ (タグ 9)
            IF EM0:Z1 <> 9 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 26 THEN
            ' デバイス参照 (タグ 11)
            IF EM0:Z1 <> 11 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 27 THEN
            ' self (タグ 10)
            IF EM0:Z1 <> 10 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE IF Z5 <= 28 THEN
            ' クラス (タグ 13-14)
            IF EM0:Z1 < 13 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 14 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE
            ' 配列・ハッシュ (タグ 8-9)
            IF EM0:Z1 < 8 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            IF EM0:Z1 > 9 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          END IF
        END IF
        IF Z5 = 1 THEN
          ' !=
          ' 数値は型が違っても値で比べる (Ruby では 1 == 1.0 は真)
          ' 数値以外は型と値の両方が一致したときだけ真 (nil == false は偽)
          ' 結果を R[a] に書くと比較元が壊れるため、先に判定してから代入する
          EM16:Z9 = 0
          ' シンボルや配列のタグは 4 より大きいので、上限も見ないと
          ' 番号やスロット番号が数値として比べられてしまう
          Z3 = 0
          IF EM0:Z1 >= 4 THEN
            IF EM0:Z1 <= 5 THEN
              Z3 = 1
            END IF
          END IF
          Z4 = 0
          IF EM0:Z2 >= 4 THEN
            IF EM0:Z2 <= 5 THEN
              Z4 = 1
            END IF
          END IF
          IF Z3 = 1 THEN
            IF Z4 = 1 THEN
              IF EM0:Z1 = 5 THEN
                IF EM0:Z2 = 5 THEN
                  IF EM1.F:Z1 = EM1.F:Z2 THEN
                    EM16:Z9 = 1
                  END IF
                ELSE
                  IF EM1.F:Z1 = EM1.L:Z2 THEN
                    EM16:Z9 = 1
                  END IF
                END IF
              ELSE
                IF EM0:Z2 = 5 THEN
                  IF EM1.L:Z1 = EM1.F:Z2 THEN
                    EM16:Z9 = 1
                  END IF
                ELSE
                  IF EM1.L:Z1 = EM1.L:Z2 THEN
                    EM16:Z9 = 1
                  END IF
                END IF
              END IF
            ELSE
              ' 数値と非数値は等しくない
            END IF
          ELSE
            IF EM0:Z1 = EM0:Z2 THEN
              IF EM0:Z1 = 7 THEN
                ' 文字列は中身で比べる。スロット番号ではない
                ' Z3 を借りる。返すまでの間に呼ぶ側の値を壊さないため
                EM46:Z9 = Z3
                EM43:Z9 = 0
                Z3 = EM1.L:Z1
                Z3 = Z3 * 52 + 2008 + Z9
                EM44:Z9 = EM0:Z3   ' バイト数
                Z3 = EM1.L:Z2
                Z3 = Z3 * 52 + 2008 + Z9
                IF EM44:Z9 = EM0:Z3 THEN
                  ' バイト数が同じ。ここから中身を見る
                  EM43:Z9 = 1
                  EM45:Z9 = EM44:Z9 + 1
                  EM45:Z9 = EM45:Z9 / 2   ' ワード数
                  IF EM45:Z9 > 0 THEN
                    EM45:Z9 = EM45:Z9 - 1
                    FOR EM42:Z9 = 0 TO EM45:Z9
                      Z3 = EM1.L:Z1
                      Z3 = Z3 * 52 + 2008 + Z9
                      Z3 = EM42:Z9 + Z3 + 4
                      EM44:Z9 = EM0:Z3
                      Z3 = EM1.L:Z2
                      Z3 = Z3 * 52 + 2008 + Z9
                      Z3 = EM42:Z9 + Z3 + 4
                      IF EM44:Z9 <> EM0:Z3 THEN
                        EM43:Z9 = 0
                      END IF
                    NEXT
                  END IF
                END IF
                ' 借りた Z3 を返す
                Z3 = EM46:Z9
                IF EM43:Z9 = 1 THEN
                  EM16:Z9 = 1
                END IF
              ELSE
                IF EM1.L:Z1 = EM1.L:Z2 THEN
                  EM16:Z9 = 1
                END IF
              END IF
            END IF
          END IF
          IF EM16:Z9 = 1 THEN
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          ELSE
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          END IF
        ELSE IF Z5 = 2 THEN
          ' !
          IF EM0:Z1 > 2 THEN
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          ELSE
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          END IF
        ELSE IF Z5 = 3 THEN
          ' %
          ' 整数どうしのみ。実数の % は未対応
          IF EM0:Z2 = 4 THEN
            IF EM0:Z1 = 4 THEN
              IF EM1.L:Z2 <> 0 THEN
                EM16.L:Z9 = EM1.L:Z1       ' 被除数を退避
                EM1.L:Z1 = EM1.L:Z1 / EM1.L:Z2   ' 0方向へ切り捨てた商
                EM18.L:Z9 = EM16.L:Z9 - EM1.L:Z1 * EM1.L:Z2   ' 余り
                IF EM18.L:Z9 <> 0 THEN
                  ' 符号が違うときだけ除数を足して符号を合わせる
                  IF EM16.L:Z9 < 0 THEN
                    IF EM1.L:Z2 > 0 THEN
                      EM18.L:Z9 = EM18.L:Z9 + EM1.L:Z2
                    END IF
                  ELSE
                    IF EM1.L:Z2 < 0 THEN
                      EM18.L:Z9 = EM18.L:Z9 + EM1.L:Z2
                    END IF
                  END IF
                END IF
                EM1.L:Z1 = EM18.L:Z9
                EM0:Z1 = 4
              ELSE
                EM1:Z9 = 3
                EM2:Z9 = 1
                BREAK
              END IF
            ELSE
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
          ELSE
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
        ELSE IF Z5 = 4 THEN
          ' abs
          IF EM0:Z1 = 5 THEN
            IF EM1.F:Z1 < 0 THEN
              EM1.F:Z1 = 0 - EM1.F:Z1
            END IF
          ELSE
            IF EM1.L:Z1 < 0 THEN
              EM1.L:Z1 = 0 - EM1.L:Z1
            END IF
          END IF
        ELSE IF Z5 = 5 THEN
          ' to_i
          IF EM0:Z1 = 5 THEN
            ' 0 方向へ切り捨て (Ruby の Float#to_i と同じ)
            EM16.L:Z9 = EM1.F:Z1
            EM1.L:Z1 = EM16.L:Z9
            EM0:Z1 = 4
          END IF
        ELSE IF Z5 = 6 THEN
          ' to_f
          IF EM0:Z1 = 4 THEN
            ' 整数→実数。同じスロットを .L で読んで .F で書くためスクラッチを挟む
            EM18.F:Z9 = EM1.L:Z1
            EM1.F:Z1 = EM18.F:Z9
            EM0:Z1 = 5
          END IF
        ELSE IF Z5 = 7 THEN
          ' floor
          IF EM0:Z1 = 5 THEN
            ' KV の実数→整数は 0 方向へ切り捨て。負で端数があるときだけ 1 引く
            EM16.L:Z9 = EM1.F:Z1
            IF EM1.F:Z1 < 0 THEN
              IF EM16.L:Z9 <> EM1.F:Z1 THEN
                EM16.L:Z9 = EM16.L:Z9 - 1
              END IF
            END IF
            EM1.L:Z1 = EM16.L:Z9
            EM0:Z1 = 4
          END IF
        ELSE IF Z5 = 8 THEN
