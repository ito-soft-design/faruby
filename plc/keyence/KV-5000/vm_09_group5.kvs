            EM0:Z1 = 4
          ELSE IF EM0:Z1 = 7 THEN
            ' 文字列は中身を継ぎ足す
            IF EM0:Z2 <> 7 THEN
              EM1:Z9 = 3
              EM2:Z9 = 4
              BREAK
            END IF
            Z3 = EM1.L:Z1
            Z3 = Z3 * 52 + 2008 + Z9
            Z4 = EM1.L:Z2
            Z4 = Z4 * 52 + 2008 + Z9
            EM16.L:Z9 = EM0:Z3
            EM18.L:Z9 = EM0:Z4
            ' 1 スロットに収まること
            Z5 = EM16.L:Z9 + EM18.L:Z9
