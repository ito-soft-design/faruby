                  EM1.L:Z1 = EM1.L:Z1 - 1   ' ~x = -x - 1
                ELSE
                  EM1.L:Z1 = SRA(EM1.L:Z1, EM18.L:Z9)
                END IF
              END IF
            ELSE
              IF EM18.L:Z9 >= 32 THEN
                ' 全部ずれる。左は 0、右は符号で埋まる
                EM1.L:Z1 = 0
              ELSE
                EM1.L:Z1 = SLA(EM1.L:Z1, EM18.L:Z9)
              END IF
