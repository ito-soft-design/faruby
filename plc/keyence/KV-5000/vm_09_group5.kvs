          END IF
        ELSE IF Z5 = 9 THEN
          ' -@
          IF EM0:Z1 = 5 THEN
            EM1.F:Z1 = 0 - EM1.F:Z1
          ELSE
            EM1.L:Z1 = 0 - EM1.L:Z1
          END IF
        ELSE IF Z5 = 10 THEN
          ' +@
          ' +x は何もしない (Ruby と同じ)
        ELSE IF Z5 = 13 THEN
          ' &
          IF EM0:Z1 <> 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
            BREAK
          END IF
          IF EM0:Z2 <> 4 THEN
            EM1:Z9 = 3
            EM2:Z9 = 4
