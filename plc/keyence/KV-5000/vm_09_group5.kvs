              EM1:Z9 = 3
              EM2:Z9 = 10
              BREAK
            END IF
            IF EM18.L:Z9 > 0 THEN
              Z6 = EM18.L:Z9
              Z6 = Z6 - 1
              FOR Z5 = 0 TO Z6
                ' 継ぎ足す元のバイトを 1 つ取り出す
                Z7 = Z5 / 2
                Z8 = Z7 + Z4 + 4
                Z8 = EM0:Z8
                Z7 = Z7 * 2
                IF Z5 = Z7 THEN
                  ' 偶数の位置は上位バイト
                  Z8 = Z8 / 256
                ELSE
                  ' 奇数の位置は下位バイト
                  Z7 = Z8 / 256
                  Z8 = Z8 - Z7 * 256
                END IF
                ' 書き先の位置 (継ぎ足す先の長さ + 何バイト目か)
                EM44:Z9 = EM16.L:Z9 + Z5
                Z7 = EM44:Z9
                Z7 = Z7 / 2
                Z7 = Z7 + Z3 + 4
                EM45:Z9 = EM44:Z9 / 2
                EM45:Z9 = EM45:Z9 * 2
                IF EM44:Z9 = EM45:Z9 THEN
                  ' 偶数。下位バイトは 0 にしておく (次のバイトか詰め物が入る)
                  EM0:Z7 = Z8 * 256
                ELSE
                  ' 奇数。上位バイトを残して下位に入れる
                  EM45:Z9 = EM0:Z7
                  EM45:Z9 = EM45:Z9 / 256
                  EM0:Z7 = EM45:Z9 * 256 + Z8
                END IF
              NEXT
            END IF
            ' 長さを更新する
            EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
            EM0:Z3 = EM16.L:Z9
          ELSE IF EM0:Z1 = 8 THEN
            ' スロットの見出し。R[a] を書き換える前に読む
            Z4 = EM1.L:Z1
            Z4 = Z4 * 52 + 2008 + Z9
            EM18.L:Z9 = EM0:Z4   ' 要素数
            IF EM18.L:Z9 >= 12 THEN
