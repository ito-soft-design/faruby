          END IF
        NEXT
        ' 印の付かなかったスロットを探す。32 なら見つからなかった印
        EM3673:Z9 = 32
        FOR EM3672:Z9 = 0 TO 31
          IF EM3673:Z9 >= 32 THEN
            Z6 = EM3672:Z9 * 52 + 2008 + Z9
            IF EM1:Z6 = 0 THEN
              EM3673:Z9 = EM3672:Z9
            END IF
          END IF
        NEXT
        ' 借りた Z を返す
        Z6 = EM3677:Z9
        Z7 = EM3678:Z9
        IF EM3673:Z9 >= 32 THEN
          ' 全スロットが生きている。回収しても足りない
          EM1:Z9 = 3
          EM2:Z9 = 10
          BREAK
        END IF
      ELSE
        ' まだ順に渡せる
        EM3673:Z9 = EM39:Z9
      END IF
      Z3 = EM3673:Z9 * 52 + 2008 + Z9
      EM0:Z3 = 0
      ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
      IF EM3673:Z9 = EM39:Z9 THEN
        EM39:Z9 = EM39:Z9 + 1
      END IF
      ' 組を写す。組の数 0 (空ハッシュ) では引き算もしない
      IF EM8:Z9 > 0 THEN
        Z4 = EM8:Z9 - 1
        FOR Z5 = 0 TO Z4
          Z6 = (EM7:Z9 + Z5 * 2) * 4 + EM32:Z9 + Z9   ' 鍵
          Z7 = Z5 * 4 + Z2 + 4
          EM1.L:Z7 = EM1.L:Z6
          EM0:Z7 = EM0:Z6
          Z6 = (EM7:Z9 + Z5 * 2 + 1) * 4 + EM32:Z9 + Z9   ' 値
          Z7 = Z5 * 4 + Z3 + 4
          EM1.L:Z7 = EM1.L:Z6
          EM0:Z7 = EM0:Z6
        NEXT
      END IF
      ' 写し終えたので要素数を入れる
      EM0:Z2 = EM8:Z9
      EM0:Z3 = EM8:Z9
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      ' 鍵の配列の番号は守っていたところから戻す (スロット + 1)
      EM1:Z1 = EM3675:Z9 - 1   ' 鍵の配列
      EM2:Z1 = EM3673:Z9   ' 値の配列
      EM0:Z1 = 9
      ' レジスタから届くようになったので守りを解く
      EM3675:Z9 = 0

    ELSE IF EM6:Z9 = 87 THEN
      ' OP_BLOCK (BB): R[a] = 子 irep b から作ったブロック
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 実行中の irep の最初の子の番号に、親から見た子の番号を足す
      Z3 = EM30:Z9 * 8 + EM38:Z9
      Z4 = Z3 + 5
      EM16:Z9 = ZF98304:Z4 + EM8:Z9
      IF EM16:Z9 >= EM36:Z9 THEN
        ' 指す先の irep が無い
        EM1:Z9 = 3
        EM2:Z9 = 7
        BREAK
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1:Z1 = EM16:Z9   ' 本体の irep
      Z4 = 65535
      IF EM31:Z9 > 0 THEN
        Z4 = EM31:Z9 - 1
      END IF
      EM2:Z1 = Z4   ' 定義元のフレーム
      EM0:Z1 = 12

    ELSE IF EM6:Z9 = 88 THEN
      ' OP_METHOD (BB): R[a] = 子 irep b への参照
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 実行中の irep の最初の子の番号に、親から見た子の番号を足す
      Z3 = EM30:Z9 * 8 + EM38:Z9
      Z4 = Z3 + 5
      EM16:Z9 = ZF98304:Z4 + EM8:Z9
      IF EM16:Z9 >= EM36:Z9 THEN
        ' 指す先の irep が無い
        EM1:Z9 = 3
        EM2:Z9 = 7
        BREAK
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1:Z1 = EM16:Z9   ' 本体の irep
      EM2:Z1 = 65535   ' メソッドは外側を見ない
      EM0:Z1 = 12

    ELSE IF EM6:Z9 = 92 THEN
      ' OP_CLASS (BB): R[a] = クラス symbols[b]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' シンボル表参照 (4ワード/エントリ)
      Z3 = EM8:Z9 * 4 + EM35:Z9
      Z5 = ZF98304:Z3   ' メソッド番号
      Z7 = Z3 + 2
      Z8 = ZF98304:Z7   ' 引数の数
      Z7 = Z3 + 3
      Z4 = ZF98304:Z7   ' シンボル種別
      IF Z4 <> 6 THEN
        ' クラス名でないシンボルを定数として読もうとした
        EM1:Z9 = 3
        EM2:Z9 = 3
        BREAK
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1.L:Z1 = Z5   ' クラス番号
      EM0:Z1 = 13

    ELSE
      ' 未知のオペコード: エラー
      EM1:Z9 = 3
      EM2:Z9 = EM6:Z9
      BREAK

    END IF

    ' バイトコード範囲チェック
    IF EM0:Z9 >= EM10:Z9 THEN
      EM1:Z9 = 2
      BREAK
    END IF

  NEXT
END IF
