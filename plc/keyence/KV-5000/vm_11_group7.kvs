        IF EM3675:Z9 > 0 THEN
          Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
          IF EM1:Z6 = 0 THEN
            EM1:Z6 = 8
            EM3676:Z9 = 1
          END IF
