' =======================================
' faRuby VM - オペコード 0x3F - 0x47
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   定義: tools/opcode_table.rb
'   生成: tools/kvs_generator.rb  (rake vm_core)
'   編集した場合 test_kvs_generator.rb が失敗します。
'
' ラダーでの置き場所: 内側 FOR の中 (6 番目の群)
' 並び順と役割は vm_02_prologue.kvs の先頭にあります。

' 担当外の番号はここで素通りする。**判定はループの外に置く。**
' 見るのは上限だけ。63 未満は手前の群が実行して
' 65535 で潰しているので、ここには届かない
IF EM54:Z9 <= 71 THEN

  ' 後ろの群がもう一度実行しないように潰す。**本体より先に置く。**
  ' 本体は途中で BREAK することがあり、後ろに置くと通らない
  EM54:Z9 = 65535

  ' BREAK の相手 (1 回だけ回る)。抜けるとこのスクリプトが終わる
  FOR EM20:Z9 = 1 TO 1

    IF EM6:Z9 = 63 THEN
      ' OP_SUBI (BB): R[a] = R[a] - b
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        EM1.F:Z1 = EM1.F:Z1 - EM8:Z9
        EM0:Z1 = 5
      ELSE
        EM1.L:Z1 = EM1.L:Z1 - EM8:Z9
        EM0:Z1 = 4
      END IF

    ELSE IF EM6:Z9 = 64 THEN
      ' OP_MUL (B): R[a] = R[a] * R[a+1]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          EM1.F:Z1 = EM1.F:Z1 * EM1.F:Z2
          EM0:Z1 = 5
        ELSE
          EM1.F:Z1 = EM1.F:Z1 * EM1.L:Z2
          EM0:Z1 = 5
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          EM1.F:Z1 = EM1.L:Z1 * EM1.F:Z2
          EM0:Z1 = 5
        ELSE
          EM1.L:Z1 = EM1.L:Z1 * EM1.L:Z2
          EM0:Z1 = 4
        END IF
      END IF

    ELSE IF EM6:Z9 = 65 THEN
      ' OP_DIV (B): R[a] = R[a] / R[a+1]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z2 <> 0 THEN
            EM1.F:Z1 = EM1.F:Z1 / EM1.F:Z2
          ELSE
            ' 0 除算。KV の / は CR2012 を出すため実行せず、
            ' IEEE754 の無限大 / 非数のビット列を直接置く
            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
            IF EM1.F:Z1 > 0 THEN
              EM16:Z9 = 32640   ' +Infinity
            END IF
            IF EM1.F:Z1 < 0 THEN
              EM16:Z9 = 65408   ' -Infinity
            END IF
            EM1:Z1 = 0
            EM2:Z1 = EM16:Z9
          END IF
          EM0:Z1 = 5
        ELSE
          IF EM1.L:Z2 <> 0 THEN
            EM1.F:Z1 = EM1.F:Z1 / EM1.L:Z2
          ELSE
            ' 0 除算。KV の / は CR2012 を出すため実行せず、
            ' IEEE754 の無限大 / 非数のビット列を直接置く
            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
            IF EM1.F:Z1 > 0 THEN
              EM16:Z9 = 32640   ' +Infinity
            END IF
            IF EM1.F:Z1 < 0 THEN
              EM16:Z9 = 65408   ' -Infinity
            END IF
            EM1:Z1 = 0
            EM2:Z1 = EM16:Z9
          END IF
          EM0:Z1 = 5
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z2 <> 0 THEN
            EM1.F:Z1 = EM1.L:Z1 / EM1.F:Z2
          ELSE
            ' 0 除算。KV の / は CR2012 を出すため実行せず、
            ' IEEE754 の無限大 / 非数のビット列を直接置く
            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
            IF EM1.L:Z1 > 0 THEN
              EM16:Z9 = 32640   ' +Infinity
            END IF
            IF EM1.L:Z1 < 0 THEN
              EM16:Z9 = 65408   ' -Infinity
            END IF
            EM1:Z1 = 0
            EM2:Z1 = EM16:Z9
          END IF
          EM0:Z1 = 5
        ELSE
          IF EM1.L:Z2 <> 0 THEN
            ' Ruby の整数除算は切り下げ。KV の / は0方向へ切り捨てるため補正する
            EM16.L:Z9 = EM1.L:Z1       ' 被除数を退避
            EM1.L:Z1 = EM1.L:Z1 / EM1.L:Z2
            EM18.L:Z9 = EM16.L:Z9 - EM1.L:Z1 * EM1.L:Z2   ' 余り
            IF EM18.L:Z9 <> 0 THEN
              ' 符号が異なるときだけ切り下げになる
              IF EM16.L:Z9 < 0 THEN
                IF EM1.L:Z2 > 0 THEN
                  EM1.L:Z1 = EM1.L:Z1 - 1
                END IF
              ELSE
                IF EM1.L:Z2 < 0 THEN
                  EM1.L:Z1 = EM1.L:Z1 - 1
                END IF
              END IF
            END IF
            EM0:Z1 = 4
          ELSE
            EM1:Z9 = 3
            EM2:Z9 = 1
            BREAK
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 66 THEN
      ' OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      ' 数値は型が違っても値で比べる (Ruby では 1 == 1.0 は真)
      ' 数値以外は型と値の両方が一致したときだけ真 (nil == false は偽)
      ' 結果を R[a] に書くと比較元が壊れるため、先に判定してから代入する
      EM16:Z9 = 0
      ' シンボルや配列のタグは 4 より大きいので、上限も見ないと
      ' 番号やスロット番号が数値として比べられてしまう
      Z3 = 0
      IF EM0:Z1 >= 4 THEN
        IF EM0:Z1 <= 5 THEN
          Z3 = 1
        END IF
      END IF
      Z4 = 0
      IF EM0:Z2 >= 4 THEN
        IF EM0:Z2 <= 5 THEN
          Z4 = 1
        END IF
      END IF
      IF Z3 = 1 THEN
        IF Z4 = 1 THEN
          IF EM0:Z1 = 5 THEN
            IF EM0:Z2 = 5 THEN
              IF EM1.F:Z1 = EM1.F:Z2 THEN
                EM16:Z9 = 1
              END IF
            ELSE
              IF EM1.F:Z1 = EM1.L:Z2 THEN
                EM16:Z9 = 1
              END IF
            END IF
          ELSE
            IF EM0:Z2 = 5 THEN
              IF EM1.L:Z1 = EM1.F:Z2 THEN
                EM16:Z9 = 1
              END IF
            ELSE
              IF EM1.L:Z1 = EM1.L:Z2 THEN
                EM16:Z9 = 1
              END IF
            END IF
          END IF
        ELSE
          ' 数値と非数値は等しくない
        END IF
      ELSE
        IF EM0:Z1 = EM0:Z2 THEN
          IF EM0:Z1 = 7 THEN
            ' 文字列は中身で比べる。スロット番号ではない
            ' Z3 を借りる。返すまでの間に呼ぶ側の値を壊さないため
            EM46:Z9 = Z3
            EM43:Z9 = 0
            Z3 = EM1.L:Z1
            Z3 = Z3 * 52 + 2008 + Z9
            EM44:Z9 = EM0:Z3   ' バイト数
            Z3 = EM1.L:Z2
            Z3 = Z3 * 52 + 2008 + Z9
            IF EM44:Z9 = EM0:Z3 THEN
              ' バイト数が同じ。ここから中身を見る
              EM43:Z9 = 1
              EM45:Z9 = EM44:Z9 + 1
              EM45:Z9 = EM45:Z9 / 2   ' ワード数
              IF EM45:Z9 > 0 THEN
                EM45:Z9 = EM45:Z9 - 1
                FOR EM42:Z9 = 0 TO EM45:Z9
                  Z3 = EM1.L:Z1
                  Z3 = Z3 * 52 + 2008 + Z9
                  Z3 = EM42:Z9 + Z3 + 4
                  EM44:Z9 = EM0:Z3
                  Z3 = EM1.L:Z2
                  Z3 = Z3 * 52 + 2008 + Z9
                  Z3 = EM42:Z9 + Z3 + 4
                  IF EM44:Z9 <> EM0:Z3 THEN
                    EM43:Z9 = 0
                  END IF
                NEXT
              END IF
            END IF
            ' 借りた Z3 を返す
            Z3 = EM46:Z9
            IF EM43:Z9 = 1 THEN
              EM16:Z9 = 1
            END IF
          ELSE
            IF EM1.L:Z1 = EM1.L:Z2 THEN
              EM16:Z9 = 1
            END IF
          END IF
        END IF
      END IF
      IF EM16:Z9 = 1 THEN
        EM1.L:Z1 = 1
        EM0:Z1 = 3
      ELSE
        EM1.L:Z1 = 0
        EM0:Z1 = 2
      END IF

    ELSE IF EM6:Z9 = 67 THEN
      ' OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z1 < EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.F:Z1 < EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          IF EM1.L:Z1 < EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.L:Z1 < EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 68 THEN
      ' OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z1 <= EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.F:Z1 <= EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          IF EM1.L:Z1 <= EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.L:Z1 <= EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 69 THEN
      ' OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z1 > EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.F:Z1 > EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          IF EM1.L:Z1 > EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.L:Z1 > EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 70 THEN
      ' OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 5 THEN
        IF EM0:Z2 = 5 THEN
          IF EM1.F:Z1 >= EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.F:Z1 >= EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      ELSE
        IF EM0:Z2 = 5 THEN
          IF EM1.L:Z1 >= EM1.F:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        ELSE
          IF EM1.L:Z1 >= EM1.L:Z2 THEN
            EM1.L:Z1 = 1
            EM0:Z1 = 3
          ELSE
            EM1.L:Z1 = 0
            EM0:Z1 = 2
          END IF
        END IF
      END IF

    ELSE IF EM6:Z9 = 71 THEN
      ' OP_ARRAY (BB): R[a] = [R[a] .. R[a+b-1]]
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      EM8:Z9 = ZF98304:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' プールの空きスロットを決める
      IF EM39:Z9 >= 32 THEN
        ' 順に渡すぶんは尽きた。回収して空きを探す
        ' --- 回収 (使い切ったときだけ走る) ---
        ' アドレスを載せる Z を 2 本借りる。確保の場所ごとに空きが違う
        EM3677:Z9 = Z6
        EM3678:Z9 = Z7
        ' 印と走査済みを消す
        FOR EM3672:Z9 = 0 TO 31
          Z6 = EM3672:Z9 * 52 + 2008 + Z9
          EM1:Z6 = 0
          EM2:Z6 = 0
        NEXT
        ' ルート — レジスタ全 80 個と汎用グローバル 300 個
        ' **窓ではなく物理的な全レジスタ。** 外側のフレームの値も生きている
        FOR EM3672:Z9 = 0 TO 379
          IF EM3672:Z9 < 80 THEN
            Z7 = EM3672:Z9 * 4 + 72 + Z9
          ELSE
            Z7 = (EM3672:Z9 - 80) * 4 + 808 + Z9
          END IF
          EM3674:Z9 = EM0:Z7
          IF EM3674:Z9 >= 7 THEN
            IF EM3674:Z9 <= 10 THEN
              IF EM3674:Z9 = 9 THEN
                ' 鍵と値で 2 本。**どちらも配列として印を付ける** —
                ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
                Z6 = (EM2:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = 8
                  EM3676:Z9 = 1
                END IF
              ELSE IF EM3674:Z9 = 10 THEN
                ' **値は スロット + 1。** 0 は main でスロットを持たない
                IF EM1:Z7 > 0 THEN
                  Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                  IF EM1:Z6 = 0 THEN
                    EM1:Z6 = 10
                    EM3676:Z9 = 1
                  END IF
                END IF
              ELSE
                ' 文字列と配列。値がそのままスロット番号
                Z6 = (EM1:Z7) * 52 + 2008 + Z9
                IF EM1:Z6 = 0 THEN
                  EM1:Z6 = EM3674:Z9
                  EM3676:Z9 = 1
                END IF
              END IF
            END IF
          END IF
        NEXT
        ' 確保してレジスタへ書くまでのスロット。**まだどこからも届かない**
        ' 1 つの命令で 2 つ取るところ (ハッシュ) で要る。0 なら無し
        IF EM3675:Z9 > 0 THEN
          Z6 = (EM3675:Z9 - 1) * 52 + 2008 + Z9
          IF EM1:Z6 = 0 THEN
            EM1:Z6 = 8
            EM3676:Z9 = 1
          END IF
        END IF
        ' 到達性を伝播する。印の付いたスロットの中身も辿る
        ' **印が増えなくなったら空回りします。** 最悪 32 周
        ' **BREAK は使いません。** 命令ループの BREAK と違って内側の FOR を
        ' 抜けるだけですが、エラーの BREAK と見分けが付かなくなります
        ' ルート走査で印が付いているので 1 周は回す
        EM3676:Z9 = 1
        FOR EM3679:Z9 = 0 TO 31
          IF EM3676:Z9 <> 0 THEN
            EM3676:Z9 = 0
            FOR EM3672:Z9 = 0 TO 31
              Z6 = EM3672:Z9 * 52 + 2008 + Z9
              ' 見出しのアドレスを覚える。印を付けるときに Z6 が壊れる
              EM3680:Z9 = Z6
              EM3674:Z9 = EM1:Z6
              IF EM3674:Z9 <> 0 THEN
                IF EM2:Z6 = 0 THEN
                  EM2:Z6 = 1
                  ' 文字列の中身はバイト列。辿らない
                  IF EM3674:Z9 <> 7 THEN
                    IF EM3674:Z9 = 10 THEN
                      ' インスタンス変数は容量いっぱい使う
                      EM3682:Z9 = 12
                    ELSE
                      ' 配列は要素数まで
                      EM3682:Z9 = EM0:Z6
                    END IF
                    ' **要素数 0 では 1 つも見ない。** 書いていない要素を値スロットと
                    ' して読むと、前に入っていた文字列のバイト列が型タグに見え、
                    ' プールの外へ印を書きに行くことがある
                    ' 符号なしなので 0 - 1 が 65535 になるのも同じ理由で避ける
                    IF EM3682:Z9 > 0 THEN
                      EM3682:Z9 = EM3682:Z9 - 1
                      ' 要素は値スロットの並び。ルートと同じ手で印を付ける
                      FOR EM3681:Z9 = 0 TO EM3682:Z9
                        Z7 = EM3680:Z9 + 4 + EM3681:Z9 * 4
                        EM3674:Z9 = EM0:Z7
                        IF EM3674:Z9 >= 7 THEN
                          IF EM3674:Z9 <= 10 THEN
                            IF EM3674:Z9 = 9 THEN
                              ' 鍵と値で 2 本。**どちらも配列として印を付ける** —
                              ' 中身が値スロットの並びで、読み方はふつうの配列と同じ
                              Z6 = (EM1:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = 8
                                EM3676:Z9 = 1
                              END IF
                              Z6 = (EM2:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = 8
                                EM3676:Z9 = 1
                              END IF
                            ELSE IF EM3674:Z9 = 10 THEN
                              ' **値は スロット + 1。** 0 は main でスロットを持たない
                              IF EM1:Z7 > 0 THEN
                                Z6 = (EM1:Z7 - 1) * 52 + 2008 + Z9
                                IF EM1:Z6 = 0 THEN
                                  EM1:Z6 = 10
                                  EM3676:Z9 = 1
                                END IF
                              END IF
                            ELSE
                              ' 文字列と配列。値がそのままスロット番号
                              Z6 = (EM1:Z7) * 52 + 2008 + Z9
                              IF EM1:Z6 = 0 THEN
                                EM1:Z6 = EM3674:Z9
                                EM3676:Z9 = 1
                              END IF
                            END IF
                          END IF
                        END IF
                      NEXT
                    END IF
                  END IF
                END IF
              END IF
            NEXT
          END IF
        NEXT
        ' 印の付かなかったスロットを探す。32 なら見つからなかった印
        EM3673:Z9 = 32
        FOR EM3672:Z9 = 0 TO 31
          IF EM3673:Z9 >= 32 THEN
            Z6 = EM3672:Z9 * 52 + 2008 + Z9
            IF EM1:Z6 = 0 THEN
              EM3673:Z9 = EM3672:Z9
            END IF
          END IF
        NEXT
        ' 借りた Z を返す
        Z6 = EM3677:Z9
        Z7 = EM3678:Z9
        IF EM3673:Z9 >= 32 THEN
          ' 全スロットが生きている。回収しても足りない
          EM1:Z9 = 3
          EM2:Z9 = 10
          BREAK
        END IF
      ELSE
        ' まだ順に渡せる
        EM3673:Z9 = EM39:Z9
      END IF
      IF EM8:Z9 > 12 THEN
        ' 1 スロットの容量を超える要素数
        EM1:Z9 = 3
        EM2:Z9 = 10
        BREAK
      END IF
      ' スロットの見出し
      Z2 = EM3673:Z9 * 52 + 2008 + Z9
      EM0:Z2 = EM8:Z9
      ' 要素を写す。要素数 0 (空配列) では引き算もしない
      ' EM は16ビット符号なしのため、0 - 1 は 65535 になり得る
      IF EM8:Z9 > 0 THEN
        Z3 = EM8:Z9 - 1
        FOR Z4 = 0 TO Z3
          Z5 = (EM7:Z9 + Z4) * 4 + EM32:Z9 + Z9
          Z6 = Z4 * 4 + Z2 + 4
          EM1.L:Z6 = EM1.L:Z5
          EM0:Z6 = EM0:Z5
        NEXT
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      EM1.L:Z1 = EM3673:Z9   ' スロット番号
      EM0:Z1 = 8
      ' 順に渡したぶんだけ進める。回収で返ってきたスロットでは進めない
      IF EM3673:Z9 = EM39:Z9 THEN
        EM39:Z9 = EM39:Z9 + 1
      END IF

    ELSE
      ' 未知のオペコード: エラー
      EM1:Z9 = 3
      EM2:Z9 = EM6:Z9
      BREAK

    END IF

    ' バイトコード範囲チェック
    IF EM0:Z9 >= EM10:Z9 THEN
      EM1:Z9 = 2
      BREAK
    END IF

  NEXT
END IF
