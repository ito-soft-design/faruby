' =======================================
' faRuby VM - Reset Handler
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   生成: tools/kvs_generator.rb  (rake vm_core)
'
' 毎スキャン実行。RESET_REQ = 1 のインスタンスについて
' VM 状態とレジスタファイルを初期化します。

' インデックスレジスタの退避
' Z はラダーと共有する資源のため、faRuby の実行前後で
' 内容が変わらないようにする (1スキャンにつき1回)
EM20021 = Z1
EM20022 = Z2
EM20023 = Z3
EM20024 = Z4
EM20025 = Z5
EM20026 = Z6
EM20027 = Z7
EM20028 = Z8
EM20029 = Z9

' インスタンスごとの実行 (ブロック先頭を Z9 に載せる)
' instances = 2
FOR Z9 = 20000 TO 25000 STEP 5000

    IF EM13:Z9 = 1 THEN

        EM0:Z9 = 0      ' PC = 0
        EM1:Z9 = 0      ' STATUS = stopped
        EM2:Z9 = 0      ' ERROR = none
        EM3.L:Z9 = 0    ' STEP_COUNT = 0

        ' レジスタファイルクリア (ブロック先頭 +32 から 80スロット × 4ワード)
        ' スロット先頭の型タグも 0 (TT_EMPTY) になる
        FOR Z1 = 32 + Z9 TO 351 + Z9
            EM0:Z1 = 0
        NEXT

        EM13:Z9 = 0     ' リセット要求クリア

    END IF

NEXT

' インデックスレジスタの復元
Z1 = EM20021
Z2 = EM20022
Z3 = EM20023
Z4 = EM20024
Z5 = EM20025
Z6 = EM20026
Z7 = EM20027
Z8 = EM20028
Z9 = EM20029
