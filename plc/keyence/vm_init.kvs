' =======================================
' mruby/c VM - Reset Handler
' =======================================
' 毎スキャン実行。EM13 (RESET_REQ) = 1 のとき
' VM 状態とレジスタファイルを初期化します。
'
' EM13 = RESET_REQ (1=リセット要求)

IF EM13 = 1 THEN

    EM0 = 0      ' PC = 0
    EM1 = 0      ' STATUS = stopped (0)
    EM2 = 0      ' ERROR = none
    EM3.L = 0    ' STEP_COUNT = 0

    ' レジスタファイルクリア (EM100-EM419: 80スロット × 4ワード)
    ' スロット先頭の型タグも 0 (TT_EMPTY) になる
    FOR Z1 = 100 TO 419
        EM0:Z1 = 0
    NEXT

    EM13 = 0     ' リセット要求クリア

END IF
