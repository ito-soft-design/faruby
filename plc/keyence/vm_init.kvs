' =======================================
' faRuby VM - Reset Handler
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   生成: tools/kvs_generator.rb  (rake vm_core)
'
' 毎スキャン実行。EM20013 (RESET_REQ) = 1 のとき
' VM 状態とレジスタファイルを初期化します。

IF EM20013 = 1 THEN

    ' インデックスレジスタの退避 (ラダーの値を壊さないため)
    EM20021 = Z1

    EM20000 = 0      ' PC = 0
    EM20001 = 0      ' STATUS = stopped
    EM20002 = 0      ' ERROR = none
    EM20003.L = 0    ' STEP_COUNT = 0

    ' レジスタファイルクリア (EM20032-EM20351: 80スロット × 4ワード)
    ' スロット先頭の型タグも 0 (TT_EMPTY) になる
    FOR Z1 = 20032 TO 20351
        EM0:Z1 = 0
    NEXT

    EM20013 = 0     ' リセット要求クリア

    ' インデックスレジスタの復元
    Z1 = EM20021

END IF
