                LR0.F:Z6 = EM18.F:Z9
              ELSE
                LR0.S:Z6 = EM16.L:Z9
              END IF
            END IF
          ELSE IF Z5 = 8 THEN
            IF Z8 = 5 THEN
              ' 接点は書けない。タイムアップ・カウントアップで決まる
              EM1:Z9 = 3
              EM2:Z9 = 2
              BREAK
            ELSE
              IF Z8 = 2 THEN
                T0.L:Z6 = EM16.L:Z9
              ELSE IF Z8 = 1 THEN
                T0.U:Z6 = EM16.L:Z9
              ELSE IF Z8 = 3 THEN
                T0.D:Z6 = EM16.L:Z9
              ELSE
                T0.S:Z6 = EM16.L:Z9
              END IF
            END IF
          ELSE IF Z5 = 9 THEN
            IF Z8 = 5 THEN
              ' 接点は書けない。タイムアップ・カウントアップで決まる
              EM1:Z9 = 3
              EM2:Z9 = 2
              BREAK
            ELSE
              IF Z8 = 2 THEN
                C0.L:Z6 = EM16.L:Z9
              ELSE IF Z8 = 1 THEN
                C0.U:Z6 = EM16.L:Z9
              ELSE IF Z8 = 3 THEN
                C0.D:Z6 = EM16.L:Z9
              ELSE
                C0.S:Z6 = EM16.L:Z9
              END IF
            END IF
          ELSE
            EM1:Z9 = 3
            EM2:Z9 = 2
            BREAK
          END IF
        END IF
      ELSE IF EM0:Z1 = 8 THEN
        ' スロットの見出し。R[a] を書き換える前に読む
        Z4 = EM1.L:Z1
        Z4 = Z4 * 50 + 1000 + Z9
        EM18.L:Z9 = EM0:Z4   ' 要素数
        ' 負の添字は後ろから数える (Ruby の a[-1] は最後の要素)
        EM16.L:Z9 = EM1.L:Z2
        IF EM16.L:Z9 < 0 THEN
          EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
        END IF
        IF EM16.L:Z9 < 0 THEN
          ' 後ろから数えても先頭より前 (Ruby は IndexError)
          EM1:Z9 = 3
          EM2:Z9 = 2
          BREAK
        END IF
        IF EM16.L:Z9 >= 12 THEN
          ' 1 スロットの容量を超える位置
          EM1:Z9 = 3
          EM2:Z9 = 10
          BREAK
        END IF
        ' 要素数を超える位置への代入は、間を nil で埋めて伸ばす
        IF EM16.L:Z9 > EM18.L:Z9 THEN
          Z6 = EM18.L:Z9   ' 埋め始め (今の要素数)
          Z7 = EM16.L:Z9
          Z7 = Z7 - 1   ' 埋め終わり。ここは添字 > 要素数 >= 0 なので 0 未満にならない
          FOR Z8 = Z6 TO Z7
            Z5 = Z8 * 4 + Z4 + 2
            EM1.L:Z5 = 0
            EM0:Z5 = 1
          NEXT
        END IF
        IF EM16.L:Z9 >= EM18.L:Z9 THEN
          Z6 = EM16.L:Z9
          EM0:Z4 = Z6 + 1   ' 要素数を伸ばす
        END IF
        Z5 = EM16.L:Z9
        Z5 = Z5 * 4 + Z4 + 2
        EM1.L:Z5 = EM1.L:Z3
        EM0:Z5 = EM0:Z3
      ELSE IF EM0:Z1 = 9 THEN
        ' 鍵の配列の見出し。R[a] を書き換える前に読む
        Z4 = EM1:Z1
        Z4 = Z4 * 50 + 1000 + Z9
        EM18.L:Z9 = EM0:Z4   ' 組の数
        Z5 = EM2:Z1   ' 値の配列
        Z5 = Z5 * 50 + 1000 + Z9
        ' 鍵を先頭から探す。一致は型と値の両方 (Ruby の eql? と同じ)
        EM16.L:Z9 = -1
        IF EM18.L:Z9 > 0 THEN
          Z8 = EM18.L:Z9
          Z8 = Z8 - 1
          FOR Z6 = 0 TO Z8
            IF EM16.L:Z9 < 0 THEN
              ' 最初に一致したものを採る
              Z7 = Z6 * 4 + Z4 + 2
              IF EM0:Z7 = EM0:Z2 THEN
                IF EM0:Z2 = 7 THEN
                  ' 文字列の鍵は中身で照合する。スロットが違っても同じ鍵
                  ' 文字列は中身で比べる。スロット番号ではない
                  ' Z3 を借りる。返すまでの間に呼ぶ側の値を壊さないため
                  EM46:Z9 = Z3
                  EM43:Z9 = 0
                  Z3 = EM1.L:Z7
                  Z3 = Z3 * 50 + 1000 + Z9
                  EM44:Z9 = EM0:Z3   ' バイト数
                  Z3 = EM1.L:Z2
                  Z3 = Z3 * 50 + 1000 + Z9
                  IF EM44:Z9 = EM0:Z3 THEN
                    ' バイト数が同じ。ここから中身を見る
                    EM43:Z9 = 1
                    EM45:Z9 = EM44:Z9 + 1
                    EM45:Z9 = EM45:Z9 / 2   ' ワード数
                    IF EM45:Z9 > 0 THEN
                      EM45:Z9 = EM45:Z9 - 1
                      FOR EM42:Z9 = 0 TO EM45:Z9
                        Z3 = EM1.L:Z7
                        Z3 = Z3 * 50 + 1000 + Z9
                        Z3 = EM42:Z9 + Z3 + 2
                        EM44:Z9 = EM0:Z3
                        Z3 = EM1.L:Z2
                        Z3 = Z3 * 50 + 1000 + Z9
                        Z3 = EM42:Z9 + Z3 + 2
                        IF EM44:Z9 <> EM0:Z3 THEN
                          EM43:Z9 = 0
                        END IF
                      NEXT
                    END IF
                  END IF
                  ' 借りた Z3 を返す
                  Z3 = EM46:Z9
                  IF EM43:Z9 = 1 THEN
                    EM16.L:Z9 = Z6
                  END IF
                ELSE
                  IF EM1.L:Z7 = EM1.L:Z2 THEN
                    EM16.L:Z9 = Z6
                  END IF
                END IF
              END IF
            END IF
          NEXT
        END IF
        IF EM16.L:Z9 >= 0 THEN
          ' 既にある鍵は値だけ差し替える
          Z7 = EM16.L:Z9
          Z7 = Z7 * 4 + Z5 + 2
          EM1.L:Z7 = EM1.L:Z3
          EM0:Z7 = EM0:Z3
        ELSE
          ' 新しい鍵は鍵と値の両方の末尾に足す
          IF EM18.L:Z9 >= 12 THEN
            ' 1 スロットの容量がいっぱい
            EM1:Z9 = 3
            EM2:Z9 = 10
            BREAK
          END IF
          EM16.L:Z9 = EM18.L:Z9
          Z7 = EM16.L:Z9
          Z7 = Z7 * 4 + Z4 + 2
          EM1.L:Z7 = EM1.L:Z2
          EM0:Z7 = EM0:Z2
          Z7 = EM16.L:Z9
          Z7 = Z7 * 4 + Z5 + 2
          EM1.L:Z7 = EM1.L:Z3
          EM0:Z7 = EM0:Z3
          Z8 = EM18.L:Z9
          Z8 = Z8 + 1   ' 組の数を 1 増やす
          EM0:Z4 = Z8
          EM0:Z5 = Z8
        END IF
      ELSE
        ' デバイス参照・配列・ハッシュ以外への添字代入は未対応
        EM1:Z9 = 3
        EM2:Z9 = 2
        BREAK
      END IF

    ELSE IF EM6:Z9 = 37 THEN
      ' OP_JMP (S): PC += signed16(a)
      ' 16bit big-endian: hi byte, lo byte
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM7:Z9 = Z3 * 256 + Z4
      IF EM7:Z9 >= 32768 THEN
        EM7:Z9 = EM7:Z9 - 65536
      END IF
      EM0:Z9 = EM0:Z9 + EM7:Z9

    ELSE IF EM6:Z9 = 38 THEN
      ' OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 16bit big-endian: hi byte, lo byte
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM8:Z9 = Z3 * 256 + Z4
      IF EM8:Z9 >= 32768 THEN
        EM8:Z9 = EM8:Z9 - 65536
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF EM0:Z1 > 2 THEN
        EM0:Z9 = EM0:Z9 + EM8:Z9
      END IF

    ELSE IF EM6:Z9 = 39 THEN
      ' OP_JMPNOT (BS): if R[a] が偽 (nil/false) then PC += signed16(b)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 16bit big-endian: hi byte, lo byte
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM8:Z9 = Z3 * 256 + Z4
      IF EM8:Z9 >= 32768 THEN
        EM8:Z9 = EM8:Z9 - 65536
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF EM0:Z1 <= 2 THEN
        EM0:Z9 = EM0:Z9 + EM8:Z9
      END IF

    ELSE IF EM6:Z9 = 40 THEN
      ' OP_JMPNIL (BS): if R[a] が nil then PC += signed16(b)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      ' 16bit big-endian: hi byte, lo byte
      Z1 = EM0:Z9 + EM33:Z9
      Z3 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM0:Z9 + EM33:Z9
      Z4 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      EM8:Z9 = Z3 * 256 + Z4
      IF EM8:Z9 >= 32768 THEN
        EM8:Z9 = EM8:Z9 - 65536
      END IF
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 1 THEN
        EM0:Z9 = EM0:Z9 + EM8:Z9
      END IF

    ELSE
      ' 未知のオペコード: エラー
      EM1:Z9 = 3
      EM2:Z9 = EM6:Z9
      BREAK

    END IF

    ' バイトコード範囲チェック
    IF EM0:Z9 >= EM10:Z9 THEN
      EM1:Z9 = 2
      BREAK
    END IF

  NEXT
END IF
