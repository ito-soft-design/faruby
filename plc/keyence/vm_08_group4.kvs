          END IF
          IF Z5 = 1 THEN
            EM47:Z9 = 1
          END IF
          IF Z5 = 2 THEN
            EM47:Z9 = 1
          END IF
          IF Z5 = 3 THEN
            EM47:Z9 = 1
          END IF
          IF Z5 = 4 THEN
