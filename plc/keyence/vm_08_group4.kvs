          EM50:Z9 = EM45:Z9   ' 見つからなければバイト数のまま
          EM51:Z9 = EM45:Z9
          IF EM45:Z9 > 0 THEN
            Z6 = EM45:Z9
            Z6 = Z6 - 1
            FOR EM42:Z9 = 0 TO Z6
              Z8 = EM42:Z9 / 2
              Z7 = Z8 + Z4 + 2
              Z7 = EM0:Z7
              Z8 = Z8 * 2
              IF EM42:Z9 = Z8 THEN
                Z7 = Z7 / 256   ' 偶数の位置は上位バイト
              ELSE
                Z8 = Z7 / 256
                Z7 = Z7 - Z8 * 256   ' 奇数の位置は下位バイト
              END IF
              ' この位置が文字の先頭かどうか
              EM43:Z9 = 1
              IF EM40:Z9 = 0 THEN
                ' 継続バイト (10xxxxxx) は文字の途中
                IF Z7 >= 128 THEN
                  IF Z7 < 192 THEN
                    EM43:Z9 = 0
                  END IF
                END IF
              ELSE IF EM40:Z9 = 1 THEN
                IF EM48:Z9 = 1 THEN
                  ' 先導バイトの次は後続バイト
                  EM43:Z9 = 0
                  EM48:Z9 = 0
                ELSE
                  ' 先導バイト (0x81-0x9F, 0xE0-0xEF) なら次のバイトは後続
                  IF Z7 >= 129 THEN
                    IF Z7 <= 159 THEN
                      EM48:Z9 = 1
                    END IF
                  END IF
                  IF Z7 >= 224 THEN
                    IF Z7 <= 239 THEN
                      EM48:Z9 = 1
                    END IF
                  END IF
                END IF
              END IF
              ' ASCII はどのバイトも文字の先頭なので何も見ない
              IF EM43:Z9 = 1 THEN
                IF EM49:Z9 <= 96 THEN
                  ' 探している文字なら位置を控える。次の切れ目がその文字の終わり
                  IF EM47:Z9 = EM49:Z9 THEN
                    EM50:Z9 = EM42:Z9
                  END IF
                  Z7 = EM49:Z9 + 1
                  IF EM47:Z9 = Z7 THEN
                    EM51:Z9 = EM42:Z9
                  END IF
                END IF
                EM47:Z9 = EM47:Z9 + 1
              END IF
            NEXT
          END IF
          IF EM50:Z9 >= EM45:Z9 THEN
            ' そこまで文字が無い。範囲外は nil (Ruby と同じ)
            EM1.L:Z1 = 0
            EM0:Z1 = 1
          ELSE
            ' プールの空きスロットを取る。返さないので使い切ったら止まる
            IF EM39:Z9 >= 16 THEN
              EM1:Z9 = 3
              EM2:Z9 = 10
              BREAK
            END IF
            Z3 = EM39:Z9
            Z3 = Z3 * 50 + 1000 + Z9
            EM16.L:Z9 = 0   ' 新しいスロットは空から始める
            EM18.L:Z9 = EM51:Z9 - EM50:Z9   ' その文字のバイト数
            IF EM18.L:Z9 > 0 THEN
              Z6 = EM18.L:Z9
              Z6 = Z6 - 1
              FOR Z5 = 0 TO Z6
                ' 継ぎ足す元のバイトを 1 つ取り出す
                EM48:Z9 = EM50:Z9 + Z5   ' 元の位置
                Z7 = EM48:Z9 / 2
                Z8 = Z7 + Z4 + 2
                Z8 = EM0:Z8
                Z7 = Z7 * 2
                IF EM48:Z9 = Z7 THEN
                  Z8 = Z8 / 256   ' 偶数の位置は上位バイト
                ELSE
