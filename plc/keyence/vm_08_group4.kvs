      END IF

    ELSE IF EM6:Z9 = 36 THEN
      ' OP_SETIDX (B): R[a][R[a+1]] = R[a+2] (デバイス・配列)
      Z1 = EM0:Z9 + EM33:Z9
      EM7:Z9 = FM0:Z1
      EM0:Z9 = EM0:Z9 + 1
      Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
      Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
      Z3 = (EM7:Z9 + 2) * 4 + EM32:Z9 + Z9
      IF EM0:Z1 = 11 THEN
        ' デバイス参照から種別・幅・アドレスを取り出す
        Z8 = EM2:Z1 / 16   ' アクセス幅
        Z5 = EM2:Z1 - Z8 * 16   ' デバイス種別
        ' アドレス = ベース + 添字。範囲外は黙って別の場所を読み書きしてしまうため弾く
        EM16.L:Z9 = EM1:Z1 + EM1.L:Z2
        IF EM16.L:Z9 >= 0 THEN
          IF EM16.L:Z9 <= 65535 THEN
            Z6 = EM16.L:Z9
          ELSE
            EM1:Z9 = 3
            EM2:Z9 = 2
            BREAK
          END IF
        ELSE
          EM1:Z9 = 3
          EM2:Z9 = 2
          BREAK
        END IF
        IF EM0:Z3 = 7 THEN
          ' 文字列を書けるのは EM / DM / ZF だけ
          ' **この検査は FOR の外に置く。** 中の BREAK は FOR を抜けるだけで
          ' 命令ループから出られず、エラーを書いてもそのまま走り続ける
          IF Z5 > 2 THEN
            EM1:Z9 = 3
            EM2:Z9 = 2
            BREAK
          END IF
          ' 桁数。0 なら終端付き
          Z7 = Z8 / 16
          ' 文字列スロットの見出し
          Z4 = EM1.L:Z3
          Z4 = Z4 * 50 + 1000 + Z9
          EM18.L:Z9 = EM0:Z4   ' バイト数
          ' 書く長さと埋めるバイトを決める
          IF Z7 = 0 THEN
            ' 終端付き。バイト列 + 0
            EM16.L:Z9 = EM18.L:Z9 + 1
            Z8 = 0
          ELSE
            ' 固定長。余りは FARUBY_STR_FILL
            EM16.L:Z9 = Z7
            Z8 = EM41:Z9
          END IF
          ' 中身の長さ。桁からはみ出す分は切り詰める
          IF EM18.L:Z9 > EM16.L:Z9 THEN
            EM18.L:Z9 = EM16.L:Z9
          END IF
          ' ワード数。奇数バイトなら最後のワードの下位バイトは埋めるバイト
          Z2 = EM16.L:Z9 + 1
          Z2 = Z2 / 2
          IF Z2 > 0 THEN
            Z2 = Z2 - 1
            FOR Z3 = 0 TO Z2
              Z1 = Z3 * 2   ' 先頭バイトの位置
              Z7 = Z1 + 1
              IF Z7 < EM18.L:Z9 THEN
                ' 2 バイトとも中身。並びが同じなのでそのまま写す
                Z7 = Z3 + Z4 + 2
                Z7 = EM0:Z7
              ELSE
