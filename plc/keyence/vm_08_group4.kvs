                ' 書き先の位置 (継ぎ足す先の長さ + 何バイト目か)
                EM44:Z9 = EM16.L:Z9 + Z5
                Z7 = EM44:Z9
                Z7 = Z7 / 2
                Z7 = Z7 + Z3 + 2
                EM45:Z9 = EM44:Z9 / 2
                EM45:Z9 = EM45:Z9 * 2
                IF EM44:Z9 = EM45:Z9 THEN
