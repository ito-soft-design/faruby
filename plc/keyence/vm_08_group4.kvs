                Z7 = 0
                IF Z1 < EM18.L:Z9 THEN
                  Z7 = Z3 + Z4 + 2
                  Z7 = EM0:Z7
                  Z7 = Z7 / 256   ' 上位バイトだけ中身
                ELSE
