                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    ELSE
                        IF EM1.L:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.F:Z1 / EM1.L:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.L:Z1 / EM1.F:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.L:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.L:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
