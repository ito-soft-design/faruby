                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = EM8:Z9
                EM0:Z1 = 6

            ELSE IF EM6:Z9 = 99 THEN
                ' OP_TCLASS (B): R[a] = 定義先クラス (トップレベルは main)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 10

            ELSE IF EM6:Z9 = 105 THEN
                ' OP_STOP (Z): VM 停止
                EM1:Z9 = 2
                BREAK

            ELSE
                ' 未知のオペコード: エラー
                EM1:Z9 = 3
                EM2:Z9 = EM6:Z9
                BREAK

            END IF

            ' バイトコード範囲チェック
            IF EM0:Z9 >= EM10:Z9 THEN
                EM1:Z9 = 2
                BREAK
            END IF

        NEXT

    END IF

NEXT

' ファイルレジスタのバンクを 0 に戻す
FRSET(0)
' インデックスレジスタの復元
Z1 = EM20021
Z2 = EM20022
Z3 = EM20023
Z4 = EM20024
Z5 = EM20025
Z6 = EM20026
Z7 = EM20027
Z8 = EM20028
Z9 = EM20029
