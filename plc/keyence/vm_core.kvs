                        IF EM0:Z4 = 9 THEN
                            EM5:Z3 = 3
                        ELSE
                            EM5:Z3 = 2
                        END IF
                    END IF
                    ' 窓をずらした後、ブロックは R[引数の数 + 1] にある
                    Z2 = (EM9:Z9 + 1) * 4 + EM32:Z9 + Z9
