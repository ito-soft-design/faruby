                    Z4 = EM1:Z1
                    Z4 = Z4 * 50 + 1000 + Z9
                    EM18.L:Z9 = EM0:Z4   ' 組の数
                    ' 鍵を先頭から探す。一致は型と値の両方 (Ruby の eql? と同じ)
                    EM16.L:Z9 = -1
