                    Z7 = EM2:Z2   ' 定義元のフレーム
                    ' 反復の状態と定義元をフレームに書く (Z3 は push_frame が指したまま)
                    EM4:Z3 = Z7
                    EM6.L:Z3 = EM16.L:Z9
                    EM8.L:Z3 = EM18.L:Z9
                    ' 渡す値と引数の数はどちらもフレームの種別で決まる。まとめて書く
                    Z2 = 4 + EM32:Z9 + Z9
                    IF EM5:Z3 = 3 THEN
                        ' h.each は鍵と値を渡す。レシーバのハッシュは R[0] に残っている
                        Z4 = 0 + EM32:Z9 + Z9
                        Z7 = EM1:Z4   ' スロット番号
                        Z7 = Z7 * 50 + 1000 + Z9
                        Z5 = EM16.L:Z9
                        Z5 = Z5 * 4 + Z7 + 2
                        EM1.L:Z2 = EM1.L:Z5
                        EM0:Z2 = EM0:Z5
                        Z2 = 2 * 4 + EM32:Z9 + Z9   ' R[2] に値
                        Z7 = EM2:Z4   ' スロット番号
                        Z7 = Z7 * 50 + 1000 + Z9
                        Z5 = EM16.L:Z9
                        Z5 = Z5 * 4 + Z7 + 2
                        EM1.L:Z2 = EM1.L:Z5
                        EM0:Z2 = EM0:Z5
                        EM37:Z9 = 2
                    ELSE IF EM5:Z3 = 2 THEN
                        ' a.each はその位置の要素を渡す。レシーバの配列は R[0] に残っている
                        Z4 = 0 + EM32:Z9 + Z9
                        Z7 = EM1.L:Z4   ' スロット番号
                        Z7 = Z7 * 50 + 1000 + Z9
                        Z5 = EM16.L:Z9
                        Z5 = Z5 * 4 + Z7 + 2
                        EM1.L:Z2 = EM1.L:Z5
                        EM0:Z2 = EM0:Z5
                        EM37:Z9 = 1
                    ELSE
                        ' times / upto は添字を渡す
                        EM1.L:Z2 = EM16.L:Z9
                        EM0:Z2 = 4
                        EM37:Z9 = 1
                    END IF
                    EM30:Z9 = Z6
                    ' IREP テーブルから実行中の irep の情報を写す
                    Z1 = Z6 * 8 + EM38:Z9
                    EM33:Z9 = FM0:Z1
                    EM10:Z9 = FM1:Z1
                    EM34:Z9 = FM2:Z1
                    EM35:Z9 = FM3:Z1
                    EM11:Z9 = FM4:Z1
                    ' レジスタ窓が領域からはみ出さないこと
                    EM16:Z9 = EM32:Z9 + EM11:Z9 * 4
                    IF EM16:Z9 > 376 THEN
                        EM1:Z9 = 3
                        EM2:Z9 = 5
                        BREAK
                    END IF
                    EM0:Z9 = 0
                END IF
                ' 1 回も回らないときはレシーバがそのまま呼び出しの値になる

            ELSE IF EM6:Z9 = 52 THEN
                ' OP_ENTER (W): 引数の数を検査し、残りのレジスタを空にする
                ' 24bit big-endian。16ビットに収まらないため上位バイトと下位2バイトに分ける
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z3 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z4 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4   ' aspec の下位2バイト
                ' 必須引数の数 = aspec >> 18。上位バイトを 4 で割った値と同じ
                Z3 = EM7:Z9 / 4
                IF EM7:Z9 <> Z3 * 4 THEN
                    ' 必須引数以外の指定 (省略可能・可変長・キーワード) は未対応
                    EM1:Z9 = 3
                    EM2:Z9 = 6
                    BREAK
                END IF
                IF EM8:Z9 <> 0 THEN
                    EM1:Z9 = 3
                    EM2:Z9 = 6
                    BREAK
                END IF
                ' ブロックは引数の数を検査しない。Ruby は足りなければ nil、余れば捨てる
                ' (引数を書かないブロックでも times は 1 個渡す)
                Z4 = 0
                IF EM31:Z9 > 0 THEN
                    Z5 = (EM31:Z9 - 1) * 10 + 376 + Z9
                    IF EM5:Z5 >= 1 THEN
                        Z4 = 1
                    END IF
                END IF
                IF Z4 = 0 THEN
                    IF EM37:Z9 <> Z3 THEN
                        ' 実引数の数が定義と違う
                        EM1:Z9 = 3
                        EM2:Z9 = 6
                        BREAK
                    END IF
                END IF
                ' 引数の後ろのレジスタを空にする (未代入のローカル変数は偽になる)
                ' 受け取れなかった引数も空になる (Ruby の nil に相当)
                IF EM37:Z9 < Z3 THEN
                    Z3 = EM37:Z9
                END IF
                Z4 = (Z3 + 1) * 4 + EM32:Z9 + Z9
                Z5 = EM11:Z9 * 4 + EM32:Z9 + Z9 - 1
                IF Z4 <= Z5 THEN
                    FOR Z6 = Z4 TO Z5
                        EM0:Z6 = 0
                    NEXT
                END IF

            ELSE IF EM6:Z9 = 56 THEN
                ' OP_RETURN (B): R[b] を返して呼び出し元へ (トップレベルでは VM 停止)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                IF EM31:Z9 = 0 THEN
                    ' トップレベルの return は VM 停止
                    EM1:Z9 = 2
                    BREAK
                ELSE
                    Z3 = (EM31:Z9 - 1) * 10 + 376 + Z9
                    IF EM5:Z3 >= 1 THEN
                        EM16.L:Z9 = EM6.L:Z3 + 1
                        IF EM16.L:Z9 <= EM8.L:Z3 THEN
                            ' 次の回。PC を 0 に戻し、ブロックの引数を更新するだけ
                            ' irep もレジスタ窓もそのまま使い回す
                            EM6.L:Z3 = EM16.L:Z9
                            Z2 = 4 + EM32:Z9 + Z9
                            IF EM5:Z3 = 3 THEN
                                ' h.each は鍵と値を渡す。レシーバのハッシュは R[0] に残っている
                                Z4 = 0 + EM32:Z9 + Z9
                                Z7 = EM1:Z4   ' スロット番号
                                Z7 = Z7 * 50 + 1000 + Z9
                                Z5 = EM16.L:Z9
                                Z5 = Z5 * 4 + Z7 + 2
                                EM1.L:Z2 = EM1.L:Z5
                                EM0:Z2 = EM0:Z5
                                Z2 = 2 * 4 + EM32:Z9 + Z9   ' R[2] に値
                                Z7 = EM2:Z4   ' スロット番号
                                Z7 = Z7 * 50 + 1000 + Z9
                                Z5 = EM16.L:Z9
                                Z5 = Z5 * 4 + Z7 + 2
                                EM1.L:Z2 = EM1.L:Z5
                                EM0:Z2 = EM0:Z5
                                EM37:Z9 = 2
                            ELSE IF EM5:Z3 = 2 THEN
                                ' a.each はその位置の要素を渡す。レシーバの配列は R[0] に残っている
                                Z4 = 0 + EM32:Z9 + Z9
                                Z7 = EM1.L:Z4   ' スロット番号
                                Z7 = Z7 * 50 + 1000 + Z9
                                Z5 = EM16.L:Z9
                                Z5 = Z5 * 4 + Z7 + 2
                                EM1.L:Z2 = EM1.L:Z5
                                EM0:Z2 = EM0:Z5
                                EM37:Z9 = 1
                            ELSE
                                ' times / upto は添字を渡す
                                EM1.L:Z2 = EM16.L:Z9
                                EM0:Z2 = 4
                                EM37:Z9 = 1
                            END IF
                            EM0:Z9 = 0
                        ELSE
                            ' 反復の終わり。R[0] にはレシーバが残っており、それが呼び出しの値になる
                            EM31:Z9 = EM31:Z9 - 1
                            ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
                            Z3 = EM31:Z9 * 10 + 376 + Z9
                            EM0:Z9 = EM0:Z3
                            Z5 = EM1:Z3
                            EM32:Z9 = EM2:Z3
                            EM30:Z9 = Z5
                            ' IREP テーブルから実行中の irep の情報を写す
                            Z1 = Z5 * 8 + EM38:Z9
                            EM33:Z9 = FM0:Z1
                            EM10:Z9 = FM1:Z1
                            EM34:Z9 = FM2:Z1
                            EM35:Z9 = FM3:Z1
                            EM11:Z9 = FM4:Z1
                        END IF
                    ELSE
                        ' R[a] を R[0] へ写す。R[0] は呼んだ側の R[a] と同じ場所なので
                        ' これで戻り値が呼び出し元から見える位置に入る
                        Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                        Z2 = 0 + EM32:Z9 + Z9
                        EM1.L:Z2 = EM1.L:Z1
                        EM0:Z2 = EM0:Z1
                        EM31:Z9 = EM31:Z9 - 1
                        ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
                        Z3 = EM31:Z9 * 10 + 376 + Z9
                        EM0:Z9 = EM0:Z3
                        Z5 = EM1:Z3
                        EM32:Z9 = EM2:Z3
                        EM30:Z9 = Z5
                        ' IREP テーブルから実行中の irep の情報を写す
                        Z1 = Z5 * 8 + EM38:Z9
                        EM33:Z9 = FM0:Z1
                        EM10:Z9 = FM1:Z1
                        EM34:Z9 = FM2:Z1
                        EM35:Z9 = FM3:Z1
                        EM11:Z9 = FM4:Z1
                    END IF
                END IF

            ELSE IF EM6:Z9 = 58 THEN
                ' OP_BREAK (B): 反復を打ち切って R[a] を返す
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                IF EM31:Z9 = 0 THEN
                    ' 反復の外での break
                    EM1:Z9 = 3
                    EM2:Z9 = 9
                    BREAK
                END IF
                Z3 = (EM31:Z9 - 1) * 10 + 376 + Z9
                IF EM5:Z3 < 1 THEN
                    EM1:Z9 = 3
                    EM2:Z9 = 9
                    BREAK
                END IF
                ' break の値を R[0] へ。R[0] は呼んだ側の R[a] と同じ場所
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = 0 + EM32:Z9 + Z9
                EM1.L:Z2 = EM1.L:Z1
                EM0:Z2 = EM0:Z1
                EM31:Z9 = EM31:Z9 - 1
                ' 外した段がそのまま戻り先。減らした後なので top_frame_expr ではない
                Z3 = EM31:Z9 * 10 + 376 + Z9
                EM0:Z9 = EM0:Z3
                Z5 = EM1:Z3
                EM32:Z9 = EM2:Z3
                EM30:Z9 = Z5
                ' IREP テーブルから実行中の irep の情報を写す
                Z1 = Z5 * 8 + EM38:Z9
                EM33:Z9 = FM0:Z1
                EM10:Z9 = FM1:Z1
                EM34:Z9 = FM2:Z1
                EM35:Z9 = FM3:Z1
                EM11:Z9 = FM4:Z1

            ELSE IF EM6:Z9 = 60 THEN
                ' OP_ADD (B): R[a] = R[a] + R[a+1]
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 + EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        IF EM0:Z1 = 7 THEN
                            ' プールの空きスロットを取る。返さないので使い切ったら止まる
                            IF EM39:Z9 >= 16 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 10
                                BREAK
                            END IF
                            Z4 = EM1.L:Z1
                            Z4 = Z4 * 50 + 1000 + Z9
                            EM16.L:Z9 = EM0:Z4
                            Z5 = EM1.L:Z2
                            Z5 = Z5 * 50 + 1000 + Z9
                            EM18.L:Z9 = EM0:Z5
                            ' 1 スロットに収まること
                            Z6 = EM16.L:Z9 + EM18.L:Z9
                            IF Z6 > 96 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 10
                                BREAK
                            END IF
                            ' 新しいスロットへ左側をワード単位で写す。並びが同じなのでそのまま
                            Z3 = EM39:Z9 * 50 + 1000 + Z9
                            EM0:Z3 = EM16.L:Z9
                            EM45:Z9 = EM16.L:Z9 + 1
                            EM45:Z9 = EM45:Z9 / 2
                            IF EM45:Z9 > 0 THEN
                                EM45:Z9 = EM45:Z9 - 1
                                FOR EM42:Z9 = 0 TO EM45:Z9
                                    Z7 = EM42:Z9 + Z4 + 2
                                    Z8 = EM42:Z9 + Z3 + 2
                                    EM0:Z8 = EM0:Z7
                                NEXT
                            END IF
                            ' 右側を継ぎ足す。Z4 を継ぎ足す元にする
                            Z4 = Z5
                            IF EM18.L:Z9 > 0 THEN
                                Z6 = EM18.L:Z9
                                Z6 = Z6 - 1
                                FOR Z5 = 0 TO Z6
