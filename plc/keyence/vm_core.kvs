' =======================================
' mruby/c VM Core - Fetch/Decode/Execute
' =======================================
' EM デバイスを使用。
' EM0  = PC (プログラムカウンタ)
' EM1  = STATUS (0=停止, 1=実行中, 2=完了, 3=エラー)
' EM2  = ERROR
' EM5  = STEPS_PER_CYCLE
' EM6  = CURRENT_OPCODE (デバッグ用)
' EM7  = operand a
' EM8  = operand b
' EM100~ = レジスタファイル R[n] = EM(100+n*2).L
' EM1000~ = バイトコード (1バイト/1EM)
' EM4000~ = 定数プール Pool[n] = EM(4000+n*2).L
'
' Z1-Z6 を間接アドレッシングに使用

IF EM1 = 1 THEN

    FOR EM20 = 1 TO EM5

        ' === FETCH OPCODE ===
        Z1 = EM0 + 1000
        EM6 = EM[Z1]
        EM0 = EM0 + 1

        ' === DECODE & EXECUTE ===

        IF EM6 = 0 THEN
            ' OP_NOP (Z): 何もしない

        ELSE IF EM6 = 1 THEN
            ' OP_MOVE (BB): R[a] = R[b]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = EM8 * 2 + 100
            EM[Z1].L = EM[Z2].L

        ELSE IF EM6 = 2 THEN
            ' OP_LOADL (BB): R[a] = Pool[b]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = EM8 * 2 + 4000
            EM[Z1].L = EM[Z2].L

        ELSE IF EM6 = 3 THEN
            ' OP_LOADI8 (BB): R[a] = signed(b)
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            IF EM8 >= 128 THEN
                EM8 = EM8 - 256
            END IF
            Z1 = EM7 * 2 + 100
            EM[Z1].L = EM8

        ELSE IF EM6 = 4 THEN
            ' OP_LOADINEG (BB): R[a] = -b
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 0 - EM8

        ELSE IF EM6 = 5 THEN
            ' OP_LOADI__1 (B): R[a] = -1
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = -1

        ELSE IF EM6 = 6 THEN
            ' OP_LOADI_0 (B): R[a] = 0
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 0

        ELSE IF EM6 = 7 THEN
            ' OP_LOADI_1 (B): R[a] = 1
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 1

        ELSE IF EM6 = 8 THEN
            ' OP_LOADI_2 (B): R[a] = 2
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 2

        ELSE IF EM6 = 9 THEN
            ' OP_LOADI_3 (B): R[a] = 3
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 3

        ELSE IF EM6 = 10 THEN
            ' OP_LOADI_4 (B): R[a] = 4
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 4

        ELSE IF EM6 = 11 THEN
            ' OP_LOADI_5 (B): R[a] = 5
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 5

        ELSE IF EM6 = 12 THEN
            ' OP_LOADI_6 (B): R[a] = 6
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 6

        ELSE IF EM6 = 13 THEN
            ' OP_LOADI_7 (B): R[a] = 7
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 7

        ELSE IF EM6 = 14 THEN
            ' OP_LOADI16 (BS): R[a] = signed16(b)
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            ' 16bit big-endian: hi byte, lo byte
            Z1 = EM0 + 1000
            Z3 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM[Z1]
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            Z1 = EM7 * 2 + 100
            EM[Z1].L = EM8

        ELSE IF EM6 = 15 THEN
            ' OP_LOADI32 (BSS): R[a] = (b<<16)+c
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            ' b (16bit)
            Z1 = EM0 + 1000
            Z3 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM[Z1]
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            ' c (16bit)
            Z1 = EM0 + 1000
            Z3 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM[Z1]
            EM0 = EM0 + 1
            EM9 = Z3 * 256 + Z4
            Z1 = EM7 * 2 + 100
            EM[Z1].L = EM8 * 65536 + EM9

        ELSE IF EM6 = 18 THEN
            ' OP_LOADSELF (B): R[a] = self (=0)
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = 0

        ELSE IF EM6 = 56 THEN
            ' OP_RETURN (B): トップレベルでは VM 停止
            EM0 = EM0 + 1
            EM1 = 2
            EXIT

        ELSE IF EM6 = 60 THEN
            ' OP_ADD (B): R[a] = R[a] + R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM[Z1].L = EM[Z1].L + EM[Z2].L

        ELSE IF EM6 = 61 THEN
            ' OP_ADDI (BB): R[a] = R[a] + b
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = EM[Z1].L + EM8

        ELSE IF EM6 = 62 THEN
            ' OP_SUB (B): R[a] = R[a] - R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM[Z1].L = EM[Z1].L - EM[Z2].L

        ELSE IF EM6 = 63 THEN
            ' OP_SUBI (BB): R[a] = R[a] - b
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM[Z1].L = EM[Z1].L - EM8

        ELSE IF EM6 = 64 THEN
            ' OP_MUL (B): R[a] = R[a] * R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM[Z1].L = EM[Z1].L * EM[Z2].L

        ELSE IF EM6 = 65 THEN
            ' OP_DIV (B): R[a] = R[a] / R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM[Z1]
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM[Z2].L <> 0 THEN
                EM[Z1].L = EM[Z1].L / EM[Z2].L
            ELSE
                EM1 = 3
                EM2 = 1
                EXIT
            END IF

        ELSE IF EM6 = 105 THEN
            ' OP_STOP (Z): VM 停止
            EM1 = 2
            EXIT

        ELSE
            ' 未知のオペコード: エラー
            EM1 = 3
            EM2 = EM6
            EXIT

        END IF

        ' バイトコード範囲チェック
        IF EM0 >= EM10 THEN
            EM1 = 2
            EXIT
        END IF

    NEXT

END IF
