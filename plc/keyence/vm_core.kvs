                                        EM0:Z7 = Z8 * 256
                                    ELSE
                                        ' 奇数。上位バイトを残して下位に入れる
                                        EM45:Z9 = EM0:Z7
                                        EM45:Z9 = EM45:Z9 / 256
                                        EM0:Z7 = EM45:Z9 * 256 + Z8
                                    END IF
                                NEXT
                            END IF
                            ' 長さを更新する
                            EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
                            EM0:Z3 = EM16.L:Z9
                            EM1.L:Z1 = EM39:Z9   ' スロット番号
                            EM0:Z1 = 7
                            EM39:Z9 = EM39:Z9 + 1
                        ELSE
                            EM1.L:Z1 = EM1.L:Z1 + EM1.L:Z2
                            EM0:Z1 = 4
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 61 THEN
                ' OP_ADDI (BB): R[a] = R[a] + b
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                EM8:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 + EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 + EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 62 THEN
                ' OP_SUB (B): R[a] = R[a] - R[a+1]
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 - EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 - EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 63 THEN
                ' OP_SUBI (BB): R[a] = R[a] - b
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                EM8:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 - EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 - EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 64 THEN
