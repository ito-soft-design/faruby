' =======================================
' faRuby VM Core - Fetch/Decode/Execute
' =======================================
' 【自動生成】このファイルを直接編集しないでください。
'   定義: tools/opcode_table.rb
'   生成: tools/kvs_generator.rb  (rake vm_core)
'   編集した場合 test_kvs_generator.rb が失敗します。
'
' EM デバイスを使用。
'
' インスタンスごとに 5000 ワードのブロックを使います。
'   インスタンス0  EM20000-EM24999
'   インスタンス1  EM25000-EM29999
'
' 実行中のブロック先頭は Z9 に載っています。
' ブロック内の位置はオフセットをインデックス修飾で足して指します。
' どのインスタンスでも同じコードが動くのはこのためです。
'
' ブロック先頭からのオフセット:
'   EM0:Z9  = PC (プログラムカウンタ)
'   EM1:Z9  = STATUS (0=停止, 1=実行中, 2=完了, 3=エラー)
'   EM2:Z9  = ERROR
'   EM5:Z9  = STEPS_PER_CYCLE
'   EM6:Z9  = CURRENT_OPCODE (デバッグ用)
'   EM7:Z9  = operand a
'   EM8:Z9  = operand b
'   EM9:Z9  = operand c
'   EM13:Z9 = RESET_REQ (1=リセット要求, vm_init で処理)
'   EM16:Z9 = 32ビット合成スクラッチ 下位ワード
'   EM17:Z9 = 32ビット合成スクラッチ 上位ワード
'          EM は無サフィックスだと16ビット符号なしのため、負値や
'          65535 超の即値は一旦この2ワードに置いてから .L で読む
'   +32~ = レジスタファイル (値スロット 4ワード/レジスタ)
'   +352~ = バイトコード (1バイト/1ワード)
'   +3352~ = 定数プール (値スロット 4ワード/エントリ)
'   +4152~ = デバイスマッピングテーブル (4ワード/エントリ)
'
' Z1-Z9 を使用 (Z11/Z12 は特別な用途があり使用不可、Z10 はラダー用に残す)
'   Z はラダーと共有する資源のため、スクリプトの先頭で退避し末尾で復元する。
'   faRuby の実行前後で Z の内容は変わらない。
'   退避先 EM20021-EM20029 (インスタンスループの外なので絶対アドレス)
'
' 【重要】インデックス修飾と型サフィックスの順序
'   正: EM0.L:Z1   デバイスに .L が付く → 32ビットアクセス
'   誤: EM0:Z1.L   .L がインデックスレジスタ Z1 に結合してしまい、
'                  エラーにならないまま16ビットアクセスになる
'   インデックスの刻み幅は .L でも 1 ワード。下位ワードが先。

' インデックスレジスタの退避
' Z はラダーと共有する資源のため、faRuby の実行前後で
' 内容が変わらないようにする (1スキャンにつき1回)
EM20021 = Z1
EM20022 = Z2
EM20023 = Z3
EM20024 = Z4
EM20025 = Z5
EM20026 = Z6
EM20027 = Z7
EM20028 = Z8
EM20029 = Z9

' インスタンスごとの実行 (ブロック先頭を Z9 に載せる)
' instances = 2
FOR Z9 = 20000 TO 25000 STEP 5000

    IF EM1:Z9 = 1 THEN

        FOR EM20:Z9 = 1 TO EM5:Z9

            ' === FETCH OPCODE ===
            Z1 = EM0:Z9 + 352 + Z9
            EM6:Z9 = EM0:Z1
            EM0:Z9 = EM0:Z9 + 1

            ' === DECODE & EXECUTE ===

            IF EM6:Z9 = 0 THEN
                ' OP_NOP (Z): 何もしない

            ELSE IF EM6:Z9 = 1 THEN
                ' OP_MOVE (BB): R[a] = R[b]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = EM8:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = EM1.L:Z2
                EM0:Z1 = EM0:Z2

            ELSE IF EM6:Z9 = 2 THEN
                ' OP_LOADL (BB): R[a] = Pool[b]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = EM8:Z9 * 4 + 3352 + Z9
                EM1.L:Z1 = EM1.L:Z2
                EM0:Z1 = EM0:Z2

            ELSE IF EM6:Z9 = 3 THEN
                ' OP_LOADI (BB): R[a] = b (符号なし)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = EM8:Z9
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 4 THEN
                ' OP_LOADINEG (BB): R[a] = -b
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 2の補数を32ビットで組み立てる
                EM16:Z9 = 0 - EM8:Z9
                EM17:Z9 = 0
                IF EM8:Z9 <> 0 THEN
                    EM17:Z9 = 65535
                END IF
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = EM16.L:Z9
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 5 THEN
                ' OP_LOADI__1 (B): R[a] = -1
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = -1
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 6 THEN
                ' OP_LOADI_0 (B): R[a] = 0
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 7 THEN
                ' OP_LOADI_1 (B): R[a] = 1
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 1
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 8 THEN
                ' OP_LOADI_2 (B): R[a] = 2
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 2
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 9 THEN
                ' OP_LOADI_3 (B): R[a] = 3
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 3
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 10 THEN
                ' OP_LOADI_4 (B): R[a] = 4
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 4
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 11 THEN
                ' OP_LOADI_5 (B): R[a] = 5
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 5
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 12 THEN
                ' OP_LOADI_6 (B): R[a] = 6
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 6
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 13 THEN
                ' OP_LOADI_7 (B): R[a] = 7
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 7
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 14 THEN
                ' OP_LOADI16 (BS): R[a] = signed16(b)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                ' 16ビット値を符号拡張して32ビットスクラッチに置く
                EM16:Z9 = EM8:Z9
                EM17:Z9 = 0
                IF EM8:Z9 >= 32768 THEN
                    EM17:Z9 = 65535
                END IF
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = EM16.L:Z9
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 15 THEN
                ' OP_LOADI32 (BSS): R[a] = (b<<16)+c
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM9:Z9 = Z3 * 256 + Z4
                ' 上位 * 65536 は16ビット演算になり桁上がりが落ちるため、
                ' 下位/上位ワードを並べて32ビットとして読む
                EM16:Z9 = EM9:Z9
                EM17:Z9 = EM8:Z9
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = EM16.L:Z9
                EM0:Z1 = 4

            ELSE IF EM6:Z9 = 17 THEN
                ' OP_LOADNIL (B): R[a] = nil
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 1

            ELSE IF EM6:Z9 = 18 THEN
                ' OP_LOADSELF (B): R[a] = self (main)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 10

            ELSE IF EM6:Z9 = 19 THEN
                ' OP_LOADT (B): R[a] = true
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 1
                EM0:Z1 = 3

            ELSE IF EM6:Z9 = 20 THEN
                ' OP_LOADF (B): R[a] = false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 2

            ELSE IF EM6:Z9 = 21 THEN
                ' OP_GETGV (BB): R[a] = global[symbols[b]]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' デバイスマッピングテーブル参照 (4ワード/エントリ)
                Z3 = EM8:Z9 * 4 + 4152 + Z9
                Z4 = Z3 + 1
                Z5 = EM0:Z3
                Z6 = EM0:Z4
                Z7 = Z3 + 2
                Z8 = EM0:Z7
                ' レジスタアドレス
                Z2 = EM7:Z9 * 4 + 32 + Z9
                ' デバイスタイプ別読み取り
                ' ワードデバイス (EM, DM, ZF): Z8 (access_type) で幅を選ぶ
                '   2=.L(32bit符号付き)
                '   1=.U(16bit符号なし)
                '   3=.D(32bit符号なし)
                '   4=.F(実数)
                '   それ以外=.S(16bit符号付き/既定)
                ' ビットデバイス (R, MR, B, L, T, C): ON→true, OFF→false
                '   整数の 1/0 ではなく真偽値。0 は Ruby では真なので、
                '   整数にすると if $MR10 が常に成立してしまう
                IF Z5 = 0 THEN
                    IF Z8 = 2 THEN
                        EM1.L:Z2 = EM0.L:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 1 THEN
                        EM1.L:Z2 = EM0.U:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 3 THEN
                        EM1.L:Z2 = EM0.D:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 4 THEN
                        EM1.F:Z2 = EM0.F:Z6
                        EM0:Z2 = 5
                    ELSE
                        EM1.L:Z2 = EM0.S:Z6
                        EM0:Z2 = 4
                    END IF
                ELSE IF Z5 = 1 THEN
                    IF Z8 = 2 THEN
                        EM1.L:Z2 = DM0.L:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 1 THEN
                        EM1.L:Z2 = DM0.U:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 3 THEN
                        EM1.L:Z2 = DM0.D:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 4 THEN
                        EM1.F:Z2 = DM0.F:Z6
                        EM0:Z2 = 5
                    ELSE
                        EM1.L:Z2 = DM0.S:Z6
                        EM0:Z2 = 4
                    END IF
                ELSE IF Z5 = 2 THEN
                    IF Z8 = 2 THEN
                        EM1.L:Z2 = ZF0.L:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 1 THEN
                        EM1.L:Z2 = ZF0.U:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 3 THEN
                        EM1.L:Z2 = ZF0.D:Z6
                        EM0:Z2 = 4
                    ELSE IF Z8 = 4 THEN
                        EM1.F:Z2 = ZF0.F:Z6
                        EM0:Z2 = 5
                    ELSE
                        EM1.L:Z2 = ZF0.S:Z6
                        EM0:Z2 = 4
                    END IF
                ELSE IF Z5 = 3 THEN
                    IF R0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE IF Z5 = 4 THEN
                    IF MR0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE IF Z5 = 5 THEN
                    IF B0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE IF Z5 = 6 THEN
                    IF L0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE IF Z5 = 8 THEN
                    IF T0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE IF Z5 = 9 THEN
                    IF C0:Z6 THEN
                        EM1.L:Z2 = 1
                        EM0:Z2 = 3
                    ELSE
                        EM1.L:Z2 = 0
                        EM0:Z2 = 2
                    END IF
                ELSE
                    EM1:Z9 = 3
                    EM2:Z9 = 21
                    BREAK
                END IF

            ELSE IF EM6:Z9 = 22 THEN
                ' OP_SETGV (BB): global[symbols[b]] = R[a]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' デバイスマッピングテーブル参照 (4ワード/エントリ)
                Z3 = EM8:Z9 * 4 + 4152 + Z9
                Z4 = Z3 + 1
                Z5 = EM0:Z3
                Z6 = EM0:Z4
                Z7 = Z3 + 2
                Z8 = EM0:Z7
                ' レジスタアドレス
                Z2 = EM7:Z9 * 4 + 32 + Z9
                ' レジスタの値を書き込み先の幅に合わせて変換する
                ' 使う側の形だけを作る。Infinity や NaN の整数変換は
                ' 浮動小数点フォーマット異常になるため、.F 書き込みでは行わない
                IF Z8 = 4 THEN
                    IF EM0:Z2 = 5 THEN
                        EM18.F:Z9 = EM1.F:Z2
                    ELSE
                        EM18.F:Z9 = EM1.L:Z2      ' 整数→実数
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM16.L:Z9 = EM1.F:Z2      ' 実数→整数 (0方向へ切り捨て)
                    ELSE
                        EM16.L:Z9 = EM1.L:Z2
                    END IF
                END IF
                ' デバイスタイプ別書き込み
                ' ワードデバイス (EM, DM, ZF): Z8 (access_type) で幅を選ぶ
                '   2=.L(32bit符号付き)
                '   1=.U(16bit符号なし)
                '   3=.D(32bit符号なし)
                '   4=.F(実数)
                '   それ以外=.S(16bit符号付き/既定)
                ' ビットデバイス (R, MR, B, L, T, C): 非0→ON, 0→OFF
                '   true=1 / false=nil=0 なので値だけで判定できる
                IF Z5 = 0 THEN
                    IF Z8 = 2 THEN
                        EM0.L:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 1 THEN
                        EM0.U:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 3 THEN
                        EM0.D:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 4 THEN
                        EM0.F:Z6 = EM18.F:Z9
                    ELSE
                        EM0.S:Z6 = EM16.L:Z9
                    END IF
                ELSE IF Z5 = 1 THEN
                    IF Z8 = 2 THEN
                        DM0.L:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 1 THEN
                        DM0.U:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 3 THEN
                        DM0.D:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 4 THEN
                        DM0.F:Z6 = EM18.F:Z9
                    ELSE
                        DM0.S:Z6 = EM16.L:Z9
                    END IF
                ELSE IF Z5 = 2 THEN
                    IF Z8 = 2 THEN
                        ZF0.L:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 1 THEN
                        ZF0.U:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 3 THEN
                        ZF0.D:Z6 = EM16.L:Z9
                    ELSE IF Z8 = 4 THEN
                        ZF0.F:Z6 = EM18.F:Z9
                    ELSE
                        ZF0.S:Z6 = EM16.L:Z9
                    END IF
                ELSE IF Z5 = 3 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        R0:Z6 = 1
                    ELSE
                        R0:Z6 = 0
                    END IF
                ELSE IF Z5 = 4 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        MR0:Z6 = 1
                    ELSE
                        MR0:Z6 = 0
                    END IF
                ELSE IF Z5 = 5 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        B0:Z6 = 1
                    ELSE
                        B0:Z6 = 0
                    END IF
                ELSE IF Z5 = 6 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        L0:Z6 = 1
                    ELSE
                        L0:Z6 = 0
                    END IF
                ELSE IF Z5 = 8 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        SET(T0:Z6)
                    ELSE
                        RES(T0:Z6)
                    END IF
                ELSE IF Z5 = 9 THEN
                    IF EM16.L:Z9 <> 0 THEN
                        SET(C0:Z6)
                    ELSE
                        RES(C0:Z6)
                    END IF
                ELSE
                    EM1:Z9 = 3
                    EM2:Z9 = 22
                    BREAK
                END IF

            ELSE IF EM6:Z9 = 37 THEN
                ' OP_JMP (S): PC += signed16(a)
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM7:Z9 = Z3 * 256 + Z4
                IF EM7:Z9 >= 32768 THEN
                    EM7:Z9 = EM7:Z9 - 65536
                END IF
                EM0:Z9 = EM0:Z9 + EM7:Z9

            ELSE IF EM6:Z9 = 38 THEN
                ' OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + 32 + Z9
                IF EM0:Z1 > 2 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 39 THEN
                ' OP_JMPNOT (BS): if R[a] が偽 (nil/false) then PC += signed16(b)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + 32 + Z9
                IF EM0:Z1 <= 2 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 40 THEN
                ' OP_JMPNIL (BS): if R[a] が nil then PC += signed16(b)
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + 352 + Z9
                Z3 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                Z4 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + 32 + Z9
                IF EM0:Z1 = 1 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 56 THEN
                ' OP_RETURN (B): トップレベルでは VM 停止
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM1:Z9 = 2
                BREAK

            ELSE IF EM6:Z9 = 60 THEN
                ' OP_ADD (B): R[a] = R[a] + R[a+1]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 + EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 + EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 61 THEN
                ' OP_ADDI (BB): R[a] = R[a] + b
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 + EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 + EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 62 THEN
                ' OP_SUB (B): R[a] = R[a] - R[a+1]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 - EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 - EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 63 THEN
                ' OP_SUBI (BB): R[a] = R[a] - b
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + 352 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 - EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 - EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 64 THEN
                ' OP_MUL (B): R[a] = R[a] * R[a+1]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 * EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 * EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 * EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 * EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 65 THEN
                ' OP_DIV (B): R[a] = R[a] / R[a+1]
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.F:Z1 / EM1.F:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    ELSE
                        IF EM1.L:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.F:Z1 / EM1.L:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.L:Z1 / EM1.F:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.L:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.L:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    ELSE
                        IF EM1.L:Z2 <> 0 THEN
                            ' Ruby の整数除算は切り下げ。KV の / は0方向へ切り捨てるため補正する
                            EM16.L:Z9 = EM1.L:Z1       ' 被除数を退避
                            EM1.L:Z1 = EM1.L:Z1 / EM1.L:Z2
                            EM18.L:Z9 = EM16.L:Z9 - EM1.L:Z1 * EM1.L:Z2   ' 余り
                            IF EM18.L:Z9 <> 0 THEN
                                ' 符号が異なるときだけ切り下げになる
                                IF EM16.L:Z9 < 0 THEN
                                    IF EM1.L:Z2 > 0 THEN
                                        EM1.L:Z1 = EM1.L:Z1 - 1
                                    END IF
                                ELSE
                                    IF EM1.L:Z2 < 0 THEN
                                        EM1.L:Z1 = EM1.L:Z1 - 1
                                    END IF
                                END IF
                            END IF
                            EM0:Z1 = 4
                        ELSE
                            EM1:Z9 = 3
                            EM2:Z9 = 1
                            BREAK
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 66 THEN
                ' OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                ' 数値は型が違っても値で比べる (Ruby では 1 == 1.0 は真)
                ' 数値以外は型と値の両方が一致したときだけ真 (nil == false は偽)
                ' 結果を R[a] に書くと比較元が壊れるため、先に判定してから代入する
                EM16:Z9 = 0
                IF EM0:Z1 >= 4 THEN
                    IF EM0:Z2 >= 4 THEN
                        IF EM0:Z1 = 5 THEN
                            IF EM0:Z2 = 5 THEN
                                IF EM1.F:Z1 = EM1.F:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            ELSE
                                IF EM1.F:Z1 = EM1.L:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            END IF
                        ELSE
                            IF EM0:Z2 = 5 THEN
                                IF EM1.L:Z1 = EM1.F:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            ELSE
                                IF EM1.L:Z1 = EM1.L:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            END IF
                        END IF
                    ELSE
                        ' 数値と非数値は等しくない
                    END IF
                ELSE
                    IF EM0:Z1 = EM0:Z2 THEN
                        IF EM1.L:Z1 = EM1.L:Z2 THEN
                            EM16:Z9 = 1
                        END IF
                    END IF
                END IF
                IF EM16:Z9 = 1 THEN
                    EM1.L:Z1 = 1
                    EM0:Z1 = 3
                ELSE
                    EM1.L:Z1 = 0
                    EM0:Z1 = 2
                END IF

            ELSE IF EM6:Z9 = 67 THEN
                ' OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 < EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 < EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 < EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 < EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 68 THEN
                ' OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 <= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 <= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 <= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 <= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 69 THEN
                ' OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 > EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 > EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 > EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 > EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 70 THEN
                ' OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
                Z1 = EM0:Z9 + 352 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + 32 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + 32 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 >= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 >= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 >= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 >= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 105 THEN
                ' OP_STOP (Z): VM 停止
                EM1:Z9 = 2
                BREAK

            ELSE
                ' 未知のオペコード: エラー
                EM1:Z9 = 3
                EM2:Z9 = EM6:Z9
                BREAK

            END IF

            ' バイトコード範囲チェック
            IF EM0:Z9 >= EM10:Z9 THEN
                EM1:Z9 = 2
                BREAK
            END IF

        NEXT

    END IF

NEXT

' インデックスレジスタの復元
Z1 = EM20021
Z2 = EM20022
