' =======================================
' mruby/c VM Core - Fetch/Decode/Execute
' =======================================
' EM デバイスを使用。
' EM0  = PC (プログラムカウンタ)
' EM1  = STATUS (0=停止, 1=実行中, 2=完了, 3=エラー)
' EM2  = ERROR
' EM5  = STEPS_PER_CYCLE
' EM6  = CURRENT_OPCODE (デバッグ用)
' EM7  = operand a
' EM8  = operand b
' EM13 = RESET_REQ (1=リセット要求, vm_init で処理)
' EM100~ = レジスタファイル R[n] = EM(100+n*2).L
' EM1000~ = バイトコード (1バイト/1EM)
' EM4000~ = 定数プール Pool[n] = EM(4000+n*2).L
' EM5000~ = デバイスマッピングテーブル (2ワード/エントリ)
'           EM(5000+idx*2)   = device_type (0=EM,1=DM,2=ZF,3=R,4=MR,5=B,6=L,8=T,9=C)
'           EM(5000+idx*2+1) = device_address
'
' Z1-Z6 を間接アドレッシングに使用

IF EM1 = 1 THEN

    FOR EM20 = 1 TO EM5

        ' === FETCH OPCODE ===
        Z1 = EM0 + 1000
        EM6 = EM0:Z1
        EM0 = EM0 + 1

        ' === DECODE & EXECUTE ===

        IF EM6 = 0 THEN
            ' OP_NOP (Z): 何もしない

        ELSE IF EM6 = 1 THEN
            ' OP_MOVE (BB): R[a] = R[b]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = EM8 * 2 + 100
            EM0:Z1.L = EM0:Z2.L

        ELSE IF EM6 = 2 THEN
            ' OP_LOADL (BB): R[a] = Pool[b]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = EM8 * 2 + 4000
            EM0:Z1.L = EM0:Z2.L

        ELSE IF EM6 = 3 THEN
            ' OP_LOADI8 (BB): R[a] = signed(b)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            IF EM8 >= 128 THEN
                EM8 = EM8 - 256
            END IF
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = EM8

        ELSE IF EM6 = 4 THEN
            ' OP_LOADINEG (BB): R[a] = -b
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 0 - EM8

        ELSE IF EM6 = 5 THEN
            ' OP_LOADI__1 (B): R[a] = -1
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = -1

        ELSE IF EM6 = 6 THEN
            ' OP_LOADI_0 (B): R[a] = 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 0

        ELSE IF EM6 = 7 THEN
            ' OP_LOADI_1 (B): R[a] = 1
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 1

        ELSE IF EM6 = 8 THEN
            ' OP_LOADI_2 (B): R[a] = 2
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 2

        ELSE IF EM6 = 9 THEN
            ' OP_LOADI_3 (B): R[a] = 3
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 3

        ELSE IF EM6 = 10 THEN
            ' OP_LOADI_4 (B): R[a] = 4
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 4

        ELSE IF EM6 = 11 THEN
            ' OP_LOADI_5 (B): R[a] = 5
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 5

        ELSE IF EM6 = 12 THEN
            ' OP_LOADI_6 (B): R[a] = 6
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 6

        ELSE IF EM6 = 13 THEN
            ' OP_LOADI_7 (B): R[a] = 7
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 7

        ELSE IF EM6 = 14 THEN
            ' OP_LOADI16 (BS): R[a] = signed16(b)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            ' 16bit big-endian: hi byte, lo byte
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = EM8

        ELSE IF EM6 = 15 THEN
            ' OP_LOADI32 (BSS): R[a] = (b<<16)+c
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            ' b (16bit)
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            ' c (16bit)
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM9 = Z3 * 256 + Z4
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = EM8 * 65536 + EM9

        ELSE IF EM6 = 18 THEN
            ' OP_LOADSELF (B): R[a] = self (=0)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 0

        ELSE IF EM6 = 19 THEN
            ' OP_LOADTRUE (B): R[a] = 1
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 1

        ELSE IF EM6 = 20 THEN
            ' OP_LOADFALSE (B): R[a] = 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = 0

        ELSE IF EM6 = 21 THEN
            ' OP_GETGV (BB): R[a] = global[symbols[b]]
            ' fetch operand a
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            ' fetch operand b
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            ' デバイスマッピングテーブル参照
            Z3 = EM8 * 2 + 5000
            Z4 = Z3 + 1
            Z5 = EM0:Z3
            Z6 = EM0:Z4
            ' レジスタアドレス
            Z2 = EM7 * 2 + 100
            ' デバイスタイプ別読み取り
            ' ワードデバイス (EM, DM, ZF): .L (32ビット)
            ' ビットデバイス (R, MR, B, L, T, C): 個別ビット → 0/1
            IF Z5 = 0 THEN
                EM0:Z2.L = EM0:Z6.L
            ELSE IF Z5 = 1 THEN
                EM0:Z2.L = DM0:Z6.L
            ELSE IF Z5 = 2 THEN
                EM0:Z2.L = ZF0:Z6.L
            ELSE IF Z5 = 3 THEN
                IF R0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE IF Z5 = 4 THEN
                IF MR0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE IF Z5 = 5 THEN
                IF B0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE IF Z5 = 6 THEN
                IF L0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE IF Z5 = 8 THEN
                IF T0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE IF Z5 = 9 THEN
                IF C0:Z6 THEN
                    EM0:Z2.L = 1
                ELSE
                    EM0:Z2.L = 0
                END IF
            ELSE
                EM1 = 3
                EM2 = 21
                BREAK
            END IF

        ELSE IF EM6 = 22 THEN
            ' OP_SETGV (BB): global[symbols[b]] = R[a]
            ' fetch operand a
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            ' fetch operand b
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            ' デバイスマッピングテーブル参照
            Z3 = EM8 * 2 + 5000
            Z4 = Z3 + 1
            Z5 = EM0:Z3
            Z6 = EM0:Z4
            ' レジスタアドレス
            Z2 = EM7 * 2 + 100
            ' デバイスタイプ別書き込み
            ' ワードデバイス (EM, DM, ZF): .L (32ビット)
            ' ビットデバイス (R, MR, B, L, T, C): 非0→ON, 0→OFF
            IF Z5 = 0 THEN
                EM0:Z6.L = EM0:Z2.L
            ELSE IF Z5 = 1 THEN
                DM0:Z6.L = EM0:Z2.L
            ELSE IF Z5 = 2 THEN
                ZF0:Z6.L = EM0:Z2.L
            ELSE IF Z5 = 3 THEN
                IF EM0:Z2.L <> 0 THEN
                    R0:Z6 = 1
                ELSE
                    R0:Z6 = 0
                END IF
            ELSE IF Z5 = 4 THEN
                IF EM0:Z2.L <> 0 THEN
                    MR0:Z6 = 1
                ELSE
                    MR0:Z6 = 0
                END IF
            ELSE IF Z5 = 5 THEN
                IF EM0:Z2.L <> 0 THEN
                    B0:Z6 = 1
                ELSE
                    B0:Z6 = 0
                END IF
            ELSE IF Z5 = 6 THEN
                IF EM0:Z2.L <> 0 THEN
                    L0:Z6 = 1
                ELSE
                    L0:Z6 = 0
                END IF
            ELSE IF Z5 = 8 THEN
                IF EM0:Z2.L <> 0 THEN
                    SET(T0:Z6)
                ELSE
                    RES(T0:Z6)
                END IF
            ELSE IF Z5 = 9 THEN
                IF EM0:Z2.L <> 0 THEN
                    SET(C0:Z6)
                ELSE
                    RES(C0:Z6)
                END IF
            ELSE
                EM1 = 3
                EM2 = 22
                BREAK
            END IF

        ELSE IF EM6 = 37 THEN
            ' OP_JMP (S): 無条件ジャンプ PC += signed16(a)
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            EM0 = EM0 + EM8

        ELSE IF EM6 = 38 THEN
            ' OP_JMPIF (BS): if R[a] != 0 then PC += signed16(b)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            Z1 = EM7 * 2 + 100
            IF EM0:Z1.L <> 0 THEN
                EM0 = EM0 + EM8
            END IF

        ELSE IF EM6 = 39 THEN
            ' OP_JMPNOT (BS): if R[a] == 0 then PC += signed16(b)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            Z1 = EM7 * 2 + 100
            IF EM0:Z1.L = 0 THEN
                EM0 = EM0 + EM8
            END IF

        ELSE IF EM6 = 40 THEN
            ' OP_JMPNIL (BS): if R[a] == 0 (nil) then PC += signed16(b)
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z3 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            Z4 = EM0:Z1
            EM0 = EM0 + 1
            EM8 = Z3 * 256 + Z4
            IF EM8 >= 32768 THEN
                EM8 = EM8 - 65536
            END IF
            Z1 = EM7 * 2 + 100
            IF EM0:Z1.L = 0 THEN
                EM0 = EM0 + EM8
            END IF

        ELSE IF EM6 = 56 THEN
            ' OP_RETURN (B): トップレベルでは VM 停止
            EM0 = EM0 + 1
            EM1 = 2
            BREAK

        ELSE IF EM6 = 60 THEN
            ' OP_ADD (B): R[a] = R[a] + R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM0:Z1.L = EM0:Z1.L + EM0:Z2.L

        ELSE IF EM6 = 61 THEN
            ' OP_ADDI (BB): R[a] = R[a] + b
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = EM0:Z1.L + EM8

        ELSE IF EM6 = 62 THEN
            ' OP_SUB (B): R[a] = R[a] - R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM0:Z1.L = EM0:Z1.L - EM0:Z2.L

        ELSE IF EM6 = 63 THEN
            ' OP_SUBI (BB): R[a] = R[a] - b
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM0 + 1000
            EM8 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            EM0:Z1.L = EM0:Z1.L - EM8

        ELSE IF EM6 = 64 THEN
            ' OP_MUL (B): R[a] = R[a] * R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            EM0:Z1.L = EM0:Z1.L * EM0:Z2.L

        ELSE IF EM6 = 65 THEN
            ' OP_DIV (B): R[a] = R[a] / R[a+1]
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z2.L <> 0 THEN
                EM0:Z1.L = EM0:Z1.L / EM0:Z2.L
            ELSE
                EM1 = 3
                EM2 = 1
                BREAK
            END IF

        ELSE IF EM6 = 66 THEN
            ' OP_EQ (B): R[a] = (R[a] == R[a+1]) ? 1 : 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z1.L = EM0:Z2.L THEN
                EM0:Z1.L = 1
            ELSE
                EM0:Z1.L = 0
            END IF

        ELSE IF EM6 = 67 THEN
            ' OP_LT (B): R[a] = (R[a] < R[a+1]) ? 1 : 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z1.L < EM0:Z2.L THEN
                EM0:Z1.L = 1
            ELSE
                EM0:Z1.L = 0
            END IF

        ELSE IF EM6 = 68 THEN
            ' OP_LE (B): R[a] = (R[a] <= R[a+1]) ? 1 : 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z1.L <= EM0:Z2.L THEN
                EM0:Z1.L = 1
            ELSE
                EM0:Z1.L = 0
            END IF

        ELSE IF EM6 = 69 THEN
            ' OP_GT (B): R[a] = (R[a] > R[a+1]) ? 1 : 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z1.L > EM0:Z2.L THEN
                EM0:Z1.L = 1
            ELSE
                EM0:Z1.L = 0
            END IF

        ELSE IF EM6 = 70 THEN
            ' OP_GE (B): R[a] = (R[a] >= R[a+1]) ? 1 : 0
            Z1 = EM0 + 1000
            EM7 = EM0:Z1
            EM0 = EM0 + 1
            Z1 = EM7 * 2 + 100
            Z2 = (EM7 + 1) * 2 + 100
            IF EM0:Z1.L >= EM0:Z2.L THEN
                EM0:Z1.L = 1
            ELSE
                EM0:Z1.L = 0
            END IF

        ELSE IF EM6 = 105 THEN
            ' OP_STOP (Z): VM 停止
            EM1 = 2
            BREAK

        ELSE
            ' 未知のオペコード: エラー
            EM1 = 3
            EM2 = EM6
            BREAK

        END IF

        ' バイトコード範囲チェック
        IF EM0 >= EM10 THEN
            EM1 = 2
            BREAK
        END IF

    NEXT

END IF
