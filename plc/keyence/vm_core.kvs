                        END IF
                        IF EM0:Z1 > 5 THEN
                            EM1:Z9 = 3
                            EM2:Z9 = 4
                            BREAK
                        END IF
                    ELSE IF Z5 <= 12 THEN
                        ' 文字列・配列・ハッシュ (タグ 7-9)
                        IF EM0:Z1 < 7 THEN
                            EM1:Z9 = 3
                            EM2:Z9 = 4
                            BREAK
                        END IF
                        IF EM0:Z1 > 9 THEN
                            EM1:Z9 = 3
                            EM2:Z9 = 4
                            BREAK
