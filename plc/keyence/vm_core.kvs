                            IF EM16.L:Z9 < 0 THEN
                                ' 最初に一致したものを採る
                                Z7 = Z6 * 4 + Z4 + 2
                                IF EM0:Z7 = EM0:Z2 THEN
                                    IF EM0:Z2 = 7 THEN
                                        ' 文字列の鍵は中身で照合する。スロットが違っても同じ鍵
