                ELSE IF Z5 = 6 THEN
                    ' to_f
                    IF EM0:Z1 = 4 THEN
                        ' 整数→実数。同じスロットを .L で読んで .F で書くためスクラッチを挟む
                        EM18.F:Z9 = EM1.L:Z1
                        EM1.F:Z1 = EM18.F:Z9
                        EM0:Z1 = 5
                    END IF
                ELSE IF Z5 = 7 THEN
                    ' floor
                    IF EM0:Z1 = 5 THEN
                        ' KV の実数→整数は 0 方向へ切り捨て。負で端数があるときだけ 1 引く
                        EM16.L:Z9 = EM1.F:Z1
                        IF EM1.F:Z1 < 0 THEN
                            IF EM16.L:Z9 <> EM1.F:Z1 THEN
                                EM16.L:Z9 = EM16.L:Z9 - 1
                            END IF
                        END IF
                        EM1.L:Z1 = EM16.L:Z9
                        EM0:Z1 = 4
                    END IF
                ELSE IF Z5 = 8 THEN
                    ' round
                    IF EM0:Z1 = 5 THEN
                        ' Ruby の round は 0 から遠い方へ丸める (2.5→3, -2.5→-3)
                        IF EM1.F:Z1 >= 0 THEN
                            EM18.F:Z9 = EM1.F:Z1 + 0.5
                        ELSE
                            EM18.F:Z9 = EM1.F:Z1 - 0.5
                        END IF
                        EM16.L:Z9 = EM18.F:Z9
                        EM1.L:Z1 = EM16.L:Z9
                        EM0:Z1 = 4
                    END IF
                ELSE IF Z5 = 11 THEN
                    ' length
                    IF EM0:Z1 = 9 THEN
                        ' 鍵の配列の見出し。R[a] を書き換える前に読む
                        Z4 = EM1:Z1
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM18.L:Z9 = EM0:Z4   ' 組の数
                    ELSE
                        ' スロットの見出し。R[a] を書き換える前に読む
                        Z4 = EM1.L:Z1
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM18.L:Z9 = EM0:Z4   ' 要素数
                        IF EM0:Z1 = 7 THEN
                            ' 文字列は文字数を返す。バイト数ではない
                            EM49:Z9 = 65535   ' 数えるだけ
                            ' 文字の切れ目を先頭から数える。バイト列は 1 回だけなめる
                            EM45:Z9 = EM0:Z4   ' バイト数
                            EM47:Z9 = 0
                            EM48:Z9 = 0
                            EM50:Z9 = EM45:Z9   ' 見つからなければバイト数のまま
                            EM51:Z9 = EM45:Z9
                            IF EM45:Z9 > 0 THEN
                                Z6 = EM45:Z9
                                Z6 = Z6 - 1
                                FOR EM42:Z9 = 0 TO Z6
                                    Z8 = EM42:Z9 / 2
                                    Z7 = Z8 + Z4 + 2
                                    Z7 = EM0:Z7
                                    Z8 = Z8 * 2
                                    IF EM42:Z9 = Z8 THEN
                                        Z7 = Z7 / 256   ' 偶数の位置は上位バイト
                                    ELSE
                                        Z8 = Z7 / 256
                                        Z7 = Z7 - Z8 * 256   ' 奇数の位置は下位バイト
                                    END IF
                                    ' この位置が文字の先頭かどうか
                                    EM43:Z9 = 1
                                    IF EM40:Z9 = 0 THEN
                                        ' 継続バイト (10xxxxxx) は文字の途中
                                        IF Z7 >= 128 THEN
                                            IF Z7 < 192 THEN
                                                EM43:Z9 = 0
                                            END IF
                                        END IF
                                    ELSE IF EM40:Z9 = 1 THEN
                                        IF EM48:Z9 = 1 THEN
                                            ' 先導バイトの次は後続バイト
                                            EM43:Z9 = 0
                                            EM48:Z9 = 0
                                        ELSE
                                            ' 先導バイト (0x81-0x9F, 0xE0-0xEF) なら次のバイトは後続
                                            IF Z7 >= 129 THEN
                                                IF Z7 <= 159 THEN
                                                    EM48:Z9 = 1
                                                END IF
                                            END IF
                                            IF Z7 >= 224 THEN
                                                IF Z7 <= 239 THEN
                                                    EM48:Z9 = 1
                                                END IF
                                            END IF
                                        END IF
                                    END IF
                                    ' ASCII はどのバイトも文字の先頭なので何も見ない
                                    IF EM43:Z9 = 1 THEN
                                        IF EM49:Z9 <= 96 THEN
                                            ' 探している文字なら位置を控える。次の切れ目がその文字の終わり
                                            IF EM47:Z9 = EM49:Z9 THEN
                                                EM50:Z9 = EM42:Z9
                                            END IF
                                            Z7 = EM49:Z9 + 1
                                            IF EM47:Z9 = Z7 THEN
                                                EM51:Z9 = EM42:Z9
                                            END IF
                                        END IF
                                        EM47:Z9 = EM47:Z9 + 1
                                    END IF
                                NEXT
                            END IF
                            EM18.L:Z9 = EM47:Z9
                        END IF
                    END IF
                    EM1.L:Z1 = EM18.L:Z9
                    EM0:Z1 = 4
                ELSE IF Z5 = 12 THEN
                    ' empty?
                    IF EM0:Z1 = 9 THEN
                        ' 鍵の配列の見出し。R[a] を書き換える前に読む
                        Z4 = EM1:Z1
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM18.L:Z9 = EM0:Z4   ' 組の数
                    ELSE
                        ' スロットの見出し。R[a] を書き換える前に読む
                        Z4 = EM1.L:Z1
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM18.L:Z9 = EM0:Z4   ' 要素数
                    END IF
                    IF EM18.L:Z9 = 0 THEN
                        EM1.L:Z1 = 1
                        EM0:Z1 = 3
                    ELSE
                        EM1.L:Z1 = 0
                        EM0:Z1 = 2
                    END IF
                ELSE IF Z5 = 13 THEN
                    ' <<
                    IF EM0:Z1 = 7 THEN
                        ' 文字列は中身を継ぎ足す
                        IF EM0:Z2 <> 7 THEN
                            EM1:Z9 = 3
                            EM2:Z9 = 4
                            BREAK
                        END IF
                        Z3 = EM1.L:Z1
                        Z3 = Z3 * 50 + 1000 + Z9
                        Z4 = EM1.L:Z2
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM16.L:Z9 = EM0:Z3
                        EM18.L:Z9 = EM0:Z4
                        ' 1 スロットに収まること
                        Z5 = EM16.L:Z9 + EM18.L:Z9
                        IF Z5 > 96 THEN
                            EM1:Z9 = 3
                            EM2:Z9 = 10
                            BREAK
                        END IF
                        IF EM18.L:Z9 > 0 THEN
                            Z6 = EM18.L:Z9
                            Z6 = Z6 - 1
