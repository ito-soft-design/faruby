                        EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
                        EM0:Z3 = EM16.L:Z9
                    ELSE
                        ' スロットの見出し。R[a] を書き換える前に読む
                        Z4 = EM1.L:Z1
                        Z4 = Z4 * 50 + 1000 + Z9
                        EM18.L:Z9 = EM0:Z4   ' 要素数
                        IF EM18.L:Z9 >= 12 THEN
                            ' 1 スロットの容量がいっぱい
                            EM1:Z9 = 3
                            EM2:Z9 = 10
                            BREAK
                        END IF
                        ' 末尾に足して要素数を 1 増やす
                        EM16.L:Z9 = EM18.L:Z9
                        Z5 = EM16.L:Z9
                        Z5 = Z5 * 4 + Z4 + 2
                        EM1.L:Z5 = EM1.L:Z2
                        EM0:Z5 = EM0:Z2
                        Z6 = EM18.L:Z9
                        EM0:Z4 = Z6 + 1
                    END IF
                ELSE IF Z5 = 15 THEN
                    ' push
                    ' スロットの見出し。R[a] を書き換える前に読む
                    Z4 = EM1.L:Z1
                    Z4 = Z4 * 50 + 1000 + Z9
                    EM18.L:Z9 = EM0:Z4   ' 要素数
                    IF EM18.L:Z9 >= 12 THEN
