                END IF
                ' 引数の後ろのレジスタを空にする (未代入のローカル変数は偽になる)
                Z4 = (Z3 + 1) * 4 + EM32:Z9 + Z9
                Z5 = EM11:Z9 * 4 + EM32:Z9 + Z9 - 1
                IF Z4 <= Z5 THEN
                    FOR Z6 = Z4 TO Z5
                        EM0:Z6 = 0
                    NEXT
                END IF

            ELSE IF EM6:Z9 = 56 THEN
                ' OP_RETURN (B): R[b] を返して呼び出し元へ (トップレベルでは VM 停止)
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                IF EM31:Z9 = 0 THEN
                    ' トップレベルの return は VM 停止
                    EM1:Z9 = 2
                    BREAK
                ELSE
                    ' R[a] を R[0] へ写す。R[0] は呼んだ側の R[a] と同じ場所なので
                    ' これで戻り値が呼び出し元から見える位置に入る
                    Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                    Z2 = 0 + EM32:Z9 + Z9
                    EM1.L:Z2 = EM1.L:Z1
                    EM0:Z2 = EM0:Z1
                    EM31:Z9 = EM31:Z9 - 1
                    Z3 = EM31:Z9 * 4 + 368 + Z9
                    EM0:Z9 = EM0:Z3
                    Z5 = EM1:Z3
                    EM32:Z9 = EM2:Z3
                    EM30:Z9 = Z5
                    ' IREP テーブルから実行中の irep の情報を写す
                    Z1 = Z5 * 8 + 432 + Z9
                    EM33:Z9 = EM0:Z1
                    EM10:Z9 = EM1:Z1
                    EM34:Z9 = EM2:Z1
                    EM35:Z9 = EM3:Z1
                    EM11:Z9 = EM4:Z1
                END IF

            ELSE IF EM6:Z9 = 60 THEN
                ' OP_ADD (B): R[a] = R[a] + R[a+1]
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 + EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 + EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 + EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 61 THEN
                ' OP_ADDI (BB): R[a] = R[a] + b
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 + EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 + EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 62 THEN
                ' OP_SUB (B): R[a] = R[a] - R[a+1]
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 - EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 - EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 - EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 63 THEN
                ' OP_SUBI (BB): R[a] = R[a] - b
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    EM1.F:Z1 = EM1.F:Z1 - EM8:Z9
                    EM0:Z1 = 5
                ELSE
                    EM1.L:Z1 = EM1.L:Z1 - EM8:Z9
                    EM0:Z1 = 4
                END IF

            ELSE IF EM6:Z9 = 64 THEN
                ' OP_MUL (B): R[a] = R[a] * R[a+1]
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.F:Z1 * EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.F:Z1 = EM1.F:Z1 * EM1.L:Z2
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        EM1.F:Z1 = EM1.L:Z1 * EM1.F:Z2
                        EM0:Z1 = 5
                    ELSE
                        EM1.L:Z1 = EM1.L:Z1 * EM1.L:Z2
                        EM0:Z1 = 4
                    END IF
                END IF

            ELSE IF EM6:Z9 = 65 THEN
                ' OP_DIV (B): R[a] = R[a] / R[a+1]
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.F:Z1 / EM1.F:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    ELSE
                        IF EM1.L:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.F:Z1 / EM1.L:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.F:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.F:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z2 <> 0 THEN
                            EM1.F:Z1 = EM1.L:Z1 / EM1.F:Z2
                        ELSE
                            ' 0 除算。KV の / は CR2012 を出すため実行せず、
                            ' IEEE754 の無限大 / 非数のビット列を直接置く
                            ' 代入先は被除数と同じレジスタなので、先に符号から上位ワードを決める。
                            ' 被除数を書き換えてから符号を見ると、低位ワードを消した時点で
                            ' 整数の 1-65535 が 0 になり、+Infinity が NaN になる
                            EM16:Z9 = 32704   ' 既定は NaN (0.0 / 0.0)
                            IF EM1.L:Z1 > 0 THEN
                                EM16:Z9 = 32640   ' +Infinity
                            END IF
                            IF EM1.L:Z1 < 0 THEN
                                EM16:Z9 = 65408   ' -Infinity
                            END IF
                            EM1:Z1 = 0
                            EM2:Z1 = EM16:Z9
                        END IF
                        EM0:Z1 = 5
                    ELSE
                        IF EM1.L:Z2 <> 0 THEN
                            ' Ruby の整数除算は切り下げ。KV の / は0方向へ切り捨てるため補正する
                            EM16.L:Z9 = EM1.L:Z1       ' 被除数を退避
                            EM1.L:Z1 = EM1.L:Z1 / EM1.L:Z2
                            EM18.L:Z9 = EM16.L:Z9 - EM1.L:Z1 * EM1.L:Z2   ' 余り
                            IF EM18.L:Z9 <> 0 THEN
                                ' 符号が異なるときだけ切り下げになる
                                IF EM16.L:Z9 < 0 THEN
                                    IF EM1.L:Z2 > 0 THEN
                                        EM1.L:Z1 = EM1.L:Z1 - 1
                                    END IF
                                ELSE
                                    IF EM1.L:Z2 < 0 THEN
                                        EM1.L:Z1 = EM1.L:Z1 - 1
                                    END IF
                                END IF
                            END IF
                            EM0:Z1 = 4
                        ELSE
                            EM1:Z9 = 3
                            EM2:Z9 = 1
                            BREAK
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 66 THEN
                ' OP_EQ (B): R[a] = (R[a] == R[a+1]) ? true : false
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                ' 数値は型が違っても値で比べる (Ruby では 1 == 1.0 は真)
                ' 数値以外は型と値の両方が一致したときだけ真 (nil == false は偽)
                ' 結果を R[a] に書くと比較元が壊れるため、先に判定してから代入する
                EM16:Z9 = 0
                IF EM0:Z1 >= 4 THEN
                    IF EM0:Z2 >= 4 THEN
                        IF EM0:Z1 = 5 THEN
                            IF EM0:Z2 = 5 THEN
                                IF EM1.F:Z1 = EM1.F:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            ELSE
                                IF EM1.F:Z1 = EM1.L:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            END IF
                        ELSE
                            IF EM0:Z2 = 5 THEN
                                IF EM1.L:Z1 = EM1.F:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            ELSE
                                IF EM1.L:Z1 = EM1.L:Z2 THEN
                                    EM16:Z9 = 1
                                END IF
                            END IF
                        END IF
                    ELSE
                        ' 数値と非数値は等しくない
                    END IF
                ELSE
                    IF EM0:Z1 = EM0:Z2 THEN
                        IF EM1.L:Z1 = EM1.L:Z2 THEN
                            EM16:Z9 = 1
                        END IF
                    END IF
                END IF
                IF EM16:Z9 = 1 THEN
                    EM1.L:Z1 = 1
                    EM0:Z1 = 3
                ELSE
                    EM1.L:Z1 = 0
                    EM0:Z1 = 2
                END IF

            ELSE IF EM6:Z9 = 67 THEN
                ' OP_LT (B): R[a] = (R[a] < R[a+1]) ? true : false
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 < EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 < EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 < EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 < EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 68 THEN
                ' OP_LE (B): R[a] = (R[a] <= R[a+1]) ? true : false
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 <= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 <= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 <= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 <= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 69 THEN
                ' OP_GT (B): R[a] = (R[a] > R[a+1]) ? true : false
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 > EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 > EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 > EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 > EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 70 THEN
                ' OP_GE (B): R[a] = (R[a] >= R[a+1]) ? true : false
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 5 THEN
                    IF EM0:Z2 = 5 THEN
                        IF EM1.F:Z1 >= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.F:Z1 >= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                ELSE
                    IF EM0:Z2 = 5 THEN
                        IF EM1.L:Z1 >= EM1.F:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    ELSE
                        IF EM1.L:Z1 >= EM1.L:Z2 THEN
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        ELSE
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        END IF
                    END IF
                END IF

            ELSE IF EM6:Z9 = 88 THEN
                ' OP_METHOD (BB): R[a] = 子 irep b への参照
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 実行中の irep の最初の子の番号に、親から見た子の番号を足す
                Z3 = EM30:Z9 * 8 + 432 + Z9
                Z4 = Z3 + 5
                EM16:Z9 = EM0:Z4 + EM8:Z9
                IF EM16:Z9 >= EM36:Z9 THEN
                    ' 指す先の irep が無い
                    EM1:Z9 = 3
                    EM2:Z9 = 7
                    BREAK
                END IF
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = EM16:Z9
                EM0:Z1 = 12

            ELSE IF EM6:Z9 = 95 THEN
                ' OP_DEF (BB): メソッド表に symbols[b] = R[a+1] を登録
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM8:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' シンボル表参照 (4ワード/エントリ)
                Z3 = EM8:Z9 * 4 + EM35:Z9 + Z9
                Z5 = EM0:Z3   ' メソッド番号
                Z7 = Z3 + 2
                Z8 = EM0:Z7   ' 引数の数
                Z7 = Z3 + 3
                Z4 = EM0:Z7   ' シンボル種別
                IF Z4 <> 2 THEN
                    EM1:Z9 = 3
                    EM2:Z9 = 3
                    BREAK
                END IF
                Z6 = EM0:Z3   ' 組み込みメソッド番号
                Z3 = Z3 + 1
                Z5 = EM0:Z3   ' ユーザー定義メソッドID
                IF Z5 = 0 THEN
                    ' 組み込みと同じ名前は再定義できない
                    EM1:Z9 = 3
                    EM2:Z9 = 3
                    BREAK
                END IF
                Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                IF EM0:Z2 <> 12 THEN
                    EM1:Z9 = 3
                    EM2:Z9 = 3
                    BREAK
                END IF
                ' メソッド表 (ID => 本体の irep 番号)
                Z3 = Z5 + 4560 + Z9
                EM0:Z3 = EM1.L:Z2
                ' OP_DEF の戻り値はメソッド名の Symbol。トップレベルでは捨てられる
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = EM8:Z9
                EM0:Z1 = 6

            ELSE IF EM6:Z9 = 99 THEN
                ' OP_TCLASS (B): R[a] = 定義先クラス (トップレベルは main)
                Z1 = EM0:Z9 + EM33:Z9 + Z9
                EM7:Z9 = EM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = 0
                EM0:Z1 = 10

            ELSE IF EM6:Z9 = 105 THEN
                ' OP_STOP (Z): VM 停止
                EM1:Z9 = 2
                BREAK

            ELSE
                ' 未知のオペコード: エラー
                EM1:Z9 = 3
                EM2:Z9 = EM6:Z9
                BREAK

            END IF

            ' バイトコード範囲チェック
            IF EM0:Z9 >= EM10:Z9 THEN
                EM1:Z9 = 2
                BREAK
            END IF

        NEXT

    END IF

NEXT

' インデックスレジスタの復元
Z1 = EM20021
Z2 = EM20022
Z3 = EM20023
Z4 = EM20024
Z5 = EM20025
Z6 = EM20026
Z7 = EM20027
Z8 = EM20028
Z9 = EM20029
