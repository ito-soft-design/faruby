                    Z4 = EM1.L:Z1
                    Z4 = Z4 * 50 + 1000 + Z9
                    EM18.L:Z9 = EM0:Z4   ' 要素数
                    ' 負の添字は後ろから数える (Ruby の a[-1] は最後の要素)
                    EM16.L:Z9 = EM1.L:Z2
                    IF EM16.L:Z9 < 0 THEN
                        EM16.L:Z9 = EM16.L:Z9 + EM18.L:Z9
                    END IF
                    IF EM16.L:Z9 < 0 THEN
                        ' 後ろから数えても先頭より前 (Ruby は IndexError)
                        EM1:Z9 = 3
                        EM2:Z9 = 2
                        BREAK
                    END IF
                    IF EM16.L:Z9 >= 12 THEN
                        ' 1 スロットの容量を超える位置
                        EM1:Z9 = 3
                        EM2:Z9 = 10
                        BREAK
                    END IF
                    ' 要素数を超える位置への代入は、間を nil で埋めて伸ばす
                    IF EM16.L:Z9 > EM18.L:Z9 THEN
                        Z6 = EM18.L:Z9   ' 埋め始め (今の要素数)
                        Z7 = EM16.L:Z9
                        Z7 = Z7 - 1   ' 埋め終わり。ここは添字 > 要素数 >= 0 なので 0 未満にならない
                        FOR Z8 = Z6 TO Z7
                            Z5 = Z8 * 4 + Z4 + 2
                            EM1.L:Z5 = 0
                            EM0:Z5 = 1
                        NEXT
                    END IF
                    IF EM16.L:Z9 >= EM18.L:Z9 THEN
                        Z6 = EM16.L:Z9
                        EM0:Z4 = Z6 + 1   ' 要素数を伸ばす
                    END IF
                    Z5 = EM16.L:Z9
                    Z5 = Z5 * 4 + Z4 + 2
                    EM1.L:Z5 = EM1.L:Z3
                    EM0:Z5 = EM0:Z3
                ELSE IF EM0:Z1 = 9 THEN
                    ' 鍵の配列の見出し。R[a] を書き換える前に読む
                    Z4 = EM1:Z1
                    Z4 = Z4 * 50 + 1000 + Z9
                    EM18.L:Z9 = EM0:Z4   ' 組の数
                    Z5 = EM2:Z1   ' 値の配列
                    Z5 = Z5 * 50 + 1000 + Z9
                    ' 鍵を先頭から探す。一致は型と値の両方 (Ruby の eql? と同じ)
                    EM16.L:Z9 = -1
                    IF EM18.L:Z9 > 0 THEN
                        Z8 = EM18.L:Z9
                        Z8 = Z8 - 1
                        FOR Z6 = 0 TO Z8
                            IF EM16.L:Z9 < 0 THEN
                                ' 最初に一致したものを採る
                                Z7 = Z6 * 4 + Z4 + 2
                                IF EM0:Z7 = EM0:Z2 THEN
                                    IF EM0:Z2 = 7 THEN
                                        ' 文字列の鍵は中身で照合する。スロットが違っても同じ鍵
                                        ' 文字列は中身で比べる。スロット番号ではない
                                        ' Z3 を借りる。返すまでの間に呼ぶ側の値を壊さないため
                                        EM46:Z9 = Z3
                                        EM43:Z9 = 0
                                        Z3 = EM1.L:Z7
                                        Z3 = Z3 * 50 + 1000 + Z9
                                        EM44:Z9 = EM0:Z3   ' バイト数
                                        Z3 = EM1.L:Z2
                                        Z3 = Z3 * 50 + 1000 + Z9
                                        IF EM44:Z9 = EM0:Z3 THEN
                                            ' バイト数が同じ。ここから中身を見る
                                            EM43:Z9 = 1
                                            EM45:Z9 = EM44:Z9 + 1
                                            EM45:Z9 = EM45:Z9 / 2   ' ワード数
                                            IF EM45:Z9 > 0 THEN
                                                EM45:Z9 = EM45:Z9 - 1
                                                FOR EM42:Z9 = 0 TO EM45:Z9
                                                    Z3 = EM1.L:Z7
                                                    Z3 = Z3 * 50 + 1000 + Z9
                                                    Z3 = EM42:Z9 + Z3 + 2
                                                    EM44:Z9 = EM0:Z3
                                                    Z3 = EM1.L:Z2
                                                    Z3 = Z3 * 50 + 1000 + Z9
                                                    Z3 = EM42:Z9 + Z3 + 2
                                                    IF EM44:Z9 <> EM0:Z3 THEN
                                                        EM43:Z9 = 0
                                                    END IF
                                                NEXT
                                            END IF
                                        END IF
                                        ' 借りた Z3 を返す
                                        Z3 = EM46:Z9
                                        IF EM43:Z9 = 1 THEN
                                            EM16.L:Z9 = Z6
                                        END IF
                                    ELSE
                                        IF EM1.L:Z7 = EM1.L:Z2 THEN
                                            EM16.L:Z9 = Z6
                                        END IF
                                    END IF
                                END IF
                            END IF
                        NEXT
                    END IF
                    IF EM16.L:Z9 >= 0 THEN
                        ' 既にある鍵は値だけ差し替える
                        Z7 = EM16.L:Z9
                        Z7 = Z7 * 4 + Z5 + 2
                        EM1.L:Z7 = EM1.L:Z3
                        EM0:Z7 = EM0:Z3
                    ELSE
                        ' 新しい鍵は鍵と値の両方の末尾に足す
                        IF EM18.L:Z9 >= 12 THEN
                            ' 1 スロットの容量がいっぱい
                            EM1:Z9 = 3
                            EM2:Z9 = 10
                            BREAK
                        END IF
                        EM16.L:Z9 = EM18.L:Z9
                        Z7 = EM16.L:Z9
                        Z7 = Z7 * 4 + Z4 + 2
                        EM1.L:Z7 = EM1.L:Z2
                        EM0:Z7 = EM0:Z2
                        Z7 = EM16.L:Z9
                        Z7 = Z7 * 4 + Z5 + 2
                        EM1.L:Z7 = EM1.L:Z3
                        EM0:Z7 = EM0:Z3
                        Z8 = EM18.L:Z9
                        Z8 = Z8 + 1   ' 組の数を 1 増やす
                        EM0:Z4 = Z8
                        EM0:Z5 = Z8
                    END IF
                ELSE
                    ' デバイス参照・配列・ハッシュ以外への添字代入は未対応
                    EM1:Z9 = 3
                    EM2:Z9 = 2
                    BREAK
                END IF

            ELSE IF EM6:Z9 = 37 THEN
                ' OP_JMP (S): PC += signed16(a)
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + EM33:Z9
                Z3 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z4 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM7:Z9 = Z3 * 256 + Z4
                IF EM7:Z9 >= 32768 THEN
                    EM7:Z9 = EM7:Z9 - 65536
                END IF
                EM0:Z9 = EM0:Z9 + EM7:Z9

            ELSE IF EM6:Z9 = 38 THEN
                ' OP_JMPIF (BS): if R[a] が真 then PC += signed16(b)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + EM33:Z9
                Z3 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z4 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 > 2 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 39 THEN
                ' OP_JMPNOT (BS): if R[a] が偽 (nil/false) then PC += signed16(b)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + EM33:Z9
                Z3 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z4 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 <= 2 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 40 THEN
                ' OP_JMPNIL (BS): if R[a] が nil then PC += signed16(b)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' 16bit big-endian: hi byte, lo byte
                Z1 = EM0:Z9 + EM33:Z9
                Z3 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                Z4 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                EM8:Z9 = Z3 * 256 + Z4
                IF EM8:Z9 >= 32768 THEN
                    EM8:Z9 = EM8:Z9 - 65536
                END IF
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                IF EM0:Z1 = 1 THEN
                    EM0:Z9 = EM0:Z9 + EM8:Z9
                END IF

            ELSE IF EM6:Z9 = 45 THEN
                ' OP_SSEND (BBB): R[a] = self.symbols[b](R[a+1]..)
                Z1 = EM0:Z9 + EM33:Z9
                EM7:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                EM8:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                Z1 = EM0:Z9 + EM33:Z9
                EM9:Z9 = FM0:Z1
                EM0:Z9 = EM0:Z9 + 1
                ' self をレシーバ位置に置く (mruby の regs[a] = regs[0])
                Z3 = 0 + EM32:Z9 + Z9
                Z1 = EM7:Z9 * 4 + EM32:Z9 + Z9
                EM1.L:Z1 = EM1.L:Z3
                EM0:Z1 = EM0:Z3
                ' シンボル表参照 (4ワード/エントリ)
                Z3 = EM8:Z9 * 4 + EM35:Z9
                Z5 = FM0:Z3   ' メソッド番号
                Z7 = Z3 + 2
                Z8 = FM0:Z7   ' 引数の数
                Z7 = Z3 + 3
                Z4 = FM0:Z7   ' シンボル種別
                IF Z4 <> 2 THEN
                    EM1:Z9 = 3
                    EM2:Z9 = 3
                    BREAK
                END IF
                Z3 = Z3 + 1
                Z6 = FM0:Z3   ' ユーザー定義メソッドID
                IF Z5 <> 0 THEN
                    ' 組み込みメソッド。フレームを積まずその場で計算する
                    IF EM9:Z9 <> Z8 THEN
                        ' 引数の数が定義と違う
                        ' オペランドは位置引数とキーワード引数の数を4ビットずつ詰めたもの。
                        ' 普通の呼び出しでは引数の数と一致し、スプラットやキーワード付きは弾かれる
                        EM1:Z9 = 3
                        EM2:Z9 = 3
                        BREAK
                    END IF
                    Z2 = (EM7:Z9 + 1) * 4 + EM32:Z9 + Z9
                    ' メソッド番号の帯ごとにレシーバのタグの範囲を見る (METHOD_RECEIVER_BANDS)
                    ' 3 未満 (!= と !) はどの型でも呼べる
                    IF Z5 >= 3 THEN
                        IF Z5 <= 10 THEN
                            ' 数値 (タグ 4-5)
                            IF EM0:Z1 < 4 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                            IF EM0:Z1 > 5 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE IF Z5 <= 12 THEN
                            ' 文字列・配列・ハッシュ (タグ 7-9)
                            IF EM0:Z1 < 7 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                            IF EM0:Z1 > 9 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE IF Z5 <= 13 THEN
                            ' 文字列・配列 (タグ 7-8)
                            IF EM0:Z1 < 7 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                            IF EM0:Z1 > 8 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE IF Z5 <= 14 THEN
                            ' 配列・ハッシュ (タグ 8-9)
                            IF EM0:Z1 < 8 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                            IF EM0:Z1 > 9 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE IF Z5 <= 15 THEN
                            ' 配列 (タグ 8)
                            IF EM0:Z1 <> 8 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE
                            ' ハッシュ (タグ 9)
                            IF EM0:Z1 <> 9 THEN
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        END IF
                    END IF
                    IF Z5 = 1 THEN
                        ' !=
                        ' 数値は型が違っても値で比べる (Ruby では 1 == 1.0 は真)
                        ' 数値以外は型と値の両方が一致したときだけ真 (nil == false は偽)
                        ' 結果を R[a] に書くと比較元が壊れるため、先に判定してから代入する
                        EM16:Z9 = 0
                        ' シンボルや配列のタグは 4 より大きいので、上限も見ないと
                        ' 番号やスロット番号が数値として比べられてしまう
                        Z3 = 0
                        IF EM0:Z1 >= 4 THEN
                            IF EM0:Z1 <= 5 THEN
                                Z3 = 1
                            END IF
                        END IF
                        Z4 = 0
                        IF EM0:Z2 >= 4 THEN
                            IF EM0:Z2 <= 5 THEN
                                Z4 = 1
                            END IF
                        END IF
                        IF Z3 = 1 THEN
                            IF Z4 = 1 THEN
                                IF EM0:Z1 = 5 THEN
                                    IF EM0:Z2 = 5 THEN
                                        IF EM1.F:Z1 = EM1.F:Z2 THEN
                                            EM16:Z9 = 1
                                        END IF
                                    ELSE
                                        IF EM1.F:Z1 = EM1.L:Z2 THEN
                                            EM16:Z9 = 1
                                        END IF
                                    END IF
                                ELSE
                                    IF EM0:Z2 = 5 THEN
                                        IF EM1.L:Z1 = EM1.F:Z2 THEN
                                            EM16:Z9 = 1
                                        END IF
                                    ELSE
                                        IF EM1.L:Z1 = EM1.L:Z2 THEN
                                            EM16:Z9 = 1
                                        END IF
                                    END IF
                                END IF
                            ELSE
                                ' 数値と非数値は等しくない
                            END IF
                        ELSE
                            IF EM0:Z1 = EM0:Z2 THEN
                                IF EM0:Z1 = 7 THEN
                                    ' 文字列は中身で比べる。スロット番号ではない
                                    ' Z3 を借りる。返すまでの間に呼ぶ側の値を壊さないため
                                    EM46:Z9 = Z3
                                    EM43:Z9 = 0
                                    Z3 = EM1.L:Z1
                                    Z3 = Z3 * 50 + 1000 + Z9
                                    EM44:Z9 = EM0:Z3   ' バイト数
                                    Z3 = EM1.L:Z2
                                    Z3 = Z3 * 50 + 1000 + Z9
                                    IF EM44:Z9 = EM0:Z3 THEN
                                        ' バイト数が同じ。ここから中身を見る
                                        EM43:Z9 = 1
                                        EM45:Z9 = EM44:Z9 + 1
                                        EM45:Z9 = EM45:Z9 / 2   ' ワード数
                                        IF EM45:Z9 > 0 THEN
                                            EM45:Z9 = EM45:Z9 - 1
                                            FOR EM42:Z9 = 0 TO EM45:Z9
                                                Z3 = EM1.L:Z1
                                                Z3 = Z3 * 50 + 1000 + Z9
                                                Z3 = EM42:Z9 + Z3 + 2
                                                EM44:Z9 = EM0:Z3
                                                Z3 = EM1.L:Z2
                                                Z3 = Z3 * 50 + 1000 + Z9
                                                Z3 = EM42:Z9 + Z3 + 2
                                                IF EM44:Z9 <> EM0:Z3 THEN
                                                    EM43:Z9 = 0
                                                END IF
                                            NEXT
                                        END IF
                                    END IF
                                    ' 借りた Z3 を返す
                                    Z3 = EM46:Z9
                                    IF EM43:Z9 = 1 THEN
                                        EM16:Z9 = 1
                                    END IF
                                ELSE
                                    IF EM1.L:Z1 = EM1.L:Z2 THEN
                                        EM16:Z9 = 1
                                    END IF
                                END IF
                            END IF
                        END IF
                        IF EM16:Z9 = 1 THEN
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        ELSE
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        END IF
                    ELSE IF Z5 = 2 THEN
                        ' !
                        IF EM0:Z1 > 2 THEN
                            EM1.L:Z1 = 0
                            EM0:Z1 = 2
                        ELSE
                            EM1.L:Z1 = 1
                            EM0:Z1 = 3
                        END IF
                    ELSE IF Z5 = 3 THEN
                        ' %
                        ' 整数どうしのみ。実数の % は未対応
                        IF EM0:Z2 = 4 THEN
                            IF EM0:Z1 = 4 THEN
                                IF EM1.L:Z2 <> 0 THEN
                                    EM16.L:Z9 = EM1.L:Z1       ' 被除数を退避
                                    EM1.L:Z1 = EM1.L:Z1 / EM1.L:Z2   ' 0方向へ切り捨てた商
                                    EM18.L:Z9 = EM16.L:Z9 - EM1.L:Z1 * EM1.L:Z2   ' 余り
                                    IF EM18.L:Z9 <> 0 THEN
                                        ' 符号が違うときだけ除数を足して符号を合わせる
                                        IF EM16.L:Z9 < 0 THEN
                                            IF EM1.L:Z2 > 0 THEN
                                                EM18.L:Z9 = EM18.L:Z9 + EM1.L:Z2
                                            END IF
                                        ELSE
                                            IF EM1.L:Z2 < 0 THEN
                                                EM18.L:Z9 = EM18.L:Z9 + EM1.L:Z2
                                            END IF
                                        END IF
                                    END IF
                                    EM1.L:Z1 = EM18.L:Z9
                                    EM0:Z1 = 4
                                ELSE
                                    EM1:Z9 = 3
                                    EM2:Z9 = 1
                                    BREAK
                                END IF
                            ELSE
                                EM1:Z9 = 3
                                EM2:Z9 = 4
                                BREAK
                            END IF
                        ELSE
                            EM1:Z9 = 3
                            EM2:Z9 = 4
                            BREAK
                        END IF
                    ELSE IF Z5 = 4 THEN
                        ' abs
                        IF EM0:Z1 = 5 THEN
                            IF EM1.F:Z1 < 0 THEN
                                EM1.F:Z1 = 0 - EM1.F:Z1
                            END IF
                        ELSE
                            IF EM1.L:Z1 < 0 THEN
                                EM1.L:Z1 = 0 - EM1.L:Z1
                            END IF
                        END IF
                    ELSE IF Z5 = 5 THEN
                        ' to_i
                        IF EM0:Z1 = 5 THEN
                            ' 0 方向へ切り捨て (Ruby の Float#to_i と同じ)
                            EM16.L:Z9 = EM1.F:Z1
                            EM1.L:Z1 = EM16.L:Z9
                            EM0:Z1 = 4
                        END IF
                    ELSE IF Z5 = 6 THEN
                        ' to_f
                        IF EM0:Z1 = 4 THEN
                            ' 整数→実数。同じスロットを .L で読んで .F で書くためスクラッチを挟む
                            EM18.F:Z9 = EM1.L:Z1
                            EM1.F:Z1 = EM18.F:Z9
                            EM0:Z1 = 5
                        END IF
                    ELSE IF Z5 = 7 THEN
                        ' floor
                        IF EM0:Z1 = 5 THEN
                            ' KV の実数→整数は 0 方向へ切り捨て。負で端数があるときだけ 1 引く
                            EM16.L:Z9 = EM1.F:Z1
                            IF EM1.F:Z1 < 0 THEN
                                IF EM16.L:Z9 <> EM1.F:Z1 THEN
                                    EM16.L:Z9 = EM16.L:Z9 - 1
                                END IF
                            END IF
                            EM1.L:Z1 = EM16.L:Z9
                            EM0:Z1 = 4
                        END IF
                    ELSE IF Z5 = 8 THEN
                        ' round
                        IF EM0:Z1 = 5 THEN
                            ' Ruby の round は 0 から遠い方へ丸める (2.5→3, -2.5→-3)
                            IF EM1.F:Z1 >= 0 THEN
                                EM18.F:Z9 = EM1.F:Z1 + 0.5
                            ELSE
                                EM18.F:Z9 = EM1.F:Z1 - 0.5
                            END IF
                            EM16.L:Z9 = EM18.F:Z9
                            EM1.L:Z1 = EM16.L:Z9
                            EM0:Z1 = 4
                        END IF
                    ELSE IF Z5 = 11 THEN
                        ' length
                        IF EM0:Z1 = 9 THEN
                            ' 鍵の配列の見出し。R[a] を書き換える前に読む
                            Z4 = EM1:Z1
                            Z4 = Z4 * 50 + 1000 + Z9
                            EM18.L:Z9 = EM0:Z4   ' 組の数
                        ELSE
                            ' スロットの見出し。R[a] を書き換える前に読む
                            Z4 = EM1.L:Z1
                            Z4 = Z4 * 50 + 1000 + Z9
                            EM18.L:Z9 = EM0:Z4   ' 要素数
                            IF EM0:Z1 = 7 THEN
                                ' 文字列は文字数を返す。バイト数ではない
                                EM49:Z9 = 65535   ' 数えるだけ
                                ' 文字の切れ目を先頭から数える。バイト列は 1 回だけなめる
                                EM45:Z9 = EM0:Z4   ' バイト数
                                EM47:Z9 = 0
                                EM48:Z9 = 0
                                EM50:Z9 = EM45:Z9   ' 見つからなければバイト数のまま
                                EM51:Z9 = EM45:Z9
                                IF EM45:Z9 > 0 THEN
                                    Z6 = EM45:Z9
                                    Z6 = Z6 - 1
                                    FOR EM42:Z9 = 0 TO Z6
                                        Z8 = EM42:Z9 / 2
                                        Z7 = Z8 + Z4 + 2
                                        Z7 = EM0:Z7
                                        Z8 = Z8 * 2
                                        IF EM42:Z9 = Z8 THEN
                                            Z7 = Z7 / 256   ' 偶数の位置は上位バイト
                                        ELSE
                                            Z8 = Z7 / 256
                                            Z7 = Z7 - Z8 * 256   ' 奇数の位置は下位バイト
                                        END IF
                                        ' この位置が文字の先頭かどうか
                                        EM43:Z9 = 1
                                        IF EM40:Z9 = 0 THEN
                                            ' 継続バイト (10xxxxxx) は文字の途中
                                            IF Z7 >= 128 THEN
                                                IF Z7 < 192 THEN
                                                    EM43:Z9 = 0
                                                END IF
                                            END IF
                                        ELSE IF EM40:Z9 = 1 THEN
                                            IF EM48:Z9 = 1 THEN
                                                ' 先導バイトの次は後続バイト
                                                EM43:Z9 = 0
                                                EM48:Z9 = 0
                                            ELSE
                                                ' 先導バイト (0x81-0x9F, 0xE0-0xEF) なら次のバイトは後続
                                                IF Z7 >= 129 THEN
                                                    IF Z7 <= 159 THEN
                                                        EM48:Z9 = 1
                                                    END IF
                                                END IF
                                                IF Z7 >= 224 THEN
                                                    IF Z7 <= 239 THEN
                                                        EM48:Z9 = 1
                                                    END IF
                                                END IF
                                            END IF
                                        END IF
                                        ' ASCII はどのバイトも文字の先頭なので何も見ない
                                        IF EM43:Z9 = 1 THEN
                                            IF EM49:Z9 <= 96 THEN
